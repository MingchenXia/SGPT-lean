import SGPT.Projective.AlgebraicClosedImmersionStalk
import SGPT.Projective.AlgebraicCurveSectionLength
import SGPT.NAPotential.GraphDivisorOrderTransport

/-! The actual original algebraic section-zero stalk is the SAME parent
principal quotient, with the ACTUAL original stalk map and full lengths.
Blueprint: algebraic-section-zero-stalk.tex. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
namespace SGPT.Projective.NumEq.AlgebraicCurveDegree
open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes Opposite

variable {X : Scheme.{0}} {L : X.Modules}
  (a : LineBundleAtlas L) (s : Γ(L, ⊤))

/-- The ACTUAL section-zero stalk kernel is generated by the SAME original
section coefficient germ in ANY original atlas frame. No quotient or
stalk kernel comparison is a supplied premise. -/
theorem sectionZero_stalk_kernel (z : sectionZeroSubscheme a s)
    (i : a.I) (hi : sectionZeroι a s z ∈ a.opens i) :
    RingHom.ker ((sectionZeroι a s).stalkMap z).hom =
      Ideal.span {sectionStalkCoefficient a s i (sectionZeroι a s z) hi} := by
  obtain ⟨V, hV, hzV, hVU⟩ := exists_isAffineOpen_mem_and_subset hi
  let j : V ⟶ a.opens i := homOfLE hVU
  let r : Γ(X, V) := (a.frame i).coefficients j (L.presheaf.map V.leTop.op s)
  have hcoeff : r = X.presheaf.map j.op
      ((a.frame i).coefficients (𝟙 (a.opens i)) (L.presheaf.map (a.opens i).leTop.op s)) := by
    have hc := (a.frame i).coefficients_restrict (𝟙 (a.opens i)) j
      (L.presheaf.map (a.opens i).leTop.op s)
    have hres : L.val.map j.op (L.presheaf.map (a.opens i).leTop.op s) =
        L.presheaf.map V.leTop.op s := by
      change L.val.map j.op (L.val.map (a.opens i).leTop.op s) = L.val.map V.leTop.op s
      rw [← L.val.map_comp_apply]
      rfl
    rw [hres] at hc
    change r = X.presheaf.map j.op _ at hc
    exact hc
  have hgerm : X.presheaf.germ V (sectionZeroι a s z) hzV r =
      sectionStalkCoefficient a s i (sectionZeroι a s z) hi := by
    rw [hcoeff]
    exact X.presheaf.germ_res_apply j (sectionZeroι a s z) hzV _
  rw [closedImmersion_stalk_kernel (sectionZeroι a s) V hV z hzV,
    sectionZeroι_app_ker a s ⟨V, hV⟩,
    sectionZeroIdeal_eq_span_frame s (a.frame i) j,
    Ideal.map_span, Set.image_singleton, hgerm]

/-- A genuine ring isomorphism from the ACTUAL parent coefficient quotient
to the ACTUAL original zero-subscheme local ring. Nonreduced multiplicities
are retained, and no geometric zero-set surrogate is used. -/
def sectionZeroStalkQuotientEquiv (z : sectionZeroSubscheme a s)
    (i : a.I) (hi : sectionZeroι a s z ∈ a.opens i) :
    ((X.presheaf.stalk (sectionZeroι a s z)) ⧸
      Ideal.span {sectionStalkCoefficient a s i (sectionZeroι a s z) hi}) ≃+*
        (sectionZeroSubscheme a s).presheaf.stalk z :=
  (Ideal.quotEquivOfEq (sectionZero_stalk_kernel a s z i hi).symm).trans
    (((sectionZeroι a s).stalkMap z).hom.quotientKerEquivOfSurjective
      ((sectionZeroι a s).stalkMap_surjective z))

/-- The quotient isomorphism reads back to the SAME original stalk map
on EVERY actual original local-ring element. -/
theorem sectionZeroStalkQuotientEquiv_apply_mk (z : sectionZeroSubscheme a s)
    (i : a.I) (hi : sectionZeroι a s z ∈ a.opens i)
    (r : X.presheaf.stalk (sectionZeroι a s z)) :
    sectionZeroStalkQuotientEquiv a s z i hi (Ideal.Quotient.mk _ r) =
      (sectionZeroι a s).stalkMap z r := by
  simp [sectionZeroStalkQuotientEquiv]

/-- FULL original zero-scheme local-ring length equals the SAME literal
parent local principal quotient module length, with no reducedness or
finiteness/length certificate input. -/
theorem sectionZeroStalk_length_eq_principalLength (z : sectionZeroSubscheme a s)
    (i : a.I) (hi : sectionZeroι a s z ∈ a.opens i) :
    Module.length ((sectionZeroSubscheme a s).presheaf.stalk z)
      ((sectionZeroSubscheme a s).presheaf.stalk z) =
    Module.length (X.presheaf.stalk (sectionZeroι a s z))
      ((X.presheaf.stalk (sectionZeroι a s z)) ⧸
        Ideal.span {sectionStalkCoefficient a s i (sectionZeroι a s z) hi}) := by
  let R := X.presheaf.stalk (sectionZeroι a s z)
  let Q := R ⧸ Ideal.span {sectionStalkCoefficient a s i (sectionZeroι a s z) hi}
  have hiso := SGPT.NAPotential.GraphDivisorOrderTransport.ord_ringEquiv
    (sectionZeroStalkQuotientEquiv a s z i hi) 0
  simp only [map_zero, Ring.ord_zero] at hiso
  have hscalar : Module.length R Q = Module.length Q Q :=
    Module.length_eq_of_surjective (R := Q) (S := R) (M := Q) Ideal.Quotient.mk_surjective
  exact hiso.trans hscalar.symm

end SGPT.Projective.NumEq.AlgebraicCurveDegree
