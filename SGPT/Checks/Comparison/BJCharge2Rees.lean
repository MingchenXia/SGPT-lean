import SGPT.Checks.Comparison.BJCharge2Divisorial
import SGPT.Support.Principalization.Scheme.IdealSheaf.Invertible


/-!
# Rees centres on normal models (lane BJ-CHARGE, step R8(c), abstract part)

Source: [BJ22] (`references/bj22-trivval`), Lemma `lem:tcdiv` via [BHJ17, Theorem 4.6]: on the
normalized blow-up of a flag ideal `𝔞` adapted to a divisorial `v`, the Gauss extension `σ(v)` is
centred at a point `c` where `(t^N 𝔞) · 𝒪` is principal, generated by an element of minimal value;
the quotients of elements of minimal value are units of `𝒪_c` whose residues are those of the
residually independent elements of `BJChargeGauss`, so `c` is a prime divisor and `σ(v)` is a
multiple of `ord_c`. Towards `thm:BJappseq` of `chapter_NApotential.tex`. Blueprint:
`claude-bj-charge2.tex`.

* `functionFieldValuation`: a semi-valuation supported at the generic point as a valuation of the
  function field (with the `ℂ`-structure of the generic stalk);
* `reesCenter`: **Rees centres**: for a valuation `w` of `ℂ(𝒳)` centred at a non-generic point `c`
  of a normal integral `𝒳` of finite type over `ℂ` of dimension `≤ n + 1`, an invertible ideal
  sheaf `J` and pairs `h_i, h'_i ∈ J_c` of equal finite minimal value whose quotients are
  residually independent for `w`, the point `c` has codimension one, `𝒪_{𝒳,c}` is a DVR and
  `w = β · ord_c`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.BJ

open AlgebraicGeometry CategoryTheory Order
open SGPT.NAPotential.Berkovich SGPT.NAPotential.Berkovich.BerkovichPoint
open SGPT.NAPotential.BJCharge

section rees

variable {𝒳 : Scheme.{0}} [IsIntegral 𝒳] (q : 𝒳 ⟶ Spec (.of ℂ))

/-- The valuation of a semi-valuation supported at the generic point, transported to the function
field `ℂ(𝒳)` (with the `ℂ`-structure of the generic stalk). -/
def functionFieldValuation (val : ResidueValuation q (genericPoint 𝒳)) :
    letI := q.stalkAlgebra (genericPoint 𝒳)
    SourceRealValuation 𝒳.functionField :=
  letI := q.stalkAlgebra (genericPoint 𝒳)
  letI := residueComplexAlgebra q (genericPoint 𝒳)
  { toFun := fun F => val ((𝒳.residue (genericPoint 𝒳)).hom F)
    eq_top_iff' := fun F => by
      rw [val.eq_top_iff']
      exact map_eq_zero_iff _ (RingHom.injective _)
    map_mul' := fun F G => by rw [map_mul]; exact val.map_mul' _ _
    min_le_map_add' := fun F G => by rw [map_add]; exact val.min_le_map_add' _ _
    map_complex' := fun a ha => by
      have h := congrArg (fun φ => φ.hom a) (residueComplexHom_eq_stalkAlgebra q (genericPoint 𝒳))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
      change val ((𝒳.residue (genericPoint 𝒳)).hom (algebraMap ℂ _ a)) = 0
      rw [← h]
      exact val.map_complex' a ha }

variable [IsLocallyNoetherian 𝒳] [IsProper q]

/-- **Rees centres** (the units argument of [BHJ17, Theorem 4.6] for [BJ22, `lem:tcdiv`]): let `𝒳`
be a normal integral scheme of finite type over `ℂ` of dimension `≤ n + 1`, `w ∈ 𝒳^An` a valuation
of `ℂ(𝒳)` centred at a non-generic point `c`, and `J` an invertible ideal sheaf. If
`h_i, h'_i ∈ J_c` (`i < n`) have the same values, `w(h'_i)` is finite and minimal on `J_c`, and the
ratios `h_i / h'_i` are residually independent for `w`, then `c` has codimension one, `𝒪_{𝒳,c}` is
a discrete valuation ring and `w = β · ord_c` for some `β > 0`. -/
theorem reesCenter (hnorm : ∀ x : 𝒳, IsIntegrallyClosed (𝒳.presheaf.stalk x)) {n : ℕ}
    (hdim : topologicalKrullDim 𝒳 ≤ n + 1) (val : ResidueValuation q (genericPoint 𝒳))
    (hc : (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center ≠ genericPoint 𝒳)
    (J : 𝒳.IdealSheafData) (hJ : J.IsInvertible)
    (h h' : Fin n → 𝒳.presheaf.stalk (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center)
    (hh : ∀ i, h i ∈ stalkIdeal J (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center)
    (hh' : ∀ i, h' i ∈ stalkIdeal J (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center)
    (hv : ∀ i, (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).centerVal (h i) =
      (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).centerVal (h' i))
    (hmin : ∀ i, ∀ g ∈ stalkIdeal J (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center,
      (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).centerVal (h' i) ≤
        (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).centerVal g)
    (hfin : ∀ i, (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).centerVal (h' i) ≠ ⊤)
    (hind : letI := residueComplexAlgebra q (genericPoint 𝒳)
      ResiduallyIndependent val (fun i =>
        (specializationMap (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).support_specializes_center).hom
          (h i) / (specializationMap
            (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).support_specializes_center).hom (h' i))) :
    coheight (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center = 1 ∧
      IsDiscreteValuationRing (𝒳.presheaf.stalk (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center) ∧
      ∃ β : ℝ, 0 < β ∧ ∀ F : 𝒳.functionField, F ≠ 0 →
        val ((𝒳.residue (genericPoint 𝒳)).hom F) = ((β * (Scheme.ord F
          (⟨genericPoint 𝒳, val⟩ : BerkovichPoint q).center : ℝ) : ℝ) : WithTop ℝ) := by
  let w : BerkovichPoint q := ⟨genericPoint 𝒳, val⟩
  let c := w.center
  let sp : 𝒳.presheaf.stalk c →+* 𝒳.residueField (genericPoint 𝒳) :=
    (specializationMap w.support_specializes_center).hom
  have hsp : ∀ t : 𝒳.presheaf.stalk c, sp t =
      (𝒳.residue (genericPoint 𝒳)).hom (algebraMap _ 𝒳.functionField t) := fun t => rfl
  have hsp_inj : Function.Injective sp := by
    intro a b hab
    rw [hsp, hsp] at hab
    exact IsFractionRing.injective _ 𝒳.functionField ((RingHom.injective _) hab)
  have hcv : ∀ t, w.centerVal t = val (sp t) := fun t => rfl
  -- the generator of `J_c`
  obtain ⟨g, hg, hJg⟩ := ((Scheme.IdealSheafData.isInvertible_iff_forall_stalkIdeal_eq_span J).mp
    hJ) c
  have hJg' : stalkIdeal J c = Ideal.span {g} := hJg
  have hgJ : g ∈ stalkIdeal J c := by rw [hJg']; exact Ideal.mem_span_singleton_self g
  have hdiv : ∀ x ∈ stalkIdeal J c, ∃ u, x = g * u := by
    intro x hx
    rw [hJg', Ideal.mem_span_singleton'] at hx
    obtain ⟨u, rfl⟩ := hx
    exact ⟨u, mul_comm _ _⟩
  have hcancel : ∀ {a b : WithTop ℝ}, a ≠ ⊤ → a + b = a → b = 0 := by
    intro a b ha hab
    lift a to ℝ using ha
    cases b with
    | top => rw [WithTop.add_top] at hab; exact absurd hab.symm WithTop.coe_ne_top
    | coe r =>
      rw [← WithTop.coe_add, WithTop.coe_eq_coe] at hab
      rw [show r = 0 by linarith]
      rfl
  -- the units `u_i = h_i / g`, `u'_i = h'_i / g`
  have hunits : ∀ i, ∃ u u' : 𝒳.presheaf.stalk c, h i = g * u ∧ h' i = g * u' ∧ IsUnit u ∧
      IsUnit u' := by
    intro i
    obtain ⟨u, hu⟩ := hdiv _ (hh i)
    obtain ⟨u', hu'⟩ := hdiv _ (hh' i)
    have h1 : w.centerVal (h' i) = w.centerVal g + w.centerVal u' := by rw [hu', centerVal_mul]
    have h2 : w.centerVal (h' i) ≤ w.centerVal g := hmin i g hgJ
    have h3 : w.centerVal (h' i) = w.centerVal g := by
      apply le_antisymm h2
      rw [h1]
      exact le_add_of_nonneg_right (w.centerVal_nonneg u')
    have hgfin : w.centerVal g ≠ ⊤ := h3 ▸ hfin i
    have hu'0 : w.centerVal u' = 0 := hcancel hgfin (by rw [← h1, h3])
    have hu0 : w.centerVal u = 0 := hcancel hgfin (by rw [← centerVal_mul, ← hu, hv i, h3])
    exact ⟨u, u', hu, hu', (w.centerVal_eq_zero_iff u).mp hu0, (w.centerVal_eq_zero_iff u').mp hu'0⟩
  choose u u' hu hu' hun hun' using hunits
  have hg0 : sp g ≠ 0 := fun h0 =>
    nonZeroDivisors.ne_zero hg (hsp_inj (h0.trans (map_zero sp).symm))
  let e : Fin n → 𝒳.presheaf.stalk c := fun i => u i * ↑(hun' i).unit⁻¹
  have hse : ∀ i, sp (e i) = sp (h i) / sp (h' i) := by
    intro i
    have hinv : sp (↑(hun' i).unit⁻¹) = (sp (u' i))⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      rw [← map_mul, IsUnit.val_inv_mul, map_one]
    simp only [e]
    rw [map_mul, hinv, hu i, hu' i, map_mul, map_mul, mul_div_mul_left _ _ hg0, div_eq_mul_inv]
  -- apply the divisorial-centre theorem to the valuation on the function field
  let := q.stalkAlgebra (genericPoint 𝒳)
  let := q.stalkAlgebra c
  let := residueComplexAlgebra q (genericPoint 𝒳)
  let W := functionFieldValuation q val
  have hW : ∀ F, W F = val ((𝒳.residue (genericPoint 𝒳)).hom F) := fun F => rfl
  let ρ : 𝒳.functionField →ₐ[ℂ] 𝒳.residueField (genericPoint 𝒳) :=
    { (𝒳.residue (genericPoint 𝒳)).hom with
      commutes' := fun a => by
        have h := congrArg (fun φ => φ.hom a) (residueComplexHom_eq_stalkAlgebra q (genericPoint 𝒳))
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
        exact h.symm }
  have he : ResiduallyIndependent W (algebraMap _ 𝒳.functionField ∘ e) := by
    intro P hP
    rw [hW]
    change val (ρ _) = 0
    rw [MvPolynomial.comp_aeval_apply]
    have : (fun i => ρ ((algebraMap _ 𝒳.functionField ∘ e) i)) =
        fun i => sp (h i) / sp (h' i) := by
      funext i
      exact hse i
    rw [this]
    exact hind P hP
  obtain ⟨hc1, hdvr, β, hβ, hβF⟩ := divisorialCenter q hnorm hdim hc W
    (fun s => w.centerVal_nonneg s) (fun s hs => w.centerVal_pos hs) e he
  exact ⟨hc1, hdvr, β, hβ, fun F hF => (hβF F hF)⟩

end rees

end SGPT.NAPotential.BJ
