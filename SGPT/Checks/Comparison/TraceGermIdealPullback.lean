import SGPT.Checks.Comparison.TraceAnalyticIdealGerms

/-! Entire original holomorphic germ ideals under actual pullback.
Blueprint: `trace-na-ideal-functoriality.tex`. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
namespace SGPT.NAPotential.TraceComparison

open Set Filter AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.NAPotential.GAGAMult SGPT.NAPotential.Berkovich SGPT.NAPotential.BJ.GfIm
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open scoped Topology Manifold ContDiff

section Manifold

variable {n k : ℕ} {M V : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [TopologicalSpace V] [ChartedSpace (ComplexModel k) V] [IsComplexManifold k V]

/-- Passing to actual finite holomorphic combinations does not alter the
WHOLE ideal of actual holomorphic germs generated by the original functions. -/
theorem spanGerms_isInSpanAt_eq {S : (M → ℂ) → Prop} {x : M}
    (hS : ∀ s, S s → HolomorphicAt n s x) :
    spanGerms (n := n) (IsInSpanAt (n := n) S x) x = spanGerms (n := n) S x := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨g, hg, h, rfl⟩
    exact mk_mem_spanGerms_of_isInSpanAt hS h
  · apply Ideal.span_le.mpr
    rintro _ ⟨g, hg, h, rfl⟩
    apply mk_mem_spanGerms hg
    exact ⟨hg, 1, fun _ => g, fun _ => 1, fun _ => h,
      fun _ => holomorphicAt_const 1, Eventually.of_forall fun y => by simp⟩

/-- The ENTIRE original pullback ideal gives precisely the actual image
ideal under the actual holomorphic-germ ring pullback. No pointwise-only
evaluation or generator-match certificate is a premise. -/
theorem spanGerms_pullback_eq_map {F : V → M}
    (hF : ContMDiff 𝓘(ℂ, ComplexModel k) 𝓘(ℂ, ComplexModel n) ∞ F)
    (A : GermIdeal n M) (y : V) (hA : ∀ a, A.mem (F y) a → HolomorphicAt n a (F y)) :
    spanGerms (n := k) ((GermIdeal.pullback (m := k) F A).mem y) y =
      (spanGerms (n := n) (A.mem (F y)) (F y)).map (NativeHolGerm.comap F hF y) := by
  let S : (V → ℂ) → Prop := fun s => ∃ a, A.mem (F y) a ∧ s = a ∘ F
  have hS : ∀ s, S s → HolomorphicAt k s y := by
    rintro s ⟨a, ha, rfl⟩
    exact (hA a ha).comp_contMDiff (Eventually.of_forall fun z => hF.contMDiffAt)
  change spanGerms (n := k) (IsInSpanAt (n := k) S y) y = _
  rw [spanGerms_isInSpanAt_eq hS]
  unfold spanGerms
  rw [Ideal.map_span]
  congr 1
  ext γ
  constructor
  · rintro ⟨s, hs, ⟨a, ha, rfl⟩, rfl⟩
    refine ⟨NativeHolGerm.mk a (hA a ha), ⟨a, hA a ha, ha, rfl⟩, ?_⟩
    apply Subtype.ext
    rfl
  · rintro ⟨_, ⟨a, ha, hAa, rfl⟩, rfl⟩
    refine ⟨a ∘ F, (hA a hAa).comp_contMDiff
      (Eventually.of_forall fun z => hF.contMDiffAt), ⟨a, hAa, rfl⟩, ?_⟩
    apply Subtype.ext
    rfl

/-- Membership in the actual original pullback ideal is membership of the
actual holomorphic germ in the actual image ideal, with no closure loss. -/
theorem pullback_mem_iff_mk_mem_map {F : V → M}
    (hF : ContMDiff 𝓘(ℂ, ComplexModel k) 𝓘(ℂ, ComplexModel n) ∞ F)
    (A : GermIdeal n M) (y : V) (hA : ∀ a, A.mem (F y) a → HolomorphicAt n a (F y))
    {g : V → ℂ} (hg : HolomorphicAt k g y) :
    (GermIdeal.pullback (m := k) F A).mem y g ↔
      NativeHolGerm.mk g hg ∈
        (spanGerms (n := n) (A.mem (F y)) (F y)).map (NativeHolGerm.comap F hF y) := by
  let S : (V → ℂ) → Prop := fun s => ∃ a, A.mem (F y) a ∧ s = a ∘ F
  have hS : ∀ s, S s → HolomorphicAt k s y := by
    rintro s ⟨a, ha, rfl⟩
    exact (hA a ha).comp_contMDiff (Eventually.of_forall fun z => hF.contMDiffAt)
  rw [← spanGerms_pullback_eq_map hF A y hA]
  change IsInSpanAt (n := k) S y g ↔
    NativeHolGerm.mk g hg ∈ spanGerms (n := k) (IsInSpanAt (n := k) S y) y
  rw [spanGerms_isInSpanAt_eq hS]
  exact ⟨fun h => mk_mem_spanGerms_of_isInSpanAt hS h,
    fun h => isInSpanAt_of_mk_mem_spanGerms hg h⟩

end Manifold

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ)
  [SmoothOfRelativeDimension n f] (E : ClosedProjectiveEmbedding f)
  [IsSeparated f] [QuasiCompact f]

local instance tracePullGermsPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance tracePullGermsPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n
local instance tracePullGermsPointManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

/-- Taking all actual analytic ideal-member functions generates exactly the
SAME whole original analytic ideal germ, rather than a larger surrogate. -/
theorem spanGerms_analytificationIdeal_eq (J : X.IdealSheafData) (p : SchemeComplexPoint f) :
    spanGerms ((analytificationIdeal f n E J).mem p) p = anGerms f n E J p := by
  change spanGerms (IsInSpanAt (n := n) (AnGen f n E J p) p) p = _
  exact spanGerms_isInSpanAt_eq (fun s hs => holomorphicAt_of_anGen f n E hs)

end SGPT.NAPotential.TraceComparison
