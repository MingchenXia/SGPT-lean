variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ) [SmoothOfRelativeDimension n f]
  (E : ClosedProjectiveEmbedding f)

local instance gfImPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance gfImPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

section Germs

variable [IsSeparated f] [QuasiCompact f]

local instance gfImPointManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

/-- The stalk `𝔞^an_x`, as an ideal of the ring of holomorphic germs at `x`. -/
def anGerms (𝔞 : X.IdealSheafData) (x : SchemeComplexPoint f) :
    Ideal (NativeHolGerm n (SchemeComplexPoint f) x) :=
  spanGerms (n := n) (AnGen f n E 𝔞 x) x

theorem isInSpanAt_self {S : (SchemeComplexPoint f → ℂ) → Prop} {x : SchemeComplexPoint f}
    {g : SchemeComplexPoint f → ℂ} (hg : HolomorphicAt n g x) (hS : S g) :
    IsInSpanAt (n := n) S x g :=
  ⟨hg, 1, fun _ => g, fun _ => 1, fun _ => hS, fun _ => holomorphicAt_const 1,
    Eventually.of_forall fun y => by simp⟩

theorem mem_analytificationIdeal_iff_mk (𝔞 : X.IdealSheafData) (x : SchemeComplexPoint f)
    {g : SchemeComplexPoint f → ℂ} (hg : HolomorphicAt n g x) :
    (analytificationIdeal f n E 𝔞).mem x g ↔ NativeHolGerm.mk g hg ∈ anGerms f n E 𝔞 x := by
  constructor
  · intro h
    exact mk_mem_spanGerms_of_isInSpanAt (fun s hs => holomorphicAt_of_anGen f n E hs) h
  · intro h
    exact isInSpanAt_of_mk_mem_spanGerms hg h

theorem regularGermHom_mem_anGerms {𝔞 : X.IdealSheafData} {U : X.affineOpens}
    {x : SchemeComplexPoint f} (hx : schemeComplexPointImage f x ∈ (U : X.Opens)) {r : Γ(X, U)}
    (hr : r ∈ 𝔞.ideal U) : regularGermHom f n E (U : X.Opens) x hx r ∈ anGerms f n E 𝔞 x := by
  rw [regularGermHom_apply]
  exact mk_mem_spanGerms _ ⟨U, hx, r, hr, rfl⟩

/-- `(𝔞𝔟)^an_x ⊆ 𝔞^an_x 𝔟^an_x`. -/
theorem anGerms_mul_le (𝔞 𝔟 : X.IdealSheafData) (x : SchemeComplexPoint f) :
    anGerms f n E (𝔞 * 𝔟) x ≤ anGerms f n E 𝔞 x * anGerms f n E 𝔟 x := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨s, hs, ⟨U, hU, r, hr, rfl⟩, rfl⟩
  have hmk : NativeHolGerm.mk _ hs = regularGermHom f n E (U : X.Opens) x hU r := by
    rw [regularGermHom_apply]
  rw [SetLike.mem_coe, hmk]
  have hle : ∀ 𝔠 : X.IdealSheafData,
      Ideal.map (regularGermHom f n E (U : X.Opens) x hU) (𝔠.ideal U) ≤ anGerms f n E 𝔠 x :=
    fun 𝔠 => Ideal.map_le_iff_le_comap.mpr fun r' hr' => regularGermHom_mem_anGerms f n E hU hr'
  have hr' : r ∈ 𝔞.ideal U * 𝔟.ideal U := by
    rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply] at hr
    exact hr
  have hmap := Ideal.mem_map_of_mem (regularGermHom f n E (U : X.Opens) x hU) hr'
  rw [Ideal.map_mul] at hmap
  exact Ideal.mul_mono (hle 𝔞) (hle 𝔟) hmap

/-- `𝔞^an_x 𝔟^an_x ⊆ (𝔞𝔟)^an_x`. -/
theorem mul_anGerms_le (𝔞 𝔟 : X.IdealSheafData) (x : SchemeComplexPoint f) :
    anGerms f n E 𝔞 x * anGerms f n E 𝔟 x ≤ anGerms f n E (𝔞 * 𝔟) x := by
  refine Ideal.mul_le.mpr fun u hu w hw => ?_
  refine Submodule.span_induction (p := fun u _ => u * w ∈ anGerms f n E (𝔞 * 𝔟) x)
    ?_ ?_ ?_ ?_ hu
  · rintro _ ⟨s, hs, hS, rfl⟩
    refine Submodule.span_induction
      (p := fun w _ => NativeHolGerm.mk s hs * w ∈ anGerms f n E (𝔞 * 𝔟) x) ?_ ?_ ?_ ?_ hw
    · rintro _ ⟨t, ht, hT, rfl⟩
      have := mk_mul_mem_spanGerms f n E hS hT
      have heq : NativeHolGerm.mk s hs * NativeHolGerm.mk t ht =
          NativeHolGerm.mk (s * t) (hs.mul ht) := Subtype.ext rfl
      rw [heq]
      exact this
    · simp
    · intro w₁ w₂ _ _ h₁ h₂
      rw [mul_add]
      exact Ideal.add_mem _ h₁ h₂
    · intro c w _ h
      rw [smul_eq_mul, mul_left_comm]
      exact Ideal.mul_mem_left _ _ h
  · simp
  · intro u₁ u₂ _ _ h₁ h₂
    rw [add_mul]
    exact Ideal.add_mem _ h₁ h₂
  · intro c u _ h
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ _ h

theorem anGerms_mul (𝔞 𝔟 : X.IdealSheafData) (x : SchemeComplexPoint f) :
    anGerms f n E (𝔞 * 𝔟) x = anGerms f n E 𝔞 x * anGerms f n E 𝔟 x :=
  le_antisymm (anGerms_mul_le f n E 𝔞 𝔟 x) (mul_anGerms_le f n E 𝔞 𝔟 x)

/-- `(𝔟^j)^an_x = (𝔟^an_x)^j` for `j ≥ 1`. -/
theorem anGerms_pow (𝔟 : X.IdealSheafData) (x : SchemeComplexPoint f) {j : ℕ} (hj : 0 < j) :
    anGerms f n E (𝔟 ^ j) x = anGerms f n E 𝔟 x ^ j := by
  induction j, hj using Nat.le_induction with
  | base => rw [pow_one, pow_one]
  | succ j hj ih => rw [pow_succ, anGerms_mul, ih, pow_succ]

theorem mk_mul' {x : SchemeComplexPoint f} {u w : SchemeComplexPoint f → ℂ}
    (hu : HolomorphicAt n u x) (hw : HolomorphicAt n w x) :
    NativeHolGerm.mk (fun z => u z * w z) (hu.mul hw) = NativeHolGerm.mk u hu * NativeHolGerm.mk w hw :=
  Subtype.ext rfl

/-- The germ of a finite product is the product of the germs. -/
theorem mk_prod {ι : Type*} (s : Finset ι) {x : SchemeComplexPoint f}
    {F : ι → SchemeComplexPoint f → ℂ} (hF : ∀ i, HolomorphicAt n (F i) x) :
    NativeHolGerm.mk (fun z => ∏ i ∈ s, F i z) (holomorphicAt_prod s fun i _ => hF i) =
      ∏ i ∈ s, NativeHolGerm.mk (F i) (hF i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact Subtype.ext rfl
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, ← ih, ← mk_mul' f n (hF a)]
    congr 1
    funext z
    rw [Finset.prod_insert ha]

/-- The germ of a finite sum is the sum of the germs. -/
theorem mk_sum {ι : Type*} (s : Finset ι) {x : SchemeComplexPoint f}
    {F : ι → SchemeComplexPoint f → ℂ} (hF : ∀ i, HolomorphicAt n (F i) x)
    (hs : HolomorphicAt n (fun z => ∑ i ∈ s, F i z) x) :
    NativeHolGerm.mk (fun z => ∑ i ∈ s, F i z) hs = ∑ i ∈ s, NativeHolGerm.mk (F i) (hF i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact Subtype.ext rfl
  | insert a s ha ih =>
    have hs' : HolomorphicAt n (fun z => ∑ i ∈ s, F i z) x :=
      HolomorphicAt.sum s fun i _ => hF i
    rw [Finset.sum_insert ha, ← ih hs']
    exact Subtype.ext (by
      change ((fun z => ∑ i ∈ insert a s, F i z : SchemeComplexPoint f → ℂ) :
        Germ (𝓝 x) ℂ) = ((F a : SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) +
          ((fun z => ∑ i ∈ s, F i z : SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ)
      rw [← Germ.coe_add]
      congr 1
      funext z
      rw [Finset.sum_insert ha]
      rfl)

end Germs


/-! ### Real and extended-real arithmetic of finite maxima -/

/-- `max_k (log |z_k|² + c) = log (max_k |z_k|²) + c`. -/
theorem sup'_logNormSq_add {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (z : ι → ℂ) (c : ℝ) :
    s.sup' hs (fun k => SGPT.Foundations.Analysis.logNormSq (z k) + (c : EReal)) =
      ENNReal.log (ENNReal.ofReal (s.sup' hs fun k => ‖z k‖ ^ 2)) + (c : EReal) := by
  have hadd : ∀ a b : EReal, (a ⊔ b) + (c : EReal) = (a + c) ⊔ (b + c) := fun a b =>
    (Monotone.map_max (f := fun t : EReal => t + (c : EReal)) fun _ _ h => add_le_add h le_rfl)
  have hlog : ∀ a b : ℝ, ENNReal.log (ENNReal.ofReal (a ⊔ b)) =
      ENNReal.log (ENNReal.ofReal a) ⊔ ENNReal.log (ENNReal.ofReal b) := fun a b =>
    Monotone.map_max (f := fun t : ℝ => ENNReal.log (ENNReal.ofReal t))
      (ENNReal.log_monotone.comp fun _ _ h => ENNReal.ofReal_le_ofReal h)
  rw [Finset.apply_sup'_eq_sup'_comp hs (fun t : ℝ => ENNReal.log (ENNReal.ofReal t)) hlog,
    Finset.apply_sup'_eq_sup'_comp hs (fun t : EReal => t + (c : EReal)) hadd]
  rfl

/-- The bounded remainder `log max_k |z_k|² - log ∑_k |z_k|²` (`0` if all `z_k` vanish). -/
def maxSumDefect {ι : Type*} [Fintype ι] [Nonempty ι] (z : ι → ℂ) : ℝ :=
  if ∑ k, ‖z k‖ ^ 2 = 0 then 0 else
    Real.log (Finset.univ.sup' Finset.univ_nonempty fun k => ‖z k‖ ^ 2) - Real.log (∑ k, ‖z k‖ ^ 2)

theorem abs_maxSumDefect_le {ι : Type*} [Fintype ι] [Nonempty ι] (z : ι → ℂ) :
    |maxSumDefect z| ≤ Real.log (Fintype.card ι) := by
  have hcard : (1 : ℝ) ≤ Fintype.card ι := by exact_mod_cast Fintype.card_pos
  have hlogc : 0 ≤ Real.log (Fintype.card ι) := Real.log_nonneg hcard
  unfold maxSumDefect
  split_ifs with hS
  · simpa using hlogc
  set S := ∑ k, ‖z k‖ ^ 2 with hSdef
  set Mx := Finset.univ.sup' Finset.univ_nonempty fun k => ‖z k‖ ^ 2 with hMx
  have hS0 : 0 < S := lt_of_le_of_ne (Finset.sum_nonneg fun k _ => by positivity) (Ne.symm hS)
  have hMxS : Mx ≤ S := Finset.sup'_le _ _ fun k _ =>
    Finset.single_le_sum (f := fun k => ‖z k‖ ^ 2) (fun k _ => by positivity) (Finset.mem_univ k)
  have hSMx : S ≤ Fintype.card ι * Mx := by
    calc S ≤ ∑ _k : ι, Mx := Finset.sum_le_sum fun k _ => Finset.le_sup' (fun k => ‖z k‖ ^ 2) (Finset.mem_univ k)
      _ = Fintype.card ι * Mx := by simp
  have hMx0 : 0 < Mx := by
    by_contra h
    push Not at h
    have : S ≤ 0 := hSMx.trans (mul_nonpos_of_nonneg_of_nonpos (by positivity) h)
    linarith
  rw [abs_le]
  constructor
  · have h1 : Real.log S ≤ Real.log (Fintype.card ι) + Real.log Mx := by
      rw [← Real.log_mul (by positivity) hMx0.ne']
      exact Real.log_le_log hS0 hSMx
    linarith
  · have := Real.log_le_log hMx0 hMxS
    linarith

/-- `log (max_k |z_k|²) = log ∑_k |z_k|² + defect` in `[-∞, ∞)`. -/
theorem log_sup'_eq_add_maxSumDefect {ι : Type*} [Fintype ι] [Nonempty ι] (z : ι → ℂ) :
    ENNReal.log (ENNReal.ofReal (Finset.univ.sup' Finset.univ_nonempty fun k => ‖z k‖ ^ 2)) =
      ENNReal.log (ENNReal.ofReal (∑ k, ‖z k‖ ^ 2)) + (maxSumDefect z : EReal) := by
  set S := ∑ k, ‖z k‖ ^ 2 with hSdef
  set Mx := Finset.univ.sup' Finset.univ_nonempty fun k => ‖z k‖ ^ 2 with hMx
  have hMxS : Mx ≤ S := Finset.sup'_le _ _ fun k _ =>
    Finset.single_le_sum (f := fun k => ‖z k‖ ^ 2) (fun k _ => by positivity) (Finset.mem_univ k)
  have hMxnn : 0 ≤ Mx := by
    obtain ⟨k, -, hk⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty fun k => ‖z k‖ ^ 2
    rw [← hMx] at hk
    rw [hk]
    positivity
  unfold maxSumDefect
  rw [← hSdef, ← hMx]
  by_cases hS : S = 0
  · have hM0 : Mx = 0 := le_antisymm (hS ▸ hMxS) hMxnn
    rw [if_pos hS, hS, hM0, ENNReal.ofReal_zero, ENNReal.log_zero, EReal.bot_add]
  · rw [if_neg hS]
    have hS0 : 0 < S := lt_of_le_of_ne (Finset.sum_nonneg fun k _ => by positivity) (Ne.symm hS)
    have hSMx : S ≤ Fintype.card ι * Mx := by
      calc S ≤ ∑ _k : ι, Mx := Finset.sum_le_sum fun k _ =>
            Finset.le_sup' (fun k => ‖z k‖ ^ 2) (Finset.mem_univ k)
        _ = Fintype.card ι * Mx := by simp
    have hMx0 : 0 < Mx := by
      by_contra h
      push Not at h
      have : S ≤ 0 := hSMx.trans (mul_nonpos_of_nonneg_of_nonpos (by positivity) h)
      linarith
    rw [ENNReal.log_ofReal_of_pos hMx0, ENNReal.log_ofReal_of_pos hS0, ← EReal.coe_add]
    congr 1
    ring

section Sections

variable [IsSeparated f] [QuasiCompact f]

local instance gfImPointManifold' : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

variable {M : X.Modules} (b : LineBundleAtlas M) (N : ℕ) {ι : Type} [Fintype ι]
  (t : ι → bundlePowerGlobalSections M N)

/-- The ideal sheaf `∑_k (t_k)` generated by finitely many sections of `M^{⊗ N}`. -/
def sectionsIdeal : X.IdealSheafData :=
  ⨆ k, sectionZeroIdealSheaf (b.tensorPower N) (t k)

/-- The analytic function of the coefficient of `t_k` in the frame `(b.frame i)^{⊗ N}`. -/
def frameCoeff (i : b.I) (k : ι) : SchemeComplexPoint f → ℂ :=
  schemeOpenRegularFunction f n E (b.opens i) (algCoef (b.frame i) N (t k))

theorem frameCoeff_holomorphicAt (i : b.I) (k : ι) {x : SchemeComplexPoint f}
    (hx : schemeComplexPointImage f x ∈ b.opens i) :
    HolomorphicAt n (frameCoeff f n E b N t i k) x :=
  schemeOpenRegularFunction_holomorphicAt f n E _ _ x hx

/-- Near a point of the frame domain, `𝔟^an_x` is generated by the frame coefficients of the
sections. -/
theorem anGerms_sectionsIdeal (i : b.I) {x : SchemeComplexPoint f}
    (hx : schemeComplexPointImage f x ∈ b.opens i) :
    anGerms f n E (sectionsIdeal b N t) x =
      Ideal.span (Set.range fun k => NativeHolGerm.mk (frameCoeff f n E b N t i k)
        (frameCoeff_holomorphicAt f n E b N t i k hx)) := by
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨s, hs, hS, rfl⟩
    have hmem : (analytificationIdeal f n E (sectionsIdeal b N t)).mem x s :=
      isInSpanAt_self f n hs hS
    have h1 := analytificationIdeal_sup_le f n E
      (fun k => sectionZeroIdealSheaf (b.tensorPower N) (t k)) x s hmem
    have h2 := mk_mem_spanGerms_of_isInSpanAt (n := n)
      (fun s' (hs' : ∃ k, (analytificationIdeal f n E
        (sectionZeroIdealSheaf (b.tensorPower N) (t k))).mem x s') => hs'.choose_spec.1) h1
    refine (Ideal.span_le.mpr ?_) h2
    rintro _ ⟨s', hs', ⟨k, hk⟩, rfl⟩
    rw [analytificationIdeal_sectionZeroIdealSheaf_iff f n E b N (t k) i hx] at hk
    have h3 := mk_mem_spanGerms_of_isInSpanAt (n := n)
      (S := (· = frameCoeff f n E b N t i k))
      (fun s'' hs'' => hs'' ▸ frameCoeff_holomorphicAt f n E b N t i k hx) hk
    refine (Ideal.span_le.mpr ?_) h3
    rintro _ ⟨h, hh, rfl, rfl⟩
    exact Ideal.subset_span ⟨k, rfl⟩
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨k, rfl⟩
    have hk : (analytificationIdeal f n E (sectionZeroIdealSheaf (b.tensorPower N) (t k))).mem x
        (frameCoeff f n E b N t i k) :=
      (analytificationIdeal_sectionZeroIdealSheaf_iff f n E b N (t k) i hx _).mpr
        (isInSpanAt_self f n (frameCoeff_holomorphicAt f n E b N t i k hx) rfl)
    exact (mem_analytificationIdeal_iff_mk f n E _ x _).mp
      (analytificationIdeal_le_sup f n E (fun k => sectionZeroIdealSheaf (b.tensorPower N) (t k))
        k x _ hk)

variable (HM : SchemeLineBundleMetric f n E M) [Nonempty ι] [IsIntegral X]

/-- `Φ = max_k log |t_k|²_{h_M^N}`. -/
def sectionsMaxLog : SchemeComplexPoint f → EReal :=
  Finset.univ.sup' Finset.univ_nonempty fun k => HM.sectionLogNormSq b N (t k)

theorem sectionsMaxLog_apply (p : SchemeComplexPoint f) :
    sectionsMaxLog f n E b N t HM p =
      Finset.univ.sup' Finset.univ_nonempty fun k => HM.sectionLogNormSq b N (t k) p :=
  Finset.sup'_apply _ _ _

/-- `Φ ∈ PSH(X, N c₁(M, h_M))`. -/
theorem isThetaPshPotential_sectionsMaxLog (ht : ∀ k, t k ≠ 0) :
    IsThetaPshPotential ((N : ℝ) • HM.curvature b).val (sectionsMaxLog f n E b N t HM) := by
  refine Finset.sup'_induction _ _ (fun u hu w hw => ?_)
    fun k _ => HM.isThetaPshPotential_sectionLogNormSq b N (t k) (ht k)
  exact SGPT.Foundations.Analysis.Pending.IsThetaPshPotential.max hu hw

/-- **Local analytic presentation of `Φ`**: near every complex point `x`, in a frame domain of
`b`, `Φ = log ∑_k |g_k|² + R` with `g_k` the frame coefficients of the `t_k` and `R` bounded. -/
theorem exists_local_presentation (x : SchemeComplexPoint f) :
    ∃ (i : b.I) (_hx : schemeComplexPointImage f x ∈ b.opens i) (U : Set (SchemeComplexPoint f))
      (R : SchemeComplexPoint f → ℝ) (C : ℝ),
      IsOpen U ∧ x ∈ U ∧ U ⊆ schemeComplexPointImage f ⁻¹' (b.opens i : Set X) ∧
        (∀ y ∈ U, |R y| ≤ C) ∧
        ∀ y ∈ U, sectionsMaxLog f n E b N t HM y =
          generatorLog (fun j => frameCoeff f n E b N t i ((Fintype.equivFin ι).symm j)) y +
            (R y : EReal) := by
  set i := (b.covers (schemeComplexPointImage f x)).choose with hi
  have hx : schemeComplexPointImage f x ∈ b.opens i := (b.covers _).choose_spec
  set D : Set (SchemeComplexPoint f) := schemeComplexPointImage f ⁻¹' (b.opens i : Set X) with hD
  have hDo : IsOpen D := (b.opens i).isOpen.preimage (schemeComplexPointImage_continuous f)
  set w : SchemeComplexPoint f → ℝ := HM.frameNormSq (b.frame i) with hw
  -- continuity of the frame weight at `x`
  have hwcont : ContinuousAt w x := by
    set e := complexChartAt (n := n) x with he
    have hsrc : x ∈ e.val.source := mem_complexChartAt_source x
    have hO : IsOpen (e.val.target ∩ e.val.symm ⁻¹' D) := e.val.isOpen_inter_preimage_symm hDo
    have hz : e.val x ∈ e.val.target ∩ e.val.symm ⁻¹' D :=
      ⟨e.val.map_source hsrc, by simp only [mem_preimage, e.val.left_inv hsrc]; exact hx⟩
    have h1 : ContinuousAt (fun z => w (e.val.symm z)) (e.val x) :=
      (HM.smooth (b.frame i) e).continuousOn.continuousAt (hO.mem_nhds hz)
    have h2 : ContinuousAt ((fun z => w (e.val.symm z)) ∘ e.val) x :=
      h1.comp (e.val.continuousAt hsrc)
    refine h2.congr ?_
    filter_upwards [e.val.open_source.mem_nhds hsrc] with p hp
    simp only [Function.comp_apply, e.val.left_inv hp]
  have hwpos : 0 < w x := HM.positive (b.frame i) x hx
  have hlog : ContinuousAt (fun p => Real.log (w p)) x := hwcont.log hwpos.ne'
  set c₀ := Real.log (w x) with hc₀
  set V : Set (SchemeComplexPoint f) := {p | p ∈ D ∧ |Real.log (w p) - c₀| < 1} with hV
  have hVn : V ∈ 𝓝 x := by
    have h2 : {p | |Real.log (w p) - c₀| < 1} ∈ 𝓝 x := by
      filter_upwards [hlog.preimage_mem_nhds (Metric.ball_mem_nhds c₀ one_pos)] with p hp
      simpa [Real.dist_eq] using hp
    filter_upwards [hDo.mem_nhds hx, h2] with p h1 h2 using ⟨h1, h2⟩
  set g : Fin (Fintype.card ι) → SchemeComplexPoint f → ℂ :=
    fun j => frameCoeff f n E b N t i ((Fintype.equivFin ι).symm j) with hg
  set R : SchemeComplexPoint f → ℝ := fun p =>
    maxSumDefect (fun k => frameCoeff f n E b N t i k p) + N * Real.log (w p) with hR
  refine ⟨i, hx, interior V, R, Real.log (Fintype.card ι) + N * (|c₀| + 1), isOpen_interior,
    mem_interior_iff_mem_nhds.mpr hVn, fun y hy => (interior_subset hy).1, fun y hy => ?_,
    fun y hy => ?_⟩
  · have hyV := interior_subset hy
    have h1 := abs_maxSumDefect_le (fun k => frameCoeff f n E b N t i k y)
    have h2 : |Real.log (w y)| ≤ |c₀| + 1 := by
      have := hyV.2
      calc |Real.log (w y)| = |(Real.log (w y) - c₀) + c₀| := by ring_nf
        _ ≤ |Real.log (w y) - c₀| + |c₀| := abs_add_le _ _
        _ ≤ |c₀| + 1 := by linarith
    calc |R y| ≤ |maxSumDefect (fun k => frameCoeff f n E b N t i k y)| + |N * Real.log (w y)| :=
          abs_add_le _ _
      _ ≤ Real.log (Fintype.card ι) + N * (|c₀| + 1) := by
          rw [abs_mul, Nat.abs_cast]
          gcongr
  · have hyD : y ∈ D := (interior_subset hy).1
    rw [sectionsMaxLog_apply]
    have hframe : ∀ k, HM.sectionLogNormSq b N (t k) y =
        SGPT.Foundations.Analysis.logNormSq (frameCoeff f n E b N t i k y) +
          (((N : ℝ) * Real.log (w y) : ℝ) : EReal) := fun k =>
      HM.sectionLogNormSq_frame b (b.frame i) N (t k) y hyD
    simp_rw [hframe]
    rw [sup'_logNormSq_add, log_sup'_eq_add_maxSumDefect, generatorLog_eq_log_sum, add_assoc,
      ← EReal.coe_add]
    have hsum : ∑ j, ‖g j y‖ ^ 2 = ∑ k, ‖frameCoeff f n E b N t i k y‖ ^ 2 :=
      (Fintype.equivFin ι).symm.sum_comp (fun k => ‖frameCoeff f n E b N t i k y‖ ^ 2)
    rw [hsum]

/-- The frame coefficients are holomorphic on the frame domain. -/
theorem mdifferentiableOn_frameCoeff (i : b.I) {U : Set (SchemeComplexPoint f)}
    (hUi : U ⊆ schemeComplexPointImage f ⁻¹' (b.opens i : Set X)) (k : ι) :
    MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (frameCoeff f n E b N t i k) U := fun _y hy =>
  ((frameCoeff_holomorphicAt f n E b N t i k (hUi hy)).mdifferentiableAt).mdifferentiableWithinAt

/-- **The easy inclusion** `(𝔟^j)^an ⊆ 𝓘(jΦ)` for `j ≥ 1`. -/
theorem analytificationIdeal_pow_le_multiplierIdeal (ht : ∀ k, t k ≠ 0) {j : ℕ} (hj : 0 < j) :
    (analytificationIdeal f n E (sectionsIdeal b N t ^ j)).Le
      (multiplierIdeal (n := n) (j : ℝ) (sectionsMaxLog f n E b N t HM)) := by
  intro x F hF
  have hΦ := isThetaPshPotential_sectionsMaxLog f n E b N t HM ht
  have hjR : (0 : ℝ) < j := by exact_mod_cast hj
  have hcoh := SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine
    hΦ.quasiPshPotential hjR
  obtain ⟨i, hx, U, R, C, hU, hxU, hUi, hRC, heq⟩ := exists_local_presentation f n E b N t HM x
  have hFmk := (mem_analytificationIdeal_iff_mk f n E _ x hF.1).mp hF
  rw [anGerms_pow f n E _ x hj, anGerms_sectionsIdeal f n E b N t i hx] at hFmk
  have hprod : ∀ β : Fin j → ι,
      ∏ l, NativeHolGerm.mk (frameCoeff f n E b N t i (β l))
        (frameCoeff_holomorphicAt f n E b N t i (β l) hx) ∈
      spanGerms (n := n) ((multiplierIdeal (n := n) (j : ℝ) (sectionsMaxLog f n E b N t HM)).mem x)
        x := by
    intro β
    have hmem := prod_mem_multiplierIdeal (n := n) hΦ.quasiPshPotential.1 hU
      (fun j' => mdifferentiableOn_frameCoeff f n E b N t i hUi ((Fintype.equivFin ι).symm j'))
      hRC heq hxU hj (fun l => Fintype.equivFin ι (β l))
    simp only [Equiv.symm_apply_apply] at hmem
    rw [← mk_prod f n Finset.univ (fun l => frameCoeff_holomorphicAt f n E b N t i (β l) hx)]
    exact mk_mem_spanGerms _ hmem
  have hle := pow_span_le_of_prod_mem (fun k => NativeHolGerm.mk (frameCoeff f n E b N t i k)
    (frameCoeff_holomorphicAt f n E b N t i k hx)) j _ hprod
  exact SGPT.Foundations.Analysis.Pending.GermIdealTotalTransform.mem_of_isInSpanAt_mem hcoh
    (isInSpanAt_of_mk_mem_spanGerms hF.1 (hle hFmk))

/-- **Skoda's inclusion** `𝓘((j + n)Φ) ⊆ (𝔟^j)^an` for `j ≥ 1` (dimension `n > 0`). -/
theorem multiplierIdeal_le_analytificationIdeal_pow (hn : 0 < n) (ht : ∀ k, t k ≠ 0) {j : ℕ}
    (hj : 0 < j) :
    (multiplierIdeal (n := n) ((j + n : ℕ) : ℝ) (sectionsMaxLog f n E b N t HM)).Le
      (analytificationIdeal f n E (sectionsIdeal b N t ^ j)) := by
  intro x F hF
  have hΦ := isThetaPshPotential_sectionsMaxLog f n E b N t HM ht
  obtain ⟨i, hx, U, R, C, hU, hxU, hUi, hRC, heq⟩ := exists_local_presentation f n E b N t HM x
  set g : Fin (Fintype.card ι) → SchemeComplexPoint f → ℂ :=
    fun j' => frameCoeff f n E b N t i ((Fintype.equivFin ι).symm j') with hg
  have hgU : ∀ j', MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (g j') U := fun j' =>
    mdifferentiableOn_frameCoeff f n E b N t i hUi ((Fintype.equivFin ι).symm j')
  have hsk := SGPT.Okounkov.TranscendentalSkoda.manifoldSkodaStatement.{0} n (SchemeComplexPoint f) hn _ hΦ.quasiPshPotential.1
    (Fintype.card ι) g U hU hgU R C hRC heq x hxU n j le_rfl F
  obtain ⟨h, hh, hFeq⟩ := hsk.mp hF
  have hgx : ∀ j', HolomorphicAt n (g j') x := fun j' =>
    frameCoeff_holomorphicAt f n E b N t i ((Fintype.equivFin ι).symm j') hx
  have hgmem : ∀ j', NativeHolGerm.mk (g j') (hgx j') ∈ anGerms f n E (sectionsIdeal b N t) x := by
    intro j'
    rw [anGerms_sectionsIdeal f n E b N t i hx]
    exact Ideal.subset_span ⟨(Fintype.equivFin ι).symm j', rfl⟩
  have hP : ∀ β : Fin j → Fin (Fintype.card ι),
      HolomorphicAt n (fun z => ∏ l, g (β l) z) x := fun β =>
    holomorphicAt_prod Finset.univ fun l _ => hgx (β l)
  have hterm : ∀ β : Fin j → Fin (Fintype.card ι),
      HolomorphicAt n (fun z => (∏ l, g (β l) z) * h β z) x := fun β => (hP β).mul (hh β).1
  have hsum : HolomorphicAt n (fun z => ∑ β, (∏ l, g (β l) z) * h β z) x :=
    HolomorphicAt.sum Finset.univ fun β _ => hterm β
  have hmk : NativeHolGerm.mk F hF.1 = NativeHolGerm.mk _ hsum :=
    NativeHolGerm.mk_eq_mk_iff.mpr hFeq
  rw [mem_analytificationIdeal_iff_mk f n E _ x hF.1, hmk, mk_sum f n Finset.univ hterm hsum,
    anGerms_pow f n E _ x hj]
  refine Ideal.sum_mem _ fun β _ => ?_
  rw [mk_mul' f n (hP β) (hh β).1, mk_prod f n Finset.univ (fun l => hgx (β l))]
  refine Ideal.mul_mem_right _ _ ?_
  have := Ideal.prod_mem_prod (s := Finset.univ) (I := fun _ : Fin j =>
    anGerms f n E (sectionsIdeal b N t) x) (x := fun l => NativeHolGerm.mk (g (β l)) (hgx (β l)))
    fun l _ => hgmem (β l)
  rwa [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at this

end Sections

/-! ### Valuations and the analytification -/

section Values

variable [IsProjective f] [IsIntegral X]

local instance gfImProper : IsProper f := (SGPT.Foundations.Envelope.ProjectiveFactorizationRingIso.of_isProjective f).isProper
local instance gfImPointManifold'' : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

variable {M : X.Modules} (b : LineBundleAtlas M) (N : ℕ) {ι : Type} [Fintype ι] [Nonempty ι]
  (t : ι → bundlePowerGlobalSections M N) (HM : SchemeLineBundleMetric f n E M)

include E in
theorem idealVal_pow (v : BerkovichPoint f) (𝔟 : X.IdealSheafData) (j : ℕ) :
    v.idealVal (𝔟 ^ j) = j * v.idealVal 𝔟 := by
  have := E.locallyOfFiniteType
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  induction j with
  | zero => rw [pow_zero, Nat.cast_zero, zero_mul]; exact BerkovichPoint.idealVal_top v
  | succ j ih => rw [pow_succ, BerkovichPoint.idealVal_mul, ih, Nat.cast_succ, add_mul, one_mul]

/-- `v(𝓘(jΦ)) ≤ j v(𝔟)` for `j ≥ 1`. -/
theorem multiplierIdealVal_le (ht : ∀ k, t k ≠ 0) {j : ℕ} (hj : 0 < j) (v : BerkovichPoint f) :
    v.multiplierIdealVal n E (sectionsMaxLog f n E b N t HM) j ≤
      j * v.idealVal (sectionsIdeal b N t) := by
  rw [← idealVal_pow f E v]
  refine BerkovichPoint.idealVal_antitone v ?_
  exact (le_algebraization_analytificationIdeal f n E _).trans
    (algebraization_mono f n E (analytificationIdeal_pow_le_multiplierIdeal f n E b N t HM ht hj))

/-- `j v(𝔟) ≤ v(𝓘((j + n)Φ))` for `j ≥ 1` (Skoda). -/
theorem le_multiplierIdealVal (hn : 0 < n) (ht : ∀ k, t k ≠ 0) {j : ℕ} (hj : 0 < j)
    (v : BerkovichPoint f) :
    j * v.idealVal (sectionsIdeal b N t) ≤
      v.multiplierIdealVal n E (sectionsMaxLog f n E b N t HM) (j + n) := by
  rw [← idealVal_pow f E v]
  refine BerkovichPoint.idealVal_antitone v ?_
  have h := algebraization_mono f n E
    (multiplierIdeal_le_analytificationIdeal_pow f n E b N t HM hn ht hj)
  rwa [algebraization_analytificationIdeal] at h

/-- `v(∑_k (t_k)) = min_k v(t_k)`. -/
theorem idealVal_sectionsIdeal (v : BerkovichPoint f) :
    v.idealVal (sectionsIdeal b N t) = ⨅ k, toENNReal (powerSectionValue b N (t k) v) := by
  unfold sectionsIdeal
  rw [SGPT.NAPotential.BJModel.idealVal_iSup]
  exact iInf_congr fun k => SGPT.NAPotential.BJ.Assembly.idealVal_sectionZeroIdealSheaf b N (t k) v

/-- **Analytification of `K⁻¹ max_k log |t_k|²`** (dimension `n > 0`): at every `v ∈ X^An`,
`(K⁻¹ Φ)^An(v) = -K⁻¹ v(𝔟)`, `𝔟 = ∑_k (t_k)`. -/
theorem potentialAn_sectionsMaxLog (hn : 0 < n) (ht : ∀ k, t k ≠ 0) {K : ℕ} (hK : 0 < K)
    (v : BerkovichPoint f) :
    potentialAn n E (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * sectionsMaxLog f n E b N t HM p) v =
      -(((v.idealVal (sectionsIdeal b N t) / K : ℝ≥0∞)) : EReal) := by
  set Φ := sectionsMaxLog f n E b N t HM with hΦdef
  set V := v.idealVal (sectionsIdeal b N t) with hV
  have hΦ := isThetaPshPotential_sectionsMaxLog f n E b N t HM ht
  have hψ := SGPT.Okounkov.TranscendentalCore.isThetaPshPotential_nonneg_smul hΦ
    (inv_nonneg.mpr (Nat.cast_nonneg (α := ℝ) K))
  have hA := SGPT.GAGA.H0S.multiplierIdealAlgebraic f E n
  have htend := BerkovichPoint.tendsto_potentialVal_of_multiplierIdealAlgebraic n E hA hψ v
  have hKR : (0 : ℝ) < K := by exact_mod_cast hK
  -- `v(𝓘(K m · K⁻¹Φ)) = v(𝓘(mΦ))`
  have hscale : ∀ m : ℕ, 0 < m → v.multiplierIdealVal n E
      (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * Φ p) (K * m) = v.multiplierIdealVal n E Φ m := by
    intro m hm
    unfold BerkovichPoint.multiplierIdealVal
    rw [SGPT.NAPotential.BJ.Assembly.multiplierIdeal_coe_mul
      (by exact_mod_cast Nat.mul_pos hK hm) (inv_pos.mpr hKR)]
    congr 3
    push_cast
    field_simp
  set s : ℕ → ℕ := fun j => K * (j + n) with hs
  have hstend : Tendsto s atTop atTop :=
    tendsto_atTop_mono (fun j => by
      show j ≤ K * (j + n)
      nlinarith) tendsto_id
  have hlim := htend.comp hstend
  have hK0 : (K : ℝ≥0∞) ≠ 0 := by exact_mod_cast hK.ne'
  have hKt : (K : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top K
  have hcast : ∀ j : ℕ, ((s j : ℕ) : ℝ≥0∞) = (K : ℝ≥0∞) * ((j : ℝ≥0∞) + n) := fun j => by
    simp only [hs]; push_cast; ring
  have hsj0 : ∀ j : ℕ, (K : ℝ≥0∞) * ((j : ℝ≥0∞) + n) ≠ 0 := fun j =>
    mul_ne_zero hK0 (by
      have : (0 : ℝ≥0∞) < n := by exact_mod_cast hn
      exact (lt_of_lt_of_le this le_add_self).ne')
  have hsjt : ∀ j : ℕ, (K : ℝ≥0∞) * ((j : ℝ≥0∞) + n) ≠ ⊤ := fun j =>
    ENNReal.mul_ne_top hKt (ENNReal.add_ne_top.mpr ⟨ENNReal.natCast_ne_top j, ENNReal.natCast_ne_top n⟩)
  -- upper bound
  have hupper : ∀ j : ℕ, 0 < j → (fun k : ℕ => v.multiplierIdealVal n E
      (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * Φ p) k / k) (s j) ≤ V / K := by
    intro j hj
    simp only
    rw [hscale _ (Nat.add_pos_right j hn), hcast, ENNReal.div_le_iff (hsj0 j) (hsjt j)]
    calc v.multiplierIdealVal n E Φ (j + n) ≤ ((j + n : ℕ) : ℝ≥0∞) * V :=
          multiplierIdealVal_le f n E b N t HM ht (Nat.add_pos_right j hn) v
      _ = V / K * (K * ((j : ℝ≥0∞) + n)) := by
          rw [← mul_assoc, ENNReal.div_mul_cancel hK0 hKt]
          push_cast
          ring
  -- lower bound
  have hlower : ∀ j : ℕ, 0 < j → (j : ℝ≥0∞) / ((j : ℝ≥0∞) + n) * (V / K) ≤
      (fun k : ℕ => v.multiplierIdealVal n E
        (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * Φ p) k / k) (s j) := by
    intro j hj
    simp only
    rw [hscale _ (Nat.add_pos_right j hn), hcast,
      ENNReal.le_div_iff_mul_le (Or.inl (hsj0 j)) (Or.inl (hsjt j))]
    have hjn0 : (j : ℝ≥0∞) + n ≠ 0 := by
      have : (0 : ℝ≥0∞) < n := by exact_mod_cast hn
      exact (lt_of_lt_of_le this le_add_self).ne'
    have hjnt : (j : ℝ≥0∞) + n ≠ ⊤ :=
      ENNReal.add_ne_top.mpr ⟨ENNReal.natCast_ne_top j, ENNReal.natCast_ne_top n⟩
    calc (j : ℝ≥0∞) / ((j : ℝ≥0∞) + n) * (V / K) * (K * ((j : ℝ≥0∞) + n))
        = ((j : ℝ≥0∞) / ((j : ℝ≥0∞) + n) * ((j : ℝ≥0∞) + n)) * (V / K * K) := by ring
      _ = j * V := by rw [ENNReal.div_mul_cancel hjn0 hjnt, ENNReal.div_mul_cancel hK0 hKt]
      _ ≤ v.multiplierIdealVal n E Φ (j + n) := le_multiplierIdealVal f n E b N t HM hn ht hj v
  -- `j / (j + n) → 1`
  have hfrac : Tendsto (fun j : ℕ => (j : ℝ≥0∞) / ((j : ℝ≥0∞) + n)) atTop (𝓝 1) := by
    have hR := tendsto_natCast_div_add_atTop (𝕜 := ℝ) (n : ℝ)
    have h1 := (ENNReal.continuous_ofReal.tendsto 1).comp hR
    rw [ENNReal.ofReal_one] at h1
    refine h1.congr fun j => ?_
    have hpos : (0 : ℝ) < (j : ℝ) + n := by
      have : (0 : ℝ) < n := by exact_mod_cast hn
      positivity
    simp only [Function.comp_apply]
    rw [ENNReal.ofReal_div_of_pos hpos, ENNReal.ofReal_natCast,
      ENNReal.ofReal_add (Nat.cast_nonneg _) (Nat.cast_nonneg _), ENNReal.ofReal_natCast,
      ENNReal.ofReal_natCast]
  have hlow := ENNReal.Tendsto.mul_const hfrac (b := V / K) (Or.inl one_ne_zero)
  rw [one_mul] at hlow
  have hle1 : v.potentialVal n E (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * Φ p) ≤ V / K :=
    le_of_tendsto hlim (Filter.eventually_atTop.mpr ⟨1, fun j hj => hupper j hj⟩)
  have hle2 : V / K ≤ v.potentialVal n E (fun p => (((K : ℝ)⁻¹ : ℝ) : EReal) * Φ p) :=
    le_of_tendsto_of_tendsto hlow hlim (Filter.eventually_atTop.mpr ⟨1, fun j hj => hlower j hj⟩)
  unfold potentialAn
  rw [le_antisymm hle1 hle2]

end Values

end SGPT.NAPotential.BJ.GfIm
