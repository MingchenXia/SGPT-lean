import SGPT.Checks.Comparison.BJPointBridge

/-! # Topology of the native and additive Berkovich point spaces

Both topologies are generated by actual scheme support opens and actual local
regular-section evaluations. The residue valuation dictionary therefore
identifies these topologies without an affine-cover or projectivity hypothesis.
-/
set_option autoImplicit false
noncomputable section
namespace SGPT.NAPotential.BJ

open AlgebraicGeometry CategoryTheory Topology Set
open SGPT.NAPotential.Berkovich
open SGPT.Foundations.Envelope.Berkovich
open scoped NNReal

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))

/-- The inverse point map preserves the actual real value of every local section. -/
theorem ofNative_sectionAbs (v : RelativeSchemeValuedPoint (1 : Valuation ℂ ℝ≥0) f)
    (U : X.Opens) (hv : v.1.point ∈ U) (s : Γ(X, U)) :
    BerkovichPoint.expNeg ((ofNative f v).sectionVal U hv s) =
      (SchemeValuedPoint.eval v.1 U hv s : ℝ) := by
  change (expNegNN (negLogNN (v.1.residueVal (X.evaluation U v.1.point hv s))) : ℝ) = _
  rw [expNegNN_negLogNN]
  rfl

/-- The book-to-native point map is continuous for the actual generated topologies. -/
theorem continuous_toNative : Continuous (toNative f) := by
  apply Continuous.subtype_mk
  apply continuous_generateFrom_iff.mpr
  intro S hS
  rcases hS with ⟨U, rfl⟩ | ⟨U, s, V, hV, rfl⟩
  · exact BerkovichPoint.isOpen_supportOpen U
  · obtain ⟨W, hW, hWV⟩ := isOpen_induced_iff.mp hV
    rw [← hWV]
    have heq : (fun v : BerkovichPoint f => (toNative f v).1) ⁻¹'
        SchemeValuedPoint.sectionOpen U s ((fun r : ℝ≥0 => (r:ℝ)) ⁻¹' W) =
        BerkovichPoint.sectionPreimage U s W := by
      ext v
      simp only [mem_preimage, SchemeValuedPoint.sectionOpen,
        BerkovichPoint.sectionPreimage, mem_ofPred_eq, toNative_point]
      constructor
      · rintro ⟨hv,h⟩
        refine ⟨hv,?_⟩
        change ((pointEquiv f v).1.eval U hv s:ℝ)∈W at h
        rw [pointEquiv_eval f v U hv s] at h
        exact h
      · rintro ⟨hv,h⟩
        refine ⟨hv,?_⟩
        change ((pointEquiv f v).1.eval U hv s:ℝ)∈W
        rw [pointEquiv_eval f v U hv s]
        exact h
    change IsOpen ((fun v : BerkovichPoint f => (toNative f v).1) ⁻¹'
      SchemeValuedPoint.sectionOpen U s ((fun r : ℝ≥0 => (r:ℝ)) ⁻¹' W))
    rw [heq]
    exact BerkovichPoint.isOpen_sectionPreimage U s hW

/-- The native-to-book point map is continuous for the actual generated topologies. -/
theorem continuous_ofNative : Continuous (ofNative f) := by
  apply continuous_generateFrom_iff.mpr
  intro S hS
  rcases hS with ⟨U, rfl⟩ | ⟨U, s, W, hW, rfl⟩
  · exact (SchemeValuedPoint.isOpen_point_preimage U).preimage continuous_subtype_val
  · have heq : ofNative f ⁻¹' BerkovichPoint.sectionPreimage U s W =
        Subtype.val ⁻¹' SchemeValuedPoint.sectionOpen U s ((↑) ⁻¹' W) := by
      ext v
      simp only [mem_preimage, BerkovichPoint.sectionPreimage,
        SchemeValuedPoint.sectionOpen, mem_ofPred_eq, ofNative_support]
      constructor
      · rintro ⟨hv, h⟩
        exact ⟨hv, by simpa only [ofNative_sectionAbs f v U hv s] using h⟩
      · rintro ⟨hv, h⟩
        exact ⟨hv, by simpa only [ofNative_sectionAbs f v U hv s] using h⟩
    rw [heq]
    exact (SchemeValuedPoint.isOpen_sectionOpen U s _
      (hW.preimage continuous_subtype_val)).preimage continuous_subtype_val

/-- Canonical homeomorphism of the two actual Berkovich point spaces. -/
def pointHomeomorph : BerkovichPoint f ≃ₜ RelativeSchemeValuedPoint (1 : Valuation ℂ ℝ≥0) f where
  __ := pointEquiv f
  continuous_toFun := continuous_toNative f
  continuous_invFun := continuous_ofNative f

end SGPT.NAPotential.BJ
