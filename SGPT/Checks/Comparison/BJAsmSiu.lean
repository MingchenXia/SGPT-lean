/-!
# Algebraic models of multiplier ideals generated by finitely many sections

Infrastructure for `lma:varphian` (`chapter_NApotential.tex`, *The algebraic setting*). The book's
proof uses Siu's uniform global generation: finitely many global sections `s_i` generate
`H^b ⊗ L^k ⊗ 𝓘(kφ)`, so that `v(𝓘(kφ)) = min_i v(s_i)`. Here, for a metrized algebraic line bundle
`(M, h_M)` on the smooth projective `X`, a Kähler background `ω` and `δ > 0`, there is `k₀` such
that for every `k ≥ k₀` and every `ψ ∈ PSH(X, c₁(M, h_M) - δω)` the algebraic model
`alg 𝓘(kψ)` of the multiplier ideal (`SGPT.NAPotential.Berkovich.algebraization`) is the sum of
the zero ideals of finitely many algebraic global sections of `M^{⊗ k}`
(`exists_sections_algebraization_eq`).

Proof: Siu's theorem (`SGPT.NAPotential.GAGAMult.siuGlobalGeneration`) generates `𝓘(kψ)_x` by
the frame coefficients of the holomorphic sections of `(M^an)^{⊗ k}` with finite `L²(e^{-kψ})`
norm. These span a finite-dimensional space; a finite linearly independent subfamily spans the
same space (`exists_linearIndependent`), and its members are algebraic by GAGA
(`SGPT.GAGA.H0L.schemeSectionsAlgebraic`). Hence `𝓘(kψ) ⊆ 𝔞^an` for the sum `𝔞` of their zero
ideals, and `alg 𝓘(kψ) ⊆ alg(𝔞^an) = 𝔞` (`algebraization_analytificationIdeal`); conversely
each zero ideal lies in `alg 𝓘(kψ)` (`sectionZeroIdealSheaf_le_algebraization`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option linter.unusedSectionVars false

noncomputable section

namespace SGPT.NAPotential.BJ.Assembly

open Set Filter Bundle MeasureTheory
open scoped Topology Manifold ContDiff ENNReal
open AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.PositiveClasses
open SGPT.Bergman.TensorDictionaryDraft SGPT.Bergman.CompactHolomorphicSectionsDraft
open HermitianHolomorphicLineBundle SGPT.NAPotential.Berkovich SGPT.NAPotential.GAGAMult
open SGPT.Foundations.Analysis.Pending.ChartwiseGlobalL1 SGPT.PSH.GlobalL2
open SGPT.Foundations.Analysis.Pending.RelativePrincipalizationSpan

/-- Evaluation of a finite sum of holomorphic sections. -/
theorem holomorphicSections_sum_apply {n : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M] {Λ T : HermitianHolomorphicLineBundle.{0, 0} n M} {k : ℕ}
    {ι : Type*} (s : Finset ι) (g : ι → twistedSections Λ T k) (y : M) :
    (∑ j ∈ s, g j) y = ∑ j ∈ s, g j y := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.sum_empty]; rfl
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, ContMDiffSection.coe_add, Pi.add_apply, ih]

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ) [SmoothOfRelativeDimension n f]
  (E : ClosedProjectiveEmbedding f) {M : X.Modules} (b : LineBundleAtlas M)
  (HM : SchemeLineBundleMetric f n E M)

local instance asmSiuPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance asmSiuPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

variable [IsSeparated f] [QuasiCompact f]

local instance asmSiuPointManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

variable [MeasurableSpace (SchemeComplexPoint f)] [BorelSpace (SchemeComplexPoint f)]
  [CompactSpace (SchemeComplexPoint f)]

/-- `e^{-1 · (kψ)} = e^{-kψ}`. -/
theorem multiplierWeight_one_coe_mul (c : ℝ) (t : EReal) :
    multiplierWeight 1 ((c : EReal) * t) = multiplierWeight c t := by
  unfold multiplierWeight
  rw [EReal.coe_one, one_mul]

/-- **Algebraic models of multiplier ideals are generated by finitely many sections.** For a
metrized algebraic line bundle `(M, h_M)`, a Kähler background `ω` and `δ > 0` there is `k₀` such
that for every `k ≥ k₀` and every `ψ ∈ PSH(X, c₁(M, h_M) - δω)`, `alg 𝓘(kψ) = ∑_i 𝔟_{σ_i}` for
finitely many global sections `σ_i` of `M^{⊗ k}` (Siu's uniform global generation and GAGA). -/
theorem exists_sections_algebraization_eq (ωb : KahlerBackground n (SchemeComplexPoint f))
    {δ : ℝ} (hδ : 0 < δ) :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ ψ : SchemeComplexPoint f → EReal,
      IsThetaPshPotential (HM.curvature b - δ • ωb.form).val ψ →
      ∃ (ι : Type) (_ : Fintype ι) (σ : ι → bundlePowerGlobalSections M k),
        algebraization f n E (multiplierIdeal (n := n) (k : ℝ) ψ) =
          ⨆ i, sectionZeroIdealSheaf (b.tensorPower k) (σ i) := by
  classical
  let μ := IntegrationCurrent.kahlerVolume ωb
  have hμ : IsSmoothPositiveVolume (n := n) μ :=
    KahlerVolumeSmoothPositive.isSmoothPositiveVolume_kahlerVolume ωb
  obtain ⟨k₀, hk₀⟩ := siuGlobalGeneration (n := n) (X := SchemeComplexPoint f) inferInstance ωb μ
    hμ (schemeHermitianLineBundle f n E b HM) unit
    (isSourceSmoothHermitianMetric_schemeHermitianLineBundle f n E b HM)
    isSourceSmoothHermitianMetric_unit (HM.curvature b)
    (isOwnFirstChernForm_schemeHermitianLineBundle f n E b HM) δ hδ
  refine ⟨max k₀ 1, fun k hk ψ hψ => ?_⟩
  have hk0 : k₀ ≤ k := le_of_max_le_left hk
  have hk1 : 0 < k := le_of_max_le_right hk
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk1
  let Λ := schemeHermitianLineBundle f n E b HM
  let S : Set (twistedSections Λ unit k) :=
    {s | ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight (k : ℝ) (ψ y) ∂μ < ⊤}
  have : FiniteDimensional ℂ (twistedSections Λ unit k) :=
    SGPT.Bergman.TensorDictionaryDraft.HermitianHolomorphicLineBundle.twistedSections_finiteDimensional
      Λ unit k
  obtain ⟨B, hBS, hspan, hli⟩ := exists_linearIndependent ℂ S
  let : Fintype B := hli.setFinite.fintype
  have hgaga := SGPT.GAGA.H0L.schemeSectionsAlgebraic (f := f) (E := E) (n := n) (a := b)
    (H := HM) k
  choose σ hσ using hgaga
  refine ⟨B, inferInstance, fun t => σ t.1, ?_⟩
  set 𝔞 : X.IdealSheafData := ⨆ t : B, sectionZeroIdealSheaf (b.tensorPower k) (σ t.1) with h𝔞
  apply le_antisymm
  · -- `𝓘(kψ) ⊆ 𝔞^an`, hence `alg 𝓘(kψ) ⊆ alg 𝔞^an = 𝔞`
    have hLe : (multiplierIdeal (n := n) (k : ℝ) ψ).Le (analytificationIdeal f n E 𝔞) := by
      intro x g hg
      obtain ⟨i, hi⟩ := b.covers (schemeComplexPointImage f x)
      let e := twistedFrame f n E b HM (b.frame i) k
      have hxe : x ∈ e.val.baseSet := mem_twistedFrame_baseSet f n E b HM (b.frame i) k hi
      have hgen := hk₀ k hk0 ψ hψ x e hxe g hg
      obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVi⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open hi (b.opens i).isOpen
      let V' : X.affineOpens := ⟨V, hV⟩
      have hVi' : (V : X.Opens) ≤ b.opens i := hVi
      have hO : IsOpen (schemeComplexPointImage f ⁻¹' (V : Set X)) :=
        (V' : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f)
      -- the regular function of a basis element near `x`
      let r : B → Γ(X, V) := fun t =>
        X.presheaf.map (homOfLE hVi').op (algCoef (b.frame i) k (σ t.1))
      have hrmem : ∀ t : B, r t ∈ 𝔞.ideal V' := by
        intro t
        have h1 : r t ∈ (sectionZeroIdealSheaf (b.tensorPower k) (σ t.1)).ideal V' :=
          restrict_algCoef_mem_sectionZeroIdeal (b.frame i) hVi' k (σ t.1)
        exact Scheme.IdealSheafData.le_def.mp
          (le_iSup (fun t : B => sectionZeroIdealSheaf (b.tensorPower k) (σ t.1)) t) V' h1
      have hreq : ∀ t : B, ∀ᶠ y in 𝓝 x, e.val.continuousLinearMapAt ℂ y (t.1 y) =
          schemeOpenRegularFunction f n E V (r t) y := by
        intro t
        filter_upwards [hO.mem_nhds hxV] with y hy
        rw [hσ t.1 i y (hVi' hy), schemeOpenRegularFunction_restrict f n E V (b.opens i) hVi' _ hy]
      show IsInSpanAt (n := n) (fun s => ∃ (U : X.affineOpens)
        (_ : schemeComplexPointImage f x ∈ (U : X.Opens)) (r : Γ(X, U)),
          r ∈ 𝔞.ideal U ∧ s = schemeOpenRegularFunction f n E U r) x g
      refine IsInSpanAt.trans ?_ hgen
      rintro _ ⟨s, hs, rfl⟩
      have hsB : s ∈ Submodule.span ℂ B := hspan ▸ Submodule.subset_span hs
      obtain ⟨N, c, g', hsum⟩ := Submodule.mem_span_set'.mp hsB
      have hpt : ∀ y, e.val.continuousLinearMapAt ℂ y (s y) =
          ∑ j, c j * e.val.continuousLinearMapAt ℂ y ((g' j).1 y) := by
        intro y
        rw [← hsum, holomorphicSections_sum_apply]
        simp only [ContMDiffSection.coe_smul, Pi.smul_apply, map_sum, map_smul, smul_eq_mul]
      have hev : (fun y => e.val.continuousLinearMapAt ℂ y (s y)) =ᶠ[𝓝 x]
          fun y => ∑ j, (fun _ => c j) y * schemeOpenRegularFunction f n E V (r (g' j)) y := by
        filter_upwards [Filter.eventually_all.mpr fun j => hreq (g' j)] with y hy
        rw [hpt y]
        exact Finset.sum_congr rfl fun j _ => by rw [hy j]
      refine ⟨?_, N, fun j => schemeOpenRegularFunction f n E V (r (g' j)), fun j _ => c j,
        fun j => ⟨V', hxV, r (g' j), hrmem (g' j), rfl⟩, fun j => holomorphicAt_const _, hev⟩
      refine HolomorphicAt.congr ?_ hev.symm
      refine HolomorphicAt.sum Finset.univ fun j _ => ?_
      exact (holomorphicAt_const _).mul
        (schemeOpenRegularFunction_holomorphicAt f n E V (r (g' j)) x hxV)
    calc algebraization f n E (multiplierIdeal (n := n) (k : ℝ) ψ)
        ≤ algebraization f n E (analytificationIdeal f n E 𝔞) := algebraization_mono f n E hLe
      _ = 𝔞 := algebraization_analytificationIdeal f n E 𝔞
  · -- every zero ideal lies in `alg 𝓘(kψ)`
    refine iSup_le fun t => ?_
    have hψ' := TranscendentalCore.isThetaPshPotential_nonneg_smul hψ hkR.le
    have hcoh : (multiplierIdeal (n := n) 1 (fun y => ((k : ℝ) : EReal) * ψ y)).IsCoherent :=
      SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine
        ⟨hψ'.1.quasiPlurisubharmonic, hψ'.2⟩ one_pos
    have hint : ∫⁻ y, ENNReal.ofReal (‖t.1 y‖ ^ 2) *
        multiplierWeight 1 (((k : ℝ) : EReal) * ψ y) ∂μ < ⊤ := by
      simp only [multiplierWeight_one_coe_mul]
      exact hBS t.2
    have h := sectionZeroIdealSheaf_le_algebraization f n E b HM hμ hψ'.1 hcoh hint (hσ t.1)
    rwa [multiplierIdeal_one_mul f n hkR ψ] at h

end SGPT.NAPotential.BJ.Assembly
