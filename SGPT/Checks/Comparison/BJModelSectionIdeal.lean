import SGPT.Checks.Comparison.BJNativeSectionNorm
import SGPT.Checks.Comparison.BJSectionPowers
import SGPT.Foundations.Envelope.AlgGeom.InvertibleBaseIdealFrameCoefficients
import SGPT.NAPotential.BJModelFlagIdeal
import SGPT.NAPotential.GAGAMult2Faithful

/-!
# Fubini–Study functions and flag ideals: truncations of rational GF functions are piecewise linear

Source: `chapter_NApotential.tex`, the definition of `𝓗^gf_ℚ(L^An)` before `def:BJpshmetric`, and
Boucksom–Jonsson ([BJ22], `references/bj22-trivval`), §2.4–2.5: Definition `defi:FS`,
Proposition `prop:FSideal` and Corollary `cor:FSideal`. Infrastructure for `thm:BJappseq`
(lane BJ-MODEL, steps R4 and R9 of `claude-bj-energy:plan`); blueprint `claude-bj-model.tex`.

For a global section `s` of an invertible sheaf `M`, `log|s| = log|𝔟_s|` where `𝔟_s ⊆ 𝒪_X` is the
zero ideal of `s` (`idealVal_sectionIdeal`, `sectionLogNorm_eq_neg_idealVal`). Hence a function

`φ = m⁻¹ max_j (log|s_j| + λ_j)`,  `s_j ∈ H⁰(X, L^{⊗n})`, `λ_j ∈ ℚ`

(a rational generically finite Fubini–Study function, `rationalGFFunction`) satisfies, for
`c ∈ ℚ` and every `d ≥ 1` such that `d λ_j ∈ ℤ` and `d m c ∈ ℤ`,

`max(φ, c) = (m d)⁻¹ φ_𝔞`,   `𝔞 = (t^{-dmc}) + ∑_j 𝔟_{s_j^d} t^{-dλ_j}`

(`max_rationalGFFunction_eq_phi`), the flag ideal generated by the rational sections
`s_j^d t^{-dλ_j}` of `L^{⊗nd}` and by `t^{-dmc}` ([BJ22, proof of `prop:FSideal`]). In particular
every truncation of a rational GF function is in `PL⁺(X)` (`isPLPos_truncation`). If moreover
`L^{⊗nd}` is globally generated, then `L^{⊗nd} ⊗ 𝔞_λ` is globally generated for every `λ`
(`FlagIdeal.IsGeneratedBy`), which is the condition of [BJ22, `prop:FSideal`] characterizing the
Fubini–Study functions `𝓗(L)` among the functions `m⁻¹ φ_𝔞`.

## Main definitions

* `FlagIdeal.IsGeneratedBy 𝔞 hM`: `M ⊗ 𝔞_λ` is generated by global sections for all `λ`, i.e.
  `𝔞_λ` is the sum of the zero ideals of a set of global sections of `M`.
* `sectionFlagIdeal hM s w κ`: the flag ideal `(t^{-κ}) + ∑_j 𝔟_{s_j} t^{-w_j}`.

## Main results

* `idealVal_sectionIdeal`: `v(𝔟_s) = v(s)`.
* `phi_sectionFlagIdeal_le_iff`: `φ_𝔞 = max(κ, max_j (w_j - v(s_j)))`.
* `isGeneratedBy_sectionFlagIdeal`: the flag ideal is generated by sections of `M` if `M` is
  globally generated.
* `max_rationalGFFunction_eq_phi`, `isPLPos_truncation`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace SGPT.NAPotential.BJModel

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open Scheme.Modules SGPT.Foundations.Schemes
open scoped ENNReal
open SGPT.NAPotential.Berkovich SGPT.NAPotential.Berkovich.BJSections
open SGPT.NAPotential.BJ SGPT.NAPotential.BJ.NativePicard
open SGPT.Foundations.Envelope SGPT.Foundations.Envelope.InvertibleSheafBaseIdeal

local instance (Y : Scheme.{0}) : ∀ U, IsMulCommutative (Y.ringCatSheaf.obj.obj U) :=
  fun U => by
    change IsMulCommutative (Y.presheaf.obj U)
    exact IsMulCommutative.of_comm fun a b => mul_comm a b

variable {X : Scheme.{0}}

/-! ### Values on ideal sheaves through one affine chart

The stalk of an ideal sheaf is generated by its sections over one affine neighbourhood
(`SGPT.NAPotential.Berkovich.stalkIdeal_eq_map`). -/

variable {p : X ⟶ Spec (.of ℂ)} [IsProper p]

/-- `v(𝔞)` computed on generators of `𝔞` over an affine open neighbourhood of the centre. -/
theorem idealVal_eq_iInf_of_ideal_eq_span (v : BerkovichPoint p) (𝔞 : X.IdealSheafData)
    (W : X.affineOpens) (hc : v.center ∈ (W : X.Opens)) {S : Set Γ(X, W)}
    (hS : 𝔞.ideal W = Ideal.span S) :
    v.idealVal 𝔞 = ⨅ r ∈ S, toENNReal (v.sectionVal W
      (v.support_specializes_center.mem_open (W : X.Opens).isOpen hc) r) := by
  have hspan : Ideal.span ((X.presheaf.germ W v.center hc).hom '' S) =
      stalkIdeal 𝔞 v.center := by
    rw [stalkIdeal_eq_map 𝔞 W hc, hS, Ideal.map_span]
  rw [v.idealVal_eq_iInf_of_span 𝔞 hspan, iInf_image]
  refine iInf_congr fun r => iInf_congr fun _ => ?_
  unfold BerkovichPoint.centerValENN
  rw [centerVal_germ_eq_sectionVal v W hc r]

/-! ### The zero ideal of a section -/

/-- **`log|s| = log|𝔟_s|`**: the value of a semi-valuation on the zero ideal `𝔟_s` of a section
`s` of `L^{⊗n}` is the value `v(s)` of the section. -/
theorem idealVal_sectionIdeal {L : X.Modules} (a : LineBundleAtlas L) (n : ℕ)
    (s : bundlePowerGlobalSections L n) (v : BerkovichPoint p) :
    v.idealVal (sectionIdeal (isInvertible_of_atlas (powerAtlas a n)) s) =
      toENNReal (powerSectionValue a n s v) := by
  let i := centerIndex a v
  obtain ⟨W, hW, hcW, hWU⟩ := exists_isAffineOpen_mem_and_subset
    (X := X) (U := a.opens i) (x := v.center) (center_mem_open a v)
  let U : X.affineOpens := ⟨W, hW⟩
  let e : SGPT.Foundations.Schemes.LocalBundleFrame L W :=
    SGPT.Support.ModularCurves.SheafOfModules.restrictOverTrivialization X.ringCatSheaf L (a.opens i)
      (a.frame i) (Over.mk (homOfLE hWU))
  have hideal := InvertibleBaseIdealFrameCoefficients.sectionIdeal_ideal_of_frame
    (isInvertible_of_atlas (powerAtlas a n)) U (e.tensorPower n) s
  rw [idealVal_eq_iInf_of_ideal_eq_span v _ U hcW hideal, powerSectionValue_eq_local a n s v e hcW]
  simp only [Set.mem_singleton_iff, iInf_iInf_eq_left]
  congr 1
  unfold localPowerValue
  congr 1
  change (e.tensorPower n).coefficients (𝟙 W)
    ((1 : Γ(X, W)) • (bundleTensorPower L n).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op s) = _
  rw [one_smul]
  rfl

/-- `toENNReal` of a multiple. -/
theorem toENNReal_nsmul {x : WithTop ℝ} (hx : 0 ≤ x) (k : ℕ) :
    toENNReal (k • x) = k * toENNReal x := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [succ_nsmul, toENNReal_add (nsmul_nonneg hx k) hx, ih]
    push_cast
    ring

/-- The value of a semi-valuation on the zero ideal of the `d`-th power of a section. -/
theorem idealVal_sectionIdeal_tensorPowerSection {L : X.Modules} (a : LineBundleAtlas L) (n : ℕ)
    (s : bundlePowerGlobalSections L n) (d : ℕ) (v : BerkovichPoint p) :
    v.idealVal (sectionIdeal (isInvertible_of_atlas (powerAtlas a (n * d)))
      (tensorPowerSection a n s d)) = d * toENNReal (powerSectionValue a n s v) := by
  rw [idealVal_sectionIdeal, tensorPowerSection_value,
    toENNReal_nsmul (powerSectionValue_nonneg a n s v)]

/-! ### Flag ideals generated by sections -/

/-- **`M ⊗ 𝔞` is globally generated** ([BJ22, `prop:FSideal`]): for every weight `λ` the sheaf
`M ⊗ 𝔞_λ` is generated by its global sections, i.e. `𝔞_λ` is the sum of the zero ideals of a set
of global sections of the invertible sheaf `M`. -/
def FlagIdeal.IsGeneratedBy (𝔞 : FlagIdeal X) {M : X.Modules} (hM : IsInvertible M) : Prop :=
  ∀ l : ℤ, ∃ S : Set Γ(M, ⊤), 𝔞.ideal l = ⨆ s ∈ S, sectionIdeal hM s

section sectionFlagIdeal

variable {M : X.Modules} (hM : IsInvertible M) {ι : Type} [Finite ι] (s : ι → Γ(M, ⊤))
  (w : ι → ℤ) (κ : ℤ)

/-- **The flag ideal `(t^{-κ}) + ∑_j 𝔟_{s_j} t^{-w_j}`** generated by `t^{-κ}` and the rational
sections `s_j t^{-w_j}` of the trivial test configuration of `M` ([BJ22, proof of
`prop:FSideal`]): `𝔞_λ = 𝒪_X` for `λ ≤ κ` and `𝔞_λ = ∑_{w_j ≥ λ} 𝔟_{s_j}` for `λ > κ`. -/
def sectionFlagIdeal : FlagIdeal X where
  ideal l := if l ≤ κ then ⊤ else ⨆ (j : ι) (_ : l ≤ w j), sectionIdeal hM (s j)
  antitone l l' h := by
    show (if l' ≤ κ then ⊤ else ⨆ (j : ι) (_ : l' ≤ w j), sectionIdeal hM (s j)) ≤
      (if l ≤ κ then ⊤ else ⨆ (j : ι) (_ : l ≤ w j), sectionIdeal hM (s j))
    by_cases h' : l' ≤ κ
    · simp [h', h.trans h']
    · rw [if_neg h']
      by_cases h'' : l ≤ κ
      · rw [if_pos h'']; exact le_top
      · rw [if_neg h'']
        exact iSup_mono fun j => iSup_mono' fun hj => ⟨h.trans hj, le_rfl⟩
  exists_eq_top := ⟨κ, fun l hl => by simp [hl]⟩
  exists_eq_bot := by
    obtain ⟨b, hb⟩ := Finite.bddAbove_range w
    refine ⟨max κ b, fun l hl => ?_⟩
    rw [if_neg (not_le.mpr ((le_max_left _ _).trans_lt hl))]
    refine le_bot_iff.mp (iSup_le fun j => iSup_le fun hj => ?_)
    have : w j ≤ b := hb ⟨j, rfl⟩
    exact absurd (hj.trans this) (not_le.mpr ((le_max_right _ _).trans_lt hl))

theorem sectionFlagIdeal_ideal (l : ℤ) :
    (sectionFlagIdeal hM s w κ).ideal l =
      if l ≤ κ then ⊤ else ⨆ (j : ι) (_ : l ≤ w j), sectionIdeal hM (s j) := rfl

/-- `φ_𝔞 = max(κ, max_j (w_j - v(𝔟_{s_j})))` for `𝔞 = (t^{-κ}) + ∑_j 𝔟_{s_j} t^{-w_j}`. -/
theorem phi_sectionFlagIdeal_le_iff (v : BerkovichPoint p) (r : ℝ) :
    (sectionFlagIdeal hM s w κ).phi v ≤ r ↔
      (κ : ℝ) ≤ r ∧ ∀ j, ENNReal.ofReal (w j - r) ≤ v.idealVal (sectionIdeal hM (s j)) := by
  rw [FlagIdeal.phi_le_iff]
  constructor
  · intro h
    have hκ : (κ : ℝ) ≤ r := by
      have h0 := h κ
      rw [sectionFlagIdeal_ideal, if_pos le_rfl, BerkovichPoint.idealVal_top, nonpos_iff_eq_zero,
        ENNReal.ofReal_eq_zero] at h0
      linarith
    refine ⟨hκ, fun j => ?_⟩
    by_cases hj : w j ≤ κ
    · have : (w j : ℝ) ≤ κ := by exact_mod_cast hj
      rw [ENNReal.ofReal_of_nonpos (by linarith)]
      exact zero_le
    · have h0 := h (w j)
      rw [sectionFlagIdeal_ideal, if_neg hj] at h0
      refine h0.trans (v.idealVal_antitone ?_)
      exact le_iSup₂_of_le j le_rfl le_rfl
  · rintro ⟨hκ, h⟩ l
    rw [sectionFlagIdeal_ideal]
    by_cases hl : l ≤ κ
    · have : (l : ℝ) ≤ κ := by exact_mod_cast hl
      rw [if_pos hl, ENNReal.ofReal_of_nonpos (by linarith)]
      exact zero_le
    · rw [if_neg hl, idealVal_iSup]
      refine le_iInf fun j => ?_
      by_cases hj : l ≤ w j
      · have : (l : ℝ) ≤ w j := by exact_mod_cast hj
        rw [iSup_pos hj]
        exact (ENNReal.ofReal_le_ofReal (by linarith)).trans (h j)
      · rw [iSup_neg hj, idealVal_bot]
        exact le_top

/-- If `M` is globally generated, then `M ⊗ 𝔞_λ` is globally generated for all `λ`, for the flag
ideal `𝔞 = (t^{-κ}) + ∑_j 𝔟_{s_j} t^{-w_j}` ([BJ22, `prop:FSideal`]). -/
theorem isGeneratedBy_sectionFlagIdeal (hbase : baseIdeal hM = ⊤) :
    (sectionFlagIdeal hM s w κ).IsGeneratedBy hM := by
  intro l
  by_cases hl : l ≤ κ
  · refine ⟨Set.univ, ?_⟩
    rw [sectionFlagIdeal_ideal, if_pos hl, ← hbase, baseIdeal]
    simp
  · refine ⟨s '' {j | l ≤ w j}, ?_⟩
    rw [sectionFlagIdeal_ideal, if_neg hl, iSup_image]
    rfl

end sectionFlagIdeal

/-! ### Truncations of rational generically finite Fubini–Study functions -/

/-- `-v ≤ r` in `[-∞, ∞)` iff `v ≥ -r` in `[0, ∞]`, for `v ∈ [0, ∞]`. -/
theorem negativeValue_add_le_iff {x : WithTop ℝ} (hx : 0 ≤ x) (l r : ℝ) :
    negativeValue x + ((l : ℝ) : EReal) ≤ (r : EReal) ↔ ENNReal.ofReal (l - r) ≤ toENNReal x := by
  cases x with
  | top => simp
  | coe y =>
    have hy : 0 ≤ y := by exact_mod_cast hx
    rw [negativeValue_coe, toENNReal_coe, ENNReal.ofReal_le_ofReal_iff hy, ← EReal.coe_add,
      EReal.coe_le_coe_iff]
    constructor <;> intro h <;> linarith

/-- Multiplication by a positive real number in `[-∞, ∞]`. -/
theorem coe_mul_le_coe_iff {a : ℝ} (ha : 0 < a) (x : EReal) (r : ℝ) :
    ((a : ℝ) : EReal) * x ≤ (r : EReal) ↔ x ≤ ((r / a : ℝ) : EReal) := by
  induction x with
  | bot => simp [EReal.coe_mul_bot_of_pos ha]
  | top => simp [EReal.coe_mul_top_of_pos ha]
  | coe y =>
    rw [← EReal.coe_mul, EReal.coe_le_coe_iff, EReal.coe_le_coe_iff, le_div_iff₀ ha, mul_comm]

variable {L : X.Modules} {n m : ℕ}

/-- `max(φ, c) ≤ r` for a rational GF function `φ = m⁻¹ max_j (log|s_j| + λ_j)`. -/
theorem max_rationalGFFunction_le_iff (a : LineBundleAtlas L) (D : RationalGFData L n m) (c : ℚ)
    (v : BerkovichPoint p) (r : ℝ) :
    max (rationalGFFunction a D v) ((c : ℝ) : EReal) ≤ (r : EReal) ↔
      (c : ℝ) ≤ r ∧ ∀ j, ENNReal.ofReal ((D.weight j : ℝ) - m * r) ≤
        toENNReal (powerSectionValue a n (D.sections j) v) := by
  have hm : (0 : ℝ) < m := by exact_mod_cast D.denominator_pos
  rw [max_le_iff, EReal.coe_le_coe_iff, and_comm]
  refine and_congr_right fun _ => ?_
  unfold rationalGFFunction finiteMaximum
  rw [coe_mul_le_coe_iff (one_div_pos.mpr hm), iSup_le_iff]
  refine forall_congr' fun j => ?_
  have h : r / (1 / (m : ℝ)) = m * r := by field_simp
  rw [h]
  exact negativeValue_add_le_iff (powerSectionValue_nonneg a n (D.sections j) v) _ _

/-- **Truncations of rational GF functions as functions of flag ideals** ([BJ22, proof of
`prop:FSideal`]): for `φ = m⁻¹ max_j (log|s_j| + λ_j)`, `c ∈ ℚ` and `d ≥ 1` with
`w_j = d λ_j ∈ ℤ` and `κ = m d c ∈ ℤ`,
`max(φ, c) = (m d)⁻¹ φ_𝔞` with `𝔞 = (t^{-κ}) + ∑_j 𝔟_{s_j^d} t^{-w_j}`. -/
theorem max_rationalGFFunction_eq_phi (a : LineBundleAtlas L) (D : RationalGFData L n m) (c : ℚ)
    {d : ℕ} (hd : 0 < d) (w : D.I → ℤ) (hw : ∀ j, (w j : ℝ) = d * (D.weight j : ℝ)) (κ : ℤ)
    (hκ : (κ : ℝ) = m * d * c) (v : BerkovichPoint p) :
    max (rationalGFFunction a D v) ((c : ℝ) : EReal) =
      ((((m * d : ℕ) : ℝ)⁻¹ * (sectionFlagIdeal (isInvertible_of_atlas (powerAtlas a (n * d)))
        (fun j => tensorPowerSection a n (D.sections j) d) w κ).phi v : ℝ) : EReal) := by
  have hm : (0 : ℝ) < m := by exact_mod_cast D.denominator_pos
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  set Φ := (sectionFlagIdeal (isInvertible_of_atlas (powerAtlas a (n * d)))
    (fun j => tensorPowerSection a n (D.sections j) d) w κ).phi v with hΦ
  -- the two sides have the same real upper bounds
  have key : ∀ r : ℝ, max (rationalGFFunction a D v) ((c : ℝ) : EReal) ≤ (r : EReal) ↔
      ((m * d : ℕ) : ℝ)⁻¹ * Φ ≤ r := by
    intro r
    have hmd : (0 : ℝ) < ((m * d : ℕ) : ℝ) := by
      exact_mod_cast Nat.mul_pos D.denominator_pos hd
    rw [max_rationalGFFunction_le_iff, inv_mul_le_iff₀ hmd, hΦ,
      phi_sectionFlagIdeal_le_iff, hκ]
    push_cast
    refine and_congr ?_ (forall_congr' fun j => ?_)
    · constructor
      · intro h
        have : (m : ℝ) * d * c ≤ m * d * r := by gcongr
        linarith
      · intro h
        have h' : (m : ℝ) * d * c ≤ m * d * r := by linarith
        exact le_of_mul_le_mul_left h' (by positivity)
    · rw [idealVal_sectionIdeal_tensorPowerSection, hw]
      have h1 : (d : ℝ) * (D.weight j : ℝ) - (m : ℝ) * d * r =
          d * ((D.weight j : ℝ) - m * r) := by ring
      rw [h1, ENNReal.ofReal_mul hd'.le, ENNReal.ofReal_natCast,
        ENNReal.mul_le_mul_iff_right (by exact_mod_cast hd.ne') (ENNReal.natCast_ne_top d)]
  -- the left-hand side is a real number
  have hne_bot : max (rationalGFFunction a D v) ((c : ℝ) : EReal) ≠ ⊥ :=
    ne_bot_of_le_ne_bot (EReal.coe_ne_bot _) (le_max_right _ _)
  have hne_top : max (rationalGFFunction a D v) ((c : ℝ) : EReal) ≠ ⊤ :=
    max_ne_top (rationalGFFunction_ne_top a D v) (EReal.coe_ne_top _)
  obtain ⟨x, hx⟩ : ∃ x : ℝ, max (rationalGFFunction a D v) ((c : ℝ) : EReal) = (x : EReal) :=
    ⟨_, (EReal.coe_toReal hne_top hne_bot).symm⟩
  rw [hx, EReal.coe_eq_coe_iff]
  apply eq_of_forall_ge_iff
  intro r
  rw [← key r, hx, EReal.coe_le_coe_iff]

/-- A common denominator: for finitely many rational numbers `q_j`, a rational number `q` and
`d₀ ≥ 1` there is a multiple `d ≥ 1` of `d₀` with `d q_j ∈ ℤ` and `d q ∈ ℤ`. -/
theorem exists_common_denominator {ι : Type} [Finite ι] (q : ι → ℚ) (q' : ℚ) (d₀ : ℕ)
    (hd₀ : 0 < d₀) :
    ∃ d : ℕ, 0 < d ∧ d₀ ∣ d ∧ (∃ κ : ℤ, (κ : ℚ) = d * q') ∧ ∀ j, ∃ z : ℤ, (z : ℚ) = d * q j := by
  classical
  cases nonempty_fintype ι
  refine ⟨d₀ * q'.den * ∏ j, (q j).den, ?_, ?_, ?_, ?_⟩
  · exact Nat.mul_pos (Nat.mul_pos hd₀ q'.den_pos) (Finset.prod_pos fun j _ => (q j).den_pos)
  · exact Dvd.intro _ (by rw [mul_assoc])
  · refine ⟨d₀ * q'.num * ∏ j, ((q j).den : ℤ), ?_⟩
    push_cast
    have h := Rat.den_mul_eq_num q'
    calc (d₀ : ℚ) * q'.num * ∏ j, ((q j).den : ℚ)
        = d₀ * (q'.den * q') * ∏ j, ((q j).den : ℚ) := by rw [h]
      _ = d₀ * q'.den * (∏ j, ((q j).den : ℚ)) * q' := by ring
  · intro j
    refine ⟨d₀ * q'.den * ((∏ i ∈ Finset.univ.erase j, ((q i).den : ℤ)) * (q j).num), ?_⟩
    push_cast
    rw [← Finset.mul_prod_erase Finset.univ (fun i => ((q i).den : ℚ)) (Finset.mem_univ j)]
    have h := Rat.den_mul_eq_num (q j)
    calc (d₀ : ℚ) * q'.den * ((∏ i ∈ Finset.univ.erase j, ((q i).den : ℚ)) * (q j).num)
        = d₀ * q'.den * ((∏ i ∈ Finset.univ.erase j, ((q i).den : ℚ)) * ((q j).den * q j)) := by
          rw [h]
      _ = d₀ * q'.den * ((q j).den * ∏ i ∈ Finset.univ.erase j, ((q i).den : ℚ)) * q j := by ring

/-- **Truncations of rational GF functions are in `PL⁺(X)`** ([BJ22, `cor:FSideal`] for the
truncations): `max(φ, c) ∈ PL⁺(X)` for `φ = m⁻¹ max_j (log|s_j| + λ_j)` and `c ∈ ℚ`. -/
theorem isPLPos_truncation (a : LineBundleAtlas L) (D : RationalGFData L n m) (c : ℚ) :
    IsPLPos p fun v => (max (rationalGFFunction a D v) ((c : ℝ) : EReal)).toReal := by
  obtain ⟨d, hd, -, ⟨κ, hκ⟩, hw⟩ := exists_common_denominator D.weight (m * c) 1 one_pos
  choose w hw using hw
  refine ⟨m * d, sectionFlagIdeal (isInvertible_of_atlas (powerAtlas a (n * d)))
    (fun j => tensorPowerSection a n (D.sections j) d) w κ,
    Nat.mul_pos D.denominator_pos hd, fun v => ?_⟩
  have hw' : ∀ j, (w j : ℝ) = d * (D.weight j : ℝ) := fun j => by exact_mod_cast hw j
  have hκ' : (κ : ℝ) = m * d * c := by
    have : (κ : ℚ) = m * d * c := by rw [hκ]; ring
    exact_mod_cast this
  show (max (rationalGFFunction a D v) ((c : ℝ) : EReal)).toReal = _
  rw [max_rationalGFFunction_eq_phi a D c hd w hw' κ hκ' v, EReal.toReal_coe]

end SGPT.NAPotential.BJModel
