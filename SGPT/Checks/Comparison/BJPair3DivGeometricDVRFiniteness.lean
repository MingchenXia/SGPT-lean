/-!
# Finiteness of a DVR from its actual finite curve field

The input is a DVR inside a field, with a genuine uniformizer and an actual
finite extension of the coefficient field generated by that uniformizer.
No essential-finiteness or divisorial/model-realization hypothesis is assumed
for the input DVR. These are algebraic support lemmas, with zero book credit.
-/

noncomputable section

open Polynomial IsLocalRing
open scoped IntermediateField

namespace SGPT.NAPotential.BJ.Pair3Div

open SGPT.Foundations.Envelope.Char0

variable {L K : Type*} [Field L] [Field K] [Algebra L K]
variable (V : Subalgebra L K) (π : V) [Fact (Irreducible π)]
  [IsDiscreteValuationRing V]

/-- The actual curve intersection is essentially finite type, without assuming
that the ambient DVR is essentially finite type. -/
theorem curveDVR_essFiniteType : Algebra.EssFiniteType L (curveDVR V π) := by
  classical
  rw [Algebra.essFiniteType_iff]
  refine ⟨{curvePi V π}, ?_⟩
  intro x
  obtain ⟨Q, S, hS, hx⟩ := (mem_curveDVR_iff V π).1 x.2
  have hm (P : L[X]) : aeval (curvePi V π) P ∈
      Algebra.adjoin L (↑({curvePi V π} : Finset (curveDVR V π)) : Set (curveDVR V π)) := by
    simp only [Finset.coe_singleton]
    exact Polynomial.aeval_mem_adjoin_singleton L (curvePi V π) (p := P)
  refine ⟨aeval (curvePi V π) S, hm S,
    isUnit_aeval_of_mem_maximalIdeal (curvePi_mem_maximalIdeal V π) hS, ?_⟩
  have hs0 : aeval (π : K) S ≠ 0 := by
    rw [← coe_aeval_curvePi V π]
    exact fun h => (isUnit_aeval_of_mem_maximalIdeal
      (curvePi_mem_maximalIdeal V π) hS).ne_zero (Subtype.ext h)
  have heq : x * aeval (curvePi V π) S = aeval (curvePi V π) Q := by
    apply Subtype.ext
    change (x : K) * _ = _
    simp only [coe_aeval_curvePi]
    rw [hx, div_mul_cancel₀ _ hs0]
  rw [heq]
  exact hm Q

variable [IsFractionRing V K] [CharZero L]
  [FiniteDimensional L⟮(π : K)⟯ K]

/-- The actual integral-closure localization equals the given DVR. This is
`Char0.exists_mul_mem_curveB` with the needed finite-field hypothesis supplied
directly, instead of deriving it from essential finiteness of the desired DVR. -/
theorem exists_mul_mem_curveB_of_finite_curveField (x : V) :
    ∃ b s : curveB V π, s ∉ curveIdeal V π ∧ (x : K) * s = b := by
  let : CharZero L⟮(π : K)⟯ :=
    charZero_of_injective_algebraMap (algebraMap L L⟮(π : K)⟯).injective
  let : Algebra.IsSeparable L⟮(π : K)⟯ K :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  let : IsDedekindDomain (curveB V π) :=
    integralClosure.isDedekindDomain (curveDVR V π) L⟮(π : K)⟯ K
  let : IsFractionRing (curveB V π) K :=
    IsIntegralClosure.isFractionRing_of_finite_extension
      (curveDVR V π) L⟮(π : K)⟯ K (curveB V π)
  set n := curveIdeal V π
  have hS : n.primeCompl ≤ nonZeroDivisors (curveB V π) := Ideal.primeCompl_le_nonZeroDivisors n
  set R := Localization.subalgebra.ofField K n.primeCompl hS
  have : IsDiscreteValuationRing R :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (curveB V π)
      (curveIdeal_ne_bot V π) R
  have hmem : ∀ r : R, ∃ a s : curveB V π, s ∉ n ∧ (r : K) = (a : K) * (s : K)⁻¹ := by
    intro r
    obtain ⟨a, s, hs, h⟩ := r.2
    exact ⟨a, s, hs, h⟩
  have hinv : ∀ (s : curveB V π) (hs : s ∉ n),
      ((((isUnit_curveBToV V π hs).unit⁻¹ : Vˣ) : V) : K) = (s : K)⁻¹ := by
    intro s hs
    rw [coe_inv_unit]
    rfl
  have h₁ : ∀ r : R, algebraMap R K r ∈ V := by
    intro r
    obtain ⟨a, s, hs, h⟩ := hmem r
    change (r : K) ∈ V
    rw [h, ← hinv s hs]
    exact V.mul_mem (curveB_le V π a.2) (((isUnit_curveBToV V π hs).unit⁻¹ : Vˣ) : V).2
  have h₂ : ∀ r : R, ¬ IsUnit r → ¬ IsUnit (⟨algebraMap R K r, h₁ r⟩ : V) := by
    intro r hr
    obtain ⟨a, s, hs, h⟩ := hmem r
    have ha : a ∈ n := by
      by_contra ha
      apply hr
      have ha0 : (a : K) ≠ 0 := by
        intro h0
        apply ha
        rw [show a = 0 from Subtype.ext h0]
        exact n.zero_mem
      have hs0 : (s : K) ≠ 0 := by
        intro h0
        apply hs
        rw [show s = 0 from Subtype.ext h0]
        exact n.zero_mem
      refine IsUnit.of_mul_eq_one (⟨(s : K) * (a : K)⁻¹, ⟨s, a, ha, rfl⟩⟩ : R) (Subtype.ext ?_)
      change (r : K) * ((s : K) * (a : K)⁻¹) = 1
      rw [h]
      field_simp
    have heq : (⟨algebraMap R K r, h₁ r⟩ : V) =
        curveBToV V π a * (((isUnit_curveBToV V π hs).unit⁻¹ : Vˣ) : V) := by
      apply Subtype.ext
      change (r : K) = (a : K) * _
      rw [hinv s hs, h]
    rw [heq]
    intro hu
    have hmax : curveBToV V π a * (((isUnit_curveBToV V π hs).unit⁻¹ : Vˣ) : V) ∈
        maximalIdeal V := Ideal.mul_mem_right _ _ ((mem_curveIdeal V π).1 ha)
    exact hmax hu
  obtain ⟨r, hr⟩ := exists_eq_of_dominates (R := R) V h₁ h₂ x x.2
  obtain ⟨a, s, hs, h⟩ := hmem r
  refine ⟨a, s, hs, ?_⟩
  have hs0 : (s : K) ≠ 0 := by
    intro h0
    apply hs
    rw [show s = 0 from Subtype.ext h0]
    exact n.zero_mem
  change (r : K) = (x : K) at hr
  rw [← hr, h, inv_mul_cancel_right₀ hs0]

include π in
/-- A DVR in its actual fraction field is essentially finite type when that
field is finite over the coefficient field generated by a uniformizer. -/
theorem geometricDVR_essFiniteType_of_finite_curveField : Algebra.EssFiniteType L V := by
  let : CharZero L⟮(π : K)⟯ :=
    charZero_of_injective_algebraMap (algebraMap L L⟮(π : K)⟯).injective
  let : Algebra.IsSeparable L⟮(π : K)⟯ K :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  let : Module.Finite (curveDVR V π) (curveB V π) :=
    IsIntegralClosure.finite (curveDVR V π) L⟮(π : K)⟯ K (curveB V π)
  let : Algebra (curveB V π) V := (curveBToV V π).toAlgebra
  let : IsScalarTower (curveDVR V π) (curveB V π) V :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsLocalization (curveIdeal V π).primeCompl V := by
    rw [isLocalization_iff]
    refine ⟨fun y => isUnit_curveBToV V π y.2, ?_, ?_⟩
    · intro x
      obtain ⟨b, s, hs, h⟩ := exists_mul_mem_curveB_of_finite_curveField V π x
      exact ⟨(b, ⟨s, hs⟩), Subtype.ext h⟩
    · intro x y h
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, one_mul]
      exact Subtype.ext (congrArg (fun z : V => (z : K)) h)
  have : Algebra.EssFiniteType (curveB V π) V :=
    .of_isLocalization V (curveIdeal V π).primeCompl
  have : Algebra.EssFiniteType (curveDVR V π) V :=
    .comp (curveDVR V π) (curveB V π) V
  have : Algebra.EssFiniteType L (curveDVR V π) := curveDVR_essFiniteType V π
  let : IsScalarTower L (curveDVR V π) V :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact .comp L (curveDVR V π) V

end SGPT.NAPotential.BJ.Pair3Div
