import SGPT.Checks.Comparison.BJHodgeAlgebra
import SGPT.Support.Principalization.Scheme.IdealSheaf.StalkLe
import SGPT.Support.Principalization.Scheme.IdealSheaf.Invertible

/-!
# Cartier divisors supported on a union of prime Cartier divisors

Step (b) of the reduction of the Hodge-type inequality ([BHJ17, Lemma 6.14]; blueprint
`claude-bj-hodge.tex`): on an integral locally Noetherian scheme `X`, let `C_j` (`j ∈ ι`, finite)
be irreducible closed subsets, none contained in another, whose vanishing ideals `I_j` are
invertible (prime Cartier divisors; on a regular scheme these are the components of a strict
normal crossings divisor, `SGPT.Support.Alterations.Geometry.SNCSubdivisorComponent`). Then every invertible
ideal sheaf `J` whose support lies in `⋃ C_j` is a product of powers of the `I_j`:

  `J = ∏ j, I_j ^ ord J j`   (`eq_prod_pow_ord`),

where `ord J j` is the order of `J` at the generic point of `C_j`, and `ord J j > 0` when
`C_j ⊆ supp J` (`ord_pos`). The proof is stalkwise (`Scheme.IdealSheafData.ext_stalkIdeal`), on the
local rings `𝒪_{X,y} = Γ(X, U)_{p_y}` of an affine open `U ∋ y`: there `J` is locally principal, the
`I_j` with `y ∈ C_j` are generated by prime elements, and the support condition with Krull's
principal ideal theorem gives the factorization (`BJHodgeAlgebra`); the exponents are the orders at
the generic points, which do not depend on `y`.
-/

set_option autoImplicit false

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace SGPT.NAPotential.BJHodge

open Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-! ### Points, primes and supports on an affine open -/

section affine

/-- On an affine open `U ∋ x`, `x` lies in the support of `I` iff `I(U)` is contained in the
prime of `x`. -/
theorem mem_support_iff_le_primeIdealOf (I : X.IdealSheafData) (U : X.affineOpens) {x : X}
    (hx : x ∈ U.1) :
    x ∈ I.support ↔ I.ideal U ≤ (U.2.primeIdealOf ⟨x, hx⟩).asIdeal := by
  rw [mem_support_iff_of_mem hx, Scheme.mem_zeroLocus_iff]
  have hU : IsAffineOpen U.1 := U.2
  refine forall₂_congr fun f _ => ?_
  have h := fromSpec_mem_basicOpen_iff hU (hU.primeIdealOf ⟨x, hx⟩) f
  rw [hU.fromSpec_primeIdealOf ⟨x, hx⟩] at h
  exact (not_congr h).trans not_not

/-- The point of a prime of `Γ(X, U)` lies in `U`, and its prime is the given one. -/
theorem primeIdealOf_fromSpec (U : X.affineOpens) (q : PrimeSpectrum Γ(X, U.1)) :
    ∃ h : U.2.fromSpec q ∈ U.1, U.2.primeIdealOf ⟨U.2.fromSpec q, h⟩ = q := by
  have hU : IsAffineOpen U.1 := U.2
  have h : U.2.fromSpec q ∈ (U.1 : Set X) := by
    rw [← hU.range_fromSpec]
    exact ⟨q, rfl⟩
  refine ⟨h, hU.fromSpec.isOpenEmbedding.injective ?_⟩
  exact hU.fromSpec_primeIdealOf ⟨_, h⟩

/-- The support of the vanishing ideal of a closed set is the set. -/
theorem mem_support_vanishingIdeal (C : Closeds X) {x : X} :
    x ∈ (vanishingIdeal C).support ↔ x ∈ C := by
  show x ∈ ((vanishingIdeal C).support : Set X) ↔ _
  rw [coe_support_vanishingIdeal]
  rfl

/-- The vanishing ideal of a closed set is contained in the prime of each of its points. -/
theorem vanishingIdeal_ideal_le_primeIdealOf (C : Closeds X) (U : X.affineOpens) {y : X}
    (hy : y ∈ U.1) (hyC : y ∈ C) :
    (vanishingIdeal C).ideal U ≤ (U.2.primeIdealOf ⟨y, hy⟩).asIdeal := by
  rw [← mem_support_iff_le_primeIdealOf, mem_support_vanishingIdeal]
  exact hyC

/-- On an affine open containing the generic point `η` of an irreducible closed set `C`, the
vanishing ideal of `C` is the prime of `η`. -/
theorem vanishingIdeal_ideal_eq_primeIdealOf (C : Closeds X) {η : X} (hη : IsGenericPoint η C)
    (U : X.affineOpens) (hηU : η ∈ U.1) :
    (vanishingIdeal C).ideal U = (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal := by
  refine le_antisymm (vanishingIdeal_ideal_le_primeIdealOf C U hηU hη.mem) ?_
  intro f hf
  rw [vanishingIdeal_ideal, PrimeSpectrum.mem_vanishingIdeal]
  intro x hx
  have hU : IsAffineOpen U.1 := U.2
  have hspec : η ⤳ hU.fromSpec x := hη.specializes hx
  have h1 : hU.fromSpec (hU.primeIdealOf ⟨η, hηU⟩) = η := hU.fromSpec_primeIdealOf ⟨η, hηU⟩
  rw [← h1] at hspec
  have h2 := hU.fromSpec.isOpenEmbedding.toIsInducing.specializes_iff.mp hspec
  exact (PrimeSpectrum.le_iff_specializes _ _).mpr h2 hf

end affine

/-! ### The decomposition -/

section decomposition

variable {ι : Type*} [Fintype ι] (C : ι → Closeds X) (hirr : ∀ j, IsIrreducible (C j : Set X))

include hirr in
/-- The generic point of `C_j`. -/
def genPt (j : ι) : X := (hirr j).genericPoint

omit [Fintype ι] in
/-- `genPt C hirr j` is the generic point of `C_j`. -/
theorem isGenericPoint_genPt (j : ι) : IsGenericPoint (genPt C hirr j) (C j) :=
  (hirr j).isGenericPoint_genericPoint (C j).isClosed

open Classical in
/-- The components through a point. -/
def through (y : X) : Finset ι := Finset.univ.filter fun j => y ∈ C j

/-- `j` lies in `through C y` iff `y ∈ C_j`. -/
theorem mem_through {y : X} {j : ι} : j ∈ through C y ↔ y ∈ C j := by
  simp [through]

variable [IsIntegral X] [IsLocallyNoetherian X] (hcart : ∀ j, (vanishingIdeal (C j)).IsInvertible)
  (hinc : ∀ i j, C i ≤ C j → i = j)

include hirr hcart in
/-- **Local factorization.** For `J` invertible with `supp J ⊆ ⋃ C_j`, on an affine open `U ∋ y`,
the image of `J(U)` in `𝒪_{X,y}` is a product of powers of the images of the `I_j(U)`, `y ∈ C_j`. -/
theorem exists_map_germ_eq_prod_pow (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (U : X.affineOpens) {y : X}
    (hy : y ∈ U.1) :
    ∃ a : ι → ℕ, (J.ideal U).map (X.presheaf.germ U.1 y hy).hom =
      ∏ j ∈ through C y, (((vanishingIdeal (C j)).ideal U).map
        (X.presheaf.germ U.1 y hy).hom) ^ a j := by
  classical
  have : Nonempty U.1 := ⟨⟨y, hy⟩⟩
  have : IsNoetherianRing Γ(X, U.1) := IsLocallyNoetherian.component_noetherian U
  let _ := X.presheaf.algebra_section_stalk ⟨y, hy⟩
  let p := (U.2.primeIdealOf ⟨y, hy⟩).asIdeal
  have : IsLocalization.AtPrime (X.presheaf.stalk y) p := U.2.isLocalization_stalk ⟨y, hy⟩
  have hPprime : ∀ j ∈ through C y, ((vanishingIdeal (C j)).ideal U).IsPrime := by
    intro j hj
    have hηU : genPt C hirr j ∈ U.1 :=
      ((isGenericPoint_genPt C hirr j).mem_open_set_iff U.1.isOpen).mpr
        ⟨y, (mem_through C).mp hj, hy⟩
    rw [vanishingIdeal_ideal_eq_primeIdealOf (C j) (isGenericPoint_genPt C hirr j) U hηU]
    infer_instance
  choose z hz0 hz using fun j => (hcart j).exists_ne_zero_stalkIdeal_eq_span y
  obtain ⟨g, hg0, hg⟩ := hJ.exists_ne_zero_stalkIdeal_eq_span y
  rw [stalkIdeal_eq_map_germ J U hy] at hg
  have hsupp' : ∀ q : Ideal Γ(X, U.1), q.IsPrime → q ≤ p → J.ideal U ≤ q →
      ∃ j ∈ through C y, (vanishingIdeal (C j)).ideal U ≤ q := by
    intro q hq hqp hJq
    obtain ⟨hxU, hxq⟩ := primeIdealOf_fromSpec U ⟨q, hq⟩
    set x := U.2.fromSpec ⟨q, hq⟩
    have hxJ : x ∈ J.support := by
      rw [mem_support_iff_le_primeIdealOf J U hxU, hxq]
      exact hJq
    obtain ⟨j, hxj⟩ := Set.mem_iUnion.mp (hsupp hxJ)
    have hle := vanishingIdeal_ideal_le_primeIdealOf (C j) U hxU hxj
    rw [hxq] at hle
    refine ⟨j, (mem_through C).mpr ?_, hle⟩
    have hsp : x ⤳ y := by
      have h1 : (⟨q, hq⟩ : PrimeSpectrum Γ(X, U.1)) ⤳ U.2.primeIdealOf ⟨y, hy⟩ :=
        (PrimeSpectrum.le_iff_specializes _ _).mp hqp
      have h2 := h1.map U.2.fromSpec.continuous
      rwa [U.2.fromSpec_primeIdealOf ⟨y, hy⟩] at h2
    exact hsp.mem_closed (C j).isClosed hxj
  obtain ⟨a, ha⟩ := map_eq_prod_pow_of_supp p (X.presheaf.stalk y) (through C y)
    (fun j => (vanishingIdeal (C j)).ideal U) hPprime
    (fun j hj => vanishingIdeal_ideal_le_primeIdealOf (C j) U hy ((mem_through C).mp hj)) z
    (fun j _ => by
      change ((vanishingIdeal (C j)).ideal U).map (X.presheaf.germ U.1 y hy).hom = _
      rw [← stalkIdeal_eq_map_germ, hz j])
    (fun j _ => hz0 j) (J.ideal U) hg hg0 hsupp'
  exact ⟨a, ha⟩

include hirr hcart in
/-- The stalkwise form of `exists_map_germ_eq_prod_pow`. -/
theorem exists_stalkIdeal_eq_prod_pow (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (y : X) :
    ∃ a : ι → ℕ, J.stalkIdeal y =
      ∏ j ∈ through C y, ((vanishingIdeal (C j)).stalkIdeal y) ^ a j := by
  obtain ⟨U, hy⟩ := exists_affineOpens_mem y
  obtain ⟨a, ha⟩ := exists_map_germ_eq_prod_pow C hirr hcart J hJ hsupp U hy
  refine ⟨a, ?_⟩
  rw [stalkIdeal_eq_map_germ J U hy, ha]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [stalkIdeal_eq_map_germ _ U hy]

omit [IsIntegral X] [IsLocallyNoetherian X] in
include hinc in
/-- Only `C_j` passes through the generic point of `C_j`. -/
theorem through_genPt (j : ι) : through C (genPt C hirr j) = {j} := by
  ext i
  rw [mem_through, Finset.mem_singleton]
  constructor
  · intro hi
    have hle : C j ≤ C i := by
      intro x hx
      exact ((isGenericPoint_genPt C hirr j).specializes hx).mem_closed (C i).isClosed hi
    exact (hinc j i hle).symm
  · rintro rfl
    exact (isGenericPoint_genPt C hirr i).mem

include hcart hinc in
/-- At the generic point of `C_j`, the stalk of `J` is a power of the stalk of `I_j`. -/
theorem exists_ord (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (j : ι) :
    ∃ n : ℕ, J.stalkIdeal (genPt C hirr j) =
      ((vanishingIdeal (C j)).stalkIdeal (genPt C hirr j)) ^ n := by
  obtain ⟨a, ha⟩ := exists_stalkIdeal_eq_prod_pow C hirr hcart J hJ hsupp (genPt C hirr j)
  rw [through_genPt C hirr hinc j, Finset.prod_singleton] at ha
  exact ⟨a j, ha⟩

/-- The order of `J` along `C_j`: the exponent of the stalk of `I_j` in the stalk of `J` at the
generic point of `C_j`. -/
def ord (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (j : ι) : ℕ :=
  (exists_ord C hirr hcart hinc J hJ hsupp j).choose

/-- The defining property of `ord`: `J = I_j ^ ord J j` at the generic point of `C_j`. -/
theorem ord_spec (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (j : ι) :
    J.stalkIdeal (genPt C hirr j) = ((vanishingIdeal (C j)).stalkIdeal (genPt C hirr j)) ^
      ord C hirr hcart hinc J hJ hsupp j :=
  (exists_ord C hirr hcart hinc J hJ hsupp j).choose_spec

/-- **Decomposition of vertical Cartier divisors.** An invertible ideal sheaf supported on
`⋃ C_j` is `∏ j, I_j ^ ord J j`. -/
theorem eq_prod_pow_ord (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) :
    J = ∏ j, (vanishingIdeal (C j)) ^ ord C hirr hcart hinc J hJ hsupp j := by
  classical
  apply ext_stalkIdeal
  intro y
  obtain ⟨U, hy⟩ := exists_affineOpens_mem y
  have : Nonempty U.1 := ⟨⟨y, hy⟩⟩
  have : IsNoetherianRing Γ(X, U.1) := IsLocallyNoetherian.component_noetherian U
  obtain ⟨a, ha⟩ := exists_map_germ_eq_prod_pow C hirr hcart J hJ hsupp U hy
  rw [stalkIdeal_finset_prod]
  simp only [stalkIdeal_pow]
  -- the components not through `y` contribute the unit ideal
  rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun j => y ∈ C j)]
  rw [Finset.prod_eq_one (s := Finset.univ.filter fun j => y ∉ C j) (fun j hj => by
    rw [stalkIdeal_eq_top_of_notMem_support _ (by
      rw [mem_support_vanishingIdeal]
      exact (Finset.mem_filter.mp hj).2), Ideal.top_pow, Ideal.one_eq_top]), mul_one]
  change J.stalkIdeal y = ∏ j ∈ through C y, _
  rw [stalkIdeal_eq_map_germ J U hy, ha]
  refine Finset.prod_congr rfl fun j hj => ?_
  rw [stalkIdeal_eq_map_germ _ U hy]
  congr 1
  -- the exponent at `y` is the order at the generic point
  have hyj : y ∈ C j := (mem_through C).mp hj
  set η := genPt C hirr j
  have hηU : η ∈ U.1 :=
    ((isGenericPoint_genPt C hirr j).mem_open_set_iff U.1.isOpen).mpr ⟨y, hyj, hy⟩
  let _ := X.presheaf.algebra_section_stalk ⟨y, hy⟩
  let _ := X.presheaf.algebra_section_stalk ⟨η, hηU⟩
  let p := (U.2.primeIdealOf ⟨y, hy⟩).asIdeal
  have : IsLocalization.AtPrime (X.presheaf.stalk y) p := U.2.isLocalization_stalk ⟨y, hy⟩
  have hPη := vanishingIdeal_ideal_eq_primeIdealOf (C j) (isGenericPoint_genPt C hirr j) U hηU
  let P := (vanishingIdeal (C j)).ideal U
  have : P.IsPrime := by
    change ((vanishingIdeal (C j)).ideal U).IsPrime
    rw [hPη]
    infer_instance
  have : IsLocalization.AtPrime (X.presheaf.stalk η) P := by
    change IsLocalization ((vanishingIdeal (C j)).ideal U).primeCompl _
    have h := U.2.isLocalization_stalk ⟨η, hηU⟩
    convert h using 2
  obtain ⟨w, hw0, hw⟩ := (hcart j).exists_ne_zero_stalkIdeal_eq_span η
  rw [stalkIdeal_eq_map_germ _ U hηU] at hw
  have hd := ord_spec C hirr hcart hinc J hJ hsupp j
  rw [stalkIdeal_eq_map_germ _ U hηU, stalkIdeal_eq_map_germ _ U hηU] at hd
  refine exponent_eq_of_map_eq_prod_pow p P
    (vanishingIdeal_ideal_le_primeIdealOf (C j) U hy hyj) (X.presheaf.stalk y)
    (X.presheaf.stalk η) (through C y) (fun i => (vanishingIdeal (C i)).ideal U) j hj rfl
    (fun i hi hne hle => hne ?_) (J.ideal U) a ha _ hd w hw hw0
  -- `I_i(U) ≤ I_j(U)` forces `C_j ⊆ C_i`
  have hηi : η ∈ C i := by
    have hmem := (mem_support_iff_le_primeIdealOf (vanishingIdeal (C i)) U hηU).mpr
      (hle.trans hPη.le)
    rwa [mem_support_vanishingIdeal] at hmem
  refine hinc j i ?_ |>.symm
  intro x hx
  exact ((isGenericPoint_genPt C hirr j).specializes hx).mem_closed (C i).isClosed hηi

omit [IsIntegral X] [IsLocallyNoetherian X] in
/-- A point of the support of `J` has a proper stalk ideal. -/
theorem stalkIdeal_ne_top_of_mem_support (J : X.IdealSheafData) {x : X} (hx : x ∈ J.support) :
    J.stalkIdeal x ≠ ⊤ := by
  obtain ⟨U, hxU⟩ := exists_affineOpens_mem x
  let _ := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  let p := (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal
  have : IsLocalization.AtPrime (X.presheaf.stalk x) p := U.2.isLocalization_stalk ⟨x, hxU⟩
  have hle : J.ideal U ≤ p := (mem_support_iff_le_primeIdealOf J U hxU).mp hx
  rw [stalkIdeal_eq_map_germ J U hxU]
  intro htop
  have hprime := isPrime_map_of_le p (X.presheaf.stalk x) p le_rfl
  apply hprime.ne_top
  rw [eq_top_iff, ← htop]
  exact Ideal.map_mono hle

/-- The order along a component contained in the support is positive. -/
theorem ord_pos (J : X.IdealSheafData) (hJ : J.IsInvertible)
    (hsupp : (J.support : Set X) ⊆ ⋃ j, (C j : Set X)) (j : ι)
    (hj : (C j : Set X) ⊆ J.support) : 0 < ord C hirr hcart hinc J hJ hsupp j := by
  rw [Nat.pos_iff_ne_zero]
  intro h0
  have hd := ord_spec C hirr hcart hinc J hJ hsupp j
  rw [h0, pow_zero, Ideal.one_eq_top] at hd
  exact stalkIdeal_ne_top_of_mem_support J (hj (isGenericPoint_genPt C hirr j).mem) hd

end decomposition

end SGPT.NAPotential.BJHodge
