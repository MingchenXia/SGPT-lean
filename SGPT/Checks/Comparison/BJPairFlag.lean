import SGPT.Checks.Comparison.BJPairDVR
import SGPT.Checks.Comparison.BJModel3Vertical
import SGPT.NAPotential.BJModel3Gauss

/-!
# Divisorial values of flag ideals on normal test configurations (lane BJ-PAIR, R5)

Source: [BJ22] (`references/bj22-trivval`), §2.1–§2.2: for a component `E` of the central fibre
of a normal test configuration, `ord_E` restricted to a flag ideal `𝔞` is
`ord_E(𝔞) = b_E σ(v_E)(𝔞) = b_E (b - φ_𝔞(v_E))`, with `b_E = ord_E(t)` and
`v_E = b_E⁻¹ ord_E|_{ℂ(X)}`. Towards `thm:BJappseq` of `chapter_NApotential.tex`. Blueprint:
`claude-bj-pair.tex`.

[BJ22] obtain this from the `𝔾_m`-invariance of `ord_E` (`ord_E = b_E σ(v_E)` as valuations). For
the values on *flag ideals* the invariance is not needed: `t^b 𝔞 = ∑_j pr₁⁻¹(𝔞_{b-j}) · 𝓘^j` is
generated by "monomials", and for **every** semi-valuation `w` of a model `Y ⟶ X × ℙ¹`

`w((t^b 𝔞) · 𝒪_Y) = min_j (w(𝔞_{b-j}) + j w(𝓘))` (`idealVal_flagSheaf_comap`),

so with `c = w(𝓘) ∈ (0, ∞)` and `v = c⁻¹ w|_X ∈ X^An` one gets
`w((t^b 𝔞) · 𝒪_Y) = c (b - φ_𝔞(v))` (`idealVal_flagSheaf_comap_eq`).

## Main definitions and results

* `pushPoint h w`: the image `h_* w` of a semi-valuation, with `w(J · 𝒪_Y) = (h_* w)(J)`
  (`idealVal_comap_pushPoint`);
* `rescalePoint v c`: the semi-valuation `c v` (`c > 0`), `(c v)(J) = c v(J)`;
* `idealVal_flagSheaf_comap`, `idealVal_flagSheaf_comap_eq`: the formula above;
* `exists_idealVal_ordPoint_flagSheaf`: on the normalized model of a good test configuration, for
  every point `z` with a DVR as local ring there are `c_z ∈ [0, ∞)` and `v_z ∈ X^An` with
  `ord_z((t^b 𝔞) · 𝒪) = c_z (b - φ_𝔞(v_z))` for all flag ideals `𝔞` and weight bounds `b`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.BJ

open AlgebraicGeometry CategoryTheory Topology IsLocalRing
open SGPT.NAPotential.Berkovich SGPT.NAPotential.BJModel SGPT.NAPotential.BJModel3
open SGPT.NAPotential.Berkovich.BerkovichPoint (specializationMap)
open FlagIdealBound
open scoped ENNReal

/-! ### Images of semi-valuations -/

section push

variable {Y Z : Scheme.{0}} {fY : Y ⟶ Spec (.of ℂ)} {fZ : Z ⟶ Spec (.of ℂ)}

/-- **The image `h_* w ∈ Z^An`** of a semi-valuation `w ∈ Y^An` under a `ℂ`-morphism
`h : Y ⟶ Z`: support `h(supp w)`, valuation the restriction of `w` to `κ(h(supp w))`. -/
def pushPoint (h : Y ⟶ Z) (hh : h ≫ fZ = fY) (w : BerkovichPoint fY) : BerkovichPoint fZ :=
  letI := residueComplexAlgebra fY w.support
  fieldBerkovichPoint (L := Y.residueField w.support) fZ (Y.fromSpecResidueField w.support ≫ h)
    (by rw [Category.assoc, hh]; exact (spec_map_residueComplexHom fY w.support).symm) w.val

variable [IsProper fY] [IsProper fZ]

/-- **`w(J · 𝒪_Y) = (h_* w)(J)`** ([BJ22, §1.1]). -/
theorem idealVal_comap_pushPoint (h : Y ⟶ Z) (hh : h ≫ fZ = fY) (w : BerkovichPoint fY)
    (J : Z.IdealSheafData) : w.idealVal (J.comap h) = (pushPoint h hh w).idealVal J := by
  let _ := residueComplexAlgebra fY w.support
  have hg : (Spec.map (𝟙 (Y.residueField w.support)) ≫ Y.fromSpecResidueField w.support) ≫ fY =
      Spec.map (CommRingCat.ofHom (algebraMap ℂ (Y.residueField w.support))) := by
    rw [Spec.map_id, Category.id_comp]
    exact (spec_map_residueComplexHom fY w.support).symm
  rw [← idealVal_fieldBerkovichPoint_fromSpecResidueField (L := Y.residueField w.support) w
    (𝟙 (Y.residueField w.support)) w.val hg (fun a => rfl) (J.comap h),
    idealVal_comap_fieldBerkovichPoint h hh]
  have e : (Spec.map (𝟙 (Y.residueField w.support)) ≫ Y.fromSpecResidueField w.support) ≫ h =
      Y.fromSpecResidueField w.support ≫ h := by
    rw [Spec.map_id, Category.id_comp]
  unfold pushPoint
  exact congrArg (fun u : BerkovichPoint fZ => u.idealVal J) (fieldBerkovichPoint_congr (L := Y.residueField w.support) e _ _ w.val)

end push

/-! ### Rescaling semi-valuations -/

section rescale

variable {Y : Scheme.{0}} {f : Y ⟶ Spec (.of ℂ)}

/-- **The semi-valuation `c v`** for `c > 0`. -/
def rescalePoint (v : BerkovichPoint f) {c : ℝ} (hc : 0 < c) : BerkovichPoint f :=
  ⟨v.support, letI := residueComplexAlgebra f v.support; v.val.rescale hc⟩

theorem rescalePoint_valAt (v : BerkovichPoint f) {c : ℝ} (hc : 0 < c)
    (g : Y.residueField v.support) :
    (rescalePoint v hc).valAt g = scaleTop c (v.valAt g) := rfl

theorem scaleTop_pos {c : ℝ} (hc : 0 < c) {a : WithTop ℝ} (ha : 0 < a) : 0 < scaleTop c a := by
  cases a with
  | top => simp
  | coe r =>
    rw [scaleTop_coe, ← WithTop.coe_zero, WithTop.coe_lt_coe]
    have : (0 : ℝ) < r := by exact_mod_cast ha
    positivity

theorem scaleTop_nonneg {c : ℝ} (hc : 0 < c) {a : WithTop ℝ} (ha : 0 ≤ a) : 0 ≤ scaleTop c a := by
  cases a with
  | top => simp
  | coe r =>
    rw [scaleTop_coe, ← WithTop.coe_zero, WithTop.coe_le_coe]
    have : (0 : ℝ) ≤ r := by exact_mod_cast ha
    positivity

theorem isCenter_rescalePoint {v : BerkovichPoint f} {c : ℝ} (hc : 0 < c) {x : Y}
    (hx : v.IsCenter x) : (rescalePoint v hc).IsCenter x := by
  obtain ⟨h, h0, hpos⟩ := hx
  exact ⟨h, fun g => scaleTop_nonneg hc (h0 g), fun g hg => scaleTop_pos hc (hpos g hg)⟩

theorem toENNReal_scaleTop {c : ℝ} (hc : 0 < c) {a : WithTop ℝ} (ha : 0 ≤ a) :
    toENNReal (scaleTop c a) = ENNReal.ofReal c * toENNReal a := by
  cases a with
  | top =>
    rw [scaleTop_top, toENNReal_top, ENNReal.mul_top (ENNReal.ofReal_pos.mpr hc).ne']
  | coe r =>
    have : (0 : ℝ) ≤ r := by exact_mod_cast ha
    rw [scaleTop_coe, toENNReal_coe, toENNReal_coe, ENNReal.ofReal_mul hc.le]

variable [IsProper f]

/-- **`(c v)(J) = c v(J)`.** -/
theorem idealVal_rescalePoint (v : BerkovichPoint f) {c : ℝ} (hc : 0 < c)
    (J : Y.IdealSheafData) :
    (rescalePoint v hc).idealVal J = ENNReal.ofReal c * v.idealVal J := by
  have hcen := isCenter_rescalePoint hc v.isCenter_center
  have hc0 : ENNReal.ofReal c ≠ 0 := (ENNReal.ofReal_pos.mpr hc).ne'
  rw [idealVal_eq_of_isCenter _ hcen]
  unfold BerkovichPoint.idealVal BerkovichPoint.centerValENN
  rw [ENNReal.mul_iInf_of_ne hc0 ENNReal.ofReal_ne_top]
  refine iInf_congr fun g => ?_
  rw [ENNReal.mul_iInf_of_ne hc0 ENNReal.ofReal_ne_top]
  refine iInf_congr fun _ => ?_
  rw [rescalePoint_valAt]
  exact toENNReal_scaleTop hc (v.centerVal_nonneg g)

end rescale

/-! ### Values of flag ideals -/

section flag

variable {X : Scheme.{0}} {p : X ⟶ Spec (.of ℂ)} [IsProjective p] [IsIntegral X]

local instance : IsProper p :=
  (SGPT.Foundations.Envelope.ProjectiveFactorizationRingIso.of_isProjective p).isProper

variable {Y : Scheme.{0}} {fY : Y ⟶ Spec (.of ℂ)} [IsProper fY] (ρ : Y ⟶ productLine p)

omit [IsProjective p] [IsIntegral X] [IsProper fY] in
theorem comp_productFst_structure (hρ : ρ ≫ productStructure p = fY) :
    (ρ ≫ productFst p) ≫ p = fY := by
  rw [Category.assoc]
  exact hρ

/-- The point `w|_X ∈ X^An` below a semi-valuation `w` of a model `ρ : Y ⟶ X × ℙ¹`. -/
def basePoint (hρ : ρ ≫ productStructure p = fY) (w : BerkovichPoint fY) : BerkovichPoint p :=
  pushPoint (ρ ≫ productFst p) (comp_productFst_structure ρ hρ) w

omit [IsIntegral X] in
/-- **The value of `t^b 𝔞` at any semi-valuation of a model**:
`w((t^b 𝔞) · 𝒪_Y) = inf_j (w|_X(𝔞_{b-j}) + j w(𝓘 · 𝒪_Y))`. -/
theorem idealVal_flagSheaf_comap (hρ : ρ ≫ productStructure p = fY) (w : BerkovichPoint fY) (𝔞 : FlagIdeal X) (b : ℤ) :
    w.idealVal ((flagSheaf p 𝔞 b).comap ρ) =
      ⨅ j : ℕ, ((basePoint ρ hρ w).idealVal (𝔞.ideal (b - j)) +
        j * w.idealVal ((centralIdeal p).comap ρ)) := by
  rw [idealVal_comap_pushPoint ρ hρ, flagSheaf, idealVal_iSup]
  refine iInf_congr fun j => ?_
  rw [BerkovichPoint.idealVal_mul, idealVal_pow, ← idealVal_comap_pushPoint ρ hρ w,
    ← idealVal_comap_pushPoint ρ hρ w, ← Scheme.IdealSheafData.comap_comp, basePoint,
    ← idealVal_comap_pushPoint]

omit [IsIntegral X] in
/-- **`w((t^b 𝔞) · 𝒪_Y) = c (b - φ_𝔞(v))`** for a weight bound `b`, where `c = w(𝓘 · 𝒪_Y)` is
finite and positive and `v = c⁻¹ w|_X`. -/
theorem idealVal_flagSheaf_comap_eq (hρ : ρ ≫ productStructure p = fY) (w : BerkovichPoint fY)
    (hc0 : 0 < w.idealVal ((centralIdeal p).comap ρ))
    (hct : w.idealVal ((centralIdeal p).comap ρ) ≠ ⊤) (𝔞 : FlagIdeal X) {b : ℤ}
    (hb : IsWeightBound 𝔞 b) :
    w.idealVal ((flagSheaf p 𝔞 b).comap ρ) =
      w.idealVal ((centralIdeal p).comap ρ) *
        ENNReal.ofReal (b - 𝔞.phi (rescalePoint (basePoint ρ hρ w)
          (inv_pos.mpr (ENNReal.toReal_pos hc0.ne' hct)))) := by
  set c := w.idealVal ((centralIdeal p).comap ρ) with hcdef
  have hcr : 0 < c.toReal := ENNReal.toReal_pos hc0.ne' hct
  set v := rescalePoint (basePoint ρ hρ w) (inv_pos.mpr hcr) with hv
  have hbase : ∀ J : X.IdealSheafData, (basePoint ρ hρ w).idealVal J = c * v.idealVal J := by
    intro J
    rw [hv, idealVal_rescalePoint, ← mul_assoc, ENNReal.ofReal_inv_of_pos hcr,
      ENNReal.ofReal_toReal hct, ENNReal.mul_inv_cancel hc0.ne' hct, one_mul]
  rw [idealVal_flagSheaf_comap ρ hρ w 𝔞 b, ← iInf_idealVal_add_eq_ofReal v 𝔞 hb,
    ENNReal.mul_iInf_of_ne hc0.ne' hct]
  refine iInf_congr fun j => ?_
  rw [hbase, mul_add, mul_comm (j : ℝ≥0∞) c]

end flag

/-! ### Divisorial points of the normalized models -/

section normModel

variable {X : Scheme.{0}} {p : X ⟶ Spec (.of ℂ)} [IsProjective p] [IsIntegral X]

local instance : IsProper p :=
  (SGPT.Foundations.Envelope.ProjectiveFactorizationRingIso.of_isProjective p).isProper

theorem normModelπ_structure (𝔠 : FlagIdeal X) (c : ℤ) :
    normModelπ p 𝔠 c ≫ productStructure p = normModelStructure p 𝔠 c := by
  rw [normModelπ, Category.assoc]

instance normModel_isLocallyNoetherian (𝔠 : FlagIdeal X) (c : ℤ) :
    IsLocallyNoetherian (normModel p 𝔠 c) :=
  isLocallyNoetherian_of_isProjective (normModelStructure p 𝔠 c)

/-- **Divisorial values of flag ideals** ([BJ22, §2.2]). Let `(𝔠, c)` be a model on which the
central fibre is Cartier and `z` a point of its normalization whose local ring is a DVR. There are
`c_z ∈ [0, ∞)` and `v_z ∈ X^An` such that `ord_z((t^b 𝔞) · 𝒪) = c_z (b - φ_𝔞(v_z))` for every flag
ideal `𝔞` with weight bound `b` (`c_z = 0` off the central fibre). -/
theorem exists_idealVal_ordPoint_flagSheaf {𝔠 : FlagIdeal X} {c : ℤ}
    (h0 : ((centralIdeal p).comap (flagModelπ p 𝔠 c)).IsInvertible) (z : normModel p 𝔠 c)
    (hz : IsDiscreteValuationRing ((normModel p 𝔠 c).presheaf.stalk z)) :
    ∃ (C : ℝ≥0∞) (v : BerkovichPoint p), C ≠ ⊤ ∧ ∀ (𝔞 : FlagIdeal X) (b : ℤ),
      IsWeightBound 𝔞 b →
        (ordPoint (normModelStructure p 𝔠 c) z).idealVal
            ((flagSheaf p 𝔞 b).comap (normModelπ p 𝔠 c)) =
          C * ENNReal.ofReal (b - 𝔞.phi v) := by
  set w := ordPoint (normModelStructure p 𝔠 c) z
  have hinv : ((centralIdeal p).comap (normModelπ p 𝔠 c)).IsInvertible := by
    rw [normModelπ, Scheme.IdealSheafData.comap_comp]
    exact isInvertible_comap_normModelν p 𝔠 c h0
  by_cases hzc : z ∈ ((centralIdeal p).comap (normModelπ p 𝔠 c)).support
  · have hc0 := idealVal_ordPoint_pos (normModelStructure p 𝔠 c) z hzc
    have hct := idealVal_ordPoint_ne_top (normModelStructure p 𝔠 c) z hinv
    exact ⟨_, _, hct, fun 𝔞 b hb =>
      idealVal_flagSheaf_comap_eq (normModelπ p 𝔠 c) (normModelπ_structure 𝔠 c) w hc0 hct 𝔞 hb⟩
  · refine ⟨0, BerkovichPoint.trivial p, ENNReal.zero_ne_top, fun 𝔞 b _ => ?_⟩
    rw [zero_mul]
    apply idealVal_ordPoint_eq_zero
    intro hz'
    apply hzc
    rw [Scheme.IdealSheafData.support_comap] at hz' ⊢
    exact support_flagSheaf_le p 𝔞 b hz'

end normModel

end SGPT.NAPotential.BJ
