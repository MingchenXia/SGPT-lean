import SGPT.Foundations.Schemes.NativeLineTotalSpaceGeometry
import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.RingTheory.Polynomial.Ideal

/-!
# The actual zero divisor of the native dual-line total space

The local zero ideals are generated by the native coordinate, which is regular
over every affine base. Actual affine chart images transfer these calculations
to the native kernel ideal of the glued zero section.
-/

open CategoryTheory Limits Opposite AlgebraicGeometry

namespace SGPT.Foundations.Schemes

universe u

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The actual affine-line global ring is the polynomial ring over the actual
base global ring, via native affine schemes and their Γ–Spec isomorphisms. -/
def nativeAffineLinePolynomialEquiv (U : Scheme.{u}) [IsAffine U] :
    MvPolynomial PUnit.{u + 1} Γ(U, ⊤) ≃+* Γ(nativeAffineLine U, ⊤) :=
  ((Scheme.ΓSpecIso (.of (MvPolynomial PUnit.{u + 1} Γ(U, ⊤)))).symm ≪≫
    asIso (AffineSpace.isoOfIsAffine PUnit.{u + 1} U).hom.appTop).commRingCatIsoToRingEquiv

/-- The actual polynomial equivalence evaluates coefficients through the
projection and the variable through the literal native coordinate. -/
theorem nativeAffineLinePolynomialEquiv_toRingHom (U : Scheme.{u}) [IsAffine U] :
    (nativeAffineLinePolynomialEquiv U).toRingHom =
      MvPolynomial.eval₂Hom (nativeAffineLineProjection U).appTop.hom
        (fun _ ↦ nativeAffineLineCoordinate U) := by
  change ((Scheme.ΓSpecIso (.of (MvPolynomial PUnit.{u + 1} Γ(U, ⊤)))).inv ≫
    (AffineSpace.isoOfIsAffine PUnit.{u + 1} U).hom.appTop).hom = _
  rw [AffineSpace.isoOfIsAffine_hom_appTop, ← Category.assoc,
    Iso.inv_hom_id, Category.id_comp]
  rfl

@[simp]
theorem nativeAffineLinePolynomialEquiv_C (U : Scheme.{u}) [IsAffine U]
    (r : Γ(U, ⊤)) :
    nativeAffineLinePolynomialEquiv U (MvPolynomial.C r) =
      (nativeAffineLineProjection U).appTop r := by
  change (nativeAffineLinePolynomialEquiv U).toRingHom (MvPolynomial.C r) = _
  rw [nativeAffineLinePolynomialEquiv_toRingHom]
  exact MvPolynomial.eval₂_C _ _ _

@[simp]
theorem nativeAffineLinePolynomialEquiv_X (U : Scheme.{u}) [IsAffine U] :
    nativeAffineLinePolynomialEquiv U (MvPolynomial.X PUnit.unit) =
      nativeAffineLineCoordinate U := by
  change (nativeAffineLinePolynomialEquiv U).toRingHom (MvPolynomial.X PUnit.unit) = _
  rw [nativeAffineLinePolynomialEquiv_toRingHom]
  exact MvPolynomial.eval₂_X _ _ _

/-- The local zero pullback is literally polynomial evaluation at zero. -/
theorem nativeAffineLineZero_polynomial (U : Scheme.{u}) [IsAffine U] :
    (nativeAffineLineZero U).appTop.hom.comp
      (nativeAffineLinePolynomialEquiv U).toRingHom =
      MvPolynomial.eval (fun _ : PUnit.{u + 1} ↦ (0 : Γ(U, ⊤))) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    change (nativeAffineLineZero U).appTop
      (nativeAffineLinePolynomialEquiv U (MvPolynomial.C r)) = _
    rw [nativeAffineLinePolynomialEquiv_C]
    change ((nativeAffineLineZero U ≫ nativeAffineLineProjection U).appTop) r = _
    rw [nativeAffineLineZero_projection]
    simp
  · intro j
    have hj : j = PUnit.unit := Subsingleton.elim _ _
    subst j
    change (nativeAffineLineZero U).appTop
      (nativeAffineLinePolynomialEquiv U (MvPolynomial.X PUnit.unit)) = _
    rw [nativeAffineLinePolynomialEquiv_X, nativeAffineLineZero_coordinate]
    simp

/-- Ring equivalences preserve literal injectivity of multiplication. -/
theorem nativeRegular_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) {r : R} (hr : IsRegular r) : IsRegular (e r) := by
  constructor
  · intro x y h
    apply e.symm.injective
    apply hr.left
    simpa using congrArg e.symm h
  · intro x y h
    apply e.symm.injective
    apply hr.right
    simpa using congrArg e.symm h

/-- The genuine affine-line coordinate is regular over every affine base. -/
theorem nativeAffineLineCoordinate_regular (U : Scheme.{u}) [IsAffine U] :
    IsRegular (nativeAffineLineCoordinate U) := by
  rw [← nativeAffineLinePolynomialEquiv_X U]
  exact nativeRegular_ringEquiv (nativeAffineLinePolynomialEquiv U)
    MvPolynomial.isRegular_X

/-- Literal evaluation at zero on the one-variable polynomial ring has the
variable as its ideal generator, over any commutative coefficient ring. -/
theorem nativePUnitPolynomial_eval_zero_ker (R : Type u) [CommRing R] :
    RingHom.ker (MvPolynomial.eval (fun _ : PUnit.{u + 1} ↦ (0 : R))) =
      Ideal.span {MvPolynomial.X PUnit.unit} := by
  let e := (MvPolynomial.uniqueAlgEquiv R PUnit.{u + 1}).toRingEquiv
  have hx : e (MvPolynomial.X PUnit.unit) = Polynomial.X := by
    simp [e, MvPolynomial.uniqueAlgEquiv]
  ext p
  have hp : (e p).coeff 0 =
      MvPolynomial.eval (fun _ : PUnit.{u + 1} ↦ (0 : R)) p := by
    calc
      (e p).coeff 0 = (e p).eval 0 := Polynomial.coeff_zero_eq_eval_zero _
      _ = _ := MvPolynomial.eval₂_const_uniqueAlgEquiv
  rw [RingHom.mem_ker, Ideal.mem_span_singleton, ← map_dvd_iff e, hx,
    Polynomial.X_dvd_iff, hp]

/-- The actual zero-section map on global functions has the native coordinate
as its literal kernel-ideal generator. -/
theorem nativeAffineLineZero_appTop_ker (U : Scheme.{u}) [IsAffine U] :
    RingHom.ker (nativeAffineLineZero U).appTop.hom =
      Ideal.span {nativeAffineLineCoordinate U} := by
  let e := nativeAffineLinePolynomialEquiv U
  calc
    RingHom.ker (nativeAffineLineZero U).appTop.hom =
        ((RingHom.ker (nativeAffineLineZero U).appTop.hom).comap e.toRingHom).map
          e.toRingHom :=
      (Ideal.map_comap_of_surjective e.toRingHom e.surjective _).symm
    _ = (RingHom.ker (MvPolynomial.eval
        (fun _ : PUnit.{u + 1} ↦ (0 : Γ(U, ⊤))))).map e.toRingHom := by
      rw [RingHom.comap_ker, nativeAffineLineZero_polynomial]
    _ = _ := by
      rw [nativePUnitPolynomial_eval_zero_ker, Ideal.map_span, Set.image_singleton]
      exact congrArg (fun t ↦ Ideal.span {t}) (nativeAffineLinePolynomialEquiv_X U)

/-- The native ideal sheaf of the local zero is literally the ideal generated
by the genuine global coordinate on the affine-line chart. -/
theorem nativeAffineLineZero_ideal_top (U : Scheme.{u}) [IsAffine U] :
    (nativeAffineLineZero U).ker.ideal
      ⟨⊤, isAffineOpen_top (nativeAffineLine U)⟩ =
      Ideal.span {nativeAffineLineCoordinate U} := by
  rw [Scheme.Hom.ker_apply]
  exact nativeAffineLineZero_appTop_ker U

variable {X : Scheme.{u}}

/-- The actual chart inclusion for any framed subopen, retaining the native
colimit morphism of the genuine gluing diagram. -/
def nativeFramedChart {L : X.Modules} (a : LineBundleAtlas L)
    (c : NativeFramedOpen a) :
    nativeAffineLine c.2.1.toScheme ⟶ nativeDualLineTotalSpace a :=
  colimit.ι (nativeDualLineDiagram a) c

instance nativeFramedChart_isOpenImmersion {L : X.Modules} (a : LineBundleAtlas L)
    (c : NativeFramedOpen a) : IsOpenImmersion (nativeFramedChart a c) :=
  inferInstanceAs (IsOpenImmersion (colimit.ι (nativeDualLineDiagram a) c))

@[reassoc (attr := simp)]
theorem nativeFramedChart_projection {L : X.Modules} (a : LineBundleAtlas L)
    (c : NativeFramedOpen a) :
    nativeFramedChart a c ≫ nativeDualLineProjection a =
      nativeAffineLineProjection c.2.1.toScheme ≫ c.2.1.ι :=
  nativeDualLineProjection_on_open a c

/-- The actual global zero restricts to the literal zero on every framed
subopen, derived from the original atlas and the transition naturality. -/
@[reassoc (attr := simp)]
theorem nativeDualLineZero_on_framedOpen {L : X.Modules} (a : LineBundleAtlas L)
    (c : NativeFramedOpen a) :
    c.2.1.ι ≫ nativeDualLineZero a =
      nativeAffineLineZero c.2.1.toScheme ≫ nativeFramedChart a c := by
  let d : NativeFramedOpen a := ⟨c.1, ⟨a.opens c.1, le_rfl⟩⟩
  let h : c ⟶ d := InducedCategory.homMk (homOfLE c.2.2)
  calc
    c.2.1.ι ≫ nativeDualLineZero a =
        X.homOfLE c.2.2 ≫ (a.opens c.1).ι ≫ nativeDualLineZero a := by
      rw [← Category.assoc, Scheme.homOfLE_ι]
    _ = X.homOfLE c.2.2 ≫ nativeAffineLineZero (a.opens c.1).toScheme ≫
        nativeDualLineChart a c.1 := by rw [nativeDualLineZero_on_chart]
    _ = _ := nativeDualLineZero_restrict a h

/-- The zero pullback square holds for every actual framed subopen chart. -/
theorem nativeDualLineZero_framed_isPullback {L : X.Modules} (a : LineBundleAtlas L)
    (c : NativeFramedOpen a) :
    IsPullback c.2.1.ι (nativeAffineLineZero c.2.1.toScheme)
      (nativeDualLineZero a) (nativeFramedChart a c) := by
  apply IsPullback.mk' (nativeDualLineZero_on_framedOpen a c)
  · intro T φ φ' h _
    exact (cancel_mono c.2.1.ι).mp h
  · intro T g h w
    have hw := congrArg (fun q ↦ q ≫ nativeDualLineProjection a) w
    have hb : h ≫ nativeAffineLineProjection c.2.1.toScheme ≫ c.2.1.ι = g := by
      simpa only [Category.assoc, nativeDualLineZero_projection, Category.comp_id,
        nativeFramedChart_projection] using hw.symm
    refine ⟨h ≫ nativeAffineLineProjection c.2.1.toScheme, hb, ?_⟩
    apply (cancel_mono (nativeFramedChart a c)).mp
    rw [Category.assoc, ← nativeDualLineZero_on_framedOpen]
    have hbz : h ≫ nativeAffineLineProjection c.2.1.toScheme ≫ c.2.1.ι ≫
        nativeDualLineZero a = g ≫ nativeDualLineZero a := by
      simpa only [Category.assoc] using congrArg (fun q ↦ q ≫ nativeDualLineZero a) hb
    exact hbz.trans w

/-- The native zero kernel on every affine framed chart image is principal
with a regular generator transported through the actual chart section iso. -/
theorem nativeDualLineZero_regular_principal_framed {L : X.Modules}
    (a : LineBundleAtlas L) (c : NativeFramedOpen a) [IsAffine c.2.1.toScheme] :
    ∃ t : Γ(nativeDualLineTotalSpace a, nativeFramedChart a c ''ᵁ ⊤),
      IsRegular t ∧ (nativeDualLineZeroIdeal a).ideal
        ⟨nativeFramedChart a c ''ᵁ ⊤,
          (isAffineOpen_top (nativeAffineLine c.2.1.toScheme)).image_of_isOpenImmersion
            (nativeFramedChart a c)⟩ = Ideal.span {t} := by
  let e := ((nativeFramedChart a c).appIso ⊤).symm.commRingCatIsoToRingEquiv
  refine ⟨e (nativeAffineLineCoordinate c.2.1.toScheme),
    nativeRegular_ringEquiv e (nativeAffineLineCoordinate_regular c.2.1.toScheme), ?_⟩
  have hk := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
    (nativeDualLineZero a) (nativeAffineLineZero c.2.1.toScheme) c.2.1.ι
    (nativeFramedChart a c) (nativeDualLineZero_framed_isPullback a c).flip
    ⟨⊤, isAffineOpen_top (nativeAffineLine c.2.1.toScheme)⟩
  rw [nativeAffineLineZero_ideal_top] at hk
  change Ideal.span {nativeAffineLineCoordinate c.2.1.toScheme} =
    ((nativeDualLineZeroIdeal a).ideal
      ⟨nativeFramedChart a c ''ᵁ ⊤,
        (isAffineOpen_top (nativeAffineLine c.2.1.toScheme)).image_of_isOpenImmersion
          (nativeFramedChart a c)⟩).comap e.toRingHom at hk
  have hm := congrArg (fun J ↦ J.map e.toRingHom) hk
  rw [Ideal.map_comap_of_surjective e.toRingHom e.surjective,
    Ideal.map_span, Set.image_singleton] at hm
  exact hm.symm

/-- Actual affine subopens of the genuine base atlas yield affine framed
charts covering every point of the glued total space. -/
theorem nativeDualLine_affineFramedChart_cover {L : X.Modules}
    (a : LineBundleAtlas L) (x : nativeDualLineTotalSpace a) :
    ∃ c : NativeFramedOpen a, IsAffine c.2.1.toScheme ∧
      x ∈ Set.range (nativeFramedChart a c) := by
  obtain ⟨i, y, hy⟩ := nativeDualLineChart_jointly_surjective a x
  obtain ⟨W, hW, hyW, hWi⟩ := exists_isAffineOpen_mem_and_subset
    (nativeAffineLineProjection (a.opens i).toScheme y).2
  let c : NativeFramedOpen a := ⟨i, ⟨W, hWi⟩⟩
  let d : NativeFramedOpen a := ⟨i, ⟨a.opens i, le_rfl⟩⟩
  let h : c ⟶ d := InducedCategory.homMk (homOfLE hWi)
  obtain ⟨z, hz⟩ := (nativeFramedMap_mem_range a h y).mpr hyW
  refine ⟨c, hW, z, ?_⟩
  have he := congrArg (fun q ↦ q z) (colimit.w (nativeDualLineDiagram a) h)
  change nativeDualLineChart a i (nativeFramedMap a h z) = nativeFramedChart a c z at he
  rw [hz, hy] at he
  exact he.symm

/-- The literal native kernel ideal of the zero section is locally generated
by a regular function at every actual total-space point. -/
theorem nativeDualLineZero_locally_regular_principal {L : X.Modules}
    (a : LineBundleAtlas L) (x : nativeDualLineTotalSpace a) :
    ∃ (V : (nativeDualLineTotalSpace a).Opens) (hV : IsAffineOpen V),
      x ∈ V ∧ ∃ t : Γ(nativeDualLineTotalSpace a, V),
        IsRegular t ∧ (nativeDualLineZeroIdeal a).ideal ⟨V, hV⟩ = Ideal.span {t} := by
  obtain ⟨c, hc, hx⟩ := nativeDualLine_affineFramedChart_cover a x
  let : IsAffine c.2.1.toScheme := hc
  refine ⟨nativeFramedChart a c ''ᵁ ⊤,
    (isAffineOpen_top (nativeAffineLine c.2.1.toScheme)).image_of_isOpenImmersion
      (nativeFramedChart a c), ?_, nativeDualLineZero_regular_principal_framed a c⟩
  rw [Scheme.Hom.image_top_eq_opensRange]
  exact hx

end

end SGPT.Foundations.Schemes
