import SGPT.Foundations.Schemes.PolynomialTwistedSectionGrading
import SGPT.Foundations.Schemes.HomogeneousSyzygyResolution

/-! # Actual finite homogeneous spans of genuine projective twisted sections

This constructs the literal polynomial submodule generated by finitely many
actual global twisted sections.  Its finiteness and native integral grading
are proved from those real generators and actual ambient decomposition.
-/

open CategoryTheory Opposite AlgebraicGeometry

namespace SGPT.Foundations.Schemes

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000

variable (K : Type) [Field K] (n : ℕ) (M : (polynomialProj K n).Modules)
  {A : Type} [Fintype A] [DecidableEq A] (d : A → ℕ)
  (t : ∀ a, bundleTwistedGlobalSections (polynomialProjTwistingLine K n).sheaf M (d a))

/-- The genuine homogeneous sections, literally included in the actual Γ_* module. -/
def polynomialProjTwistedFiniteGenerators (a : A) : polynomialProjTwistedSectionModule K n M :=
  (polynomialProjTwistingLine K n).ofTwistedSection M (d a) (t a)

/-- The actual polynomial span of the given finite genuine homogeneous sections. -/
def polynomialProjTwistedFiniteSpan :
    Submodule (MvPolynomial (Fin (n + 1)) K) (polynomialProjTwistedSectionModule K n M) :=
  Submodule.span (MvPolynomial (Fin (n + 1)) K)
    (Set.range (polynomialProjTwistedFiniteGenerators K n M d t))

/-- The actual finite span is finite over the actual polynomial ring, by its literal generators. -/
instance polynomialProjTwistedFiniteSpan_finite :
    Module.Finite (MvPolynomial (Fin (n + 1)) K) (polynomialProjTwistedFiniteSpan K n M d t) :=
  Module.Finite.span_of_finite _ (Set.finite_range _)

omit [DecidableEq A] in
/-- The literal finite free summation map has precisely the actual finite span as its image. -/
theorem polynomialProjTwistedFiniteSpan_eq_range :
    polynomialProjTwistedFiniteSpan K n M d t =
      LinearMap.range (finiteHomogeneousPresentationMap
        (R := MvPolynomial (Fin (n + 1)) K)
        (polynomialProjTwistedFiniteGenerators K n M d t)) := by
  ext x
  exact Submodule.mem_span_range_iff_exists_fun _

/-- True ambient projections preserve the literal finite span of true homogeneous sections. -/
theorem polynomialProjTwistedFiniteSpan_isHomogeneous :
    (polynomialProjTwistedFiniteSpan K n M d t).IsHomogeneous
      (polynomialProjTwistedSectionPiece K n M) := by
  let 𝒜 := polynomialIntegralGrading (K := K) (I := Fin (n + 1))
  let ℳ := polynomialProjTwistedSectionPiece K n M
  let δ : A → ℤ := fun a => (d a : ℤ)
  let ℱ := finiteShiftedFreePiece 𝒜 δ
  let := finiteShiftedFreeDecomposition 𝒜 δ
  let g := polynomialProjTwistedFiniteGenerators K n M d t
  let f := finiteHomogeneousPresentationMap (R := MvPolynomial (Fin (n + 1)) K) g
  have hg : ∀ a, g a ∈ ℳ (δ a) := fun a =>
    polynomialProjTwistedSectionPiece_ofTwistedSection K n M (d a) (t a)
  have hf : ∀ k a, a ∈ ℱ k → f a ∈ ℳ k :=
    finiteHomogeneousPresentationMap_homogeneous 𝒜 ℳ δ g hg
  intro k x hx
  rw [polynomialProjTwistedFiniteSpan_eq_range] at hx
  obtain ⟨a, rfl⟩ := hx
  have he := homogeneousMap_decompose ℱ ℳ f hf k a
  rw [← he, polynomialProjTwistedFiniteSpan_eq_range]
  exact ⟨(DirectSum.decompose ℱ a k : A → MvPolynomial (Fin (n + 1)) K), rfl⟩

/-- The literal induced integral degree pieces in the actual finite polynomial span. -/
def polynomialProjTwistedFiniteSpanPiece (k : ℤ) :
    Submodule K (polynomialProjTwistedFiniteSpan K n M d t) :=
  homogeneousSubmodulePiece (polynomialProjTwistedSectionPiece K n M)
    (polynomialProjTwistedFiniteSpan K n M d t) k

/-- The actual finite span inherits its genuine native internal decomposition. -/
instance polynomialProjTwistedFiniteSpanDecomposition :
    DirectSum.Decomposition (polynomialProjTwistedFiniteSpanPiece K n M d t) :=
  homogeneousSubmoduleDecomposition (polynomialProjTwistedSectionPiece K n M)
    (polynomialProjTwistedFiniteSpan K n M d t)
    (polynomialProjTwistedFiniteSpan_isHomogeneous K n M d t)

/-- Actual polynomial homogeneous multiplication preserves the true finite span degree pieces. -/
instance polynomialProjTwistedFiniteSpanGradedSMul :
    SetLike.GradedSMul (polynomialIntegralGrading (K := K) (I := Fin (n + 1)))
      (polynomialProjTwistedFiniteSpanPiece K n M d t) :=
  homogeneousSubmoduleGradedSMul (polynomialIntegralGrading (K := K) (I := Fin (n + 1)))
    (polynomialProjTwistedSectionPiece K n M) (polynomialProjTwistedFiniteSpan K n M d t)

end

end SGPT.Foundations.Schemes
