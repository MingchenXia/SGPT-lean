import SGPT.Foundations.Analysis.Pending.NaturalComplexifiedRealSpan
import SGPT.Foundations.Analysis.Pending.NaturalComplexOneOneRealComponents
import SGPT.Foundations.Analysis.Pending.NaturalComplexExteriorProductTransport

/-!
# Actual complexified positive-product span and genuine exterior step

All complex spans are generated by unique complexifications of the original
continuous real formSpan. Its actual exterior product with the entire
degree-one complex span belongs to the next span. General pure-type span
equality and global cohomological claims remain separate.
-/

noncomputable section

namespace SGPT.Foundations.Analysis.Pending.NaturalComplexPositiveProductSpanStep

open SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.FirstPass.MongeAmpere
open NaturalComplexBidegreeTransport NaturalRealAlternatingComplexification
open NaturalRealPPSubmodule NaturalComplexifiedRealSpan
open NaturalComplexOneOneRealComponents NaturalComplexExteriorProductTransport

def complexFormSpan (n q : ℕ) :
    Submodule ℂ (complexification n [⋀^Fin (2 * q)]→ₗ[ℂ] ℂ) :=
  complexSpan (LocalProductCurrents.formSpan n q)

theorem unit_mem_complexFormSpan (n : ℕ) :
    realExtension n 0 (coordinateWedgeUnit : StronglyPositiveForms.RealForm n 0) ∈
      complexFormSpan n 0 := by
  exact Submodule.subset_span ⟨coordinateWedgeUnit,
    LocalProductCurrents.mem_formSpan_of_mem_spCone StronglyPositiveForms.unit_mem_spCone,
    rfl⟩

private theorem realExtension_wedge {n p q : ℕ}
    (A : ComplexModel n [⋀^Fin p]→L[ℝ] ℝ)
    (B : ComplexModel n [⋀^Fin q]→L[ℝ] ℝ) :
    realExtension n (p + q) (coordinateWedge A B) =
      complexWedge (realExtension n p A) (realExtension n q B) :=
  complexify_coordinateWedge A B

theorem complexWedge_mem_complexFormSpan_of_oneOne {n q : ℕ}
    (F : complexification n [⋀^Fin (2 * q)]→ₗ[ℂ] ℂ)
    (hF : F ∈ complexFormSpan n q)
    (β : ComplexModel n [⋀^Fin 2]→L[ℝ] ℝ) (hβ : IsOneOne β) :
    complexWedge F (realExtension n 2 β) ∈ complexFormSpan n (q + 1) := by
  obtain ⟨A, hA, B, hB, hAB⟩ :=
    mem_complexSpan_components (LocalProductCurrents.formSpan n q) F hF
  rw [hAB, complexWedge_add_left, complexWedge_smul_left]
  refine (complexFormSpan n (q + 1)).add_mem ?_
    ((complexFormSpan n (q + 1)).smul_mem Complex.I ?_)
  · rw [← realExtension_wedge]
    exact Submodule.subset_span ⟨coordinateWedge A β,
      LocalProductCurrents.wedge_mem_formSpan hA hβ, rfl⟩
  · rw [← realExtension_wedge]
    exact Submodule.subset_span ⟨coordinateWedge B β,
      LocalProductCurrents.wedge_mem_formSpan hB hβ, rfl⟩

theorem complexWedge_mem_complexFormSpan {n q : ℕ}
    (F : complexification n [⋀^Fin (2 * q)]→ₗ[ℂ] ℂ)
    (G : complexification n [⋀^Fin 2]→ₗ[ℂ] ℂ)
    (hF : F ∈ complexFormSpan n q) (hG : G ∈ complexFormSpan n 1) :
    complexWedge F G ∈ complexFormSpan n (q + 1) := by
  obtain ⟨A, hA, B, hB, hAB⟩ :=
    mem_complexSpan_components (LocalProductCurrents.formSpan n 1) G hG
  have hAt : IsOneOne A := (isOneOne_iff_pureRealPP A).mpr
    ((mem_formSpan_one_iff_pureRealPP A).mp hA)
  have hBt : IsOneOne B := (isOneOne_iff_pureRealPP B).mpr
    ((mem_formSpan_one_iff_pureRealPP B).mp hB)
  rw [hAB, complexWedge_add_right, complexWedge_smul_right]
  exact (complexFormSpan n (q + 1)).add_mem
    (complexWedge_mem_complexFormSpan_of_oneOne F hF A hAt)
    ((complexFormSpan n (q + 1)).smul_mem Complex.I
      (complexWedge_mem_complexFormSpan_of_oneOne F hF B hBt))

theorem mixedGenerator_mem_complexFormSpan {n : ℕ} (j k : Fin n) :
    mixedGenerator j k ∈ complexFormSpan n 1 := by
  rw [mixedGenerator_eq_complexify_components]
  refine (complexFormSpan n 1).add_mem ?_
    ((complexFormSpan n 1).smul_mem Complex.I ?_)
  · exact Submodule.subset_span ⟨realComponent j k,
      realComponent_mem_formSpan j k, rfl⟩
  · exact Submodule.subset_span ⟨imagComponent j k,
      imagComponent_mem_formSpan j k, rfl⟩

end SGPT.Foundations.Analysis.Pending.NaturalComplexPositiveProductSpanStep
