import SGPT.Toric.Toric3Okounkov
import SGPT.Toric.BigToric2BaseLocus
import SGPT.AlmostSemigroup.Okounkov
import Mathlib.Analysis.Convex.KreinMilman

/-!
# The Okounkov body of a toric line bundle

Source `chapter_toric_big.tex`, `prop:toricusualOko`:

`k⁻¹ ν_{Y•}(H⁰(X, L^k)^×) = Φ_ℝ(P_D ∩ k⁻¹ M)` for every `k ∈ ℤ_{>0}`, and
`Δ_{Y•}(L) = Φ_ℝ(P_D)`,

where `L = O(D)`, `L^k = O(kD)`, `Y•` is the toric flag of a maximal cone `σ = σ_v` with an
ordering `e` of its rays, `Φ_ℝ(x) = (⟨x - m_σ, u_{ρ_1}⟩, …, ⟨x - m_σ, u_{ρ_n}⟩)` and
`Δ_{Y•}(L) = Δ(Γ(L))` is the Okounkov body (source `def:Okobd`, `def:Okokk`: the height-one
slice of the closed convex cone generated by the semigroup
`Γ(L) = {(ν_{Y•}(s), k) : k ∈ ℕ, s ∈ H⁰(X, L^k) ∖ 0}`, `SGPT.AlmostSemigroup.Okounkov.body`).

No bigness of `D` is needed (if `P_D = ∅` both sides are empty).  The density of the points
`P_D ∩ k⁻¹ M` in `P_D` used to pass from the first to the second statement is proved through the
extreme points of `P_D`, which are rational (`exists_latticeVector_eq_smul_of_mem_extremePoints`,
the argument of `exists_rat_mem_face` for `cor:stablebl_toric`), and Krein–Milman.

## Main results

* `toricSectionSemigroup`: the semigroup `Γ(L)`;
* `toricOkounkovBody`: `Δ_{Y•}(L)`;
* `image_toricSectionValues_eq`: source `eq:DeltakLtoric`;
* `toricOkounkovBody_eq`: `Δ_{Y•}(L) = Φ_ℝ(P_D)`.
-/

set_option autoImplicit false
noncomputable section
namespace SGPT.Toric
open Set Filter SGPT.AlmostSemigroup SGPT.AlmostSemigroup.Counting
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Okounkov
open scoped Topology BigOperators

variable {n : ℕ} {K : Type*} [Fintype K] [Nonempty K]
variable {γ : K → Fin n → ℤ} {hs : latticePolytopeEdgeSmooth γ}

/-! ### Rational extreme points of `P_D` -/

/-- The extreme points of `P_D` are rational: `x = k⁻¹ m` with `m ∈ M`, `k ≥ 1` (an extreme
point is the unique solution of its active equations `⟨x, u_ρ⟩ = -a_ρ`, which are integral). -/
theorem exists_latticeVector_eq_smul_of_mem_extremePoints (D : ToricDivisor γ hs)
    {x : EuclideanSpace ℝ (Fin n)} (hxe : x ∈ (toricDivisorPolytope D).extremePoints ℝ) :
    ∃ (k : ℕ) (m : Fin n → ℤ), 0 < k ∧ latticeVector m = (k : ℝ) • x := by
  classical
  have hfin := finite_polytopeToricRays γ hs
  let _ := hfin.fintype
  set Q := toricDivisorPolytope D
  have hxQ' : x ∈ Q := hxe.1
  let A : Set (PolytopeToricRays γ hs) := {ρ | (D ρ : ℝ) + latticeFunctional ρ.val x = 0}
  have hinj : ∀ d : EuclideanSpace ℝ (Fin n),
      (∀ ρ : A, latticeFunctional ρ.val.val d = 0) → d = 0 := by
    intro d hd
    by_contra hd0
    have hev : ∀ ρ : PolytopeToricRays γ hs, ∀ᶠ t : ℝ in 𝓝 0,
        -(D ρ : ℝ) ≤ latticeFunctional ρ.val (x + t • d) := by
      intro ρ
      by_cases hρ : ρ ∈ A
      · refine Eventually.of_forall fun t => ?_
        have h0 := hd ⟨ρ, hρ⟩
        simp only [map_add, map_smul, smul_eq_mul] at h0 ⊢
        rw [h0, mul_zero, add_zero]
        have : (D ρ : ℝ) + latticeFunctional ρ.val x = 0 := hρ
        linarith
      · have hgap : -(D ρ : ℝ) < latticeFunctional ρ.val x := by
          have h1 := hxQ' ρ
          have h2 : (D ρ : ℝ) + latticeFunctional ρ.val x ≠ 0 := hρ
          change -(D ρ : ℝ) ≤ latticeFunctional ρ.val x at h1
          rcases h1.lt_or_eq with h | h
          · exact h
          · exact absurd (by linarith) h2
        have hcont : Continuous fun t : ℝ => latticeFunctional ρ.val (x + t • d) :=
          (LinearMap.continuous_of_finiteDimensional _).comp
            (continuous_const.add (continuous_id.smul continuous_const))
        have := hcont.tendsto 0
        simp only [zero_smul, add_zero] at this
        filter_upwards [this.eventually (lt_mem_nhds hgap)] with t ht
        exact ht.le
    have hall : ∀ᶠ t : ℝ in 𝓝 0, x + t • d ∈ Q := by
      filter_upwards [Filter.eventually_all.mpr hev] with t ht
      exact fun ρ => ht ρ
    have hall' : ∀ᶠ t : ℝ in 𝓝 0, x + t • d ∈ Q ∧ x + (-t) • d ∈ Q := by
      have hneg : Tendsto (fun t : ℝ => -t) (𝓝 0) (𝓝 0) := by
        simpa using (continuous_neg.tendsto (0 : ℝ))
      exact hall.and (hneg.eventually hall)
    obtain ⟨t, ht, htpos⟩ := ((hall'.filter_mono nhdsWithin_le_nhds).and
      (self_mem_nhdsWithin : ∀ᶠ t : ℝ in 𝓝[>] 0, t ∈ Ioi 0)).exists
    have hseg : x ∈ openSegment ℝ (x + t • d) (x + (-t) • d) := by
      refine ⟨1 / 2, 1 / 2, by norm_num, by norm_num, by norm_num, ?_⟩
      simp only [smul_add, smul_smul, neg_smul]
      module
    have := hxe.2 ht.1 ht.2 hseg
    have htd : t • d = 0 := by
      have h' : x + t • d - x = 0 := by rw [this, sub_self]
      simpa using h'
    rcases smul_eq_zero.mp htd with h | h
    · exact absurd h (ne_of_gt htpos)
    · exact hd0 h
  obtain ⟨q, hq⟩ := exists_rat_of_unique_solution (fun ρ : A => ρ.val.val)
    (fun ρ : A => -D ρ.val) (x := x) (fun ρ => by
      have : (D ρ.val : ℝ) + latticeFunctional ρ.val.val x = 0 := ρ.property
      push_cast; linarith) hinj
  obtain ⟨k, m, hk, hm⟩ := exists_nat_int_of_rat q
  refine ⟨k, m, hk, ?_⟩
  ext i
  rw [latticeVector_apply, hm i, PiLp.smul_apply, smul_eq_mul, hq i]

/-! ### The real map `Φ_ℝ` -/

variable (hs) in
/-- Source `eq:isoMZncanonical`: the affine isomorphism
`Φ_ℝ(x) = (⟨x - m_σ, u_{ρ_1}⟩, …, ⟨x - m_σ, u_{ρ_n}⟩) : M_ℝ → ℝ^n`. -/
def toricFlagRealMap (v : latticePolytopeVertices γ) (e : Fin n ≃ Fin n) (D : ToricDivisor γ hs)
    (x : EuclideanSpace ℝ (Fin n)) : Fin n → ℝ :=
  fun l => latticeFunctional (polytopeToricRayGenerator γ hs v (e l)) x -
    (intPairing (toricCartierDatum D v) (polytopeToricRayGenerator γ hs v (e l)) : ℝ)

variable (v : latticePolytopeVertices γ) (e : Fin n ≃ Fin n) (D : ToricDivisor γ hs)

theorem toricFlagRealMap_latticeVector (m : Fin n → ℤ) :
    toricFlagRealMap hs v e D (latticeVector m) = integerCast (toricFlagLatticeMap hs v e D m) := by
  funext l
  simp only [toricFlagRealMap, toricFlagLatticeMap, integerCast, latticeFunctional_latticeVector]
  rw [intPairing_comm (polytopeToricRayGenerator γ hs v (e l)) m, intPairing_sub]
  push_cast
  ring

/-- `Φ_{kD}(m) = k Φ_ℝ(k⁻¹ m)` (`m_σ(kD) = k m_σ(D)`). -/
theorem integerCast_toricFlagLatticeMap_smul {k : ℕ} (hk : 0 < k) (m : Fin n → ℤ) :
    (k : ℝ)⁻¹ • integerCast (toricFlagLatticeMap hs v e ((k : ℤ) • D) m) =
      toricFlagRealMap hs v e D ((k : ℝ)⁻¹ • latticeVector m) := by
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
  funext l
  simp only [toricFlagLatticeMap, toricFlagRealMap, toricCartierDatum_smul, integerCast,
    Pi.smul_apply, smul_eq_mul, map_smul, latticeFunctional_latticeVector, intPairing_sub,
    intPairing_smul, Int.cast_sub, Int.cast_mul, Int.cast_natCast]
  rw [intPairing_comm m]
  field_simp

theorem continuous_toricFlagRealMap : Continuous (toricFlagRealMap hs v e D) :=
  continuous_pi fun _ => ((LinearMap.continuous_of_finiteDimensional _).sub continuous_const)

/-! ### The semigroup `Γ(L)` -/

theorem add_mem_toricLatticePoints_smul {k k' : ℕ} {m m' : Fin n → ℤ}
    (hm : m ∈ toricLatticePoints ((k : ℤ) • D)) (hm' : m' ∈ toricLatticePoints ((k' : ℤ) • D)) :
    m + m' ∈ toricLatticePoints (((k + k' : ℕ) : ℤ) • D) := by
  rw [mem_toricLatticePoints_iff] at hm hm' ⊢
  intro w j
  have h1 := hm w j
  have h2 := hm' w j
  simp only [toricCartierDatum_smul, intPairing_smul, intPairing_add] at h1 h2 ⊢
  push_cast
  linarith

theorem toricFlagLatticeMap_add {k k' : ℕ} (m m' : Fin n → ℤ) :
    toricFlagLatticeMap hs v e ((k : ℤ) • D) m + toricFlagLatticeMap hs v e ((k' : ℤ) • D) m' =
      toricFlagLatticeMap hs v e (((k + k' : ℕ) : ℤ) • D) (m + m') := by
  funext l
  simp only [toricFlagLatticeMap, toricCartierDatum_smul, Pi.add_apply, intPairing_sub,
    intPairing_add, intPairing_smul]
  push_cast
  ring

/-- Source `def:Okobd`: the semigroup `Γ(L) = {(ν_{Y•}(s), k) : k ∈ ℕ, s ∈ H⁰(X, L^k) ∖ 0}` of
`L = O(D)` (`L^k = O(kD)`). -/
def toricSectionSemigroup : AddSubsemigroup ((Fin n → ℤ) × ℤ) where
  carrier := {z | ∃ k : ℕ, z.2 = k ∧ z.1 ∈ toricSectionValues v e ((k : ℤ) • D)}
  add_mem' := by
    rintro ⟨w, a⟩ ⟨w', a'⟩ ⟨k, hk, hw⟩ ⟨k', hk', hw'⟩
    simp only at hk hk' hw hw'
    rw [toricSectionValues_eq] at hw hw'
    obtain ⟨m, hm, rfl⟩ := hw
    obtain ⟨m', hm', rfl⟩ := hw'
    refine ⟨k + k', by simp [hk, hk'], ?_⟩
    rw [toricSectionValues_eq]
    exact ⟨m + m', add_mem_toricLatticePoints_smul D hm hm',
      (toricFlagLatticeMap_add (k := k) (k' := k') v e D m m').symm⟩

theorem mem_toricSectionSemigroup_iff (z : (Fin n → ℤ) × ℤ) :
    z ∈ toricSectionSemigroup v e D ↔ ∃ (k : ℕ) (m : Fin n → ℤ),
      m ∈ toricLatticePoints ((k : ℤ) • D) ∧
        z = (toricFlagLatticeMap hs v e ((k : ℤ) • D) m, (k : ℤ)) := by
  change (∃ k : ℕ, z.2 = k ∧ z.1 ∈ toricSectionValues v e ((k : ℤ) • D)) ↔ _
  constructor
  · rintro ⟨k, hk, hw⟩
    rw [toricSectionValues_eq] at hw
    obtain ⟨m, hm, hmw⟩ := hw
    exact ⟨k, m, hm, Prod.ext hmw.symm hk⟩
  · rintro ⟨k, m, hm, rfl⟩
    refine ⟨k, rfl, ?_⟩
    rw [toricSectionValues_eq]
    exact ⟨m, hm, rfl⟩

/-- Source `def:Okobd`: the Okounkov body `Δ_{Y•}(L) = Δ(Γ(L))` of `L = O(D)` with respect to
the toric flag. -/
def toricOkounkovBody : Set (Fin n → ℝ) := Okounkov.body (toricSectionSemigroup v e D)

/-! ### `eq:DeltakLtoric` -/

/-- Source `prop:toricusualOko`, `eq:DeltakLtoric`:
`k⁻¹ ν_{Y•}(H⁰(X, L^k)^×) = Φ_ℝ(P_D ∩ k⁻¹ M)` for every `k ∈ ℤ_{>0}`. -/
theorem image_toricSectionValues_eq {k : ℕ} (hk : 0 < k) :
    (fun w => (k : ℝ)⁻¹ • integerCast w) '' toricSectionValues v e ((k : ℤ) • D) =
      toricFlagRealMap hs v e D ''
        (toricDivisorPolytope D ∩ {x | ∃ m : Fin n → ℤ, latticeVector m = (k : ℝ) • x}) := by
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [toricSectionValues_eq, image_image]
  ext y
  constructor
  · rintro ⟨m, hm, rfl⟩
    refine ⟨(k : ℝ)⁻¹ • latticeVector m, ⟨?_, m, ?_⟩,
      (integerCast_toricFlagLatticeMap_smul v e D hk m).symm⟩
    · have := (mem_toricDivisorPolytope_smul_iff D hk _).mp hm
      rwa [Set.mem_smul_set_iff_inv_smul_mem₀ hk'] at this
    · rw [smul_smul, mul_inv_cancel₀ hk', one_smul]
  · rintro ⟨x, ⟨hxP, m, hm⟩, rfl⟩
    have hx : x = (k : ℝ)⁻¹ • latticeVector m := by
      rw [hm, smul_smul, inv_mul_cancel₀ hk', one_smul]
    refine ⟨m, ?_, ?_⟩
    · change latticeVector m ∈ toricDivisorPolytope ((k : ℤ) • D)
      rw [mem_toricDivisorPolytope_smul_iff D hk, hm]
      exact Set.smul_mem_smul_set hxP
    · rw [hx]
      exact integerCast_toricFlagLatticeMap_smul v e D hk m

/-! ### The Okounkov body -/

/-- Every `x ∈ M_ℝ` is `∑_j ⟨x, u_j(v)⟩ b_j(v)` (`b(v)` and `u(v)` are dual bases). -/
theorem eq_sum_latticeFunctional_rayGenerator (x : EuclideanSpace ℝ (Fin n)) :
    x = ∑ j, latticeFunctional (polytopeToricRayGenerator γ hs v j) x •
      latticeVector (originalPolytopeNativeBasis γ hs v j) := by
  apply ext_inner_left ℝ
  intro m
  rw [real_inner_comm, inner_eq_sum_basis hs v x m, inner_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [inner_smul_right, real_inner_comm, inner_latticeVector, mul_comm]

variable (hs) in
/-- `Ψ(y) = ∑_l y_l b_{e(l)}(v)`, the inverse of the linear part of `Φ_ℝ`. -/
def toricFlagRealInverse (y : Fin n → ℝ) : EuclideanSpace ℝ (Fin n) :=
  ∑ l, y l • latticeVector (originalPolytopeNativeBasis γ hs v (e l))

theorem toricFlagRealInverse_add (y y' : Fin n → ℝ) :
    toricFlagRealInverse hs v e (y + y') = toricFlagRealInverse hs v e y +
      toricFlagRealInverse hs v e y' := by
  simp only [toricFlagRealInverse, Pi.add_apply, add_smul, Finset.sum_add_distrib]

theorem toricFlagRealInverse_smul (c : ℝ) (y : Fin n → ℝ) :
    toricFlagRealInverse hs v e (c • y) = c • toricFlagRealInverse hs v e y := by
  simp only [toricFlagRealInverse, Pi.smul_apply, smul_eq_mul, Finset.smul_sum, smul_smul]

theorem continuous_toricFlagRealInverse : Continuous (toricFlagRealInverse hs v e) :=
  continuous_finsetSum _ fun l _ => (continuous_apply l).smul continuous_const

theorem latticeFunctional_toricFlagRealInverse (y : Fin n → ℝ) (l : Fin n) :
    latticeFunctional (polytopeToricRayGenerator γ hs v (e l)) (toricFlagRealInverse hs v e y) = y l := by
  simp only [toricFlagRealInverse, map_sum, map_smul, latticeFunctional_latticeVector, smul_eq_mul]
  rw [Finset.sum_eq_single l]
  · rw [intPairing_comm, intPairing_basis_rayGenerator, if_pos rfl, Int.cast_one, mul_one]
  · intro l' _ hl'
    rw [intPairing_comm, intPairing_basis_rayGenerator, if_neg (e.injective.ne hl'), Int.cast_zero,
      mul_zero]
  · intro h; exact absurd (Finset.mem_univ l) h

theorem toricFlagRealMap_inverse (y : Fin n → ℝ) :
    toricFlagRealMap hs v e D (toricFlagRealInverse hs v e y + latticeVector (toricCartierDatum D v)) =
      y := by
  funext l
  simp only [toricFlagRealMap, map_add, latticeFunctional_toricFlagRealInverse,
    latticeFunctional_latticeVector]
  rw [intPairing_comm]
  ring

/-- `Ψ(Φ(m)) + m_σ = m`. -/
theorem toricFlagRealInverse_latticeMap (D' : ToricDivisor γ hs) (m : Fin n → ℤ) :
    toricFlagRealInverse hs v e (integerCast (toricFlagLatticeMap hs v e D' m)) +
      latticeVector (toricCartierDatum D' v) = latticeVector m := by
  have hx := eq_sum_latticeFunctional_rayGenerator (hs := hs) v
    (latticeVector m - latticeVector (toricCartierDatum D' v))
  have h1 : toricFlagRealInverse hs v e (integerCast (toricFlagLatticeMap hs v e D' m)) =
      latticeVector m - latticeVector (toricCartierDatum D' v) := by
    rw [hx, toricFlagRealInverse]
    refine (Fintype.sum_equiv e _ _ fun l => ?_)
    congr 1
    simp only [integerCast, toricFlagLatticeMap, map_sub, latticeFunctional_latticeVector,
      intPairing_sub]
    push_cast
    rw [intPairing_comm m, intPairing_comm (toricCartierDatum D' v)]
  rw [h1, sub_add_cancel]

/-- The closed convex cone `{(y, t) : t ≥ 0, Ψ(y) + t m_σ ∈ t P_D}` over `Φ_ℝ(P_D)`. -/
def toricFlagConvexCone : ConvexCone ℝ ((Fin n → ℝ) × ℝ) where
  carrier := {p | 0 ≤ p.2 ∧ ∀ ρ : PolytopeToricRays γ hs, -(p.2 * (D ρ : ℝ)) ≤
    latticeFunctional ρ.val (toricFlagRealInverse hs v e p.1 + p.2 • latticeVector (toricCartierDatum D v))}
  smul_mem' := by
    rintro c hc ⟨y, t⟩ ⟨ht, hρ⟩
    refine ⟨mul_nonneg hc.le ht, fun ρ => ?_⟩
    change -((c * t) * (D ρ : ℝ)) ≤ latticeFunctional ρ.val
      (toricFlagRealInverse hs v e (c • y) + (c * t) • latticeVector (toricCartierDatum D v))
    rw [toricFlagRealInverse_smul, mul_smul, ← smul_add, map_smul, smul_eq_mul]
    have := mul_le_mul_of_nonneg_left (hρ ρ) hc.le
    linarith
  add_mem' := by
    rintro ⟨y, t⟩ ⟨ht, hρ⟩ ⟨y', t'⟩ ⟨ht', hρ'⟩
    refine ⟨add_nonneg ht ht', fun ρ => ?_⟩
    change -((t + t') * (D ρ : ℝ)) ≤ latticeFunctional ρ.val
      (toricFlagRealInverse hs v e (y + y') + (t + t') • latticeVector (toricCartierDatum D v))
    have h1 := hρ ρ
    have h2 := hρ' ρ
    simp only at h1 h2
    rw [toricFlagRealInverse_add, add_smul]
    have : toricFlagRealInverse hs v e y + toricFlagRealInverse hs v e y' +
        (t • latticeVector (toricCartierDatum D v) + t' • latticeVector (toricCartierDatum D v)) =
        (toricFlagRealInverse hs v e y + t • latticeVector (toricCartierDatum D v)) +
        (toricFlagRealInverse hs v e y' + t' • latticeVector (toricCartierDatum D v)) := by abel
    rw [this, map_add]
    linarith

theorem isClosed_toricFlagConvexCone :
    IsClosed (toricFlagConvexCone v e D : Set ((Fin n → ℝ) × ℝ)) := by
  have : (toricFlagConvexCone v e D : Set ((Fin n → ℝ) × ℝ)) = {p | 0 ≤ p.2} ∩
      ⋂ ρ : PolytopeToricRays γ hs, {p | -(p.2 * (D ρ : ℝ)) ≤ latticeFunctional ρ.val
        (toricFlagRealInverse hs v e p.1 + p.2 • latticeVector (toricCartierDatum D v))} := by
    ext p; simp [toricFlagConvexCone]
  rw [this]
  refine (isClosed_le continuous_const continuous_snd).inter (isClosed_iInter fun ρ => ?_)
  exact isClosed_le ((continuous_snd.mul continuous_const).neg)
    ((LinearMap.continuous_of_finiteDimensional _).comp
      (((continuous_toricFlagRealInverse v e).comp continuous_fst).add
        (continuous_snd.smul continuous_const)))

theorem closedCone_subset_toricFlagConvexCone :
    (Okounkov.closedCone (toricSectionSemigroup v e D) : Set ((Fin n → ℝ) × ℝ)) ⊆
      toricFlagConvexCone v e D := by
  have hpt : (toricFlagConvexCone v e D).Pointed := by
    refine ⟨le_refl _, fun ρ => ?_⟩
    simp [toricFlagRealInverse]
  have hh : PointedCone.hull ℝ (latticeCast n '' (toricSectionSemigroup v e D : Set _)) ≤
      (toricFlagConvexCone v e D).toPointedCone hpt := by
    apply Submodule.span_le.mpr
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨k, m, hm, rfl⟩ := (mem_toricSectionSemigroup_iff v e D z).mp hz
    refine ⟨by simp [latticeCast], fun ρ => ?_⟩
    change -((k : ℝ) * (D ρ : ℝ)) ≤ latticeFunctional ρ.val
      (toricFlagRealInverse hs v e (integerCast (toricFlagLatticeMap hs v e ((k : ℤ) • D) m)) +
        (k : ℝ) • latticeVector (toricCartierDatum D v))
    have hmv : (k : ℝ) • latticeVector (toricCartierDatum D v) =
        latticeVector (toricCartierDatum ((k : ℤ) • D) v) := by
      rw [toricCartierDatum_smul]
      ext i; simp
    rw [hmv, toricFlagRealInverse_latticeMap]
    have := hm ρ
    simp only [Pi.smul_apply, smul_eq_mul, Int.cast_mul, Int.cast_natCast] at this
    linarith
  exact closure_minimal hh (isClosed_toricFlagConvexCone v e D)

/-- Source `prop:toricusualOko`: `Δ_{Y•}(L) = Φ_ℝ(P_D)`. -/
theorem toricOkounkovBody_eq :
    toricOkounkovBody v e D = toricFlagRealMap hs v e D '' toricDivisorPolytope D := by
  apply Subset.antisymm
  · intro y hy
    have h1 : (y, (1 : ℝ)) ∈ (toricFlagConvexCone v e D : Set ((Fin n → ℝ) × ℝ)) :=
      closedCone_subset_toricFlagConvexCone v e D hy
    obtain ⟨-, hρ⟩ := h1
    refine ⟨toricFlagRealInverse hs v e y + latticeVector (toricCartierDatum D v), fun ρ => ?_,
      toricFlagRealMap_inverse v e D y⟩
    have := hρ ρ
    simp only [one_mul, one_smul] at this
    exact this
  · -- `Φ_ℝ⁻¹(Δ)` is closed, convex and contains the (rational) extreme points of `P_D`
    set B := toricFlagRealMap hs v e D ⁻¹' toricOkounkovBody v e D
    have hBclosed : IsClosed B := by
      have hclosed : IsClosed (toricOkounkovBody v e D) :=
        (Okounkov.isClosed_closedCone _).preimage (continuous_id.prodMk continuous_const)
      exact hclosed.preimage (continuous_toricFlagRealMap v e D)
    have hBconv : Convex ℝ B := by
      intro x hx x' hx' a b ha hb hab
      have hΦ : toricFlagRealMap hs v e D (a • x + b • x') =
          a • toricFlagRealMap hs v e D x + b • toricFlagRealMap hs v e D x' := by
        funext l
        simp only [toricFlagRealMap, map_add, map_smul, smul_eq_mul, Pi.add_apply, Pi.smul_apply]
        linear_combination
          (intPairing (toricCartierDatum D v) (polytopeToricRayGenerator γ hs v (e l)) : ℝ) * hab
      change toricFlagRealMap hs v e D (a • x + b • x') ∈ toricOkounkovBody v e D
      rw [hΦ]
      exact Okounkov.convex_body _ hx hx' ha hb hab
    have hext : (toricDivisorPolytope D).extremePoints ℝ ⊆ B := by
      intro x hxe
      obtain ⟨k, m, hk, hm⟩ := exists_latticeVector_eq_smul_of_mem_extremePoints D hxe
      have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
      have hmΛ : m ∈ toricLatticePoints ((k : ℤ) • D) := by
        change latticeVector m ∈ toricDivisorPolytope ((k : ℤ) • D)
        rw [mem_toricDivisorPolytope_smul_iff D hk, hm]
        exact Set.smul_mem_smul_set hxe.1
      have hz : (toricFlagLatticeMap hs v e ((k : ℤ) • D) m, (k : ℤ)) ∈ toricSectionSemigroup v e D :=
        (mem_toricSectionSemigroup_iff v e D _).mpr ⟨k, m, hmΛ, rfl⟩
      have hnorm := Okounkov.normalizedPoint_mem_heightOne
        (Okounkov.closedCone (toricSectionSemigroup v e D) : ConvexCone ℝ ((Fin n → ℝ) × ℝ))
        (z := (toricFlagLatticeMap hs v e ((k : ℤ) • D) m, (k : ℤ)))
        (Okounkov.mem_closedCone_of_mem _ hz) (show (0 : ℤ) < (k : ℤ) by exact_mod_cast hk)
      have hval : Okounkov.normalizedPoint (toricFlagLatticeMap hs v e ((k : ℤ) • D) m, (k : ℤ)) =
          (k : ℝ)⁻¹ • integerCast (toricFlagLatticeMap hs v e ((k : ℤ) • D) m) := by
        simp [Okounkov.normalizedPoint]
      rw [hval] at hnorm
      change toricFlagRealMap hs v e D x ∈ toricOkounkovBody v e D
      have hx : x = (k : ℝ)⁻¹ • latticeVector m := by
        rw [hm, smul_smul, inv_mul_cancel₀ hk', one_smul]
      rw [hx, ← integerCast_toricFlagLatticeMap_smul v e D hk m]
      exact hnorm
    have hP : toricDivisorPolytope D ⊆ B := by
      rw [← closure_convexHull_extremePoints (isCompact_toricDivisorPolytope D)
        (convex_toricDivisorPolytope D)]
      exact closure_minimal (convexHull_min hext hBconv) hBclosed
    rintro _ ⟨x, hx, rfl⟩
    exact hP hx

end SGPT.Toric
