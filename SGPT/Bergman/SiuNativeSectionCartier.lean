import SGPT.Bergman.SiuNSCartierBundle
import SGPT.Bergman.SourceNativeSectionLogPsh

/-! The actual effective Cartier ideal of an actual native global section.
All changes of actual local generators are proved from native coordinates. -/
set_option autoImplicit false
noncomputable section
namespace SGPT.BDivisor.NSKodaira
open Set Filter Bundle
open scoped Topology Manifold ContDiff BigOperators
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending InvertibleIdealQuotient RelativePrincipalizationSpan
open SGPT.Bergman.TensorDictionaryDraft SGPT.Bergman.PolynomialH0Growth
open SGPT.Bergman.NativeHermitianMetric SGPT.Bergman.QuantizationDraft
open SGPT.Bergman.CompactHolomorphicSectionsDraft SGPT.LineBundle.TMetric
open HermitianHolomorphicLineBundle

variable {n : ℕ} {X : Type} [TopologicalSpace X]
  [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  (L : HermitianHolomorphicLineBundle n X) (s : HolomorphicSections (n := n) L.Fiber)

/-- Every actual section coefficient is a genuine holomorphic germ in any
actual native frame domain. -/
theorem nativeSectionCoefficient_holomorphicAt (e : AtlasFrame L) {p : X}
    (hp : p ∈ e.val.baseSet) : HolomorphicAt n (sectionCoefficient L.Fiber e.val s) p := by
  let := e.property
  filter_upwards [e.val.open_baseSet.mem_nhds hp] with y hy
  exact ((e.val.contMDiffAt_section_iff hy).mp (s.contMDiff y)).mdifferentiableAt (by simp)

/-- The actual section coefficients obey the exact native linear transition
law; no frame coefficient identity is supplied as an assumption. -/
theorem nativeSectionCoefficient_transition (e f : AtlasFrame L) {p : X}
    (he : p ∈ e.val.baseSet) (hf : p ∈ f.val.baseSet) :
    sectionCoefficient L.Fiber f.val s p =
      sectionCoefficient L.Fiber e.val s p * frameTransition e f p := by
  let := e.property
  let := f.property
  have hread : (e.val.coordChangeL ℂ f.val p) (sectionCoefficient L.Fiber e.val s p) =
      sectionCoefficient L.Fiber f.val s p := by
    rw [Trivialization.coordChangeL_apply e.val f.val ⟨he, hf⟩]
    dsimp only [sectionCoefficient]
    rw [e.val.symm_apply_apply_mk he]
  rw [← hread]
  have hlin := (e.val.coordChangeL ℂ f.val p).map_smul
    (sectionCoefficient L.Fiber e.val s p) (1 : ℂ)
  simpa only [smul_eq_mul, mul_one, frameTransition] using hlin

/-- One actual coefficient belongs to the entire germ ideal generated by
the coefficient in another actual frame, including at section zeros. -/
theorem nativeSectionCoefficient_mem_frame_span (e f : AtlasFrame L) {p : X}
    (he : p ∈ e.val.baseSet) (hf : p ∈ f.val.baseSet) :
    IsInSpanAt (n := n) (· = sectionCoefficient L.Fiber e.val s) p
      (sectionCoefficient L.Fiber f.val s) := by
  have ht : HolomorphicAt n (frameTransition e f) p := by
    filter_upwards [(e.val.open_baseSet.inter f.val.open_baseSet).mem_nhds ⟨he, hf⟩] with y hy
    exact frameTransition_mdifferentiableAt e f hy
  refine isInSpanAt_of_eq_mul rfl (nativeSectionCoefficient_holomorphicAt L s f hf) ht ?_
  filter_upwards [(e.val.open_baseSet.inter f.val.open_baseSet).mem_nhds ⟨he, hf⟩] with y hy
  rw [nativeSectionCoefficient_transition L s e f hy.1 hy.2, mul_comm]

/-- Whole original principal germ ideals are independent of genuine native
frame, rather than merely their zero sets or radicals. -/
theorem sectionCoefficient_span_frame_iff (e f : AtlasFrame L) {p : X}
    (he : p ∈ e.val.baseSet) (hf : p ∈ f.val.baseSet) (g : X → ℂ) :
    IsInSpanAt (n := n) (· = sectionCoefficient L.Fiber e.val s) p g ↔
      IsInSpanAt (n := n) (· = sectionCoefficient L.Fiber f.val s) p g := by
  constructor
  · exact IsInSpanAt.trans (fun k hk => hk ▸ nativeSectionCoefficient_mem_frame_span L s f e hf he)
  · exact IsInSpanAt.trans (fun k hk => hk ▸ nativeSectionCoefficient_mem_frame_span L s e f he hf)

/-- The actual full original stalk ideal of the section, defined using
genuine native frames and their proved coordinate transformations. -/
def nativeSectionIdeal : GermIdeal n X where
  mem p g := ∃ e : AtlasFrame L, p ∈ e.val.baseSet ∧
    IsInSpanAt (n := n) (· = sectionCoefficient L.Fiber e.val s) p g

/-- On any genuine frame domain the entire original ideal has exactly the
actual section coefficient as its single generator. -/
theorem nativeSectionIdeal_frame (e : AtlasFrame L) {p : X}
    (he : p ∈ e.val.baseSet) (g : X → ℂ) :
    (nativeSectionIdeal L s).mem p g ↔
      IsInSpanAt (n := n) (· = sectionCoefficient L.Fiber e.val s) p g := by
  constructor
  · rintro ⟨f, hf, hg⟩
    exact (sectionCoefficient_span_frame_iff L s f e hf he g).mp hg
  · exact fun hg => ⟨e, he, hg⟩

/-- Dense nonzero original section values supply the actual nonzero
Cartier generators required by invertibility at every original stalk. -/
theorem nativeSectionIdeal_isInvertible
    (hdense : ∀ U : Set X, IsOpen U → U.Nonempty → ∃ y ∈ U, s y ≠ 0) :
    (nativeSectionIdeal L s).IsInvertible := by
  intro x
  let e : AtlasFrame L := ⟨trivializationAt ℂ L.Fiber x, inferInstance⟩
  have hx : x ∈ e.val.baseSet := mem_baseSet_trivializationAt ℂ L.Fiber x
  refine ⟨e.val.baseSet, e.val.open_baseSet, hx, sectionCoefficient L.Fiber e.val s, ?_, ?_, ?_⟩
  · intro y hy
    exact (nativeSectionCoefficient_holomorphicAt L s e hy).self_of_nhds.mdifferentiableWithinAt
  · intro U hU hUe hUne
    obtain ⟨y, hyU, hy⟩ := hdense U hU hUne
    refine ⟨y, hyU, ?_⟩
    intro hzero
    have hn := norm_eq_coefficient_mul_frameNorm L.Fiber e.val s (hUe hyU)
    rw [hzero, norm_zero, zero_mul] at hn
    exact hy (norm_eq_zero.mp hn)
  · intro y hy g
    exact nativeSectionIdeal_frame L s e hy g

/-- The actual effective Cartier divisor on the original manifold cut out
by the actual native section with dense nonzero locus. -/
def nativeSectionCartierDivisor
    (hdense : ∀ U : Set X, IsOpen U → U.Nonempty → ∃ y ∈ U, s y ≠ 0) :
    EffectiveDivisor n X where
  ideal := nativeSectionIdeal L s
  isInvertible := nativeSectionIdeal_isInvertible L s hdense

end SGPT.BDivisor.NSKodaira
