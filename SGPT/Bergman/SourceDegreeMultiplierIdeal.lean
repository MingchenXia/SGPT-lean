import SGPT.Bergman.SourceHolomorphicSectionSheaf
import SGPT.Foundations.Analysis.Pending.MultiplierIdealProductComparison
import SGPT.Foundations.Analysis.Pending.GlobalQuasiPshMultiplierCoherence
import SGPT.Foundations.Analysis.Pending.ZeroDimensionalQuasiPshMultiplierIdeals

/-!
# DegreeMultiplierIdeal

The multiplier ideal `I(kφ)` of the scaled potential `kφ` used in `H⁰(X, L^k ⊗ T ⊗ I(kφ))` (source `def:Bergman:L778`), its coherence for quasi-psh `φ`, and `I(0) = O_X`.

Ported from the previous team's drafts (`work/sgpt-active-lanes-20261102/bergman-*`).
-/

set_option autoImplicit false
noncomputable section

namespace SGPT.Bergman.MultiplierSectionsDraft

open Bundle Set Filter TopologicalSpace MeasureTheory Metric
open scoped Topology ENNReal Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending

/-- EXACT original source exponent: the same coefficient c, the same potential, no factor2 or reader rescaling. -/
theorem multiplierDensity_scaled_one {Y : Type*} (φ : Y → EReal) (c : ℝ) (a : Y → ℂ) :
    multiplierDensity (fun y => (c : EReal) * φ y) 1 a = multiplierDensity φ c a := by
  funext y
  simp [multiplierDensity, multiplierWeight]

/-- The literal original source weighted-L2 predicate has EXACTLY the same scaled-one density. -/
theorem weightedL2On_scaled_one_iff {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℂ Y]
    [MeasurableSpace Y] [BorelSpace Y] (φ : Y → EReal) (c : ℝ) (a : Y → ℂ)
    (U : Set Y) (μ : Measure Y) :
    WeightedL2On (fun y => (c : EReal) * φ y) 1 a U μ ↔ WeightedL2On φ c a U μ := by
  unfold WeightedL2On
  rw [multiplierDensity_scaled_one]

/-- Positive-degree original multiplier membership retains the exact SAME unscaled original potential. -/
theorem multiplierIntegrableAt_scaled_one_iff {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℂ Y]
    [MeasurableSpace Y] [BorelSpace Y] (φ : Y → EReal) {c : ℝ} (hc : 0 < c)
    (a : Y → ℂ) (y : Y) (μ : Measure Y) :
    MultiplierIntegrableAt (fun z => (c : EReal) * φ z) 1 a y μ ↔ MultiplierIntegrableAt φ c a y μ := by
  constructor
  · rintro ⟨_, U, hU, hy, hhol, hL2⟩
    exact ⟨hc, U, hU, hy, hhol, (weightedL2On_scaled_one_iff φ c a U μ).mp hL2⟩
  · rintro ⟨_, U, hU, hy, hhol, hL2⟩
    exact ⟨one_pos, U, hU, hy, hhol, (weightedL2On_scaled_one_iff φ c a U μ).mpr hL2⟩

variable {n : ℕ} {X : Type} [TopologicalSpace X]
  [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]

/-- Literal source I(k phi), using the ORIGINAL positive-exponent definition at the actual scaled potential.
At k=0 this is I(0), rather than the native forbidden c=0 predicate. -/
def sourceDegreeMultiplierIdeal (k : ℕ) (φ : X → EReal) : GermIdeal n X :=
  multiplierIdeal (n := n) 1 (fun x => ((k : ℝ) : EReal) * φ x)

omit [IsComplexManifold n X] in
/-- For every original positive degree, source I(k phi) is EXACTLY the native parameter-k ideal on SAME phi. -/
theorem sourceDegreeMultiplierIdeal_pos (k : ℕ) (hk : 0 < k) (φ : X → EReal) :
    sourceDegreeMultiplierIdeal (n := n) k φ = multiplierIdeal (n := n) (k : ℝ) φ := by
  ext x a
  change (HolomorphicAt n a x ∧ MultiplierIntegrableAt
      (chartFunction (fun y => ((k : ℝ) : EReal) * φ y) (complexChartAt (n := n) x)) 1
      (fun z => a ((complexChartAt (n := n) x).val.symm z))
      ((complexChartAt (n := n) x).val x) volume) ↔ _
  exact and_congr_right fun _ => multiplierIntegrableAt_scaled_one_iff _
    (Nat.cast_pos.mpr hk) _ _ _

/-- The ACTUAL unit ideal sheaf O_X at every original point. -/
def originalUnitGermIdeal : GermIdeal n X where
  mem x a := HolomorphicAt n a x

omit [IsComplexManifold n X] in
/-- The unit ideal is coherently generated by the true original scalar one, including n=0. -/
theorem originalUnitGermIdeal_isCoherent : (originalUnitGermIdeal (n := n) (X := X)).IsCoherent := by
  intro x
  refine ⟨Set.univ, isOpen_univ, Set.mem_univ x, 1, fun _ _ => 1,
    fun _ => mdifferentiableOn_const, ?_⟩
  intro y _ a
  constructor
  · intro ha
    refine ⟨ha, 1, fun _ _ => 1, fun _ => a, fun _ => ⟨0, rfl⟩, fun _ => ha, ?_⟩
    exact Filter.Eventually.of_forall fun z => by simp
  · exact fun ha => ha.1

omit [IsComplexManifold n X] in
/-- Genuine original chart-ball integration produces the unit multiplier at the zero potential. -/
theorem one_mem_zeroPotentialMultiplier {c : ℝ} (hc : 0 < c) (x : X) :
    (multiplierIdeal (n := n) c (fun _ : X => (0 : EReal))).mem x (fun _ => (1 : ℂ)) := by
  let e := complexChartAt (n := n) x
  have hd : multiplierDensity (chartFunction (fun _ : X => (0 : EReal)) e) c
      (fun _ => (1 : ℂ)) = fun _ => (1 : ℝ≥0∞) := by
    funext z
    simp [multiplierDensity, multiplierWeight, chartFunction]
  refine ⟨holomorphicAt_const (n := n) (M := X) 1, hc, ball (e.val x) 1,
    isOpen_ball, mem_ball_self one_pos, differentiableOn_const _, ?_, ?_⟩
  · rw [hd]
    exact aemeasurable_const
  · rw [hd, lintegral_const, Measure.restrict_apply_univ, one_mul]
    exact measure_ball_lt_top

/-- The ORIGINAL zero-potential multiplier ideal is the true unit ideal, by actual integrability and holomorphic absorption. -/
theorem zeroPotentialMultiplier_eq_unit {c : ℝ} (hc : 0 < c) :
    multiplierIdeal (n := n) c (fun _ : X => (0 : EReal)) = originalUnitGermIdeal (n := n) (X := X) := by
  ext x a
  constructor
  · exact fun ha => ha.1
  · intro ha
    have hm := MultiplierIdealProductComparison.mem_multiplierIdeal_holomorphic_mul ha
      (one_mem_zeroPotentialMultiplier (n := n) hc x)
    exact MultiplierIdealProductComparison.mem_multiplierIdeal_congr hm
      (Filter.Eventually.of_forall fun y => mul_one (a y))

/-- Source degree zero REALLY gives I(0)=O_X, including original minus-infinity poles. -/
theorem sourceDegreeMultiplierIdeal_zero (φ : X → EReal) :
    sourceDegreeMultiplierIdeal (n := n) 0 φ = originalUnitGermIdeal (n := n) (X := X) := by
  unfold sourceDegreeMultiplierIdeal
  simp only [Nat.cast_zero, EReal.coe_zero, zero_mul]
  exact zeroPotentialMultiplier_eq_unit (n := n) one_pos

/-- Genuine original quasi-PSH potentials produce full multiplier coherence in EVERY dimension, including n=0. -/
theorem multiplierIdeal_isCoherent_genuine {φ : X → EReal}
    (hφ : IsGlobalQuasiPshPotential (n := n) φ) {c : ℝ} (hc : 0 < c) :
    (multiplierIdeal (n := n) c φ).IsCoherent := by
  cases n with
  | zero =>
    have heq : multiplierIdeal (n := 0) c φ = originalUnitGermIdeal (n := 0) (X := X) := by
      ext x a
      exact ZeroDimensionalQuasiPshMultiplierIdeals.mem_multiplierIdeal_iff_holomorphicAt hφ hc x a
    rw [heq]
    exact originalUnitGermIdeal_isCoherent (n := 0) (X := X)
  | succ m =>
    exact GlobalQuasiPshMultiplierCoherence.isCoherent_multiplierIdeal_of_manifoldQuasiPlurisubharmonic
      (Nat.succ_pos m) hφ.1 hc

/-- Coherence of the SAME literal original degree ideal is internally produced, with no incoming ideal/Gamma certificate. -/
theorem sourceDegreeMultiplierIdeal_isCoherent (k : ℕ) {φ : X → EReal}
    (hφ : IsGlobalQuasiPshPotential (n := n) φ) :
    (sourceDegreeMultiplierIdeal (n := n) k φ).IsCoherent := by
  cases k with
  | zero =>
    rw [sourceDegreeMultiplierIdeal_zero]
    exact originalUnitGermIdeal_isCoherent (n := n) (X := X)
  | succ k =>
    rw [sourceDegreeMultiplierIdeal_pos _ (Nat.succ_pos k)]
    exact multiplierIdeal_isCoherent_genuine hφ (Nat.cast_pos.mpr (Nat.succ_pos k))

end SGPT.Bergman.MultiplierSectionsDraft
