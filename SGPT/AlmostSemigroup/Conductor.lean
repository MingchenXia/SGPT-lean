import SGPT.AlmostSemigroup.Counting
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Geometry.Convex.Cone.Pointed
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Actual translated-semigroup conductors

The additive-generation and finite-remainder ingredients for the remaining
semigroup clauses of Appendix C `thm:KK12growth`. The semigroup is the actual
additively closed subset; a degree-zero identity is not imposed.
-/

namespace SGPT.AlmostSemigroup.Conductor

open Set
open scoped BigOperators Pointwise

variable {A : Type*} [AddCommGroup A]

/-- Elements of the actual generated subgroup are differences of semigroup elements.
Nonemptiness handles zero without imposing a degree-zero identity on the semigroup. -/
theorem exists_sub_of_mem_closure (S : AddSubsemigroup A) (hne : (S : Set A).Nonempty)
    {u : A} (hu : u ∈ AddSubgroup.closure (S : Set A)) :
    ∃ p ∈ S, ∃ q ∈ S, u = p - q := by
  obtain ⟨w, hw⟩ := hne
  induction hu using AddSubgroup.closure_induction with
  | mem s hs =>
    exact ⟨s + w, S.add_mem hs hw, w, hw, by abel⟩
  | zero => exact ⟨w, hw, w, hw, by abel⟩
  | add x y hx hy hpx hpy =>
    obtain ⟨p, hp, q, hq, rfl⟩ := hpx
    obtain ⟨p', hp', q', hq', rfl⟩ := hpy
    exact ⟨p + p', S.add_mem hp hp', q + q', S.add_mem hq hq', by abel⟩
  | neg x hx hpx =>
    obtain ⟨p, hp, q, hq, rfl⟩ := hpx
    exact ⟨q, hq, p, hp, by abel⟩

/-- One actual semigroup element translates an entire finite subgroup set into the semigroup. -/
theorem exists_translate_of_finite (S : AddSubsemigroup A)
    (hne : (S : Set A).Nonempty) {R : Set A} (hR : R.Finite)
    (hgroup : R ⊆ AddSubgroup.closure (S : Set A)) :
    ∃ f ∈ S, ∀ u ∈ R, u + f ∈ S := by
  induction R, hR using Set.Finite.induction_on with
  | empty =>
    obtain ⟨w, hw⟩ := hne
    exact ⟨w, hw, by simp⟩
  | @insert u R hR hu ih =>
    obtain ⟨f, hf, hclear⟩ := ih (fun x hx => hgroup (Set.mem_insert_of_mem u hx))
    obtain ⟨p, hp, q, hq, huq⟩ := exists_sub_of_mem_closure S hne
      (hgroup (Set.mem_insert u R))
    refine ⟨f + q, S.add_mem hf hq, ?_⟩
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · have heq : x + (f + q) = p + f := by rw [huq]; abel
      rw [heq]
      exact S.add_mem hp hf
    · simpa [add_assoc] using S.add_mem (hclear x hx) hq

/-- Coordinate casting as an additive map, used to preserve the actual integer remainder. -/
def integerCastHom (d : ℕ) : (Fin d → ℤ) →+ (Fin d → ℝ) where
  toFun := Counting.integerCast
  map_zero' := by ext; simp [Counting.integerCast]
  map_add' x y := by ext; simp [Counting.integerCast]

/-- The bounded fractional-coefficient zonotope of the actual integer generators. -/
def fractionalZonotope {d m : ℕ} (v : Fin m → Fin d → ℤ) : Set (Fin d → ℝ) :=
  (fun t : Fin m → ℝ => ∑ i, t i • Counting.integerCast (v i)) '' Set.Icc 0 1

/-- The fractional remainders lie in a genuine compact image of the coefficient cube. -/
theorem isCompact_fractionalZonotope {d m : ℕ} (v : Fin m → Fin d → ℤ) :
    IsCompact (fractionalZonotope v) := by
  apply isCompact_Icc.image
  exact continuous_finsetSum Finset.univ fun i _ =>
    (continuous_apply i).smul continuous_const

/-- Only finitely many actual integer lattice vectors can occur as fractional remainders. -/
theorem finite_integer_remainders {d m : ℕ} (v : Fin m → Fin d → ℤ) :
    (Counting.integerPoints (fractionalZonotope v)).Finite :=
  Counting.finite_integerPoints (isCompact_fractionalZonotope v).isBounded

/-- The intrinsic pointed cone generated by a finite family of actual lattice vectors. -/
def generatedCone {d m : ℕ} (v : Fin m → Fin d → ℤ) : PointedCone ℝ (Fin d → ℝ) :=
  PointedCone.hull ℝ (Set.range (Counting.integerCast ∘ v))

/-- Membership in the actual generated cone gives finite nonnegative coefficients. -/
theorem mem_generatedCone_iff {d m : ℕ} (v : Fin m → Fin d → ℤ) (x : Fin d → ℝ) :
    x ∈ generatedCone v ↔ ∃ t : Fin m → ℝ,
      (∀ i, 0 ≤ t i) ∧ ∑ i, t i • Counting.integerCast (v i) = x := by
  change x ∈ Submodule.span {r : ℝ // 0 ≤ r}
    (Set.range (Counting.integerCast ∘ v)) ↔ _
  rw [Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨t, ht⟩
    exact ⟨fun i => (t i : ℝ), fun i => (t i).property, ht⟩
  · rintro ⟨t, ht, heq⟩
    exact ⟨fun i => ⟨t i, ht i⟩, heq⟩

/-- The actual integer sum casts to the same real nonnegative combination. -/
theorem integerCast_sum_nsmul {d m : ℕ} (v : Fin m → Fin d → ℤ)
    (a : Fin m → ℕ) :
    Counting.integerCast (∑ i, a i • v i) =
      ∑ i, (a i : ℝ) • Counting.integerCast (v i) := by
  ext j
  simp [Counting.integerCast, Finset.sum_apply, nsmul_eq_mul, smul_eq_mul]

/-- Floor coefficients split every actual cone lattice point into an integer
nonnegative combination plus one of the genuine finite lattice remainders. -/
theorem floor_decomposition {d m : ℕ} (v : Fin m → Fin d → ℤ)
    {x : Fin d → ℤ} (hx : Counting.integerCast x ∈ generatedCone v) :
    ∃ a : Fin m → ℕ,
      x - ∑ i, a i • v i ∈ Counting.integerPoints (fractionalZonotope v) := by
  obtain ⟨t, ht, htx⟩ := (mem_generatedCone_iff v _).mp hx
  let a : Fin m → ℕ := fun i => ⌊t i⌋₊
  refine ⟨a, ?_⟩
  change Counting.integerCast (x - ∑ i, a i • v i) ∈ fractionalZonotope v
  refine ⟨fun i => t i - (a i : ℝ), ?_, ?_⟩
  · constructor
    · intro i
      exact sub_nonneg.mpr (Nat.floor_le (ht i))
    · intro i
      have h := Nat.lt_floor_add_one (t i)
      dsimp [a]
      linarith
  · have hc : Counting.integerCast (x - ∑ i, a i • v i) =
        Counting.integerCast x - Counting.integerCast (∑ i, a i • v i) := by
      exact (integerCastHom d).map_sub _ _
    rw [hc, integerCast_sum_nsmul, ← htx, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    exact sub_smul _ _ _

/-- Repeatedly adding an actual generator preserves semigroup membership, including zero copies. -/
theorem add_nsmul_mem (S : AddSubsemigroup A) {u v : A}
    (hu : u ∈ S) (hv : v ∈ S) (k : ℕ) : u + k • v ∈ S := by
  induction k with
  | zero => simpa using hu
  | succ k ih => simpa [succ_nsmul, add_assoc] using S.add_mem ih hv

/-- Adding any actual finite nonnegative generator combination preserves membership. -/
theorem add_sum_nsmul_mem {ι : Type*} [Fintype ι] (S : AddSubsemigroup A)
    {u : A} (hu : u ∈ S) (v : ι → A) (hv : ∀ i, v i ∈ S) (a : ι → ℕ) :
    u + ∑ i, a i • v i ∈ S := by
  classical
  have hs (s : Finset ι) : u + ∑ i ∈ s, a i • v i ∈ S := by
    induction s using Finset.induction_on with
    | empty => simpa using hu
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      simpa [add_assoc, add_comm, add_left_comm] using add_nsmul_mem S ih (hv i) (a i)
  exact hs Finset.univ

/-- Every actual generated subgroup admits a semigroup translate of the points
it contributes to a finite inner cone. No full-lattice assumption is needed. -/
theorem exists_conductor_in_generated_group {d m : ℕ} (S : AddSubsemigroup (Fin d → ℤ))
    (hne : (S : Set (Fin d → ℤ)).Nonempty)
    (v : Fin m → Fin d → ℤ) (hv : ∀ i, v i ∈ S) :
    ∃ f ∈ S, ∀ x ∈ AddSubgroup.closure (S : Set (Fin d → ℤ)),
      Counting.integerCast x ∈ generatedCone v → x + f ∈ S := by
  let G := AddSubgroup.closure (S : Set (Fin d → ℤ))
  obtain ⟨f, hf, hclear⟩ := exists_translate_of_finite S hne
    ((finite_integer_remainders v).inter_of_left (G : Set (Fin d → ℤ)))
    (fun _ hx => hx.2)
  refine ⟨f, hf, ?_⟩
  intro x hxgroup hx
  obtain ⟨a, ha⟩ := floor_decomposition v hx
  have hsum : (∑ i, a i • v i) ∈ G := by
    apply G.sum_mem
    intro i _
    exact G.nsmul_mem (AddSubgroup.subset_closure (hv i)) (a i)
  have hmem := add_sum_nsmul_mem S (hclear _ ⟨ha, G.sub_mem hxgroup hsum⟩) v hv a
  have heq : (x - ∑ i, a i • v i + f) + ∑ i, a i • v i = x + f := by abel
  simpa only [heq] using hmem

/-- A full-lattice additive semigroup contains an actual translate of the lattice
points in every cone generated by finitely many of its elements. This is the
finite-generation Khovanskii conductor ingredient, rather than an assumed
interior eventual-membership certificate. -/
theorem exists_conductor {d m : ℕ} (S : AddSubsemigroup (Fin d → ℤ))
    (hne : (S : Set (Fin d → ℤ)).Nonempty)
    (hfull : AddSubgroup.closure (S : Set (Fin d → ℤ)) = ⊤)
    (v : Fin m → Fin d → ℤ) (hv : ∀ i, v i ∈ S) :
    ∃ f ∈ S, ∀ x : Fin d → ℤ, Counting.integerCast x ∈ generatedCone v → x + f ∈ S := by
  obtain ⟨f, hf, htranslate⟩ := exists_conductor_in_generated_group S hne v hv
  exact ⟨f, hf, fun x hx => htranslate x (by rw [hfull]; trivial) hx⟩

end SGPT.AlmostSemigroup.Conductor
