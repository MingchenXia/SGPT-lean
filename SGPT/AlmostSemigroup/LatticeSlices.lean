import SGPT.AlmostSemigroup.Conductor
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The actual degree group and horizontal slice lattice

Generated subgroups, their degree image and intrinsic horizontal cosets for
the general semigroup clauses of SGPT Appendix C `thm:KK12growth`.
-/

namespace SGPT.AlmostSemigroup.LatticeSlices

open Set
open Filter MeasureTheory
open scoped Pointwise Topology

noncomputable section

/-- The actual subgroup generated by the source additive semigroup. -/
def generatedGroup {n : ℕ} (S : AddSubsemigroup ((Fin n → ℤ) × ℤ)) :
    AddSubgroup ((Fin n → ℤ) × ℤ) := AddSubgroup.closure (S : Set _)

/-- The actual image of the degree-coordinate homomorphism. -/
def degreeGroup {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ)) : AddSubgroup ℤ :=
  G.map (AddMonoidHom.snd (Fin n → ℤ) ℤ)

/-- The actual horizontal subgroup in degree zero. -/
def horizontalGroup {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ)) :
    AddSubgroup (Fin n → ℤ) where
  carrier := {x | (x, 0) ∈ G}
  zero_mem' := G.zero_mem
  add_mem' hx hy := G.add_mem hx hy
  neg_mem' hx := G.neg_mem hx

@[simp] theorem mem_horizontalGroup {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) (x : Fin n → ℤ) :
    x ∈ horizontalGroup G ↔ (x, 0) ∈ G := Iff.rfl

theorem mem_degreeGroup_iff {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ)) (k : ℤ) :
    k ∈ degreeGroup G ↔ ∃ x : Fin n → ℤ, (x, k) ∈ G := by
  constructor
  · rintro ⟨⟨x, l⟩, hx, hl⟩
    change l = k at hl
    exact ⟨x, hl ▸ hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨(x, k), hx, rfl⟩

/-- Every actual integer degree subgroup has a nonnegative integral generator. -/
theorem exists_degree_generator {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ)) :
    ∃ a : ℕ, degreeGroup G = AddSubgroup.zmultiples (a : ℤ) := by
  obtain ⟨z, hz⟩ := (degreeGroup G).isAddCyclic_iff_exists_zmultiples_eq_top.mp
    (inferInstance : IsAddCyclic (degreeGroup G))
  exact ⟨z.natAbs, hz.symm.trans (Int.zmultiples_natAbs z).symm⟩

/-- A genuine positive degree rules out the zero generator. -/
theorem exists_positive_degree_generator {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    (hpos : ∃ x : Fin n → ℤ, ∃ k : ℤ, 0 < k ∧ (x, k) ∈ G) :
    ∃ a : ℕ, 0 < a ∧ degreeGroup G = AddSubgroup.zmultiples (a : ℤ) := by
  obtain ⟨a, ha⟩ := exists_degree_generator G
  refine ⟨a, ?_, ha⟩
  obtain ⟨x, k, hk, hx⟩ := hpos
  have hmem := (mem_degreeGroup_iff G k).mpr ⟨x, hx⟩
  by_contra h
  have ha0 : a = 0 := Nat.eq_zero_of_not_pos h
  rw [ha, ha0] at hmem
  have hk0 : k = 0 := by simpa using hmem
  omega

/-- The degree generator has an actual lift in the generated group. -/
theorem exists_degree_lift {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {a : ℕ} (ha : degreeGroup G = AddSubgroup.zmultiples (a : ℤ)) :
    ∃ β : Fin n → ℤ, (β, (a : ℤ)) ∈ G := by
  apply (mem_degreeGroup_iff G (a : ℤ)).mp
  rw [ha]
  exact AddSubgroup.mem_zmultiples _

/-- Every source semigroup degree lies in its actual degree subgroup. -/
theorem degree_mem_generated {n : ℕ} (S : AddSubsemigroup ((Fin n → ℤ) × ℤ))
    {x : Fin n → ℤ} {k : ℤ} (hx : (x, k) ∈ S) :
    k ∈ degreeGroup (generatedGroup S) :=
  (mem_degreeGroup_iff _ _).mpr ⟨x, AddSubgroup.subset_closure hx⟩

/-- Divisibility is derived from the actual generated group, not imposed on slices. -/
theorem degree_dvd_of_mem {n : ℕ} (S : AddSubsemigroup ((Fin n → ℤ) × ℤ))
    {a : ℕ} (ha : degreeGroup (generatedGroup S) = AddSubgroup.zmultiples (a : ℤ))
    {x : Fin n → ℤ} {k : ℤ} (hx : (x, k) ∈ S) : (a : ℤ) ∣ k := by
  have h := degree_mem_generated S hx
  rw [ha] at h
  exact Int.mem_zmultiples_iff.mp h

/-- Subtracting a genuine element of the degree slice identifies its horizontal coset. -/
theorem mem_group_slice_iff {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {γ x : Fin n → ℤ} {k : ℤ} (hγ : (γ, k) ∈ G) :
    (x, k) ∈ G ↔ x - γ ∈ horizontalGroup G := by
  constructor
  · intro hx
    have h := G.sub_mem hx hγ
    simpa using h
  · intro hx
    have h := G.add_mem hx hγ
    simpa using h

/-- The actual degree slice is the actual translate of the horizontal subgroup. -/
theorem group_slice_eq_translate {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {γ : Fin n → ℤ} {k : ℤ} (hγ : (γ, k) ∈ G) :
    {x | (x, k) ∈ G} = (fun y => y + γ) '' (horizontalGroup G : Set _) := by
  ext x
  constructor
  · intro hx
    exact ⟨x - γ, (mem_group_slice_iff G hγ).mp hx, sub_add_cancel x γ⟩
  · rintro ⟨y, hy, rfl⟩
    exact (mem_group_slice_iff G hγ).mpr (by simpa using hy)

/-- Off the actual degree group, the source group slice is empty. -/
theorem group_slice_eq_empty {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {k : ℤ} (hk : k ∉ degreeGroup G) : {x | (x, k) ∈ G} = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro x hx
  exact hk ((mem_degreeGroup_iff G k).mpr ⟨x, hx⟩)

/-- Every divisible degree has the coset determined by the single chosen degree lift. -/
theorem mem_group_slice_mul_iff {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {β x : Fin n → ℤ} {a : ℤ} (hβ : (β, a) ∈ G) (k : ℤ) :
    (x, k * a) ∈ G ↔ x - k • β ∈ horizontalGroup G := by
  have h := G.zsmul_mem hβ k
  have hka : (k • β, k * a) ∈ G := by simpa [zsmul_eq_mul] using h
  exact mem_group_slice_iff G hka

/-- Translation is a genuine equivalence on the integer slices. -/
def groupSliceEquiv {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {γ : Fin n → ℤ} {k : ℤ} (hγ : (γ, k) ∈ G) :
    ↥{x | (x, k) ∈ G} ≃ horizontalGroup G where
  toFun x := ⟨x.val - γ, (mem_group_slice_iff G hγ).mp x.property⟩
  invFun y := ⟨y.val + γ, (mem_group_slice_iff G hγ).mpr (by simp [y.property])⟩
  left_inv x := by apply Subtype.ext; exact sub_add_cancel x.val γ
  right_inv y := by apply Subtype.ext; exact add_sub_cancel_right y.val γ

/-- The real-coordinate image of the actual horizontal integer subgroup. -/
def horizontalLattice {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ)) :
    Submodule ℤ (Fin n → ℝ) :=
  (horizontalGroup G).toIntSubmodule.map (Conductor.integerCastHom n).toIntLinearMap

theorem mem_horizontalLattice_iff {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) (y : Fin n → ℝ) :
    y ∈ horizontalLattice G ↔
      ∃ x ∈ horizontalGroup G, Counting.integerCast x = y := Iff.rfl

/-- This lattice is genuinely a subset of the standard integer lattice. -/
theorem horizontalLattice_le_standard {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) :
    horizontalLattice G ≤ Counting.standardLattice n := by
  rintro y ⟨x, hx, rfl⟩
  exact Counting.integerCast_mem_standardLattice x

/-- Discreteness follows from the actual integer-coordinate embedding. -/
instance horizontalLattice_discrete {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) : DiscreteTopology (horizontalLattice G) := by
  have h : DiscreteTopology (Counting.standardLattice n) := by
    unfold Counting.standardLattice
    infer_instance
  exact DiscreteTopology.of_subset h (horizontalLattice_le_standard G)

/-- Integer horizontal points of a real body are the same actual real lattice points. -/
def horizontalPointsEquiv {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    (K : Set (Fin n → ℝ)) :
    ↥{x | x ∈ horizontalGroup G ∧ Counting.integerCast x ∈ K} ≃
      ↥(K ∩ horizontalLattice G) :=
  Equiv.ofBijective
    (fun x => ⟨Counting.integerCast x.val, x.property.2, x.val, x.property.1, rfl⟩) (by
      constructor
      · intro x y h
        apply Subtype.ext
        exact Counting.integerCast_injective (congrArg Subtype.val h)
      · rintro ⟨y, hy, x, hx, hxy⟩
        change Counting.integerCast x = y at hxy
        exact ⟨⟨x, hx, hxy.symm ▸ hy⟩, Subtype.ext hxy⟩)

/-- The actual group saturation of a body's degree slice. -/
def groupBodySlice {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    (K : Set (Fin n → ℝ)) (k : ℕ) : Set (Fin n → ℤ) :=
  {x | (x, (k : ℤ)) ∈ G ∧ Counting.integerCast x ∈ (k : ℝ) • K}

/-- Removing the degree lift translates the body by its actual normalized lift. -/
def centeredBody {n : ℕ} (K : Set (Fin n → ℝ)) (β : Fin n → ℤ) (a : ℕ) :
    Set (Fin n → ℝ) :=
  (fun y => y - (a : ℝ)⁻¹ • Counting.integerCast β) '' K

theorem centeredBody_compact {n : ℕ} {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (β : Fin n → ℤ) (a : ℕ) :
    IsCompact (centeredBody K β a) :=
  hK.image (continuous_id.sub continuous_const)

theorem centeredBody_convex {n : ℕ} {K : Set (Fin n → ℝ)}
    (hK : Convex ℝ K) (β : Fin n → ℤ) (a : ℕ) :
    Convex ℝ (centeredBody K β a) := by
  simpa only [centeredBody, sub_eq_add_neg, add_comm] using
    hK.translate (-((a : ℝ)⁻¹ • Counting.integerCast β))

/-- Translation preserves the actual Lebesgue-volume normalization. -/
theorem volume_centeredBody {n : ℕ} (K : Set (Fin n → ℝ))
    (β : Fin n → ℤ) (a : ℕ) :
    MeasureTheory.volume.real (centeredBody K β a) = MeasureTheory.volume.real K := by
  have heq : centeredBody K β a =
      (fun y => y + (a : ℝ)⁻¹ • Counting.integerCast β) ⁻¹' K := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      simpa using hx
    · intro hy
      exact ⟨y + (a : ℝ)⁻¹ • Counting.integerCast β, hy, by simp⟩
  rw [heq, Measure.real, Measure.real,
    measure_preimage_add_right MeasureTheory.volume]

/-- The dilated translated-body condition is the actual translated coordinate condition. -/
theorem mem_dilate_centeredBody_iff {n : ℕ} (K : Set (Fin n → ℝ))
    (β : Fin n → ℤ) (a : ℕ) (r : ℝ) (y : Fin n → ℝ) :
    y - r • ((a : ℝ)⁻¹ • Counting.integerCast β) ∈ r • centeredBody K β a ↔
      y ∈ r • K := by
  constructor
  · rintro ⟨z, ⟨w, hw, rfl⟩, hz⟩
    refine ⟨w, hw, ?_⟩
    have h := congrArg (fun z => z + r • ((a : ℝ)⁻¹ • Counting.integerCast β)) hz
    simpa only [smul_sub, sub_add_cancel] using h
  · rintro ⟨w, hw, rfl⟩
    exact ⟨w - (a : ℝ)⁻¹ • Counting.integerCast β, ⟨w, hw, rfl⟩, smul_sub _ _ _⟩

theorem integerCast_zsmul {n : ℕ} (β : Fin n → ℤ) (k : ℤ) :
    Counting.integerCast (k • β) = (k : ℝ) • Counting.integerCast β := by
  ext i
  simp [Counting.integerCast, smul_eq_mul]

theorem mul_degree_center_eq_zsmul {n : ℕ} (β : Fin n → ℤ)
    {a : ℕ} (ha : 0 < a) (k : ℕ) :
    ((k * a : ℕ) : ℝ) • ((a : ℝ)⁻¹ • Counting.integerCast β) =
      Counting.integerCast ((k : ℤ) • β) := by
  rw [integerCast_zsmul, smul_smul, Nat.cast_mul]
  congr 1
  have ha0 : (a : ℝ) ≠ 0 := by exact_mod_cast ha.ne'
  field_simp
  simp

theorem integerCast_sub {n : ℕ} (x y : Fin n → ℤ) :
    Counting.integerCast (x - y) = Counting.integerCast x - Counting.integerCast y :=
  (Conductor.integerCastHom n).map_sub x y

theorem integerCast_add {n : ℕ} (x y : Fin n → ℤ) :
    Counting.integerCast (x + y) = Counting.integerCast x + Counting.integerCast y :=
  (Conductor.integerCastHom n).map_add x y

/-- Subtracting the actual degree lift gives an actual integer-coordinate bijection. -/
def groupBodySliceIntegerEquiv {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    (K : Set (Fin n → ℝ)) {β : Fin n → ℤ} {a : ℕ}
    (hβ : (β, (a : ℤ)) ∈ G) (ha : 0 < a) (k : ℕ) :
    groupBodySlice G K (k * a) ≃
      ↥{x | x ∈ horizontalGroup G ∧
        Counting.integerCast x ∈ ((k * a : ℕ) : ℝ) • centeredBody K β a} where
  toFun x := ⟨x.val - (k : ℤ) • β, by
    constructor
    · apply (mem_group_slice_mul_iff G hβ (k : ℤ)).mp
      simpa [groupBodySlice, Nat.cast_mul] using x.property.1
    · have hx := x.property.2
      change Counting.integerCast (x.val - (k : ℤ) • β) ∈ _
      rw [integerCast_sub]
      rw [← mul_degree_center_eq_zsmul β ha k]
      exact (mem_dilate_centeredBody_iff K β a _ _).mpr hx⟩
  invFun y := ⟨y.val + (k : ℤ) • β, by
    constructor
    · have h := (mem_group_slice_mul_iff G hβ (k : ℤ)).mpr
        (by simpa using y.property.1 : y.val + (k : ℤ) • β - (k : ℤ) • β ∈ horizontalGroup G)
      simpa [Nat.cast_mul] using h
    · have hy := (mem_dilate_centeredBody_iff K β a
        ((k * a : ℕ) : ℝ) (Counting.integerCast (y.val + (k : ℤ) • β))).mp
        (by
          rw [integerCast_add,
            mul_degree_center_eq_zsmul β ha k, add_sub_cancel_right]
          exact y.property.2)
      exact hy⟩
  left_inv x := by apply Subtype.ext; exact sub_add_cancel x.val ((k : ℤ) • β)
  right_inv y := by apply Subtype.ext; exact add_sub_cancel_right y.val ((k : ℤ) • β)

/-- The source saturation count is exactly a count in the actual horizontal real lattice. -/
theorem card_groupBodySlice {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    (K : Set (Fin n → ℝ)) {β : Fin n → ℤ} {a : ℕ}
    (hβ : (β, (a : ℤ)) ∈ G) (ha : 0 < a) (k : ℕ) :
    Nat.card (groupBodySlice G K (k * a)) =
      Nat.card ↥((((k * a : ℕ) : ℝ) • centeredBody K β a) ∩ horizontalLattice G) :=
  Nat.card_congr ((groupBodySliceIntegerEquiv G K hβ ha k).trans
    (horizontalPointsEquiv G _))

/-- The actual full-horizontal-lattice saturation limit at the actual degree normalization. -/
theorem tendsto_groupBodySlice {n : ℕ} (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    [IsZLattice ℝ (horizontalLattice G)]
    {K : Set (Fin n → ℝ)} (hcompact : IsCompact K) (hconvex : Convex ℝ K)
    {β : Fin n → ℤ} {a : ℕ} (hβ : (β, (a : ℤ)) ∈ G) (ha : 0 < a) :
    Tendsto (fun k : ℕ => (((k * a : ℕ) : ℝ)⁻¹ ^ n) *
      (Nat.card (groupBodySlice G K (k * a)) : ℝ)) atTop
      (𝓝 (MeasureTheory.volume.real K / ZLattice.covolume (horizontalLattice G))) := by
  have h := Counting.tendsto_lattice_count (horizontalLattice G)
    (centeredBody_compact hcompact β a) (centeredBody_convex hconvex β a)
  rw [volume_centeredBody] at h
  have hmul : Tendsto (fun k : ℕ => k * a) atTop atTop :=
    tendsto_atTop_mono (fun k => Nat.le_mul_of_pos_right k ha) tendsto_id
  apply (h.comp hmul).congr
  intro k
  rw [card_groupBodySlice G K hβ ha k]
  rfl

/-- The actual generated-group saturation inside the original source cone. -/
def groupConeSubset {n : ℕ} (C : AdmissibleCone n)
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) : ConeSubset C :=
  ⟨{z | z ∈ latticePoints C.cone ∧ z ∈ G}, fun _ hz => hz.1⟩

/-- Positive-degree cone/group slices are the actual centered-body counts. -/
theorem card_groupConeSubset_slices {n : ℕ} (C : AdmissibleCone n)
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) (k : ℕ) (hk : 0 < k) :
    ((groupConeSubset C G).slices k).card =
      Nat.card (groupBodySlice G (heightOne C.cone) k) := by
  change ((groupConeSubset C G).finite_slice k).toFinset.card = _
  rw [← Nat.card_eq_card_finite_toFinset ((groupConeSubset C G).finite_slice k)]
  have hs : slice (groupConeSubset C G).val (k : ℤ) =
      groupBodySlice G (heightOne C.cone) k := by
    ext x
    exact and_comm.trans
      (and_congr Iff.rfl (Counting.mem_slice_iff_integerPoints_heightOne C.cone k hk x))
  rw [hs]

/-- Source cone slices in the actual generated group converge along the degree period. -/
theorem tendsto_groupConeSubset {n : ℕ} (C : AdmissibleCone n)
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) [IsZLattice ℝ (horizontalLattice G)]
    {β : Fin n → ℤ} {a : ℕ} (hβ : (β, (a : ℤ)) ∈ G) (ha : 0 < a) :
    Tendsto (fun k : ℕ => (groupConeSubset C G).normalizedCardinality (k * a))
      atTop (𝓝 (MeasureTheory.volume.real (heightOne C.cone) /
        ZLattice.covolume (horizontalLattice G))) := by
  have h := tendsto_groupBodySlice G
    (isCompact_heightOne C.cone C.closed C.nonnegativeHeight C.zeroHeight)
    (Counting.convex_heightOne C.cone) hβ ha
  apply h.congr'
  filter_upwards [eventually_gt_atTop 0] with k hk
  rw [ConeSubset.normalizedCardinality, card_groupConeSubset_slices C G (k * a)
    (Nat.mul_pos hk ha)]

/-- Full group generation gives the actual standard horizontal lattice. -/
theorem horizontalLattice_top {n : ℕ} :
    horizontalLattice (⊤ : AddSubgroup ((Fin n → ℤ) × ℤ)) = Counting.standardLattice n := by
  apply le_antisymm (horizontalLattice_le_standard _) ?_
  intro y hy
  obtain ⟨x, hx⟩ := (Counting.integerLatticeEquiv n).surjective ⟨y, hy⟩
  apply (mem_horizontalLattice_iff _ y).mpr
  exact ⟨x, AddSubgroup.mem_top _, congrArg Subtype.val hx⟩

/-- Full group generation supplies the horizontal full-span hypothesis automatically. -/
instance horizontalLattice_top_isZLattice {n : ℕ} :
    IsZLattice ℝ (horizontalLattice (⊤ : AddSubgroup ((Fin n → ℤ) × ℤ))) where
  span_top := by
    rw [horizontalLattice_top]
    exact ZSpan.span_top (Pi.basisFun ℝ (Fin n))

/-- A nonzero actual source cone point has strictly positive degree. -/
theorem positive_degree_of_nonzero {n : ℕ} (C : AdmissibleCone n)
    {x : Fin n → ℤ} {k : ℤ} (hx : (x, k) ∈ latticePoints C.cone)
    (hzero : (x, k) ≠ 0) : 0 < k := by
  have hnonneg : 0 ≤ k := by
    have h := C.nonnegativeHeight _ hx
    change 0 ≤ (k : ℝ) at h
    exact_mod_cast h
  have hk0 : k ≠ 0 := by
    intro hk
    subst k
    have hx0 : Counting.integerCast x = 0 := by
      apply C.zeroHeight
      have hcast : latticeCast n (x, 0) = (Counting.integerCast x, 0) := by
        apply Prod.ext
        · ext i; rfl
        · simp [latticeCast]
      change latticeCast n (x, 0) ∈ C.cone at hx
      rwa [hcast] at hx
    have hxz : x = 0 := Counting.integerCast_injective
      (by rw [hx0]; ext i; simp [Counting.integerCast])
    exact hzero (Prod.ext hxz rfl)
  exact lt_of_le_of_ne hnonneg (Ne.symm hk0)

/-- The period and its lift are produced from an actual nonzero semigroup element. -/
theorem exists_semigroup_degree_period {n : ℕ} (C : AdmissibleCone n)
    (S : AddSubsemigroup ((Fin n → ℤ) × ℤ)) (hS : S ≤ latticePoints C.cone)
    (hnonzero : ∃ z ∈ S, z ≠ 0) :
    ∃ a : ℕ, 0 < a ∧ degreeGroup (generatedGroup S) = AddSubgroup.zmultiples (a : ℤ) ∧
      ∃ β : Fin n → ℤ, (β, (a : ℤ)) ∈ generatedGroup S := by
  obtain ⟨⟨x, k⟩, hx, hzero⟩ := hnonzero
  obtain ⟨a, ha, hdegree⟩ := exists_positive_degree_generator (generatedGroup S)
    ⟨x, k, positive_degree_of_nonzero C (hS hx) hzero, AddSubgroup.subset_closure hx⟩
  exact ⟨a, ha, hdegree, exists_degree_lift _ hdegree⟩

/-- Actual horizontal lattice intersections are bounded by actual standard integer counts. -/
theorem card_horizontal_le_integerPoints {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ)) {K : Set (Fin n → ℝ)}
    (hK : Bornology.IsBounded K) :
    Nat.card ↥(K ∩ horizontalLattice G) ≤ Nat.card (Counting.integerPoints K) := by
  have hf : (K ∩ Counting.standardLattice n : Set (Fin n → ℝ)).Finite :=
    ZSpan.setFinite_inter (Pi.basisFun ℝ (Fin n)) hK
  let := hf.to_subtype
  rw [Counting.card_integerPoints]
  exact Nat.card_le_card_of_injective
    (Set.inclusion (Set.inter_subset_inter_right K (horizontalLattice_le_standard G)))
    (Set.inclusion_injective _)

/-- A proper linear support gives an actual zero limit, including every lower-rank lattice. -/
theorem tendsto_groupBodySlice_of_lower_rank {n : ℕ}
    (G : AddSubgroup ((Fin n → ℤ) × ℤ))
    {K : Set (Fin n → ℝ)} (hcompact : IsCompact K) (hconvex : Convex ℝ K)
    {β : Fin n → ℤ} {a : ℕ} (hβ : (β, (a : ℤ)) ∈ G) (ha : 0 < a)
    (V : Submodule ℝ (Fin n → ℝ)) (hV : V ≠ ⊤)
    (hsupport : centeredBody K β a ⊆ V) :
    Tendsto (fun k : ℕ => (((k * a : ℕ) : ℝ)⁻¹ ^ n) *
      (Nat.card (groupBodySlice G K (k * a)) : ℝ)) atTop (𝓝 0) := by
  have hvolume : MeasureTheory.volume (centeredBody K β a) = 0 :=
    measure_mono_null hsupport (Measure.addHaar_submodule MeasureTheory.volume V hV)
  have h := Counting.tendsto_integer_lattice_count
    (centeredBody_compact hcompact β a) (centeredBody_convex hconvex β a)
  have hreal : MeasureTheory.volume.real (centeredBody K β a) = 0 := by
    rw [Measure.real, hvolume, ENNReal.toReal_zero]
  rw [hreal] at h
  have hmul : Tendsto (fun k : ℕ => k * a) atTop atTop :=
    tendsto_atTop_mono (fun k => Nat.le_mul_of_pos_right k ha) tendsto_id
  apply squeeze_zero (fun k => mul_nonneg (pow_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _)) _)
    (Nat.cast_nonneg _)) ?_ (h.comp hmul)
  intro k
  change (((k * a : ℕ) : ℝ)⁻¹ ^ n) * (Nat.card (groupBodySlice G K (k * a)) : ℝ) ≤
    (((k * a : ℕ) : ℝ)⁻¹ ^ n) *
      (Nat.card (Counting.integerPoints (((k * a : ℕ) : ℝ) • centeredBody K β a)) : ℝ)
  rw [card_groupBodySlice G K hβ ha k]
  apply mul_le_mul_of_nonneg_left _ (pow_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _)) _)
  exact Nat.cast_le.mpr (card_horizontal_le_integerPoints G
    (K := ((k * a : ℕ) : ℝ) • centeredBody K β a)
    ((centeredBody_compact hcompact β a).image
      (continuous_id.const_smul ((k * a : ℕ) : ℝ))).isBounded)

end

end SGPT.AlmostSemigroup.LatticeSlices
