import SGPT.TestCurve.TCLinVandermonde
import SGPT.TestCurve.FGRelPolarized

/-!
# The `𝔾_m`-action on `R(X, L)[t, t⁻¹]` and weight components of coordinates

The Laurent section ring `R(X, L)[t, t⁻¹]` (the `LaurentSecRing`) carries
the `𝔾_m`-action `c · t^p s = c^p t^p s` (`twist`), by `ℂ`-algebra automorphisms. Let
`x_i = t^{-w_i} y_i` be bihomogeneous elements and `ℂ[t, x] = polAlg a w y` the subalgebra they
generate with `t`; it is stable under the action. The key algebraic step towards the chart
condition of a linearized test configuration is:

*if `X_G = Σ_{i ∈ G} x_i` with distinct weights `w_i` (`i ∈ G`) satisfies `X_G^D z ∈ ℂ[t, x]`
for a `t`-homogeneous `z`, then every component satisfies `x_i^E z ∈ ℂ[t, x]` for some `E`*
(`exists_pow_mul_mem_of_sum`).

Proof: applying the action gives `(c · X_G)^D z ∈ ℂ[t, x]` for every `c ∈ ℂ^*`; each component
`x_i` is a linear combination of finitely many `c · X_G` (`TCLin.eq_sum_zpow_smul`), hence a
power of `x_i` lies in the ideal of `ℂ[t, x]` generated by the `(c · X_G)^D`
(`Ideal.sum_pow_mem_span_pow`).

`exists_uniform_pow_mul_mem` collects this for a family of groups covering all coordinates.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.TCLin

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle
open SGPT.TestCurve.TestConfig SGPT.TestCurve.TestConfig.LaurentSecRing SGPT.TestCurve.FGRel

/-! ### Powers of sums in a subalgebra -/

/-- If `g_i ∈ A` and `g_i^{n+1} z ∈ A` for all `i ∈ s`, then `(Σ_i g_i)^{|s| n + 1} z ∈ A`. -/
theorem sum_pow_mul_mem {R : Type*} [CommRing R] [Algebra ℂ R] (A : Subalgebra ℂ R) (z : R)
    {ι : Type*} (s : Finset ι) (g : ι → R) (hg : ∀ i ∈ s, g i ∈ A) (n : ℕ)
    (hgz : ∀ i ∈ s, g i ^ (n + 1) * z ∈ A) :
    (∑ i ∈ s, g i) ^ (s.card * n + 1) * z ∈ A := by
  classical
  let I : Ideal A :=
    { carrier := {u | (u : R) * z ∈ A}
      add_mem' := by
        intro u v hu hv
        change ((u : R) + v) * z ∈ A
        rw [add_mul]
        exact add_mem hu hv
      zero_mem' := by
        change (0 : R) * z ∈ A
        rw [zero_mul]
        exact zero_mem _
      smul_mem' := by
        intro c u hu
        change ((c : R) * u) * z ∈ A
        rw [mul_assoc]
        exact mul_mem c.2 hu }
  let g' : s → A := fun i => ⟨g i, hg i i.2⟩
  have hmem := Ideal.sum_pow_mem_span_pow (Finset.univ : Finset s) g' n
  have hle : Ideal.span ((fun i => g' i ^ (n + 1)) '' (Finset.univ : Finset s)) ≤ I := by
    rw [Ideal.span_le]
    rintro _ ⟨i, -, rfl⟩
    change ((g' i ^ (n + 1) : A) : R) * z ∈ A
    rw [SubmonoidClass.coe_pow]
    exact hgz i i.2
  have h := hle hmem
  change (((∑ i : s, g' i) ^ ((Finset.univ : Finset s).card * n + 1) : A) : R) * z ∈ A at h
  rw [SubmonoidClass.coe_pow, AddSubmonoidClass.coe_finsetSum, Finset.card_univ,
    Fintype.card_coe] at h
  rwa [Finset.sum_coe_sort s g] at h

variable {X : Scheme} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules} {a : LineBundleAtlas L}

/-! ### The `𝔾_m`-action on `R(X, L)[t, t⁻¹]` -/

variable (f a) in
/-- The character `t^p ↦ c^p t^p`. -/
def twistChar (c : ℂˣ) : Multiplicative ℤ →* LaurentSecRing f a where
  toFun p := AddMonoidAlgebra.single (Multiplicative.toAdd p)
    (algebraMap ℂ (SecRing f a) ((c ^ Multiplicative.toAdd p : ℂˣ) : ℂ))
  map_one' := by
    simp only [toAdd_one, zpow_zero, Units.val_one, map_one]
    rfl
  map_mul' p q := by
    rw [AddMonoidAlgebra.single_mul_single, ← map_mul, ← Units.val_mul, ← zpow_add, toAdd_mul]

variable (f a) in
/-- **The `𝔾_m`-action** `c · t^p s = c^p t^p s` on `R(X, L)[t, t⁻¹]`. -/
def twist (c : ℂˣ) : LaurentSecRing f a →ₐ[SecRing f a] LaurentSecRing f a :=
  AddMonoidAlgebra.lift (SecRing f a) (LaurentSecRing f a) ℤ (twistChar f a c)

theorem twist_single (c : ℂˣ) (p : ℤ) (b : SecRing f a) :
    twist f a c (AddMonoidAlgebra.single p b) = ((c ^ p : ℂˣ) : ℂ) • AddMonoidAlgebra.single p b := by
  rw [twist, AddMonoidAlgebra.lift_single]
  change b • AddMonoidAlgebra.single p (algebraMap ℂ (SecRing f a) ((c ^ p : ℂˣ) : ℂ)) = _
  rw [AddMonoidAlgebra.smul_single', AddMonoidAlgebra.smul_single, Algebra.smul_def, mul_comm]

theorem twist_mono (c : ℂˣ) (p : ℤ) (m : ℕ) (s : SectionSpace f L m) :
    twist f a c (mono p m s) = ((c ^ p : ℂˣ) : ℂ) • mono p m s :=
  twist_single c p _

theorem twist_smul (c : ℂˣ) (c' : ℂ) (u : LaurentSecRing f a) :
    twist f a c (c' • u) = c' • twist f a c u := by
  rw [← algebraMap_smul (SecRing f a) c' u, map_smul, algebraMap_smul]

theorem twist_tElt (c : ℂˣ) : twist f a c (tElt f a) = (c : ℂ) • tElt f a := by
  rw [tElt, twist_mono, zpow_one]

variable {N r : ℕ} (w : Fin (N + 1) → ℤ) (y : Fin (N + 1) → SectionSpace f L r)

theorem twist_coordElt (c : ℂˣ) (i : Fin (N + 1)) :
    twist f a c (coordElt a w y i) = ((c ^ (-(w i)) : ℂˣ) : ℂ) • coordElt a w y i :=
  twist_mono c _ r (y i)

/-- `ℂ[t, x]` is stable under the `𝔾_m`-action. -/
theorem twist_mem_polAlg (c : ℂˣ) {u : LaurentSecRing f a} (hu : u ∈ polAlg a w y) :
    twist f a c u ∈ polAlg a w y := by
  refine Algebra.adjoin_induction (p := fun u _ => twist f a c u ∈ polAlg a w y)
    ?_ ?_ ?_ ?_ hu
  · rintro u (rfl | ⟨i, rfl⟩)
    · rw [twist_tElt]
      exact Subalgebra.smul_mem _ (tElt_mem_polAlg a w y) _
    · rw [twist_coordElt]
      exact Subalgebra.smul_mem _ (coordElt_mem_polAlg a w y i) _
  · intro c'
    rw [Algebra.algebraMap_eq_smul_one c', twist_smul, map_one]
    exact Subalgebra.smul_mem _ (one_mem _) _
  · intro u v _ _ hu hv
    rw [map_add]
    exact add_mem hu hv
  · intro u v _ _ hu hv
    rw [map_mul]
    exact mul_mem hu hv

/-! ### Weight components of a sum of coordinates -/

/-- **Weight components.** Let `G` be a set of coordinates of distinct weights and `z` a
`t`-homogeneous element. If `(Σ_{i ∈ G} x_i)^D z ∈ ℂ[t, x]`, then for every `i₀ ∈ G` some
`x_{i₀}^E z ∈ ℂ[t, x]`. -/
theorem exists_pow_mul_mem_of_sum (G : Finset (Fin (N + 1))) (hG : Set.InjOn w G)
    (z : LaurentSecRing f a) (j : ℤ) (hz : ∀ c : ℂˣ, twist f a c z = ((c ^ j : ℂˣ) : ℂ) • z)
    (D : ℕ) (hD : (∑ i ∈ G, coordElt a w y i) ^ D * z ∈ polAlg a w y)
    {i₀ : Fin (N + 1)} (hi₀ : i₀ ∈ G) :
    ∃ E : ℕ, coordElt a w y i₀ ^ E * z ∈ polAlg a w y := by
  classical
  set XG := ∑ i ∈ G, coordElt a w y i with hXG
  -- the translates `c · X_G`
  have htw : ∀ c : ℂˣ, twist f a c XG = ∑ i ∈ G, ((c ^ (-(w i)) : ℂˣ) : ℂ) • coordElt a w y i :=
    fun c => by rw [hXG, map_sum]; exact Finset.sum_congr rfl fun i _ => twist_coordElt w y c i
  have hXGmem : XG ∈ polAlg a w y := Subalgebra.sum_mem _ fun i _ => coordElt_mem_polAlg a w y i
  have htwD : ∀ c : ℂˣ, twist f a c XG ^ (D + 1) * z ∈ polAlg a w y := by
    intro c
    have h1 := twist_mem_polAlg w y c hD
    rw [map_mul, map_pow, hz c, mul_smul_comm] at h1
    have h2 : twist f a c XG ^ D * z ∈ polAlg a w y := by
      have := Subalgebra.smul_mem _ h1 (((c ^ j : ℂˣ) : ℂ)⁻¹)
      rwa [smul_smul, inv_mul_cancel₀ (Units.ne_zero _), one_smul] at this
    rw [pow_succ', mul_assoc]
    exact mul_mem (twist_mem_polAlg w y c hXGmem) h2
  -- interpolation
  let S : Finset ℤ := G.image fun i => -(w i)
  let v : ℤ → LaurentSecRing f a := fun ν => ∑ i ∈ G with -(w i) = ν, coordElt a w y i
  obtain ⟨C, b, hb⟩ := eq_sum_zpow_smul S v (Finset.mem_image_of_mem _ hi₀)
  have hv₀ : v (-(w i₀)) = coordElt a w y i₀ := by
    have : G.filter (fun i => -(w i) = -(w i₀)) = {i₀} := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_singleton, neg_inj]
      constructor
      · rintro ⟨hi, hw⟩
        exact hG hi hi₀ hw
      · rintro rfl
        exact ⟨hi₀, rfl⟩
    simp only [v, this, Finset.sum_singleton]
  have hvtw : ∀ c : ℂˣ, ∑ ν ∈ S, ((c ^ ν : ℂˣ) : ℂ) • v ν = twist f a c XG := by
    intro c
    rw [htw c, ← Finset.sum_fiberwise_of_maps_to (g := fun i => -(w i)) (t := S)
      (fun i hi => Finset.mem_image_of_mem _ hi)]
    refine Finset.sum_congr rfl fun ν _ => ?_
    simp only [v, Finset.smul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [(Finset.mem_filter.mp hi).2]
  rw [hv₀] at hb
  simp_rw [hvtw] at hb
  refine ⟨C.card * D + 1, ?_⟩
  rw [hb]
  exact sum_pow_mul_mem (polAlg a w y) z C (fun c => b c • twist f a c XG)
    (fun c _ => Subalgebra.smul_mem _ (twist_mem_polAlg w y c hXGmem) _) D
    (fun c _ => by
      rw [smul_pow, smul_mul_assoc]
      exact Subalgebra.smul_mem _ (htwD c) _)

/-- **Uniform version.** Let the coordinates be grouped into groups `G l` of distinct weights
covering all coordinates. If for every group some `(Σ_{i ∈ G l} x_i)^D z ∈ ℂ[t, x]`, then there
is `E` with `x_i^E z ∈ ℂ[t, x]` for every coordinate `i`. -/
theorem exists_uniform_pow_mul_mem {Λ : Type*} (G : Λ → Finset (Fin (N + 1)))
    (hG : ∀ l, Set.InjOn w (G l)) (hcov : ∀ i, ∃ l, i ∈ G l)
    (z : LaurentSecRing f a) (j : ℤ) (hz : ∀ c : ℂˣ, twist f a c z = ((c ^ j : ℂˣ) : ℂ) • z)
    (hD : ∀ l, ∃ D : ℕ, (∑ i ∈ G l, coordElt a w y i) ^ D * z ∈ polAlg a w y) :
    ∃ E : ℕ, ∀ i, coordElt a w y i ^ E * z ∈ polAlg a w y := by
  classical
  have hE : ∀ i, ∃ E : ℕ, coordElt a w y i ^ E * z ∈ polAlg a w y := by
    intro i
    obtain ⟨l, hl⟩ := hcov i
    obtain ⟨D, hD⟩ := hD l
    exact exists_pow_mul_mem_of_sum w y (G l) (hG l) z j hz D hD hl
  choose E hE using hE
  refine ⟨∑ i, E i, fun i => ?_⟩
  have hle : E i ≤ ∑ i, E i := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
  rw [show ∑ i, E i = (∑ i, E i - E i) + E i by omega, pow_add, mul_assoc]
  exact mul_mem (pow_mem (coordElt_mem_polAlg a w y i) _) (hE i)

end SGPT.TestCurve.TCLin
