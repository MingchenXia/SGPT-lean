import SGPT.TestCurve.FGRelLaurent
import SGPT.TestCurve.FGRelSerre

/-!
# The polarized subalgebra `ℂ[t, x₀, …, x_N]` of a Rees algebra

([BHJ17, Prop. 2.15], finite generation of the filtration of an ample test
configuration). Let `𝓕` be a `ℤ`-filtration of `R(X, L)` and let `x_i = t^{-w_i} y_i`
(`y_i ∈ 𝓕^{w_i} H⁰(X, L^r)`) be bihomogeneous elements of its Rees algebra: for the filtration of
a test configuration `(𝓧, 𝓛)` with an equivariant embedding `𝓧 ↪ ℙᴺ × 𝔸¹` by `𝓛^r`, these are
the coordinate sections. This file studies the subalgebra `ℂ[t, x₀, …, x_N]` generated by `t`
and the `x_i` (`polAlg`).

## Main results

* `bproj_mem_polAlg`: `polAlg` is bigraded.
* `exists_aeval_add_tElt_mul`: every element of `polAlg` is `P(x) + t · u` with `u ∈ polAlg`.
* `exists_bproj_aeval`: the bihomogeneous components of `P(x)` in degree `r k` are `P'(x)` with
  `P'` homogeneous of degree `k`.
* `relIdeal`, `relIdeal_isHomogeneous`: the homogeneous ideal of relations
  `{P : P(x) ∈ t · polAlg}` (generated by its homogeneous elements), i.e. the ideal of the
  central fibre `𝓧₀ ⊆ ℙᴺ`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.FGRel

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle
open SGPT.TestCurve.TestConfig SGPT.TestCurve.TestConfig.LaurentSecRing

variable {X : Scheme} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules} (a : LineBundleAtlas L)
variable {N r : ℕ} (w : Fin (N + 1) → ℤ) (y : Fin (N + 1) → SectionSpace f L r)

/-- The coordinate elements `x_i = t^{-w_i} y_i`. -/
def coordElt (i : Fin (N + 1)) : LaurentSecRing f a := mono (-(w i)) r (y i)

/-- The polarized subalgebra `ℂ[t, x₀, …, x_N] ⊆ R(X, L)[t, t⁻¹]`. -/
def polAlg : Subalgebra ℂ (LaurentSecRing f a) :=
  Algebra.adjoin ℂ (insert (tElt f a) (Set.range (coordElt a w y)))

/-- Evaluation `P ↦ P(x₀, …, x_N)`. -/
def coordEval : MvPolynomial (Fin (N + 1)) ℂ →ₐ[ℂ] LaurentSecRing f a :=
  MvPolynomial.aeval (coordElt a w y)

theorem tElt_mem_polAlg : tElt f a ∈ polAlg a w y :=
  Algebra.subset_adjoin (Set.mem_insert _ _)

theorem coordElt_mem_polAlg (i : Fin (N + 1)) : coordElt a w y i ∈ polAlg a w y :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

theorem coordEval_mem_polAlg (p : MvPolynomial (Fin (N + 1)) ℂ) :
    coordEval a w y p ∈ polAlg a w y := by
  induction p using MvPolynomial.induction_on with
  | C c =>
    rw [coordEval, MvPolynomial.aeval_C]
    exact (polAlg a w y).algebraMap_mem c
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, coordEval, MvPolynomial.aeval_X]
    exact mul_mem hp (coordElt_mem_polAlg a w y i)

/-! ### Bihomogeneity -/

/-- Every element of the monoid generated by `t` and the `x_i` is bihomogeneous. -/
theorem exists_mono_of_mem_closure {z : LaurentSecRing f a}
    (hz : z ∈ Submonoid.closure (insert (tElt f a) (Set.range (coordElt a w y)))) :
    ∃ (j : ℤ) (m : ℕ) (s : SectionSpace f L m), z = mono j m s := by
  refine Submonoid.closure_induction (motive := fun z _ => ∃ (j : ℤ) (m : ℕ)
    (s : SectionSpace f L m), z = mono j m s) ?_ ?_ ?_ hz
  · rintro z (rfl | ⟨i, rfl⟩)
    · exact ⟨1, 0, secOne f L, rfl⟩
    · exact ⟨_, _, _, rfl⟩
  · exact ⟨0, 0, secOne f L, rfl⟩
  · rintro z z' - - ⟨j, m, s, rfl⟩ ⟨j', m', s', rfl⟩
    exact ⟨_, _, _, mono_mul_mono j j' m m' s s'⟩

/-- `polAlg` is spanned by bihomogeneous elements, hence stable under the projections onto
bihomogeneous components. -/
theorem bproj_mem_polAlg (j : ℤ) (m : ℕ) {u : LaurentSecRing f a} (hu : u ∈ polAlg a w y) :
    bproj f a j m u ∈ polAlg a w y := by
  have hu' : u ∈ Subalgebra.toSubmodule (polAlg a w y) := hu
  rw [polAlg, Algebra.adjoin_eq_span] at hu'
  refine Submodule.span_induction (p := fun u _ => bproj f a j m u ∈ polAlg a w y) ?_ ?_ ?_ ?_ hu'
  · intro z hz
    obtain ⟨j', m', s, rfl⟩ := exists_mono_of_mem_closure a w y hz
    rcases bproj_mono (f := f) (a := a) j m s with h | h
    · rw [h]
      exact (Submonoid.closure_le (S := (polAlg a w y).toSubmonoid)).mpr Algebra.subset_adjoin hz
    · rw [h]; exact zero_mem _
  · rw [map_zero]; exact zero_mem _
  · intro u v _ _ hu hv; rw [map_add]; exact add_mem hu hv
  · intro c u _ hu; rw [map_smul]; exact Subalgebra.smul_mem _ hu c

/-- Every element of `polAlg` is `P(x) + t · u` with `u ∈ polAlg` (reduction modulo `t`). -/
theorem exists_coordEval_add_tElt_mul {u : LaurentSecRing f a} (hu : u ∈ polAlg a w y) :
    ∃ (p : MvPolynomial (Fin (N + 1)) ℂ) (v : LaurentSecRing f a), v ∈ polAlg a w y ∧
      u = coordEval a w y p + tElt f a * v := by
  refine Algebra.adjoin_induction (hx := hu) (p := fun u _ => ∃ (p : MvPolynomial (Fin (N + 1)) ℂ)
    (v : LaurentSecRing f a), v ∈ polAlg a w y ∧ u = coordEval a w y p + tElt f a * v)
    ?_ ?_ ?_ ?_
  · rintro z (rfl | ⟨i, rfl⟩)
    · exact ⟨0, 1, one_mem _, by rw [map_zero, zero_add, mul_one]⟩
    · exact ⟨MvPolynomial.X i, 0, zero_mem _, by
        rw [mul_zero, add_zero, coordEval, MvPolynomial.aeval_X]⟩
  · intro c
    exact ⟨MvPolynomial.C c, 0, zero_mem _, by
      rw [mul_zero, add_zero, coordEval, MvPolynomial.aeval_C]⟩
  · rintro u v - - ⟨p, u', hu', rfl⟩ ⟨q, v', hv', rfl⟩
    exact ⟨p + q, u' + v', add_mem hu' hv', by rw [map_add, mul_add]; ring⟩
  · rintro u v - - ⟨p, u', hu', rfl⟩ ⟨q, v', hv', rfl⟩
    refine ⟨p * q, u' * coordEval a w y q + coordEval a w y p * v' + tElt f a * u' * v',
      add_mem (add_mem (mul_mem hu' (coordEval_mem_polAlg a w y q))
        (mul_mem (coordEval_mem_polAlg a w y p) hv'))
        (mul_mem (mul_mem (tElt_mem_polAlg a w y) hu') hv'), ?_⟩
    rw [map_mul]
    ring

/-- Powers of a bihomogeneous element are bihomogeneous. -/
theorem exists_mono_pow (j : ℤ) (m : ℕ) (s : SectionSpace f L m) (e : ℕ) :
    ∃ (j' : ℤ) (s' : SectionSpace f L (m * e)), (mono j m s : LaurentSecRing f a) ^ e =
      mono j' (m * e) s' := by
  induction e with
  | zero => exact ⟨0, secOne f L, by rw [pow_zero]; rfl⟩
  | succ e ih =>
    obtain ⟨j', s', h⟩ := ih
    exact ⟨j' + j, SectionSpace.mul f a (m * e) m s' s, by rw [pow_succ, h, mono_mul_mono]; rfl⟩

/-- The sum of the exponents of a monomial. -/
def expSum (β : Fin (N + 1) →₀ ℕ) : ℕ := β.sum fun _ e => e

/-- The value of a monomial at the coordinates is bihomogeneous of degree `r · |β|`. -/
theorem exists_coordEval_monomial (β : Fin (N + 1) →₀ ℕ) :
    ∃ (j : ℤ) (m : ℕ) (s : SectionSpace f L m), m = r * expSum β ∧
      coordEval a w y (MvPolynomial.monomial β 1) = mono j m s := by
  induction β using Finsupp.induction with
  | zero => exact ⟨0, 0, secOne f L, by simp [expSum], by
      rw [coordEval, MvPolynomial.aeval_monomial, Finsupp.prod_zero_index, map_one, mul_one]
      rfl⟩
  | single_add i e β hi he ih =>
    obtain ⟨j, m, s, hm, hβ⟩ := ih
    obtain ⟨j', s', hpow⟩ := exists_mono_pow (a := a) (-(w i)) r (y i) e
    refine ⟨j' + j, r * e + m, SectionSpace.mul f a (r * e) m s' s, ?_, ?_⟩
    · rw [hm, expSum, expSum, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl, mul_add]
    · rw [← mul_one (1 : ℂ), ← MvPolynomial.monomial_mul, map_mul, hβ, coordEval,
        MvPolynomial.aeval_monomial, map_one, one_mul,
        Finsupp.prod_single_index (by rw [pow_zero])]
      change coordElt a w y i ^ e * _ = _
      rw [coordElt, hpow, mono_mul_mono]

/-- The weighted degree of a monomial for the unit weights. -/
theorem weight_one_eq_expSum (β : Fin (N + 1) →₀ ℕ) :
    Finsupp.weight (fun _ : Fin (N + 1) => (1 : ℤ)) β = (expSum β : ℤ) := by
  rw [Finsupp.weight_apply, expSum, Finsupp.sum, Finsupp.sum, Nat.cast_sum]
  simp

theorem monomial_mem_grading (β : Fin (N + 1) →₀ ℕ) (c : ℂ) :
    MvPolynomial.monomial β c ∈
      polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1)) (expSum β : ℤ) :=
  MvPolynomial.isWeightedHomogeneous_monomial _ β c (weight_one_eq_expSum β)

/-- The bihomogeneous components of `P(x)` of degree `r k` are values of homogeneous
polynomials of degree `k`. -/
theorem exists_bproj_coordEval (hr : 0 < r) (p : MvPolynomial (Fin (N + 1)) ℂ) (j : ℤ) (k : ℕ) :
    ∃ q ∈ polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1)) (k : ℤ),
      bproj f a j (r * k) (coordEval a w y p) = coordEval a w y q := by
  induction p using MvPolynomial.induction_on' with
  | monomial β c =>
    obtain ⟨j', m, s, hm, hβ⟩ := exists_coordEval_monomial a w y β
    have hc : MvPolynomial.monomial β c = c • MvPolynomial.monomial β 1 := by
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [hc, map_smul, map_smul, hβ]
    by_cases hjm : j' = j ∧ m = r * k
    · obtain ⟨rfl, hmk⟩ := hjm
      have hk : expSum β = k := Nat.eq_of_mul_eq_mul_left hr (hm.symm.trans hmk)
      subst hmk
      refine ⟨c • MvPolynomial.monomial β 1, ?_, ?_⟩
      · rw [← hk]; exact Submodule.smul_mem _ c (monomial_mem_grading β 1)
      · rw [bproj_mono_same, map_smul, hβ]
    · exact ⟨0, zero_mem _, by rw [bproj_mono_of_ne hjm, smul_zero, map_zero]⟩
  | add p q hp hq =>
    obtain ⟨p', hp', ep⟩ := hp
    obtain ⟨q', hq', eq⟩ := hq
    exact ⟨p' + q', add_mem hp' hq', by rw [map_add, map_add, ep, eq, map_add]⟩

end SGPT.TestCurve.FGRel
