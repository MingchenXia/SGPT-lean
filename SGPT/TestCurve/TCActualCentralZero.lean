import SGPT.TestCurve.TCUnitZeroUniversal
import SGPT.TestCurve.TCLinChartRing

/-! The actual original central fibre is the entire coordinate zero subscheme.
Blueprint: tc-actual-central-zero.tex. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
namespace SGPT.TestCurve.CentralFiber
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry SGPT.Foundations.Schemes Opposite
open SGPT.LineBundle SGPT.TestCurve.TCEnc SGPT.TestCurve.TCLin

/-- Vanishing of the actual affine coordinate gives the original zero-point factorization. -/
theorem toLine_eq_zeroPoint_of_coordinate_zero {Y : Scheme.{0}} (π : Y ⟶ AffineLine)
    (h : π.appTop coordT = 0) :
    π = (π ≫ affineLineToBase) ≫ linePoint 0 := by
  apply AlgebraicGeometry.ext_of_isAffine
  apply CommRingCat.hom_ext
  ext y
  apply RingHom.eqOn_set_closure (f := π.appTop.hom)
    (g := ((π ≫ affineLineToBase) ≫ linePoint 0).appTop.hom) _ (mem_closure_affineLine y)
  intro x hx
  rcases hx with ⟨c,rfl⟩ | hx
  · have he : ((π ≫ affineLineToBase) ≫ linePoint 0) ≫ affineLineToBase =
        π ≫ affineLineToBase := by
      rw [Category.assoc,linePoint_comp_toBase,Category.comp_id]
    have hc := congrArg (fun q => q.appTop c) he
    exact hc.symm
  · obtain rfl := Set.mem_singleton_iff.mp hx
    change π.appTop coordT = (π ≫ affineLineToBase).appTop ((linePoint 0).appTop coordT)
    rw [h,linePoint_appTop_coordT]
    simp only [map_zero]

variable {X : Scheme.{0}} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules}
  {a : LineBundleAtlas L} (T : TestConfiguration f a)

abbrev centralUnitZero : Scheme.{0} := unitZeroScheme T.space (tFun T.toLine)

def centralUnitZeroToFiber : centralUnitZero T ⟶ centralFiberScheme T :=
  pullback.lift (unitZeroInclusion T.space (tFun T.toLine))
    (unitZeroInclusion T.space (tFun T.toLine) ≫ T.structureMap)
    (toLine_eq_zeroPoint_of_coordinate_zero
      (unitZeroInclusion T.space (tFun T.toLine) ≫ T.toLine)
      (unitZero_coordinate_zero T.space (tFun T.toLine)))

def centralFiberToUnitZero : centralFiberScheme T ⟶ centralUnitZero T :=
  unitZeroLift T.space (tFun T.toLine) (centralFiberInclusion T)
    (centralFiber_coordinate_zero T)

theorem centralUnitZeroToFiber_inclusion :
    centralUnitZeroToFiber T ≫ centralFiberInclusion T =
      unitZeroInclusion T.space (tFun T.toLine) := pullback.lift_fst _ _ _

theorem centralFiberToUnitZero_inclusion :
    centralFiberToUnitZero T ≫ unitZeroInclusion T.space (tFun T.toLine) =
      centralFiberInclusion T := unitZeroLift_fac _ _ _ _

/-- Genuine scheme isomorphism; the nilpotents of the original central fibre are retained. -/
def centralFiberUnitZeroIso : centralFiberScheme T ≅ centralUnitZero T where
  hom := centralFiberToUnitZero T
  inv := centralUnitZeroToFiber T
  hom_inv_id := by
    apply (cancel_mono (centralFiberInclusion T)).mp
    simp only [Category.assoc,centralUnitZeroToFiber_inclusion,
      centralFiberToUnitZero_inclusion,Category.id_comp]
  inv_hom_id := by
    apply (cancel_mono (unitZeroInclusion T.space (tFun T.toLine))).mp
    simp only [Category.assoc,centralFiberToUnitZero_inclusion,
      centralUnitZeroToFiber_inclusion,Category.id_comp]

/-- The actual central immersion has the actual principal coordinate ideal sheaf. -/
theorem centralFiberInclusion_ker :
    (centralFiberInclusion T).ker =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span {tFun T.toLine}) := by
  rw [← centralFiberToUnitZero_inclusion T]
  have : IsIso (centralFiberToUnitZero T) :=
    inferInstanceAs (IsIso (centralFiberUnitZeroIso T).hom)
  rw [Scheme.Hom.ker_comp_of_isIso]
  exact (Scheme.IdealSheafData.ker_subschemeι _).trans
    (unitZeroIdeal_eq T.space (tFun T.toLine))

/-- The true affine central restriction kernel is generated by the SAME restricted t. -/
theorem centralFiberInclusion_affine_kernel (U : T.space.affineOpens) :
    RingHom.ker ((centralFiberInclusion T).app U.val).hom =
      Ideal.span {T.space.presheaf.map U.val.leTop.op (tFun T.toLine)} := by
  rw [← Scheme.Hom.ker_apply,centralFiberInclusion_ker]
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal,Ideal.map_span,Set.image_singleton]
  rfl

end SGPT.TestCurve.CentralFiber
