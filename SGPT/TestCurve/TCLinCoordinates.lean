import SGPT.TestCurve.TCLinGraph
import SGPT.TestCurve.TCLinTwist

/-!
# Diagonalizing the embedding of a linearized test configuration

([BHJ17, Prop. 2.15], first half, for test configurations with a `𝔾_m`-linearized
line bundle). Let `(𝓧, 𝓛)` be a test configuration of `(X, L)` with a `𝔾_m`-linearization of `𝓛`
(`SectionLinearization`), and let `s_0, …, s_N ∈ H⁰(𝓧, 𝓛^r)` be sections

* without common zeros (`NoCommonZero`), and
* satisfying the chart condition of the embedding they define (`ChartCondition`): for every
  `σ ∈ H⁰(𝓧, 𝓛^{rk})` and every `i`, some `s_i^D σ` is a linear combination of the monomials
  `t^a s^β`, `|β| = D + k` (the coordinate ring of the chart `{s_i ≠ 0}` is generated by `t` and
  the `s_l / s_i`, as for a closed embedding `𝓧 ↪ ℙᴺ × 𝔸¹`).

The `s_i` need not be weight vectors. The linearization decomposes each `s_l = Σ_μ ξ_{l,μ}` into
weight vectors; the weight components `ξ_{l,μ}` are the coordinates of the "diagonalized"
equivariant embedding. We show that the coordinates `x_{l,μ} = t^{-μ} y_{l,μ}` of the Rees
algebra (`ξ_{l,μ}` extends `t^{-μ} q^* y_{l,μ}`) satisfy the chart condition `H1` and the
saturation condition `H2` of the criterion, so that **the induced filtration is
finitely generated** (`filtrationFinitelyGenerated_of_chartCondition`).

The chart condition for the weight components is obtained from that of the `s_l` in the Laurent
section ring `R(X, L)[t, t⁻¹]`: the Laurent expansion of `s_l^D σ = P(t, s)` gives
`X_l^D t^j s = P(t, X)` with `X_l = Σ_μ x_{l,μ}` (`graph_unique`), and the `𝔾_m`-action on
`R(X, L)[t, t⁻¹]` separates the components (`exists_uniform_pow_mul_mem`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.TCLin

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle Opposite
open SGPT.TestCurve.TestConfig SGPT.TestCurve.TestConfig.LaurentSecRing SGPT.TestCurve.TCEnc
open SGPT.TestCurve.FGRel

variable {X : Scheme.{0}} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules} {a : LineBundleAtlas L}

section Defs

variable (T : TestConfiguration f a) {N r : ℕ} (s : Fin (N + 1) → SectionSpace T.structureMap T.line r)

/-- The monomials `t^a s^β` of degree `|β| = n` in the section ring of `𝓛`. -/
def degreeMonomials (n : ℕ) : Set (SecRing T.structureMap T.extAtlas) :=
  {z | ∃ (a' : ℕ) (β : Fin (N + 1) →₀ ℕ), expSum β = n ∧ z = secMonomialξ T s a' β}

/-- **The chart condition of the embedding by `s_0, …, s_N ∈ H⁰(𝓧, 𝓛^r)`**: for every
`σ ∈ H⁰(𝓧, 𝓛^{rk})` and every `i`, some `s_i^D σ` is a linear combination of the monomials
`t^a s^β` of degree `|β| = D + k` (for the closed embedding `(s, π) : 𝓧 ↪ ℙᴺ × 𝔸¹`: the regular
functions on `{s_i ≠ 0}` are polynomials in `t` and the `s_l / s_i`). -/
def ChartCondition : Prop :=
  ∀ (i : Fin (N + 1)) (k : ℕ) (σ : SectionSpace T.structureMap T.line (r * k)), ∃ D : ℕ,
    (SecRing.of (r * D + r * k) (SectionSpace.mul T.structureMap T.extAtlas (r * D) (r * k)
      (secPow T.extAtlas (s i) D) σ) : SecRing T.structureMap T.extAtlas) ∈
      Submodule.span ℂ (degreeMonomials T s (D + k))

/-- **The sections `s_0, …, s_N` have no common zeros** (in the charts of the atlas of `𝓛`). -/
def NoCommonZero : Prop :=
  ∀ c : T.extAtlas.I, T.extAtlas.opens c ≤
    ⨆ i, T.space.basicOpen (atlasPowerGlobalCoefficients T.extAtlas r c (s i))

end Defs

/-! ### Laurent expansions of monomials -/

section Monomials

variable {T : TestConfiguration f a}

theorem graph_one : (secOne T.structureMap T.line, (1 : LaurentSecRing f a)) ∈ graph T 0 := by
  have := mem_graph_of_extends (TestConfiguration'.extends_one T)
  rwa [neg_zero, ← one_eq_mono] at this

theorem graph_tFun :
    ((show SectionSpace T.structureMap T.line 0 from tFun T.toLine), tElt f a) ∈ graph T 0 := by
  have := mem_graph_of_extends (TestConfiguration'.extends_tFun T)
  rwa [neg_neg] at this

theorem graph_secPow {r : ℕ} {σ : SectionSpace T.structureMap T.line r} {z : LaurentSecRing f a}
    (h : (σ, z) ∈ graph T r) (D : ℕ) : (secPow T.extAtlas σ D, z ^ D) ∈ graph T (r * D) := by
  induction D with
  | zero => exact graph_one
  | succ D ih =>
    rw [pow_succ]
    exact graph_mul ih h

variable {N r : ℕ} (s : Fin (N + 1) → SectionSpace T.structureMap T.line r)
  (Xl : Fin (N + 1) → LaurentSecRing f a)

/-- The monomial `t^a s^β` has the Laurent expansion `t^a X^β`. -/
theorem exists_monomial_graph (hs : ∀ l, (s l, Xl l) ∈ graph T r) (a' : ℕ)
    (β : Fin (N + 1) →₀ ℕ) :
    ∃ (M : ℕ) (σ0 : SectionSpace T.structureMap T.line M), M = r * expSum β ∧
      secMonomialξ T s a' β = SecRing.of M σ0 ∧
      (σ0, tElt f a ^ a' * β.prod fun l e => Xl l ^ e) ∈ graph T M := by
  classical
  have hβ : ∃ (M : ℕ) (σ0 : SectionSpace T.structureMap T.line M), M = r * expSum β ∧
      (β.prod fun l e => (SecRing.of r (s l) : SecRing T.structureMap T.extAtlas) ^ e) =
        SecRing.of M σ0 ∧ (σ0, β.prod fun l e => Xl l ^ e) ∈ graph T M := by
    induction β using Finsupp.induction with
    | zero =>
      refine ⟨0, secOne T.structureMap T.line, by simp [expSum], rfl, ?_⟩
      rw [Finsupp.prod_zero_index]
      exact graph_one
    | single_add i e β hi he ih =>
      obtain ⟨M, σ0, hM, hprod, hg⟩ := ih
      refine ⟨r * e + M, SectionSpace.mul T.structureMap T.extAtlas (r * e) M
        (secPow T.extAtlas (s i) e) σ0, ?_, ?_, ?_⟩
      · rw [hM, expSum, expSum, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, mul_add]
      · rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
          Finsupp.prod_single_index (by rw [pow_zero]), hprod]
        have hpow : ∀ e : ℕ, (SecRing.of r (s i) : SecRing T.structureMap T.extAtlas) ^ e =
            SecRing.of (r * e) (secPow T.extAtlas (s i) e) := by
          intro e
          induction e with
          | zero => rfl
          | succ e ihe => rw [pow_succ, ihe, SecRing.of_mul_of]; rfl
        rw [hpow, SecRing.of_mul_of]
      · rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
          Finsupp.prod_single_index (by rw [pow_zero])]
        exact graph_mul (graph_secPow (hs i) e) hg
  obtain ⟨M, σ0, hM, hprod, hg⟩ := hβ
  have htpow : ∀ n : ℕ, ∃ τ : SectionSpace T.structureMap T.line 0,
      tSecRing T ^ n = SecRing.of 0 τ ∧ (τ, tElt f a ^ n) ∈ graph T 0 := by
    intro n
    induction n with
    | zero => exact ⟨secOne T.structureMap T.line, rfl, graph_one⟩
    | succ n ih =>
      obtain ⟨τ, hτ, hτg⟩ := ih
      refine ⟨SectionSpace.mul T.structureMap T.extAtlas 0 0 τ
        (show SectionSpace T.structureMap T.line 0 from tFun T.toLine), ?_, ?_⟩
      · rw [pow_succ, hτ, tSecRing, SecRing.of_mul_of]
      · rw [pow_succ]
        exact graph_mul hτg graph_tFun
  obtain ⟨τ, hτ, hτg⟩ := htpow a'
  refine ⟨0 + M, SectionSpace.mul T.structureMap T.extAtlas 0 M τ σ0, by rw [zero_add, hM],
    ?_, graph_mul hτg hg⟩
  rw [secMonomialξ, hτ, hprod, SecRing.of_mul_of]

/-- Elements of the span of the degree-`n` monomials have Laurent expansions in `ℂ[t, X]`. -/
theorem exists_graph_of_mem_span (hs : ∀ l, (s l, Xl l) ∈ graph T r)
    (A : Subalgebra ℂ (LaurentSecRing f a)) (htA : tElt f a ∈ A) (hXA : ∀ l, Xl l ∈ A)
    (n M : ℕ) (hM : M = r * n) (ζ : SecRing T.structureMap T.extAtlas)
    (hζ : ζ ∈ Submodule.span ℂ (degreeMonomials T s n)) :
    ∃ u ∈ A, (SecRing.comp M ζ, u) ∈ graph T M := by
  refine Submodule.span_induction (p := fun ζ _ => ∃ u ∈ A, (SecRing.comp M ζ, u) ∈ graph T M)
    ?_ ?_ ?_ ?_ hζ
  · rintro _ ⟨a', β, hβ, rfl⟩
    obtain ⟨M', σ0, hM', hz, hg⟩ := exists_monomial_graph s Xl hs a' β
    have hMM : M' = M := by rw [hM', hβ, hM]
    subst hMM
    refine ⟨tElt f a ^ a' * β.prod fun l e => Xl l ^ e, ?_, ?_⟩
    · exact mul_mem (pow_mem htA _) (prod_mem fun l _ => pow_mem (hXA l) _)
    · rw [hz, SecRing.comp_of_same]
      exact hg
  · exact ⟨0, zero_mem _, by rw [SecRing.comp_zero]; exact zero_mem _⟩
  · rintro x y - - ⟨u, hu, hxu⟩ ⟨v, hv, hyv⟩
    refine ⟨u + v, add_mem hu hv, ?_⟩
    rw [SecRing.comp_add]
    exact add_mem hxu hyv
  · rintro c x - ⟨u, hu, hxu⟩
    refine ⟨c • u, Subalgebra.smul_mem _ hu c, ?_⟩
    rw [SecRing.comp_smul]
    exact Submodule.smul_mem _ c hxu

end Monomials

/-! ### Nonvanishing loci -/

theorem basicOpen_sum_le {Y : Scheme.{0}} {U : Y.Opens} {ι : Type*} (s : Finset ι)
    (g : ι → Γ(Y, U)) : Y.basicOpen (∑ i ∈ s, g i) ≤ ⨆ i ∈ s, Y.basicOpen (g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    refine (Y.basicOpen_add_le _ _).trans (sup_le ?_ (ih.trans ?_))
    · exact le_iSup₂_of_le i (Finset.mem_insert_self i s) le_rfl
    · exact iSup₂_le fun j hj => le_iSup₂_of_le j (Finset.mem_insert_of_mem hj) le_rfl

/-! ### The diagonalized coordinates -/

section Coordinates

variable [IsIntegral X] (T : TestConfiguration f a) (P : SectionLinearization T)
include P

/-- **The weight components of an embedding.** For a linearized test configuration and sections
`s_0, …, s_N ∈ H⁰(𝓧, 𝓛^r)` without common zeros satisfying the chart condition, there are
weight vectors `ξ_0, …, ξ_{N'}` (the weight components of the `s_l`; `ξ_i` extends
`t^{-w_i} q^* y_i`) without common zeros whose Rees coordinates `x_i = t^{-w_i} y_i` satisfy the
chart condition `H1` of `FGRel.isFinitelyGenerated_of_polarization`. -/
theorem exists_weightCoordinates {N r : ℕ} (s : Fin (N + 1) → SectionSpace T.structureMap T.line r)
    (hcov : NoCommonZero T s) (hchart : ChartCondition T s) :
    ∃ (N' : ℕ) (w : Fin (N' + 1) → ℤ) (y : Fin (N' + 1) → SectionSpace f L r)
      (ξ : Fin (N' + 1) → SectionSpace T.structureMap T.line r),
      (∀ i, T.Extends (w i) r (y i) (ξ i)) ∧ NoCommonZero T ξ ∧
      ∀ (k : ℕ) (j : ℤ) (s' : SectionSpace f L (r * k)), s' ∈ T.piece (-j) (r * k) →
        ∃ D : ℕ, ∀ i, coordElt a w y i ^ D * mono j (r * k) s' ∈ polAlg a w y := by
  classical
  -- weight decomposition of the `s_l`
  have hdec : ∀ l, ∃ c : ℤ →₀ SectionSpace T.structureMap T.line r,
      (∀ μ, c μ ∈ weightSpace T r μ) ∧ (c.sum fun _ x => x) = s l := fun l =>
    (Submodule.mem_iSup_iff_exists_finsupp _ _).mp (P.mem_iSup_weightSpace r (s l))
  choose c hc hcs using hdec
  choose yy hyy using hc
  -- the index set `Fin (N + 1) × S`
  let S : Finset ℤ := insert 0 (Finset.univ.biUnion fun l => (c l).support)
  have hS : ∀ l, (c l).support ⊆ S := fun l μ hμ =>
    Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ l, hμ⟩)
  let J := Fin (N + 1) × S
  have hJ : 0 < Fintype.card J := by
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_coe]
    exact Nat.mul_pos (Nat.succ_pos N) (Finset.card_pos.mpr ⟨0, Finset.mem_insert_self _ _⟩)
  let N' := Fintype.card J - 1
  let e : J ≃ Fin (N' + 1) := (Fintype.equivFin J).trans (finCongr (by omega))
  let w : Fin (N' + 1) → ℤ := fun i => ((e.symm i).2 : ℤ)
  let y : Fin (N' + 1) → SectionSpace f L r := fun i => yy (e.symm i).1 (e.symm i).2
  let ξ : Fin (N' + 1) → SectionSpace T.structureMap T.line r := fun i => c (e.symm i).1 (e.symm i).2
  have hext : ∀ i, T.Extends (w i) r (y i) (ξ i) := fun i => hyy _ _
  -- the groups
  let G : Fin (N + 1) → Finset (Fin (N' + 1)) := fun l =>
    (Finset.univ : Finset S).map ⟨fun μ => e (l, μ), fun μ μ' h =>
      (Prod.ext_iff.mp (e.injective h)).2⟩
  have hGinj : ∀ l, Set.InjOn w (G l) := by
    intro l i hi i' hi' hw
    simp only [G, Finset.coe_map, Function.Embedding.coeFn_mk, Set.mem_image,
      Finset.mem_coe, Finset.mem_univ, true_and] at hi hi'
    obtain ⟨μ, rfl⟩ := hi
    obtain ⟨μ', rfl⟩ := hi'
    simp only [w, Equiv.symm_apply_apply] at hw
    rw [Subtype.ext hw]
  have hGcov : ∀ i, ∃ l, i ∈ G l := fun i =>
    ⟨(e.symm i).1, Finset.mem_map.mpr ⟨(e.symm i).2, Finset.mem_univ _, by simp⟩⟩
  have hξsum : ∀ l, ∑ i ∈ G l, ξ i = s l := by
    intro l
    rw [← hcs l, Finsupp.sum, Finset.sum_map]
    simp only [Function.Embedding.coeFn_mk, ξ, Equiv.symm_apply_apply]
    rw [Finset.sum_coe_sort S (fun μ => c l μ)]
    exact (Finset.sum_subset (hS l) fun μ _ hμ => Finsupp.notMem_support_iff.mp hμ).symm
  -- the Laurent expansions `X_l` of the `s_l`
  let Xl : Fin (N + 1) → LaurentSecRing f a := fun l => ∑ i ∈ G l, coordElt a w y i
  have hXl : ∀ l, (s l, Xl l) ∈ graph T r := by
    intro l
    rw [← hξsum l]
    have : (∑ i ∈ G l, ξ i, Xl l) = ∑ i ∈ G l, (ξ i, coordElt a w y i) :=
      Prod.ext (by rw [Prod.fst_sum]) (by rw [Prod.snd_sum])
    rw [this]
    exact Submodule.sum_mem _ fun i _ => mem_graph_of_extends (hext i)
  have hXA : ∀ l, Xl l ∈ polAlg a w y := fun l =>
    Subalgebra.sum_mem _ fun i _ => coordElt_mem_polAlg a w y i
  refine ⟨N', w, y, ξ, hext, ?_, ?_⟩
  · -- no common zeros
    intro cc
    refine (hcov cc).trans (iSup_le fun l => ?_)
    rw [← hξsum l]
    have hcoef : atlasPowerGlobalCoefficients T.extAtlas r cc (∑ i ∈ G l, ξ i) =
        ∑ i ∈ G l, atlasPowerGlobalCoefficients T.extAtlas r cc (ξ i) :=
      map_sum (coeffHom T.extAtlas r cc) _ _
    rw [hcoef]
    exact (basicOpen_sum_le _ _).trans (iSup₂_le fun i _ => le_iSup_of_le i le_rfl)
  · -- the chart condition `H1`
    intro k j s' hs'
    obtain ⟨σ, hσ⟩ := hs'
    have hσg : (σ, mono j (r * k) s') ∈ graph T (r * k) := by
      have := mem_graph_of_extends hσ
      rwa [neg_neg] at this
    refine exists_uniform_pow_mul_mem w y G hGinj hGcov (mono j (r * k) s') j
      (fun cc => twist_mono cc j (r * k) s') fun l => ?_
    obtain ⟨D, hD⟩ := hchart l k σ
    refine ⟨D, ?_⟩
    obtain ⟨u, hu, hug⟩ := exists_graph_of_mem_span s Xl hXl (polAlg a w y)
      (tElt_mem_polAlg a w y) hXA (D + k) (r * D + r * k) (by ring) _ hD
    rw [SecRing.comp_of_same] at hug
    have hg := graph_mul (graph_secPow (hXl l) D) hσg
    rw [graph_unique hg hug]
    exact hu

/-- **[BHJ17, Prop. 2.15], first half, for linearized test configurations**: if a test
configuration with a `𝔾_m`-linearized line bundle has sections `s_0, …, s_N ∈ H⁰(𝓧, 𝓛^r)`
(`r > 0`) without common zeros satisfying the chart condition of the embedding they define, then
its filtration is finitely generated. -/
theorem filtrationFinitelyGenerated_of_chartCondition (E : ClosedProjectiveEmbedding f)
    {N r : ℕ} (hr : 0 < r) (s : Fin (N + 1) → SectionSpace T.structureMap T.line r)
    (hcov : NoCommonZero T s) (hchart : ChartCondition T s) : T.FiltrationFinitelyGenerated E := by
  obtain ⟨N', w, y, ξ, hext, hcovξ, H1⟩ := exists_weightCoordinates T P s hcov hchart
  exact isFinitelyGenerated_of_polarization E (T.zFiltration E) (T.zFiltration_piece_zero_zero E)
    hr w y (fun i => T.mem_piece.mpr ⟨ξ i, hext i⟩) H1
    (fun k j s' h => saturation_of_weightSections E T w y ξ hext hcovξ k j s' h)

end Coordinates

end SGPT.TestCurve.TCLin
