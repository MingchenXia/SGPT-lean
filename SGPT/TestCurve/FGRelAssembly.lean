import SGPT.TestCurve.FGRelSaturation

/-!
# Finite generation of a polarized `ℤ`-filtration

See [BHJ17, Prop. 2.15]. Assembly of the algebraic part of the finite generation of the
filtration of an ample test configuration: if a normalized `ℤ`-filtration `𝓕` of `R(X, L)`
(`X` integral and projective) admits bihomogeneous elements `x_i = t^{-w_i} y_i` of its Rees
algebra satisfying the chart and saturation conditions of `FGRel.mono_mem_polAlg_of_large`, then
its Rees algebra is a finitely generated `ℂ`-algebra
(`SectionZFiltration.IsFinitelyGenerated`).

* Large degrees `r k`: the Rees algebra agrees with `ℂ[t, x]` (`mono_mem_polAlg_of_large`).
* Each fixed degree `m` is a finitely generated `ℂ[t]`-module (`exists_degree_gens`: the
  filtration of the finite-dimensional `H⁰(X, L^m)` has finitely many jumps).
* Degrees prime to `r` (Veronese): multiplication by a nonzero `u^{r-1}`, `u` bihomogeneous of
  degree `≡ ρ (mod r)`, embeds the degree-`≡ ρ` part into the Noetherian algebra generated in
  degrees `≡ 0` (`exists_residue_gens`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.FGRel

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle
open SGPT.TestCurve.TestConfig SGPT.TestCurve.TestConfig.LaurentSecRing

variable {X : Scheme} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules} {a : LineBundleAtlas L}

theorem tElt_pow_mul_mono (n : ℕ) (j : ℤ) (m : ℕ) (s : SectionSpace f L m) :
    tElt f a ^ n * mono j m s = mono ((n : ℤ) + j) m s := by
  induction n with
  | zero => rw [pow_zero, one_mul, Nat.cast_zero, zero_add]
  | succ n ih =>
    rw [pow_succ', mul_assoc, ih, tElt_mul_mono]
    congr 1
    push_cast
    ring

namespace SectionZFiltration'

variable (F : SectionZFiltration f a)

theorem tElt_mem_rees (h0 : F.piece 0 0 = ⊤) : tElt f a ∈ F.rees := by
  have : secOne f L ∈ F.piece (-1) 0 := F.piece_anti (by norm_num) 0 (h0 ▸ Submodule.mem_top)
  have h := F.mono_mem_rees this
  rwa [neg_neg] at h

theorem mono_mem_rees' {j : ℤ} {m : ℕ} {s : SectionSpace f L m} (hs : s ∈ F.piece (-j) m) :
    (mono j m s : LaurentSecRing f a) ∈ F.rees := by
  have h := F.mono_mem_rees hs
  rwa [neg_neg] at h

/-- **Each degree is a finitely generated `ℂ[t]`-module**: there is a finite set `G` of
bihomogeneous elements of the Rees algebra in degree `m` such that every `t^j s`,
`s ∈ 𝓕^{-j} H⁰(X, L^m)`, lies in the algebra generated by `t` and `G`. -/
theorem exists_degree_gens [IsIntegral X] (E : ClosedProjectiveEmbedding f) (m : ℕ) :
    ∃ G : Set (LaurentSecRing f a), G.Finite ∧ G ⊆ F.rees ∧
      ∀ (j : ℤ) (s : SectionSpace f L m), s ∈ F.piece (-j) m →
        mono j m s ∈ Algebra.adjoin ℂ (insert (tElt f a) G) := by
  classical
  have := SectionSpace.finiteDimensional f E a m
  obtain ⟨μ0, hμ0⟩ := F.exhaustive m
  obtain ⟨μ1', hμ1'⟩ := F.separating m
  set μ1 := max μ0 μ1' with hμ1def
  have hμ1 : F.piece μ1 m = ⊥ :=
    eq_bot_iff.mpr ((F.piece_anti (le_max_right _ _) m).trans hμ1'.le)
  have hμ01 : μ0 ≤ μ1 := le_max_left _ _
  have hfg : ∀ μ : ℤ, (F.piece μ m).FG := fun μ => IsNoetherian.noetherian _
  choose S hS using fun μ => (hfg μ)
  let G : Set (LaurentSecRing f a) :=
    ⋃ μ ∈ Finset.Icc μ0 μ1, (fun s => (mono (-μ) m s : LaurentSecRing f a)) '' (S μ : Set _)
  have hmem : ∀ μ ∈ Finset.Icc μ0 μ1, ∀ s ∈ F.piece μ m,
      (mono (-μ) m s : LaurentSecRing f a) ∈ Algebra.adjoin ℂ (insert (tElt f a) G) := by
    intro μ hμ s hs
    rw [← hS μ] at hs
    have h1 : monoLin f a (-μ) m s ∈ Submodule.map (monoLin f a (-μ) m) (Submodule.span ℂ (S μ)) :=
      Submodule.mem_map_of_mem hs
    rw [Submodule.map_span] at h1
    have h2 : Submodule.span ℂ (monoLin f a (-μ) m '' (S μ : Set _)) ≤
        Subalgebra.toSubmodule (Algebra.adjoin ℂ (insert (tElt f a) G)) := by
      rw [Submodule.span_le]
      rintro _ ⟨s', hs', rfl⟩
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _
        (Set.mem_biUnion hμ ⟨s', hs', rfl⟩))
    exact h2 h1
  refine ⟨G, ?_, ?_, ?_⟩
  · exact Set.Finite.biUnion (Finset.finite_toSet _) fun μ _ => (S μ).finite_toSet.image _
  · intro z hz
    obtain ⟨μ, -, s, hs, rfl⟩ := Set.mem_iUnion₂.mp hz
    have : s ∈ F.piece μ m := hS μ ▸ Submodule.subset_span hs
    exact F.mono_mem_rees this
  · intro j s hs
    by_cases h1 : μ1 ≤ -j
    · have : s ∈ F.piece μ1 m := F.piece_anti h1 m hs
      rw [hμ1, Submodule.mem_bot] at this
      rw [this, mono_zero]
      exact zero_mem _
    · by_cases h2 : -j < μ0
      · have hs0 : s ∈ F.piece μ0 m := hμ0 ▸ Submodule.mem_top
        have hμ0' : μ0 ∈ Finset.Icc μ0 μ1 :=
          Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
        have e : (mono j m s : LaurentSecRing f a) =
            tElt f a ^ (j + μ0).toNat * mono (-μ0) m s := by
          rw [tElt_pow_mul_mono]
          congr 1
          omega
        rw [e]
        exact mul_mem (pow_mem (Algebra.subset_adjoin (Set.mem_insert _ _)) _)
          (hmem μ0 hμ0' s hs0)
      · have hj : -j ∈ Finset.Icc μ0 μ1 := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
        have := hmem (-j) hj s hs
        rwa [neg_neg] at this

/-- Bihomogeneous elements of the Rees algebra (with the index of the filtration recorded). -/
def IsBihomRees (z : LaurentSecRing f a) (m : ℕ) : Prop :=
  ∃ (m' : ℕ) (j : ℤ) (s : SectionSpace f L m'), m' = m ∧ s ∈ F.piece (-j) m' ∧ z = mono j m' s

theorem IsBihomRees.mul {z z' : LaurentSecRing f a} {m m' : ℕ} (hz : IsBihomRees F z m)
    (hz' : IsBihomRees F z' m') : IsBihomRees F (z * z') (m + m') := by
  obtain ⟨m, j, s, rfl, hs, rfl⟩ := hz
  obtain ⟨m', j', s', rfl, hs', rfl⟩ := hz'
  refine ⟨m + m', j + j', _, rfl, ?_, mono_mul_mono j j' m m' s s'⟩
  rw [neg_add]
  exact F.mul_mem _ _ _ _ _ _ hs hs'

theorem IsBihomRees.pow {z : LaurentSecRing f a} {m : ℕ} (hz : IsBihomRees F z m)
    (h0 : F.piece 0 0 = ⊤) (e : ℕ) : IsBihomRees F (z ^ e) (m * e) := by
  induction e with
  | zero => exact ⟨0, 0, secOne f L, rfl, by rw [neg_zero, h0]; exact Submodule.mem_top, rfl⟩
  | succ e ih => rw [pow_succ, Nat.mul_succ]; exact ih.mul F hz

theorem IsBihomRees.mem_rees {z : LaurentSecRing f a} {m : ℕ} (hz : IsBihomRees F z m) :
    z ∈ F.rees := by
  obtain ⟨m, j, s, rfl, hs, rfl⟩ := hz
  exact mono_mem_rees' F hs

set_option backward.isDefEq.respectTransparency true in
/-- **Veronese step**: if every bihomogeneous element of the Rees algebra of degree divisible by
`r` lies in a finitely generated subalgebra `A ⊆ Rees`, then for each residue `ρ` finitely many
bihomogeneous elements `Z` of the Rees algebra generate, together with `A`, every bihomogeneous
element of degree `≡ ρ (mod r)`. -/
theorem exists_residue_gens [IsIntegral X] (h0 : F.piece 0 0 = ⊤) {r : ℕ} (hr : 0 < r)
    (A : Subalgebra ℂ (LaurentSecRing f a)) (hA : A.FG)
    (hdeg : ∀ (m : ℕ) (z : LaurentSecRing f a), r ∣ m → IsBihomRees F z m → z ∈ A) (ρ : ℕ) :
    ∃ Z : Set (LaurentSecRing f a), Z.Finite ∧ Z ⊆ F.rees ∧
      ∀ (m : ℕ) (z : LaurentSecRing f a), m % r = ρ → IsBihomRees F z m →
        z ∈ Algebra.adjoin ℂ ((A : Set (LaurentSecRing f a)) ∪ Z) := by
  classical
  by_cases hex : ∃ (m : ℕ) (z : LaurentSecRing f a), m % r = ρ ∧ IsBihomRees F z m ∧ z ≠ 0
  swap
  · refine ⟨∅, Set.finite_empty, Set.empty_subset _, fun m z hm hz => ?_⟩
    have : z = 0 := by
      by_contra hne
      exact hex ⟨m, z, hm, hz, hne⟩
    rw [this]
    exact zero_mem _
  obtain ⟨m0, u, hm0, hu, hu0⟩ := hex
  set u' := u ^ (r - 1) with hu'def
  have hu'0 : u' ≠ 0 := pow_ne_zero _ hu0
  have hu' : IsBihomRees F u' (m0 * (r - 1)) := hu.pow F h0 (r - 1)
  -- the products `z u'` lie in `A`
  have hprod : ∀ (m : ℕ) (z : LaurentSecRing f a), m % r = ρ → IsBihomRees F z m →
      z * u' ∈ A := by
    intro m z hm hz
    refine hdeg _ _ ?_ (hz.mul F hu')
    have h1 : m ≡ ρ [MOD r] := by rw [← hm]; exact (Nat.mod_modEq m r).symm
    have h2 : m0 ≡ ρ [MOD r] := by rw [← hm0]; exact (Nat.mod_modEq m0 r).symm
    have h3 := h1.add (h2.mul_right (r - 1))
    have h4 : ρ + ρ * (r - 1) = ρ * r := by
      obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
      rw [Nat.add_sub_cancel]
      ring
    rw [h4] at h3
    exact (Nat.modEq_zero_iff_dvd).mp (h3.trans ((Nat.modEq_zero_iff_dvd).mpr (dvd_mul_left r ρ)))
  -- the ideal of `A` generated by the products
  let SA : Set A := {c | ∃ (m : ℕ) (z : LaurentSecRing f a), m % r = ρ ∧ IsBihomRees F z m ∧
    (c : LaurentSecRing f a) = z * u'}
  have hnoeth : IsNoetherianRing A := by
    have : Algebra.FiniteType ℂ A := (Subalgebra.fg_iff_finiteType A).mp hA
    exact Algebra.FiniteType.isNoetherianRing ℂ A
  have hfgI : (Ideal.span SA).FG := IsNoetherian.noetherian _
  obtain ⟨T0, hT0⟩ := hfgI
  have hfin : ∀ t : A, t ∈ T0 → ∃ S0 : Set A, S0.Finite ∧ S0 ⊆ SA ∧
      t ∈ Submodule.span A S0 := by
    intro t ht
    have : t ∈ Ideal.span SA := hT0 ▸ Submodule.subset_span ht
    obtain ⟨S0, hS0, ht0⟩ := Submodule.mem_span_finite_of_mem_span this
    exact ⟨S0, S0.finite_toSet, hS0, ht0⟩
  choose S0 hS0f hS0 htS0 using hfin
  let S1 : Set A := ⋃ (t : A) (ht : t ∈ T0), S0 t ht
  have hS1f : S1.Finite := by
    exact Set.Finite.biUnion' T0.finite_toSet fun t ht => hS0f t ht
  have hS1 : S1 ⊆ SA := Set.iUnion₂_subset fun t ht => hS0 t ht
  have hspan : Ideal.span SA ≤ Submodule.span A S1 := by
    rw [← hT0, Submodule.span_le]
    intro t ht
    exact Submodule.span_mono (Set.subset_iUnion₂_of_subset t ht le_rfl) (htS0 t ht)
  have hS1' : ∀ c : A, c ∈ S1 → c ∈ SA := fun c hc => hS1 hc
  choose zm zz _ hzb hze using hS1'
  let Z : Set (LaurentSecRing f a) := Set.range fun c : S1 => zz c.1 c.2
  have hZf : Z.Finite := by
    have : Finite S1 := hS1f.to_subtype
    exact Set.finite_range _
  refine ⟨Z, hZf, ?_, fun m z hm hz => ?_⟩
  · rintro _ ⟨c, rfl⟩
    exact (hzb c.1 c.2).mem_rees F
  · -- every element of `span S1` is `q u'` with `q` in the algebra generated by `A` and `Z`
    let B : Subalgebra ℂ (LaurentSecRing f a) :=
      Algebra.adjoin ℂ ((A : Set (LaurentSecRing f a)) ∪ Z)
    have hrep : ∀ c : A, c ∈ Submodule.span A S1 → ∃ q ∈ B,
        (c : LaurentSecRing f a) = q * u' := by
      intro c hc
      refine Submodule.span_induction (p := fun (c : A) _ => ∃ q ∈ B,
        (c : LaurentSecRing f a) = q * u') ?_ ?_ ?_ ?_ hc
      · intro c hc
        exact ⟨zz c hc, Algebra.subset_adjoin (Or.inr ⟨⟨c, hc⟩, rfl⟩), hze c hc⟩
      · exact ⟨0, zero_mem _, by simp⟩
      · rintro c c' - - ⟨q, hq, hc⟩ ⟨q', hq', hc'⟩
        exact ⟨q + q', add_mem hq hq', by rw [Subalgebra.coe_add, hc, hc', add_mul]⟩
      · rintro b c - ⟨q, hq, hc⟩
        refine ⟨(b : LaurentSecRing f a) * q,
          mul_mem (Algebra.subset_adjoin (Or.inl b.2)) hq, ?_⟩
        rw [smul_eq_mul, Subalgebra.coe_mul, hc, mul_assoc]
    have hzA : (⟨z * u', hprod m z hm hz⟩ : A) ∈ Ideal.span SA :=
      Submodule.subset_span ⟨m, z, hm, hz, rfl⟩
    obtain ⟨q, hq, hqe⟩ := hrep _ (hspan hzA)
    have : z = q := by
      apply mul_left_injective_of_ne_zero hu'0
      rw [mul_comm u', mul_comm u']
      exact hqe
    rw [this]
    exact hq

end SectionZFiltration'

open SectionZFiltration' in
/-- **Finite generation of a polarized `ℤ`-filtration.** Let `𝓕` be a normalized `ℤ`-filtration
of `R(X, L)`, `X` integral and projective, and let `x_i = t^{-w_i} y_i`, `y_i ∈ 𝓕^{w_i}
H⁰(X, L^r)`, satisfy the chart condition `H1` and the saturation condition `H2` of
`mono_mem_polAlg_of_large`. Then the Rees algebra of `𝓕` is a finitely generated
`ℂ`-algebra. -/
theorem isFinitelyGenerated_of_polarization [IsIntegral X] (E : ClosedProjectiveEmbedding f)
    (F : SectionZFiltration f a) (h0 : F.piece 0 0 = ⊤) {N r : ℕ} (hr : 0 < r)
    (w : Fin (N + 1) → ℤ) (y : Fin (N + 1) → SectionSpace f L r)
    (hy : ∀ i, y i ∈ F.piece (w i) r)
    (H1 : ∀ (k : ℕ) (j : ℤ) (s : SectionSpace f L (r * k)), s ∈ F.piece (-j) (r * k) →
      ∃ D : ℕ, ∀ i, coordElt a w y i ^ D * mono j (r * k) s ∈ polAlg a w y)
    (H2 : ∀ (k : ℕ) (j : ℤ) (s : SectionSpace f L (r * k)),
      (∀ i, ∃ D : ℕ, coordElt a w y i ^ D * mono j (r * k) s ∈ polAlg a w y) →
        s ∈ F.piece (-j) (r * k)) :
    F.IsFinitelyGenerated := by
  classical
  obtain ⟨b, hb⟩ := mono_mem_polAlg_of_large a w y hr F H1 H2
  choose G hGf hGr hG using fun m => exists_degree_gens F E m
  let G0 : Set (LaurentSecRing f a) := insert (tElt f a)
    (Set.range (coordElt a w y) ∪ ⋃ k ∈ Finset.range b.toNat, G (r * k))
  have hG0f : G0.Finite :=
    ((Set.finite_range _).union
      (Set.Finite.biUnion (Finset.finite_toSet _) fun k _ => hGf _)).insert _
  let A : Subalgebra ℂ (LaurentSecRing f a) := Algebra.adjoin ℂ G0
  have hAfg : A.FG := ⟨hG0f.toFinset, by rw [Set.Finite.coe_toFinset]⟩
  have hpolA : polAlg a w y ≤ A :=
    Algebra.adjoin_mono (Set.insert_subset_insert Set.subset_union_left)
  have hdeg : ∀ (m : ℕ) (z : LaurentSecRing f a), r ∣ m → IsBihomRees F z m → z ∈ A := by
    rintro m z ⟨k, rfl⟩ ⟨m', j, s, hm', hs, rfl⟩
    subst hm'
    by_cases hk : b ≤ k
    · exact hpolA (hb k hk j s hs)
    · have hk' : k ∈ Finset.range b.toNat := Finset.mem_range.mpr (by omega)
      refine Algebra.adjoin_mono (Set.insert_subset_insert ?_) (hG (r * k) j s hs)
      intro z hz
      exact Or.inr (Set.mem_biUnion hk' hz)
  choose Z hZf hZr hZ using fun ρ => exists_residue_gens F h0 hr A hAfg hdeg ρ
  let Gall : Set (LaurentSecRing f a) := G0 ∪ ⋃ ρ ∈ Finset.range r, Z ρ
  have hGallf : Gall.Finite :=
    hG0f.union (Set.Finite.biUnion (Finset.finite_toSet _) fun ρ _ => hZf ρ)
  have hGall : Gall ⊆ F.rees := by
    rintro x ((rfl | (⟨i, rfl⟩ | hx)) | hx)
    · exact tElt_mem_rees F h0
    · have h := F.mono_mem_rees (hy i)
      exact h
    · obtain ⟨k, -, hx⟩ := Set.mem_iUnion₂.mp hx
      exact hGr _ hx
    · obtain ⟨ρ, -, hx⟩ := Set.mem_iUnion₂.mp hx
      exact hZr ρ hx
  have hle : F.rees ≤ Algebra.adjoin ℂ Gall := by
    apply Algebra.adjoin_le
    rintro _ ⟨μ, m, s, hs, rfl⟩
    have hz : IsBihomRees F (mono (-μ) m s) m := ⟨m, -μ, s, rfl, by rwa [neg_neg], rfl⟩
    have hρ : m % r ∈ Finset.range r := Finset.mem_range.mpr (Nat.mod_lt _ hr)
    refine Algebra.adjoin_le ?_ (hZ (m % r) m _ rfl hz)
    rintro x (hx | hx)
    · exact Algebra.adjoin_mono Set.subset_union_left hx
    · exact Algebra.subset_adjoin (Or.inr (Set.mem_biUnion hρ hx))
  refine ⟨hGallf.toFinset, ?_⟩
  rw [Set.Finite.coe_toFinset]
  exact le_antisymm (Algebra.adjoin_le hGall) hle

end SGPT.TestCurve.FGRel
