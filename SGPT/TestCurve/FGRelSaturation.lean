import SGPT.TestCurve.FGRelPolarized

/-!
# The Rees algebra agrees with `ℂ[t, x₀, …, x_N]` in large degrees

See [BHJ17, Prop. 2.15]. Let `𝓕` be a `ℤ`-filtration of `R(X, L)` and let
`x_i = t^{-w_i} y_i` (`y_i ∈ H⁰(X, L^r)`) be such that

* (chart condition) every bihomogeneous element `t^j s` of the Rees algebra in degree `r k`
  satisfies `x_i^D · t^j s ∈ ℂ[t, x]` for all `i` and some `D`;
* (saturation condition) conversely, if `x_i^D · t^j s ∈ ℂ[t, x]` for all `i`, then `t^j s` lies
  in the Rees algebra.

For the filtration of a test configuration `(𝓧, 𝓛)` with an equivariant closed embedding
`𝓧 ↪ ℙᴺ × 𝔸¹` by `𝓛^r` these are the geometric facts "`Γ(𝓧 ∩ {x_i ≠ 0}, 𝒪)` is generated by the
`x_l / x_i` and `t`" and "a section of `𝓛^{rk}` over `𝓧 ∖ 𝓧₀` which becomes regular after
multiplication by `x_i^D` for every `i` is regular". Then every bihomogeneous element of degree
`r k`, `k ≫ 0`, of the Rees algebra lies in `ℂ[t, x]` (`mono_mem_polAlg_of_large`).

The proof is the reduction modulo `t` to the central fibre `𝓧₀ = V(J) ⊆ ℙᴺ`
(`J = relIdeal`): Serre's theorem over the field `ℂ` (`FGRel.exists_saturation_lift`, from
`SGPT.Foundations.Schemes`) lifts the compatible family `(x_i^D t^j s mod t) / x_i^D` to a polynomial
`c(x)` of degree `k`, and the saturation condition shows that `(c(x)_j - t^j s) / t` lies in the
Rees algebra; induction on the power of `t` (bounded below since `𝓕` is separating) concludes.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.FGRel

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle
open SGPT.TestCurve.TestConfig SGPT.TestCurve.TestConfig.LaurentSecRing

variable {X : Scheme} {f : X ⟶ Spec (.of ℂ)} {L : X.Modules} (a : LineBundleAtlas L)
variable {N r : ℕ} (w : Fin (N + 1) → ℤ) (y : Fin (N + 1) → SectionSpace f L r)

theorem mono_sub (j : ℤ) (m : ℕ) (s s' : SectionSpace f L m) :
    (mono j m (s - s') : LaurentSecRing f a) = mono j m s - mono j m s' :=
  (monoLin f a j m).map_sub s s'

theorem bproj_tElt_mul' (j : ℤ) (m : ℕ) (u : LaurentSecRing f a) :
    bproj f a j m (tElt f a * u) = tElt f a * bproj f a (j - 1) m u := by
  rw [← bproj_tElt_mul, add_sub_cancel]

/-! ### The ideal of relations of the central fibre -/

/-- The polynomials `P` with `P(x) ∈ t · ℂ[t, x]`. -/
def relIdeal₀ : Ideal (MvPolynomial (Fin (N + 1)) ℂ) where
  carrier := {p | ∃ v ∈ polAlg a w y, coordEval a w y p = tElt f a * v}
  add_mem' := by
    rintro p q ⟨v, hv, hp⟩ ⟨v', hv', hq⟩
    exact ⟨v + v', add_mem hv hv', by rw [map_add, hp, hq, mul_add]⟩
  zero_mem' := ⟨0, zero_mem _, by rw [map_zero, mul_zero]⟩
  smul_mem' := by
    rintro c p ⟨v, hv, hp⟩
    exact ⟨coordEval a w y c * v, mul_mem (coordEval_mem_polAlg a w y c) hv, by
      rw [smul_eq_mul, map_mul, hp]; ring⟩

/-- The homogeneous ideal of relations: generated by the homogeneous `P` with
`P(x) ∈ t · ℂ[t, x]` (the ideal of the central fibre `𝓧₀ ⊆ ℙᴺ`). -/
def relIdeal : Ideal (MvPolynomial (Fin (N + 1)) ℂ) :=
  Ideal.span {p | (∃ k : ℤ, p ∈ polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1)) k) ∧
    p ∈ relIdeal₀ a w y}

theorem relIdeal_le : relIdeal a w y ≤ relIdeal₀ a w y :=
  Ideal.span_le.mpr fun _ hp => hp.2

theorem relIdeal_isHomogeneous :
    (relIdeal a w y).IsHomogeneous (polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1))) :=
  Ideal.homogeneous_span _ _ fun _ hp => hp.1

theorem X_pow_mem_grading (i : Fin (N + 1)) (D : ℕ) :
    (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) ℂ) ^ D ∈
      polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1)) (D : ℤ) := by
  simpa using SetLike.pow_mem_graded D (polynomialCoordinate_X_degree (K := ℂ) i)

/-! ### Large degrees -/

/-- **The Rees algebra agrees with `ℂ[t, x]` in large degrees**, given the chart and saturation
conditions (see the module docstring). -/
theorem mono_mem_polAlg_of_large (hr : 0 < r) (F : SectionZFiltration f a)
    (H1 : ∀ (k : ℕ) (j : ℤ) (s : SectionSpace f L (r * k)), s ∈ F.piece (-j) (r * k) →
      ∃ D : ℕ, ∀ i, coordElt a w y i ^ D * mono j (r * k) s ∈ polAlg a w y)
    (H2 : ∀ (k : ℕ) (j : ℤ) (s : SectionSpace f L (r * k)),
      (∀ i, ∃ D : ℕ, coordElt a w y i ^ D * mono j (r * k) s ∈ polAlg a w y) →
        s ∈ F.piece (-j) (r * k)) :
    ∃ b : ℤ, ∀ k : ℕ, b ≤ k → ∀ (j : ℤ) (s : SectionSpace f L (r * k)),
      s ∈ F.piece (-j) (r * k) → mono j (r * k) s ∈ polAlg a w y := by
  classical
  obtain ⟨b, hb⟩ := exists_saturation_lift (K := ℂ) (I := Fin (N + 1)) (relIdeal a w y)
    (relIdeal_isHomogeneous a w y)
  refine ⟨b, fun k hk => ?_⟩
  obtain ⟨μ1, hμ1⟩ := F.separating (r * k)
  suffices h : ∀ n : ℕ, ∀ j : ℤ, j ≤ -μ1 + n → ∀ s : SectionSpace f L (r * k),
      s ∈ F.piece (-j) (r * k) → mono j (r * k) s ∈ polAlg a w y from
    fun j s hs => h (j + μ1).toNat j (by omega) s hs
  intro n
  induction n with
  | zero =>
    intro j hj s hs
    have h1 : s ∈ F.piece μ1 (r * k) := F.piece_anti (by omega) _ hs
    rw [hμ1, Submodule.mem_bot] at h1
    rw [h1, mono_zero]
    exact zero_mem _
  | succ n ih =>
    intro j hj s hs
    obtain ⟨D, hD⟩ := H1 k j s hs
    have hred : ∀ i, ∃ p : MvPolynomial (Fin (N + 1)) ℂ,
        p ∈ polynomialIntegralGrading (K := ℂ) (I := Fin (N + 1)) ((k : ℤ) + D) ∧
        ∃ v ∈ polAlg a w y,
          coordElt a w y i ^ D * mono j (r * k) s = coordEval a w y p + tElt f a * v := by
      intro i
      obtain ⟨jx, sx, hjx⟩ := exists_mono_pow (a := a) (-(w i)) r (y i) D
      obtain ⟨p0, v0, hv0, he⟩ := exists_coordEval_add_tElt_mul a w y (hD i)
      have hfix : bproj f a (jx + j) (r * D + r * k) (coordElt a w y i ^ D * mono j (r * k) s) =
          coordElt a w y i ^ D * mono j (r * k) s := by
        rw [coordElt, hjx, mono_mul_mono, bproj_mono_same]
      obtain ⟨q, hq, hqe⟩ := exists_bproj_coordEval a w y hr p0 (jx + j) (D + k)
      refine ⟨q, ?_, bproj f a (jx + j - 1) (r * D + r * k) v0,
        bproj_mem_polAlg a w y _ _ hv0, ?_⟩
      · have e : ((D + k : ℕ) : ℤ) = (k : ℤ) + D := by push_cast; ring
        rwa [e] at hq
      · rw [← hfix, he, map_add, bproj_tElt_mul', show r * D + r * k = r * (D + k) by ring, hqe]
    choose p hp v hv hpv using hred
    have hcomp : ∀ i i', (MvPolynomial.X i' : MvPolynomial (Fin (N + 1)) ℂ) ^ D * p i -
        MvPolynomial.X i ^ D * p i' ∈ relIdeal a w y := by
      intro i i'
      apply Ideal.subset_span
      refine ⟨⟨(D : ℤ) + ((k : ℤ) + D), sub_mem
        (SetLike.mul_mem_graded (X_pow_mem_grading i' D) (hp i))
        (SetLike.mul_mem_graded (X_pow_mem_grading i D) (hp i'))⟩,
        coordElt a w y i ^ D * v i' - coordElt a w y i' ^ D * v i,
        sub_mem (mul_mem (pow_mem (coordElt_mem_polAlg a w y i) D) (hv i'))
          (mul_mem (pow_mem (coordElt_mem_polAlg a w y i') D) (hv i)), ?_⟩
      rw [map_sub, map_mul, map_mul, map_pow, map_pow]
      simp only [coordEval, MvPolynomial.aeval_X] at hpv ⊢
      linear_combination (-(coordElt a w y i' ^ D)) * hpv i + coordElt a w y i ^ D * hpv i'
    obtain ⟨c, -, hcE⟩ := hb k hk D p hp hcomp
    choose E hE using hcE
    have hE' : ∀ i, ∃ u ∈ polAlg a w y, coordEval a w y
        ((MvPolynomial.X i) ^ E i * (MvPolynomial.X i ^ D * c - p i)) = tElt f a * u :=
      fun i => relIdeal_le a w y (hE i)
    choose u hu hue using hE'
    set cj := coeffAt j (r * k) (coordEval a w y c) with hcj
    have hwz : (mono j (r * k) cj : LaurentSecRing f a) ∈ polAlg a w y :=
      bproj_mem_polAlg a w y j (r * k) (coordEval_mem_polAlg a w y c)
    have hTz' : tElt f a * mono (j - 1) (r * k) (cj - s) = mono j (r * k) cj - mono j (r * k) s := by
      rw [tElt_mul_mono, show 1 + (j - 1) = j by ring, mono_sub]
    have key : ∀ i, coordElt a w y i ^ (E i + D) * mono (j - 1) (r * k) (cj - s) ∈
        polAlg a w y := by
      intro i
      obtain ⟨jy, sy, hjy⟩ := exists_mono_pow (a := a) (-(w i)) r (y i) (E i + D)
      have hid : coordElt a w y i ^ (E i + D) * (coordEval a w y c - mono j (r * k) s) =
          tElt f a * (u i - coordElt a w y i ^ E i * v i) := by
        have h1 := hue i
        rw [map_mul, map_pow, map_sub, map_mul, map_pow] at h1
        simp only [coordEval, MvPolynomial.aeval_X] at h1 hpv
        simp only [coordEval]
        linear_combination h1 - coordElt a w y i ^ E i * hpv i
      have hp1 := congrArg (bproj f a (jy + j) (r * (E i + D) + r * k)) hid
      rw [coordElt, hjy, bproj_mono_mul, map_sub, bproj_apply (j := j), bproj_mono_same,
        bproj_tElt_mul', ← hcj, ← hTz', ← hjy, mul_left_comm] at hp1
      rw [coordElt, tElt_mul_cancel hp1]
      exact bproj_mem_polAlg a w y _ _ (sub_mem (hu i)
        (mul_mem (pow_mem (coordElt_mem_polAlg a w y i) _) (hv i)))
    have hs'' := H2 k (j - 1) (cj - s) (fun i => ⟨E i + D, key i⟩)
    have hz' := ih (j - 1) (by omega) (cj - s) hs''
    have e : (mono j (r * k) s : LaurentSecRing f a) =
        mono j (r * k) cj - tElt f a * mono (j - 1) (r * k) (cj - s) := by
      rw [hTz']; ring
    rw [e]
    exact sub_mem hwz (mul_mem (tElt_mem_polAlg a w y) hz')

end SGPT.TestCurve.FGRel
