import SGPT.TestCurve.SkodaIncMonomials
import SGPT.TestCurve.SkodaRWNMultiplier

/-!
# The obstacle of a finitely generated filtration is bounded by one level of the filtration

Input of `SkodaInclusionIdeal` (the Skoda-division part of [RWN14, Theorem 7.10], used for
`rmk:PhongSturm`, chapter *Test curves*). Let `𝓕` be a normalized finitely generated
`ℤ`-filtration of `R(X, L)` and `τ'' < τ`. For a degree `d` large enough, with
`W = 𝓕^{dτ''}_d` spanned by `w₁, …, w_r` and `|w|² = ∑ⱼ |wⱼ|²_{h^d}`, this file proves that
for every `K > 0`

`K⁻¹ Γ^{𝓕,K}_τ ≤ d⁻¹ log |w|² + C_K`   on `X`,

with a constant `C_K` depending on `K` (`normalizedPotential_le_familyLog`). Together with the
strong openness theorem for increasing sequences (`SkodaIncOpenness`) this shows that the
multiplier ideals of the obstacle `ψ_τ = usc sup_K K⁻¹ Γ^{𝓕,K}_τ` are contained in those of
`d⁻¹ log |w|²` ([RWN14, §7]: `ψ_τ` is dominated by the analytic singularities of one level of the
filtration).

## Proof

By finite generation (`SkodaIncMonomials`), `𝓕^{Kτ}_K` is spanned by the monomials
`g^e = ∏ᵢ gᵢ^{eᵢ}` in the generators of the Rees algebra, of degree `∑ eᵢ mᵢ = K` and weight
`∑ eᵢ μᵢ ≥ Kτ`. For such a monomial, the rounded exponents `bᵢ = ⌊(d - e₀) eᵢ / K⌋` give a monomial
`g^b` of degree `d - p` (`e₀ ≤ p ≤ e₀ + ∑ mᵢ`) and weight `≥ (d - e₀)τ - ∑ |μᵢ|`; its products
`g^b h` with the sections `h` of `L^p` lie in `W` when `d` is large, and since `L^p` is globally
generated (`p ≥ e₀`), `|g^b|² ≤ A |w|²`. As `K bᵢ ≤ d eᵢ`, `|g^e|^{2d} ≤ C |g^b|^{2K} ≤ C' |w|^{2K}`
(`monomial_pow_le`). The bound passes to linear combinations (`pow_le_of_mem_span`) and,
uniformly, to the sup-normalized sections of `𝓕^{Kτ}_K` (compactness,
`exists_normalized_pow_le`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.SkodaInc

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes Filter Set SGPT.Okounkov SGPT.LineBundle
open SGPT.LineBundle.Misc2RWN
open SGPT.TestCurve.TestConfig
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open scoped Topology

variable {X : Scheme} {f : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n f]
  {E : ClosedProjectiveEmbedding f}

local instance skodaIncCmpTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance skodaIncCmpCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n
local instance skodaIncCmpManifold [IsSeparated f] [QuasiCompact f] :
    IsComplexManifold n (SchemeComplexPoint f) := schemeAnalyticTN_isComplexManifold f n

variable {L : X.Modules} (H : SchemeLineBundleMetric f n E L) (a : LineBundleAtlas L)

/-! ### The norm of a finite family of sections -/

/-- `|w|²_{h^d} = ∑ⱼ |wⱼ|²_{h^d}` for a finite family `w` of sections of `L^d`. -/
def familyNormSq (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d) (p : SchemeComplexPoint f) :
    ℝ :=
  ∑ j, H.sectionNormSq a d (w j) p

/-- `log |w|²_{h^d}`, with value `-∞` at the common zeros of the `wⱼ`. In a local frame `e` of
`L`, `log |w|²_{h^d} = log ∑ⱼ |wⱼ,ₑ|² + d log |e|²_h` has the analytic singularities of the ideal
generated by the `wⱼ`. -/
def familyLog (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d) (p : SchemeComplexPoint f) :
    EReal :=
  ENNReal.log (ENNReal.ofReal (familyNormSq H a d w p))

theorem familyNormSq_nonneg (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d)
    (p : SchemeComplexPoint f) : 0 ≤ familyNormSq H a d w p :=
  Finset.sum_nonneg fun j _ => H.sectionNormSq_nonneg a d (w j) p

theorem continuous_familyNormSq (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d) :
    Continuous (familyNormSq H a d w) :=
  continuous_finsetSum _ fun j _ => continuous_sectionNormSq H a d (w j)

theorem continuous_familyLog (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d) :
    Continuous (familyLog H a d w) :=
  ENNReal.continuous_log.comp (ENNReal.continuous_ofReal.comp (continuous_familyNormSq H a d w))

theorem sectionNormSq_zero (k : ℕ) (p : SchemeComplexPoint f) :
    H.sectionNormSq a k (0 : SectionSpace f L k) p = 0 := by
  rw [← pointSeminorm_sq H a k p, map_zero]
  ring

/-- **Cauchy–Schwarz**: `|∑ⱼ cⱼ wⱼ|² ≤ (∑ⱼ |cⱼ|²) |w|²`. -/
theorem sectionNormSq_sum_smul_le (d : ℕ) {r : ℕ} (w : Fin r → SectionSpace f L d)
    (c : Fin r → ℂ) (p : SchemeComplexPoint f) :
    H.sectionNormSq a d (∑ j, c j • w j) p ≤ (∑ j, ‖c j‖ ^ 2) * familyNormSq H a d w p := by
  have h1 : pointSeminorm H a d p (∑ j, c j • w j) ≤
      ∑ j, ‖c j‖ * pointSeminorm H a d p (w j) := by
    refine (Finset.le_sum_of_subadditive (pointSeminorm H a d p) (map_zero _).le
      (map_add_le_add _) _ _).trans (le_of_eq ?_)
    simp only [map_smul_eq_mul]
  have h0 : 0 ≤ pointSeminorm H a d p (∑ j, c j • w j) := apply_nonneg _ _
  have h2 := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun j => ‖c j‖)
    (fun j => pointSeminorm H a d p (w j))
  rw [← pointSeminorm_sq H a d p]
  have hsq : ∀ j, pointSeminorm H a d p (w j) ^ 2 = H.sectionNormSq a d (w j) p :=
    fun j => pointSeminorm_sq H a d p (w j)
  simp only [hsq] at h2
  calc pointSeminorm H a d p (∑ j, c j • w j) ^ 2
      ≤ (∑ j, ‖c j‖ * pointSeminorm H a d p (w j)) ^ 2 := pow_le_pow_left₀ h0 h1 2
    _ ≤ _ := h2

/-! ### Powers of monomials -/

variable {G : SectionZFiltration f a}

/-- The squared norm of a monomial: `|g^e|² = ∏ᵢ |gᵢ|^{2eᵢ}`, as a section of `L^K`,
`K = ∑ eᵢ mᵢ`. -/
theorem sectionNormSq_secMonomial (R : ReesGenerators G) (h0 : G.piece 0 0 = ⊤)
    (e : Fin R.card → ℕ) {K : ℕ} (hK : R.degree e = K) (p : SchemeComplexPoint f) :
    H.sectionNormSq a K (SecRing.comp K (R.secMonomial e)) p =
      ∏ i, H.sectionNormSq a (R.deg i) (R.gen i) p ^ e i := by
  obtain ⟨s, hs, -, hν⟩ := R.exists_secMonomial_eq (Y := SchemeComplexPoint f)
    (fun D s p => H.sectionNormSq a D s p) (funext fun p => H.sectionNormSq_one a p)
    (fun D D' s t => funext fun p => by
      rw [SectionSpace.mul_apply]
      exact H.sectionNormSq_mul a D D' s t p) h0 e
  subst hK
  rw [hs, SecRing.comp_of_same]
  have := congrFun hν p
  simpa only [Finset.prod_apply, Pi.pow_apply] using this

/-! ### Linear combinations and normalized sections -/

/-- The bound `|s|^{2d} ≤ C ρ^K` passes to linear combinations. -/
theorem pow_le_of_mem_span {d K : ℕ} (hd : 0 < d) (ρ : SchemeComplexPoint f → ℝ)
    (hρ : ∀ p, 0 ≤ ρ p) (S : Set (SectionSpace f L K))
    (hS : ∀ t ∈ S, ∃ C : ℝ, ∀ p, H.sectionNormSq a K t p ^ d ≤ C * ρ p ^ K)
    {s : SectionSpace f L K} (hs : s ∈ Submodule.span ℂ S) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p, H.sectionNormSq a K s p ^ d ≤ C * ρ p ^ K := by
  induction hs using Submodule.span_induction with
  | mem t ht =>
    obtain ⟨C, hC⟩ := hS t ht
    refine ⟨max C 0, le_max_right _ _, fun p => (hC p).trans ?_⟩
    exact mul_le_mul_of_nonneg_right (le_max_left _ _) (pow_nonneg (hρ p) K)
  | zero =>
    refine ⟨0, le_rfl, fun p => ?_⟩
    rw [sectionNormSq_zero, zero_pow hd.ne', zero_mul]
  | add s t _ _ hs ht =>
    obtain ⟨C₁, hC₁0, hC₁⟩ := hs
    obtain ⟨C₂, hC₂0, hC₂⟩ := ht
    refine ⟨4 ^ d * (C₁ + C₂), by positivity, fun p => ?_⟩
    set u := H.sectionNormSq a K s p
    set v := H.sectionNormSq a K t p
    have hu : 0 ≤ u := H.sectionNormSq_nonneg a K s p
    have hv : 0 ≤ v := H.sectionNormSq_nonneg a K t p
    have hst : H.sectionNormSq a K (s + t) p ≤ 4 * max u v := by
      rw [← pointSeminorm_sq H a K p]
      have h1 := map_add_le_add (pointSeminorm H a K p) s t
      have h2 : pointSeminorm H a K p s ^ 2 = u := pointSeminorm_sq H a K p s
      have h3 : pointSeminorm H a K p t ^ 2 = v := pointSeminorm_sq H a K p t
      have hs0 : 0 ≤ pointSeminorm H a K p s := apply_nonneg _ _
      have ht0 : 0 ≤ pointSeminorm H a K p t := apply_nonneg _ _
      have hst0 : 0 ≤ pointSeminorm H a K p (s + t) := apply_nonneg _ _
      calc pointSeminorm H a K p (s + t) ^ 2
          ≤ (pointSeminorm H a K p s + pointSeminorm H a K p t) ^ 2 :=
            pow_le_pow_left₀ hst0 h1 2
        _ ≤ 2 * (pointSeminorm H a K p s ^ 2 + pointSeminorm H a K p t ^ 2) := by
            nlinarith [sq_nonneg (pointSeminorm H a K p s - pointSeminorm H a K p t)]
        _ = 2 * (u + v) := by rw [h2, h3]
        _ ≤ 4 * max u v := by
            have := le_max_left u v
            have := le_max_right u v
            linarith
    have hmax : max u v ^ d ≤ u ^ d + v ^ d := by
      rcases le_total u v with h | h
      · rw [max_eq_right h]; linarith [pow_nonneg hu d]
      · rw [max_eq_left h]; linarith [pow_nonneg hv d]
    calc H.sectionNormSq a K (s + t) p ^ d ≤ (4 * max u v) ^ d :=
          pow_le_pow_left₀ (H.sectionNormSq_nonneg a K _ p) hst d
      _ = 4 ^ d * max u v ^ d := mul_pow _ _ _
      _ ≤ 4 ^ d * (u ^ d + v ^ d) := mul_le_mul_of_nonneg_left hmax (by positivity)
      _ ≤ 4 ^ d * (C₁ * ρ p ^ K + C₂ * ρ p ^ K) :=
          mul_le_mul_of_nonneg_left (add_le_add (hC₁ p) (hC₂ p)) (by positivity)
      _ = 4 ^ d * (C₁ + C₂) * ρ p ^ K := by ring
  | smul c s _ hs =>
    obtain ⟨C, hC0, hC⟩ := hs
    refine ⟨Complex.normSq c ^ d * C, mul_nonneg (pow_nonneg (Complex.normSq_nonneg c) d) hC0,
      fun p => ?_⟩
    rw [H.sectionNormSq_smul a K c s p, mul_pow, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hC p) (pow_nonneg (Complex.normSq_nonneg c) d)

/-- `(∑ₗ zₗ)^m ≤ r^{m-1} ∑ₗ zₗ^m` for nonnegative `zₗ`, `m > 0`. -/
theorem sum_pow_le_card_mul {r : ℕ} (z : Fin r → ℝ) (hz : ∀ l, 0 ≤ z l) {m : ℕ} (hm : 0 < m) :
    (∑ l, z l) ^ m ≤ (r : ℝ) ^ (m - 1) * ∑ l, z l ^ m := by
  rcases Nat.eq_zero_or_pos r with hr | hr
  · subst hr
    simp [zero_pow hm.ne']
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  have h := pow_sum_div_card_le_sum_pow (s := (Finset.univ : Finset (Fin r)))
    (fun l _ => hz l) m'
  rw [Finset.card_univ, Fintype.card_fin] at h
  have hpos : (0 : ℝ) < (r : ℝ) ^ m' := pow_pos (Nat.cast_pos.mpr hr) m'
  rw [div_le_iff₀ hpos] at h
  simpa [mul_comm] using h

/-! ### The rounded monomials -/

/-- A section in `𝓕^μ_D`, `D = d`, `μ ≥ μ₀`, is bounded by `|w|²` if `w` spans `𝓕^{μ₀}_d`. -/
theorem exists_sectionNormSq_le_familyNormSq (G : SectionZFiltration f a) {d r : ℕ}
    (w : Fin r → SectionSpace f L d) {μ₀ : ℤ}
    (hw : ∀ t ∈ G.piece μ₀ d, ∃ c : Fin r → ℂ, t = ∑ j, c j • w j)
    {D : ℕ} (hD : D = d) {μ : ℤ} (hμ : μ₀ ≤ μ) (t : SectionSpace f L D) (ht : t ∈ G.piece μ D) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ p, H.sectionNormSq a D t p ≤ A * familyNormSq H a d w p := by
  subst hD
  obtain ⟨c, rfl⟩ := hw t (G.piece_anti hμ D ht)
  exact ⟨∑ j, ‖c j‖ ^ 2, Finset.sum_nonneg fun j _ => sq_nonneg _,
    sectionNormSq_sum_smul_le H a D w c⟩

/-- If `L^e` is globally generated, a basis `h` of `H⁰(X, L^e)` has `|h|² ≥ β > 0` on `X`. -/
theorem exists_pos_le_familyNormSq (e : ℕ)
    (hbpf : ∀ p : SchemeComplexPoint f, ∃ σ : SectionSpace f L e, H.sectionNormSq a e σ p ≠ 0) :
    ∃ (q : ℕ) (h : Fin q → SectionSpace f L e) (β : ℝ), 0 < β ∧
      ∀ p, β ≤ familyNormSq H a e h p := by
  have := SectionSpace.finiteDimensional f E a e
  set b := Module.finBasis ℂ (SectionSpace f L e)
  refine ⟨_, fun l => b l, ?_⟩
  have hpos : ∀ p, 0 < familyNormSq H a e (fun l => b l) p := by
    intro p
    obtain ⟨σ, hσ⟩ := hbpf p
    by_contra hle
    have h0 : familyNormSq H a e (fun l => b l) p = 0 :=
      le_antisymm (not_lt.mp hle) (familyNormSq_nonneg H a e _ p)
    have h1 := sectionNormSq_sum_smul_le H a e (fun l => b l) (fun l => b.repr σ l) p
    rw [b.sum_repr σ, h0, mul_zero] at h1
    exact hσ (le_antisymm h1 (H.sectionNormSq_nonneg a e σ p))
  rcases isEmpty_or_nonempty (SchemeComplexPoint f) with hX | hX
  · exact ⟨1, one_pos, fun p => (IsEmpty.false p).elim⟩
  · have : CompactSpace (SchemeComplexPoint f) := E.analyticCompact
    obtain ⟨p₀, -, hmin⟩ := isCompact_univ.exists_isMinOn Set.univ_nonempty
      (continuous_familyNormSq H a e (fun l => b l)).continuousOn
    exact ⟨_, hpos p₀, fun p => hmin (Set.mem_univ p)⟩

/-- **The monomial bound.** Let `g^e` be a monomial of degree `K` and weight `≥ Kτ`, `w` span
`𝓕^{⌈dτ''⌉}_d`, and `d` be large: `e₀ ≤ d` and
`e₀ |τ| + ∑ᵢ |μᵢ| + C (e₀ + ∑ᵢ mᵢ) ≤ d (τ - τ'')`, where `L^p` is globally generated for `p ≥ e₀`
and `𝓕^{-Cm}_m = H⁰(X, L^m)`. Then `|g^e|^{2d} ≤ C' |w|^{2K}` on `X`. -/
theorem monomial_pow_le (G : SectionZFiltration f a) (R : ReesGenerators G)
    [IsIntegral X] (h0 : G.piece 0 0 = ⊤)
    {CF : ℕ} (hCF : ∀ m : ℕ, 0 < m → G.piece (-((CF : ℤ) * m)) m = ⊤)
    {e₀ : ℕ} (he₀ : 0 < e₀)
    (hbpf : ∀ e : ℕ, e₀ ≤ e → ∀ p : SchemeComplexPoint f,
      ∃ σ : SectionSpace f L e, H.sectionNormSq a e σ p ≠ 0)
    {τ τ'' : ℝ} {d : ℕ} (hde : e₀ ≤ d)
    (hd : (e₀ : ℝ) * |τ| + ∑ i, |(R.wt i : ℝ)| + (CF : ℝ) * ((e₀ : ℝ) + ∑ i, (R.deg i : ℝ)) ≤
      (d : ℝ) * (τ - τ''))
    {r : ℕ} (w : Fin r → SectionSpace f L d)
    (hw : ∀ t ∈ G.piece ⌈(d : ℝ) * τ''⌉ d, ∃ c : Fin r → ℂ, t = ∑ j, c j • w j)
    {K : ℕ} (hK : 0 < K) (e : Fin R.card → ℕ) (hdeg : R.degree e = K)
    (hwt : (K : ℝ) * τ ≤ R.weight e) :
    ∃ C : ℝ, ∀ p, H.sectionNormSq a K (SecRing.comp K (R.secMonomial e)) p ^ d ≤
      C * familyNormSq H a d w p ^ K := by
  classical
  have hd0 : 0 < d := lt_of_lt_of_le he₀ hde
  simp only [sectionNormSq_secMonomial H a R h0 e hdeg]
  -- generators of degree zero and positive weight vanish
  have hzero_gen : ∀ (D : ℕ) (s : SectionSpace f L D) (μ : ℤ), D = 0 → 0 < μ →
      s ∈ G.piece μ D → s = 0 := by
    intro D s μ hD hμ hs
    subst hD
    rw [G.piece_zero_eq_bot_of_pos hμ] at hs
    exact (Submodule.mem_bot ℂ).mp hs
  by_cases hbad : ∃ i, R.deg i = 0 ∧ 0 < e i ∧ 0 < R.wt i
  · obtain ⟨i, hi0, hie, hiw⟩ := hbad
    have hgi : R.gen i = 0 := hzero_gen _ _ _ hi0 hiw (R.gen_mem i)
    refine ⟨0, fun p => ?_⟩
    have : ∏ j, H.sectionNormSq a (R.deg j) (R.gen j) p ^ e j = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ i) (by rw [hgi, sectionNormSq_zero, zero_pow hie.ne'])
    rw [this, zero_pow hd0.ne', zero_mul]
  push Not at hbad
  -- the rounded exponents
  set b : Fin R.card → ℕ := fun i => if 0 < R.deg i then ((d - e₀) * e i) / K else 0 with hb
  have hb1 : ∀ i, K * b i ≤ (d - e₀) * e i := by
    intro i
    simp only [hb]
    split_ifs
    · rw [mul_comm]; exact Nat.div_mul_le_self _ _
    · simp
  have hb2 : ∀ i, 0 < R.deg i → (d - e₀) * e i < K * b i + K := by
    intro i hi
    simp only [hb, if_pos hi]
    rw [mul_comm K]
    exact Nat.lt_div_mul_add hK
  have hb0 : ∀ i, R.deg i = 0 → b i = 0 := by
    intro i hi
    simp [hb, hi]
  have hbK : ∀ i, b i * K ≤ e i * d := by
    intro i
    have h1 := hb1 i
    have h2 : (d - e₀) * e i ≤ d * e i := Nat.mul_le_mul_right _ (Nat.sub_le d e₀)
    rw [mul_comm (b i), mul_comm (e i)]
    exact h1.trans h2
  -- the degree of the rounded monomial
  have hdeg1' : K * R.degree b ≤ (d - e₀) * R.degree e := by
    unfold ReesGenerators.degree
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    have := Nat.mul_le_mul_right (R.deg i) (hb1 i)
    calc K * (b i * R.deg i) = K * b i * R.deg i := by ring
      _ ≤ (d - e₀) * e i * R.deg i := this
      _ = (d - e₀) * (e i * R.deg i) := by ring
  have hdeg1 : K * R.degree b ≤ K * (d - e₀) := by
    rw [hdeg, mul_comm (d - e₀)] at hdeg1'
    exact hdeg1'
  have hdeg2' : (d - e₀) * R.degree e ≤ K * (R.degree b + ∑ i, R.deg i) := by
    unfold ReesGenerators.degree
    rw [← Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    rcases Nat.eq_zero_or_pos (R.deg i) with hi | hi
    · simp [hi]
    · have h := hb2 i hi
      have h' := Nat.mul_le_mul_right (R.deg i) h.le
      nlinarith
  have hdeg2 : K * (d - e₀) ≤ K * (R.degree b + ∑ i, R.deg i) := by
    rw [hdeg, mul_comm (d - e₀)] at hdeg2'
    exact hdeg2'
  have hdb : R.degree b ≤ d - e₀ := Nat.le_of_mul_le_mul_left hdeg1 hK
  have hdb2 : d - e₀ ≤ R.degree b + ∑ i, R.deg i := Nat.le_of_mul_le_mul_left hdeg2 hK
  set pad := d - R.degree b with hpad
  have hpad_d : R.degree b + pad = d := by omega
  have hpad_ge : e₀ ≤ pad := by omega
  have hpad_le : pad ≤ e₀ + ∑ i, R.deg i := by omega
  have hpad_pos : 0 < pad := lt_of_lt_of_le he₀ hpad_ge
  -- the weight of the rounded monomial
  have hdsub : ((d - e₀ : ℕ) : ℝ) = (d : ℝ) - e₀ := Nat.cast_sub hde
  have hKR : (0 : ℝ) < K := Nat.cast_pos.mpr hK
  have hterm : ∀ i, ((d : ℝ) - e₀) / K * ((e i : ℝ) * R.wt i) - |(R.wt i : ℝ)| ≤
      (b i : ℝ) * R.wt i := by
    intro i
    have hq0 : 0 ≤ ((d : ℝ) - e₀) / K := by
      apply div_nonneg _ hKR.le
      rw [← hdsub]; exact Nat.cast_nonneg _
    rcases Nat.eq_zero_or_pos (R.deg i) with hi | hi
    · rw [hb0 i hi, Nat.cast_zero, zero_mul]
      rcases Nat.eq_zero_or_pos (e i) with he | he
      · rw [he, Nat.cast_zero, zero_mul, mul_zero, zero_sub, neg_nonpos]
        exact abs_nonneg _
      · have hw0 : (R.wt i : ℝ) ≤ 0 := by exact_mod_cast hbad i hi he
        have : ((d : ℝ) - e₀) / K * ((e i : ℝ) * R.wt i) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos hq0
            (mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) hw0)
        linarith [abs_nonneg (R.wt i : ℝ)]
    · have h1 : (K : ℝ) * b i ≤ ((d : ℝ) - e₀) * e i := by
        rw [← hdsub]; exact_mod_cast hb1 i
      have h2 : ((d : ℝ) - e₀) * e i < K * b i + K := by
        rw [← hdsub]; exact_mod_cast hb2 i hi
      set q : ℝ := ((d : ℝ) - e₀) / K * e i with hq
      have hbq : (b i : ℝ) ≤ q := by
        rw [hq, div_mul_eq_mul_div, le_div_iff₀ hKR]; linarith
      have hqb : q < b i + 1 := by
        rw [hq, div_mul_eq_mul_div, div_lt_iff₀ hKR]; linarith
      have hrw : ((d : ℝ) - e₀) / K * ((e i : ℝ) * R.wt i) = q * R.wt i := by
        rw [hq]; ring
      rw [hrw]
      rcases le_total 0 (R.wt i : ℝ) with hw | hw
      · rw [abs_of_nonneg hw]; nlinarith
      · rw [abs_of_nonpos hw]; nlinarith
  have hwb : ((d : ℝ) - e₀) * τ - ∑ i, |(R.wt i : ℝ)| ≤ (R.weight b : ℝ) := by
    have hsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => hterm i
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum] at hsum
    have hwe : (K : ℝ) * τ ≤ ∑ i, (e i : ℝ) * R.wt i := by
      refine hwt.trans (le_of_eq ?_)
      unfold ReesGenerators.weight
      push_cast
      rfl
    have hq0 : 0 ≤ ((d : ℝ) - e₀) / K := by
      apply div_nonneg _ hKR.le
      rw [← hdsub]; exact Nat.cast_nonneg _
    have h3 : ((d : ℝ) - e₀) * τ ≤ ((d : ℝ) - e₀) / K * ∑ i, (e i : ℝ) * R.wt i := by
      calc ((d : ℝ) - e₀) * τ = ((d : ℝ) - e₀) / K * ((K : ℝ) * τ) := by
            field_simp
        _ ≤ _ := mul_le_mul_of_nonneg_left hwe hq0
    have hwbR : (R.weight b : ℝ) = ∑ i, (b i : ℝ) * R.wt i := by
      unfold ReesGenerators.weight
      push_cast
      rfl
    rw [hwbR]
    linarith
  have hceil : ⌈(d : ℝ) * τ''⌉ ≤ R.weight b + -((CF : ℤ) * pad) := by
    rw [Int.ceil_le]
    have hpadR : (pad : ℝ) ≤ e₀ + ∑ i, (R.deg i : ℝ) := by exact_mod_cast hpad_le
    have hCF0 : (0 : ℝ) ≤ CF := Nat.cast_nonneg _
    have habs : -(e₀ : ℝ) * |τ| ≤ -(e₀ : ℝ) * τ := by
      have := le_abs_self τ
      nlinarith [(Nat.cast_nonneg e₀ : (0 : ℝ) ≤ e₀)]
    push_cast
    nlinarith [mul_le_mul_of_nonneg_left hpadR hCF0]
  -- the rounded monomial `g^b` and its products with the sections of `L^pad`
  obtain ⟨sb, -, hsbmem, hsbν⟩ := R.exists_secMonomial_eq (Y := SchemeComplexPoint f)
    (fun D s p => H.sectionNormSq a D s p) (funext fun p => H.sectionNormSq_one a p)
    (fun D D' s t => funext fun p => by
      rw [SectionSpace.mul_apply]
      exact H.sectionNormSq_mul a D D' s t p) h0 b
  have hsbnorm : ∀ p, H.sectionNormSq a (R.degree b) sb p =
      ∏ i, H.sectionNormSq a (R.deg i) (R.gen i) p ^ b i := by
    intro p
    have := congrFun hsbν p
    simpa only [Finset.prod_apply, Pi.pow_apply] using this
  obtain ⟨q, h, β, hβ, hβle⟩ := exists_pos_le_familyNormSq H a pad (hbpf pad hpad_ge)
  have hA : ∀ l : Fin q, ∃ A : ℝ, 0 ≤ A ∧ ∀ p,
      H.sectionNormSq a (R.degree b + pad) (SectionSpace.mul f a _ _ sb (h l)) p ≤
        A * familyNormSq H a d w p := by
    intro l
    have hl : h l ∈ G.piece (-((CF : ℤ) * pad)) pad := by
      rw [hCF pad hpad_pos]; exact Submodule.mem_top
    exact exists_sectionNormSq_le_familyNormSq H a G w hw hpad_d hceil _
      (G.mul_mem _ _ _ _ sb (h l) hsbmem hl)
  choose A hA0 hAle using hA
  set A' : ℝ := (∑ l, A l) / β with hA'
  have hA'0 : 0 ≤ A' := div_nonneg (Finset.sum_nonneg fun l _ => hA0 l) hβ.le
  have hsb_le : ∀ p, H.sectionNormSq a (R.degree b) sb p ≤ A' * familyNormSq H a d w p := by
    intro p
    have h1 : H.sectionNormSq a (R.degree b) sb p * familyNormSq H a pad h p ≤
        (∑ l, A l) * familyNormSq H a d w p := by
      unfold familyNormSq
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_le_sum fun l _ => ?_
      have := hAle l p
      rw [SectionSpace.mul_apply, H.sectionNormSq_mul] at this
      exact this
    have h2 : H.sectionNormSq a (R.degree b) sb p * β ≤
        H.sectionNormSq a (R.degree b) sb p * familyNormSq H a pad h p :=
      mul_le_mul_of_nonneg_left (hβle p) (H.sectionNormSq_nonneg a _ sb p)
    rw [hA', div_mul_eq_mul_div, le_div_iff₀ hβ]
    linarith
  -- bounds for the generators
  have hB : ∀ i, ∃ B : ℝ, 0 < B ∧ ∀ p, H.sectionNormSq a (R.deg i) (R.gen i) p ≤ B :=
    fun i => H.exists_sectionNormSq_le a (R.deg i) (R.gen i)
  choose B hB0 hBle using hB
  refine ⟨A' ^ K * ∏ i, B i ^ (e i * d - b i * K), fun p => ?_⟩
  set y : Fin R.card → ℝ := fun i => H.sectionNormSq a (R.deg i) (R.gen i) p
  have hy0 : ∀ i, 0 ≤ y i := fun i => H.sectionNormSq_nonneg a _ _ p
  have hsplit : (∏ i, y i ^ e i) ^ d =
      (∏ i, y i ^ b i) ^ K * ∏ i, y i ^ (e i * d - b i * K) := by
    rw [← Finset.prod_pow, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [← pow_mul, ← pow_mul, ← pow_add, Nat.add_sub_cancel' (hbK i)]
  change (∏ i, y i ^ e i) ^ d ≤ _
  rw [hsplit]
  have hprod : ∏ i, y i ^ (e i * d - b i * K) ≤ ∏ i, B i ^ (e i * d - b i * K) :=
    Finset.prod_le_prod (fun i _ => pow_nonneg (hy0 i) _)
      (fun i _ => pow_le_pow_left₀ (hy0 i) (hBle i p) _)
  have hmon : (∏ i, y i ^ b i) ^ K ≤ (A' * familyNormSq H a d w p) ^ K := by
    refine pow_le_pow_left₀ (Finset.prod_nonneg fun i _ => pow_nonneg (hy0 i) _) ?_ K
    rw [← hsbnorm p]
    exact hsb_le p
  calc (∏ i, y i ^ b i) ^ K * ∏ i, y i ^ (e i * d - b i * K)
      ≤ (A' * familyNormSq H a d w p) ^ K * ∏ i, B i ^ (e i * d - b i * K) :=
        mul_le_mul hmon hprod (Finset.prod_nonneg fun i _ => pow_nonneg (hy0 i) _)
          (pow_nonneg (mul_nonneg hA'0 (familyNormSq_nonneg H a d w p)) K)
    _ = A' ^ K * (∏ i, B i ^ (e i * d - b i * K)) * familyNormSq H a d w p ^ K := by
        rw [mul_pow]; ring

variable [IsIntegral X]

/-- **Uniformity over the normalized sections.** If every `s ∈ 𝓕^{Kτ}_K` satisfies
`|s|^{2d} ≤ C_s ρ^K`, then one constant works for all `s ∈ 𝓕^{Kτ}_K` with
`sup_X |s|²_{h^K} ≤ 1` (the sup norm is a norm on the finite-dimensional `H⁰(X, L^K)`). -/
theorem exists_normalized_pow_le [Nonempty (SchemeComplexPoint f)] (F : SectionFiltration f a)
    {K d : ℕ} (hd : 0 < d) (τ : ℝ) (ρ : SchemeComplexPoint f → ℝ)
    (hV : ∀ s ∈ F.piece ((K : ℝ) * τ) K, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, H.sectionNormSq a K s p ^ d ≤ C * ρ p ^ K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s ∈ F.normalizedSections H K τ, ∀ p,
      H.sectionNormSq a K s p ^ d ≤ C * ρ p ^ K := by
  classical
  have := SectionSpace.finiteDimensional f E a K
  set V := F.piece ((K : ℝ) * τ) K
  set bV := Module.finBasis ℂ V
  set r := Module.finrank ℂ V
  have hC : ∀ l : Fin r, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, H.sectionNormSq a K (bV l : SectionSpace f L K) p ^ d ≤ C * ρ p ^ K :=
    fun l => hV _ (bV l).2
  choose C hC0 hCle using hC
  -- bounded coordinates on the compact set of normalized sections
  have hB : ∀ l : Fin r, ∃ B : ℝ, 0 ≤ B ∧ ∀ s ∈ F.normalizedSections H K τ,
      ∀ hs : s ∈ V, ‖bV.coord l ⟨s, hs⟩‖ ≤ B := by
    intro l
    obtain ⟨g, hg⟩ := LinearMap.exists_extend (bV.coord l)
    have hcont : Continuous (g ∘ₗ (coordEquiv E a K).toLinearMap) :=
      LinearMap.continuous_of_finiteDimensional _
    obtain ⟨B, hBle⟩ := (F.isCompact_coord_normalizedSections H K τ).exists_bound_of_continuousOn
      hcont.continuousOn
    refine ⟨max B 0, le_max_right _ _, fun s hs hsV => ?_⟩
    have hgs : bV.coord l ⟨s, hsV⟩ = g s := by
      rw [← hg]
      rfl
    have hpre : (coordEquiv E a K).symm s ∈ coordEquiv E a K ⁻¹' F.normalizedSections H K τ := by
      change coordEquiv E a K ((coordEquiv E a K).symm s) ∈ F.normalizedSections H K τ
      rw [LinearEquiv.apply_symm_apply]
      exact hs
    have := hBle _ hpre
    rw [hgs]
    refine (le_of_eq ?_).trans (this.trans (le_max_left _ _))
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
  choose B hB0 hBle using hB
  refine ⟨(r : ℝ) ^ (2 * d - 1) * ∑ l, B l ^ (2 * d) * C l, ?_, fun s hs p => ?_⟩
  · exact mul_nonneg (pow_nonneg (Nat.cast_nonneg _) _)
      (Finset.sum_nonneg fun l _ => mul_nonneg (pow_nonneg (hB0 l) _) (hC0 l))
  have hsV : s ∈ V := hs.1
  have hrepr : s = ∑ l, bV.coord l ⟨s, hsV⟩ • (bV l : SectionSpace f L K) := by
    have h := bV.sum_repr ⟨s, hsV⟩
    have h' := congrArg (Subtype.val : V → SectionSpace f L K) h
    rw [Submodule.coe_sum] at h'
    simp only [Submodule.coe_smul] at h'
    exact h'.symm
  set q : Fin r → ℝ := fun l => pointSeminorm H a K p (bV l : SectionSpace f L K)
  have hq0 : ∀ l, 0 ≤ q l := fun l => apply_nonneg _ _
  have hps : pointSeminorm H a K p s ≤ ∑ l, B l * q l := by
    conv_lhs => rw [hrepr]
    refine (Finset.le_sum_of_subadditive (pointSeminorm H a K p) (map_zero _).le
      (map_add_le_add _) _ _).trans (Finset.sum_le_sum fun l _ => ?_)
    rw [map_smul_eq_mul]
    exact mul_le_mul_of_nonneg_right (hBle l s hs hsV) (hq0 l)
  have hd2 : 0 < 2 * d := by omega
  have hq : ∀ l, q l ^ (2 * d) ≤ C l * ρ p ^ K := by
    intro l
    rw [pow_mul, pointSeminorm_sq]
    exact hCle l p
  calc H.sectionNormSq a K s p ^ d = pointSeminorm H a K p s ^ (2 * d) := by
        rw [pow_mul, pointSeminorm_sq]
    _ ≤ (∑ l, B l * q l) ^ (2 * d) := pow_le_pow_left₀ (apply_nonneg _ _) hps _
    _ ≤ (r : ℝ) ^ (2 * d - 1) * ∑ l, (B l * q l) ^ (2 * d) :=
        sum_pow_le_card_mul _ (fun l => mul_nonneg (hB0 l) (hq0 l)) hd2
    _ ≤ (r : ℝ) ^ (2 * d - 1) * ∑ l, B l ^ (2 * d) * (C l * ρ p ^ K) := by
        refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun l _ => ?_)
          (pow_nonneg (Nat.cast_nonneg _) _)
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_left (hq l) (pow_nonneg (hB0 l) _)
    _ = (r : ℝ) ^ (2 * d - 1) * (∑ l, B l ^ (2 * d) * C l) * ρ p ^ K := by
        rw [mul_assoc, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl fun l _ => ?_
        ring

/-- **From powers to the normalized potential**: if `|s|^{2d} ≤ C |w|^{2K}` for all
sup-normalized `s ∈ 𝓕^{Kτ}_K`, then `K⁻¹ Γ^{𝓕,K}_τ ≤ d⁻¹ log |w|² + C'`. -/
theorem normalizedPotential_le_of_pow_le (F : SectionFiltration f a) {K d : ℕ} (hK : 0 < K)
    (hd : 0 < d) (τ : ℝ) {r : ℕ} (w : Fin r → SectionSpace f L d) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ s ∈ F.normalizedSections H K τ, ∀ p,
      H.sectionNormSq a K s p ^ d ≤ C * familyNormSq H a d w p ^ K) (p : SchemeComplexPoint f) :
    F.normalizedPotential H K τ p ≤
      (((d : ℝ)⁻¹ : ℝ) : EReal) * familyLog H a d w p +
        ((Real.log (C + 1) / ((d : ℝ) * K) : ℝ) : EReal) := by
  have hKR : (0 : ℝ) < K := Nat.cast_pos.mpr hK
  have hdR : (0 : ℝ) < d := Nat.cast_pos.mpr hd
  have hC1 : (0 : ℝ) < C + 1 := by linarith
  unfold SectionFiltration.normalizedPotential
  rw [EReal.div_le_iff_le_mul (EReal.coe_pos.mpr hKR) (EReal.coe_ne_top _),
    ThetaPshConvexCombination.coe_mul_add_coe hKR]
  rw [F.sectionPotential_eq_raw H K τ]
  refine iSup_le fun s => ?_
  set A := H.sectionLogNormSq a K s.1 p
  set Lw := familyLog H a d w p
  -- the inequality `d log |s|² ≤ log (C + 1) + K log |w|²`
  have hpow : ENNReal.ofReal (H.sectionNormSq a K s.1 p) ^ d ≤
      ENNReal.ofReal (C + 1) * ENNReal.ofReal (familyNormSq H a d w p) ^ K := by
    rw [← ENNReal.ofReal_pow (H.sectionNormSq_nonneg a K s.1 p),
      ← ENNReal.ofReal_pow (familyNormSq_nonneg H a d w p), ← ENNReal.ofReal_mul hC1.le]
    refine ENNReal.ofReal_le_ofReal ((hC s.1 s.2 p).trans ?_)
    exact mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg (familyNormSq_nonneg H a d w p) K)
  have hlog := ENNReal.log_le_log hpow
  rw [ENNReal.log_pow, ENNReal.log_mul_add, ENNReal.log_pow,
    ENNReal.log_ofReal_of_pos hC1] at hlog
  change (d : EReal) * A ≤ ((Real.log (C + 1) : ℝ) : EReal) + (K : EReal) * Lw at hlog
  -- divide by `d`
  have hdiv := mul_le_mul_of_nonneg_left hlog (EReal.coe_nonneg.mpr (inv_pos.mpr hdR).le)
  have hlhs : (((d : ℝ)⁻¹ : ℝ) : EReal) * ((d : EReal) * A) = A := by
    rw [← mul_assoc, show (d : EReal) = ((d : ℝ) : EReal) from rfl, ← EReal.coe_mul,
      inv_mul_cancel₀ hdR.ne', EReal.coe_one, one_mul]
  rw [hlhs, add_comm, ThetaPshConvexCombination.coe_mul_add_coe (inv_pos.mpr hdR)] at hdiv
  refine hdiv.trans (le_of_eq ?_)
  have hKc : (K : EReal) = ((K : ℝ) : EReal) := rfl
  rw [hKc, mul_left_comm]
  congr 1
  congr 1
  field_simp

/-- **The obstacle bound at a fixed level** (hypotheses of `monomial_pow_le`): for every `K > 0`,
`K⁻¹ Γ^{𝓕,K}_τ ≤ d⁻¹ log |w|² + B_K` on `X`, where `𝓕 = G.fgFiltration`. -/
theorem normalizedPotential_le_familyLog [Nonempty (SchemeComplexPoint f)]
    (G : SectionZFiltration f a) (hG : G.IsFinitelyGenerated) (h0 : G.piece 0 0 = ⊤)
    (R : ReesGenerators G)
    {CF : ℕ} (hCF : ∀ m : ℕ, 0 < m → G.piece (-((CF : ℤ) * m)) m = ⊤)
    {e₀ : ℕ} (he₀ : 0 < e₀)
    (hbpf : ∀ e : ℕ, e₀ ≤ e → ∀ p : SchemeComplexPoint f,
      ∃ σ : SectionSpace f L e, H.sectionNormSq a e σ p ≠ 0)
    {τ τ'' : ℝ} {d : ℕ} (hde : e₀ ≤ d)
    (hd : (e₀ : ℝ) * |τ| + ∑ i, |(R.wt i : ℝ)| + (CF : ℝ) * ((e₀ : ℝ) + ∑ i, (R.deg i : ℝ)) ≤
      (d : ℝ) * (τ - τ''))
    {r : ℕ} (w : Fin r → SectionSpace f L d)
    (hw : ∀ t ∈ G.piece ⌈(d : ℝ) * τ''⌉ d, ∃ c : Fin r → ℂ, t = ∑ j, c j • w j)
    {K : ℕ} (hK : 0 < K) :
    ∃ B : ℝ, ∀ p, (G.fgFiltration hG h0).normalizedPotential H K τ p ≤
      (((d : ℝ)⁻¹ : ℝ) : EReal) * familyLog H a d w p + (B : EReal) := by
  have hd0 : 0 < d := lt_of_lt_of_le he₀ hde
  set F := G.fgFiltration hG h0
  have hV : ∀ s ∈ F.piece ((K : ℝ) * τ) K, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, H.sectionNormSq a K s p ^ d ≤ C * familyNormSq H a d w p ^ K := by
    intro s hs
    have hs' : s ∈ G.piece ⌈(K : ℝ) * τ⌉ K := hs
    refine pow_le_of_mem_span H a hd0 _ (familyNormSq_nonneg H a d w) _ ?_
      (R.mem_span_secMonomial h0 hs')
    rintro t ⟨e, hwt, hdeg, rfl⟩
    refine monomial_pow_le H a G R h0 hCF he₀ hbpf hde hd w hw hK e hdeg ?_
    rw [hwt]
    exact Int.le_ceil _
  obtain ⟨C, hC0, hC⟩ := exists_normalized_pow_le H a F hd0 τ (familyNormSq H a d w) hV
  exact ⟨_, normalizedPotential_le_of_pow_le H a F hK hd0 τ w hC0 hC⟩

end SGPT.TestCurve.SkodaInc
