import SGPT.TestCurve.TCLinCoordinates
import Mathlib.AlgebraicGeometry.Morphisms.Flat

/-!
# Regular functions on the charts of a closed embedding into `ℙᴺ × 𝔸¹`

Let `ι : 𝓨 ⟶ ℙᴺ_ℂ` and `π : 𝓨 ⟶ 𝔸¹` be such that `(ι, π) : 𝓨 ⟶ ℙᴺ_ℂ ×_ℂ 𝔸¹` is a
closed immersion (the relative very ampleness `TCEnc.TestConfiguration.IsAmple`). Then every
regular function on the chart `𝓨_i = ι⁻¹(D₊(X_i))` is a polynomial, with complex coefficients,
in `t = π^♯(t)` and the pulled-back ratios `ι^♯(X_j / X_i)` (`exists_mvPolynomial_chart`).

Proof: `V_i = D₊(X_i) ×_ℂ 𝔸¹` is affine and `Γ(V_i)` is the pushout (tensor product)
`Γ(D₊(X_i)) ⊗_ℂ ℂ[t]` (Mathlib's `isIso_pushoutSection_of_isAffineOpen`), hence generated by the
two factors (`mem_closure_of_isPushout`); a closed immersion is surjective on the sections over
affine opens (`Scheme.Hom.app_surjective`); `Γ(D₊(X_i))` is generated by the ratios over the
constants (`awayToSection_algebraMap`, `mem_closure_coordinateOpen`), and `ℂ[t]` by `t`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.TCLin

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry SGPT.Foundations.Schemes Opposite
open SGPT.TestCurve.TCEnc

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### Pushouts of rings are generated by the two factors -/

/-- In a pushout square of commutative rings the target is generated, as a ring, by the images
of the two factors. -/
theorem mem_closure_of_isPushout {A B C P : CommRingCat.{0}} {f : A ⟶ B} {g : A ⟶ C}
    {inl : B ⟶ P} {inr : C ⟶ P} (h : IsPushout f g inl inr) (x : P) :
    x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
  let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
  let inl' : B ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inl.hom.codRestrict S fun b => Subring.subset_closure (Or.inl ⟨b, rfl⟩))
  let inr' : C ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inr.hom.codRestrict S fun c => Subring.subset_closure (Or.inr ⟨c, rfl⟩))
  have w : f ≫ inl' = g ≫ inr' := by
    ext a
    change inl.hom (f.hom a) = inr.hom (g.hom a)
    exact congrArg (fun φ : A ⟶ P => φ.hom a) h.w
  let φ := h.desc inl' inr' w
  let ι : CommRingCat.of S ⟶ P := CommRingCat.ofHom S.subtype
  have hφ : φ ≫ ι = 𝟙 P := by
    apply h.hom_ext
    · rw [IsPushout.inl_desc_assoc, Category.comp_id]
      rfl
    · rw [IsPushout.inr_desc_assoc, Category.comp_id]
      rfl
  have hx := congrArg (fun ψ : P ⟶ P => ψ.hom x) hφ
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, CommRingCat.hom_id,
    RingHom.id_apply] at hx
  rw [← hx]
  exact (φ.hom x).2

/-! ### Generators of the coordinate charts of `ℙᴺ` -/

theorem appLE_congr_hom {A B : Scheme.{0}} {g g' : A ⟶ B} (h : g = g') (U : B.Opens)
    (V : A.Opens) (e : V ≤ g ⁻¹ᵁ U) (e' : V ≤ g' ⁻¹ᵁ U) : g.appLE U V e = g'.appLE U V e' := by
  subst h
  rfl

theorem le_preimage_top {A B : Scheme.{0}} (g : A ⟶ B) (V : A.Opens) : V ≤ g ⁻¹ᵁ ⊤ :=
  fun _ _ => trivial

variable (N : ℕ)

/-- The constants of the chart ring `(ℂ[X]_{X_i})₀` are the constants of the structure morphism. -/
theorem awayToSection_algebraMap (i : Fin (N + 1)) (c : ℂ) :
    (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ℂ)
        (MvPolynomial.X i)).hom (algebraMap ℂ (polynomialProjCoordinateRing ℂ N i) c) =
      (polynomialProjStructureMap ℂ N).appLE ⊤ (polynomialProjCoordinateOpen ℂ N i)
        (le_preimage_top _ _) ((Scheme.ΓSpecIso (.of ℂ)).inv c) := by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ℂ
  let U := polynomialProjCoordinateOpen ℂ N i
  let φ := Proj.basicOpenToSpec 𝒜 (MvPolynomial.X i)
  have hφ := Proj.basicOpenToSpec_app_top 𝒜 (MvPolynomial.X i)
  have key : ∀ a, (Proj.awayToSection 𝒜 (MvPolynomial.X i)).hom a =
      U.topIso.hom (φ.appTop ((Scheme.ΓSpecIso _).inv a)) := by
    intro a
    have h2 : φ.appTop ((Scheme.ΓSpecIso _).inv a) =
        U.topIso.inv ((Proj.awayToSection 𝒜 (MvPolynomial.X i)).hom a) := by
      change (φ.app ⊤) _ = _
      rw [hφ]
      simp
      rfl
    rw [h2, CategoryTheory.Iso.inv_hom_id_apply]
  have hstr : φ ≫ Spec.map (CommRingCat.ofHom (algebraMap ℂ (polynomialProjCoordinateRing ℂ N i))) =
      U.ι ≫ polynomialProjStructureMap ℂ N := by
    have h1 := polynomialProjCoordinateImmersion_structure ℂ N i
    have h2 : φ ≫ polynomialProjCoordinateImmersion ℂ N i = U.ι := by
      change (Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X i) (MvPolynomial.isHomogeneous_X ℂ i)
        (by decide)).hom ≫ ((Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X i)
        (MvPolynomial.isHomogeneous_X ℂ i) (by decide)).inv ≫ U.ι) = U.ι
      rw [Iso.hom_inv_id_assoc]
    rw [← h2, Category.assoc, h1]
    rfl
  have hn := congrArg (fun ψ => ψ.hom c)
    (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (algebraMap ℂ (polynomialProjCoordinateRing ℂ N i))))
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom] at hn
  rw [key, hn]
  have e1 : φ.appTop ((Spec.map (CommRingCat.ofHom
      (algebraMap ℂ (polynomialProjCoordinateRing ℂ N i)))).appTop
        ((Scheme.ΓSpecIso (.of ℂ)).inv c)) =
      (U.ι ≫ polynomialProjStructureMap ℂ N).appTop ((Scheme.ΓSpecIso (.of ℂ)).inv c) := by
    rw [← hstr]
    rfl
  rw [e1, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, Scheme.Opens.ι_appTop,
    Scheme.Opens.topIso_hom, ← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- **`Γ(D₊(X_i))` is generated by the ratios `X_j / X_i` over the constants.** -/
theorem mem_closure_coordinateOpen (i : Fin (N + 1))
    (b : Γ(polynomialProj ℂ N, polynomialProjCoordinateOpen ℂ N i)) :
    b ∈ Subring.closure (Set.range ((polynomialProjStructureMap ℂ N).appLE ⊤
        (polynomialProjCoordinateOpen ℂ N i) (le_preimage_top _ _)).hom ∪
      Set.range (fun j => polynomialProjCoordinateRegularRatio ℂ N i j)) := by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ℂ
  let σ := (Proj.awayToSection 𝒜 (MvPolynomial.X i)).hom
  have hbij : Function.Surjective σ := (homogeneousPolynomialBasicOpenAwayEquiv i).surjective
  obtain ⟨a, rfl⟩ := hbij b
  rw [← polynomialProjRatioMap_coordinateDehomogenization ℂ N i a]
  generalize polynomialProjCoordinateDehomogenization ℂ N i a = p
  induction p using MvPolynomial.induction_on with
  | C c =>
    rw [polynomialProjRatioMap, MvPolynomial.aeval_C]
    exact Subring.subset_closure (Or.inl ⟨_, (awayToSection_algebraMap N i c).symm⟩)
  | add p q hp hq =>
    rw [map_add, map_add]
    exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul, map_mul]
    refine mul_mem hp (Subring.subset_closure (Or.inr ⟨i.succAbove j, ?_⟩))
    simp [polynomialProjRatioMap, polynomialProjCoordinateRegularRatio,
      polynomialProjCoordinateSectionMap]
    rfl

/-- `Γ(𝔸¹) = ℂ[t]` is generated by `t` over the constants. -/
theorem mem_closure_affineLine (y : Γ(AffineLine, ⊤)) :
    y ∈ Subring.closure (Set.range affineLineToBase.appTop.hom ∪ {coordT}) := by
  obtain ⟨p, rfl⟩ : ∃ p, (Scheme.ΓSpecIso (.of (Polynomial ℂ))).inv p = y :=
    ⟨(Scheme.ΓSpecIso (.of (Polynomial ℂ))).hom y, by simp⟩
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | monomial n c =>
    rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
    have hX : (Scheme.ΓSpecIso (.of (Polynomial ℂ))).inv Polynomial.X ∈
        Subring.closure (Set.range affineLineToBase.appTop.hom ∪ {coordT}) :=
      Subring.subset_closure (Set.mem_union_right _ (Set.mem_singleton_iff.mpr rfl))
    refine mul_mem (Subring.subset_closure (Or.inl ⟨(Scheme.ΓSpecIso (.of ℂ)).inv c, ?_⟩))
      (pow_mem hX _)
    have hn := congrArg (fun ψ => ψ.hom c)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (Polynomial.C : ℂ →+* Polynomial ℂ)))
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
      CommRingCat.hom_ofHom] at hn
    exact hn.symm

/-! ### Charts of a closed embedding into `ℙᴺ × 𝔸¹` -/

variable {N} {Y : Scheme.{0}} (ι : Y ⟶ polynomialProj ℂ N) (π : Y ⟶ AffineLine)
  (hι : ι ≫ polynomialProjStructureMap ℂ N = π ≫ affineLineToBase)

/-- **Regular functions on a chart of a closed embedding `(ι, π) : 𝓨 ↪ ℙᴺ × 𝔸¹`** lie in the
ring generated by `ι^♯ Γ(D₊(X_i))` and `π^♯ Γ(𝔸¹)`. -/
theorem mem_closure_chart [IsClosedImmersion (pullback.lift ι π hι)] (i : Fin (N + 1))
    (g : Γ(Y, ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)) :
    g ∈ Subring.closure (Set.range (ι.app (polynomialProjCoordinateOpen ℂ N i)).hom ∪
      Set.range (π.appLE ⊤ (ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)
        (le_preimage_top _ _)).hom) := by
  classical
  let U := polynomialProjCoordinateOpen ℂ N i
  let str := polynomialProjStructureMap ℂ N
  let Ψ := pullback.lift ι π hι
  have H : IsPullback (pullback.fst str affineLineToBase) (pullback.snd str affineLineToBase)
      str affineLineToBase := IsPullback.of_hasPullback _ _
  let V : (pullback str affineLineToBase).Opens :=
    pullback.fst str affineLineToBase ⁻¹ᵁ U ⊓ pullback.snd str affineLineToBase ⁻¹ᵁ ⊤
  have hUST : (⊤ : AffineLine.Opens) ≤ affineLineToBase ⁻¹ᵁ ⊤ := le_preimage_top _ _
  have hUSX : U ≤ str ⁻¹ᵁ ⊤ := le_preimage_top _ _
  have hUS : IsAffineOpen (⊤ : (Spec (.of ℂ)).Opens) := isAffineOpen_top _
  have hUT : IsAffineOpen (⊤ : AffineLine.Opens) := isAffineOpen_top _
  have hUX : IsAffineOpen U := polynomialProjCoordinateOpen_isAffine ℂ N i
  have hpush := (isIso_pushoutSection_iff H hUST hUSX (UY := V) rfl).mp
    (isIso_pushoutSection_of_isAffineOpen H hUST hUSX rfl hUS hUT hUX)
  have hV : IsAffineOpen V := by
    have : IsAffine (⊤ : (Spec (.of ℂ)).Opens).toScheme := hUS
    have : IsAffine (⊤ : AffineLine.Opens).toScheme := hUT
    have : IsAffine U.toScheme := hUX
    exact .of_isIso (Scheme.Hom.isPullback_resLE H hUST hUSX rfl).isoPullback.hom
  have hpre : Ψ ⁻¹ᵁ V = ι ⁻¹ᵁ U := by
    ext x
    simp only [V, Scheme.Hom.preimage_inf, SetLike.mem_coe, TopologicalSpace.Opens.mem_inf]
    change (Ψ ≫ pullback.fst str affineLineToBase) x ∈ U ∧
      (Ψ ≫ pullback.snd str affineLineToBase) x ∈ (⊤ : AffineLine.Opens) ↔ ι x ∈ U
    rw [pullback.lift_fst, pullback.lift_snd]
    simp
  let ψ : Γ(pullback str affineLineToBase, V) →+* Γ(Y, ι ⁻¹ᵁ U) :=
    (Ψ.appLE V (ι ⁻¹ᵁ U) hpre.ge).hom
  have hψ : Function.Surjective ψ := by
    intro g
    obtain ⟨b, hb⟩ := Ψ.app_surjective V hV (Y.presheaf.map (eqToHom hpre).op g)
    refine ⟨b, ?_⟩
    change (Ψ.app V ≫ Y.presheaf.map (homOfLE hpre.ge).op) b = g
    rw [CommRingCat.comp_apply, hb, ← CommRingCat.comp_apply, ← Functor.map_comp]
    have : (eqToHom hpre).op ≫ (homOfLE hpre.ge).op = 𝟙 (op (ι ⁻¹ᵁ U)) := Subsingleton.elim _ _
    rw [this, CategoryTheory.Functor.map_id]
    rfl
  obtain ⟨b, hgb⟩ := hψ g
  rw [← hgb]
  have hb := mem_closure_of_isPushout hpush b
  have hmap : ψ b ∈ (Subring.closure _).map ψ := Subring.mem_map.mpr ⟨b, hb, rfl⟩
  rw [RingHom.map_closure] at hmap
  refine Subring.closure_mono ?_ hmap
  rintro _ ⟨_, ⟨x, rfl⟩ | ⟨y, rfl⟩, rfl⟩
  · left
    refine ⟨x, ?_⟩
    change ι.app U x = (_ ≫ Ψ.appLE V (ι ⁻¹ᵁ U) hpre.ge) x
    rw [Scheme.Hom.appLE_comp_appLE, appLE_congr_hom (pullback.lift_fst ι π hι) _ _ _ le_rfl,
      Scheme.Hom.appLE_eq_app]
  · right
    refine ⟨y, ?_⟩
    change π.appLE ⊤ (ι ⁻¹ᵁ U) _ y = (_ ≫ Ψ.appLE V (ι ⁻¹ᵁ U) hpre.ge) y
    rw [Scheme.Hom.appLE_comp_appLE, appLE_congr_hom (pullback.lift_snd ι π hι) _ _ _
      (le_preimage_top _ _)]

/-- The constants `ℂ → Γ(𝓨, V)` of the structure morphism `π ≫ (𝔸¹ ⟶ Spec ℂ)`. -/
def chartConstants (V : Y.Opens) : ℂ →+* Γ(Y, V) :=
  ((π ≫ affineLineToBase).appLE ⊤ V (le_preimage_top _ _)).hom.comp
    (Scheme.ΓSpecIso (.of ℂ)).inv.hom

/-- The generators `t`, `ι^♯(X_j / X_i)` of the chart ring. -/
def chartGenerators (i : Fin (N + 1)) :
    Option (Fin (N + 1)) → Γ(Y, ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)
  | none => π.appLE ⊤ _ (le_preimage_top _ _) coordT
  | some j => ι.app _ (polynomialProjCoordinateRegularRatio ℂ N i j)

/-- **Every regular function on the chart `ι⁻¹(D₊(X_i))` of a closed embedding
`(ι, π) : 𝓨 ↪ ℙᴺ × 𝔸¹` is a complex polynomial in `t` and the `ι^♯(X_j / X_i)`.** -/
theorem exists_mvPolynomial_chart [IsClosedImmersion (pullback.lift ι π hι)] (i : Fin (N + 1))
    (g : Γ(Y, ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)) :
    ∃ Q : MvPolynomial (Option (Fin (N + 1))) ℂ,
      g = MvPolynomial.eval₂ (chartConstants π _) (chartGenerators ι π i) Q := by
  let R := (MvPolynomial.eval₂Hom (chartConstants π _) (chartGenerators ι π i)).range
  suffices h : g ∈ R by
    obtain ⟨Q, hQ⟩ := h
    exact ⟨Q, hQ.symm⟩
  have hconst : ∀ c : Γ(Spec (.of ℂ), ⊤),
      ((π ≫ affineLineToBase).appLE ⊤ (ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)
        (le_preimage_top _ _)) c ∈ R := by
    intro c
    refine ⟨MvPolynomial.C ((Scheme.ΓSpecIso (.of ℂ)).hom c), ?_⟩
    simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, chartConstants,
      RingHom.coe_comp, Function.comp_apply]
    congr 1
    simp
  refine Subring.closure_le.mpr ?_ (mem_closure_chart ι π hι i g)
  rintro _ (⟨b, rfl⟩ | ⟨y, rfl⟩)
  · have hb : (ι.app (polynomialProjCoordinateOpen ℂ N i)).hom b ∈ Subring.map
        (ι.app (polynomialProjCoordinateOpen ℂ N i)).hom _ :=
      Subring.mem_map.mpr ⟨b, mem_closure_coordinateOpen N i b, rfl⟩
    rw [RingHom.map_closure] at hb
    refine Subring.closure_le.mpr ?_ hb
    rintro _ ⟨_, ⟨c, rfl⟩ | ⟨j, rfl⟩, rfl⟩
    · change (_ ≫ ι.app _) c ∈ R
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, appLE_congr_hom hι _ _ _ (le_preimage_top _ _)]
      exact hconst c
    · exact ⟨MvPolynomial.X (some j), by simp [chartGenerators]⟩
  · have hy : (π.appLE ⊤ (ι ⁻¹ᵁ polynomialProjCoordinateOpen ℂ N i)
        (le_preimage_top _ _)).hom y ∈ Subring.map (π.appLE ⊤ (ι ⁻¹ᵁ
          polynomialProjCoordinateOpen ℂ N i) (le_preimage_top _ _)).hom _ :=
      Subring.mem_map.mpr ⟨y, mem_closure_affineLine y, rfl⟩
    rw [RingHom.map_closure] at hy
    refine Subring.closure_le.mpr ?_ hy
    rintro _ ⟨_, ⟨c, rfl⟩ | rfl, rfl⟩
    · change (_ ≫ π.appLE ⊤ _ _) c ∈ R
      have := hconst c
      rw [Scheme.Hom.comp_appLE] at this
      exact this
    · exact ⟨MvPolynomial.X none, by simp [chartGenerators]⟩

end SGPT.TestCurve.TCLin
