import SGPT.LineBundle.SectionFiltration
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.FiniteType

/-!
# `ℤ`-filtrations of the section ring, the Rees algebra and finite generation

Infrastructure for `rmk:PhongSturm` and `rmk:NApotential:L862` (chapters *Test curves* and
*Non-Archimedean pluripotential theory*): *"`𝓕` is the filtration induced by a (smooth) test
configuration `(𝓧, 𝓛)` of `(X, L)`"*.

A test configuration `(𝓧, 𝓛)` of a polarized variety `(X, L)` (`L` ample) induces a
`ℤ`-filtration of the section ring `R = R(X, L) = ⊕_m H⁰(X, L^m)`
(Witt Nyström; Ross–Witt Nyström [RWN14, §8]; Boucksom–Hisamoto–Jonsson [BHJ17, §2.5]):

`𝓕^λ H⁰(X, L^m) = {s : t^{-λ} s̄ ∈ H⁰(𝓧, m𝓛)}`, `λ ∈ ℤ`,

where `s̄` is the `𝔾_m`-invariant extension of `s` to `𝓧 ∖ 𝓧₀`. The `𝔾_m`-equivariant Rees
construction identifies `H⁰(𝓧, m𝓛)` with `⊕_λ t^{-λ} 𝓕^λ H⁰(X, L^m)`, and
[BHJ17, Prop. 2.15] makes `(𝓧, 𝓛) ↦ 𝓕` a bijection between ample test configurations and
*finitely generated* `ℤ`-filtrations (`defi:fingen` of [BHJ17]: the bigraded algebra
`⊕_{(λ, m)} 𝓕^λ R_m`, equivalently the `ℂ[t]`-algebra `⊕_m ⊕_λ t^{-λ} 𝓕^λ R_m`, is finitely
generated). Following [RWN14, §8] a `ℤ`-filtration is extended to all real indices by
`𝓕^λ := 𝓕^{⌈λ⌉}`, which makes it left-continuous.

This file formalizes this algebraic side.

## Main definitions

* `SectionZFiltration f a`: a `ℤ`-filtration of `R(X, L)` in the sense of [BHJ17, §1.1]
  (decreasing, separating and exhaustive in every degree, multiplicative).
* `SectionZFiltration.LinearlyBounded`: the linear bound `eq:Flinearlybdd` of
  `def:testcurve:L1134` with an integer constant.
* `SectionZFiltration.toSectionFiltration`: the real-indexed filtration `λ ↦ 𝓕^{⌈λ⌉}`, a
  filtration in the sense of `def:testcurve:L1134` (`SGPT.LineBundle.SectionFiltration`).
* `SecRing f a`: the section ring `⊕_k H⁰(X, L^k)` as a commutative `ℂ`-algebra.
* `SectionZFiltration.rees`: the Rees algebra `⊕_m ⊕_λ t^{-λ} 𝓕^λ R_m`, the `ℂ`-subalgebra
  of the Laurent polynomial ring `R[t, t⁻¹]` generated by the elements `t^{-λ} s`,
  `s ∈ 𝓕^λ R_m`; `SectionZFiltration.IsFinitelyGenerated`: it is a finitely generated
  `ℂ`-algebra ([BHJ17, Def. 1.? `defi:fingen`]).

## Main results

* `SectionZFiltration.piece_zero_eq_bot_of_pos`: on an integral scheme `𝓕^λ R₀ = 0` for `λ > 0`.
* `SectionZFiltration.IsFinitelyGenerated.exists_upper_bound`: a finitely generated
  `ℤ`-filtration has linear growth, `𝓕^{Cm} R_m = 0` (the bound of Phong–Sturm,
  [RWN14, Lemma 8.2]).
* `SectionZFiltration.IsFinitelyGenerated.exists_lower_bound`: if `𝓕⁰ R₀ = R₀` (true for the
  filtration of a test configuration), then `𝓕^{-Cm} R_m = R_m`.
* `SectionZFiltration.IsFinitelyGenerated.linearlyBounded`: hence a normalized finitely
  generated `ℤ`-filtration is linearly bounded, and induces a filtration
  `toSectionFiltration` of `R(X, L)` in the sense of the book.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.TestCurve.TestConfig

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes SGPT.LineBundle

variable {X : Scheme} (f : X ⟶ Spec (.of ℂ)) {L : X.Modules} (a : LineBundleAtlas L)

/-! ### `ℤ`-filtrations -/

/-- A `ℤ`-filtration of the section ring `R(X, L) = ⊕_k H⁰(X, L^k)` ([BHJ17, §1.1]): a family
`(𝓕^μ_k)_{μ ∈ ℤ}` of subspaces of `H⁰(X, L^k)` for every `k`, decreasing in `μ`, separating
(`𝓕^μ_k = 0` for `μ ≫ 0`) and exhaustive (`𝓕^μ_k = H⁰(X, L^k)` for `μ ≪ 0`) in every degree,
and multiplicative: `𝓕^μ_k · 𝓕^{μ'}_{k'} ⊆ 𝓕^{μ+μ'}_{k+k'}`. -/
structure SectionZFiltration where
  /-- The piece `𝓕^μ_k ⊆ H⁰(X, L^k)`. -/
  piece : ℤ → ∀ k : ℕ, Submodule ℂ (SectionSpace f L k)
  antitone_piece : ∀ k : ℕ, Antitone fun μ : ℤ => piece μ k
  mul_mem : ∀ (μ μ' : ℤ) (k k' : ℕ) (s : SectionSpace f L k) (t : SectionSpace f L k'),
    s ∈ piece μ k → t ∈ piece μ' k' → SectionSpace.mul f a k k' s t ∈ piece (μ + μ') (k + k')
  separating : ∀ k : ℕ, ∃ μ : ℤ, piece μ k = ⊥
  exhaustive : ∀ k : ℕ, ∃ μ : ℤ, piece μ k = ⊤

namespace SectionZFiltration

variable {f a} (F : SectionZFiltration f a)

theorem piece_anti {μ μ' : ℤ} (h : μ ≤ μ') (k : ℕ) : F.piece μ' k ≤ F.piece μ k :=
  F.antitone_piece k h

/-- The linear bound `eq:Flinearlybdd` of `def:testcurve:L1134`: there is an integer `C > 0`
with `𝓕^{Cm}_m = 0` and `𝓕^{-Cm}_m = H⁰(X, L^m)` for every `m ∈ ℤ_{>0}`. -/
def LinearlyBounded : Prop :=
  ∃ C : ℕ, 0 < C ∧ ∀ m : ℕ, 0 < m →
    F.piece ((C : ℤ) * m) m = ⊥ ∧ F.piece (-((C : ℤ) * m)) m = ⊤

/-- The real-indexed extension `𝓕^λ := 𝓕^{⌈λ⌉}` of a `ℤ`-filtration ([RWN14, §8],
[BHJ17, §1.1]: a `ℤ`-filtration is a filtration with `𝓕^λ = 𝓕^{⌈λ⌉}`). -/
def ceilPiece (μ : ℝ) (k : ℕ) : Submodule ℂ (SectionSpace f L k) := F.piece ⌈μ⌉ k

theorem ceilPiece_intCast (μ : ℤ) (k : ℕ) : F.ceilPiece (μ : ℝ) k = F.piece μ k := by
  simp [ceilPiece]

theorem antitone_ceilPiece (k : ℕ) : Antitone fun μ : ℝ => F.ceilPiece μ k :=
  fun _ _ h => F.piece_anti (Int.ceil_mono h) k

/-- The extension `λ ↦ 𝓕^{⌈λ⌉}` is left-continuous: `𝓕^λ = ⋂_{λ' < λ} 𝓕^{λ'}`. -/
theorem ceilPiece_leftContinuous (μ : ℝ) (k : ℕ) :
    F.ceilPiece μ k = ⨅ (μ' : ℝ) (_ : μ' < μ), F.ceilPiece μ' k := by
  apply le_antisymm
  · exact le_iInf₂ fun μ' hμ' => F.antitone_ceilPiece k hμ'.le
  · -- the point `μ' = (μ + ⌈μ⌉ - 1)/2 < μ` has the same ceiling as `μ`
    have h1 : ((⌈μ⌉ : ℤ) : ℝ) - 1 < μ := by
      have := Int.ceil_lt_add_one μ
      linarith
    have h2 : μ ≤ ((⌈μ⌉ : ℤ) : ℝ) := Int.le_ceil μ
    set μ' : ℝ := (μ + ((⌈μ⌉ : ℤ) : ℝ) - 1) / 2 with hμ'def
    have hμ' : μ' < μ := by rw [hμ'def]; linarith
    have hceil : ⌈μ'⌉ = ⌈μ⌉ := by
      rw [Int.ceil_eq_iff]
      constructor
      · rw [hμ'def]; linarith
      · rw [hμ'def]; linarith
    refine (iInf₂_le μ' hμ').trans ?_
    simp only [ceilPiece, hceil, le_refl]

/-- The real-indexed extension is multiplicative. -/
theorem ceilPiece_mul_mem (μ μ' : ℝ) (k k' : ℕ) (s : SectionSpace f L k)
    (t : SectionSpace f L k') (hs : s ∈ F.ceilPiece μ k) (ht : t ∈ F.ceilPiece μ' k') :
    SectionSpace.mul f a k k' s t ∈ F.ceilPiece (μ + μ') (k + k') :=
  F.piece_anti (Int.ceil_add_le μ μ') (k + k') (F.mul_mem _ _ k k' s t hs ht)

/-- A linearly bounded `ℤ`-filtration, extended by `𝓕^λ = 𝓕^{⌈λ⌉}`, is a filtration of
`R(X, L)` in the sense of `def:testcurve:L1134`. -/
def toSectionFiltration (h : F.LinearlyBounded) : SectionFiltration f a where
  piece := F.ceilPiece
  antitone_piece := F.antitone_ceilPiece
  leftContinuous := F.ceilPiece_leftContinuous
  mul_mem := F.ceilPiece_mul_mem
  linearlyBounded := by
    obtain ⟨C, hC, hb⟩ := h
    refine ⟨C, hC, fun m hm => ?_⟩
    have e1 : ⌈((C : ℝ) * m)⌉ = (C : ℤ) * m := by
      rw [show ((C : ℝ) * m) = (((C : ℤ) * m : ℤ) : ℝ) by push_cast; ring, Int.ceil_intCast]
    have e2 : ⌈-((C : ℝ) * m)⌉ = -((C : ℤ) * m) := by
      rw [show -((C : ℝ) * m) = ((-((C : ℤ) * m) : ℤ) : ℝ) by push_cast; ring, Int.ceil_intCast]
    change F.piece ⌈((C : ℝ) * m)⌉ m = ⊥ ∧ F.piece ⌈-((C : ℝ) * m)⌉ m = ⊤
    rw [e1, e2]
    exact hb m hm

@[simp] theorem toSectionFiltration_piece (h : F.LinearlyBounded) (μ : ℝ) (k : ℕ) :
    (F.toSectionFiltration h).piece μ k = F.piece ⌈μ⌉ k := rfl

/-! ### Degree zero -/

/-- Iterated products `s^j ∈ H⁰(X, L⁰)` of a degree-zero section, as the section products
`s · s^{j-1}`. -/
def degZeroPow (s : SectionSpace f L 0) : ℕ → SectionSpace f L 0
  | 0 => s
  | j + 1 => SectionSpace.mul f a 0 0 s (degZeroPow s j)

theorem degZeroPow_mem {μ : ℤ} {s : SectionSpace f L 0} (hs : s ∈ F.piece μ 0) (j : ℕ) :
    degZeroPow (f := f) (a := a) s j ∈ F.piece ((j + 1 : ℕ) * μ) 0 := by
  induction j with
  | zero => show s ∈ _; simpa using hs
  | succ j ih =>
    have := F.mul_mem μ ((j + 1 : ℕ) * μ) 0 0 s _ hs ih
    have e : μ + ((j + 1 : ℕ) : ℤ) * μ = ((j + 1 + 1 : ℕ) : ℤ) * μ := by push_cast; ring
    rw [e] at this
    exact this

theorem degZeroPow_ne_zero [IsIntegral X] {s : SectionSpace f L 0} (hs : s ≠ 0) (j : ℕ) :
    degZeroPow (f := f) (a := a) s j ≠ 0 := by
  induction j with
  | zero => exact hs
  | succ j ih => exact SectionSpace.mul_ne_zero f a hs ih

/-- On an integral scheme, `𝓕^μ R₀ = 0` for `μ > 0`: a nonzero `s ∈ 𝓕^μ R₀` would give
nonzero powers `s^j ∈ 𝓕^{jμ} R₀` for all `j`, against separation. -/
theorem piece_zero_eq_bot_of_pos [IsIntegral X] {μ : ℤ} (hμ : 0 < μ) : F.piece μ 0 = ⊥ := by
  rw [eq_bot_iff]
  intro s hs
  rw [Submodule.mem_bot]
  by_contra hne
  obtain ⟨ν, hν⟩ := F.separating 0
  -- choose `j` with `(j+1) μ ≥ ν`
  obtain ⟨j, hj⟩ : ∃ j : ℕ, ν ≤ ((j + 1 : ℕ) : ℤ) * μ := by
    refine ⟨ν.toNat, ?_⟩
    have h1 : ν ≤ (ν.toNat : ℤ) := Int.self_le_toNat ν
    have h2 : ((ν.toNat : ℕ) : ℤ) ≤ ((ν.toNat + 1 : ℕ) : ℤ) * μ := by
      push_cast
      nlinarith
    exact h1.trans h2
  have hmem := F.piece_anti hj 0 (F.degZeroPow_mem hs j)
  rw [hν, Submodule.mem_bot] at hmem
  exact degZeroPow_ne_zero (f := f) (a := a) hne j hmem

end SectionZFiltration

/-! ### The section ring and the Rees algebra -/

/-- The section ring `R(X, L) = ⊕_k H⁰(X, L^k)`, with the ring structure of the section
product of the atlas `a` (a type synonym of the direct sum). -/
def SecRing (_a : LineBundleAtlas L) : Type := DirectSum ℕ (SectionSpace f L)

instance (a : LineBundleAtlas L) : CommRing (SecRing f a) :=
  letI := sectionGCommRing f a
  inferInstanceAs (CommRing (DirectSum ℕ (SectionSpace f L)))

instance (a : LineBundleAtlas L) : Algebra ℂ (SecRing f a) :=
  letI := sectionGCommRing f a
  letI := sectionGAlgebra f a
  inferInstanceAs (Algebra ℂ (DirectSum ℕ (SectionSpace f L)))

/-- The unit `1 ∈ H⁰(X, L⁰)`. -/
def secOne (L : X.Modules) : SectionSpace f L 0 := bundlePowerGlobalOne L

namespace SecRing

variable {f a}

/-- The degree-`m` summand `H⁰(X, L^m) → R(X, L)`. -/
def of (m : ℕ) (s : SectionSpace f L m) : SecRing f a := DirectSum.of (SectionSpace f L) m s

/-- The degree-`m` component `R(X, L) → H⁰(X, L^m)`. -/
def comp (m : ℕ) (x : SecRing f a) : SectionSpace f L m :=
  (show DirectSum ℕ (SectionSpace f L) from x) m

theorem of_mul_of (m k : ℕ) (s : SectionSpace f L m) (t : SectionSpace f L k) :
    (of m s : SecRing f a) * of k t = of (m + k) (SectionSpace.mul f a m k s t) :=
  sectionRing_of_mul_of f a s t

theorem one_eq : (1 : SecRing f a) = of 0 (secOne f L) := rfl

theorem of_zero (m : ℕ) : (of m 0 : SecRing f a) = 0 := map_zero _

theorem comp_add (m : ℕ) (x y : SecRing f a) : comp m (x + y) = comp m x + comp m y := rfl

theorem comp_smul (m : ℕ) (c : ℂ) (x : SecRing f a) : comp m (c • x) = c • comp m x := rfl

theorem comp_zero (m : ℕ) : comp m (0 : SecRing f a) = 0 := rfl

theorem comp_of_same (m : ℕ) (s : SectionSpace f L m) : comp m (of m s : SecRing f a) = s :=
  DirectSum.of_eq_same m s

theorem comp_of_ne {m k : ℕ} (h : m ≠ k) (s : SectionSpace f L k) :
    comp m (of k s : SecRing f a) = 0 :=
  DirectSum.of_eq_of_ne k m s h

end SecRing

/-- The Laurent polynomial ring `R(X, L)[t, t⁻¹]` (as the `ℤ`-graded monoid algebra). -/
abbrev LaurentSecRing (a : LineBundleAtlas L) : Type := AddMonoidAlgebra (SecRing f a) ℤ

namespace LaurentSecRing

variable {f a}

/-- The bihomogeneous element `t^j s` (`s ∈ H⁰(X, L^m)`), of bidegree `(-j, m)`. -/
def mono (j : ℤ) (m : ℕ) (s : SectionSpace f L m) : LaurentSecRing f a :=
  AddMonoidAlgebra.single j (SecRing.of m s)

theorem mono_mul_mono (j j' : ℤ) (m m' : ℕ) (s : SectionSpace f L m)
    (s' : SectionSpace f L m') :
    (mono j m s : LaurentSecRing f a) * mono j' m' s' =
      mono (j + j') (m + m') (SectionSpace.mul f a m m' s s') := by
  unfold mono
  rw [AddMonoidAlgebra.single_mul_single, SecRing.of_mul_of]

theorem one_eq_mono : (1 : LaurentSecRing f a) = mono 0 0 (secOne f L) := rfl

theorem mono_zero (j : ℤ) (m : ℕ) : (mono j m 0 : LaurentSecRing f a) = 0 := by
  unfold mono
  rw [SecRing.of_zero, AddMonoidAlgebra.single_zero]

/-- The coefficient of `t^j` in degree `m`, a `ℂ`-linear map `R[t, t⁻¹] → H⁰(X, L^m)`. -/
def coeffAt (j : ℤ) (m : ℕ) : LaurentSecRing f a →ₗ[ℂ] SectionSpace f L m where
  toFun x := SecRing.comp m (x.coeff j)
  map_add' x y := by
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply]
    exact SecRing.comp_add m _ _
  map_smul' c x := by
    rw [AddMonoidAlgebra.coeff_smul_apply]
    exact SecRing.comp_smul m c _

theorem coeffAt_mono (j j' : ℤ) (m m' : ℕ) (s : SectionSpace f L m') :
    coeffAt j m (mono j' m' s : LaurentSecRing f a) =
      if h : j' = j ∧ m' = m then h.2 ▸ s else 0 := by
  change SecRing.comp m ((AddMonoidAlgebra.single j' (SecRing.of (a := a) m' s) : LaurentSecRing f a).coeff j) = _
  rw [AddMonoidAlgebra.coeff_single]
  by_cases hj : j' = j
  · subst hj
    rw [Finsupp.single_eq_same]
    by_cases hm : m' = m
    · subst hm
      rw [dif_pos ⟨rfl, rfl⟩, SecRing.comp_of_same]
    · rw [dif_neg (fun h => hm h.2), SecRing.comp_of_ne (Ne.symm hm)]
  · rw [Finsupp.single_eq_of_ne (Ne.symm hj), dif_neg (fun h => hj h.1)]
    exact SecRing.comp_zero m

theorem coeffAt_mono_same (j : ℤ) (m : ℕ) (s : SectionSpace f L m) :
    coeffAt j m (mono j m s : LaurentSecRing f a) = s := by
  rw [coeffAt_mono, dif_pos ⟨rfl, rfl⟩]

/-- The span of the bihomogeneous elements `t^j s` with `s` in a prescribed subspace `W j m`. -/
def monoSpan (W : ℤ → ∀ m : ℕ, Submodule ℂ (SectionSpace f L m)) :
    Submodule ℂ (LaurentSecRing f a) :=
  Submodule.span ℂ {x | ∃ (j : ℤ) (m : ℕ) (s : SectionSpace f L m), s ∈ W j m ∧ x = mono j m s}

theorem mono_mem_monoSpan (W : ℤ → ∀ m : ℕ, Submodule ℂ (SectionSpace f L m)) {j : ℤ} {m : ℕ}
    {s : SectionSpace f L m} (hs : s ∈ W j m) :
    (mono j m s : LaurentSecRing f a) ∈ monoSpan W :=
  Submodule.subset_span ⟨j, m, s, hs, rfl⟩

/-- The coefficients of the span of the `t^j s`, `s ∈ W j m`, lie in `W`. -/
theorem coeffAt_mem_of_mem_monoSpan (W : ℤ → ∀ m : ℕ, Submodule ℂ (SectionSpace f L m))
    {x : LaurentSecRing f a} (hx : x ∈ monoSpan W) (j : ℤ) (m : ℕ) : coeffAt j m x ∈ W j m := by
  have hle : monoSpan (a := a) W ≤ (W j m).comap (coeffAt j m) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨j', m', s, hs, rfl⟩
    change coeffAt j m (mono j' m' s) ∈ W j m
    rw [coeffAt_mono]
    split_ifs with h
    · obtain ⟨rfl, rfl⟩ := h
      exact hs
    · exact zero_mem _
  exact hle hx

/-- If the family `W` is multiplicative and contains `1` in bidegree `(0, 0)`, the span of the
`t^j s`, `s ∈ W j m`, is a subalgebra. -/
def monoSubalgebra (W : ℤ → ∀ m : ℕ, Submodule ℂ (SectionSpace f L m))
    (hone : secOne f L ∈ W 0 0)
    (hmul : ∀ (j j' : ℤ) (m m' : ℕ) (s : SectionSpace f L m) (s' : SectionSpace f L m'),
      s ∈ W j m → s' ∈ W j' m' → SectionSpace.mul f a m m' s s' ∈ W (j + j') (m + m')) :
    Subalgebra ℂ (LaurentSecRing f a) :=
  (monoSpan (a := a) W).toSubalgebra (by rw [one_eq_mono]; exact mono_mem_monoSpan W hone)
    (by
      intro x y hx hy
      refine Submodule.span_induction (p := fun x _ => x * y ∈ monoSpan W) ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨j, m, s, hs, rfl⟩
        refine Submodule.span_induction (p := fun y _ => mono j m s * y ∈ monoSpan W)
          ?_ ?_ ?_ ?_ hy
        · rintro _ ⟨j', m', s', hs', rfl⟩
          rw [mono_mul_mono]
          exact mono_mem_monoSpan W (hmul j j' m m' s s' hs hs')
        · rw [mul_zero]; exact zero_mem _
        · intro y z _ _ hy hz; rw [mul_add]; exact add_mem hy hz
        · intro c y _ hy; rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy
      · rw [zero_mul]; exact zero_mem _
      · intro x z _ _ hx hz; rw [add_mul]; exact add_mem hx hz
      · intro c x _ hx; rw [smul_mul_assoc]; exact Submodule.smul_mem _ c hx)

theorem mem_monoSubalgebra (W : ℤ → ∀ m : ℕ, Submodule ℂ (SectionSpace f L m)) (hone hmul)
    (x : LaurentSecRing f a) :
    x ∈ monoSubalgebra W hone hmul ↔ x ∈ monoSpan W := Iff.rfl

end LaurentSecRing

open LaurentSecRing

namespace SectionZFiltration

variable {f a} (F : SectionZFiltration f a)

/-- The generators `t^{-μ} s`, `s ∈ 𝓕^μ_m`, of the Rees algebra. -/
def reesGen : Set (LaurentSecRing f a) :=
  {x | ∃ (μ : ℤ) (m : ℕ) (s : SectionSpace f L m), s ∈ F.piece μ m ∧ x = mono (-μ) m s}

/-- The Rees algebra `⊕_m ⊕_μ t^{-μ} 𝓕^μ R_m ⊆ R(X, L)[t, t⁻¹]` of the `ℤ`-filtration
([BHJ17, §1.1–1.2]): the `ℂ`-subalgebra generated by the `t^{-μ} s`, `s ∈ 𝓕^μ R_m`. For the
filtration of a test configuration `(𝓧, 𝓛)` this is `⊕_m H⁰(𝓧, m𝓛)`. -/
def rees : Subalgebra ℂ (LaurentSecRing f a) := Algebra.adjoin ℂ F.reesGen

/-- **Finite generation** ([BHJ17, `defi:fingen`]): the bigraded algebra `⊕_{(μ, m)} 𝓕^μ R_m`,
equivalently the Rees algebra `⊕_m ⊕_μ t^{-μ} 𝓕^μ R_m`, is a finitely generated
`ℂ`-algebra. By [BHJ17, Prop. 2.15] the finitely generated `ℤ`-filtrations of `R(X, L)` are
exactly the filtrations induced by the ample test configurations of `(X, L)`. -/
def IsFinitelyGenerated : Prop := F.rees.FG

theorem reesGen_subset_rees : F.reesGen ⊆ F.rees := Algebra.subset_adjoin

theorem mono_mem_rees {μ : ℤ} {m : ℕ} {s : SectionSpace f L m} (hs : s ∈ F.piece μ m) :
    (mono (-μ) m s : LaurentSecRing f a) ∈ F.rees :=
  F.reesGen_subset_rees ⟨μ, m, s, hs, rfl⟩

/-- Products of generators are generators (multiplicativity), so the monoid generated by
`reesGen` is `reesGen ∪ {1}`. -/
theorem closure_reesGen_subset :
    (Submonoid.closure F.reesGen : Set (LaurentSecRing f a)) ⊆ F.reesGen ∪ {1} := by
  intro x hx
  refine Submonoid.closure_induction (motive := fun x _ => x ∈ F.reesGen ∪ {1}) ?_ ?_ ?_ hx
  · intro x hx; exact Or.inl hx
  · exact Or.inr rfl
  · rintro x y - - (hx | hx) (hy | hy)
    · obtain ⟨μ, m, s, hs, rfl⟩ := hx
      obtain ⟨μ', m', s', hs', rfl⟩ := hy
      refine Or.inl ⟨μ + μ', m + m', SectionSpace.mul f a m m' s s',
        F.mul_mem μ μ' m m' s s' hs hs', ?_⟩
      rw [mono_mul_mono, neg_add]
    · rw [Set.mem_singleton_iff.mp hy, mul_one]; exact Or.inl hx
    · rw [Set.mem_singleton_iff.mp hx, one_mul]; exact Or.inl hy
    · rw [Set.mem_singleton_iff.mp hx, one_mul]; exact Or.inr hy

/-- Every element of the Rees algebra is a finite linear combination of generators and `1`. -/
theorem exists_finset_of_mem_rees {x : LaurentSecRing f a} (hx : x ∈ F.rees) :
    ∃ T : Finset (LaurentSecRing f a), (↑T : Set _) ⊆ F.reesGen ∪ {1} ∧
      x ∈ Submodule.span ℂ (T : Set (LaurentSecRing f a)) := by
  have hx' : x ∈ Subalgebra.toSubmodule F.rees := hx
  rw [rees, Algebra.adjoin_eq_span] at hx'
  obtain ⟨T, hT, hxT⟩ := Submodule.mem_span_finite_of_mem_span hx'
  exact ⟨T, hT.trans F.closure_reesGen_subset, hxT⟩

/-! ### Linear growth of finitely generated filtrations -/

/-- The cone `{(-j, m) : -j ≤ C m}` of bidegrees, as subspaces (everything or nothing). -/
def upperCone (C : ℕ) (j : ℤ) (m : ℕ) : Submodule ℂ (SectionSpace f L m) :=
  if -j ≤ (C : ℤ) * m then ⊤ else ⊥

theorem upperCone_mul (C : ℕ) (j j' : ℤ) (m m' : ℕ) (s : SectionSpace f L m)
    (s' : SectionSpace f L m') (hs : s ∈ upperCone (f := f) C j m)
    (hs' : s' ∈ upperCone (f := f) C j' m') :
    SectionSpace.mul f a m m' s s' ∈ upperCone (f := f) C (j + j') (m + m') := by
  unfold upperCone at *
  split_ifs at hs hs' with h1 h2 h2
  · rw [if_pos (by push_cast; linarith)]; exact Submodule.mem_top
  · rw [(Submodule.mem_bot ℂ).mp hs', map_zero]; exact zero_mem _
  · rw [(Submodule.mem_bot ℂ).mp hs, map_zero, LinearMap.zero_apply]; exact zero_mem _
  · rw [(Submodule.mem_bot ℂ).mp hs, map_zero, LinearMap.zero_apply]; exact zero_mem _

theorem upperCone_mono {C C' : ℕ} (h : C ≤ C') (j : ℤ) (m : ℕ) :
    upperCone (f := f) (L := L) C j m ≤ upperCone C' j m := by
  unfold upperCone
  split_ifs with h1 h2
  · exact le_rfl
  · exfalso; apply h2
    have : ((C : ℤ) * m) ≤ (C' : ℤ) * m :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast h) (by positivity)
    linarith
  · exact bot_le
  · exact le_rfl

theorem upperCone_zero_mem (C : ℕ) : secOne f L ∈ upperCone (f := f) C 0 0 := by
  unfold upperCone
  rw [if_pos (by simp)]
  exact Submodule.mem_top

/-- The span of the bihomogeneous elements of bidegree in the cone `{(μ, m) : μ ≤ C m}`, a
subalgebra. -/
def upperConeAlg (C : ℕ) : Subalgebra ℂ (LaurentSecRing f a) :=
  monoSubalgebra (upperCone (f := f) C) (upperCone_zero_mem C) (upperCone_mul C)

theorem upperConeAlg_mono {C C' : ℕ} (h : C ≤ C') :
    (upperConeAlg (f := f) (a := a) C : Set (LaurentSecRing f a)) ⊆ upperConeAlg (f := f) (a := a) C' := by
  intro x hx
  change x ∈ monoSpan _ at hx
  change x ∈ monoSpan _
  refine Submodule.span_le.mpr ?_ hx
  rintro _ ⟨j, m, s, hs, rfl⟩
  exact mono_mem_monoSpan _ (upperCone_mono h j m hs)

/-- Every element of a finite set lies in one member of an increasing family of sets. -/
theorem exists_index_of_finset {α : Type*} (P : ℕ → Set α)
    (hmono : ∀ {C C' : ℕ}, C ≤ C' → P C ⊆ P C') (T : Finset α)
    (hT : ∀ x ∈ T, ∃ C : ℕ, x ∈ P C) : ∃ C : ℕ, ∀ x ∈ T, x ∈ P C := by
  classical
  induction T using Finset.induction_on with
  | empty => exact ⟨0, fun x hx => absurd hx (Finset.notMem_empty x)⟩
  | insert y T hy ih =>
    obtain ⟨C₁, hC₁⟩ := ih fun x hx => hT x (Finset.mem_insert_of_mem hx)
    obtain ⟨C₂, hC₂⟩ := hT y (Finset.mem_insert_self y T)
    refine ⟨max C₁ C₂, fun x hx => ?_⟩
    rcases Finset.mem_insert.mp hx with rfl | hx
    · exact hmono (le_max_right _ _) hC₂
    · exact hmono (le_max_left _ _) (hC₁ x hx)

/-- If every generator of the Rees algebra (and `1`) lies in some member of an increasing
family of subalgebras, then so does every element of the Rees algebra, and, when the Rees
algebra is finitely generated, the whole Rees algebra lies in one member. -/
theorem exists_rees_le_of_fg (A : ℕ → Subalgebra ℂ (LaurentSecRing f a))
    (hmono : ∀ {C C' : ℕ}, C ≤ C' → (A C : Set (LaurentSecRing f a)) ⊆ A C')
    (hgen : ∀ x ∈ F.reesGen ∪ {1}, ∃ C : ℕ, x ∈ A C) (hF : F.IsFinitelyGenerated) :
    ∃ C : ℕ, F.rees ≤ A C := by
  classical
  have hmem : ∀ x ∈ F.rees, ∃ C : ℕ, x ∈ A C := by
    intro x hx
    obtain ⟨T, hT, hxT⟩ := F.exists_finset_of_mem_rees hx
    obtain ⟨C, hC⟩ := exists_index_of_finset (fun C => (A C : Set (LaurentSecRing f a)))
      hmono T fun y hy => hgen y (hT hy)
    exact ⟨C, (Submodule.span_le (p := Subalgebra.toSubmodule (A C))).mpr
      (fun y hy => hC y hy) hxT⟩
  obtain ⟨G, hG⟩ := hF
  obtain ⟨C, hC⟩ := exists_index_of_finset (fun C => (A C : Set (LaurentSecRing f a)))
    hmono G fun y hy => hmem y (hG ▸ Algebra.subset_adjoin hy)
  exact ⟨C, hG ▸ Algebra.adjoin_le fun y hy => hC y hy⟩

/-- Each generator (and `1`) lies in the cone subalgebra for a suitable `C`. -/
theorem exists_upperCone_of_mem_reesGen [IsIntegral X] {x : LaurentSecRing f a}
    (hx : x ∈ F.reesGen ∪ {1}) :
    ∃ C : ℕ, x ∈ upperConeAlg (f := f) (a := a) C := by
  rcases hx with ⟨μ, m, s, hs, rfl⟩ | hx
  · by_cases hs0 : s = 0
    · refine ⟨0, ?_⟩
      rw [hs0, mono_zero]
      exact zero_mem _
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      have hμ : μ ≤ 0 := by
        by_contra hpos
        have := F.piece_zero_eq_bot_of_pos (lt_of_not_ge hpos)
        rw [this, Submodule.mem_bot] at hs
        exact hs0 hs
      refine ⟨0, mono_mem_monoSpan _ ?_⟩
      unfold upperCone
      rw [if_pos (by simp [hμ])]
      exact Submodule.mem_top
    · refine ⟨μ.natAbs, mono_mem_monoSpan _ ?_⟩
      unfold upperCone
      rw [if_pos]
      · exact Submodule.mem_top
      · have h1 : (1 : ℤ) ≤ m := by exact_mod_cast hm
        have h2 : μ ≤ (μ.natAbs : ℤ) := Int.le_natAbs
        have h3 : (μ.natAbs : ℤ) * 1 ≤ (μ.natAbs : ℤ) * m :=
          mul_le_mul_of_nonneg_left h1 (by positivity)
        simp only [neg_neg]
        linarith
  · refine ⟨0, ?_⟩
    rw [Set.mem_singleton_iff.mp hx]
    exact one_mem _

/-- **Linear growth** (the upper half of `eq:Flinearlybdd`; for test configurations this is
the bound of Phong–Sturm, [RWN14, Lemma 8.2]): a finitely generated `ℤ`-filtration of the
section ring of an integral scheme satisfies `𝓕^{Cm} R_m = 0` for all `m > 0`. -/
theorem IsFinitelyGenerated.exists_upper_bound [IsIntegral X] (hF : F.IsFinitelyGenerated) :
    ∃ C : ℕ, 0 < C ∧ ∀ m : ℕ, 0 < m → F.piece ((C : ℤ) * m) m = ⊥ := by
  obtain ⟨C, hle⟩ := F.exists_rees_le_of_fg (fun C => upperConeAlg (f := f) (a := a) C)
    (fun h => upperConeAlg_mono h) (fun x hx => F.exists_upperCone_of_mem_reesGen hx) hF
  refine ⟨C + 1, Nat.succ_pos C, fun m hm => ?_⟩
  rw [eq_bot_iff]
  intro s hs
  rw [Submodule.mem_bot]
  have hmem : (mono (-((C + 1 : ℕ) * m : ℤ)) m s : LaurentSecRing f a) ∈
      upperConeAlg (f := f) (a := a) C :=
    hle (F.mono_mem_rees hs)
  have hcoeff := coeffAt_mem_of_mem_monoSpan (upperCone (f := f) C) hmem
    (-((C + 1 : ℕ) * m : ℤ)) m
  rw [coeffAt_mono_same] at hcoeff
  unfold upperCone at hcoeff
  rw [if_neg] at hcoeff
  · exact (Submodule.mem_bot ℂ).mp hcoeff
  · have h1 : (1 : ℤ) ≤ m := by exact_mod_cast hm
    push_cast
    nlinarith

/-! ### The lower linear bound -/

/-- The subspaces `𝓕^{-Cm}_m` (independently of the power of `t`). -/
def lowerCone (C : ℕ) (_j : ℤ) (m : ℕ) : Submodule ℂ (SectionSpace f L m) :=
  F.piece (-((C : ℤ) * m)) m

theorem lowerCone_mul (C : ℕ) (j j' : ℤ) (m m' : ℕ) (s : SectionSpace f L m)
    (s' : SectionSpace f L m') (hs : s ∈ F.lowerCone C j m) (hs' : s' ∈ F.lowerCone C j' m') :
    SectionSpace.mul f a m m' s s' ∈ F.lowerCone C (j + j') (m + m') := by
  have h := F.mul_mem _ _ m m' s s' hs hs'
  unfold lowerCone
  convert h using 2
  push_cast
  ring

theorem lowerCone_mono {C C' : ℕ} (h : C ≤ C') (j : ℤ) (m : ℕ) :
    F.lowerCone C j m ≤ F.lowerCone C' j m := by
  unfold lowerCone
  apply F.piece_anti
  have : ((C : ℤ) * m) ≤ (C' : ℤ) * m :=
    mul_le_mul_of_nonneg_right (by exact_mod_cast h) (by positivity)
  linarith

/-- Under the normalization `𝓕⁰ R₀ = R₀`, the span of the `t^j s`, `s ∈ 𝓕^{-Cm}_m`, is a
subalgebra. -/
def lowerConeAlg (h0 : F.piece 0 0 = ⊤) (C : ℕ) : Subalgebra ℂ (LaurentSecRing f a) :=
  monoSubalgebra (F.lowerCone C)
    (by unfold lowerCone; simp only [CharP.cast_eq_zero, mul_zero, neg_zero, h0];
        exact Submodule.mem_top)
    (F.lowerCone_mul C)

theorem lowerConeAlg_mono (h0 : F.piece 0 0 = ⊤) {C C' : ℕ} (h : C ≤ C') :
    (F.lowerConeAlg h0 C : Set (LaurentSecRing f a)) ⊆ F.lowerConeAlg h0 C' := by
  intro x hx
  change x ∈ monoSpan _ at hx
  change x ∈ monoSpan _
  refine Submodule.span_le.mpr ?_ hx
  rintro _ ⟨j, m, s, hs, rfl⟩
  exact mono_mem_monoSpan _ (F.lowerCone_mono h j m hs)

theorem exists_lowerCone_of_mem_reesGen (h0 : F.piece 0 0 = ⊤) {x : LaurentSecRing f a}
    (hx : x ∈ F.reesGen ∪ {1}) : ∃ C : ℕ, x ∈ F.lowerConeAlg h0 C := by
  rcases hx with ⟨μ, m, s, hs, rfl⟩ | hx
  · refine ⟨μ.natAbs, mono_mem_monoSpan _ ?_⟩
    unfold lowerCone
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      simp only [CharP.cast_eq_zero, mul_zero, neg_zero, h0]
      exact Submodule.mem_top
    · refine F.piece_anti ?_ m hs
      have h1 : (1 : ℤ) ≤ m := by exact_mod_cast hm
      have h2 : -μ ≤ (μ.natAbs : ℤ) := by
        have := Int.le_natAbs (a := -μ)
        rwa [Int.natAbs_neg] at this
      have h3 : (μ.natAbs : ℤ) * 1 ≤ (μ.natAbs : ℤ) * m :=
        mul_le_mul_of_nonneg_left h1 (by positivity)
      linarith
  · refine ⟨0, ?_⟩
    rw [Set.mem_singleton_iff.mp hx]
    exact one_mem _

/-- **The lower half of `eq:Flinearlybdd`**: a finitely generated `ℤ`-filtration with
`𝓕⁰ R₀ = R₀` (as for the filtration of a test configuration, where `H⁰(𝓧, 𝒪) = ℂ[t]`)
satisfies `𝓕^{-Cm} R_m = R_m` for all `m > 0`. -/
theorem IsFinitelyGenerated.exists_lower_bound (hF : F.IsFinitelyGenerated)
    (h0 : F.piece 0 0 = ⊤) : ∃ C : ℕ, ∀ m : ℕ, 0 < m → F.piece (-((C : ℤ) * m)) m = ⊤ := by
  obtain ⟨C, hle⟩ := F.exists_rees_le_of_fg (fun C => F.lowerConeAlg h0 C)
    (fun h => F.lowerConeAlg_mono h0 h) (fun x hx => F.exists_lowerCone_of_mem_reesGen h0 hx) hF
  refine ⟨C, fun m _ => ?_⟩
  rw [eq_top_iff]
  intro s _
  obtain ⟨μ, hμ⟩ := F.exhaustive m
  have hmem : (mono (-μ) m s : LaurentSecRing f a) ∈ F.lowerConeAlg h0 C :=
    hle (F.mono_mem_rees (by rw [hμ]; exact Submodule.mem_top))
  have hcoeff := coeffAt_mem_of_mem_monoSpan (F.lowerCone C) hmem (-μ) m
  rwa [coeffAt_mono_same] at hcoeff

/-- **A finitely generated `ℤ`-filtration is linearly bounded** (normalized by `𝓕⁰ R₀ = R₀`,
on an integral scheme), so it induces a filtration of `R(X, L)` in the sense of
`def:testcurve:L1134`. -/
theorem IsFinitelyGenerated.linearlyBounded [IsIntegral X] (hF : F.IsFinitelyGenerated)
    (h0 : F.piece 0 0 = ⊤) : F.LinearlyBounded := by
  obtain ⟨C₁, hC₁, h₁⟩ := IsFinitelyGenerated.exists_upper_bound F hF
  obtain ⟨C₂, h₂⟩ := IsFinitelyGenerated.exists_lower_bound F hF h0
  refine ⟨max C₁ C₂, lt_of_lt_of_le hC₁ (le_max_left _ _), fun m hm => ⟨?_, ?_⟩⟩
  · refine le_bot_iff.mp ((F.piece_anti ?_ m).trans (h₁ m hm).le)
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast le_max_left C₁ C₂) (by positivity)
  · refine top_le_iff.mp ((h₂ m hm).symm.le.trans (F.piece_anti ?_ m))
    have : ((C₂ : ℤ) * m) ≤ (max C₁ C₂ : ℕ) * (m : ℤ) :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast le_max_right C₁ C₂) (by positivity)
    linarith

/-- The filtration of `R(X, L)` (`def:testcurve:L1134`) induced by a normalized finitely
generated `ℤ`-filtration, i.e. (by [BHJ17, Prop. 2.15]) by an ample test configuration of
`(X, L)`: `𝓕^λ_m = 𝓕^{⌈λ⌉}_m`. -/
def fgFiltration [IsIntegral X] (hF : F.IsFinitelyGenerated) (h0 : F.piece 0 0 = ⊤) :
    SectionFiltration f a :=
  F.toSectionFiltration (IsFinitelyGenerated.linearlyBounded F hF h0)

@[simp] theorem fgFiltration_piece [IsIntegral X] (hF : F.IsFinitelyGenerated)
    (h0 : F.piece 0 0 = ⊤) (μ : ℝ) (k : ℕ) :
    (F.fgFiltration hF h0).piece μ k = F.piece ⌈μ⌉ k := rfl

end SectionZFiltration

