import SGPT.PSH.SiuL2Correction

/-!
# Siu's uniform global generation on `X × Δ`: the statement

Source `lma:Siu_global_uniform_generatedness` (`chapter_NApotential.tex`, subsection
`subsubsec:analytic_alg`).  Blueprint `claude-siu-l2.tex`, node `claude-siu-l2:siu-gen`
.

*Let `L` be a big line bundle on `X` such that `c₁(L) = {θ}` and `Φ ∈ PSH(X × Δ, p₁^*θ)`, where `Δ` is
the unit disk.  Let `G` be an ample line bundle on `X`.  Then there exists `k > 0`, depending only on
`X` and `G`, such that `p₁^*(G^k ⊗ L^m) ⊗ 𝓘(mΦ)` is globally generated for all `m ∈ ℤ_{>0}`.*

Reading of the objects (book conventions of `subsubsec:analytic_alg`: `θ = c₁(L, h)`):

* `X` is a compact complex manifold; `G` ample is encoded by a smooth metric `h_G` whose curvature
  form `θ_G = c₁(G, h_G)` is Kähler (Kodaira; such an `X` is projective);
* `L` is a holomorphic line bundle with a smooth metric `h_L` and `θ = c₁(L, h_L)`
  (`IsOwnFirstChernForm`); bigness of `L` is not assumed (the statement without it is stronger);
* `Φ ∈ PSH(X × Δ, p₁^*θ)` is `IsThetaPshPotential (p₁^*θ) Φ` on the product manifold `X × Δ`;
* `G^k ⊗ L^m` is `twistedPower L (positivePower G (k - 1)) m = L^m ⊗ G^k`; a section of
  `p₁^*(G^k ⊗ L^m)` over `X × Δ` is a function `(q : X × Δ) → (L^m ⊗ G^k)_{q.1}`, holomorphic when its
  coefficients in all atlas frames are (`IsHolomorphicProdSectionOn`);
* `p₁^*E ⊗ 𝓘(mΦ)` is globally generated (`IsProdGloballyGenerated`): at every point `q` and in every
  frame `e` of `E` at `q.1`, the stalk `𝓘(mΦ)_q` is generated by the `e`-coefficients of the global
  holomorphic sections of `p₁^*E` whose coefficients lie in `𝓘(mΦ)` at every point.

`SiuGlobalUniformGenerationStatement` is the book's statement (`k` depends only on `X` and `G`).
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.NAPotential.SiuGen

open Set Filter
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.ChartwiseGlobalL1
open SGPT.Foundations.Analysis.Pending.ProductComplexManifold
open scoped ProductComplexManifold
open SGPT.Bergman.TensorDictionaryDraft SGPT.Bergman.PolynomialH0Growth
open HermitianHolomorphicLineBundle
open SGPT.PSH.GlobalL2 SGPT.PSH.SiuL2 SGPT.NAPotential.NAGaga

variable {n : ℕ} {X : Type} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X]

/-- A global holomorphic section of `p₁^*E` over `X × Δ` lying in the ideal sheaf `𝓘`: its
coefficient in every atlas frame of `E` lies in `𝓘` at every point over the base set. -/
def IsProdSectionIn (E : HermitianHolomorphicLineBundle.{0, 0} n X) (𝓘 : GermIdeal (n + 1) (X × unitDisc))
    (S : (q : X × unitDisc) → E.Fiber q.1) : Prop :=
  IsHolomorphicProdSectionOn E S univ ∧
    ∀ (q : X × unitDisc) (e : AtlasFrame E), q.1 ∈ e.val.baseSet →
      𝓘.mem q (fun q' => e.val.continuousLinearMapAt ℂ q'.1 (S q'))

/-- **`p₁^*E ⊗ 𝓘` is globally generated on `X × Δ`**: for every point `q`, every atlas frame `e` of
`E` at `q.1` and every germ `g ∈ 𝓘_q`, `g` lies in the `𝒪_q`-span of the `e`-coefficients of the global
sections of `p₁^*E ⊗ 𝓘`. -/
def IsProdGloballyGenerated (E : HermitianHolomorphicLineBundle.{0, 0} n X)
    (𝓘 : GermIdeal (n + 1) (X × unitDisc)) : Prop :=
  ∀ (q : X × unitDisc) (e : AtlasFrame E), q.1 ∈ e.val.baseSet →
    ∀ g : X × unitDisc → ℂ, 𝓘.mem q g →
      IsInSpanAt (n := n + 1) (fun h => ∃ S : (q : X × unitDisc) → E.Fiber q.1,
        IsProdSectionIn E 𝓘 S ∧ h = fun q' => e.val.continuousLinearMapAt ℂ q'.1 (S q')) q g

variable (n X) in
/-- **Source `lma:Siu_global_uniform_generatedness`** (statement).  For every ample `G` (a smooth
metric of Kähler curvature `θ_G`) there is `k > 0` such that for every holomorphic line bundle `L`
with a smooth metric, `θ = c₁(L, h_L)`, every `Φ ∈ PSH(X × Δ, p₁^*θ)` and every `m > 0`, the sheaf
`p₁^*(G^k ⊗ L^m) ⊗ 𝓘(mΦ)` is globally generated on `X × Δ`. -/
def SiuGlobalUniformGenerationStatement [CompactSpace X] : Prop :=
  ∀ G : HermitianHolomorphicLineBundle.{0, 0} n X, IsSourceSmoothHermitianMetric G →
  ∀ θG : ClosedRealOneOneForm n X, IsOwnFirstChernForm G θG → θG.val.IsKahler →
  ∃ k : ℕ, 0 < k ∧
  ∀ L : HermitianHolomorphicLineBundle.{0, 0} n X, IsSourceSmoothHermitianMetric L →
  ∀ θ : ClosedRealOneOneForm n X, IsOwnFirstChernForm L θ →
  ∀ Φ : X × unitDisc → EReal, IsThetaPshPotential
    (ClosedRealOneOneForm.pullback (contMDiff_fst (n := n) (m := 1) (X := X) (Y := unitDisc)) θ).val Φ →
  ∀ m : ℕ, 0 < m →
    IsProdGloballyGenerated (twistedPower L (positivePower G (k - 1)) m)
      (multiplierIdeal (n := n + 1) (m : ℝ) Φ)

end SGPT.NAPotential.SiuGen
