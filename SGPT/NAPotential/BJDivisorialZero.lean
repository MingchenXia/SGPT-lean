import SGPT.NAPotential.BerkovichDivisorial
import Mathlib.AlgebraicGeometry.AlgClosed.Basic

/-!
# BJ divisorial convention and the zero-dimensional comparison case

The archived book and the existing strict `divisorialSet` omit the trivial
valuation; BJ22 and author revision `69360cfd` explicitly include it.
We define the augmented test set and prove
comparison for the actual Berkovich space when the underlying
scheme has one point and each residue field is generated by the given complex
constants. The geometric theorem that `Spec ℂ` satisfies these hypotheses,
and the general BJ psh comparison in positive dimension, remain separate.
No psh comparison or global generation theorem is assumed here.

The existing `PrimeDivisorOver` uses normal proper birational models; BJ22
uses normal projective models. Equality or inclusion of their divisorial sets
is not established here, and the name `bjDivisorialSet` does not assert it.
-/

set_option autoImplicit false
noncomputable section

namespace SGPT.NAPotential

open Set AlgebraicGeometry CategoryTheory

namespace SourceRealValuation

/-- If the base constants exhaust a field, the only source valuation is the
actual trivial valuation. -/
theorem eq_trivial_of_complex_surjective {K : Type*} [Field K] [Algebra ℂ K]
    (hsurj : Function.Surjective (algebraMap ℂ K)) (v : SourceRealValuation K) :
    v = (by classical exact SourceRealValuation.trivial) := by
  classical
  apply SourceRealValuation.ext
  intro a
  obtain ⟨c, rfl⟩ := hsurj a
  by_cases hc : c = 0
  · subst c
    simp [SourceRealValuation.map_zero, SourceRealValuation.trivial]
  · have ha : algebraMap ℂ K c ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap ℂ K).injective).mpr hc
    rw [v.map_complex' c hc]
    simp [SourceRealValuation.trivial, ha]

end SourceRealValuation

namespace Berkovich

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) [IrreducibleSpace X]

/-- BJ-style augmented set: the project's proper-model divisorial points and
the trivial valuation. This does not identify the set with BJ22's set of
projective-model divisorial valuations. The original set is unchanged. -/
def bjDivisorialSet : Set (BerkovichPoint f) :=
  insert (BerkovichPoint.trivial f) (divisorialSet f)

theorem trivial_mem_bjDivisorialSet : BerkovichPoint.trivial f ∈ bjDivisorialSet f := by
  simp [bjDivisorialSet]

theorem divisorialSet_subset_bjDivisorialSet : divisorialSet f ⊆ bjDivisorialSet f := by
  intro v hv
  exact Set.mem_insert_of_mem _ hv

/-- A one-point scheme whose residue field has only the base constants has
one actual Berkovich point. The algebraic source hypotheses are not a
comparison or a disguised generation certificate. -/
theorem berkovichPoint_eq_trivial_of_singleton
    [Subsingleton X]
    (hsurj : ∀ y : X, Function.Surjective (residueComplexHom f y).hom)
    (v : BerkovichPoint f) : v = BerkovichPoint.trivial f := by
  classical
  cases v with
  | mk y w =>
    have hy : y = genericPoint X := Subsingleton.elim y _
    subst y
    have hw : w = @SourceRealValuation.trivial _ _ (residueComplexAlgebra f _) _ :=
      @SourceRealValuation.eq_trivial_of_complex_surjective _ _ (residueComplexAlgebra f _)
        (hsurj (genericPoint X)) w
    cases hw
    rfl

/-- For the one-point source case, comparison on the BJ-style augmented project set gives
comparison at every actual Berkovich point. This is stronger than the
desired special case because the functions are arbitrary; it invokes no
unproved global BJ theorem. -/
theorem le_of_bjDivisorialSet_le_of_singleton
    [Subsingleton X]
    (hsurj : ∀ y : X, Function.Surjective (residueComplexHom f y).hom)
    {α : Type*} [Preorder α] (φ ψ : BerkovichPoint f → α)
    (h : ∀ v ∈ bjDivisorialSet f, φ v ≤ ψ v) : ∀ v, φ v ≤ ψ v := by
  intro v
  rw [berkovichPoint_eq_trivial_of_singleton f hsurj v]
  exact h _ (trivial_mem_bjDivisorialSet f)

omit [IrreducibleSpace X] in
/-- A one-point scheme locally of finite type over ℂ has only the given
complex constants in every residue field. -/
theorem residueComplexHom_surjective_of_singleton
    [Subsingleton X] [LocallyOfFiniteType f] (y : X) :
    Function.Surjective (residueComplexHom f y).hom := by
  have hs : ({y} : Set X) = Set.univ := by
    ext z
    simp [Subsingleton.elim z y]
  have hy : IsClosed ({y} : Set X) := by rw [hs]; exact isClosed_univ
  let e := AlgebraicGeometry.residueFieldIsoBase f y hy
  have he : residueComplexHom f y = e.inv := rfl
  have hi : IsIso (residueComplexHom f y) := by rw [he]; infer_instance
  exact ((ConcreteCategory.isIso_iff_bijective (residueComplexHom f y)).mp hi).2

/-- Source-geometric zero-dimensional comparison, once its connected
zero-dimensional scheme has been identified as a singleton. -/
theorem le_of_bjDivisorialSet_le_of_finiteType_singleton
    [Subsingleton X] [LocallyOfFiniteType f] {α : Type*} [Preorder α]
    (φ ψ : BerkovichPoint f → α)
    (h : ∀ v ∈ bjDivisorialSet f, φ v ≤ ψ v) : ∀ v, φ v ≤ ψ v :=
  le_of_bjDivisorialSet_le_of_singleton f (residueComplexHom_surjective_of_singleton f) φ ψ h

end Berkovich
end SGPT.NAPotential
