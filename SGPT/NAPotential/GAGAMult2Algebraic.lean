/-! ### Germ-level replacement of generators -/

section Span

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-- Generators may be replaced by germ-equal functions. -/
theorem IsInSpanAt.of_eventuallyEq {S T : (M → ℂ) → Prop} {x : M} {g : M → ℂ}
    (h : IsInSpanAt (n := n) S x g) (hST : ∀ s, S s → ∃ t, T t ∧ s =ᶠ[𝓝 x] t) :
    IsInSpanAt (n := n) T x g := by
  obtain ⟨hg, N, s, c, hS, hc, heq⟩ := h
  choose t ht hst using fun i => hST (s i) (hS i)
  refine ⟨hg, N, t, c, ht, hc, heq.trans ?_⟩
  filter_upwards [Filter.eventually_all.mpr hst] with y hy
  exact Finset.sum_congr rfl fun i _ => by rw [hy i]

end Span

/-! ### Frames of the tensor powers -/

section Powers

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

theorem mem_positivePowerAtlasFrame_baseSet {Λ : HermitianHolomorphicLineBundle.{0, 0} n M}
    (e : AtlasFrame Λ) {x : M} (hx : x ∈ e.val.baseSet) :
    ∀ k : ℕ, x ∈ (positivePowerAtlasFrame e k).val.baseSet
  | 0 => hx
  | k + 1 => ⟨mem_positivePowerAtlasFrame_baseSet e hx k, hx⟩

theorem mem_twistedPowerAtlasFrame_unit_baseSet {Λ : HermitianHolomorphicLineBundle.{0, 0} n M}
    (e : AtlasFrame Λ) {x : M} (hx : x ∈ e.val.baseSet) :
    ∀ j : ℕ, x ∈ (twistedPowerAtlasFrame e (unitAtlasFrame (n := n) (M := M)) j).val.baseSet
  | 0 => ⟨Set.mem_univ x, Set.mem_univ x⟩
  | k + 1 => ⟨mem_positivePowerAtlasFrame_baseSet e hx k, Set.mem_univ x⟩

end Powers

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ) [SmoothOfRelativeDimension n f]
  (E : ClosedProjectiveEmbedding f) {L : X.Modules} (a : LineBundleAtlas L)
  (H : SchemeLineBundleMetric f n E L)

local instance algSectionsPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance algSectionsPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

/-! ### Algebraic coefficients of global sections -/

/-- The coefficient in the frame `α^{⊗ j}` of an algebraic section `σ ∈ H⁰(X, L^{⊗ j})`. -/
def algCoef {U : X.Opens} (α : LocalBundleFrame L U) (j : ℕ)
    (σ : bundlePowerGlobalSections L j) : Γ(X, U) :=
  (α.tensorPower j).coefficients (𝟙 U) ((bundleTensorPower L j).val.map (homOfLE le_top).op σ)

/-- Restricting the algebraic coefficient is taking the coefficient of the restriction. -/
theorem coefficients_restrict_top {L' : X.Modules} {U V : X.Opens} (α : LocalBundleFrame L' U)
    (h : V ≤ U) (σ : bundleSections L' ⊤) :
    α.coefficients (homOfLE h) (L'.presheaf.map V.leTop.op σ) =
      X.presheaf.map (homOfLE h).op (α.coefficients (𝟙 U) (L'.val.map (homOfLE le_top).op σ)) := by
  have hc := α.coefficients_restrict (𝟙 U) (homOfLE h) (L'.val.map (homOfLE le_top).op σ)
  have hi : (homOfLE (le_top : U ≤ ⊤)).op ≫ (homOfLE h).op =
      (V.leTop).op := Subsingleton.elim _ _
  rw [← PresheafOfModules.map_comp_apply, hi, Category.comp_id] at hc
  exact hc

/-- The restriction of the algebraic coefficient of `σ` to a smaller open lies in the
algebraic ideal generated by `σ`. -/
theorem restrict_algCoef_mem_sectionZeroIdeal {U V : X.Opens} (α : LocalBundleFrame L U)
    (h : V ≤ U) (j : ℕ) (σ : bundlePowerGlobalSections L j) :
    X.presheaf.map (homOfLE h).op (algCoef α j σ) ∈ sectionZeroIdeal (bundleTensorPower L j) σ V := by
  rw [sectionZeroIdeal_eq_span_frame σ (α.tensorPower j) (homOfLE h),
    coefficients_restrict_top (α.tensorPower j) h σ]
  exact Ideal.subset_span (Set.mem_singleton _)

section Main

variable [IsSeparated f] [QuasiCompact f]

local instance algSectionsPointManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

/-- The frame `α^{⊗ j} ⊗ 1` of `((L, H)^an)^{⊗ j} = twistedPower (L, H)^an 𝟙 j`. -/
def twistedFrame {U : X.Opens} (α : LocalBundleFrame L U) (j : ℕ) :
    AtlasFrame (twistedPower (schemeHermitianLineBundle f n E a H) unit j) :=
  twistedPowerAtlasFrame (schemeHermitianAtlasFrame f n E a H α) unitAtlasFrame j

theorem mem_twistedFrame_baseSet {U : X.Opens} (α : LocalBundleFrame L U) (j : ℕ)
    {p : SchemeComplexPoint f} (hp : schemeComplexPointImage f p ∈ U) :
    p ∈ (twistedFrame f n E a H α j).val.baseSet :=
  mem_twistedPowerAtlasFrame_unit_baseSet _ hp j

/-- `s = σ^an`: in every algebraic frame `α` of the atlas, the coefficient of the holomorphic
section `s` of `((L, H)^an)^{⊗ j}` in `α^{⊗ j}` is the analytic function of the algebraic
coefficient of `σ ∈ H⁰(X, L^{⊗ j})` in `α^{⊗ j}`. -/
def IsAnalytificationOf {j : ℕ} (s : twistedSections (schemeHermitianLineBundle f n E a H) unit j)
    (σ : bundlePowerGlobalSections L j) : Prop :=
  ∀ (i : a.I) (p : SchemeComplexPoint f), schemeComplexPointImage f p ∈ a.opens i →
    (twistedFrame f n E a H (a.frame i) j).val.continuousLinearMapAt ℂ p (s p) =
      schemeOpenRegularFunction f n E (a.opens i) (algCoef (a.frame i) j σ) p

/-- **GAGA for the sections of `L^{⊗ j}`** (statement only; lane SERRE-GAGA): every holomorphic
section of `((L, H)^an)^{⊗ j}` on the compact complex manifold `X(ℂ)` is the analytification of
an algebraic section of `L^{⊗ j}`. -/
def SchemeSectionsAlgebraic (j : ℕ) : Prop :=
  ∀ s : twistedSections (schemeHermitianLineBundle f n E a H) unit j,
    ∃ σ : bundlePowerGlobalSections L j, IsAnalytificationOf f n E a H s σ

variable [MeasurableSpace (SchemeComplexPoint f)] [BorelSpace (SchemeComplexPoint f)]

/-- If `s = σ^an` has finite `L²(e^{-ψ})` norm, the analytic coefficients of `σ` in the atlas
frames lie in `𝓘(ψ)`. -/
theorem mem_multiplierIdeal_algCoef {μ : Measure (SchemeComplexPoint f)}
    (hμ : IsSmoothPositiveVolume (n := n) μ) {θ : SmoothRealForm n (SchemeComplexPoint f) 2}
    {ψ : SchemeComplexPoint f → EReal} (hψ : ThetaPlurisubharmonic θ ψ)
    (hψc : (multiplierIdeal (n := n) 1 ψ).IsCoherent) {j : ℕ}
    {s : twistedSections (schemeHermitianLineBundle f n E a H) unit j}
    (hint : ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight 1 (ψ y) ∂μ < ⊤)
    {σ : bundlePowerGlobalSections L j} (hσ : IsAnalytificationOf f n E a H s σ) (i : a.I)
    {p : SchemeComplexPoint f} (hp : schemeComplexPointImage f p ∈ a.opens i) :
    (multiplierIdeal (n := n) 1 ψ).mem p
      (schemeOpenRegularFunction f n E (a.opens i) (algCoef (a.frame i) j σ)) := by
  have h := mem_multiplierIdeal_of_lintegral_lt_top hμ s hψ one_pos hint
    (twistedFrame f n E a H (a.frame i) j) (mem_twistedFrame_baseSet f n E a H _ j hp)
  refine MonomialPart.mem_congr_of_isCoherent hψc h ?_
  have hO : IsOpen (schemeComplexPointImage f ⁻¹' (a.opens i : Set X)) :=
    (a.opens i).isOpen.preimage (schemeComplexPointImage_continuous f)
  filter_upwards [hO.mem_nhds hp] with y hy
  exact hσ i y hy

/-- The algebraic ideal sheaf generated by an algebraic section `σ` with `σ^an ∈ L²(e^{-ψ})`
lies in the algebraic model of `𝓘(ψ)`. -/
theorem sectionZeroIdealSheaf_le_algebraization {μ : Measure (SchemeComplexPoint f)}
    (hμ : IsSmoothPositiveVolume (n := n) μ) {θ : SmoothRealForm n (SchemeComplexPoint f) 2}
    {ψ : SchemeComplexPoint f → EReal} (hψ : ThetaPlurisubharmonic θ ψ)
    (hψc : (multiplierIdeal (n := n) 1 ψ).IsCoherent) {j : ℕ}
    {s : twistedSections (schemeHermitianLineBundle f n E a H) unit j}
    (hint : ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight 1 (ψ y) ∂μ < ⊤)
    {σ : bundlePowerGlobalSections L j} (hσ : IsAnalytificationOf f n E a H s σ) :
    sectionZeroIdealSheaf (a.tensorPower j) σ ≤
      algebraization f n E (multiplierIdeal (n := n) 1 ψ) := by
  unfold algebraization
  rw [Scheme.IdealSheafData.le_ofIdeals_iff]
  intro W t ht
  refine Ideal.subset_span fun p hp => ?_
  obtain ⟨i, hi⟩ := a.covers (schemeComplexPointImage f p)
  let W' : X.Opens := (W : X.Opens) ⊓ a.opens i
  have hpW' : schemeComplexPointImage f p ∈ W' := ⟨hp, hi⟩
  -- the restriction of `t` to `W'` is a multiple of the coefficient of `σ`
  have ht' : X.presheaf.map (homOfLE (inf_le_left : W' ≤ W)).op t ∈
      sectionZeroIdeal (bundleTensorPower L j) σ W' := by
    obtain ⟨β, rfl⟩ := ht
    exact ⟨_, sectionZeroEvaluation_restrict _ σ (inf_le_left : W' ≤ W) β⟩
  rw [sectionZeroIdeal_eq_span_frame σ ((a.frame i).tensorPower j)
    (homOfLE (inf_le_right : W' ≤ a.opens i)),
    coefficients_restrict_top ((a.frame i).tensorPower j) inf_le_right σ] at ht'
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ht'
  have hmem := mem_multiplierIdeal_algCoef f n E a H hμ hψ hψc hint hσ i hi
  refine GermIdealTotalTransform.mem_of_isInSpanAt_mem hψc ⟨?_, 1,
    fun _ => schemeOpenRegularFunction f n E (a.opens i) (algCoef (a.frame i) j σ),
    fun _ => schemeOpenRegularFunction f n E W' b, fun _ => hmem,
    fun _ => schemeOpenRegularFunction_holomorphicAt f n E W' b p hpW', ?_⟩
  · exact schemeOpenRegularFunction_holomorphicAt f n E W t p hp
  · have hO : IsOpen (schemeComplexPointImage f ⁻¹' (W' : Set X)) :=
      W'.isOpen.preimage (schemeComplexPointImage_continuous f)
    filter_upwards [hO.mem_nhds hpW'] with y hy
    simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton]
    rw [← schemeOpenRegularFunction_restrict f n E W' W inf_le_left t hy, ← hb,
      schemeOpenRegularFunction_mul f n E W' _ _ hy]
    beta_reduce
    rw [schemeOpenRegularFunction_restrict f n E W' (a.opens i) inf_le_right _ hy]
    rfl

variable [CompactSpace (SchemeComplexPoint f)]

/-- `𝓘(1 · (cφ)) = 𝓘(cφ)`. -/
theorem multiplierIdeal_one_mul {c : ℝ} (hc : 0 < c) (φ : SchemeComplexPoint f → EReal) :
    multiplierIdeal (n := n) 1 (fun y => (c : EReal) * φ y) = multiplierIdeal (n := n) c φ := by
  have hw : ∀ t : EReal, multiplierWeight 1 ((c : EReal) * t) = multiplierWeight c t := by
    intro t; unfold multiplierWeight; rw [EReal.coe_one, one_mul]
  have hdens : ∀ (e : ComplexChart n (SchemeComplexPoint f)) (g : ComplexModel n → ℂ),
      multiplierDensity (chartFunction (fun y => (c : EReal) * φ y) e) 1 g =
        multiplierDensity (chartFunction φ e) c g := by
    intro e g; funext z
    simp only [multiplierDensity, chartFunction, hw]
  ext y g
  simp only [multiplierIdeal, MultiplierIntegrableAt, WeightedL2On, hdens, hc, zero_lt_one,
    true_and]

/-- **Algebraicity of multiplier ideals** (blueprint `claude-gagamult2:mult-alg`).  If the
metric `H` of the algebraic line bundle `L` has positive curvature and GAGA holds for the
sections of `L^{⊗ j}`, `j ≫ 0`, then `𝓘(cφ) ⊆ alg(𝓘(cφ))^an` for every quasi-psh `φ` on `X(ℂ)`
and `c > 0`. -/
theorem multiplierIdeal_le_analytificationIdeal_algebraization
    (hpos : (H.curvature a).val.IsKahler)
    (hgaga : ∀ᶠ j in atTop, SchemeSectionsAlgebraic f n E a H j)
    {φ : SchemeComplexPoint f → EReal} (hφ : IsGlobalQuasiPshPotential (n := n) φ) {c : ℝ}
    (hc : 0 < c) :
    (multiplierIdeal (n := n) c φ).Le
      (analytificationIdeal f n E (algebraization f n E (multiplierIdeal (n := n) c φ))) := by
  let ωb : KahlerBackground n (SchemeComplexPoint f) := ⟨H.curvature a, hpos⟩
  let μ := IntegrationCurrent.kahlerVolume ωb
  have hμ : IsSmoothPositiveVolume (n := n) μ :=
    KahlerVolumeSmoothPositive.isSmoothPositiveVolume_kahlerVolume ωb
  obtain ⟨θ, hθ⟩ :=
    (GlobalQuasiPshKahlerBackground.isGlobalQuasiPshPotential_iff_exists_closed_background ωb
      φ).mp hφ
  set ψ : SchemeComplexPoint f → EReal := fun y => (c : EReal) * φ y with hψdef
  have hψ : IsThetaPshPotential (c • θ).val ψ := by
    refine ⟨GlobalMultilinearExpansion.thetaPlurisubharmonic_smul hc hθ.1,
      fun y U hU hyU => ?_⟩
    obtain ⟨z, hz, hne⟩ := hθ.2 y U hU hyU
    refine ⟨z, hz, ?_⟩
    show (c : EReal) * φ z ≠ ⊥
    induction h : φ z using EReal.rec with
    | bot => exact absurd h hne
    | coe t => rw [← EReal.coe_mul]; exact EReal.coe_ne_bot _
    | top => rw [EReal.coe_mul_top_of_pos hc]; exact top_ne_bot
  have hψc : (multiplierIdeal (n := n) 1 ψ).IsCoherent :=
    SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine
      ⟨hψ.1.quasiPlurisubharmonic, hψ.2⟩ one_pos
  rw [← multiplierIdeal_one_mul f n hc φ]
  obtain ⟨j₀, hj₀⟩ := siuGlobalGeneration_fixedWeight ωb hμ
    (isSourceSmoothHermitianMetric_schemeHermitianLineBundle f n E a H)
    (isOwnFirstChernForm_schemeHermitianLineBundle f n E a H) hψ
  obtain ⟨j, hgj, hjj⟩ := (hgaga.and (eventually_ge_atTop j₀)).exists
  intro x g hg
  obtain ⟨i, hi⟩ := a.covers (schemeComplexPointImage f x)
  have hgen := (hj₀ j hjj x (twistedFrame f n E a H (a.frame i) j)
    (mem_twistedFrame_baseSet f n E a H (a.frame i) j hi) g).mp hg
  show IsInSpanAt (n := n) (fun s => ∃ (U : X.affineOpens)
      (_ : schemeComplexPointImage f x ∈ (U : X.Opens)) (r : Γ(X, U)),
        r ∈ (algebraization f n E (multiplierIdeal (n := n) 1 ψ)).ideal U ∧
        s = schemeOpenRegularFunction f n E U r) x g
  refine IsInSpanAt.of_eventuallyEq hgen ?_
  rintro _ ⟨s, hint, rfl⟩
  obtain ⟨σ, hσ⟩ := hgj s
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVi⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hi (a.opens i).isOpen
  let V' : X.affineOpens := ⟨V, hV⟩
  have hVi' : (V : X.Opens) ≤ a.opens i := hVi
  refine ⟨schemeOpenRegularFunction f n E V
      (X.presheaf.map (homOfLE hVi').op (algCoef (a.frame i) j σ)),
    ⟨V', hxV, _, ?_, rfl⟩, ?_⟩
  · exact sectionZeroIdealSheaf_le_algebraization f n E a H hμ hψ.1 hψc hint hσ V'
      (restrict_algCoef_mem_sectionZeroIdeal (a.frame i) hVi' j σ)
  · have hO : IsOpen (schemeComplexPointImage f ⁻¹' (V : Set X)) :=
      (V' : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f)
    filter_upwards [hO.mem_nhds hxV] with y hy
    rw [hσ i y (hVi' hy), schemeOpenRegularFunction_restrict f n E V (a.opens i) hVi' _ hy]

/-- With the converse inclusion `alg(I)^an ⊆ I` for coherent `I`: `alg(𝓘(cφ))^an = 𝓘(cφ)`. -/
theorem analytificationIdeal_algebraization_multiplierIdeal
    (hpos : (H.curvature a).val.IsKahler)
    (hgaga : ∀ᶠ j in atTop, SchemeSectionsAlgebraic f n E a H j)
    {φ : SchemeComplexPoint f → EReal} (hφ : IsGlobalQuasiPshPotential (n := n) φ) {c : ℝ}
    (hc : 0 < c) :
    analytificationIdeal f n E (algebraization f n E (multiplierIdeal (n := n) c φ)) =
      multiplierIdeal (n := n) c φ := by
  have h1 := analytificationIdeal_algebraization_le f n E (multiplierIdeal (n := n) c φ)
    (SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine hφ hc)
  have h2 := multiplierIdeal_le_analytificationIdeal_algebraization f n E a H hpos hgaga hφ hc
  ext x g
  exact ⟨h1 x g, h2 x g⟩

end Main

/-- **`MultiplierIdealAlgebraic` from a positively curved algebraic line bundle and GAGA for its
sections.** -/
theorem multiplierIdealAlgebraic_of_positive
    (hpos : letI := E.isSeparated; letI := E.quasiCompact;
      letI := schemeAnalyticTN_isComplexManifold f n; (H.curvature a).val.IsKahler)
    (hgaga : letI := E.isSeparated; letI := E.quasiCompact;
      ∀ᶠ j in atTop, SchemeSectionsAlgebraic f n E a H j) :
    MultiplierIdealAlgebraic f n E := by
  let := E.isSeparated
  let := E.quasiCompact
  let : MeasurableSpace (SchemeComplexPoint f) := borel _
  have : BorelSpace (SchemeComplexPoint f) := ⟨rfl⟩
  have : CompactSpace (SchemeComplexPoint f) := E.analyticCompact
  intro φ hφ c hc
  exact multiplierIdeal_le_analytificationIdeal_algebraization f n E a H hpos hgaga hφ hc

end SGPT.NAPotential.GAGAMult
