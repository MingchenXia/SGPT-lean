import SGPT.NAPotential.TowerAlgReflect

/-!
# `BlowupPrimesRealized` is a statement about valuations of `ℂ(X)`


`SGPT.NAPotential.DivDict2.BlowupPrimesRealized` asks, for every prime divisor `E` on a blow-up
tower of `X(ℂ)`, for an *algebraic* prime divisor `D` over `X` (a `PrimeDivisorOver X`: a codimension
one point of a normal proper birational model) with `ord_D(𝔞) = ord_E(π^*𝔞^an)` for every ideal
sheaf `𝔞`, at every point of `E` (`PrimeDivisorOver.IsRealizedBy`).

* `isCoherent_analytificationIdeal`: `𝔞^an` is coherent (generated near every point by finitely
  many sections over an affine open);
* `isNonzeroAt_pullback_analytificationIdeal`: for `𝔞 ≠ 0` its pull-back to a modification is
  nonzero at every point;
* `idealVal_anDivVal_eq_of_mem`: the value of the analytic divisorial valuation `t ord_E`
  (`SGPT.NAPotential.TowerAlg.anDivVal`) on `𝔞` is `t · ord_{E,y}(π^*𝔞^an)` at **every** point
  `y ∈ E` and every flattening (the order is constant along the connected `E`);
* `isRealizedBy_of_ordVal_eq`: an algebraic prime divisor `D` over `X` whose divisorial valuation
  `ord_D` is the analytic divisorial valuation `ord_E` is realized by `E`;
* **`blowupPrimesRealized_of_anDivVal`**: `BlowupPrimesRealized` follows from the valuation-level
  statement *the analytic divisorial valuation `ord_E` of every prime divisor `E` on a blow-up
  tower is `ord_D` for some algebraic prime divisor `D` over `X`*
  (`AnalyticDivisorialValuationsAlgebraic`).  No scheme morphism from the analytic tower to `X`
  is needed; what remains is the classical fact that a divisorial valuation of `ℂ(X)` (here: a
  discrete valuation whose valuation ring is essentially of finite type over `ℂ`) has a normal
  proper birational model with a prime divisor computing it.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.TowerAlg

open Set Filter
open scoped Topology ENNReal
open AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.PSH.CompactPrimeOver SGPT.NAPotential.Berkovich
open DemaillyApproximantDivisorialLelong FixedGermNormalOrder

variable {X : Scheme.{0}} {f : X ⟶ Spec (.of ℂ)} {m : ℕ} [SmoothOfRelativeDimension (m + 1) f]
  (E : ClosedProjectiveEmbedding f) [IsProper f]

local instance towerAlgRealizePointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance towerAlgRealizePointCharts :
    ChartedSpace (ComplexModel (m + 1)) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f (m + 1)
local instance towerAlgRealizePointManifold : IsComplexManifold (m + 1) (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f (m + 1)

/-- **`𝔞^an` is coherent**: near every point it is generated by the analytic functions of finitely
many generators of `𝔞(U₀)`, `U₀` an affine open. -/
theorem isCoherent_analytificationIdeal (𝔞 : X.IdealSheafData) :
    (analytificationIdeal f (m + 1) E 𝔞).IsCoherent := by
  intro x
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨U₀, hU₀⟩ := exists_affineOpen_mem (schemeComplexPointImage f x)
  have : IsNoetherianRing Γ(X, U₀) := IsLocallyNoetherian.component_noetherian U₀
  obtain ⟨N, r, hr⟩ : ∃ (N : ℕ) (r : Fin N → Γ(X, U₀)), Ideal.span (range r) = 𝔞.ideal U₀ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian _)
  refine ⟨schemeComplexPointImage f ⁻¹' ((U₀ : X.Opens) : Set X),
    (U₀ : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f), hU₀, N,
    fun j => schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j), fun j => ?_,
    fun y hy g => analytificationIdeal_mem_iff_isInSpanAt E y U₀ hy 𝔞 r hr g⟩
  exact schemeOpenRegularFunction_mdifferentiableOn f (m + 1) E (U₀ : X.Opens) (r j)

variable [IsIntegral X]

/-- A nonzero ideal sheaf of the integral `X` has nonzero sections on every affine open. -/
theorem ideal_ne_bot_of_ne_bot {𝔞 : X.IdealSheafData} (h𝔞 : 𝔞 ≠ ⊥) (U : X.affineOpens)
    (hU : ((U : X.Opens) : Set X).Nonempty) : 𝔞.ideal U ≠ ⊥ := by
  intro hbot
  have hη : genericPoint X ∈ (U : X.Opens) :=
    ((genericPoint_spec X).mem_open_set_iff (U : X.Opens).isOpen).mpr
      (by simpa only [Set.univ_inter] using hU)
  have h1 := Berkovich.stalkIdeal_genericPoint_eq_top h𝔞
  rw [stalkIdeal_eq_map 𝔞 U hη, hbot, Ideal.map_bot] at h1
  exact bot_ne_top h1

/-- **The pull-back of `𝔞^an` to a modification is nonzero at every point** (`𝔞 ≠ 0`). -/
theorem isNonzeroAt_pullback_analytificationIdeal {Y : Type} [TopologicalSpace Y]
    [ChartedSpace (ComplexModel (m + 1)) Y] [IsComplexManifold (m + 1) Y] {π : Y → SchemeComplexPoint f}
    (hπ : AnalyticModificationLocalDiscrepancy.IsAnalyticModification (n := m + 1) π)
    {𝔞 : X.IdealSheafData} (h𝔞 : 𝔞 ≠ ⊥) (y : Y) :
    DivisorExponent.IsNonzeroAt
      (GermIdeal.pullback (m := m + 1) π (analytificationIdeal f (m + 1) E 𝔞)) y := by
  obtain ⟨U₀, hU₀⟩ := exists_affineOpen_mem (schemeComplexPointImage f (π y))
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (ideal_ne_bot_of_ne_bot h𝔞 U₀ ⟨_, hU₀⟩)
  have hhol := schemeOpenRegularFunction_holomorphicAt f (m + 1) E (U₀ : X.Opens) r (π y) hU₀
  have hfreq : ∃ᶠ x in 𝓝 (π y), schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) r x ≠ 0 := by
    intro hev
    apply hr0
    apply germ_injective_of_isIntegral X (schemeComplexPointImage f (π y)) hU₀
    rw [map_zero]
    apply schemeNativeStalkGerm_injective f (m + 1) (π y)
    rw [map_zero, ← schemeOpenRegularFunction_germ f (m + 1) E (U₀ : X.Opens) r (π y) hU₀]
    have h0 : (0 : NativeHolGerm (m + 1) (SchemeComplexPoint f) (π y)) =
        NativeHolGerm.mk (fun _ => (0 : ℂ)) (holomorphicAt_const 0) := rfl
    rw [h0]
    apply NativeHolGerm.mk_eq_mk_iff.mpr
    filter_upwards [hev] with x hx
    exact not_ne_iff.mp hx
  refine ⟨schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) r ∘ π, ?_,
    MultiplierPullbackNonzero.frequently_comp_ne_zero hπ y hhol hfreq⟩
  refine InvertibleIdealQuotient.isInSpanAt_self
    (S := fun s => ∃ a, (analytificationIdeal f (m + 1) E 𝔞).mem (π y) a ∧ s = a ∘ π)
    ⟨_, ?_, rfl⟩ (hhol.comp_contMDiff (Eventually.of_forall fun _ => hπ.1.contMDiffAt))
  exact (analytificationIdeal_mem_iff f (m + 1) E 𝔞 (π y) _).mpr
    (InvertibleIdealQuotient.isInSpanAt_self ⟨U₀, hU₀, r, hr, rfl⟩ hhol)

variable (p : PrimePresentation (m + 1) (SchemeComplexPoint f))

omit [IsIntegral X] in
/-- The order of `π^*0^an` along `E` is `∞` at every point. -/
theorem originalStalkNormalOrder_pullback_analytificationIdeal_bot {y : p.model}
    (Φ : DivisorFlattening (m := m) p.divisor y) :
    originalStalkNormalOrder Φ (GermIdeal.pullback (m := m + 1) p.projection
      (analytificationIdeal f (m + 1) E ⊥)) = ⊤ := by
  obtain ⟨U₀, hU₀⟩ := exists_affineOpen_mem (schemeComplexPointImage f (p.projection y))
  rw [originalStalkNormalOrder_pullback_analytificationIdeal p Φ E U₀ hU₀ ⊥]
  refine le_antisymm le_top (le_iInf₂ fun r hr => ?_)
  rw [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Ideal.mem_bot] at hr
  rw [hr, map_zero, stalkOrd_zero]

/-- **The analytic divisorial valuation computes the order along `E` at every point of `E`**:
`(t ord_E)(𝔞) = t · ord_{E,y}(π^*𝔞^an)` for all `y ∈ E` and all flattenings at `y` (not only at
the base point `y₀` used to define it). -/
theorem idealVal_anDivVal_eq_of_mem {y₀ : p.model} (Φ₀ : DivisorFlattening (m := m) p.divisor y₀)
    (t : ℝ) (ht : 0 < t) (𝔞 : X.IdealSheafData) {y : p.model} (hy : y ∈ p.divisor)
    (Φ : DivisorFlattening (m := m) p.divisor y) :
    (anDivVal p Φ₀ t ht).idealVal 𝔞 = ENNReal.ofReal t *
      ((originalStalkNormalOrder Φ (GermIdeal.pullback (m := m + 1) p.projection
        (analytificationIdeal f (m + 1) E 𝔞)) : ℕ∞) : ℝ≥0∞) := by
  rw [idealVal_anDivVal_eq p Φ₀ E t ht 𝔞]
  congr 2
  by_cases h𝔞 : 𝔞 = ⊥
  · subst h𝔞
    rw [originalStalkNormalOrder_pullback_analytificationIdeal_bot E p Φ₀,
      originalStalkNormalOrder_pullback_analytificationIdeal_bot E p Φ]
  · have hE := primePresentation_smooth_hypersurface m p
    have hy₀ : y₀ ∈ p.divisor :=
      (IdealPowerNormalOrder.regularAtDim_of_divisorFlattening Φ₀).2.1
    obtain ⟨a, ha⟩ := IdealPowerNormalOrder.exists_originalStalkNormalOrder_on_connected_hypersurface
      hE _ (GermIdealPullbackCalculus.isCoherent_pullback p.modification.1
        (isCoherent_analytificationIdeal E 𝔞))
      (isNonzeroAt_pullback_analytificationIdeal E p.modification h𝔞)
    rw [ha y₀ hy₀ Φ₀, ha y hy Φ]

/-- **An algebraic prime divisor computing the analytic divisorial valuation is realized**: if
`ord_D = ord_E` as valuations of `ℂ(X)` (`D.ordVal f 1 = anDivVal p Φ₀ 1`), then `D` is realized by
the analytic presentation `p` (`PrimeDivisorOver.IsRealizedBy`). -/
theorem isRealizedBy_of_ordVal_eq {y₀ : p.model} (Φ₀ : DivisorFlattening (m := m) p.divisor y₀)
    {D : PrimeDivisorOver X} (hD : D.ordVal f 1 one_pos = anDivVal p Φ₀ 1 one_pos) :
    D.IsRealizedBy m E p := by
  intro 𝔞 y hy Φ
  rw [PrimeDivisorOver.ordIdeal, hD, idealVal_anDivVal_eq_of_mem E p Φ₀ 1 one_pos 𝔞 hy Φ,
    ENNReal.ofReal_one, one_mul]

variable (m) in
/-- **The valuation-level form of `BlowupPrimesRealized`**: for every prime divisor `E` on a
finite blow-up tower of `X(ℂ)` (smooth centres), the analytic divisorial valuation `ord_E` of
`ℂ(X)` (`anDivVal`, defined through the analytic order along `E`) is the divisorial valuation
`ord_D` of an algebraic prime divisor `D` over `X`.  (A statement; not proved here.) -/
def AnalyticDivisorialValuationsAlgebraic : Prop :=
  ∀ p : PrimePresentation (m + 1) (SchemeComplexPoint f), DivDict2.IsBlowupPresentation p →
    ∃ (y₀ : p.model) (Φ₀ : DivisorFlattening (m := m) p.divisor y₀) (D : PrimeDivisorOver X),
      D.ordVal f 1 one_pos = anDivVal p Φ₀ 1 one_pos

/-- **`BlowupPrimesRealized` reduces to the valuation-level statement**: no scheme model of the
analytic tower and no morphism to `X` are needed beyond an algebraic prime divisor computing the
analytic divisorial valuation. -/
theorem blowupPrimesRealized_of_anDivVal (h : AnalyticDivisorialValuationsAlgebraic (f := f) m) :
    DivDict2.BlowupPrimesRealized (f := f) m E := by
  intro p hp
  obtain ⟨y₀, Φ₀, D, hD⟩ := h p hp
  exact ⟨D, isRealizedBy_of_ordVal_eq E p Φ₀ hD⟩

end SGPT.NAPotential.TowerAlg

end
