import SGPT.NAPotential.TowerAlgValuation
import Mathlib.Algebra.Order.Floor.Extended

/-!
# Values of the analytic divisorial valuation on ideal sheaves


For the analytic divisorial valuation `t · ord_D = anDivVal p Φ₀ t ht` (lane file
`TowerAlgValuation`) and every ideal sheaf `𝔞` of `X`:

* `center_anDivVal_specializes`: the centre of `t · ord_D` is a generization of `P₀`;
* `idealVal_anDivVal`: `(t ord_D)(𝔞) = t · inf_{r ∈ 𝔞(U₀)} ord_D(r)` for an affine open
  `U₀ ∋ P₀`;
* `isInSpanAt_analytificationIdeal_iff`: finitely many generators of `𝔞(U₀)` generate the
  analytification `𝔞^an` at `π(y₀)` (the stalk of a quasi-coherent ideal at `P₀` is generated by
  `𝔞(U₀)`, and the analytic germ map is a ring map);
* **`idealVal_anDivVal_eq`**: `(t ord_D)(𝔞) = t · ord_{D,y₀}(π^*𝔞^an)`, the value of the
  analytic divisorial valuation on `𝔞` is `t` times the order of vanishing along `D` at `y₀` of
  the pulled back analytic ideal `𝔞^an 𝒪_Y` (the analytic side of
  `SGPT.NAPotential.Berkovich.PrimeDivisorOver.IsRealizedBy`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.TowerAlg

open Set Filter
open scoped Topology ENNReal WithZero
open AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.PSH.CompactPrimeOver SGPT.NAPotential.Berkovich
open DemaillyApproximantDivisorialLelong FixedGermNormalOrder RelativePrincipalizationSpan

/-! ### Centres of semi-valuations that are nonnegative on a local ring -/

section Center

variable {X : Scheme.{0}} {f : X ⟶ Spec (.of ℂ)} [IsProper f]

/-- If a semi-valuation is `≥ 0` on `𝒪_{X,x}` (for a point `x` of its support), its centre is a
generization of `x` (valuative criterion of separatedness). -/
theorem center_specializes_of_nonneg (v : BerkovichPoint f) {x : X}
    (h : v.support ⤳ x)
    (hnn : ∀ g : X.presheaf.stalk x, 0 ≤ v.valAt ((BerkovichPoint.specializationMap h).hom g)) :
    v.center ⤳ x := by
  have hc := v.isCenter_center
  let φ : X.presheaf.stalk x ⟶ CommRingCat.of v.valuationRing :=
    CommRingCat.ofHom ((BerkovichPoint.specializationMap h).hom.codRestrict v.valuationRing
      (fun g => (v.mem_valuationRing_iff _).mpr (hnn g)))
  let L : Spec (CommRingCat.of v.valuationRing) ⟶ X := Spec.map φ ≫ X.fromSpecStalk x
  have hφ : φ ≫ BerkovichPoint.valuationRingIncl v = BerkovichPoint.specializationMap h := by
    ext g
    rfl
  have hL : Spec.map (BerkovichPoint.valuationRingIncl v) ≫ L =
      X.fromSpecResidueField v.support := by
    rw [← Category.assoc, ← Spec.map_comp, hφ, BerkovichPoint.specializationMap, Spec.map_comp,
      Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    rfl
  let S : ValuativeCommSq f :=
    { R := v.valuationRing
      K := X.residueField v.support
      i₁ := X.fromSpecResidueField v.support
      i₂ := hc.lift ≫ f
      commSq := ⟨by rw [← hc.spec_map_incl_lift, Category.assoc]⟩ }
  have hsub : Subsingleton S.commSq.LiftStruct := IsSeparated.valuativeCriterion f S
  let l₁ : S.commSq.LiftStruct := ⟨hc.lift, hc.spec_map_incl_lift, rfl⟩
  have e1 : Spec.map (BerkovichPoint.valuationRingIncl v) ≫ L ≫ f =
      X.fromSpecResidueField v.support ≫ f := by
    rw [← Category.assoc, hL]
  have e2 : Spec.map (BerkovichPoint.valuationRingIncl v) ≫ hc.lift ≫ f =
      X.fromSpecResidueField v.support ≫ f := by
    rw [← Category.assoc, hc.spec_map_incl_lift]
  let l₂ : S.commSq.LiftStruct :=
    ⟨L, hL, BerkovichPoint.eq_of_spec_map_incl_comp v (e1.trans e2.symm)⟩
  have hl : hc.lift = L := congrArg (fun l => l.l) (Subsingleton.elim l₁ l₂)
  have hcen : v.center = L (IsLocalRing.closedPoint (CommRingCat.of v.valuationRing)) := by
    rw [← hl, hc.lift_closedPoint]
  have hmem : L (IsLocalRing.closedPoint (CommRingCat.of v.valuationRing)) ∈
      Set.range (X.fromSpecStalk x) :=
    ⟨Spec.map φ (IsLocalRing.closedPoint (CommRingCat.of v.valuationRing)), rfl⟩
  rw [Scheme.range_fromSpecStalk] at hmem
  rw [hcen]
  exact hmem

end Center

variable {X : Scheme.{0}} {f : X ⟶ Spec (.of ℂ)} {m : ℕ} [SmoothOfRelativeDimension (m + 1) f]
  [IsProper f]

local instance towerAlgIdealPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance towerAlgIdealPointCharts :
    ChartedSpace (ComplexModel (m + 1)) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f (m + 1)
local instance towerAlgIdealPointManifold : IsComplexManifold (m + 1) (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f (m + 1)

variable [IsIntegral X] (p : PrimePresentation (m + 1) (SchemeComplexPoint f))
  {y₀ : p.model} (Φ₀ : DivisorFlattening (m := m) p.divisor y₀)

/-- The centre of `t · ord_D` is a generization of `P₀`. -/
theorem center_anDivVal_specializes (t : ℝ) (ht : 0 < t) :
    (anDivVal p Φ₀ t ht).center ⤳ schemeComplexPointImage f (p.projection y₀) :=
  center_specializes_of_nonneg _ (genericPoint_specializes _)
    (valAt_anDivVal_nonneg p Φ₀ t ht)

/-- **`(t ord_D)(𝔞)` on an affine open `U₀ ∋ P₀`**: `t · inf_{r ∈ 𝔞(U₀)} ord_D(r)`. -/
theorem idealVal_anDivVal (t : ℝ) (ht : 0 < t) (U₀ : X.affineOpens)
    (hU₀ : schemeComplexPointImage f (p.projection y₀) ∈ (U₀ : X.Opens)) (𝔞 : X.IdealSheafData) :
    (anDivVal p Φ₀ t ht).idealVal 𝔞 =
      ⨅ r ∈ 𝔞.ideal U₀, ENNReal.ofReal t *
        (stalkOrd p Φ₀ ((X.presheaf.germ (U₀ : X.Opens) _ hU₀).hom r) : ℝ≥0∞) := by
  have hc : (anDivVal p Φ₀ t ht).center ∈ (U₀ : X.Opens) :=
    (center_anDivVal_specializes p Φ₀ t ht).mem_open (U₀ : X.Opens).isOpen hU₀
  rw [BerkovichPoint.idealVal_eq_iInf_sectionVal _ 𝔞 U₀ hc]
  refine iInf_congr fun r => iInf_congr fun _ => ?_
  rw [← BerkovichPoint.valAt_specializationMap_germ _ (genericPoint_specializes _) _ hU₀ r]
  exact toENNReal_valAt_anDivVal p Φ₀ t ht _

/-! ### The analytic side: finite algebraic generation of `𝔞^an` -/

section Analytic

variable (E : ClosedProjectiveEmbedding f)

omit [IsIntegral X] in
/-- **Finitely many generators of `𝔞(U₀)` generate `𝔞^an`** at a complex point `x` with scheme
point in the affine open `U₀`: the stalk `𝔞_x` is generated by `𝔞(U₀)` and the analytic germ
map is a ring map. -/
theorem analytificationIdeal_mem_iff_isInSpanAt (x : SchemeComplexPoint f) (U₀ : X.affineOpens)
    (hU₀ : schemeComplexPointImage f x ∈ (U₀ : X.Opens)) (𝔞 : X.IdealSheafData) {N : ℕ}
    (r : Fin N → Γ(X, U₀)) (hr : Ideal.span (range r) = 𝔞.ideal U₀)
    (g : SchemeComplexPoint f → ℂ) :
    (analytificationIdeal f (m + 1) E 𝔞).mem x g ↔
      IsInSpanAt (n := m + 1)
        (· ∈ range fun j => schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j)) x g := by
  constructor
  · intro hg
    refine IsInSpanAt.trans ?_ ((analytificationIdeal_mem_iff f (m + 1) E 𝔞 x g).mp hg)
    rintro s ⟨U, hU, r', hr', rfl⟩
    have hmem : (X.presheaf.germ (U : X.Opens) _ hU).hom r' ∈
        Ideal.span (range fun j => (X.presheaf.germ (U₀ : X.Opens) _ hU₀).hom (r j)) := by
      have h1 := germ_mem_stalkIdeal 𝔞 U hU hr'
      rw [stalkIdeal_eq_map 𝔞 U₀ hU₀, ← hr, Ideal.map_span, ← Set.range_comp] at h1
      exact h1
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
    let C : Fin N → SchemeComplexPoint f → ℂ := fun j => stalkRep m x (c j)
    have hC : ∀ j, HolomorphicAt (m + 1) (C j) x := fun j => stalkRep_holomorphicAt x (c j)
    have hval : ((schemeOpenRegularFunction f (m + 1) E (U : X.Opens) r' :
          SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) =
        ((fun y => ∑ j, C j y * schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j) y :
          SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) := by
      have h1 := congrArg (fun a => ((schemeNativeStalkGerm f (m + 1) x a :
        NativeHolGerm (m + 1) (SchemeComplexPoint f) x) : Germ (𝓝 x) ℂ)) hc
      simp only [map_sum, map_mul] at h1
      rw [← schemeOpenRegularFunction_germ f (m + 1) E (U : X.Opens) r' x hU] at h1
      change ((NativeHolGerm.mk (schemeOpenRegularFunction f (m + 1) E (U : X.Opens) r')
        (schemeOpenRegularFunction_holomorphicAt f (m + 1) E (U : X.Opens) r' x hU) :
          NativeHolGerm (m + 1) (SchemeComplexPoint f) x) : Germ (𝓝 x) ℂ) = _
      rw [← h1]
      simp only [AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul]
      have h2 : ∀ j, ((schemeNativeStalkGerm f (m + 1) x
          ((X.presheaf.germ (U₀ : X.Opens) _ hU₀).hom (r j)) :
            NativeHolGerm (m + 1) (SchemeComplexPoint f) x) : Germ (𝓝 x) ℂ) =
          ((schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j) :
            SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) := by
        intro j
        rw [← schemeOpenRegularFunction_germ f (m + 1) E (U₀ : X.Opens) (r j) x hU₀]
        rfl
      have h3 : ∀ j, ((schemeNativeStalkGerm f (m + 1) x (c j) :
            NativeHolGerm (m + 1) (SchemeComplexPoint f) x) : Germ (𝓝 x) ℂ) =
          ((C j : SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) := by
        intro j
        rw [schemeNativeStalkGerm_eq_mk_stalkRep]
        rfl
      simp only [h2, h3]
      have h5 : ((fun y => ∑ j, C j y * schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j) y :
          SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ) = Germ.coeRingHom (R := ℂ) (𝓝 x)
            (∑ j, C j * schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j)) := by
        change _ = ((∑ j, C j * schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j) :
          SchemeComplexPoint f → ℂ) : Germ (𝓝 x) ℂ)
        congr 1
        funext y
        simp [Finset.sum_apply]
      rw [h5, map_sum]
      simp only [map_mul]
      rfl
    refine ⟨schemeOpenRegularFunction_holomorphicAt f (m + 1) E (U : X.Opens) r' x hU, N,
      fun j => schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j), C,
      fun j => ⟨j, rfl⟩, hC, ?_⟩
    exact Germ.coe_eq.mp hval
  · intro hg
    refine (analytificationIdeal_mem_iff f (m + 1) E 𝔞 x g).mpr (IsInSpanAt.mono ?_ hg)
    rintro s ⟨j, rfl⟩
    exact ⟨U₀, hU₀, r j, hr ▸ Ideal.subset_span ⟨j, rfl⟩, rfl⟩

omit [IsIntegral X] in
/-- **The order along `D` of `π^*𝔞^an`** at `y₀` is the infimum of the orders of the sections of
`𝔞` over an affine open `U₀ ∋ P₀`. -/
theorem originalStalkNormalOrder_pullback_analytificationIdeal (U₀ : X.affineOpens)
    (hU₀ : schemeComplexPointImage f (p.projection y₀) ∈ (U₀ : X.Opens)) (𝔞 : X.IdealSheafData) :
    originalStalkNormalOrder Φ₀ (GermIdeal.pullback (m := m + 1) p.projection
        (analytificationIdeal f (m + 1) E 𝔞)) =
      ⨅ r ∈ 𝔞.ideal U₀, stalkOrd p Φ₀ ((X.presheaf.germ (U₀ : X.Opens) _ hU₀).hom r) := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : IsNoetherianRing Γ(X, U₀) := IsLocallyNoetherian.component_noetherian U₀
  obtain ⟨N, r, hr⟩ : ∃ (N : ℕ) (r : Fin N → Γ(X, U₀)), Ideal.span (range r) = 𝔞.ideal U₀ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian _)
  rw [CoherentIdealCommonModelOrder.originalStalkNormalOrder_pullback_eq_source_generators
    p.modification.1 Φ₀ _ (fun j => schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j))
    (fun j => schemeOpenRegularFunction_holomorphicAt f (m + 1) E (U₀ : X.Opens) (r j) _ hU₀)
    (analytificationIdeal_mem_iff_isInSpanAt E (p.projection y₀) U₀ hU₀ 𝔞 r hr)]
  have hj : ∀ j, functionNormalOrder Φ₀
      (schemeOpenRegularFunction f (m + 1) E (U₀ : X.Opens) (r j) ∘ p.projection)
      ((schemeOpenRegularFunction_holomorphicAt f (m + 1) E (U₀ : X.Opens) (r j) _ hU₀).comp_contMDiff
        (Eventually.of_forall fun _ => p.modification.1.contMDiffAt)) =
      stalkOrd p Φ₀ ((X.presheaf.germ (U₀ : X.Opens) _ hU₀).hom (r j)) :=
    fun j => (stalkOrd_germ p Φ₀ E (U₀ : X.Opens) hU₀ (r j)).symm
  simp only [hj]
  apply le_antisymm
  · refine le_iInf₂ fun a ha => ?_
    rw [← hr] at ha
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨j, rfl⟩ := ha
      exact iInf_le _ j
    | zero =>
      rw [map_zero, stalkOrd_zero]
      exact le_top
    | add a b _ _ ha hb =>
      rw [map_add]
      exact (le_min ha hb).trans (min_le_stalkOrd_add p Φ₀ _ _)
    | smul c a _ ha =>
      rw [smul_eq_mul, map_mul, stalkOrd_mul]
      exact ha.trans le_add_self
  · exact le_iInf fun j => iInf₂_le (r j) (hr ▸ Ideal.subset_span ⟨j, rfl⟩)

/-- **The analytic divisorial valuation realizes the analytic order on ideal sheaves**:
`(t ord_D)(𝔞) = t · ord_{D,y₀}(π^*𝔞^an)` for every ideal sheaf `𝔞` of `X`. -/
theorem idealVal_anDivVal_eq (t : ℝ) (ht : 0 < t) (𝔞 : X.IdealSheafData) :
    (anDivVal p Φ₀ t ht).idealVal 𝔞 = ENNReal.ofReal t *
      ((originalStalkNormalOrder Φ₀ (GermIdeal.pullback (m := m + 1) p.projection
        (analytificationIdeal f (m + 1) E 𝔞)) : ℕ∞) : ℝ≥0∞) := by
  obtain ⟨U₀, hU₀⟩ := exists_affineOpen_mem (schemeComplexPointImage f (p.projection y₀))
  have ht0 : ENNReal.ofReal t ≠ 0 := (ENNReal.ofReal_pos.mpr ht).ne'
  rw [idealVal_anDivVal p Φ₀ t ht U₀ hU₀ 𝔞,
    originalStalkNormalOrder_pullback_analytificationIdeal p Φ₀ E U₀ hU₀ 𝔞]
  simp only [ENat.toENNReal_iInf]
  rw [ENNReal.mul_iInf_of_ne ht0 ENNReal.ofReal_ne_top]
  refine iInf_congr fun r => ?_
  rw [ENNReal.mul_iInf_of_ne ht0 ENNReal.ofReal_ne_top]

end Analytic

end SGPT.NAPotential.TowerAlg

