import SGPT.NAPotential.BerkovichIdealValue

/-!
# Flag ideals and piecewise linear functions on `X^An`

Source: `chapter_NApotential.tex`, Section *Comparison with Boucksom–Jonsson's theory*
(`eq:va`, `eq:Gext`), and Boucksom–Jonsson, *Global pluripotential theory over a trivially valued
field* ([BJ22], `references/bj22-trivval`), §2.1 (`sec:ideals`): `equ:flagweight`,
`equ:gaussflag`, `equ:flagsum`, Definition `defi:PL`, `equ:PLplus` and Example `exam:defconePL`.
Infrastructure for `thm:BJappseq` (lane BJ-MODEL, steps R1/R4 of `claude-bj-energy:plan`).

A *flag ideal* is a `𝔾_m`-invariant coherent fractional ideal sheaf `𝔞` on `X × 𝔸¹` which is
trivial on `X × 𝔾_m`. By its weight decomposition ([BJ22, `equ:flagweight`]) it is the same as a
decreasing family `(𝔞_λ)_{λ ∈ ℤ}` of ideal sheaves on `X` with `𝔞_λ = 𝒪_X` for `λ ≪ 0` and
`𝔞_λ = 0` for `λ ≫ 0`: `𝔞 = ∑_λ 𝔞_λ t^{-λ}`. This file takes the weight decomposition as the
definition (`FlagIdeal`); the corresponding ideal sheaf `t^b 𝔞` on `X × ℙ¹` and its (normalized)
blow-up, the test configuration of `𝔞`, are the remaining step R1 (blueprint
`claude-bj-model:plan`).

For `v ∈ X^An` with Gauss extension `σ(v)` (`eq:Gext`), `σ(v)(𝔞) = min_λ (v(𝔞_λ) - λ)`, and

`φ_𝔞(v) := -σ(v)(𝔞) = max_λ (-v(𝔞_λ) + λ)`   ([BJ22, `equ:gaussflag`]).

## Main definitions

* `FlagIdeal X`: flag ideals, with the sum `𝔞 + 𝔟` (`(𝔞 + 𝔟)_λ = 𝔞_λ + 𝔟_λ`), the product
  `𝔞 * 𝔟` (`(𝔞 𝔟)_λ = ∑_{μ + ν = λ} 𝔞_μ 𝔟_ν`), powers, the principal flag ideals
  `FlagIdeal.monomial c = (t^{-c})` and `FlagIdeal.ofIdeal 𝔟 N = 𝔟 + (t^N)`
  ([BJ22, Example `exam:defconePL`]).
* `FlagIdeal.phi 𝔞 : X^An → ℝ`, the function `φ_𝔞`.
* `IsPLPos f φ`: `φ ∈ PL⁺(X)`, i.e. `φ = m⁻¹ φ_𝔞` ([BJ22, `equ:PLplus`]);
  `plSubmodule f`: the `ℚ`-vector space `PL(X)` generated by the `φ_𝔞` ([BJ22, `defi:PL`]).

## Main results

* `FlagIdeal.phi_le_iff`: `φ_𝔞(v) ≤ r` iff `v(𝔞_λ) ≥ λ - r` for all `λ`.
* `FlagIdeal.phi_add`, `FlagIdeal.phi_mul`: `φ_{𝔞 + 𝔟} = max(φ_𝔞, φ_𝔟)`, `φ_{𝔞 𝔟} = φ_𝔞 + φ_𝔟`
  ([BJ22, `equ:flagsum`]); `FlagIdeal.phi_pow`, `FlagIdeal.phi_monomial`,
  `FlagIdeal.phi_ofIdeal`: `φ_{𝔟 + (t^N)} = max(log|𝔟|, -N)`.
* `IsPLPos.add`, `IsPLPos.max`, `IsPLPos.smul`, `isPLPos_const`: `PL⁺(X)` is stable under sums,
  finite maxima and multiplication by `ℚ_{≥0}`, and contains the rational constants.
* `mem_plSubmodule_iff`: `PL(X)` is the set of differences of functions in `PL⁺(X)`;
  `max_mem_plSubmodule`, `min_mem_plSubmodule`, `const_mem_plSubmodule`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.BJModel

open AlgebraicGeometry CategoryTheory Topology
open scoped ENNReal
open SGPT.NAPotential.Berkovich

variable {X : Scheme.{0}}

/-! ### Values of semi-valuations on sums of ideal sheaves -/

theorem stalkIdeal_bot (c : X) : stalkIdeal (⊥ : X.IdealSheafData) c = ⊥ := by
  unfold stalkIdeal
  simp only [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Ideal.map_bot, iSup_bot]

theorem stalkIdeal_iSup {ι : Type*} (I : ι → X.IdealSheafData) (c : X) :
    stalkIdeal (⨆ i, I i) c = ⨆ i, stalkIdeal (I i) c := by
  unfold stalkIdeal
  simp only [Scheme.IdealSheafData.ideal_iSup, iSup_apply, Ideal.map_iSup]
  apply le_antisymm
  · exact iSup_le fun U => iSup_le fun h => iSup_le fun i =>
      le_iSup_of_le i (le_iSup_of_le U (le_iSup_of_le h le_rfl))
  · exact iSup_le fun i => iSup_le fun U => iSup_le fun h =>
      le_iSup_of_le U (le_iSup_of_le h (le_iSup_of_le i le_rfl))

section idealVal

variable {f : X ⟶ Spec (.of ℂ)} [IsProper f]

/-- `v(0) = ∞`. -/
theorem idealVal_bot (v : BerkovichPoint f) : v.idealVal (⊥ : X.IdealSheafData) = ⊤ := by
  have hS : Ideal.span (∅ : Set (X.presheaf.stalk v.center)) = stalkIdeal ⊥ v.center := by
    rw [stalkIdeal_bot, Ideal.span_empty]
  rw [v.idealVal_eq_iInf_of_span ⊥ hS]
  simp

/-- `v(∑ᵢ 𝔞ᵢ) = infᵢ v(𝔞ᵢ)` ([BJ22, `equ:videal2`]). -/
theorem idealVal_iSup {ι : Type*} (v : BerkovichPoint f) (I : ι → X.IdealSheafData) :
    v.idealVal (⨆ i, I i) = ⨅ i, v.idealVal (I i) := by
  have hS : Ideal.span (⋃ i, (stalkIdeal (I i) v.center : Set (X.presheaf.stalk v.center))) =
      stalkIdeal (⨆ i, I i) v.center := by
    rw [stalkIdeal_iSup, Ideal.span_iUnion]
    simp only [Ideal.span_eq]
  rw [v.idealVal_eq_iInf_of_span _ hS]
  simp only [Set.mem_iUnion, iInf_exists]
  rw [iInf_comm]
  rfl

/-- `v(𝔞 + 𝔟) = min(v(𝔞), v(𝔟))` ([BJ22, `equ:videal2`]). -/
theorem idealVal_sup (v : BerkovichPoint f) (I J : X.IdealSheafData) :
    v.idealVal (I ⊔ J) = min (v.idealVal I) (v.idealVal J) := by
  rw [sup_eq_iSup, idealVal_iSup, iInf_bool_eq]
  rfl

end idealVal

/-! ### Flag ideals -/

/-- **A flag ideal** on `X` ([BJ22, §2.1]): a `𝔾_m`-invariant coherent fractional ideal sheaf
`𝔞 = ∑_λ 𝔞_λ t^{-λ}` on `X × 𝔸¹` that is trivial on `X × 𝔾_m`, given by its weight decomposition
([BJ22, `equ:flagweight`]): a decreasing family of ideal sheaves `𝔞_λ ⊆ 𝒪_X`, `λ ∈ ℤ`, with
`𝔞_λ = 𝒪_X` for `λ ≪ 0` and `𝔞_λ = 0` for `λ ≫ 0`. -/
structure FlagIdeal (X : Scheme.{0}) where
  /-- The ideal sheaf `𝔞_λ` of weight `λ`. -/
  ideal : ℤ → X.IdealSheafData
  antitone : Antitone ideal
  exists_eq_top : ∃ a : ℤ, ∀ l ≤ a, ideal l = ⊤
  exists_eq_bot : ∃ b : ℤ, ∀ l, b < l → ideal l = ⊥

namespace FlagIdeal

@[ext]
theorem ext {𝔞 𝔟 : FlagIdeal X} (h : ∀ l, 𝔞.ideal l = 𝔟.ideal l) : 𝔞 = 𝔟 := by
  cases 𝔞; cases 𝔟
  congr
  exact funext h

/-- The principal flag ideal `(t^{-c})`: `𝔞_λ = 𝒪_X` for `λ ≤ c` and `𝔞_λ = 0` for `λ > c`. -/
def monomial (X : Scheme.{0}) (c : ℤ) : FlagIdeal X where
  ideal l := if l ≤ c then ⊤ else ⊥
  antitone l l' h := by
    by_cases h' : l' ≤ c
    · simp [h', h.trans h']
    · simp [h']
  exists_eq_top := ⟨c, fun l hl => by simp [hl]⟩
  exists_eq_bot := ⟨c, fun l hl => by simp [not_le.mpr hl]⟩

theorem monomial_ideal (c l : ℤ) :
    (monomial X c).ideal l = if l ≤ c then ⊤ else ⊥ := rfl

/-- The trivial flag ideal `𝒪_{X × 𝔸¹}`. -/
instance : One (FlagIdeal X) := ⟨monomial X 0⟩

theorem one_def : (1 : FlagIdeal X) = monomial X 0 := rfl

/-- The sum of two flag ideals: `(𝔞 + 𝔟)_λ = 𝔞_λ + 𝔟_λ`. -/
instance : Add (FlagIdeal X) where
  add 𝔞 𝔟 :=
    { ideal := fun l => 𝔞.ideal l ⊔ 𝔟.ideal l
      antitone := fun _ _ h => sup_le_sup (𝔞.antitone h) (𝔟.antitone h)
      exists_eq_top := by
        obtain ⟨a, ha⟩ := 𝔞.exists_eq_top
        exact ⟨a, fun l hl => by rw [ha l hl, top_sup_eq]⟩
      exists_eq_bot := by
        obtain ⟨b, hb⟩ := 𝔞.exists_eq_bot
        obtain ⟨b', hb'⟩ := 𝔟.exists_eq_bot
        exact ⟨max b b', fun l hl => by
          rw [hb l ((le_max_left _ _).trans_lt hl), hb' l ((le_max_right _ _).trans_lt hl),
            sup_bot_eq]⟩ }

theorem add_ideal (𝔞 𝔟 : FlagIdeal X) (l : ℤ) : (𝔞 + 𝔟).ideal l = 𝔞.ideal l ⊔ 𝔟.ideal l := rfl

/-- The product of two flag ideals: `(𝔞 𝔟)_λ = ∑_{μ + ν = λ} 𝔞_μ 𝔟_ν`. -/
instance : Mul (FlagIdeal X) where
  mul 𝔞 𝔟 :=
    { ideal := fun l => ⨆ μ : ℤ, 𝔞.ideal μ * 𝔟.ideal (l - μ)
      antitone := fun l l' h => iSup_mono fun μ =>
        mul_le_mul' le_rfl (𝔟.antitone (sub_le_sub_right h μ))
      exists_eq_top := by
        obtain ⟨a, ha⟩ := 𝔞.exists_eq_top
        obtain ⟨a', ha'⟩ := 𝔟.exists_eq_top
        refine ⟨a + a', fun l hl => top_le_iff.mp ?_⟩
        refine le_iSup_of_le a ?_
        rw [ha a le_rfl, ha' (l - a) (by omega), Scheme.IdealSheafData.top_mul]
      exists_eq_bot := by
        obtain ⟨b, hb⟩ := 𝔞.exists_eq_bot
        obtain ⟨b', hb'⟩ := 𝔟.exists_eq_bot
        refine ⟨b + b', fun l hl => le_bot_iff.mp (iSup_le fun μ => ?_)⟩
        by_cases hμ : b < μ
        · rw [hb μ hμ, Scheme.IdealSheafData.bot_mul]
        · rw [hb' (l - μ) (by omega), Scheme.IdealSheafData.mul_bot] }

theorem mul_ideal (𝔞 𝔟 : FlagIdeal X) (l : ℤ) :
    (𝔞 * 𝔟).ideal l = ⨆ μ : ℤ, 𝔞.ideal μ * 𝔟.ideal (l - μ) := rfl

/-- Powers of a flag ideal. -/
def pow (𝔞 : FlagIdeal X) : ℕ → FlagIdeal X
  | 0 => 1
  | k + 1 => pow 𝔞 k * 𝔞

instance : Pow (FlagIdeal X) ℕ := ⟨pow⟩

theorem pow_zero' (𝔞 : FlagIdeal X) : 𝔞 ^ 0 = 1 := rfl

theorem pow_succ' (𝔞 : FlagIdeal X) (k : ℕ) : 𝔞 ^ (k + 1) = 𝔞 ^ k * 𝔞 := rfl

/-- The flag ideal `𝔟 + (t^N)` of an ideal sheaf `𝔟 ⊆ 𝒪_X` ([BJ22, Example `exam:defconePL`] for
`N = 1`; its blow-up is the deformation to the normal cone of `V(𝔟)`): `𝔞_λ = 𝒪_X` for `λ ≤ -N`,
`𝔞_λ = 𝔟` for `-N < λ ≤ 0` and `𝔞_λ = 0` for `λ > 0`. -/
def ofIdeal (𝔟 : X.IdealSheafData) (N : ℕ) : FlagIdeal X where
  ideal l := if l ≤ -(N : ℤ) then ⊤ else if l ≤ 0 then 𝔟 else ⊥
  antitone l l' h := by
    by_cases h1 : l' ≤ -(N : ℤ)
    · simp [h1, h.trans h1]
    · by_cases h2 : l' ≤ 0
      · by_cases h3 : l ≤ -(N : ℤ)
        · simp [h1, h2, h3]
        · simp [h1, h2, h3, h.trans h2]
      · simp [h1, h2]
  exists_eq_top := ⟨-(N : ℤ), fun l hl => by simp [hl]⟩
  exists_eq_bot := ⟨0, fun l hl => by
    have h1 : ¬ l ≤ -(N : ℤ) := by omega
    have h2 : ¬ l ≤ 0 := by omega
    simp [h1, h2]⟩

theorem ofIdeal_ideal (𝔟 : X.IdealSheafData) (N : ℕ) (l : ℤ) :
    (ofIdeal 𝔟 N).ideal l = if l ≤ -(N : ℤ) then ⊤ else if l ≤ 0 then 𝔟 else ⊥ := rfl

/-! ### The function `φ_𝔞` -/

section phi

variable {f : X ⟶ Spec (.of ℂ)} [IsProper f]

/-- The finite values `λ - v(𝔞_λ)`. -/
def terms (𝔞 : FlagIdeal X) (v : BerkovichPoint f) : Set ℝ :=
  {r | ∃ l : ℤ, v.idealVal (𝔞.ideal l) ≠ ⊤ ∧ r = (l : ℝ) - (v.idealVal (𝔞.ideal l)).toReal}

/-- **The function `φ_𝔞`** of a flag ideal ([BJ22, `equ:gaussflag`]):
`φ_𝔞(v) = -σ(v)(𝔞) = max_λ (λ - v(𝔞_λ))`, where `σ(v)` is the Gauss extension of `v`
(`eq:Gext`). -/
def phi (𝔞 : FlagIdeal X) (v : BerkovichPoint f) : ℝ := sSup (𝔞.terms v)

theorem terms_nonempty (𝔞 : FlagIdeal X) (v : BerkovichPoint f) : (𝔞.terms v).Nonempty := by
  obtain ⟨a, ha⟩ := 𝔞.exists_eq_top
  exact ⟨_, a, by rw [ha a le_rfl, BerkovichPoint.idealVal_top]; exact ENNReal.zero_ne_top, rfl⟩

theorem terms_bddAbove (𝔞 : FlagIdeal X) (v : BerkovichPoint f) : BddAbove (𝔞.terms v) := by
  obtain ⟨b, hb⟩ := 𝔞.exists_eq_bot
  refine ⟨b, ?_⟩
  rintro _ ⟨l, hl, rfl⟩
  have hlb : l ≤ b := by
    by_contra h
    exact hl (by rw [hb l (not_le.mp h), idealVal_bot])
  have : (l : ℝ) ≤ b := by exact_mod_cast hlb
  linarith [ENNReal.toReal_nonneg (a := v.idealVal (𝔞.ideal l))]

/-- `φ_𝔞(v) ≤ r` iff `v(𝔞_λ) ≥ λ - r` for all `λ`. -/
theorem phi_le_iff (𝔞 : FlagIdeal X) (v : BerkovichPoint f) (r : ℝ) :
    𝔞.phi v ≤ r ↔ ∀ l : ℤ, ENNReal.ofReal (l - r) ≤ v.idealVal (𝔞.ideal l) := by
  unfold phi
  rw [csSup_le_iff (𝔞.terms_bddAbove v) (𝔞.terms_nonempty v)]
  constructor
  · intro h l
    by_cases hl : v.idealVal (𝔞.ideal l) = ⊤
    · rw [hl]; exact le_top
    · rw [ENNReal.ofReal_le_iff_le_toReal hl]
      have := h _ ⟨l, hl, rfl⟩
      linarith
  · rintro h _ ⟨l, hl, rfl⟩
    have := (ENNReal.ofReal_le_iff_le_toReal hl).mp (h l)
    linarith

/-- `r < φ_𝔞(v)` iff `v(𝔞_λ) < λ - r` for some `λ`. -/
theorem lt_phi_iff (𝔞 : FlagIdeal X) (v : BerkovichPoint f) (r : ℝ) :
    r < 𝔞.phi v ↔ ∃ l : ℤ, v.idealVal (𝔞.ideal l) < ENNReal.ofReal (l - r) := by
  rw [← not_le, phi_le_iff, not_forall]
  simp only [not_le]

/-- The inequality `λ - v(𝔞_λ) ≤ φ_𝔞(v)`. -/
theorem ofReal_sub_phi_le (𝔞 : FlagIdeal X) (v : BerkovichPoint f) (l : ℤ) :
    ENNReal.ofReal (l - 𝔞.phi v) ≤ v.idealVal (𝔞.ideal l) :=
  (𝔞.phi_le_iff v _).mp le_rfl l

theorem le_phi (𝔞 : FlagIdeal X) (v : BerkovichPoint f) {a : ℤ} (ha : 𝔞.ideal a = ⊤) :
    (a : ℝ) ≤ 𝔞.phi v := by
  have h := 𝔞.ofReal_sub_phi_le v a
  rw [ha, BerkovichPoint.idealVal_top, nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at h
  linarith

theorem phi_le (𝔞 : FlagIdeal X) (v : BerkovichPoint f) {b : ℤ}
    (hb : ∀ l, b < l → 𝔞.ideal l = ⊥) : 𝔞.phi v ≤ b := by
  rw [phi_le_iff]
  intro l
  by_cases hl : l ≤ b
  · have : (l : ℝ) - b ≤ 0 := by
      have : (l : ℝ) ≤ b := by exact_mod_cast hl
      linarith
    rw [ENNReal.ofReal_of_nonpos this]
    exact zero_le
  · rw [hb l (not_le.mp hl), idealVal_bot]
    exact le_top

/-- Monotonicity: `𝔞 ⊆ 𝔟` implies `φ_𝔞 ≤ φ_𝔟`. -/
theorem phi_mono {𝔞 𝔟 : FlagIdeal X} (h : ∀ l, 𝔞.ideal l ≤ 𝔟.ideal l) (v : BerkovichPoint f) :
    𝔞.phi v ≤ 𝔟.phi v := by
  rw [phi_le_iff]
  intro l
  exact (𝔟.ofReal_sub_phi_le v l).trans (v.idealVal_antitone (h l))

/-- `φ_{(t^{-c})} = c`. -/
@[simp]
theorem phi_monomial (c : ℤ) (v : BerkovichPoint f) : (monomial X c).phi v = c := by
  apply le_antisymm
  · exact phi_le _ v fun l hl => by simp [monomial_ideal, not_le.mpr hl]
  · exact le_phi _ v (by simp [monomial_ideal])

@[simp]
theorem phi_one (v : BerkovichPoint f) : (1 : FlagIdeal X).phi v = 0 := by
  rw [one_def, phi_monomial, Int.cast_zero]

/-- `φ_{𝔞 + 𝔟} = max(φ_𝔞, φ_𝔟)` ([BJ22, `equ:flagsum`]). -/
theorem phi_add (𝔞 𝔟 : FlagIdeal X) (v : BerkovichPoint f) :
    (𝔞 + 𝔟).phi v = max (𝔞.phi v) (𝔟.phi v) := by
  apply eq_of_forall_ge_iff
  intro r
  rw [max_le_iff, phi_le_iff, phi_le_iff, phi_le_iff, ← forall_and]
  refine forall_congr' fun l => ?_
  rw [add_ideal, idealVal_sup, le_min_iff]

variable [IsLocallyNoetherian X]

/-- `φ_{𝔞 𝔟} = φ_𝔞 + φ_𝔟` ([BJ22, `equ:flagsum`]). -/
theorem phi_mul (𝔞 𝔟 : FlagIdeal X) (v : BerkovichPoint f) :
    (𝔞 * 𝔟).phi v = 𝔞.phi v + 𝔟.phi v := by
  apply le_antisymm
  · rw [phi_le_iff]
    intro l
    rw [mul_ideal, idealVal_iSup]
    refine le_iInf fun μ => ?_
    rw [BerkovichPoint.idealVal_mul]
    have h1 := 𝔞.ofReal_sub_phi_le v μ
    have h2 := 𝔟.ofReal_sub_phi_le v (l - μ)
    have heq : (l : ℝ) - (𝔞.phi v + 𝔟.phi v) =
        ((μ : ℝ) - 𝔞.phi v) + (((l - μ : ℤ) : ℝ) - 𝔟.phi v) := by
      push_cast
      ring
    rw [heq]
    exact (ENNReal.ofReal_add_le).trans (add_le_add h1 h2)
  · by_contra hlt
    rw [not_le] at hlt
    obtain ⟨ε, hε, hε'⟩ : ∃ ε : ℝ, 0 < ε ∧ (𝔞 * 𝔟).phi v + 2 * ε < 𝔞.phi v + 𝔟.phi v :=
      ⟨(𝔞.phi v + 𝔟.phi v - (𝔞 * 𝔟).phi v) / 4, by linarith, by linarith⟩
    obtain ⟨μ, hμ⟩ := (𝔞.lt_phi_iff v (𝔞.phi v - ε)).mp (by linarith)
    obtain ⟨ν, hν⟩ := (𝔟.lt_phi_iff v (𝔟.phi v - ε)).mp (by linarith)
    have hμpos : 0 < (μ : ℝ) - (𝔞.phi v - ε) := by
      by_contra h
      rw [ENNReal.ofReal_of_nonpos (not_lt.mp h)] at hμ
      exact not_lt_zero hμ
    have hνpos : 0 < (ν : ℝ) - (𝔟.phi v - ε) := by
      by_contra h
      rw [ENNReal.ofReal_of_nonpos (not_lt.mp h)] at hν
      exact not_lt_zero hν
    have hle : (𝔞.ideal μ * 𝔟.ideal ν : X.IdealSheafData) ≤ (𝔞 * 𝔟).ideal (μ + ν) := by
      rw [mul_ideal]
      refine le_iSup_of_le μ ?_
      rw [add_sub_cancel_left]
    have h1 : v.idealVal ((𝔞 * 𝔟).ideal (μ + ν)) <
        ENNReal.ofReal (((μ + ν : ℤ) : ℝ) - (𝔞.phi v + 𝔟.phi v - 2 * ε)) := by
      calc v.idealVal ((𝔞 * 𝔟).ideal (μ + ν))
          ≤ v.idealVal (𝔞.ideal μ * 𝔟.ideal ν) := v.idealVal_antitone hle
        _ = v.idealVal (𝔞.ideal μ) + v.idealVal (𝔟.ideal ν) := v.idealVal_mul _ _
        _ < ENNReal.ofReal ((μ : ℝ) - (𝔞.phi v - ε)) +
            ENNReal.ofReal ((ν : ℝ) - (𝔟.phi v - ε)) := ENNReal.add_lt_add hμ hν
        _ = ENNReal.ofReal (((μ + ν : ℤ) : ℝ) - (𝔞.phi v + 𝔟.phi v - 2 * ε)) := by
          rw [← ENNReal.ofReal_add hμpos.le hνpos.le]
          congr 1
          push_cast
          ring
    have h2 : (𝔞 * 𝔟).phi v ≤ 𝔞.phi v + 𝔟.phi v - 2 * ε := by linarith
    exact absurd (((𝔞 * 𝔟).phi_le_iff v _).mp h2 (μ + ν)) (not_le.mpr h1)

/-- `φ_{𝔞^k} = k φ_𝔞`. -/
theorem phi_pow (𝔞 : FlagIdeal X) (k : ℕ) (v : BerkovichPoint f) :
    (𝔞 ^ k).phi v = k * 𝔞.phi v := by
  induction k with
  | zero => rw [pow_zero', phi_one, Nat.cast_zero, zero_mul]
  | succ k ih => rw [pow_succ', phi_mul, ih]; push_cast; ring

omit [IsLocallyNoetherian X] in
/-- `φ_{𝔟 + (t^N)} = max(log|𝔟|, -N) = -min(v(𝔟), N)` ([BJ22, Example `exam:defconePL`]). -/
theorem phi_ofIdeal (𝔟 : X.IdealSheafData) (N : ℕ) (v : BerkovichPoint f) :
    (ofIdeal 𝔟 N).phi v = -(min (v.idealVal 𝔟) N).toReal := by
  have hne : min (v.idealVal 𝔟) (N : ℝ≥0∞) ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top N) (min_le_right _ _)
  apply eq_of_forall_ge_iff
  intro r
  rw [phi_le_iff, neg_le, ← ENNReal.ofReal_le_iff_le_toReal hne, le_min_iff]
  constructor
  · intro h
    constructor
    · rcases Nat.eq_zero_or_pos N with rfl | hN
      · have h0 := h 0
        rw [ofIdeal_ideal] at h0
        simp only [Nat.cast_zero, neg_zero, le_refl, if_true, BerkovichPoint.idealVal_top,
          nonpos_iff_eq_zero, Int.cast_zero, zero_sub] at h0
        rw [h0]
        exact zero_le
      · have h0 := h 0
        rw [ofIdeal_ideal] at h0
        have h1 : ¬ (0 : ℤ) ≤ -(N : ℤ) := by omega
        simpa [h1, hN.ne'] using h0
    · have h0 := h (-(N : ℤ))
      rw [ofIdeal_ideal] at h0
      simp only [le_refl, if_true, BerkovichPoint.idealVal_top, nonpos_iff_eq_zero,
        ENNReal.ofReal_eq_zero] at h0
      rw [← ENNReal.ofReal_natCast]
      apply ENNReal.ofReal_le_ofReal
      push_cast at h0
      linarith
  · rintro ⟨h1, h2⟩ l
    rw [ofIdeal_ideal]
    have h2' : -r ≤ N := by
      by_contra h
      rw [← ENNReal.ofReal_natCast, ENNReal.ofReal_le_ofReal_iff (Nat.cast_nonneg N)] at h2
      exact h h2
    by_cases hl1 : l ≤ -(N : ℤ)
    · have : (l : ℝ) ≤ -(N : ℝ) := by exact_mod_cast hl1
      rw [if_pos hl1, ENNReal.ofReal_of_nonpos (by linarith)]
      exact zero_le
    · by_cases hl2 : l ≤ 0
      · have : (l : ℝ) ≤ 0 := by exact_mod_cast hl2
        rw [if_neg hl1, if_pos hl2]
        exact (ENNReal.ofReal_le_ofReal (by linarith)).trans h1
      · rw [if_neg hl1, if_neg hl2, idealVal_bot]
        exact le_top

end phi

end FlagIdeal

/-! ### `PL⁺(X)` and `PL(X)` -/

section PL

variable (f : X ⟶ Spec (.of ℂ)) [IsProper f]

/-- **`PL⁺(X)`** ([BJ22, `equ:PLplus`]): the functions `m⁻¹ φ_𝔞` on `X^An`, for a flag ideal `𝔞`
and an integer `m ≥ 1`. -/
def IsPLPos (φ : BerkovichPoint f → ℝ) : Prop :=
  ∃ (m : ℕ) (𝔞 : FlagIdeal X), 0 < m ∧ ∀ v, φ v = (m : ℝ)⁻¹ * 𝔞.phi v

variable {f}

theorem isPLPos_phi (𝔞 : FlagIdeal X) : IsPLPos f 𝔞.phi :=
  ⟨1, 𝔞, one_pos, fun v => by simp⟩

/-- Rational constants are in `PL⁺(X)`. -/
theorem isPLPos_const (c : ℚ) : IsPLPos f fun _ => (c : ℝ) := by
  refine ⟨c.den, FlagIdeal.monomial X c.num, c.den_pos, fun v => ?_⟩
  rw [FlagIdeal.phi_monomial]
  have hden : (c.den : ℝ) ≠ 0 := by exact_mod_cast c.den_ne_zero
  rw [inv_mul_eq_div, eq_div_iff hden]
  show (c : ℝ) * (c.den : ℝ) = (c.num : ℝ)
  exact_mod_cast Rat.mul_den_eq_num c

theorem IsPLPos.congr {φ ψ : BerkovichPoint f → ℝ} (h : IsPLPos f φ) (hψ : ∀ v, ψ v = φ v) :
    IsPLPos f ψ := by
  obtain ⟨m, 𝔞, hm, h⟩ := h
  exact ⟨m, 𝔞, hm, fun v => (hψ v).trans (h v)⟩

/-- `PL⁺(X)` is stable under finite maxima. -/
theorem IsPLPos.max [IsLocallyNoetherian X] {φ ψ : BerkovichPoint f → ℝ} (hφ : IsPLPos f φ)
    (hψ : IsPLPos f ψ) : IsPLPos f fun v => max (φ v) (ψ v) := by
  obtain ⟨m, 𝔞, hm, hφ⟩ := hφ
  obtain ⟨m', 𝔟, hm', hψ⟩ := hψ
  refine ⟨m * m', 𝔞 ^ m' + 𝔟 ^ m, Nat.mul_pos hm hm', fun v => ?_⟩
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hm0' : (m' : ℝ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hpos : (0 : ℝ) ≤ ((m * m' : ℕ) : ℝ)⁻¹ := by positivity
  show Max.max (φ v) (ψ v) = _
  rw [FlagIdeal.phi_add, FlagIdeal.phi_pow, FlagIdeal.phi_pow, mul_max_of_nonneg _ _ hpos, hφ, hψ]
  congr 1
  · push_cast; field_simp
  · push_cast; field_simp

/-- `PL⁺(X)` is stable under sums. -/
theorem IsPLPos.add [IsLocallyNoetherian X] {φ ψ : BerkovichPoint f → ℝ} (hφ : IsPLPos f φ)
    (hψ : IsPLPos f ψ) : IsPLPos f fun v => φ v + ψ v := by
  obtain ⟨m, 𝔞, hm, hφ⟩ := hφ
  obtain ⟨m', 𝔟, hm', hψ⟩ := hψ
  refine ⟨m * m', 𝔞 ^ m' * 𝔟 ^ m, Nat.mul_pos hm hm', fun v => ?_⟩
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hm0' : (m' : ℝ) ≠ 0 := by exact_mod_cast hm'.ne'
  show φ v + ψ v = _
  rw [FlagIdeal.phi_mul, FlagIdeal.phi_pow, FlagIdeal.phi_pow, hφ, hψ]
  push_cast
  field_simp

/-- `PL⁺(X)` is stable under multiplication by nonnegative rational numbers. -/
theorem IsPLPos.smul [IsLocallyNoetherian X] {φ : BerkovichPoint f → ℝ} (hφ : IsPLPos f φ)
    {c : ℚ} (hc : 0 ≤ c) : IsPLPos f fun v => (c : ℝ) * φ v := by
  obtain ⟨m, 𝔞, hm, hφ⟩ := hφ
  refine ⟨c.den * m, 𝔞 ^ c.num.toNat, Nat.mul_pos c.den_pos hm, fun v => ?_⟩
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hden : (c.den : ℝ) ≠ 0 := by exact_mod_cast c.den_ne_zero
  have hnum : ((c.num.toNat : ℕ) : ℝ) = (c.num : ℝ) := by
    have h := Int.toNat_of_nonneg (Rat.num_nonneg.mpr hc)
    exact_mod_cast h
  have hc' : (c : ℝ) = (c.num : ℝ) / (c.den : ℝ) := by
    exact_mod_cast (Rat.num_div_den c).symm
  show (c : ℝ) * φ v = _
  rw [FlagIdeal.phi_pow, hφ, hnum, hc']
  push_cast
  field_simp

/-- `max(log|𝔟|, -N) ∈ PL⁺(X)` for an ideal sheaf `𝔟` ([BJ22, Example `exam:defconePL`]). -/
theorem isPLPos_neg_min_idealVal (𝔟 : X.IdealSheafData) (N : ℕ) :
    IsPLPos f fun v => -(min (v.idealVal 𝔟) N).toReal :=
  (isPLPos_phi (FlagIdeal.ofIdeal 𝔟 N)).congr fun v => (FlagIdeal.phi_ofIdeal 𝔟 N v).symm

variable (f) in
/-- **The space `PL(X)` of piecewise linear functions on `X^An`** ([BJ22, Definition
`defi:PL`]): the `ℚ`-linear span of the functions `φ_𝔞` of flag ideals. -/
def plSubmodule : Submodule ℚ (BerkovichPoint f → ℝ) :=
  Submodule.span ℚ (Set.range fun 𝔞 : FlagIdeal X => (𝔞.phi : BerkovichPoint f → ℝ))

theorem phi_mem_plSubmodule (𝔞 : FlagIdeal X) : 𝔞.phi ∈ plSubmodule f :=
  Submodule.subset_span ⟨𝔞, rfl⟩

theorem IsPLPos.mem_plSubmodule {φ : BerkovichPoint f → ℝ} (hφ : IsPLPos f φ) :
    φ ∈ plSubmodule f := by
  obtain ⟨m, 𝔞, hm, hφ⟩ := hφ
  have h : φ = ((m : ℚ)⁻¹) • (𝔞.phi : BerkovichPoint f → ℝ) := by
    funext v
    rw [Pi.smul_apply, hφ v, Rat.smul_def]
    push_cast
    rfl
  rw [h]
  exact Submodule.smul_mem _ _ (phi_mem_plSubmodule 𝔞)

variable [IsLocallyNoetherian X]

/-- Every function in `PL(X)` is a difference of functions in `PL⁺(X)` ([BJ22, §2.1]). -/
theorem mem_plSubmodule_iff {φ : BerkovichPoint f → ℝ} :
    φ ∈ plSubmodule f ↔ ∃ g h : BerkovichPoint f → ℝ, IsPLPos f g ∧ IsPLPos f h ∧ φ = g - h := by
  constructor
  · intro hφ
    induction hφ using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨𝔞, rfl⟩ := hx
      exact ⟨_, _, isPLPos_phi 𝔞, isPLPos_const 0, by funext v; simp⟩
    | zero => exact ⟨_, _, isPLPos_const 0, isPLPos_const 0, by funext v; simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨g, h, hg, hh, rfl⟩ := hx
      obtain ⟨g', h', hg', hh', rfl⟩ := hy
      exact ⟨_, _, hg.add hg', hh.add hh', by funext v; simp only [Pi.add_apply, Pi.sub_apply]; ring⟩
    | smul c x _ hx =>
      obtain ⟨g, h, hg, hh, rfl⟩ := hx
      rcases le_total 0 c with hc | hc
      · refine ⟨_, _, hg.smul hc, hh.smul hc, ?_⟩
        funext v
        simp only [Pi.smul_apply, Pi.sub_apply, Rat.smul_def]
        ring
      · refine ⟨_, _, hh.smul (neg_nonneg.mpr hc), hg.smul (neg_nonneg.mpr hc), ?_⟩
        funext v
        simp only [Pi.smul_apply, Pi.sub_apply, Rat.smul_def]
        push_cast
        ring
  · rintro ⟨g, h, hg, hh, rfl⟩
    exact Submodule.sub_mem _ hg.mem_plSubmodule hh.mem_plSubmodule

omit [IsLocallyNoetherian X] in
/-- `PL(X)` contains the rational constants. -/
theorem const_mem_plSubmodule (c : ℚ) : (fun _ => (c : ℝ)) ∈ plSubmodule f :=
  (isPLPos_const c).mem_plSubmodule

/-- `PL(X)` is stable under finite maxima ([BJ22, §2.1]). -/
theorem max_mem_plSubmodule {φ ψ : BerkovichPoint f → ℝ} (hφ : φ ∈ plSubmodule f)
    (hψ : ψ ∈ plSubmodule f) : (fun v => max (φ v) (ψ v)) ∈ plSubmodule f := by
  obtain ⟨g, h, hg, hh, rfl⟩ := mem_plSubmodule_iff.mp hφ
  obtain ⟨g', h', hg', hh', rfl⟩ := mem_plSubmodule_iff.mp hψ
  refine mem_plSubmodule_iff.mpr ⟨_, _, (hg.add hh').max (hg'.add hh), hh.add hh', ?_⟩
  funext v
  simp only [Pi.sub_apply]
  rw [← max_sub_sub_right]
  congr 1 <;> ring

/-- `PL(X)` is stable under finite minima ([BJ22, §2.1]). -/
theorem min_mem_plSubmodule {φ ψ : BerkovichPoint f → ℝ} (hφ : φ ∈ plSubmodule f)
    (hψ : ψ ∈ plSubmodule f) : (fun v => min (φ v) (ψ v)) ∈ plSubmodule f := by
  have h := max_mem_plSubmodule (Submodule.neg_mem _ hφ) (Submodule.neg_mem _ hψ)
  have h' := Submodule.neg_mem _ h
  convert h' using 1
  funext v
  simp only [Pi.neg_apply]
  rw [max_neg_neg, neg_neg]

end PL

end SGPT.NAPotential.BJModel
