import SGPT.NAPotential.BerkovichDivisorial
import Mathlib.AlgebraicGeometry.Morphisms.Proper
import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
import Mathlib.RingTheory.OrderOfVanishing.Noetherian

/-!
# The valuation ring of an algebraic prime divisor is essentially of finite type


Let `D` be an algebraic prime divisor over the integral scheme `X`
(`SGPT.NAPotential.Berkovich.PrimeDivisorOver`): a prime divisor on a normal integral model
`π : Y → X`, proper and birational.  Its valuation ring `R_D = 𝒪_{Y,D}` is the localization of
a finitely generated algebra over an affine chart of `X`:

* `exists_affine_generators`: there are an affine open `U ⊆ X` containing `π(D)` and finitely
  many rational functions `b₁, …, b_s ∈ ℂ(X)` such that the subring `A[b] ⊆ ℂ(X)` generated by
  `A = Γ(U, 𝒪_X)` (`sectionToField`) and the `bᵢ` satisfies `ord_D ≥ 0` on `A[b]`, and every
  rational function `g` with `ord_D(g) ≥ 0` is a quotient `a / c` with `a, c ∈ A[b]` and
  `ord_D(c) = 0`.  In other words `R_D = A[b]_𝔭`, `𝔭 = {ord_D > 0} ∩ A[b]`: the centre of
  `ord_D` on the affine model `Spec A[b]` is a point of codimension one whose local ring is `R_D`.

This is step (a) of the plan of `claude-alg-primes:remaining` (graph model of `D`).  The proof:
`Y` is of finite type over `X` (`π` is proper), so on an affine open `V ∋ D` of `Y` over `U`,
`Γ(V, 𝒪_Y) = A[c₁, …, c_s]`; the `bᵢ` are the `cᵢ` read in `ℂ(X)` through the birational
identification `ℂ(X) ≅ ℂ(Y)` (`pullbackEquiv`), and `𝒪_{Y,D}` is the localization of `Γ(V, 𝒪_Y)`
at the prime of `D`, the valuation ring of `ord_D` (`mem_range_of_one_le_ordFrac`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.AlgPrimes3

open AlgebraicGeometry CategoryTheory Topology IsLocalRing Opposite
open SGPT.NAPotential.Berkovich

section DVR

variable (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-- **The valuation ring of a discrete valuation ring's order.**  An element of the fraction
field of a discrete valuation ring `R` with `ordFrac ≥ 1` (order `≥ 0`) lies in `R`. -/
theorem mem_range_of_one_le_ordFrac {x : K} (hx : 1 ≤ Ring.ordFrac R x) :
    x ∈ (algebraMap R K).range := by
  rcases ValuationRing.isInteger_or_isInteger R x with ⟨r, hr⟩ | ⟨r, hr⟩
  · exact ⟨r, hr⟩
  · by_cases hx0 : x = 0
    · exact ⟨0, by simp [hx0]⟩
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [map_zero] at hr
      exact inv_ne_zero hx0 hr.symm
    by_cases hu : IsUnit r
    · obtain ⟨u, rfl⟩ := hu
      refine ⟨↑u⁻¹, ?_⟩
      have h1 : algebraMap R K ↑u⁻¹ * algebraMap R K ↑u = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      rw [hr] at h1
      calc algebraMap R K ↑u⁻¹ = algebraMap R K ↑u⁻¹ * x⁻¹ * x := by
            rw [mul_assoc, inv_mul_cancel₀ hx0, mul_one]
        _ = x := by rw [h1, one_mul]
    · exfalso
      have h1 : 1 < Ring.ordFrac R (algebraMap R K r) :=
        lt_of_le_of_ne (Ring.ordFrac_ge_one_of_ne_zero hr0) fun h =>
          hu (Ring.isUnit_iff_ordFrac_one_of_isDiscreteValuationRing.mpr h.symm)
      rw [hr, map_inv₀] at h1
      have h2 : (Ring.ordFrac R x)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hx
      exact absurd h1 (not_lt.mpr h2)

end DVR

variable {X : Scheme.{0}} (D : PrimeDivisorOver X)

namespace PrimeDivisorOver'

/-- The birational identification `ℂ(X) ≅ ℂ(Y)` of a prime divisor over `X`. -/
def pullbackEquiv : X.residueField (D.π (genericPoint D.Y)) ≃+* D.Y.functionField :=
  RingEquiv.ofBijective D.pullback
    ⟨D.pullback_injective, fun w => by
      obtain ⟨x, hx⟩ := D.birational.2 (D.residueEquiv w)
      exact ⟨x, by simp [PrimeDivisorOver.pullback, hx]⟩⟩

@[simp]
theorem pullbackEquiv_apply (x : X.residueField (D.π (genericPoint D.Y))) :
    pullbackEquiv D x = D.pullback x := rfl

/-- A section of `𝒪_X` over an open set containing the generic point `π(η_Y)` as a rational
function on `X` (an element of the residue field at `π(η_Y)`). -/
def sectionToField (U : X.Opens) (hU : D.π (genericPoint D.Y) ∈ U) :
    Γ(X, U) →+* X.residueField (D.π (genericPoint D.Y)) :=
  (X.residue (D.π (genericPoint D.Y))).hom.comp (X.presheaf.germ U _ hU).hom

theorem genericPoint_mem_preimage (U : X.Opens) (hU : D.π (genericPoint D.Y) ∈ U) :
    genericPoint D.Y ∈ D.π ⁻¹ᵁ U := hU

/-- The pull-back of the rational function of a section is the rational function of the
pulled-back section. -/
theorem pullback_sectionToField (U : X.Opens) (hU : D.π (genericPoint D.Y) ∈ U)
    [Nonempty (D.π ⁻¹ᵁ U)] (a : Γ(X, U)) :
    D.pullback (sectionToField D U hU a) = D.Y.germToFunctionField (D.π ⁻¹ᵁ U) (D.π.app U a) := by
  apply D.residueEquiv.injective
  have h1 : D.residueEquiv (D.pullback (sectionToField D U hU a)) =
      (D.π.residueFieldMap (genericPoint D.Y)).hom (sectionToField D U hU a) := by
    simp [PrimeDivisorOver.pullback]
  rw [h1]
  change (X.residue (D.π (genericPoint D.Y)) ≫ D.π.residueFieldMap (genericPoint D.Y)).hom
    (X.presheaf.germ U _ hU a) = _
  rw [Scheme.residue_residueFieldMap]
  change (D.Y.residue (genericPoint D.Y)).hom
    ((D.π.stalkMap (genericPoint D.Y)).hom (X.presheaf.germ U _ hU a)) = _
  rw [Scheme.Hom.germ_stalkMap_apply]
  rfl

/-- `ord_D ≥ 0` exactly on the rational functions whose pull-back lies in `𝒪_{Y,D}`. -/
theorem ord_nonneg_iff_mem_range {g : X.residueField (D.π (genericPoint D.Y))} (hg : g ≠ 0) :
    0 ≤ D.ord g ↔ D.pullback g ∈
      (algebraMap (D.Y.presheaf.stalk D.point) D.Y.functionField).range := by
  have hw : D.pullback g ≠ 0 := (map_ne_zero_iff _ D.pullback_injective).mpr hg
  have : Ring.KrullDimLE 1 (D.Y.presheaf.stalk D.point) :=
    krullDimLE_of_coheight_le (le_of_eq D.coheight_point)
  have hiff : 0 ≤ D.ord g ↔ 1 ≤ Ring.ordFrac (D.Y.presheaf.stalk D.point) (D.pullback g) := by
    unfold PrimeDivisorOver.ord
    rw [Scheme.le_ord_iff D.coheight_point hw]
    simp only [ofAdd_zero, WithZero.coe_one]
    rfl
  rw [hiff]
  constructor
  · exact mem_range_of_one_le_ordFrac _
  · rintro ⟨r, hr⟩
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [map_zero] at hr
      exact hw hr.symm
    rw [← hr]
    exact Ring.ordFrac_ge_one_of_ne_zero hr0

/-- `ord_D = 0` on the rational functions whose pull-back is a unit of `𝒪_{Y,D}`. -/
theorem ord_eq_zero_of_isUnit {g : X.residueField (D.π (genericPoint D.Y))}
    {r : D.Y.presheaf.stalk D.point} (hr : IsUnit r)
    (hgr : D.pullback g = algebraMap (D.Y.presheaf.stalk D.point) D.Y.functionField r) :
    D.ord g = 0 := by
  have : Ring.KrullDimLE 1 (D.Y.presheaf.stalk D.point) :=
    krullDimLE_of_coheight_le (le_of_eq D.coheight_point)
  have hw : D.pullback g ≠ 0 := by
    rw [hgr]
    exact (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hr.ne_zero
  unfold PrimeDivisorOver.ord
  rw [Scheme.ord_eq_iff D.coheight_point hw, hgr]
  change Ring.ordFrac (D.Y.presheaf.stalk D.point) _ = _
  rw [Ring.ordFrac_of_isUnit hr]
  rfl

/-- **The valuation ring of `ord_D` is essentially of finite type over an affine chart of `X`.**
There are an affine open `U ⊆ X` containing `π(D)` (hence the generic point `π(η_Y)`) and
rational functions `b₁, …, b_s` on `X` such that, `A[b]` being the subring of `ℂ(X)` generated
by the sections of `𝒪_X` over `U` and the `bᵢ`:
* `ord_D ≥ 0` on `A[b]`;
* every rational function `g ≠ 0` with `ord_D(g) ≥ 0` is `a / c` with `a, c ∈ A[b]`, `c ≠ 0`,
  `ord_D(c) = 0`.
That is, `R_D = A[b]_𝔭` with `𝔭 = {ord_D > 0} ∩ A[b]`. -/
theorem exists_affine_generators :
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (hU : D.π (genericPoint D.Y) ∈ U) (_ : D.π D.point ∈ U)
      (s : ℕ) (b : Fin s → X.residueField (D.π (genericPoint D.Y))),
      (∀ g ∈ Subring.closure (Set.range (sectionToField D U hU) ∪ Set.range b), g ≠ 0 →
        0 ≤ D.ord g) ∧
      ∀ g : X.residueField (D.π (genericPoint D.Y)), g ≠ 0 → 0 ≤ D.ord g →
        ∃ a ∈ Subring.closure (Set.range (sectionToField D U hU) ∪ Set.range b),
        ∃ c ∈ Subring.closure (Set.range (sectionToField D U hU) ∪ Set.range b),
          c ≠ 0 ∧ D.ord c = 0 ∧ g * c = a := by
  classical
  -- the affine charts
  obtain ⟨_, ⟨U, hUa, rfl⟩, hpU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (D.π D.point)) isOpen_univ
  have hpU' : D.point ∈ D.π ⁻¹ᵁ U := hpU
  obtain ⟨_, ⟨V, hVa, rfl⟩, hpV, hVU⟩ :=
    D.Y.isBasis_affineOpens.exists_subset_of_mem_open hpU' (D.π ⁻¹ᵁ U).isOpen
  have hηp : genericPoint D.Y ⤳ D.point := (genericPoint_spec D.Y).specializes (Set.mem_univ _)
  have hηV : genericPoint D.Y ∈ V := hηp.mem_open V.isOpen hpV
  have hηU : D.π (genericPoint D.Y) ∈ U := hVU hηV
  have e : V ≤ D.π ⁻¹ᵁ U := hVU
  have : Nonempty V := ⟨⟨_, hpV⟩⟩
  have : Nonempty (D.π ⁻¹ᵁ U) := ⟨⟨_, hpU'⟩⟩
  -- `Γ(V, 𝒪_Y)` is a finitely generated `Γ(U, 𝒪_X)`-algebra
  set φ : Γ(X, U) →+* Γ(D.Y, V) := (D.π.appLE U V e).hom with hφ
  have hft : φ.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType D.π inferInstance ⟨U, hUa⟩ ⟨V, hVa⟩ e
  let := φ.toAlgebra
  obtain ⟨t, ht⟩ := hft.out
  set ψ : Γ(D.Y, V) →+* X.residueField (D.π (genericPoint D.Y)) :=
    (pullbackEquiv D).symm.toRingHom.comp (D.Y.germToFunctionField V).hom with hψ
  set b : Fin t.card → X.residueField (D.π (genericPoint D.Y)) :=
    fun i => ψ (t.equivFin.symm i).1 with hb
  set S := Set.range (sectionToField D U hηU) ∪ Set.range b with hS
  -- `ψ ∘ φ` is `sectionToField`
  have hψφ : ∀ a, ψ (φ a) = sectionToField D U hηU a := by
    intro a
    apply (pullbackEquiv D).injective
    rw [hψ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      RingEquiv.apply_symm_apply, pullbackEquiv_apply, pullback_sectionToField]
    rw [hφ, Scheme.Hom.appLE]
    change (D.Y.presheaf.germ V (genericPoint D.Y) hηV)
      ((D.Y.presheaf.map (homOfLE e).op) (D.π.app U a)) = _
    rw [TopCat.Presheaf.germ_res_apply]
  -- the image of `ψ` lies in `A[b]`
  have hψS : ∀ x : Γ(D.Y, V), ψ x ∈ Subring.closure S := by
    intro x
    have hx : x ∈ Algebra.adjoin Γ(X, U) (t : Set Γ(D.Y, V)) := by rw [ht]; trivial
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      apply Subring.subset_closure
      right
      refine ⟨t.equivFin ⟨x, hx⟩, ?_⟩
      simp [hb]
    | algebraMap a =>
      apply Subring.subset_closure
      left
      exact ⟨a, (hψφ a).symm⟩
    | add x y _ _ hx hy =>
      rw [map_add]
      exact Subring.add_mem _ hx hy
    | mul x y _ _ hx hy =>
      rw [map_mul]
      exact Subring.mul_mem _ hx hy
  -- the pull-back of `ψ x` is the germ of `x` at `D`
  have hpbψ : ∀ x : Γ(D.Y, V), D.pullback (ψ x) =
      algebraMap (D.Y.presheaf.stalk D.point) D.Y.functionField (D.Y.presheaf.germ V _ hpV x) := by
    intro x
    rw [← pullbackEquiv_apply, hψ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
      RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply,
      Scheme.algebraMap_germ_eq_germToFunctionField]
  -- `A[b]` lies in the valuation ring
  set T : Subring (X.residueField (D.π (genericPoint D.Y))) :=
    (algebraMap (D.Y.presheaf.stalk D.point) D.Y.functionField).range.comap D.pullback with hT
  have hST : Subring.closure S ≤ T := by
    rw [Subring.closure_le]
    rintro g (⟨a, rfl⟩ | ⟨i, rfl⟩)
    · rw [SetLike.mem_coe, hT, Subring.mem_comap, pullback_sectionToField]
      exact ⟨_, Scheme.algebraMap_germ_eq_germToFunctionField (X := D.Y) hpU' _⟩
    · rw [SetLike.mem_coe, hT, Subring.mem_comap, hpbψ]
      exact ⟨_, rfl⟩
  refine ⟨U, hUa, hηU, hpU, t.card, b, fun g hg hg0 => (ord_nonneg_iff_mem_range D hg0).mpr (hST hg),
    fun g hg0 hg => ?_⟩
  -- the converse: `R_D` is the localization of `Γ(V, 𝒪_Y)` at the prime of `D`
  obtain ⟨r, hr⟩ := (ord_nonneg_iff_mem_range D hg0).mp hg
  let := TopCat.Presheaf.algebra_section_stalk D.Y.presheaf ⟨D.point, hpV⟩
  have hloc : IsLocalization.AtPrime (D.Y.presheaf.stalk D.point)
      (hVa.primeIdealOf ⟨D.point, hpV⟩).asIdeal := hVa.isLocalization_stalk ⟨D.point, hpV⟩
  obtain ⟨⟨a', c'⟩, hac⟩ := IsLocalization.surj (hVa.primeIdealOf ⟨D.point, hpV⟩).asIdeal.primeCompl r
  have hgerm : ∀ x : Γ(D.Y, V), algebraMap Γ(D.Y, V) (D.Y.presheaf.stalk D.point) x =
      D.Y.presheaf.germ V _ hpV x := fun x => rfl
  simp only [hgerm] at hac
  have hcu : IsUnit (D.Y.presheaf.germ V _ hpV (c' : Γ(D.Y, V))) := by
    by_contra h
    exact c'.2 ((IsLocalization.AtPrime.to_map_mem_maximal_iff (D.Y.presheaf.stalk D.point)
      (hVa.primeIdealOf ⟨D.point, hpV⟩).asIdeal (c' : Γ(D.Y, V))).mp h)
  refine ⟨ψ a', hψS a', ψ c', hψS c', ?_, ?_, ?_⟩
  · intro h0
    have h1 := hpbψ c'
    rw [h0, map_zero] at h1
    exact hcu.ne_zero ((IsFractionRing.injective _ D.Y.functionField) (h1.symm.trans (map_zero _).symm))
  · exact ord_eq_zero_of_isUnit D hcu (hpbψ c')
  · apply D.pullback_injective
    rw [map_mul, hpbψ, hpbψ, ← hr, ← map_mul, hac]

end PrimeDivisorOver'

end SGPT.NAPotential.AlgPrimes3

end
