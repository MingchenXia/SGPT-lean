import SGPT.PSH.BookRestrictionIdeal
import SGPT.PSH.GlobalL2CoverSystem

/-!
# Germ algebra for Siu's global generation

Blueprint `claude-gagamult:siu-generation` (auxiliary part).

* `spanGerms S x`: the ideal of `𝒪_{M,x}` generated by the germs at `x` of the functions
  satisfying `S`; a germ in it satisfies the existing `IsInSpanAt S x`
  (`isInSpanAt_of_mk_mem_spanGerms`).
* `le_of_le_sup_maximalIdeal_smul`: Nakayama's lemma in the Noetherian local ring `𝒪_{M,x}`:
  `I ≤ N ⊔ 𝔪 I` implies `I ≤ N`.
* Coefficients of holomorphic sections in atlas frames are holomorphic
  (`holomorphicAt_coef_of_mdifferentiableOn`), and `y ↦ g y • e.symm y 1` is a holomorphic
  section where `g` is holomorphic, over the base set of `e` (`isHolomorphicSectionOn_smul_frame`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
noncomputable section

namespace SGPT.NAPotential.GAGAMult

open Set Filter Bundle
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending
open SGPT.Okounkov SGPT.PSH.IdealRestriction

section Germs

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-- The ideal of `𝒪_{M,x}` generated by the germs at `x` of the functions satisfying `S`
(holomorphic near `x`). -/
def spanGerms (S : (M → ℂ) → Prop) (x : M) : Ideal (NativeHolGerm n M x) :=
  Ideal.span {γ | ∃ (h : M → ℂ) (hh : HolomorphicAt n h x), S h ∧ γ = NativeHolGerm.mk h hh}

theorem mk_mem_spanGerms {S : (M → ℂ) → Prop} {x : M} {h : M → ℂ} (hh : HolomorphicAt n h x)
    (hS : S h) : NativeHolGerm.mk h hh ∈ spanGerms S x :=
  Ideal.subset_span ⟨h, hh, hS, rfl⟩

theorem mk_mem_stalkIdeal {𝔞 : GermIdeal n M} {x : M} {g : M → ℂ} (hg : HolomorphicAt n g x)
    (h : 𝔞.mem x g) : NativeHolGerm.mk g hg ∈ stalkIdeal 𝔞 x :=
  Ideal.subset_span ⟨g, hg, h, rfl⟩

/-- A germ in the span of the germs of `S` is a finite holomorphic combination of members of
`S`, i.e. `IsInSpanAt S x`. -/
theorem isInSpanAt_of_mk_mem_spanGerms {S : (M → ℂ) → Prop} {x : M} {g : M → ℂ}
    (hg : HolomorphicAt n g x) (h : NativeHolGerm.mk g hg ∈ spanGerms S x) :
    IsInSpanAt (n := n) S x g := by
  obtain ⟨N, c, γ, hsum⟩ := Submodule.mem_span_set'.mp h
  choose s hs hSs hγ using fun i => (γ i).property
  choose a ha hca using fun i => NativeHolGerm.exists_eq_mk (c i)
  refine ⟨hg, N, s, a, hSs, ha, ?_⟩
  have hsum' : HolomorphicAt n (fun y => ∑ i, a i y * s i y) x :=
    HolomorphicAt.sum _ fun i _ => (ha i).mul (hs i)
  have heq : NativeHolGerm.mk g hg = NativeHolGerm.mk _ hsum' := by
    rw [mk_sum_mul a s ha hs hsum', ← hsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_eq_mul, hca i, hγ i]
  exact NativeHolGerm.mk_eq_mk_iff.mp heq

variable [IsComplexManifold n M]

/-- A germ vanishing at the point lies in the maximal ideal. -/
theorem mk_mem_maximalIdeal {x : M} {c : M → ℂ} (hc : HolomorphicAt n c x) (h0 : c x = 0) :
    NativeHolGerm.mk c hc ∈ IsLocalRing.maximalIdeal (NativeHolGerm n M x) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, NativeHolGerm.isUnit_iff_eval_ne_zero,
    NativeHolGerm.eval_mk, h0]
  exact fun h => h rfl


/-- **Nakayama's lemma** in `𝒪_{M,x}`: if `I ≤ N ⊔ 𝔪 I` then `I ≤ N`. -/
theorem le_of_le_sup_maximalIdeal_smul {x : M} {I N : Ideal (NativeHolGerm n M x)}
    (h : I ≤ N ⊔ IsLocalRing.maximalIdeal (NativeHolGerm n M x) • I) : I ≤ N := by
  have hfg : (I : Submodule (NativeHolGerm n M x) (NativeHolGerm n M x)).FG :=
    IsNoetherian.noetherian I
  have hjac : IsLocalRing.maximalIdeal (NativeHolGerm n M x) ≤
      (⊥ : Ideal (NativeHolGerm n M x)).jacobson :=
    le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).symm
  exact Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac h

end Germs

section Frames

variable {n : ℕ} {X : Type} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X]
  {V : X → Type} [∀ x, NormedAddCommGroup (V x)] [∀ x, NormedSpace ℂ (V x)]
  [TopologicalSpace (TotalSpace ℂ V)] [FiberBundle ℂ V] [VectorBundle ℂ ℂ V]
  [ContMDiffVectorBundle ∞ ℂ V (𝓘(ℂ, ComplexModel n))]

/-- The coefficient of a section, holomorphic near `x`, in an atlas frame containing `x` is
holomorphic near `x`. -/
theorem holomorphicAt_coef_of_mdifferentiableOn
    (e : Trivialization ℂ (TotalSpace.proj : TotalSpace ℂ V → X)) [MemTrivializationAtlas e]
    {s : (y : X) → V y} {U : Set X} (hU : IsOpen U)
    (hs : SGPT.PSH.LineBundleMetric.IsHolomorphicSectionOn (n := n) V s U) {x : X}
    (hxU : x ∈ U) (hx : x ∈ e.baseSet) :
    HolomorphicAt n (fun y => e.continuousLinearMapAt ℂ y (s y)) x := by
  filter_upwards [(hU.inter e.open_baseSet).mem_nhds ⟨hxU, hx⟩] with y hy
  have hsm : MDifferentiableAt 𝓘(ℂ, ComplexModel n) (𝓘(ℂ, ComplexModel n).prod 𝓘(ℂ, ℂ))
      (fun y => TotalSpace.mk' ℂ y (s y)) y :=
    (hs y hy.1).mdifferentiableAt (hU.mem_nhds hy.1)
  have hco := (Trivialization.mdifferentiableAt_section_iff (IB := 𝓘(ℂ, ComplexModel n)) e s
    hy.2).mp hsm
  refine hco.congr_of_eventuallyEq ?_
  filter_upwards [e.open_baseSet.mem_nhds hy.2] with z hz
  exact Trivialization.continuousLinearMapAt_apply_of_mem (R := ℂ) e hz _

/-- The coefficient of a global holomorphic section in an atlas frame containing `x` is
holomorphic near `x`. -/
theorem holomorphicAt_coef_of_contMDiff
    (e : Trivialization ℂ (TotalSpace.proj : TotalSpace ℂ V → X)) [MemTrivializationAtlas e]
    {s : (y : X) → V y}
    (hs : ContMDiff 𝓘(ℂ, ComplexModel n) (𝓘(ℂ, ComplexModel n).prod 𝓘(ℂ, ℂ)) ∞
      (fun y => TotalSpace.mk' ℂ y (s y))) {x : X} (hx : x ∈ e.baseSet) :
    HolomorphicAt n (fun y => e.continuousLinearMapAt ℂ y (s y)) x :=
  holomorphicAt_coef_of_mdifferentiableOn e isOpen_univ
    (fun y _ => (hs y).mdifferentiableAt (by simp) |>.mdifferentiableWithinAt) (mem_univ x) hx

/-- `y ↦ g y • e.symm y 1` is a holomorphic section over the open set `U ⊆ e.baseSet` on which
`g` is holomorphic. -/
theorem isHolomorphicSectionOn_smul_frame
    (e : Trivialization ℂ (TotalSpace.proj : TotalSpace ℂ V → X)) [MemTrivializationAtlas e]
    {g : X → ℂ} {U : Set X} (hUe : U ⊆ e.baseSet)
    (hg : ∀ y ∈ U, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) g y) :
    SGPT.PSH.LineBundleMetric.IsHolomorphicSectionOn (n := n) V
      (fun y => g y • e.symm y 1) U := by
  intro y hy
  refine MDifferentiableAt.mdifferentiableWithinAt ?_
  rw [Trivialization.mdifferentiableAt_section_iff (IB := 𝓘(ℂ, ComplexModel n)) e _ (hUe hy)]
  refine (hg y hy).congr_of_eventuallyEq ?_
  filter_upwards [e.open_baseSet.mem_nhds (hUe hy)] with z hz
  rw [← Trivialization.continuousLinearMapAt_apply_of_mem (R := ℂ) e hz, map_smul,
    SGPT.PSH.GlobalL2.trivialization_coef_frame e hz, smul_eq_mul, mul_one]

/-- In a line bundle, the coefficient of `u` in a frame `e'` is its coefficient in `e` times the
coefficient of the frame vector of `e`. -/
theorem coef_eq_coef_mul_transition
    (e e' : Trivialization ℂ (TotalSpace.proj : TotalSpace ℂ V → X)) [MemTrivializationAtlas e]
    [MemTrivializationAtlas e'] {y : X} (hy : y ∈ e.baseSet) (u : V y) :
    e'.continuousLinearMapAt ℂ y u =
      e.continuousLinearMapAt ℂ y u * e'.continuousLinearMapAt ℂ y (e.symm y 1) := by
  conv_lhs => rw [SGPT.PSH.GlobalL2.trivialization_eq_coef_smul_frame e hy u]
  rw [map_smul, smul_eq_mul]

/-- The frame transition `e'(e.symm y 1)` does not vanish on the common base set. -/
theorem transition_ne_zero
    (e e' : Trivialization ℂ (TotalSpace.proj : TotalSpace ℂ V → X)) [MemTrivializationAtlas e]
    [MemTrivializationAtlas e'] {y : X} (hy : y ∈ e.baseSet) (hy' : y ∈ e'.baseSet) :
    e'.continuousLinearMapAt ℂ y (e.symm y 1) ≠ 0 := by
  intro h0
  have h1 := SGPT.PSH.GlobalL2.trivialization_eq_coef_smul_frame e' hy' (e.symm y 1)
  rw [h0, zero_smul] at h1
  have h2 := SGPT.PSH.GlobalL2.trivialization_coef_frame e hy
  rw [h1, map_zero] at h2
  exact zero_ne_one h2

end Frames

end SGPT.NAPotential.GAGAMult
