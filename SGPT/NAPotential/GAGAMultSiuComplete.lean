import SGPT.NAPotential.GAGAMultSiu
import SGPT.Bergman.SourceDegreeMultiplierIdeal
import SGPT.Foundations.Analysis.Pending.GermIdealTotalTransform
import SGPT.Foundations.Analysis.Pending.UniformPerturbedKahlerLowerBound
import SGPT.PSH.GlobalL2SectionsPosMass

/-!
# Siu's uniform global generation: all dimensions, and the sections of `L^k ⊗ T ⊗ 𝓘(kφ)`

Blueprint `claude-gagamult:siu-generation`, `claude-gagamult:l2-sections`.

* `siuGlobalGeneration : SiuGlobalGenerationStatement n X` for every `n`; in dimension zero the
  stalks of `𝓘(kφ)` at points with `φ(x) > -∞` are generated by one section not vanishing at `x`
  (`globalPointExtension`), and in dimension zero `φ > -∞` everywhere (local nondegeneracy).
* `mem_multiplierIdeal_of_lintegral_lt_top`: a global holomorphic section `s` of a Hermitian line
  bundle with `∫_X |s|² e^{-cφ} dμ < ∞` has its coefficient, in every atlas frame at every point
  `y`, in `𝓘(cφ)_y`; i.e. `s ∈ H⁰(X, V ⊗ 𝓘(cφ))`.
* `siuGlobalGeneration_iff`: hence, for `k ≥ k₀` and a quasi-psh `φ ∈ PSH(X, θ - δω)`, a germ lies
  in `𝓘(kφ)_x` if and only if it is a holomorphic combination of the coefficients of the global
  sections of `L^k ⊗ T` with finite `L²(e^{-kφ})` norm: `𝓘(kφ) ⊗ L^k ⊗ T` is generated by
  `H⁰(X, L^k ⊗ T ⊗ 𝓘(kφ))`.
* `siuGlobalGeneration_fixedWeight`: for a line bundle `L` whose curvature is the Kähler form and
  an arbitrary quasi-psh `ψ ∈ PSH(X, η)`, the multiplier ideal `𝓘(ψ) ⊗ L^j` is generated by
  `H⁰(X, L^j ⊗ 𝓘(ψ))` for all `j ≫ 0` (the form used for the algebraic models of `𝓘(kφ)`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace SGPT.NAPotential.GAGAMult

open Set Filter Metric MeasureTheory Bundle
open scoped Topology ENNReal ContDiff Manifold
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.PositiveClasses
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.ChartwiseGlobalL1
open SGPT.Bergman.TensorDictionaryDraft SGPT.Bergman.PolynomialH0Growth
  SGPT.Bergman.CompactHolomorphicSectionsDraft
open HermitianHolomorphicLineBundle
open SGPT.PSH.GlobalL2 SGPT.Okounkov SGPT.PSH.IdealRestriction

/-! ### Dimension zero -/

section Zero

variable {X : Type} [TopologicalSpace X] [ChartedSpace (ComplexModel 0) X]
  [IsComplexManifold 0 X] [MeasurableSpace X] [BorelSpace X]

/-- Points of a complex manifold of dimension zero are open. -/
theorem isOpen_singleton_dim_zero (x : X) : IsOpen ({x} : Set X) := by
  have hsrc : (chartAt (ComplexModel 0) x).source = {x} := by
    ext y
    constructor
    · intro hy
      exact (chartAt (ComplexModel 0) x).injOn hy (mem_chart_source (ComplexModel 0) x)
        (Subsingleton.elim _ _)
    · intro hy; rw [mem_singleton_iff.mp hy]; exact mem_chart_source (ComplexModel 0) x
  rw [← hsrc]
  exact (chartAt (ComplexModel 0) x).open_source

/-- **Siu's uniform global generation in dimension zero.** -/
theorem siuGlobalGeneration_zero : SiuGlobalGenerationStatement 0 X := by
  intro hX ωb μ hμ L T hL hT θ hθ δ hδ
  obtain ⟨k₀, C, hC, hext⟩ := globalPointExtension hX ωb μ hμ L T hL hT θ hθ δ hδ
  refine ⟨k₀, fun k hk φ hφ x e hxe g hg => ?_⟩
  have := e.property
  have hφx : φ x ≠ ⊥ := by
    obtain ⟨y, hy, hne⟩ := hφ.2 x {x} (isOpen_singleton_dim_zero x) (mem_singleton x)
    rwa [mem_singleton_iff.mp hy] at hne
  have hφtop : φ x ≠ ⊤ := hφ.1.quasiPlurisubharmonic.ne_top x
  obtain ⟨s, hsx, hsint⟩ := hext k hk φ hφ x hφx (e.val.symm x 1)
  have hfin : ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight (k : ℝ) (φ y) ∂μ < ⊤ := by
    refine lt_of_le_of_lt hsint (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ?_))
    obtain ⟨t, ht⟩ : ∃ t : ℝ, φ x = (t : EReal) :=
      ⟨(φ x).toReal, (EReal.coe_toReal hφtop hφx).symm⟩
    rw [ht, multiplierWeight_coe]; exact ENNReal.ofReal_lt_top
  set S : (X → ℂ) → Prop := fun h => ∃ s : twistedSections L T k,
    ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight (k : ℝ) (φ y) ∂μ < ⊤ ∧
      h = fun y => e.val.continuousLinearMapAt ℂ y (s y) with hS
  have hsh : HolomorphicAt 0 (fun y => e.val.continuousLinearMapAt ℂ y (s y)) x :=
    holomorphicAt_coef_of_contMDiff e.val s.contMDiff hxe
  have hu : IsUnit (NativeHolGerm.mk _ hsh) := by
    rw [NativeHolGerm.isUnit_iff_eval_ne_zero, NativeHolGerm.eval_mk, hsx,
      trivialization_coef_frame _ hxe]
    exact one_ne_zero
  refine isInSpanAt_of_mk_mem_spanGerms hg.1 ?_
  have hrepr : NativeHolGerm.mk g hg.1 =
      (NativeHolGerm.mk g hg.1 * ↑hu.unit⁻¹) * NativeHolGerm.mk _ hsh := by
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  rw [hrepr]
  exact Ideal.mul_mem_left _ _ (mk_mem_spanGerms hsh ⟨s, hfin, rfl⟩)

end Zero

variable {n : ℕ} {X : Type} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] [MeasurableSpace X] [BorelSpace X]

/-- **Siu's uniform global generation** (blueprint `claude-gagamult:siu-generation`), in every
dimension. -/
theorem siuGlobalGeneration : SiuGlobalGenerationStatement n X := by
  rcases Nat.eq_zero_or_pos n with h | h
  · subst h; exact siuGlobalGeneration_zero
  · exact siuGlobalGeneration_pos h

/-! ### Global `L²` sections lie in the multiplier ideal -/

/-- **Sections of `V ⊗ 𝓘(cφ)`** (blueprint `claude-gagamult:l2-sections`): if a global
holomorphic section `s` of a Hermitian holomorphic line bundle `V` has
`∫_X |s|² e^{-cφ} dμ < ∞` (`μ` a smooth positive volume, `φ` quasi-psh, `c > 0`), then in every
atlas frame `e` and at every point `y` of its base set, the coefficient of `s` lies in
`𝓘(cφ)_y`. -/
theorem mem_multiplierIdeal_of_lintegral_lt_top {μ : Measure X}
    (hμ : IsSmoothPositiveVolume (n := n) μ) {V : HermitianHolomorphicLineBundle.{0, 0} n X}
    (s : SGPT.Bergman.QuantizationDraft.HolomorphicSections (n := n) V.Fiber)
    {θ : SmoothRealForm n X 2} {φ : X → EReal} (hφ : ThetaPlurisubharmonic θ φ) {c : ℝ}
    (hc : 0 < c) (hint : ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight c (φ y) ∂μ < ⊤)
    (e : AtlasFrame V) {y : X} (hy : y ∈ e.val.baseSet) :
    (multiplierIdeal (n := n) c φ).mem y (fun z => e.val.continuousLinearMapAt ℂ z (s z)) := by
  have := e.property
  set d := complexChartAt (n := n) y with hd
  set q := d.val y with hq
  have hyd : y ∈ d.val.source := mem_complexChartAt_source y
  refine ⟨holomorphicAt_coef_of_contMDiff e.val s.contMDiff hy, ?_⟩
  -- a closed ball around `q` inside the chart target and the frame domain
  have hO : IsOpen (d.val.target ∩ d.val.symm ⁻¹' e.val.baseSet) :=
    d.val.isOpen_inter_preimage_symm e.val.open_baseSet
  have hqO : q ∈ d.val.target ∩ d.val.symm ⁻¹' e.val.baseSet :=
    ⟨d.val.map_source hyd, by rw [mem_preimage, hq, d.val.left_inv hyd]; exact hy⟩
  obtain ⟨r, hr, hrO⟩ := Metric.isOpen_iff.mp hO q hqO
  have hcl : closedBall q (r / 2) ⊆ d.val.target ∩ d.val.symm ⁻¹' e.val.baseSet :=
    (closedBall_subset_ball (by linarith)).trans hrO
  set B := ball q (r / 2) with hB
  have hBcl : B ⊆ closedBall q (r / 2) := ball_subset_closedBall
  -- the density of `μ` and the frame norm are bounded below on the closed ball
  obtain ⟨ρ, hρs, hρpos, hρmap⟩ := hμ d
  have hKc : IsCompact (closedBall q (r / 2)) := isCompact_closedBall q _
  have hne : (closedBall q (r / 2)).Nonempty := ⟨q, mem_closedBall_self (by linarith)⟩
  obtain ⟨z₁, hz₁, hmin₁⟩ := hKc.exists_isMinOn hne
    (hρs.continuousOn.mono fun z hz => (hcl hz).1)
  have hfc : ContinuousOn (fun z => ‖e.val.symm (d.val.symm z) 1‖) (closedBall q (r / 2)) :=
    (frameNorm_continuousOn V.Fiber e.val).comp (d.val.continuousOn_symm.mono fun z hz => (hcl hz).1)
      fun z hz => (hcl hz).2
  obtain ⟨z₂, hz₂, hmin₂⟩ := hKc.exists_isMinOn hne hfc
  set ρ₀ := ρ z₁ with hρ₀
  set m₀ := ‖e.val.symm (d.val.symm z₂) 1‖ with hm₀
  have hρ₀ : 0 < ρ₀ := hρpos z₁ (hcl hz₁).1
  have hm₀ : 0 < m₀ := frameNorm_pos V.Fiber e.val (hcl hz₂).2
  -- the coefficient in the chart
  set f : ComplexModel n → ℂ := fun z => e.val.continuousLinearMapAt ℂ (d.val.symm z) (s (d.val.symm z))
    with hf
  have hfd : DifferentiableOn ℂ f B := by
    refine (differentiableOn_coord_of_holomorphicSectionOn e.val d isOpen_univ
      (F := fun z => s z) (fun z _ => ((s.contMDiff z).mdifferentiableAt
        (by simp)).mdifferentiableWithinAt)).mono fun z hz => ?_
    exact ⟨(hcl (hBcl hz)).1, mem_univ _, (hcl (hBcl hz)).2⟩
  have hnorm : ∀ z ∈ B, ‖s (d.val.symm z)‖ = ‖f z‖ * ‖e.val.symm (d.val.symm z) 1‖ :=
    fun z hz => norm_eq_coef_mul_norm_frame e.val (hcl (hBcl hz)).2 _
  have husc : UpperSemicontinuousOn (chartFunction φ d) B := by
    have h := SGPT.Okounkov.TranscendentalL2.upperSemicontinuousOn_chartFunction_of_thetaPlurisubharmonicOn
      (Ω := univ) (fun e z hz _ => hφ e z hz) d
    exact h.mono fun z hz => ⟨(hcl (hBcl hz)).1, mem_univ _⟩
  have hwm : AEMeasurable (fun z => multiplierWeight c (chartFunction φ d z)) (volume.restrict B) :=
    DemaillyApproximation.aemeasurable_multiplierWeight_restrict isOpen_ball husc hc.ne'
  have hfm : AEMeasurable (fun z => ENNReal.ofReal (‖f z‖ ^ 2)) (volume.restrict B) :=
    ENNReal.measurable_ofReal.comp_aemeasurable
      ((hfd.continuousOn.aestronglyMeasurable measurableSet_ball).norm.aemeasurable.pow_const 2)
  refine ⟨hc, B, isOpen_ball, mem_ball_self (by linarith), hfd, hfm.mul hwm, ?_⟩
  -- comparison with the global integral
  have hfr : ContinuousOn (fun z => ‖e.val.symm (d.val.symm z) 1‖) B := hfc.mono hBcl
  have hsm : AEMeasurable (fun z => ENNReal.ofReal (‖s (d.val.symm z)‖ ^ 2) *
      multiplierWeight c (φ (d.val.symm z))) (volume.restrict B) := by
    have h1 : AEMeasurable (fun z => ENNReal.ofReal ((‖f z‖ * ‖e.val.symm (d.val.symm z) 1‖) ^ 2))
        (volume.restrict B) :=
      ENNReal.measurable_ofReal.comp_aemeasurable
        (((hfd.continuousOn.norm.mul hfr).aestronglyMeasurable measurableSet_ball).aemeasurable.pow_const 2)
    refine (h1.mul hwm).congr ?_
    filter_upwards [ae_restrict_mem measurableSet_ball] with z hz
    rw [hnorm z hz]; rfl
  have hchart := SGPT.PSH.GlobalL2.setLIntegral_chart_ball d hρs.continuousOn hρmap isOpen_ball
    (fun z hz => (hcl (hBcl hz)).1) (f := fun x => ENNReal.ofReal (‖s x‖ ^ 2) * multiplierWeight c (φ x))
    hsm
  set A : ℝ≥0∞ := ENNReal.ofReal ((m₀ ^ 2 * ρ₀)⁻¹) with hA
  calc ∫⁻ z in B, multiplierDensity (chartFunction φ d) c f z
      ≤ ∫⁻ z in B, A * (ENNReal.ofReal (‖s (d.val.symm z)‖ ^ 2) *
          multiplierWeight c (φ (d.val.symm z)) * ENNReal.ofReal (ρ z)) := by
        refine setLIntegral_mono' measurableSet_ball fun z hz => ?_
        have hρz : ρ₀ ≤ ρ z := hmin₁ (hBcl hz)
        have hmz : m₀ ≤ ‖e.val.symm (d.val.symm z) 1‖ := hmin₂ (hBcl hz)
        show ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (φ (d.val.symm z)) ≤ _
        rw [hnorm z hz, hA]
        have hle : ‖f z‖ ^ 2 ≤ (m₀ ^ 2 * ρ₀)⁻¹ *
            ((‖f z‖ * ‖e.val.symm (d.val.symm z) 1‖) ^ 2 * ρ z) := by
          rw [mul_pow, inv_mul_eq_div, le_div_iff₀ (by positivity)]
          have h1 : m₀ ^ 2 ≤ ‖e.val.symm (d.val.symm z) 1‖ ^ 2 := pow_le_pow_left₀ hm₀.le hmz 2
          have h2 := mul_le_mul h1 hρz hρ₀.le (sq_nonneg _)
          have h3 := mul_le_mul_of_nonneg_left h2 (sq_nonneg ‖f z‖)
          nlinarith [h3]
        calc ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (φ (d.val.symm z))
            ≤ ENNReal.ofReal ((m₀ ^ 2 * ρ₀)⁻¹ *
                ((‖f z‖ * ‖e.val.symm (d.val.symm z) 1‖) ^ 2 * ρ z)) *
                multiplierWeight c (φ (d.val.symm z)) :=
              mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal hle) zero_le
          _ = _ := by
              rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (sq_nonneg _)]
              ring
    _ = A * ∫⁻ z in B, ENNReal.ofReal (‖s (d.val.symm z)‖ ^ 2) *
          multiplierWeight c (φ (d.val.symm z)) * ENNReal.ofReal (ρ z) :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ = A * ∫⁻ x in d.val.source ∩ d.val ⁻¹' B, ENNReal.ofReal (‖s x‖ ^ 2) *
          multiplierWeight c (φ x) ∂μ := by rw [hchart]
    _ ≤ A * ∫⁻ x, ENNReal.ofReal (‖s x‖ ^ 2) * multiplierWeight c (φ x) ∂μ :=
        mul_le_mul_of_nonneg_left (setLIntegral_le_lintegral _ _) zero_le
    _ < ⊤ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top hint

/-- **`𝓘(kφ) ⊗ L^k ⊗ T` is generated by `H⁰(X, L^k ⊗ T ⊗ 𝓘(kφ))`** (blueprint
`claude-gagamult:siu-generation`, the form used for algebraic models): for `k ≥ k₀`, every
`φ ∈ PSH(X, θ - δω)`, every point `x` and every atlas frame `e` of `L^k ⊗ T` at `x`, a germ lies in
`𝓘(kφ)_x` if and only if it is a holomorphic combination of `e`-coefficients of global holomorphic
sections `s` with `∫_X |s|² e^{-kφ} dμ < ∞`. -/
theorem siuGlobalGeneration_iff [CompactSpace X] (ωb : KahlerBackground n X) {μ : Measure X}
    (hμ : IsSmoothPositiveVolume (n := n) μ) {L T : HermitianHolomorphicLineBundle.{0, 0} n X}
    (hL : IsSourceSmoothHermitianMetric L) (hT : IsSourceSmoothHermitianMetric T)
    {θ : ClosedRealOneOneForm n X} (hθ : IsOwnFirstChernForm L θ) {δ : ℝ} (hδ : 0 < δ) :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
    ∀ φ : X → EReal, IsThetaPshPotential (θ - δ • ωb.form).val φ →
    ∀ (x : X) (e : AtlasFrame (twistedPower L T k)), x ∈ e.val.baseSet → ∀ g : X → ℂ,
      ((multiplierIdeal (n := n) (k : ℝ) φ).mem x g ↔
        IsInSpanAt (n := n) (fun h => ∃ s : twistedSections L T k,
          ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight (k : ℝ) (φ y) ∂μ < ⊤ ∧
          h = fun y => e.val.continuousLinearMapAt ℂ y (s y)) x g) := by
  obtain ⟨k₀, hk₀⟩ := siuGlobalGeneration (n := n) (X := X) inferInstance ωb μ hμ L T hL hT θ hθ
    δ hδ
  refine ⟨max k₀ 1, fun k hk φ hφ x e hxe g => ⟨fun hg =>
    hk₀ k (le_of_max_le_left hk) φ hφ x e hxe g hg, fun hg => ?_⟩⟩
  have hk1 : (0 : ℝ) < k := by exact_mod_cast (le_of_max_le_right hk)
  have hcoh : (multiplierIdeal (n := n) (k : ℝ) φ).IsCoherent :=
    SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine
      ⟨hφ.1.quasiPlurisubharmonic, hφ.2⟩ hk1
  refine GermIdealTotalTransform.mem_of_isInSpanAt_mem hcoh ?_
  refine IsInSpanAt.mono ?_ hg
  rintro _ ⟨s, hs, rfl⟩
  exact mem_multiplierIdeal_of_lintegral_lt_top hμ s hφ.1 hk1 hs e hxe

/-- `e^{-j · (ψ/j)} = e^{-ψ}`. -/
theorem multiplierWeight_natCast_mul_inv {j : ℕ} (hj : 0 < j) (a : EReal) :
    multiplierWeight (j : ℝ) (((1 / (j : ℝ) : ℝ) : EReal) * a) = multiplierWeight 1 a := by
  have hj' : (j : ℝ) ≠ 0 := by exact_mod_cast hj.ne'
  unfold multiplierWeight
  rw [← mul_assoc, ← EReal.coe_mul, mul_one_div_cancel hj', EReal.coe_one]

/-- **Siu's generation for a fixed weight** (blueprint `claude-gagamult:siu-fixed-weight`).  Let
`L` be a Hermitian holomorphic line bundle whose first Chern form is the Kähler form `ω` (e.g.
`𝒪(1)` with the Fubini–Study metric) and `ψ ∈ PSH(X, η)` for some closed real `(1,1)`-form `η`.
There is `j₀` such that for every `j ≥ j₀`, every point `x` and every atlas frame `e` of `L^j` at `x`,
a germ lies in `𝓘(ψ)_x` if and only if it is a holomorphic combination of `e`-coefficients of global
holomorphic sections `s` of `L^j` with `∫_X |s|² e^{-ψ} dμ < ∞`. -/
theorem siuGlobalGeneration_fixedWeight [CompactSpace X] (ωb : KahlerBackground n X)
    {μ : Measure X} (hμ : IsSmoothPositiveVolume (n := n) μ)
    {L : HermitianHolomorphicLineBundle.{0, 0} n X} (hL : IsSourceSmoothHermitianMetric L)
    (hθ : IsOwnFirstChernForm L ωb.form) {η : ClosedRealOneOneForm n X} {ψ : X → EReal}
    (hψ : IsThetaPshPotential η.val ψ) :
    ∃ j₀ : ℕ, ∀ j : ℕ, j₀ ≤ j →
    ∀ (x : X) (e : AtlasFrame (twistedPower L unit j)), x ∈ e.val.baseSet → ∀ g : X → ℂ,
      ((multiplierIdeal (n := n) 1 ψ).mem x g ↔
        IsInSpanAt (n := n) (fun h => ∃ s : twistedSections L unit j,
          ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight 1 (ψ y) ∂μ < ⊤ ∧
          h = fun y => e.val.continuousLinearMapAt ℂ y (s y)) x g) := by
  obtain ⟨k₀, hk₀⟩ := siuGlobalGeneration_iff (n := n) ωb hμ hL
    isSourceSmoothHermitianMetric_unit hθ (δ := 1 / 2) (by norm_num)
  obtain ⟨A, hA, hdom⟩ := KahlerDomination.exists_isSemipositive_add_smul (-η).val ωb.form.val
    ωb.isKahler.1
  refine ⟨max (max k₀ 1) (⌈2 * A⌉₊), fun j hj x e hxe g => ?_⟩
  have hj1 : 1 ≤ j := le_of_max_le_right (le_of_max_le_left hj)
  have hj0 : 0 < j := hj1
  have hjR : (0 : ℝ) < j := by exact_mod_cast hj0
  have hjA : 2 * A ≤ j := (Nat.le_ceil _).trans (by exact_mod_cast le_of_max_le_right hj)
  set φ : X → EReal := fun y => ((1 / (j : ℝ) : ℝ) : EReal) * ψ y with hφdef
  -- `φ = ψ / j ∈ PSH(X, ω - ω/2)`
  have hφ : IsThetaPshPotential (ωb.form - (1 / 2 : ℝ) • ωb.form).val φ := by
    have h1 : ThetaPlurisubharmonic ((1 / (j : ℝ)) • η).val φ :=
      Pending.GlobalMultilinearExpansion.thetaPlurisubharmonic_smul (by positivity) hψ.1
    have h2 : IsThetaPshPotential ((1 / (j : ℝ)) • η).val φ := by
      refine ⟨h1, fun y U hU hyU => ?_⟩
      obtain ⟨z, hz, hne⟩ := hψ.2 y U hU hyU
      refine ⟨z, hz, ?_⟩
      show ((1 / (j : ℝ) : ℝ) : EReal) * ψ z ≠ ⊥
      induction h : ψ z using EReal.rec with
      | bot => exact absurd h hne
      | coe t => rw [← EReal.coe_mul]; exact EReal.coe_ne_bot _
      | top => rw [EReal.coe_mul_top_of_pos (by positivity)]; exact top_ne_bot
    have hs1 : ((1 / (j : ℝ)) • (-η + A • ωb.form)).val.IsSemipositive := by
      refine KahlerDomination.isSemipositive_smul ?_ (by positivity)
      intro e' z hz v
      have := hdom e' z hz v
      simpa [ClosedRealOneOneForm.coeff_add, ClosedRealOneOneForm.coeff_smul,
        ClosedRealOneOneForm.coeff_neg] using this
    have hs2 : ((1 / 2 - A / (j : ℝ)) • ωb.form).val.IsSemipositive := by
      refine KahlerDomination.isSemipositive_smul ?_ ?_
      · exact ωb.isSemipositive
      · rw [sub_nonneg, div_le_iff₀ hjR]; linarith
    have h3 := Pending.LocalPotentials.isThetaPshPotential_add_of_semipositive h2
      (UniformPerturbedKahlerLowerBound.isSemipositive_add hs1 hs2)
    have hform : (1 / (j : ℝ)) • η + ((1 / (j : ℝ)) • (-η + A • ωb.form) +
        (1 / 2 - A / (j : ℝ)) • ωb.form) = ωb.form - (1 / 2 : ℝ) • ωb.form := by
      have hjne : (j : ℝ) ≠ 0 := hjR.ne'
      rw [smul_add, smul_neg, smul_smul]
      have : (1 / (j : ℝ)) * A = A / (j : ℝ) := by ring
      rw [this]
      module
    rwa [hform] at h3
  have hdens : ∀ (e' : ComplexChart n X) (f : ComplexModel n → ℂ),
      multiplierDensity (chartFunction φ e') ((j : ℕ) : ℝ) f =
        multiplierDensity (chartFunction ψ e') 1 f := by
    intro e' f; funext z
    simp only [multiplierDensity, chartFunction, hφdef, multiplierWeight_natCast_mul_inv hj0]
  have hmI : multiplierIdeal (n := n) ((j : ℕ) : ℝ) φ = multiplierIdeal (n := n) 1 ψ := by
    ext y f
    simp only [multiplierIdeal, MultiplierIntegrableAt, WeightedL2On, hdens, hjR, zero_lt_one,
      true_and]
  have hint : ∀ s : twistedSections L unit j,
      ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight ((j : ℕ) : ℝ) (φ y) ∂μ =
        ∫⁻ y, ENNReal.ofReal (‖s y‖ ^ 2) * multiplierWeight 1 (ψ y) ∂μ := fun s => by
    simp only [hφdef, multiplierWeight_natCast_mul_inv hj0]
  have key := hk₀ j (le_of_max_le_left (le_of_max_le_left hj)) φ hφ x e hxe g
  rw [hmI] at key
  simp only [hint] at key
  exact key

end SGPT.NAPotential.GAGAMult
