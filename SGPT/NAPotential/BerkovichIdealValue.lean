import SGPT.NAPotential.BerkovichCenter
import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
import Mathlib.AlgebraicGeometry.Noetherian
import Mathlib.Data.ENNReal.Basic

/-! # Values of semi-valuations on coherent ideal sheaves

Source: `chapter_NApotential.tex`, equation `eq:va` (Section *Valuations* of the recap of
Boucksom–Jonsson's theory): for a coherent ideal `𝔞` on the projective variety `X` and
`v ∈ X^An`,

`v(𝔞) := min {v(f) : f ∈ 𝔞_{c(v)}} ∈ [0, ∞]`,

where `c(v)` is the centre of `v` (`SGPT.NAPotential.Berkovich.BerkovichPoint.center`).

## Formal setting

`X` is a scheme proper over `ℂ` (structure morphism `f`, `[IsProper f]`); an ideal sheaf is a
Mathlib `X.IdealSheafData` (a quasi-coherent ideal sheaf; on a locally Noetherian `X` these are
the coherent ideal sheaves).  Its stalk `𝔞_c ⊆ 𝒪_{X,c}` (`stalkIdeal`) is the ideal generated
by the germs at `c` of the sections of `𝔞` over the affine open neighbourhoods of `c`.

## Main results

* `BerkovichPoint.idealVal v 𝔞 = v(𝔞) ∈ [0, ∞]`, defined as the infimum of the values `v(g)`,
  `g ∈ 𝔞_{c(v)}` (all `≥ 0`, `centerVal_nonneg`).
* `BerkovichPoint.exists_idealVal_eq` (`X` locally Noetherian): the infimum is attained, i.e.
  it is the minimum of `eq:va`.
* `BerkovichPoint.idealVal_eq_iInf_of_span`: it can be computed on generators of `𝔞_{c(v)}`.
* `idealVal_top`: `v(𝒪_X) = 0`; `idealVal_antitone`; `idealVal_eq_zero_iff`: `v(𝔞) = 0` iff
  `𝔞_{c(v)} = 𝒪_{X,c(v)}`, i.e. `c(v)` is not in the zero locus of `𝔞`;
  `idealVal_mul`: `v(𝔞 𝔟) = v(𝔞) + v(𝔟)`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.Berkovich

open AlgebraicGeometry CategoryTheory Topology IsLocalRing
open scoped ENNReal

variable {X : Scheme.{0}}

/-- The stalk `𝔞_c ⊆ 𝒪_{X,c}` of an ideal sheaf: the ideal generated by the germs at `c` of the
sections of `𝔞` over affine open neighbourhoods of `c`. -/
def stalkIdeal (𝔞 : X.IdealSheafData) (c : X) : Ideal (X.presheaf.stalk c) :=
  ⨆ (U : X.affineOpens) (h : c ∈ (U : X.Opens)), Ideal.map (X.presheaf.germ U c h).hom (𝔞.ideal U)

theorem germ_mem_stalkIdeal (𝔞 : X.IdealSheafData) {c : X} (U : X.affineOpens)
    (h : c ∈ (U : X.Opens)) {s : Γ(X, U)} (hs : s ∈ 𝔞.ideal U) :
    (X.presheaf.germ U c h).hom s ∈ stalkIdeal 𝔞 c := by
  apply Ideal.mem_iSup_of_mem U
  apply Ideal.mem_iSup_of_mem h
  exact Ideal.mem_map_of_mem _ hs

theorem stalkIdeal_mono {𝔞 𝔟 : X.IdealSheafData} (h : 𝔞 ≤ 𝔟) (c : X) :
    stalkIdeal 𝔞 c ≤ stalkIdeal 𝔟 c := by
  apply iSup₂_mono
  intro U hU
  exact Ideal.map_mono (h U)

theorem exists_affineOpen_mem (c : X) : ∃ U : X.affineOpens, c ∈ (U : X.Opens) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hcU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ c) isOpen_univ
  exact ⟨⟨U, hU⟩, hcU⟩

@[simp] theorem stalkIdeal_top (c : X) : stalkIdeal (⊤ : X.IdealSheafData) c = ⊤ := by
  obtain ⟨U, hU⟩ := exists_affineOpen_mem c
  rw [eq_top_iff]
  calc ⊤ = Ideal.map (X.presheaf.germ U c hU).hom ((⊤ : X.IdealSheafData).ideal U) := by
        rw [Scheme.IdealSheafData.ideal_top]
        exact (Ideal.map_top _).symm
    _ ≤ stalkIdeal ⊤ c := le_iSup₂_of_le U hU le_rfl

/-- Germs of sections over a larger affine open map into the stalk ideal through a smaller
affine neighbourhood. -/
theorem map_le_map_of_le (𝔞 : X.IdealSheafData) {c : X} {U W : X.affineOpens} (hWU : W ≤ U)
    (hc : c ∈ (W : X.Opens)) :
    Ideal.map (X.presheaf.germ U c (hWU hc)).hom (𝔞.ideal U) ≤
      Ideal.map (X.presheaf.germ W c hc).hom (𝔞.ideal W) := by
  rw [Ideal.map_le_iff_le_comap]
  intro s hs
  rw [Ideal.mem_comap]
  have hres := 𝔞.ideal_le_comap_ideal hWU hs
  rw [Ideal.mem_comap] at hres
  have := Ideal.mem_map_of_mem (X.presheaf.germ W c hc).hom hres
  have e : (X.presheaf.germ W c hc).hom ((X.presheaf.map (homOfLE hWU).op).hom s) =
      (X.presheaf.germ U c (hWU hc)).hom s :=
    congrArg (fun φ => φ.hom s) (X.presheaf.germ_res (homOfLE hWU) c hc)
  rwa [e] at this

/-- The stalk of a product of ideal sheaves is the product of the stalks. -/
theorem stalkIdeal_mul (𝔞 𝔟 : X.IdealSheafData) (c : X) :
    stalkIdeal (𝔞 * 𝔟) c = stalkIdeal 𝔞 c * stalkIdeal 𝔟 c := by
  apply le_antisymm
  · apply iSup₂_le
    intro U hU
    rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, Ideal.map_mul]
    apply Ideal.mul_mono
    · exact le_iSup₂_of_le U hU le_rfl
    · exact le_iSup₂_of_le U hU le_rfl
  · rw [stalkIdeal, Ideal.iSup_mul]
    apply iSup_le
    intro U
    rw [Ideal.iSup_mul]
    apply iSup_le
    intro hU
    rw [stalkIdeal, Ideal.mul_iSup]
    apply iSup_le
    intro V
    rw [Ideal.mul_iSup]
    apply iSup_le
    intro hV
    obtain ⟨_, ⟨W, hW, rfl⟩, hcW, hWUV⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_inter hU hV) ((U : X.Opens).isOpen.inter (V : X.Opens).isOpen)
    let W' : X.affineOpens := ⟨W, hW⟩
    have hWU : W' ≤ U := fun x hx => (hWUV hx).1
    have hWV : W' ≤ V := fun x hx => (hWUV hx).2
    calc Ideal.map (X.presheaf.germ U c hU).hom (𝔞.ideal U) *
          Ideal.map (X.presheaf.germ V c hV).hom (𝔟.ideal V)
        ≤ Ideal.map (X.presheaf.germ W' c hcW).hom (𝔞.ideal W') *
          Ideal.map (X.presheaf.germ W' c hcW).hom (𝔟.ideal W') :=
          Ideal.mul_mono (map_le_map_of_le 𝔞 hWU hcW) (map_le_map_of_le 𝔟 hWV hcW)
      _ = Ideal.map (X.presheaf.germ W' c hcW).hom ((𝔞 * 𝔟).ideal W') := by
          rw [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply, Ideal.map_mul]
      _ ≤ stalkIdeal (𝔞 * 𝔟) c := le_iSup₂_of_le W' hcW le_rfl

/-- `a ↦ a` from `[0, ∞] ⊆ (-∞, ∞]` to `ℝ≥0∞` (negative reals are sent to `0`). -/
def toENNReal : WithTop ℝ → ℝ≥0∞
  | ⊤ => ⊤
  | (r : ℝ) => ENNReal.ofReal r

@[simp] theorem toENNReal_top : toENNReal ⊤ = ⊤ := rfl

@[simp] theorem toENNReal_coe (r : ℝ) : toENNReal (r : WithTop ℝ) = ENNReal.ofReal r := rfl

@[simp] theorem toENNReal_zero : toENNReal 0 = 0 := by
  change toENNReal ((0 : ℝ) : WithTop ℝ) = 0
  rw [toENNReal_coe, ENNReal.ofReal_zero]

theorem toENNReal_mono : Monotone toENNReal := by
  intro a b hab
  cases b with
  | top => exact le_top
  | coe s =>
    cases a with
    | top => exact absurd hab (by simp)
    | coe r => exact ENNReal.ofReal_le_ofReal (by exact_mod_cast hab)

theorem toENNReal_add {a b : WithTop ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    toENNReal (a + b) = toENNReal a + toENNReal b := by
  cases a with
  | top => simp
  | coe r =>
    cases b with
    | top => simp
    | coe s =>
      rw [← WithTop.coe_add, toENNReal_coe, toENNReal_coe, toENNReal_coe,
        ENNReal.ofReal_add (by exact_mod_cast ha) (by exact_mod_cast hb)]

theorem toENNReal_eq_zero_iff {a : WithTop ℝ} (ha : 0 ≤ a) : toENNReal a = 0 ↔ a = 0 := by
  cases a with
  | top => simp
  | coe r =>
    rw [toENNReal_coe, ENNReal.ofReal_eq_zero]
    have : (0 : ℝ) ≤ r := by exact_mod_cast ha
    constructor
    · intro h
      exact_mod_cast le_antisymm h this
    · intro h
      exact le_of_eq (by exact_mod_cast h)

theorem toENNReal_eq_top_iff {a : WithTop ℝ} : toENNReal a = ⊤ ↔ a = ⊤ := by
  cases a with
  | top => simp
  | coe r => simp

namespace BerkovichPoint

variable {f : X ⟶ Spec (.of ℂ)} [IsProper f]

/-- The value `v(g)` of a germ `g ∈ 𝒪_{X,c(v)}` at the centre. -/
def centerVal (v : BerkovichPoint f) (g : X.presheaf.stalk v.center) : WithTop ℝ :=
  v.valAt ((specializationMap v.support_specializes_center).hom g)

theorem centerVal_nonneg (v : BerkovichPoint f) (g : X.presheaf.stalk v.center) :
    0 ≤ v.centerVal g :=
  v.isCenter_center.choose_spec.1 g

theorem centerVal_pos (v : BerkovichPoint f) {g : X.presheaf.stalk v.center}
    (hg : g ∈ maximalIdeal (X.presheaf.stalk v.center)) : 0 < v.centerVal g :=
  v.isCenter_center.choose_spec.2 g hg

theorem centerVal_mul (v : BerkovichPoint f) (g h : X.presheaf.stalk v.center) :
    v.centerVal (g * h) = v.centerVal g + v.centerVal h := by
  unfold centerVal
  rw [map_mul, valAt_mul]

theorem min_le_centerVal_add (v : BerkovichPoint f) (g h : X.presheaf.stalk v.center) :
    min (v.centerVal g) (v.centerVal h) ≤ v.centerVal (g + h) := by
  unfold centerVal
  rw [map_add]
  exact v.min_le_valAt_add _ _

@[simp] theorem centerVal_zero (v : BerkovichPoint f) : v.centerVal 0 = ⊤ := by
  unfold centerVal
  rw [map_zero, valAt_zero]

@[simp] theorem centerVal_one (v : BerkovichPoint f) : v.centerVal 1 = 0 := by
  unfold centerVal
  rw [map_one, valAt_one]

/-- Units of `𝒪_{X,c(v)}` have value `0`, non-units positive value. -/
theorem centerVal_eq_zero_iff (v : BerkovichPoint f) (g : X.presheaf.stalk v.center) :
    v.centerVal g = 0 ↔ IsUnit g := by
  constructor
  · intro h
    by_contra hg
    have := v.centerVal_pos ((mem_maximalIdeal g).mpr hg)
    rw [h] at this
    exact lt_irrefl _ this
  · rintro ⟨u, rfl⟩
    have h1 : v.centerVal (u : X.presheaf.stalk v.center) + v.centerVal (u⁻¹ : (X.presheaf.stalk v.center)ˣ) = 0 := by
      rw [← centerVal_mul, Units.mul_inv, centerVal_one]
    exact ((add_eq_zero_iff_of_nonneg (v.centerVal_nonneg _) (v.centerVal_nonneg _)).mp h1).1

/-- The value `v(g) ∈ [0, ∞]` of a germ at the centre. -/
def centerValENN (v : BerkovichPoint f) (g : X.presheaf.stalk v.center) : ℝ≥0∞ :=
  toENNReal (v.centerVal g)

theorem centerValENN_mul (v : BerkovichPoint f) (g h : X.presheaf.stalk v.center) :
    v.centerValENN (g * h) = v.centerValENN g + v.centerValENN h := by
  unfold centerValENN
  rw [centerVal_mul, toENNReal_add (v.centerVal_nonneg g) (v.centerVal_nonneg h)]

theorem min_le_centerValENN_add (v : BerkovichPoint f) (g h : X.presheaf.stalk v.center) :
    min (v.centerValENN g) (v.centerValENN h) ≤ v.centerValENN (g + h) := by
  unfold centerValENN
  rw [← toENNReal_mono.map_min]
  exact toENNReal_mono (v.min_le_centerVal_add g h)

/-- Source `eq:va`: `v(𝔞) = min {v(g) : g ∈ 𝔞_{c(v)}} ∈ [0, ∞]` (defined as the infimum; it is
attained, `exists_idealVal_eq`). -/
def idealVal (v : BerkovichPoint f) (𝔞 : X.IdealSheafData) : ℝ≥0∞ :=
  ⨅ g ∈ stalkIdeal 𝔞 v.center, v.centerValENN g

theorem idealVal_le (v : BerkovichPoint f) (𝔞 : X.IdealSheafData) {g : X.presheaf.stalk v.center}
    (hg : g ∈ stalkIdeal 𝔞 v.center) : v.idealVal 𝔞 ≤ v.centerValENN g :=
  iInf₂_le g hg

/-- The infimum of the values over an ideal of `𝒪_{X,c(v)}` is the infimum over generators. -/
theorem iInf_span_eq (v : BerkovichPoint f) (S : Set (X.presheaf.stalk v.center)) :
    ⨅ g ∈ Ideal.span S, v.centerValENN g = ⨅ g ∈ S, v.centerValENN g := by
  apply le_antisymm
  · exact le_iInf₂ fun g hg => iInf₂_le g (Ideal.subset_span hg)
  · apply le_iInf₂
    intro g hg
    induction hg using Submodule.span_induction with
    | mem x hx => exact iInf₂_le x hx
    | zero => simp [centerValENN]
    | add x y _ _ hx hy =>
      exact le_trans (le_min hx hy) (v.min_le_centerValENN_add x y)
    | smul a x _ hx =>
      rw [smul_eq_mul, centerValENN_mul]
      exact le_trans hx le_add_self

/-- `v(𝔞)` computed on generators of the stalk `𝔞_{c(v)}`. -/
theorem idealVal_eq_iInf_of_span (v : BerkovichPoint f) (𝔞 : X.IdealSheafData)
    {S : Set (X.presheaf.stalk v.center)} (hS : Ideal.span S = stalkIdeal 𝔞 v.center) :
    v.idealVal 𝔞 = ⨅ g ∈ S, v.centerValENN g := by
  rw [idealVal, ← hS, iInf_span_eq]

/-- The infimum over an ideal of the Noetherian ring `𝒪_{X,c(v)}` is attained. -/
theorem exists_iInf_eq [IsLocallyNoetherian X] (v : BerkovichPoint f)
    (I : Ideal (X.presheaf.stalk v.center)) :
    ∃ g ∈ I, ⨅ h ∈ I, v.centerValENN h = v.centerValENN g := by
  obtain ⟨S, hSfin, hS⟩ := Submodule.fg_def.mp (IsNoetherian.noetherian I)
  have hS' : Ideal.span S = I := hS
  rcases S.eq_empty_or_nonempty with hSe | hSne
  · refine ⟨0, I.zero_mem, ?_⟩
    rw [← hS', hSe, iInf_span_eq]
    simp [centerValENN]
  · obtain ⟨g, hgS, hmin⟩ := Set.exists_min_image S v.centerValENN hSfin hSne
    refine ⟨g, hS' ▸ Ideal.subset_span hgS, ?_⟩
    rw [← hS', iInf_span_eq]
    exact le_antisymm (iInf₂_le g hgS) (le_iInf₂ fun h hh => hmin h hh)

/-- Source `eq:va`: on a locally Noetherian `X` the infimum defining `v(𝔞)` is a minimum. -/
theorem exists_idealVal_eq [IsLocallyNoetherian X] (v : BerkovichPoint f)
    (𝔞 : X.IdealSheafData) : ∃ g ∈ stalkIdeal 𝔞 v.center, v.idealVal 𝔞 = v.centerValENN g :=
  v.exists_iInf_eq _

/-- `v(𝒪_X) = 0`. -/
@[simp] theorem idealVal_top (v : BerkovichPoint f) : v.idealVal ⊤ = 0 := by
  apply le_antisymm _ zero_le
  have h1 : (1 : X.presheaf.stalk v.center) ∈ stalkIdeal ⊤ v.center := by
    rw [stalkIdeal_top]
    trivial
  calc v.idealVal ⊤ ≤ v.centerValENN 1 := v.idealVal_le ⊤ h1
    _ = 0 := by simp [centerValENN]

theorem idealVal_antitone (v : BerkovichPoint f) {𝔞 𝔟 : X.IdealSheafData} (h : 𝔞 ≤ 𝔟) :
    v.idealVal 𝔟 ≤ v.idealVal 𝔞 :=
  iInf₂_mono' fun g hg => ⟨g, stalkIdeal_mono h _ hg, le_rfl⟩

/-- `v(𝔞) = 0` iff `𝔞_{c(v)} = 𝒪_{X,c(v)}`, i.e. the centre is not in the zero locus of `𝔞`. -/
theorem idealVal_eq_zero_iff [IsLocallyNoetherian X] (v : BerkovichPoint f)
    (𝔞 : X.IdealSheafData) : v.idealVal 𝔞 = 0 ↔ stalkIdeal 𝔞 v.center = ⊤ := by
  constructor
  · intro h
    obtain ⟨g, hg, hval⟩ := v.exists_idealVal_eq 𝔞
    rw [h] at hval
    have h0 : v.centerVal g = 0 :=
      (toENNReal_eq_zero_iff (v.centerVal_nonneg g)).mp hval.symm
    exact Ideal.eq_top_of_isUnit_mem _ hg ((v.centerVal_eq_zero_iff g).mp h0)
  · intro h
    apply le_antisymm _ zero_le
    have h1 : (1 : X.presheaf.stalk v.center) ∈ stalkIdeal 𝔞 v.center := by
      rw [h]
      trivial
    calc v.idealVal 𝔞 ≤ v.centerValENN 1 := v.idealVal_le 𝔞 h1
      _ = 0 := by simp [centerValENN]

/-- `v(𝔞 𝔟) = v(𝔞) + v(𝔟)`. -/
theorem idealVal_mul [IsLocallyNoetherian X] (v : BerkovichPoint f) (𝔞 𝔟 : X.IdealSheafData) :
    v.idealVal (𝔞 * 𝔟) = v.idealVal 𝔞 + v.idealVal 𝔟 := by
  obtain ⟨a, ha, hav⟩ := v.exists_idealVal_eq 𝔞
  obtain ⟨b, hb, hbv⟩ := v.exists_idealVal_eq 𝔟
  apply le_antisymm
  · have hab : a * b ∈ stalkIdeal (𝔞 * 𝔟) v.center := by
      rw [stalkIdeal_mul]
      exact Ideal.mul_mem_mul ha hb
    calc v.idealVal (𝔞 * 𝔟) ≤ v.centerValENN (a * b) := v.idealVal_le _ hab
      _ = v.idealVal 𝔞 + v.idealVal 𝔟 := by rw [centerValENN_mul, hav, hbv]
  · apply le_iInf₂
    intro x hx
    rw [stalkIdeal_mul] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro g hg h hh
      rw [centerValENN_mul]
      exact add_le_add (v.idealVal_le 𝔞 hg) (v.idealVal_le 𝔟 hh)
    · intro x y hx hy
      exact le_trans (le_min hx hy) (v.min_le_centerValENN_add x y)

end BerkovichPoint

end SGPT.NAPotential.Berkovich

end
