import SGPT.NAPotential.Valuation
import Mathlib.AlgebraicGeometry.ResidueField
import Mathlib.AlgebraicGeometry.Properties
import Mathlib.Topology.Sober
import Mathlib.Analysis.SpecialFunctions.Exp

/-! # The trivially valued Berkovich analytification `X^An`

Source: `chapter_NApotential.tex`, Section *A brief recap of Boucksom–Jonsson's theory*,
paragraph after `def:NApotential:L878`.  Let `X` be a variety over `ℂ`.  As a set, `X^An` is the
set of *semi-valuations* on `X`: real-valued valuations (`def:NApotential:L878`) `v` of the
function field `ℂ(Y)` of an irreducible reduced subvariety `Y ⊆ X`, trivial on `ℂ`; `Y` is the
*support* of `v`, and `X^An = ∐_Y Y^val`.  The topology is the coarsest one such that

1. for every Zariski open `U ⊆ X`, the set `U^An` of semi-valuations whose support meets `U` is
   open;
2. for every Zariski open `U` and every `f ∈ H⁰(U, 𝒪_X)`, the map `|f| : U^An → ℝ`,
   `v ↦ exp (-v(f))`, is continuous.

## Formal setting

`X` is a scheme with structure morphism `f : X ⟶ Spec ℂ`.  An irreducible reduced closed
subvariety `Y` is recorded by its generic point `y` (schemes are sober, so
`Y ↦ y` is a bijection between irreducible closed subsets and points,
`berkovichPointEquivSigma` below), and the function field `ℂ(Y)` of the reduced induced
structure is the residue field `κ(y)`, a `ℂ`-algebra through `f` (`residueComplexAlgebra`).
This is the usual description of the points of the Berkovich analytification as pairs
`(y, |·|)` of a scheme point and an absolute value on `κ(y)` trivial on `ℂ`.
For `f ∈ H⁰(U, 𝒪_X)` and `v` with support `y ∈ U`, `v(f)` is the value of `v` on the image of
`f` in `κ(y)` (`X.evaluation U y`).

## Main definitions and results

* `SGPT.NAPotential.Berkovich.BerkovichPoint f`: the set `X^An`.
* `BerkovichPoint.supportOpen U`: `U^An`; `mem_supportOpen_iff_meets`: the support
  `closure {y}` meets `U` iff `y ∈ U`.
* `BerkovichPoint.sectionAbs U s`: `|s| : U^An → ℝ`.
* `BerkovichPoint.IsAdmissibleTopology t`: conditions 1 and 2 for a topology `t`.
* `instTopologicalSpace`: the topology of `X^An`, generated by the sets of conditions 1–2;
  `isAdmissibleTopology_iff`: a topology satisfies 1 and 2 iff it is finer than this one, so
  this is the coarsest such topology (the book's definition).
* `BerkovichPoint.trivial`: the trivial valuation `v_triv` of `ℂ(X)` for irreducible `X`.
* `berkovichPointEquivSigma`: `X^An ≃ ∐_Y Y^val`, `Y` running over irreducible closed subsets.
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.NAPotential.Berkovich

open AlgebraicGeometry CategoryTheory Topology TopologicalSpace

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))

/-- The ring map `ℂ → κ(y)` induced by the structure morphism `f : X ⟶ Spec ℂ`: the ring map
corresponding to the composite `Spec κ(y) → X → Spec ℂ`. -/
def residueComplexHom (y : X) : CommRingCat.of ℂ ⟶ X.residueField y :=
  Spec.preimage (X.fromSpecResidueField y ≫ f)

theorem spec_map_residueComplexHom (y : X) :
    Spec.map (residueComplexHom f y) = X.fromSpecResidueField y ≫ f :=
  Spec.map_preimage _

/-- The `ℂ`-algebra structure of the residue field `κ(y)` induced by the structure morphism
`f : X ⟶ Spec ℂ`. -/
abbrev residueComplexAlgebra (y : X) : Algebra ℂ (X.residueField y) :=
  (residueComplexHom f y).hom.toAlgebra

/-- The valuations (`def:NApotential:L878`) of `κ(y)`, i.e. of the function field of the
subvariety `closure {y}`, trivial on `ℂ`. -/
abbrev ResidueValuation (y : X) : Type :=
  @SourceRealValuation (X.residueField y) _ (residueComplexAlgebra f y)

/-- The trivially valued Berkovich analytification `X^An`: a semi-valuation is a point `y` of
`X` (the generic point of its support `closure {y}`) together with a real-valued valuation of
`κ(y) = ℂ(closure {y})` trivial on `ℂ`. -/
@[ext]
structure BerkovichPoint where
  /-- The generic point of the support. -/
  support : X
  /-- The valuation of the function field of the support. -/
  val : ResidueValuation f support

namespace BerkovichPoint

variable {f}

/-- The valuation of `v`, as a function on the function field `κ(y)` of its support. -/
def valAt (v : BerkovichPoint f) : X.residueField v.support → WithTop ℝ :=
  @SourceRealValuation.toFun _ _ (residueComplexAlgebra f v.support) v.val

theorem valAt_eq_top_iff (v : BerkovichPoint f) (g : X.residueField v.support) :
    v.valAt g = ⊤ ↔ g = 0 :=
  @SourceRealValuation.eq_top_iff' _ _ (residueComplexAlgebra f v.support) v.val g

theorem valAt_mul (v : BerkovichPoint f) (g h : X.residueField v.support) :
    v.valAt (g * h) = v.valAt g + v.valAt h :=
  @SourceRealValuation.map_mul' _ _ (residueComplexAlgebra f v.support) v.val g h

theorem min_le_valAt_add (v : BerkovichPoint f) (g h : X.residueField v.support) :
    min (v.valAt g) (v.valAt h) ≤ v.valAt (g + h) :=
  @SourceRealValuation.min_le_map_add' _ _ (residueComplexAlgebra f v.support) v.val g h

theorem valAt_zero (v : BerkovichPoint f) : v.valAt 0 = ⊤ :=
  (v.valAt_eq_top_iff 0).mpr rfl

theorem valAt_one (v : BerkovichPoint f) : v.valAt 1 = 0 :=
  @SourceRealValuation.map_one _ _ (residueComplexAlgebra f v.support) v.val

/-- The valuation of `v` as a Mathlib additive valuation of `κ(y)`. -/
def toAddValuation (v : BerkovichPoint f) : AddValuation (X.residueField v.support) (WithTop ℝ) :=
  @SourceRealValuation.toAddValuation _ _ (residueComplexAlgebra f v.support) v.val

@[simp] theorem toAddValuation_apply (v : BerkovichPoint f) (g : X.residueField v.support) :
    v.toAddValuation g = v.valAt g := rfl

/-- The value `v(s) ∈ (-∞, ∞]` of a regular function `s ∈ H⁰(U, 𝒪_X)` at a semi-valuation whose
support meets `U`. -/
def sectionVal (v : BerkovichPoint f) (U : X.Opens) (hv : v.support ∈ U) (s : Γ(X, U)) :
    WithTop ℝ :=
  v.valAt (X.evaluation U v.support hv s)

theorem sectionVal_mul (v : BerkovichPoint f) (U : X.Opens) (hv : v.support ∈ U)
    (s t : Γ(X, U)) : v.sectionVal U hv (s * t) = v.sectionVal U hv s + v.sectionVal U hv t := by
  unfold sectionVal
  rw [map_mul]
  exact v.valAt_mul _ _

theorem sectionVal_eq_top_iff (v : BerkovichPoint f) (U : X.Opens) (hv : v.support ∈ U)
    (s : Γ(X, U)) : v.sectionVal U hv s = ⊤ ↔ v.support ∉ X.basicOpen s := by
  unfold sectionVal
  rw [v.valAt_eq_top_iff, Scheme.evaluation_eq_zero_iff_notMem_basicOpen]

/-- Restricting a section does not change its value. -/
theorem sectionVal_restrict (v : BerkovichPoint f) {U V : X.Opens} (i : V ≤ U)
    (hv : v.support ∈ V) (s : Γ(X, U)) :
    v.sectionVal V hv (X.presheaf.map (homOfLE i).op s) = v.sectionVal U (i hv) s := by
  unfold sectionVal
  exact congrArg (fun a => v.valAt (X.residue v.support a))
    (X.presheaf.germ_res_apply (homOfLE i) v.support hv s)

/-- `U^An`: the semi-valuations whose support is in `U` (equivalently meets `U`,
`mem_supportOpen_iff_meets`). -/
def supportOpen (U : X.Opens) : Set (BerkovichPoint f) :=
  {v | v.support ∈ U}

/-- The support `closure {y}` of `v` meets the open set `U` iff its generic point `y` lies in
`U`; so `supportOpen U` is the book's `U^An`. -/
theorem mem_supportOpen_iff_meets (v : BerkovichPoint f) (U : X.Opens) :
    v ∈ supportOpen U ↔ (closure ({v.support} : Set X) ∩ (U : Set X)).Nonempty := by
  constructor
  · intro hv
    exact ⟨v.support, subset_closure rfl, hv⟩
  · rintro ⟨x, hx, hxU⟩
    have hsp : v.support ⤳ x := specializes_iff_mem_closure.mpr hx
    exact hsp.mem_open U.isOpen hxU

/-- `exp (-a)` for `a ∈ (-∞, ∞]`, with `exp (-∞) = 0`. -/
def expNeg : WithTop ℝ → ℝ
  | ⊤ => 0
  | (r : ℝ) => Real.exp (-r)

@[simp] theorem expNeg_top : expNeg ⊤ = 0 := rfl

@[simp] theorem expNeg_coe (r : ℝ) : expNeg (r : WithTop ℝ) = Real.exp (-r) := rfl

theorem expNeg_nonneg (a : WithTop ℝ) : 0 ≤ expNeg a := by
  cases a with
  | top => simp
  | coe r => exact (Real.exp_pos _).le

/-- The function `|s| : U^An → ℝ`, `v ↦ exp (-v(s))`, of a regular function `s ∈ H⁰(U, 𝒪_X)`. -/
def sectionAbs (U : X.Opens) (s : Γ(X, U)) : supportOpen (f := f) U → ℝ :=
  fun v => expNeg (v.1.sectionVal U v.2 s)

/-- The preimage under `|s|` of a set `W ⊆ ℝ`, as a subset of `X^An`. -/
def sectionPreimage (U : X.Opens) (s : Γ(X, U)) (W : Set ℝ) : Set (BerkovichPoint f) :=
  {v | ∃ hv : v.support ∈ U, expNeg (v.sectionVal U hv s) ∈ W}

theorem sectionPreimage_eq_image (U : X.Opens) (s : Γ(X, U)) (W : Set ℝ) :
    sectionPreimage (f := f) U s W = Subtype.val '' (sectionAbs U s ⁻¹' W) := by
  ext v
  constructor
  · rintro ⟨hv, hW⟩
    exact ⟨⟨v, hv⟩, hW, rfl⟩
  · rintro ⟨w, hw, rfl⟩
    exact ⟨w.2, hw⟩

theorem sectionAbs_preimage (U : X.Opens) (s : Γ(X, U)) (W : Set ℝ) :
    sectionAbs U s ⁻¹' W = Subtype.val ⁻¹' sectionPreimage (f := f) U s W := by
  ext v
  constructor
  · intro hv
    exact ⟨v.2, hv⟩
  · rintro ⟨_, hv⟩
    exact hv

variable (f) in
/-- The sets of conditions 1 and 2: the `U^An` and the sets `|s|⁻¹(W)` for `W ⊆ ℝ` open. -/
def topologyGenerators : Set (Set (BerkovichPoint f)) :=
  {S | (∃ U : X.Opens, S = supportOpen U) ∨
    ∃ (U : X.Opens) (s : Γ(X, U)) (W : Set ℝ), IsOpen W ∧ S = sectionPreimage U s W}

variable (f) in
/-- Conditions 1 and 2 of the source for a topology `t` on `X^An`: every `U^An` is open, and every
`|s| : U^An → ℝ` is continuous for the subspace topology of `U^An`. -/
def IsAdmissibleTopology (t : TopologicalSpace (BerkovichPoint f)) : Prop :=
  (∀ U : X.Opens, IsOpen[t] (supportOpen U)) ∧
    ∀ (U : X.Opens) (s : Γ(X, U)),
      Continuous[TopologicalSpace.induced Subtype.val t, inferInstance] (sectionAbs U s)

/-- The topology of `X^An`. -/
instance instTopologicalSpace : TopologicalSpace (BerkovichPoint f) :=
  TopologicalSpace.generateFrom (topologyGenerators f)

theorem isOpen_supportOpen (U : X.Opens) : IsOpen (supportOpen (f := f) U) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨U, rfl⟩)

theorem isOpen_sectionPreimage (U : X.Opens) (s : Γ(X, U)) {W : Set ℝ} (hW : IsOpen W) :
    IsOpen (sectionPreimage (f := f) U s W) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨U, s, W, hW, rfl⟩)

/-- Condition 2: `|s|` is continuous on `U^An`. -/
theorem continuous_sectionAbs (U : X.Opens) (s : Γ(X, U)) :
    Continuous (sectionAbs (f := f) U s) := by
  rw [continuous_def]
  intro W hW
  rw [sectionAbs_preimage]
  exact (isOpen_sectionPreimage U s hW).preimage continuous_subtype_val

/-- The topology of `X^An` satisfies conditions 1 and 2. -/
theorem isAdmissibleTopology_instTopologicalSpace :
    IsAdmissibleTopology f (instTopologicalSpace (f := f)) :=
  ⟨isOpen_supportOpen, continuous_sectionAbs⟩

/-- Source (definition of the topology of `X^An`): the topologies satisfying conditions 1 and 2
are exactly the topologies finer than `instTopologicalSpace`; hence `instTopologicalSpace` is the
coarsest topology satisfying 1 and 2. -/
theorem isAdmissibleTopology_iff (t : TopologicalSpace (BerkovichPoint f)) :
    IsAdmissibleTopology f t ↔ t ≤ instTopologicalSpace (f := f) := by
  constructor
  · rintro ⟨h1, h2⟩
    apply le_generateFrom_iff_subset_isOpen.mpr
    rintro S (⟨U, rfl⟩ | ⟨U, s, W, hW, rfl⟩)
    · exact h1 U
    · have hc := h2 U s
      rw [continuous_def] at hc
      obtain ⟨O, hO, hOeq⟩ := isOpen_induced_iff.mp (hc W hW)
      have hS : sectionPreimage (f := f) U s W = O ∩ supportOpen U := by
        ext v
        constructor
        · rintro ⟨hv, hvW⟩
          have : (⟨v, hv⟩ : supportOpen (f := f) U) ∈ Subtype.val ⁻¹' O := by
            rw [hOeq]
            exact hvW
          exact ⟨this, hv⟩
        · rintro ⟨hvO, hv⟩
          have : (⟨v, hv⟩ : supportOpen (f := f) U) ∈ sectionAbs U s ⁻¹' W := by
            rw [← hOeq]
            exact hvO
          exact ⟨hv, this⟩
      rw [hS]
      exact hO.inter (h1 U)
  · intro ht
    refine ⟨fun U => ht _ (isOpen_supportOpen U), fun U s => ?_⟩
    have hle : TopologicalSpace.induced (Subtype.val : supportOpen (f := f) U → _) t ≤
        TopologicalSpace.induced Subtype.val (instTopologicalSpace (f := f)) :=
      induced_mono ht
    exact continuous_le_dom hle (continuous_sectionAbs U s)

/-- Every topology satisfying conditions 1 and 2 is finer than the topology of `X^An`. -/
theorem le_of_isAdmissibleTopology {t : TopologicalSpace (BerkovichPoint f)}
    (ht : IsAdmissibleTopology f t) : t ≤ instTopologicalSpace (f := f) :=
  (isAdmissibleTopology_iff t).mp ht

/-- The support map `X^An → X` is continuous. -/
theorem continuous_support : Continuous (fun v : BerkovichPoint f => v.support) := by
  rw [continuous_def]
  intro U hU
  exact isOpen_supportOpen (f := f) ⟨U, hU⟩

section Trivial

variable [IrreducibleSpace X]

variable (f) in
/-- The trivial valuation `v_triv ∈ X^An` of `ℂ(X)`: supported at the generic point of `X`,
`v_triv(g) = 0` for every `g ≠ 0`. -/
def trivial : BerkovichPoint f :=
  letI := Classical.decEq (X.residueField (genericPoint X))
  ⟨genericPoint X, @SourceRealValuation.trivial _ _ (residueComplexAlgebra f _) _⟩

theorem trivial_support : (trivial f).support = genericPoint X := rfl

theorem trivial_valAt_of_ne_zero {g : X.residueField (genericPoint X)} (hg : g ≠ 0) :
    (trivial f).valAt g = 0 := by
  classical
  change (if g = 0 then ⊤ else 0 : WithTop ℝ) = 0
  convert if_neg hg

/-- The support of `v_triv` is all of `X`. -/
theorem closure_trivial_support : closure ({(trivial f).support} : Set X) = Set.univ :=
  (genericPoint_spec X).def

end Trivial

end BerkovichPoint

/-- Reindexing of `∐_y Val(κ(y))` by irreducible closed subsets (via their generic points). -/
def sigmaSubvarietyEquiv :
    (Σ Y : IrreducibleCloseds X, ResidueValuation f (irreducibleSetEquivPoints Y)) ≃
      Σ y : X, ResidueValuation f y :=
  Equiv.sigmaCongrLeft (β := fun y : X => ResidueValuation f y)
    (irreducibleSetEquivPoints (α := X)).toEquiv

/-- `X^An` is the disjoint union `∐_{y ∈ X} Val(κ(y))`. -/
def sigmaEquiv : BerkovichPoint f ≃ Σ y : X, ResidueValuation f y where
  toFun v := ⟨v.support, v.val⟩
  invFun p := ⟨p.1, p.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- `X^An = ∐_Y Y^val`: semi-valuations are the same as pairs of an irreducible closed subset
`Y ⊆ X` (a subvariety with its reduced structure) and a valuation of the function field
`κ(η_Y)` of `Y`, `η_Y` the generic point of `Y`. -/
def berkovichPointEquivSigma :
    BerkovichPoint f ≃ Σ Y : IrreducibleCloseds X, ResidueValuation f (irreducibleSetEquivPoints Y) :=
  (sigmaEquiv f).trans (sigmaSubvarietyEquiv f).symm

/-- Under `berkovichPointEquivSigma` the subvariety attached to `v` is the closure of its
support point. -/
theorem berkovichPointEquivSigma_fst (v : BerkovichPoint f) :
    ((berkovichPointEquivSigma f v).1 : Set X) = closure {v.support} := by
  change ((irreducibleSetEquivPoints (α := X)).toEquiv.symm v.support : Set X) = _
  exact coe_irreducibleEquivPoints_symm_apply v.support

end SGPT.NAPotential.Berkovich

end
