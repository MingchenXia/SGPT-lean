import SGPT.NAPotential.GAGAMult2Limit

/-!
# The analytification of the ideal sheaf generated by an algebraic section

Blueprint `claude-gagamult2:section-ideal`.  For an algebraic section `σ ∈ H⁰(X, L^{⊗ j})` of a
line bundle with rank-one atlas `a`, let `(σ) ⊆ 𝒪_X` be the algebraic ideal sheaf it generates
(the image of `σ : L^{-j} → 𝒪_X`, Bing–Wang's `sectionZeroIdealSheaf`).

* `analytificationIdeal_sectionZeroIdealSheaf_iff`: at a complex point `x` in the domain of the
  atlas frame `α = a.frame i`, the stalk of `(σ)^an` is generated by the analytic function of the
  coefficient of `σ` in `α^{⊗ j}`: `(σ)^an_x = 𝒪^an_x · (σ_α)^an`.
* `analytificationIdeal_sup_le`, `analytificationIdeal_le_sup`: the analytification of a finite
  supremum `⨆ᵢ 𝔞ᵢ` of algebraic ideal sheaves is the ideal generated by the `𝔞ᵢ^an`
  (so the ideal sheaf generated by finitely many sections `σ₁, …, σ_N` analytifies to the ideal
  generated by their analytic coefficients).
* `not_mem_multiplierIdeal_zero`: in the workspace convention `𝓘(0 · φ)` is the zero germ ideal
  (membership requires `c > 0`); hence the earlier hypothesis `AlgebraizedSubmultiplicative`,
  which quantifies over `k = 0`, cannot hold for a nondegenerate `φ` on a nonempty `X`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option linter.unusedSectionVars false

noncomputable section

namespace SGPT.NAPotential.GAGAMult

open Set Filter Bundle
open scoped Topology Manifold
open AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending
open SGPT.NAPotential.Berkovich

/-- `𝓘(0 · φ)` is the zero germ ideal in the workspace convention. -/
theorem not_mem_multiplierIdeal_zero {n : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] (φ : M → EReal) (x : M) (g : M → ℂ) :
    ¬ (multiplierIdeal (n := n) 0 φ).mem x g :=
  fun h => lt_irrefl (0 : ℝ) h.2.1

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ) [SmoothOfRelativeDimension n f]
  (E : ClosedProjectiveEmbedding f) {L : X.Modules} (a : LineBundleAtlas L)

local instance sectionIdealPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance sectionIdealPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

variable [IsSeparated f] [QuasiCompact f]

local instance sectionIdealPointManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

/-- **The analytification of the ideal sheaf generated by a section**: near a point of the
domain of the atlas frame `a.frame i`, `(σ)^an` is generated by the analytic coefficient of `σ`
in `(a.frame i)^{⊗ j}`. -/
theorem analytificationIdeal_sectionZeroIdealSheaf_iff (j : ℕ) (σ : bundlePowerGlobalSections L j)
    (i : a.I) {x : SchemeComplexPoint f} (hx : schemeComplexPointImage f x ∈ a.opens i)
    (g : SchemeComplexPoint f → ℂ) :
    (analytificationIdeal f n E (sectionZeroIdealSheaf (a.tensorPower j) σ)).mem x g ↔
      IsInSpanAt (n := n)
        (· = schemeOpenRegularFunction f n E (a.opens i) (algCoef (a.frame i) j σ)) x g := by
  set c := schemeOpenRegularFunction f n E (a.opens i) (algCoef (a.frame i) j σ) with hc
  have hcx : HolomorphicAt n c x :=
    schemeOpenRegularFunction_holomorphicAt f n E (a.opens i) _ x hx
  rw [analytificationIdeal_mem_iff]
  constructor
  · intro hg
    have hspan := mk_mem_spanGerms_of_isInSpanAt (n := n)
      (fun s hs => holomorphicAt_of_anGen f n E hs) hg
    refine isInSpanAt_of_mk_mem_spanGerms hg.1 ((Ideal.span_le.mpr ?_) hspan)
    rintro _ ⟨s, hs, ⟨U, hU, r, hr, rfl⟩, rfl⟩
    let W' : X.Opens := (U : X.Opens) ⊓ a.opens i
    have hxW' : schemeComplexPointImage f x ∈ W' := ⟨hU, hx⟩
    have hr' : X.presheaf.map (homOfLE (inf_le_left : W' ≤ U)).op r ∈
        sectionZeroIdeal (bundleTensorPower L j) σ W' := by
      obtain ⟨β, rfl⟩ := hr
      exact ⟨_, sectionZeroEvaluation_restrict _ σ (inf_le_left : W' ≤ U) β⟩
    rw [sectionZeroIdeal_eq_span_frame σ ((a.frame i).tensorPower j)
      (homOfLE (inf_le_right : W' ≤ a.opens i)),
      coefficients_restrict_top ((a.frame i).tensorPower j) inf_le_right σ] at hr'
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hr'
    have hbx : HolomorphicAt n (schemeOpenRegularFunction f n E W' b) x :=
      schemeOpenRegularFunction_holomorphicAt f n E W' b x hxW'
    have heq : NativeHolGerm.mk _ hs = NativeHolGerm.mk _ hbx * NativeHolGerm.mk c hcx := by
      have hprod : HolomorphicAt n (fun y => schemeOpenRegularFunction f n E W' b y * c y) x :=
        hbx.mul hcx
      refine (NativeHolGerm.mk_eq_mk_iff.mpr ?_).trans
        (show NativeHolGerm.mk _ hprod = _ from Subtype.ext rfl)
      have hO : IsOpen (schemeComplexPointImage f ⁻¹' (W' : Set X)) :=
        W'.isOpen.preimage (schemeComplexPointImage_continuous f)
      filter_upwards [hO.mem_nhds hxW'] with y hy
      rw [← schemeOpenRegularFunction_restrict f n E W' U inf_le_left r hy, ← hb,
        schemeOpenRegularFunction_mul f n E W' _ _ hy]
      beta_reduce
      rw [schemeOpenRegularFunction_restrict f n E W' (a.opens i) inf_le_right _ hy]
      rfl
    rw [heq]
    exact Ideal.mul_mem_left _ _ (mk_mem_spanGerms hcx rfl)
  · intro hg
    refine IsInSpanAt.of_eventuallyEq hg ?_
    rintro _ rfl
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVi⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx (a.opens i).isOpen
    let V' : X.affineOpens := ⟨V, hV⟩
    have hVi' : (V : X.Opens) ≤ a.opens i := hVi
    refine ⟨_, ⟨V', hxV, _, restrict_algCoef_mem_sectionZeroIdeal (a.frame i) hVi' j σ, rfl⟩, ?_⟩
    have hO : IsOpen (schemeComplexPointImage f ⁻¹' (V : Set X)) :=
      (V' : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f)
    filter_upwards [hO.mem_nhds hxV] with y hy
    rw [hc, schemeOpenRegularFunction_restrict f n E V (a.opens i) hVi' _ hy]

/-- The analytification of a finite supremum contains the analytification of each member. -/
theorem analytificationIdeal_le_sup {ι : Type} [Fintype ι] (𝔞 : ι → X.IdealSheafData) (i : ι) :
    (analytificationIdeal f n E (𝔞 i)).Le (analytificationIdeal f n E (⨆ i, 𝔞 i)) :=
  analytificationIdeal_mono f n E (le_iSup 𝔞 i)

/-- **The analytification of a finite supremum** is generated by the analytifications of the
members: a germ of `(⨆ᵢ 𝔞ᵢ)^an` is a holomorphic combination of germs of the `𝔞ᵢ^an`. -/
theorem analytificationIdeal_sup_le {ι : Type} [Fintype ι] (𝔞 : ι → X.IdealSheafData)
    (x : SchemeComplexPoint f) (g : SchemeComplexPoint f → ℂ)
    (hg : (analytificationIdeal f n E (⨆ i, 𝔞 i)).mem x g) :
    IsInSpanAt (n := n) (fun s => ∃ i, (analytificationIdeal f n E (𝔞 i)).mem x s) x g := by
  rw [analytificationIdeal_mem_iff] at hg
  have hspan := mk_mem_spanGerms_of_isInSpanAt (n := n)
    (fun s hs => holomorphicAt_of_anGen f n E hs) hg
  refine isInSpanAt_of_mk_mem_spanGerms hg.1 ((Ideal.span_le.mpr ?_) hspan)
  rintro _ ⟨s, hs, ⟨U, hU, r, hr, rfl⟩, rfl⟩
  rw [Scheme.IdealSheafData.ideal_iSup, iSup_apply] at hr
  -- `r` is a finite sum of sections of the `𝔞ᵢ`
  have hr' : r ∈ ⨆ i, (𝔞 i).ideal U := hr
  refine Submodule.iSup_induction (fun i => (𝔞 i).ideal U) (motive := fun r => ∀ hs : HolomorphicAt n
      (schemeOpenRegularFunction f n E U r) x, NativeHolGerm.mk _ hs ∈
        spanGerms (fun s => ∃ i, (analytificationIdeal f n E (𝔞 i)).mem x s) x) hr' ?_ ?_ ?_ hs
  · intro i t ht hts
    exact mk_mem_spanGerms hts ⟨i, hts, 1, fun _ => schemeOpenRegularFunction f n E U t,
      fun _ _ => 1, fun _ => ⟨U, hU, t, ht, rfl⟩, fun _ => holomorphicAt_const 1,
      Eventually.of_forall fun _ => by simp⟩
  · intro hs0
    have h0 : NativeHolGerm.mk (schemeOpenRegularFunction f n E U 0) hs0 = 0 := by
      have hz : HolomorphicAt n (fun _ : SchemeComplexPoint f => (0 : ℂ)) x := holomorphicAt_const 0
      refine (NativeHolGerm.mk_eq_mk_iff.mpr ?_).trans (show NativeHolGerm.mk _ hz = 0 from
        Subtype.ext rfl)
      have hO : IsOpen (schemeComplexPointImage f ⁻¹' ((U : X.Opens) : Set X)) :=
        (U : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f)
      filter_upwards [hO.mem_nhds hU] with y hy
      have := schemeOpenRegularFunction_add f n E U 0 0 hy
      simp only [add_zero] at this
      linear_combination -this
    rw [h0]; exact Ideal.zero_mem _
  · intro t₁ t₂ h₁ h₂ hs12
    have hs1 := schemeOpenRegularFunction_holomorphicAt f n E U t₁ x hU
    have hs2 := schemeOpenRegularFunction_holomorphicAt f n E U t₂ x hU
    have hadd : NativeHolGerm.mk (schemeOpenRegularFunction f n E U (t₁ + t₂)) hs12 =
        NativeHolGerm.mk _ hs1 + NativeHolGerm.mk _ hs2 := by
      have hsum : HolomorphicAt n (fun y => schemeOpenRegularFunction f n E U t₁ y +
          schemeOpenRegularFunction f n E U t₂ y) x := hs1.add hs2
      refine (NativeHolGerm.mk_eq_mk_iff.mpr ?_).trans
        (show NativeHolGerm.mk _ hsum = _ from Subtype.ext rfl)
      have hO : IsOpen (schemeComplexPointImage f ⁻¹' ((U : X.Opens) : Set X)) :=
        (U : X.Opens).isOpen.preimage (schemeComplexPointImage_continuous f)
      filter_upwards [hO.mem_nhds hU] with y hy
      exact schemeOpenRegularFunction_add f n E U t₁ t₂ hy
    rw [hadd]
    exact Ideal.add_mem _ (h₁ hs1) (h₂ hs2)

end SGPT.NAPotential.GAGAMult
