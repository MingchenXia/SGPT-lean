import SGPT.NAPotential.GAGAMultAlgebraic
import SGPT.Okounkov.SchemeAffineNativeFormal
import SGPT.Foundations.Schemes.NativeFanoAlgebraicFiniteness

/-!
# Algebraic ideal sheaves are recovered from their analytifications

Blueprint `claude-gagamult2:alg-an`.  For an ideal sheaf `𝔞` of the smooth projective complex
scheme `X` (a Mathlib `X.IdealSheafData`), its analytification `𝔞^an`
(`SGPT.NAPotential.Berkovich.analytificationIdeal`) and the canonical algebraic model
`alg I` of an analytic ideal sheaf `I` (`SGPT.NAPotential.Berkovich.algebraization`):

* `algebraization_analytificationIdeal_le`: `alg(𝔞^an) ≤ 𝔞`.  On an affine open `U` a regular
  function `r` whose analytic germs at all complex points of `U` lie in `𝔞^an` has its germ at
  every closed point `x` in the extension `𝔞_x 𝒪^an_{X,x}`, hence (faithful flatness of
  `𝒪_{X,x} → 𝒪^an_{X,x}`, `SGPT.Okounkov.schemeNativeStalkGerm_faithfullyFlat`) in `𝔞_x`; by
  the Nullstellensatz every maximal ideal of `Γ(U, 𝒪_X)` is a complex point, and ideal
  membership in `Γ(U, 𝒪_X)` is detected at the maximal ideals.
* `algebraization_analytificationIdeal`: with the other half
  `le_algebraization_analytificationIdeal`, `alg(𝔞^an) = 𝔞`: this is the second clause of
  `SGPT.NAPotential.Berkovich.SerreGAGAIdeals` (`serreGAGAIdeals_algebraic`).
* `analytificationIdeal_le_iff`: `𝔞^an ⊆ 𝔟^an ↔ 𝔞 ≤ 𝔟` (analytification is an order embedding).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.NAPotential.Berkovich

open Set Filter
open scoped Topology Manifold
open AlgebraicGeometry CategoryTheory SGPT.Foundations.Schemes SGPT.Okounkov
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending

/-! ### The stalk of an ideal sheaf at a point of an affine open -/

section Stalk

variable {X : Scheme.{0}}

/-- The stalk `𝔞_c` is generated by the germs of the sections of `𝔞` over any single affine open
neighbourhood of `c`. -/
theorem stalkIdeal_eq_map (𝔞 : X.IdealSheafData) {c : X} (U : X.affineOpens)
    (hc : c ∈ (U : X.Opens)) :
    stalkIdeal 𝔞 c = Ideal.map (X.presheaf.germ U c hc).hom (𝔞.ideal U) := by
  apply le_antisymm
  · apply iSup₂_le
    intro V hV
    obtain ⟨_, ⟨W, hW, rfl⟩, hcW, hWUV⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_inter hc hV) ((U : X.Opens).isOpen.inter (V : X.Opens).isOpen)
    let W' : X.affineOpens := ⟨W, hW⟩
    have hWU : W' ≤ U := fun x hx => (hWUV hx).1
    have hWV : W' ≤ V := fun x hx => (hWUV hx).2
    refine (map_le_map_of_le 𝔞 hWV hcW).trans (le_of_eq ?_)
    rw [← 𝔞.map_ideal hWU, Ideal.map_map]
    congr 1
    rw [← CommRingCat.hom_comp]
    exact congrArg CommRingCat.Hom.hom (X.presheaf.germ_res (homOfLE hWU) c hcW)
  · exact le_iSup₂_of_le U hc le_rfl

end Stalk

/-! ### Ideal membership on an affine open is detected at the maximal ideals -/

section LocalGlobal

variable {X : Scheme.{0}}

theorem fromSpec_mem {U : X.Opens} (hU : IsAffineOpen U) (y : Spec Γ(X, U)) :
    hU.fromSpec y ∈ U :=
  (hU.range_fromSpec ▸ Set.mem_range_self y : hU.fromSpec y ∈ (U : Set X))

set_option backward.isDefEq.respectTransparency.types false in
/-- On an affine open `U`, `s ∈ I` as soon as the germ of `s` at the point of every maximal ideal
of `Γ(U, 𝒪_X)` lies in the extension of `I` (Mathlib's `IsAffineOpen.mem_ideal_iff`, with the
points restricted to the closed points). -/
theorem mem_ideal_of_forall_maximal {U : X.Opens} (hU : IsAffineOpen U) {s : Γ(X, U)}
    {I : Ideal Γ(X, U)}
    (H : ∀ (P : Ideal Γ(X, U)) (hP : P.IsMaximal) (x : X) (hx : x ∈ U),
      hU.fromSpec ⟨P, hP.isPrime⟩ = x →
        X.presheaf.germ U x hx s ∈ I.map (X.presheaf.germ U x hx).hom) :
    s ∈ I := by
  let (x : _) : Algebra Γ(X, U) (X.presheaf.stalk (hU.fromSpec x)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf _
  have (P : Ideal Γ(X, U)) [hP : P.IsPrime] : IsLocalization.AtPrime _ P :=
      hU.isLocalization_stalk' ⟨P, hP⟩ (fromSpec_mem hU _)
  refine Submodule.mem_of_localization_maximal
      (fun P hP ↦ X.presheaf.stalk (hU.fromSpec ⟨P, hP.isPrime⟩))
      (fun P hP ↦ Algebra.linearMap _ _) _ _ ?_
  intro P hP
  rw [Ideal.localized₀_eq_restrictScalars_map]
  exact H P hP _ (fromSpec_mem hU _) rfl

end LocalGlobal

/-! ### Closed points are complex points (Nullstellensatz) -/

section ClosedPoints

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))

/-- Every maximal ideal of the ring of an affine open of a scheme locally of finite type over
`ℂ` is the image of a complex point (Hilbert's Nullstellensatz). -/
theorem exists_schemeComplexPoint_fromSpec [LocallyOfFiniteType f] {U : X.Opens}
    (hU : IsAffineOpen U) (P : Ideal Γ(X, U)) (hP : P.IsMaximal) :
    ∃ p : SchemeComplexPoint f, schemeComplexPointImage f p = hU.fromSpec ⟨P, hP.isPrime⟩ := by
  let c : ComplexAffineChart X := ⟨Γ(X, U), hU.fromSpec, inferInstance⟩
  let := affinePointFieldAlgebra (c.map ≫ f)
  have := complexAffineChart_finiteType f c
  have := hP
  let χ : Γ(X, U) →ₐ[ℂ] ℂ :=
    (finiteTypeComplexResidueAlgEquiv Γ(X, U) P).toAlgHom.comp (Ideal.Quotient.mkₐ ℂ P)
  let q : ComplexAffineChartPoint f c := (affineSchemePointEquivOfStructure (c.map ≫ f)).symm χ
  refine ⟨complexAffineChartPointMap f c q, ?_⟩
  rw [schemeComplexPointImage_chart]
  change hU.fromSpec (schemeComplexPointImage (c.map ≫ f) q) = _
  congr 1
  rw [← schemeAffineOriginalPrime_eq_image (A := Γ(X, U)) (c.map ≫ f) q]
  apply PrimeSpectrum.ext
  change RingHom.ker (schemeAffineOriginalPoint (c.map ≫ f) q) = P
  have hχ : ∀ a, schemeAffineOriginalPoint (c.map ≫ f) q a = χ a := by
    intro a
    rw [schemeAffineOriginalPoint_apply, ← affineSchemePointEquivOfStructure_apply]
    exact congrArg (fun φ : ComplexAlgebraPoint Γ(X, U) => φ a)
      ((affineSchemePointEquivOfStructure (c.map ≫ f)).apply_symm_apply χ)
  ext a
  rw [RingHom.mem_ker, hχ]
  change (finiteTypeComplexResidueAlgEquiv Γ(X, U) P) (Ideal.Quotient.mk P a) = 0 ↔ a ∈ P
  rw [map_eq_zero_iff _ (finiteTypeComplexResidueAlgEquiv Γ(X, U) P).injective,
    Ideal.Quotient.eq_zero_iff_mem]

end ClosedPoints

/-! ### The faithful-flatness half: `alg(𝔞^an) ≤ 𝔞` -/

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) (n : ℕ) [SmoothOfRelativeDimension n f]
  (E : ClosedProjectiveEmbedding f)

local instance gagaFaithfulPointTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance gagaFaithfulPointCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

/-- The germ at a complex point `p` of a function in `𝔞^an` lies in the extension
`𝔞_x 𝒪^an_{X,x}` of the algebraic stalk `𝔞_x`, `x` the image of `p`. -/
theorem mk_mem_map_stalkIdeal_of_mem_analytificationIdeal (𝔞 : X.IdealSheafData)
    (p : SchemeComplexPoint f) {g : SchemeComplexPoint f → ℂ} (hg : HolomorphicAt n g p)
    (h : (analytificationIdeal f n E 𝔞).mem p g) :
    letI := E.isSeparated
    letI := E.quasiCompact
    NativeHolGerm.mk g hg ∈
      (stalkIdeal 𝔞 (schemeComplexPointImage f p)).map (schemeNativeStalkGerm f n p) := by
  let := E.isSeparated
  let := E.quasiCompact
  let := schemeAnalyticTN_isComplexManifold f n
  obtain ⟨-, N, s, a, hS, ha, heq⟩ := h
  choose U hpU r hr hsr using hS
  have hs : ∀ i, HolomorphicAt n (s i) p := fun i => by
    rw [hsr i]; exact schemeOpenRegularFunction_holomorphicAt f n E (U i) (r i) p (hpU i)
  have hsum : HolomorphicAt n (fun y => ∑ i, a i y * s i y) p :=
    HolomorphicAt.sum _ fun i _ => (ha i).mul (hs i)
  have hmk : NativeHolGerm.mk g hg = NativeHolGerm.mk _ hsum :=
    NativeHolGerm.mk_eq_mk_iff.mpr heq
  rw [hmk, SGPT.PSH.IdealRestriction.mk_sum_mul a s ha hs hsum]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ ?_
  have hsi : NativeHolGerm.mk (s i) (hs i) =
      schemeNativeStalkGerm f n p (X.presheaf.germ (U i).val
        (schemeComplexPointImage f p) (hpU i) (r i)) := by
    have := schemeOpenRegularFunction_germ f n E (U i).val (r i) p (hpU i)
    rw [← this]
    exact NativeHolGerm.mk_eq_mk_iff.mpr (by rw [hsr i])
  rw [hsi]
  exact Ideal.mem_map_of_mem _ (germ_mem_stalkIdeal 𝔞 (U i) (hpU i) (hr i))

/-- **`alg(𝔞^an) ≤ 𝔞`** (blueprint `claude-gagamult2:alg-an`): a regular function on an affine
open whose analytic germs at all complex points lie in `𝔞^an` is a section of `𝔞`. -/
theorem algebraization_analytificationIdeal_le (𝔞 : X.IdealSheafData) :
    algebraization f n E (analytificationIdeal f n E 𝔞) ≤ 𝔞 := by
  let := E.isSeparated
  let := E.quasiCompact
  let := E.locallyOfFiniteType
  let := schemeAnalyticTN_isComplexManifold f n
  intro U
  refine (algebraization_ideal_le f n E _ U).trans (Ideal.span_le.mpr fun t ht => ?_)
  refine mem_ideal_of_forall_maximal U.2 fun P hP x hx hxP => ?_
  obtain ⟨p, hp⟩ := exists_schemeComplexPoint_fromSpec f U.2 P hP
  rw [hxP] at hp
  subst hp
  have hmem := mk_mem_map_stalkIdeal_of_mem_analytificationIdeal f n E 𝔞 p
    (schemeOpenRegularFunction_holomorphicAt f n E U t p hx) (ht p hx)
  rw [schemeOpenRegularFunction_germ f n E U t p hx] at hmem
  rw [← mem_ideal_iff_schemeNativeStalkGerm f n p, stalkIdeal_eq_map 𝔞 U hx] at hmem
  exact hmem

/-- **`alg(𝔞^an) = 𝔞`** for every ideal sheaf `𝔞` of `X`. -/
theorem algebraization_analytificationIdeal (𝔞 : X.IdealSheafData) :
    algebraization f n E (analytificationIdeal f n E 𝔞) = 𝔞 :=
  le_antisymm (algebraization_analytificationIdeal_le f n E 𝔞)
    (le_algebraization_analytificationIdeal f n E 𝔞)

/-- The second clause of `SerreGAGAIdeals`: every algebraic ideal sheaf is recovered from its
analytification. -/
theorem serreGAGAIdeals_algebraic :
    ∀ 𝔞 : X.IdealSheafData, algebraization f n E (analytificationIdeal f n E 𝔞) = 𝔞 :=
  algebraization_analytificationIdeal f n E

/-- Analytification is monotone. -/
theorem analytificationIdeal_mono {𝔞 𝔟 : X.IdealSheafData} (h : 𝔞 ≤ 𝔟) :
    (analytificationIdeal f n E 𝔞).Le (analytificationIdeal f n E 𝔟) := by
  intro p g hg
  have hg' : IsInSpanAt (n := n) (fun s => ∃ (U : X.affineOpens)
      (_ : schemeComplexPointImage f p ∈ (U : X.Opens)) (r : Γ(X, U)), r ∈ 𝔞.ideal U ∧
        s = schemeOpenRegularFunction f n E U r) p g := hg
  show IsInSpanAt (n := n) (fun s => ∃ (U : X.affineOpens)
      (_ : schemeComplexPointImage f p ∈ (U : X.Opens)) (r : Γ(X, U)), r ∈ 𝔟.ideal U ∧
        s = schemeOpenRegularFunction f n E U r) p g
  refine IsInSpanAt.mono ?_ hg'
  rintro _ ⟨U, hU, r, hr, rfl⟩
  exact ⟨U, hU, r, h U hr, rfl⟩

/-- Analytification is an order embedding: `𝔞^an ⊆ 𝔟^an ↔ 𝔞 ≤ 𝔟`. -/
theorem analytificationIdeal_le_iff {𝔞 𝔟 : X.IdealSheafData} :
    (analytificationIdeal f n E 𝔞).Le (analytificationIdeal f n E 𝔟) ↔ 𝔞 ≤ 𝔟 := by
  refine ⟨fun h => ?_, analytificationIdeal_mono f n E⟩
  rw [← algebraization_analytificationIdeal f n E 𝔞,
    ← algebraization_analytificationIdeal f n E 𝔟]
  exact algebraization_mono f n E h

/-- Analytification is injective on ideal sheaves. -/
theorem analytificationIdeal_injective :
    Function.Injective (analytificationIdeal f n E) := by
  intro 𝔞 𝔟 h
  rw [← algebraization_analytificationIdeal f n E 𝔞, h, algebraization_analytificationIdeal]

end SGPT.NAPotential.Berkovich
