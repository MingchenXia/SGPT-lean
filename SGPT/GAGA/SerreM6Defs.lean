import SGPT.GAGA.SerreM6Segre

/-!
# Serre's GAGA: the objects of `lma:GAGA`

Source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145): *Let `X` be a complex projective
variety and `p : X × ℂ → X` the natural projection. Assume that `𝓘` is an analytic coherent ideal
sheaf on `X × ℂ` with `𝓘|_{X × ℂ*} = p^*𝒥` for some coherent ideal sheaf `𝒥` on `X`. Then `𝓘` is
the analytification of an algebraic coherent ideal sheaf.*

Model (step G0 of `claude-serre-gaga.tex`), in the cone model of lanes SERRE-PN/M34:

* `X = V(F) ⊆ ℙᴷ` for homogeneous polynomials `F_k` generating a prime ideal; its analytic
  structure sheaf is `𝒪_{ℙᴷ}/(F)` (the analytification of the closed subscheme `V(F)`), so
  ideal sheaves of `𝒪_{X × ℂ}` (resp. `𝒪_X`) are ideal sheaves of `𝒪_{ℙᴷ × ℂ}` (resp. `𝒪_{ℙᴷ}`)
  containing `(F)` (`idealF₂`, `idealF`), and one is coherent iff the other is.
* `ℙᴷ × ℂ` is `(ℂ^{K+1} ∖ 0) × ℂ` modulo `ℂ*` acting on the first factor; coherent ideal sheaves
  on it are coherent germ modules (`ι = Unit`) on `{z ≠ 0}` invariant under that action
  (`IsZInvariant`).
* `p^*𝒥` is the ideal generated by the germs `h(z)`, `h ∈ 𝒥_z` (`pullJ`).
* An algebraic coherent ideal sheaf on `ℙᴷ × 𝔸¹` (or on `X × 𝔸¹`, adding `(F)`) is given by
  finitely many polynomials `Q_k ∈ ℂ[t][z_0, …, z_K]` homogeneous in `z`; its analytification is
  the ideal sheaf generated at every point by the `Q_k` (`AlgGenerated`).
* `LmaGAGA`: the statement of the lemma in this model.

Also: `pullJ` is generated by the generators of `𝒥` (`pullJ_iff`), hence coherent
(`pullJ_isCoherentOn`); when `𝒥` is generated by homogeneous polynomials, `pullJ` is transported
by the chart change at infinity `chi (y, s) = (s y, 1/s)` (`pullJ_chi`).

Blueprint: `claude-serre-m6.tex`, nodes `claude-serre-m6:objects`, `claude-serre-m6:pull`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {K : ℕ}

/-! ### The objects -/

/-- `ℂ*` acting on the first factor of `(ℂ^{K+1} ∖ 0) × ℂ`: the germ modules of coherent sheaves
on `ℙᴷ × ℂ`. -/
def IsZInvariant (P : GermModule (ConeSpace K × ℂ) Unit) : Prop :=
  ∀ q : ConeSpace K × ℂ, q.1 ≠ 0 → ∀ c : ℂ, c ≠ 0 → ∀ a : Unit → ConeSpace K × ℂ → ℂ,
    P.mem q a ↔ P.mem (c • q.1, q.2) (fun j p => a j (c⁻¹ • p.1, p.2))

/-- The pull-back `p^*𝒥` of an ideal sheaf along `p : ℙᴷ × ℂ → ℙᴷ`: generated by the germs
`h(z)` with `h ∈ 𝒥_z`. -/
def pullJ (J : GermModule (ConeSpace K) Unit) : GermModule (ConeSpace K × ℂ) Unit :=
  ⟨fun q g => ∃ (ν : Type) (_ : Fintype ν) (h : ν → Unit → ConeSpace K → ℂ)
    (c : ν → ConeSpace K × ℂ → ℂ), (∀ k, J.mem q.1 (h k)) ∧ (∀ k, HolAt (c k) q) ∧
      ∀ j, g j =ᶠ[𝓝 q] fun p => ∑ k, c k p * h k j p.1⟩

/-- The ideal `(F) 𝒪_{ℙᴷ}` of `X = V(F)`. -/
def idealF {σ : Type} [Fintype σ] (F : σ → MvPolynomial (Fin (K + 1)) ℂ) :
    GermModule (ConeSpace K) Unit :=
  GermModule.span fun k => polyTuple (F k)

/-- The ideal `(F) 𝒪_{ℙᴷ × ℂ}` of `X × ℂ`. -/
def idealF₂ {σ : Type} [Fintype σ] (F : σ → MvPolynomial (Fin (K + 1)) ℂ) :
    GermModule (ConeSpace K × ℂ) Unit :=
  GermModule.span fun k _ p => polyTuple (F k) () p.1

/-- The value at `(z, t)` of a polynomial `Q ∈ ℂ[t][z_0, …, z_K]`. -/
def evalZT (Q : MvPolynomial (Fin (K + 1)) (Polynomial ℂ)) (p : ConeSpace K × ℂ) : ℂ :=
  MvPolynomial.eval₂ (Polynomial.evalRingHom p.2) (fun l => p.1 l) Q

/-- `𝓘` is the analytification of an algebraic coherent ideal sheaf on `ℙᴷ × 𝔸¹`: it is
generated at every point by finitely many polynomials `Q_k ∈ ℂ[t][z_0, …, z_K]`, homogeneous in
`z` (the homogeneous ideal `(Q_k)` defines the algebraic ideal sheaf). -/
def AlgGenerated (I : GermModule (ConeSpace K × ℂ) Unit) : Prop :=
  ∃ (μ : Type) (_ : Fintype μ) (Q : μ → MvPolynomial (Fin (K + 1)) (Polynomial ℂ)) (d : μ → ℕ),
    (∀ k, (Q k).IsHomogeneous (d k)) ∧
      I.GeneratedOn {p | p.1 ≠ 0} (fun k _ p => evalZT (Q k) p)

/-- **`lma:GAGA`** in the cone model: for a complex projective variety `X = V(F) ⊆ ℙᴷ`, a coherent
ideal sheaf `𝓘` of `𝒪_{X × ℂ}` (an invariant coherent ideal of `𝒪_{ℙᴷ × ℂ}` containing `(F)`) with
`𝓘|_{X × ℂ*} = p^*𝒥` for a coherent ideal sheaf `𝒥` of `𝒪_X` is the analytification of an algebraic
coherent ideal sheaf. Since `(F) ⊆ 𝒥`, the preimage of `p^*𝒥` in `𝒪_{ℙᴷ × ℂ}` is `pullJ 𝒥`. -/
def LmaGAGA : Prop :=
  ∀ (K : ℕ) (σ : Type) [Fintype σ] (F : σ → MvPolynomial (Fin (K + 1)) ℂ),
    (∀ k, ∃ d, (F k).IsHomogeneous d) → (Ideal.span (Set.range F)).IsPrime →
    ∀ (I : GermModule (ConeSpace K × ℂ) Unit) (J : GermModule (ConeSpace K) Unit),
      I.IsCoherentOn {p | p.1 ≠ 0} → IsZInvariant I → (idealF₂ F).LeOn I {p | p.1 ≠ 0} →
      J.IsCoherentOn (puncture (ConeSpace K)) → IsConeInvariant J →
      (idealF F).LeOn J (puncture (ConeSpace K)) →
      I.EqOn (pullJ J) {p | p.1 ≠ 0 ∧ p.2 ≠ 0} → AlgGenerated I

/-! ### The pull-back `p^*𝒥` -/

/-- Generators of `𝒥` near `y` generate `p^*𝒥` near `(y, s)`. -/
theorem pullJ_iff {J : GermModule (ConeSpace K) Unit} {U : Set (ConeSpace K)} {μ : Type}
    [Fintype μ] {G : μ → Unit → ConeSpace K → ℂ} (hG : J.GeneratedOn U G) {q : ConeSpace K × ℂ}
    (hq : q.1 ∈ U) {g : Unit → ConeSpace K × ℂ → ℂ} :
    (pullJ J).mem q g ↔ IsCombinationAt (fun k j p => G k j p.1) q g := by
  classical
  have hcomb : ∀ h : Unit → ConeSpace K → ℂ, IsCombinationAt G q.1 h →
      IsCombinationAt (fun k j p => G k j p.1) q (fun j p => h j p.1) := by
    rintro h ⟨d, hd, hdh⟩
    refine ⟨fun k p => d k p.1, fun k => ?_, fun j => ?_⟩
    · exact (hd k).comp continuous_fst fun _ => differentiableAt_fst
    · exact (hdh j).comp_tendsto continuous_fst.continuousAt
  constructor
  · rintro ⟨ν, _, h, c, hh, hc, hgc⟩
    refine Core.IsCombinationAt.trans (τ := fun k j p => h k j p.1) ⟨c, hc, hgc⟩ fun k => ?_
    exact hcomb (h k) ((hG.2 q.1 hq (h k)).1 (hh k))
  · rintro ⟨c, hc, hgc⟩
    exact ⟨μ, inferInstance, G, c, fun k => (hG.2 q.1 hq (G k)).2 (isCombinationAt_gen G q.1 k),
      hc, hgc⟩

/-- `p^*𝒥` is coherent. -/
theorem pullJ_isCoherentOn {J : GermModule (ConeSpace K) Unit}
    (hJ : J.IsCoherentOn (puncture (ConeSpace K))) :
    (pullJ J).IsCoherentOn {p : ConeSpace K × ℂ | p.1 ≠ 0} := by
  intro q hq
  obtain ⟨U, hU, hqU, μ, _, G, hG⟩ := hJ q.1 hq
  refine ⟨Prod.fst ⁻¹' U, hU.preimage continuous_fst, hqU, μ, inferInstance,
    fun k j p => G k j p.1, ⟨fun k j => (hG.1 k j).comp differentiableOn_fst fun _ h => h,
      fun q' hq' g => pullJ_iff hG hq'⟩⟩

/-- `p^*𝒥` is invariant under `ℂ*` acting on the first factor. -/
theorem isZInvariant_pullJ {J : GermModule (ConeSpace K) Unit} (hJi : IsConeInvariant J) :
    IsZInvariant (pullJ J) := by
  have key : ∀ q : ConeSpace K × ℂ, q.1 ≠ 0 → ∀ c : ℂ, c ≠ 0 → ∀ a,
      (pullJ J).mem q a → (pullJ J).mem (c • q.1, q.2) (fun j p => a j (c⁻¹ • p.1, p.2)) := by
    rintro q hq c hc a ⟨ν, _, h, d, hh, hd, had⟩
    have hφ : Continuous fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2) :=
      (continuous_fst.const_smul c⁻¹).prodMk continuous_snd
    have hφq : (fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2)) (c • q.1, q.2) = q := by
      simp [inv_smul_smul₀ hc]
    refine ⟨ν, inferInstance, fun k j z => h k j (c⁻¹ • z), fun k p => d k (c⁻¹ • p.1, p.2),
      fun k => (hJi q.1 hq c hc (h k)).1 (hh k), fun k => ?_, fun j => ?_⟩
    · have h1 : HolAt (d k) ((fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2)) (c • q.1, q.2)) := by
        rw [hφq]
        exact hd k
      have hφd : ∀ x : ConeSpace K × ℂ,
          DifferentiableAt ℂ (fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2)) x := fun _ =>
        (differentiableAt_fst.const_smul c⁻¹).prodMk differentiableAt_snd
      exact HolAt.comp (φ := fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2))
        (y := (c • q.1, q.2)) h1 hφ hφd
    · have ht : Tendsto (fun p : ConeSpace K × ℂ => (c⁻¹ • p.1, p.2)) (𝓝 (c • q.1, q.2))
          (𝓝 q) := by
        have := hφ.continuousAt (x := (c • q.1, q.2))
        have e : ((c⁻¹ • (c • q.1, q.2).1, (c • q.1, q.2).2) : ConeSpace K × ℂ) = q := hφq
        rwa [ContinuousAt, e] at this
      exact (had j).comp_tendsto ht
  intro q hq c hc a
  refine ⟨key q hq c hc a, fun ha => ?_⟩
  have h' := key (c • q.1, q.2) (smul_ne_zero hc hq) c⁻¹ (inv_ne_zero hc) _ ha
  have e1 : ((c⁻¹ • (c • q.1), q.2) : ConeSpace K × ℂ) = q := by simp [inv_smul_smul₀ hc]
  have e2 : (fun j (p : ConeSpace K × ℂ) => a j (c⁻¹ • (c⁻¹)⁻¹ • p.1, p.2)) = a := by
    funext j p
    simp [inv_inv, inv_smul_smul₀ hc]
  simp only at h'
  rw [e1, e2] at h'
  exact h'

/-- **The chart change at infinity**: when `𝒥` is generated by homogeneous polynomials, `p^*𝒥`
is transported by `chi (y, s) = (s y, 1/s)` at points with `y ≠ 0`, `s ≠ 0`. -/
theorem pullJ_chi {J : GermModule (ConeSpace K) Unit} {μ : Type} [Fintype μ]
    {G : μ → MvPolynomial (Fin (K + 1)) ℂ} {m : ℕ} (hGh : ∀ k, (G k).IsHomogeneous m)
    (hG : J.GeneratedOn (puncture (ConeSpace K)) (fun k => polyTuple (G k)))
    {q : ConeSpace K × ℂ} (hq1 : q.1 ≠ 0) (hq2 : q.2 ≠ 0) {g : Unit → ConeSpace K × ℂ → ℂ}
    (hg : (pullJ J).mem (chi q) g) : (pullJ J).mem q (fun j p => g j (chi p)) := by
  have hc1 : (chi q).1 ≠ 0 := smul_ne_zero hq2 hq1
  obtain ⟨c, hc, hcg⟩ := (pullJ_iff hG hc1).1 hg
  refine (pullJ_iff hG hq1).2 ⟨fun k p => c k (chi p) * p.2 ^ m, fun k => ?_, fun j => ?_⟩
  · exact (HolAt.comp_of_eventually (φ := chi) (hc k) (eventually_differentiableAt_chi hq2)).mul
      (Eventually.of_forall fun _ => differentiableAt_snd.pow m)
  · have hev : ∀ᶠ p in 𝓝 q, p.1 ≠ 0 ∧ p.2 ≠ 0 :=
      (continuous_fst.continuousAt.eventually_ne hq1).and
        (continuous_snd.continuousAt.eventually_ne hq2)
    filter_upwards [(differentiableAt_chi hq2).continuousAt.eventually (hcg j), hev]
      with p hp hp0
    rw [hp]
    refine Finset.sum_congr rfl fun k _ => ?_
    have h := (isHomOn_polyTuple (hGh k)).hom p.1 hp0.1 p.2 hp0.2 ()
    simp only [chi]
    rw [h, zpow_natCast]
    ring

end SGPT.GAGA.PN
