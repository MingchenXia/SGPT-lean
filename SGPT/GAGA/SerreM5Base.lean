import SGPT.GAGA.SerreM5B

/-!
# Serre's theorems on `ℙᴺ`: the base case `d = 0` of Theorem A

Towards source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145), milestone M4.2.

`L_0 = ℂ e_0` is the cone over a point of `ℙᴺ`. Let `M ⊇ I_{L_0} 𝒪^ι` be coherent and
`ℂ*`-invariant, `x ∈ L_0 ∖ 0`, and `W = {β(x) : β ∈ M_x} ⊆ ℂ^ι` (`valSpace`).

* `val_line_mem`: for `a ∈ M_x` the values `a(c x)`, `c` near `1`, lie in `W` (membership is open
  for coherent `M`, and `a(c ·) ∈ M_x` by invariance).
* `line_decomp`: such a tuple is, modulo `I_{L_0}`, `∑_l (c_l + (z_0/x_0 - 1) γ_l(z)) w_l` for a
  basis `w_l` of `W` (coordinates on `W` and `dslope` along the line).
* `const_mem_of_valSpace`: the constant tuples `w ∈ W` lie in `M_x` (Nakayama's lemma for the
  module generated by the constants of `W` and `I_{L_0}`, with `h = z_0/x_0 - 1`).
* `ptGen_zero`: the constants `w_l`, global sections of `M(0)`, generate `M_x` modulo `I_{L_0}`.

Blueprint: `claude-serre-m5.tex`, node `claude-serre-m5:base`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {N : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The constant tuple `v`. -/
def cstT (v : ι → ℂ) : ι → ConeSpace N → ℂ := fun j _ => v j

/-- The coordinate `z_0 / x_0` along `L_0`. -/
def lineCoord (x z : ConeSpace N) : ℂ := (x 0)⁻¹ * z 0

/-- Membership of a germ is an open condition at points of coherence. -/
theorem eventually_mem_of_coherentAt' {M : GermModule (ConeSpace N) ι} {x : ConeSpace N}
    (hM : M.CoherentAt x) {a : ι → ConeSpace N → ℂ} (ha : M.mem x a) :
    ∀ᶠ y in 𝓝 x, M.mem y a := by
  obtain ⟨U, hU, hxU, μ, _, τ, hτ⟩ := hM
  filter_upwards [hU.mem_nhds hxU, IsCombinationAt.eventually' ((hτ.2 x hxU a).1 ha)] with y hy hc
  exact (hτ.2 y hy a).2 hc

/-- Off `L_d`, every holomorphic germ lies in `I_{L_d} 𝒪^ι`. -/
theorem Idm_mem_of_not_mem_planeL {d : ℕ} {y : ConeSpace N} (hy : y ∉ planeL d)
    {a : ι → ConeSpace N → ℂ} (ha : HolTupleAt a y) : (Idm d ι).mem y a := by
  rw [mem_Idm_iff]
  refine ⟨ha, ?_⟩
  have hy' : ¬ ∀ l : Fin (N + 1), d < l.1 → y l = 0 := hy
  push Not at hy'
  obtain ⟨l, hl, hyl⟩ := hy'
  have hc : HolAt (fun z : ConeSpace N => z l) y :=
    Eventually.of_forall fun z => differentiable_coord l z
  filter_upwards [hc.continuousAt.eventually_ne hyl] with z hz hzL
  exact absurd (hzL l hl) hz

theorem coord_zero_ne_zero {x : ConeSpace N} (hx : x ∈ planeL 0) (hx0 : x ≠ 0) : x 0 ≠ 0 := by
  intro h
  apply hx0
  ext l
  by_cases hl : l = 0
  · subst hl
    simpa using h
  · have : 0 < l.1 := Nat.pos_of_ne_zero fun h' => hl (Fin.ext h')
    simpa using hx l this

theorem differentiableAt_lineCoord (x z : ConeSpace N) :
    DifferentiableAt ℂ (fun z : ConeSpace N => lineCoord x z) z := by
  have h : (fun z : ConeSpace N => lineCoord x z) =
      ⇑((x 0)⁻¹ • (EuclideanSpace.proj (0 : Fin (N + 1)) : ConeSpace N →L[ℂ] ℂ)) := by
    funext z
    simp [lineCoord]
  rw [h]
  exact ContinuousLinearMap.differentiableAt _

theorem holAt_lineCoord (x y : ConeSpace N) : HolAt (fun z : ConeSpace N => lineCoord x z) y :=
  Eventually.of_forall fun z => differentiableAt_lineCoord x z

/-- Points of `L_0` are multiples of `x`. -/
theorem planeL_zero_eq_smul {x z : ConeSpace N} (hx : x ∈ planeL 0) (hx0 : x 0 ≠ 0)
    (hz : z ∈ planeL 0) : z = lineCoord x z • x := by
  ext l
  by_cases hl : l = 0
  · subst hl
    simp only [lineCoord, PiLp.smul_apply, smul_eq_mul]
    field_simp
  · have hl' : 0 < l.1 := Nat.pos_of_ne_zero fun h' => hl (Fin.ext h')
    simp [hz l hl', hx l hl']

/-- The values at `x` of the members of `M_x`. -/
def valSpace (M : GermModule (ConeSpace N) ι) (x : ConeSpace N) (hM : M.CoherentAt x) :
    Submodule ℂ (ι → ℂ) where
  carrier := {v | ∃ β : ι → ConeSpace N → ℂ, M.mem x β ∧ ∀ j, β j x = v j}
  add_mem' := by
    rintro v w ⟨β, hβ, hv⟩ ⟨β', hβ', hw⟩
    exact ⟨fun j z => β j z + β' j z, hM.add_mem hβ hβ', fun j => by simp [hv j, hw j]⟩
  zero_mem' := ⟨fun _ _ => 0, hM.zero_mem, fun _ => rfl⟩
  smul_mem' := by
    rintro c v ⟨β, hβ, hv⟩
    exact ⟨fun j z => c * β j z, hM.smul_mem (holAt_const c x) hβ, fun j => by simp [hv j]⟩

theorem tendsto_smul_one (x : ConeSpace N) :
    Tendsto (fun c : ℂ => c • x) (𝓝 1) (𝓝 x) := by
  have h : Continuous fun c : ℂ => c • x := continuous_id.smul continuous_const
  have h2 := h.tendsto 1
  simpa only [one_smul] using h2

/-- **Values along the line** lie in `W`. -/
theorem val_line_mem {M : GermModule (ConeSpace N) ι} (hMi : IsConeInvariant M)
    {x : ConeSpace N} (hx0 : x ≠ 0) (hM : M.CoherentAt x) {a : ι → ConeSpace N → ℂ}
    (ha : M.mem x a) : ∀ᶠ c in 𝓝 (1 : ℂ), (fun j => a j (c • x)) ∈ valSpace M x hM := by
  filter_upwards [(tendsto_smul_one x).eventually (eventually_mem_of_coherentAt' hM ha),
    isOpen_ne.mem_nhds (one_ne_zero : (1 : ℂ) ≠ 0)] with c hc hc0
  refine ⟨fun j z => a j (c • z), ?_, fun j => rfl⟩
  rw [hMi x hx0 c hc0]
  have e : (fun j z => (fun j z => a j (c • z)) j (c⁻¹ • z)) = a := by
    funext j z
    simp only [smul_inv_smul₀ hc0]
  rw [e]
  exact hc

/-- **Decomposition along the line**: a tuple whose values along `ℂ* x` lie in `W` is, modulo
`I_{L_0}`, a combination of a basis of `W` with coefficients `c_l + (z_0/x_0 - 1) γ_l`. -/
theorem line_decomp {W : Submodule ℂ (ι → ℂ)} {r : ℕ} (B : Module.Basis (Fin r) ℂ W)
    {x : ConeSpace N} (hx : x ∈ planeL 0) (hx0 : x 0 ≠ 0) {a : ι → ConeSpace N → ℂ}
    (ha : HolTupleAt a x) (hW : ∀ᶠ c in 𝓝 (1 : ℂ), (fun j => a j (c • x)) ∈ W) :
    ∃ (c₀ : Fin r → ℂ) (γ : Fin r → ConeSpace N → ℂ), (∀ l, HolAt (γ l) x) ∧
      (∀ j, ∑ l, c₀ l * (B l : ι → ℂ) j = a j x) ∧
      (Idm 0 ι).mem x (fun j z => a j z -
        ∑ l, (c₀ l + (lineCoord x z - 1) * γ l z) * (B l : ι → ℂ) j) := by
  classical
  obtain ⟨g, hg⟩ := LinearMap.exists_extend B.equivFun.toLinearMap
  have hgW : ∀ v ∈ W, ∀ j, ∑ l, g v l * (B l : ι → ℂ) j = v j := by
    intro v hv j
    have e1 : g v = B.equivFun ⟨v, hv⟩ := LinearMap.congr_fun hg ⟨v, hv⟩
    have e2 := congrArg (fun w : W => (w : ι → ℂ) j) (B.sum_equivFun ⟨v, hv⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul] at e2
    rw [e1]
    exact e2
  have hφd : ∀ c : ℂ, DifferentiableAt ℂ (fun c : ℂ => c • x) c := fun _ =>
    differentiableAt_id.smul_const x
  have hφc : Continuous (fun c : ℂ => c • x) := continuous_id.smul continuous_const
  have hcomp : ∀ j, HolAt (fun c : ℂ => a j (c • x)) 1 := fun j => by
    have h1 : HolAt (a j) ((fun c : ℂ => c • x) 1) := by
      simp only [one_smul]
      exact ha j
    exact HolAt.comp (φ := fun c : ℂ => c • x) (y := 1) h1 hφc hφd
  obtain ⟨f, hfdef⟩ : ∃ f : ℂ → Fin r → ℂ,
      f = fun c => (LinearMap.toContinuousLinearMap g) (fun j => a j (c • x)) := ⟨_, rfl⟩
  have hfg : ∀ c, f c = g (fun j => a j (c • x)) := fun c => by
    rw [hfdef]
    rfl
  have hf : ∀ l, HolAt (fun c => f c l) 1 := by
    intro l
    filter_upwards [eventually_all.2 hcomp] with c hc
    have h1 : DifferentiableAt ℂ (fun c : ℂ => fun j => a j (c • x)) c :=
      differentiableAt_pi.2 hc
    rw [hfdef]
    exact differentiableAt_pi.1 ((LinearMap.toContinuousLinearMap g).differentiableAt.comp c h1) l
  obtain ⟨V, hVsub, hVo, h1V⟩ := eventually_nhds_iff.1 ((eventually_all.2 hf).and hW)
  have hγ' : ∀ l, DifferentiableOn ℂ (dslope (fun c => f c l) 1) V := fun l =>
    (Complex.differentiableOn_dslope (hVo.mem_nhds h1V)).2 fun c hc =>
      ((hVsub c hc).1 l).differentiableWithinAt
  have hψd : ∀ z : ConeSpace N, DifferentiableAt ℂ (fun z : ConeSpace N => lineCoord x z) z :=
    fun z => differentiableAt_lineCoord x z
  have hψc : Continuous (fun z : ConeSpace N => lineCoord x z) :=
    continuous_iff_continuousAt.2 fun z => (hψd z).continuousAt
  have hψx : lineCoord x x = 1 := inv_mul_cancel₀ hx0
  have hψhol : HolAt (fun z : ConeSpace N => lineCoord x z) x := Eventually.of_forall hψd
  have hγ : ∀ l, HolAt (fun z => dslope (fun c => f c l) 1 (lineCoord x z)) x := fun l => by
    have h1 : HolAt (dslope (fun c => f c l) 1) ((fun z => lineCoord x z) x) := by
      show HolAt _ (lineCoord x x)
      rw [hψx]
      exact holAt_of_differentiableOn hVo (hγ' l) h1V
    exact h1.comp hψc hψd
  refine ⟨fun l => f 1 l, fun l z => dslope (fun c => f c l) 1 (lineCoord x z), hγ,
    fun j => ?_, ?_⟩
  · have := hgW _ (hVsub 1 h1V).2 j
    rw [hfg]
    simpa only [one_smul] using this
  · refine mem_Idm_iff.2 ⟨fun j => (ha j).sub (HolAt.fintype_sum fun l =>
      ((holAt_const _ x).add ((hψhol.sub (holAt_const 1 x)).mul (hγ l))).mul
        (holAt_const _ x)), ?_⟩
    have hV' : ∀ᶠ z in 𝓝 x, lineCoord x z ∈ V :=
      hψc.continuousAt.eventually (by
        show ∀ᶠ y in 𝓝 (lineCoord x x), y ∈ V
        rw [hψx]
        exact hVo.mem_nhds h1V)
    filter_upwards [hV'] with z hz hzL j
    have hzx : z = lineCoord x z • x := planeL_zero_eq_smul hx hx0 hzL
    have h1 := hgW _ (hVsub _ hz).2 j
    have h2 : ∀ l, f 1 l + (lineCoord x z - 1) * dslope (fun c => f c l) 1 (lineCoord x z) =
        f (lineCoord x z) l := fun l => by
      have := sub_smul_dslope (fun c => f c l) 1 (lineCoord x z)
      rw [smul_eq_mul] at this
      rw [this]
      ring
    show a j z - _ = 0
    simp_rw [h2]
    rw [hfg, sub_eq_zero]
    conv_lhs => rw [hzx]
    exact h1.symm

/-- **The constants of `W` lie in `M_x`** (Nakayama's lemma). -/
theorem const_mem_of_valSpace {M : GermModule (ConeSpace N) ι} (hS : InS 0 M)
    {x : ConeSpace N} (hx : x ∈ planeL 0) (hx0 : x ≠ 0) {v : ι → ℂ}
    (hv : v ∈ valSpace M x (hS.coh x hx0)) : M.mem x (cstT v) := by
  classical
  have hx00 := coord_zero_ne_zero hx hx0
  have hMx := hS.coh x hx0
  have hIx : (Idm 0 ι).CoherentAt x := Idm_isCoherentOn_puncture 0 x hx0
  set W := valSpace M x hMx with hWdef
  set B := Module.finBasis ℂ W with hBdef
  set r := Module.finrank ℂ W with hrdef
  have hβ : ∀ l, ∃ β : ι → ConeSpace N → ℂ, M.mem x β ∧ ∀ j, β j x = (B l : ι → ℂ) j :=
    fun l => (B l).2
  choose β hβM hβx using hβ
  set C' := (GermModule.span (fun l : Fin r => cstT (N := N) (B l : ι → ℂ))).sup (Idm 0 ι)
    with hC'def
  have hC' : C'.CoherentAt x :=
    (GermModule.span_isCoherentOn isOpen_univ (fun _ _ => differentiableOn_const _) x
      (mem_univ x)).sup hIx
  have hcombC : ∀ e : Fin r → ConeSpace N → ℂ, (∀ m, HolAt (e m) x) →
      C'.mem x (fun j z => ∑ m, e m z * (B m : ι → ℂ) j) := fun e he =>
    ⟨fun j z => ∑ m, e m z * (B m : ι → ℂ) j, fun _ _ => 0, ⟨e, he, fun _ => EventuallyEq.rfl⟩,
      hIx.zero_mem, fun j => Eventually.of_forall fun z => (add_zero _).symm⟩
  -- line values of members of `C'`
  have hlineC : ∀ a, C'.mem x a → ∀ᶠ c in 𝓝 (1 : ℂ), (fun j => a j (c • x)) ∈ W := by
    rintro a ⟨s, i, ⟨e, -, hse⟩, hi, hsi⟩
    have hi' := (mem_Idm_iff.1 hi).2
    filter_upwards [(tendsto_smul_one x).eventually (eventually_all.2 hsi),
      (tendsto_smul_one x).eventually (eventually_all.2 hse),
      (tendsto_smul_one x).eventually hi'] with c h1 h2 h3
    have hcx : c • x ∈ planeL 0 := fun l hl => by simp [hx l hl]
    have e3 : (fun j => a j (c • x)) = ∑ m, e m (c • x) • (B m : ι → ℂ) := by
      funext j
      rw [h1 j, h3 hcx j, add_zero, h2 j]
      simp [cstT, Finset.sum_apply]
    rw [e3]
    exact W.sum_mem fun m _ => W.smul_mem _ (B m).2
  -- decompositions of the lifts `β_l`
  choose c₀β γβ hγβ hsumβ hDβ using fun l => line_decomp B hx hx00
    (hMx.holTupleAt_of_mem (hβM l)) (val_line_mem hS.inv hx0 hMx (hβM l))
  have hβC : ∀ l, C'.mem x (β l) := fun l =>
    ⟨fun j z => ∑ m, (c₀β l m + (lineCoord x z - 1) * γβ l m z) * (B m : ι → ℂ) j, _,
      ⟨fun m z => c₀β l m + (lineCoord x z - 1) * γβ l m z, fun m =>
        (holAt_const _ x).add (((holAt_lineCoord x x).sub
            (holAt_const 1 x)).mul (hγβ l m)), fun _ => EventuallyEq.rfl⟩,
      hDβ l, fun j => Eventually.of_forall fun z => by ring⟩
  have hhol : HolAt (fun z : ConeSpace N => lineCoord x z - 1) x :=
    (holAt_lineCoord x x).sub (holAt_const 1 x)
  have hh0 : lineCoord x x - 1 = 0 := by rw [show lineCoord x x = 1 from inv_mul_cancel₀ hx00, sub_self]
  have hNak := generation_nakayama hC' hIx hhol hh0 hβC fun a ha => by
    obtain ⟨c₀, γ, hγ, -, hD⟩ := line_decomp B hx hx00 (hC'.holTupleAt_of_mem ha) (hlineC a ha)
    have hb' : C'.mem x (fun j z => ∑ m, γ m z * (B m : ι → ℂ) j -
        ∑ l, c₀ l * ∑ m, γβ l m z * (B m : ι → ℂ) j) :=
      hC'.sub_mem (hcombC γ hγ) (hC'.finset_sum_mem Finset.univ fun l _ =>
        hC'.smul_mem (holAt_const (c₀ l) x) (hcombC (γβ l) (hγβ l)))
    have hb0 := hIx.sub_mem hD (hIx.finset_sum_mem Finset.univ fun l _ =>
      hIx.smul_mem (holAt_const (c₀ l) x) (hDβ l))
    refine ⟨fun l _ => c₀ l, fun j z => a j z - ∑ l, c₀ l * β l j z - (lineCoord x z - 1) *
        (∑ m, γ m z * (B m : ι → ℂ) j - ∑ l, c₀ l * ∑ m, γβ l m z * (B m : ι → ℂ) j),
      _, fun l => holAt_const _ x, hIx.congr_mem hb0 fun j => Eventually.of_forall fun z => ?_,
      hb', fun j => Eventually.of_forall fun z => ?_⟩
    · show (a j z - ∑ m, (c₀ m + (lineCoord x z - 1) * γ m z) * (B m : ι → ℂ) j) -
          ∑ l ∈ Finset.univ, c₀ l * (β l j z - ∑ m, (c₀β l m + (lineCoord x z - 1) * γβ l m z) *
            (B m : ι → ℂ) j) =
        a j z - ∑ l, c₀ l * β l j z - (lineCoord x z - 1) *
          (∑ m, γ m z * (B m : ι → ℂ) j - ∑ l, c₀ l * ∑ m, γβ l m z * (B m : ι → ℂ) j)
      have e1 : ∑ m, (c₀ m + (lineCoord x z - 1) * γ m z) * (B m : ι → ℂ) j =
          ∑ m, c₀ m * (B m : ι → ℂ) j + (lineCoord x z - 1) * ∑ m, γ m z * (B m : ι → ℂ) j := by
        calc _ = ∑ m, (c₀ m * (B m : ι → ℂ) j +
              (lineCoord x z - 1) * (γ m z * (B m : ι → ℂ) j)) :=
              Finset.sum_congr rfl fun m _ => by ring
          _ = _ := by rw [Finset.sum_add_distrib, ← Finset.mul_sum]
      have e2 : ∀ l, ∑ m, (c₀β l m + (lineCoord x z - 1) * γβ l m z) * (B m : ι → ℂ) j =
          (B l : ι → ℂ) j + (lineCoord x z - 1) * ∑ m, γβ l m z * (B m : ι → ℂ) j := fun l => by
        calc _ = ∑ m, (c₀β l m * (B m : ι → ℂ) j +
              (lineCoord x z - 1) * (γβ l m z * (B m : ι → ℂ) j)) :=
              Finset.sum_congr rfl fun m _ => by ring
          _ = ∑ m, c₀β l m * (B m : ι → ℂ) j +
              (lineCoord x z - 1) * ∑ m, γβ l m z * (B m : ι → ℂ) j := by
            rw [Finset.sum_add_distrib, ← Finset.mul_sum]
          _ = _ := by rw [hsumβ l j, hβx l j]
      have e3 : ∑ l ∈ Finset.univ, c₀ l * (β l j z - ∑ m, (c₀β l m + (lineCoord x z - 1) *
            γβ l m z) * (B m : ι → ℂ) j) =
          ∑ l, c₀ l * β l j z - ∑ l, c₀ l * (B l : ι → ℂ) j -
            (lineCoord x z - 1) * ∑ l, c₀ l * ∑ m, γβ l m z * (B m : ι → ℂ) j := by
        calc _ = ∑ l, (c₀ l * β l j z - c₀ l * (B l : ι → ℂ) j -
              (lineCoord x z - 1) * (c₀ l * ∑ m, γβ l m z * (B m : ι → ℂ) j)) :=
              Finset.sum_congr rfl fun l _ => by rw [e2 l]; ring
          _ = _ := by rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
      rw [e1, e3]
      ring
    · beta_reduce
      ring
  -- the constant `v`
  have hvsum : ∀ j, ∑ m, B.equivFun ⟨v, hv⟩ m * (B m : ι → ℂ) j = v j := by
    intro j
    have e2 := congrArg (fun w : W => (w : ι → ℂ) j) (B.sum_equivFun ⟨v, hv⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul] at e2
    exact e2
  have hvC : C'.mem x (cstT v) := hC'.congr_mem (hcombC _ fun _ => holAt_const _ x) fun j =>
    Eventually.of_forall fun _ => hvsum j
  obtain ⟨c, hc, hca⟩ := hNak _ hvC
  refine hMx.congr_mem (hMx.add_mem (hS.le x hx0 _ hca) (hMx.finset_sum_mem Finset.univ
    fun l _ => hMx.smul_mem (hc l) (hβM l))) fun j => Eventually.of_forall fun z => ?_
  beta_reduce
  ring

/-- **The base case of Theorem A**: members of `𝒮_0` are generated at the points of
`L_0 ∖ 0` by global sections of degree `0` (constant tuples). -/
theorem ptGen_zero {x : ConeSpace N} (hx : x ∈ planeL 0) (hx0 : x ≠ 0) : PtGen N 0 x := by
  intro ι _ _ M hS
  classical
  have hx00 := coord_zero_ne_zero hx hx0
  have hMx := hS.coh x hx0
  set W := valSpace M x hMx with hWdef
  set B := Module.finBasis ℂ W with hBdef
  have hψhol : HolAt (fun z : ConeSpace N => lineCoord x z) x := holAt_lineCoord x x
  refine ⟨0, Fin (Module.finrank ℂ W), inferInstance, fun l => cstT (B l : ι → ℂ),
    ⟨fun l => ?_, fun l y hy => ?_⟩, fun y hy => ?_⟩
  · refine ⟨isOpen_ne, isCone_ne_zero, fun _ h => h, fun j => differentiableOn_const _,
      fun z _ c _ j => ?_⟩
    simp [cstT]
  · have hc : M.mem x (cstT (B l : ι → ℂ)) := const_mem_of_valSpace hS hx hx0 (B l).2
    by_cases hyL : y ∈ planeL 0
    · have hy00 := coord_zero_ne_zero hyL hy
      have hc0 : lineCoord x y ≠ 0 := mul_ne_zero (inv_ne_zero hx00) hy00
      have := (hS.inv x hx0 (lineCoord x y) hc0 _).1 hc
      rw [← planeL_zero_eq_smul hx hx00 hyL] at this
      exact this
    · exact hS.le y hy _ (Idm_mem_of_not_mem_planeL hyL fun j => holAt_const _ y)
  · rw [Set.mem_singleton_iff.1 hy]
    intro a ha
    obtain ⟨c₀, γ, hγ, -, hD⟩ := line_decomp B hx hx00 (hMx.holTupleAt_of_mem ha)
      (val_line_mem hS.inv hx0 hMx ha)
    exact ⟨fun l z => c₀ l + (lineCoord x z - 1) * γ l z, fun l =>
      (holAt_const _ x).add ((hψhol.sub (holAt_const 1 x)).mul (hγ l)), hD⟩

/-- **Theorem A for `𝒮_0`.** -/
theorem serreA_zero : SerreA N 0 :=
  serreA_of_ptGen fun _ hx hx0 => ptGen_zero hx hx0

end SGPT.GAGA.PN
