import SGPT.GAGA.SerreM2Koszul

/-!
# Serre's theorems on `ℙᴺ`, part 8: global generation, polynomials, saturation

Milestones M4.2--M4.3 of `blueprint/src/claude-serre-core.tex`, towards source `lma:GAGA`
(`chapter_NApotential.tex`, lines 1143--1145).

* `GloballyGenerated M m`: finitely many global sections of `M(m)` (tuples holomorphic and
  homogeneous of degree `m` on `ℂ^{N+1} ∖ 0`) generate the stalk of `M` at every point.
  `SerreTheoremA N` is the statement of Serre's Theorem A for invariant coherent subsheaves of
  `𝒪^ι` on `ℙᴺ`: `M(m)` is globally generated for all `m ≫ 0`. It is **not** proved here.
* `exists_poly_generators`: the global generators of an ideal sheaf `I ⊆ 𝒪` in a degree
  `m ≥ 0` are homogeneous polynomials (the `exists_isHomogeneous_eq_of_homogeneous`).
  Hence `gaga_ideal_of_serreTheoremA`: Theorem A implies Serre's GAGA for coherent ideal
  sheaves of `𝒪_{ℙᴺ}` (generation by homogeneous polynomials), milestone M4.3.
* `satChain M e k = M : z_e^k` and `exists_satChain_stable`: the saturation chain stabilizes
  uniformly on `ℂ^{N+1} ∖ 0` (Noetherian germ rings, coherence, compactness of the sphere, and
  `ℂ*`-invariance). This is the finiteness input of the hyperplane step of Theorem A.

Blueprint: `claude-serre-m34.tex`, nodes `claude-serre-m34:theorem-A-statement`,
`claude-serre-m34:gaga-ideals`, `claude-serre-m34:saturation`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology Metric
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {N : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ### Global generation and Theorem A -/

/-- `M(m)` is generated by finitely many global sections: tuples `σ_k`, holomorphic and
homogeneous of degree `m` on `ℂ^{N+1} ∖ 0`, generating the stalk `M_y` at every `y ≠ 0`. -/
def GloballyGenerated (M : GermModule (ConeSpace N) ι) (m : ℤ) : Prop :=
  ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → ConeSpace N → ℂ),
    (∀ k, IsHomOn (puncture (ConeSpace N)) m (σ k)) ∧ M.GeneratedOn (puncture (ConeSpace N)) σ

variable (N) in
/-- **Serre's Theorem A on `ℙᴺ`** (for coherent subsheaves of `𝒪^ι`, in the cone model): every
`ℂ*`-invariant coherent `M ⊆ 𝒪^ι` on `ℂ^{N+1} ∖ 0` has `M(m)` globally generated for `m ≫ 0`.
This statement is the open part of milestone M4; it is not assumed anywhere else. -/
def SerreTheoremA : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (M : GermModule (ConeSpace N) ι),
    M.IsCoherentOn (puncture (ConeSpace N)) → IsConeInvariant M →
      ∃ m₀ : ℤ, ∀ m ≥ m₀, GloballyGenerated M m

/-- The tuple of length one given by a polynomial, as a function on the cone. -/
theorem polyTuple_isHomOn {m : ℕ} {P : MvPolynomial (Fin (N + 1)) ℂ} (hP : P.IsHomogeneous m) :
    IsHomOn (puncture (ConeSpace N)) (m : ℤ) (polyTuple P) :=
  isHomOn_polyTuple hP

/-- **Global generators of an ideal sheaf are homogeneous polynomials**: if the ideal sheaf
`I ⊆ 𝒪` is generated by global sections of `I(m)`, `m ≥ 0`, then it is generated at every point
of `ℂ^{N+1} ∖ 0` by finitely many homogeneous polynomials of degree `m`. -/
theorem exists_poly_generators {I : GermModule (ConeSpace N) Unit} {m : ℕ}
    (h : GloballyGenerated I (m : ℤ)) :
    ∃ (μ : Type) (_ : Fintype μ) (P : μ → MvPolynomial (Fin (N + 1)) ℂ),
      (∀ k, (P k).IsHomogeneous m) ∧
      I.GeneratedOn (puncture (ConeSpace N)) (fun k => polyTuple (P k)) := by
  obtain ⟨μ, _, σ, hσ, hgen⟩ := h
  have hpoly : ∀ k, ∃ P : MvPolynomial (Fin (N + 1)) ℂ, P.IsHomogeneous m ∧
      ∀ x : ConeSpace N, x ≠ 0 → σ k () x = MvPolynomial.eval (fun i => x i) P := by
    intro k
    refine exists_isHomogeneous_eq_of_homogeneous (m := m) ((hσ k).diff ()) fun c x hc hx => ?_
    have := (hσ k).hom x hx c hc ()
    rwa [zpow_natCast] at this
  choose P hPh hPσ using hpoly
  refine ⟨μ, inferInstance, P, hPh, fun k j => (isHomOn_polyTuple (hPh k)).diff j, fun y hy a => ?_⟩
  have hev : ∀ᶠ x in 𝓝 y, ∀ k j, σ k j x = polyTuple (P k) j x := by
    filter_upwards [isOpen_ne.mem_nhds hy] with x hx k j
    exact hPσ k x hx
  rw [hgen.2 y hy a]
  constructor
  · rintro ⟨c, hc, hca⟩
    refine ⟨c, hc, fun j => ?_⟩
    filter_upwards [hca j, hev] with x hx hx'
    rw [hx]
    exact Finset.sum_congr rfl fun k _ => by rw [hx' k j]
  · rintro ⟨c, hc, hca⟩
    refine ⟨c, hc, fun j => ?_⟩
    filter_upwards [hca j, hev] with x hx hx'
    rw [hx]
    exact Finset.sum_congr rfl fun k _ => by rw [hx' k j]

/-- **Serre's GAGA for coherent ideal sheaves of `𝒪_{ℙᴺ}`, from Theorem A** (milestone M4.3):
assuming `SerreTheoremA N`, every `ℂ*`-invariant coherent ideal sheaf `I ⊆ 𝒪` on `ℂ^{N+1} ∖ 0`
(a coherent ideal sheaf of `𝒪_{ℙᴺ}`) is generated, in every large enough degree `m`, by finitely
many homogeneous polynomials of degree `m`. -/
theorem gaga_ideal_of_serreTheoremA (hA : SerreTheoremA N) {I : GermModule (ConeSpace N) Unit}
    (hI : I.IsCoherentOn (puncture (ConeSpace N))) (hIi : IsConeInvariant I) :
    ∃ m₀ : ℕ, ∀ m ≥ m₀, ∃ (μ : Type) (_ : Fintype μ) (P : μ → MvPolynomial (Fin (N + 1)) ℂ),
      (∀ k, (P k).IsHomogeneous m) ∧
      I.GeneratedOn (puncture (ConeSpace N)) (fun k => polyTuple (P k)) := by
  obtain ⟨m₀, hm₀⟩ := hA Unit I hI hIi
  refine ⟨m₀.toNat, fun m hm => exists_poly_generators (hm₀ m ?_)⟩
  have := Int.self_le_toNat m₀
  omega

/-! ### The saturation chain `M : z_e^k` -/

section Saturation

/-- `M : z_e^k`, recursively `M : z_e^{k+1} = (M : z_e^k) : z_e`. -/
def satChain (M : GermModule (ConeSpace N) ι) (e : Fin (N + 1)) :
    ℕ → GermModule (ConeSpace N) ι
  | 0 => M
  | k + 1 => (satChain M e k).comap (scalMat ι e)

variable {M : GermModule (ConeSpace N) ι} (e : Fin (N + 1))

theorem holAt_scalMat (x : ConeSpace N) (i j : ι) : HolAt (scalMat (N := N) ι e i j) x := by
  by_cases h : i = j
  · have : scalMat (N := N) ι e i j = fun z => z e := by funext z; simp [scalMat, h]
    rw [this]
    exact Eventually.of_forall fun z => differentiable_coord e z
  · have : scalMat (N := N) ι e i j = fun _ => 0 := by funext z; simp [scalMat, h]
    rw [this]
    exact holAt_const 0 x

theorem satChain_coherent (hM : M.IsCoherentOn (puncture (ConeSpace N))) :
    ∀ k, (satChain M e k).IsCoherentOn (puncture (ConeSpace N))
  | 0 => hM
  | k + 1 => fun y hy => GermModule.CoherentAt.comap (okaProperty_of_finiteDimensional _)
      (satChain_coherent hM k y hy) (holAt_scalMat e y)

theorem satChain_invariant (hM : M.IsCoherentOn (puncture (ConeSpace N)))
    (hMi : IsConeInvariant M) : ∀ k, IsConeInvariant (satChain M e k)
  | 0 => hMi
  | k + 1 => (satChain_invariant hM hMi k).comap (satChain_coherent e hM k)
      (isHomMatrix_scalMat e)

theorem satChain_mono (hM : M.IsCoherentOn (puncture (ConeSpace N))) (k : ℕ) :
    (satChain M e k).LeOn (satChain M e (k + 1)) (puncture (ConeSpace N)) := by
  intro y hy a ha
  refine ⟨(satChain_coherent e hM k y hy).holTupleAt_of_mem ha, ?_⟩
  rw [matApply_scalMat]
  exact (satChain_coherent e hM k y hy).smul_mem
    (Eventually.of_forall fun z => differentiable_coord e z) ha

theorem satChain_succ_eqOn {k k' : ℕ} {V : Set (ConeSpace N)}
    (h : (satChain M e k).EqOn (satChain M e k') V) :
    (satChain M e (k + 1)).EqOn (satChain M e (k' + 1)) V := by
  intro y hy a
  exact and_congr Iff.rfl (h y hy _)

/-- **Local stabilization** of the saturation chain near a point `y ≠ 0`. -/
theorem exists_satChain_stable_near (hM : M.IsCoherentOn (puncture (ConeSpace N)))
    {y : ConeSpace N} (hy : y ≠ 0) :
    ∃ k₀ : ℕ, ∃ V : Set (ConeSpace N), IsOpen V ∧ y ∈ V ∧
      ∀ k ≥ k₀, (satChain M e k).EqOn (satChain M e k₀) V := by
  classical
  have := isNoetherianRing_holGerm_euclidean (N + 1)
  -- generators of each member of the chain near `y`
  have hgen : ∀ k, ∃ U : Set (ConeSpace N), IsOpen U ∧ y ∈ U ∧
      ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → ConeSpace N → ℂ),
        (satChain M e k).GeneratedOn U σ := fun k => satChain_coherent e hM k y hy
  choose U hUo hyU μ hμ σ hσ using hgen
  let S : ℕ → Submodule (HolGerm (ConeSpace N)) (ι → HolGerm (ConeSpace N)) :=
    fun k => germSpan y (σ k)
  have hmem : ∀ k a, (satChain M e k).mem y a ↔ HolTupleAt a y ∧ germTuple y a ∈ S k :=
    fun k a => (hσ k).mem_iff_germTuple (hUo k) (hyU k) a
  have hSmono : Monotone S := by
    refine monotone_nat_of_le_succ fun k => Submodule.span_le.2 ?_
    rintro _ ⟨l, rfl⟩
    have h1 : (satChain M e k).mem y (σ k l) := (hσ k).gen_mem (hyU k) l
    exact ((hmem (k + 1) _).1 (satChain_mono e hM k y hy _ h1)).2
  obtain ⟨k₀, hk₀⟩ := (monotone_stabilizes_iff_noetherian (R := HolGerm (ConeSpace N))
    (M := ι → HolGerm (ConeSpace N))).2 inferInstance ⟨S, hSmono⟩
  -- equality of stalks at `y`
  have hstalk : ∀ k ≥ k₀, ∀ a, (satChain M e k).mem y a ↔ (satChain M e k₀).mem y a := by
    intro k hk a
    have hS : S k = S k₀ := (hk₀ k hk).symm
    rw [hmem, hmem, hS]
  -- the generators of the next member lie in `satChain k₀` near `y`
  have hτ : ∀ l, ∀ᶠ y' in 𝓝 y, (satChain M e k₀).mem y' (σ (k₀ + 1) l) := fun l =>
    eventually_mem_of_coherentAt (satChain_coherent e hM k₀ y hy)
      ((hstalk (k₀ + 1) (by omega) _).1 ((hσ (k₀ + 1)).gen_mem (hyU _) l))
  obtain ⟨V₀, hV₀, hV₀o, hyV₀⟩ := _root_.eventually_nhds_iff.1 (eventually_all.2 hτ)
  refine ⟨k₀, V₀ ∩ U (k₀ + 1) ∩ puncture (ConeSpace N), (hV₀o.inter (hUo _)).inter isOpen_ne,
    ⟨⟨hyV₀, hyU _⟩, hy⟩, ?_⟩
  have hnext : (satChain M e (k₀ + 1)).EqOn (satChain M e k₀)
      (V₀ ∩ U (k₀ + 1) ∩ puncture (ConeSpace N)) := by
    intro y' hy' a
    refine ⟨fun ha => ?_, fun ha => satChain_mono e hM k₀ y' hy'.2 a ha⟩
    have hc := ((hσ (k₀ + 1)).2 y' hy'.1.2 a).1 ha
    exact (satChain_coherent e hM k₀ y' hy'.2).mem_of_isCombinationAt (hV₀ y' hy'.1.1) hc
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact fun _ _ _ => Iff.rfl
  | succ k _ ih => exact fun y' hy' a =>
      ((satChain_succ_eqOn e ih) y' hy' a).trans (hnext y' hy' a)

/-- **The saturation chain stabilizes** on `ℂ^{N+1} ∖ 0`: there is `k₀` with
`M : z_e^k = M : z_e^{k₀}` (stalkwise) for all `k ≥ k₀`. -/
theorem exists_satChain_stable (hM : M.IsCoherentOn (puncture (ConeSpace N)))
    (hMi : IsConeInvariant M) :
    ∃ k₀ : ℕ, ∀ k ≥ k₀, (satChain M e k).EqOn (satChain M e k₀) (puncture (ConeSpace N)) := by
  classical
  choose k₀ V hVo hyV hV using fun y : sphere (0 : ConeSpace N) 1 =>
    exists_satChain_stable_near e hM (y := (y : ConeSpace N)) (by
      intro h
      have := y.2
      rw [h, mem_sphere_zero_iff_norm, norm_zero] at this
      exact zero_ne_one this)
  obtain ⟨t, ht⟩ := (isCompact_sphere (0 : ConeSpace N) 1).elim_finite_subcover
    (fun y : sphere (0 : ConeSpace N) 1 => V y) hVo fun y hy => mem_iUnion.2 ⟨⟨y, hy⟩, hyV _⟩
  refine ⟨t.sup k₀, fun k hk => ?_⟩
  -- equality on the unit sphere
  have hsph : ∀ z ∈ sphere (0 : ConeSpace N) 1, ∀ a,
      (satChain M e k).mem z a ↔ (satChain M e (t.sup k₀)).mem z a := by
    intro z hz a
    obtain ⟨y, hyt, hzy⟩ := mem_iUnion₂.1 (ht hz)
    have h1 : k₀ y ≤ t.sup k₀ := Finset.le_sup hyt
    exact ((hV y k (h1.trans hk)) z hzy a).trans ((hV y _ h1) z hzy a).symm
  -- transport along `ℂ*`
  intro z hz a
  have hn : ((‖z‖ : ℂ)) ≠ 0 := Complex.ofReal_ne_zero.2 (norm_ne_zero_iff.2 hz)
  have hw : ((‖z‖ : ℂ))⁻¹ • z ∈ sphere (0 : ConeSpace N) 1 :=
    mem_sphere_zero_iff_norm.2 (norm_normalize hz)
  have hw0 : ((‖z‖ : ℂ))⁻¹ • z ≠ 0 := smul_ne_zero (inv_ne_zero hn) hz
  rw [(satChain_invariant e hM hMi k) z hz _ (inv_ne_zero hn) a,
    (satChain_invariant e hM hMi (t.sup k₀)) z hz _ (inv_ne_zero hn) a]
  exact hsph _ hw _

end Saturation

end SGPT.GAGA.PN
