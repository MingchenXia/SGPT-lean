import SGPT.GAGA.SerreM1Sub
import SGPT.Foundations.Analysis.Pending.CoordinatePlaneDivision

/-!
# Serre's theorems on `ℙᴺ`, part 6: sheaves on coordinate linear subspaces

Milestone M4.1 of the plan in `blueprint/src/claude-serre-core.tex`, towards source `lma:GAGA`
(`chapter_NApotential.tex`, lines 1143--1145). Serre's induction on hyperplane sections is
run on `ℙᴺ` itself, for sheaves supported on the coordinate linear subspaces
`L_d = {z_l = 0 for l > d}` (`planeL d`), so that no restriction functor is needed.

* `Idm d ι`: the subsheaf `I_{L_d} 𝒪^ι ⊆ 𝒪^ι`, generated by the `z_l e_j`, `l > d`. By Hadamard's
  lemma for coordinate planes (TN `exists_eq_sum_coord_mul`) a germ lies in it iff it is
  holomorphic and vanishes on `L_d` (`mem_Idm_iff`). It is coherent and `ℂ*`-invariant.
* `z_d` is a non-zero-divisor modulo `I_{L_d}` (`mem_Idm_of_mem_scal`), and
  `I_{L_{d-1}} = I_{L_d} + z_d 𝒪^ι` (`exists_split_Idm`).
* **The hyperplane sequence** (`shortExact_hyperplane`): for a coherent `M ⊇ I_{L_d} 𝒪^ι`
  (a subsheaf of `𝒪_{L_d}^ι`), `0 → (M : z_d)/I_{L_d} (-1) --z_d--> M/I_{L_d} --> (M + I_{L_{d-1}})/I_{L_{d-1}} → 0`
  is exact. The third term is again a subsheaf of a free `𝒪_{L_{d-1}}`-module.
* **Cohomology of `𝒪_{L_d}(m)^ι`** (Koszul, by the sequences above with `M = 𝒪^ι`, starting
  from SERRE-PN2's computation on `ℙᴺ`): `Ȟ^q = 0` for `q ≥ 1`, `m ≥ -d`
  (`cechH_OL_subsingleton`), and `Ȟ^q` is finite-dimensional for all `q ≥ 1`, `m`
  (`finiteDimensional_cechH_OL`).
* **Finiteness of `Ȟ¹`** for every invariant subsheaf `M/I_{L_d}` of `𝒪_{L_d}^ι`
  (`finiteDimensional_cechH_one_Sd`): `Ȟ⁰(𝒪^ι/M) → Ȟ¹(M/I) → Ȟ¹(𝒪_{L_d}^ι)`.

Blueprint: `claude-serre-m34.tex`, nodes `claude-serre-m34:linear`,
`claude-serre-m34:hyperplane-sequence`, `claude-serre-m34:OL-cohomology`,
`claude-serre-m34:finite-H1-Sd`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {N : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ### Coordinate planes and their ideal sheaves -/

/-- The coordinate linear subspace `L_d = {z_l = 0 for l > d}` (the cone over `ℙ^d ⊆ ℙᴺ`). -/
def planeL (d : ℕ) : Set (ConeSpace N) :=
  {z | ∀ l : Fin (N + 1), d < l.1 → z l = 0}

theorem isCone_planeL (d : ℕ) : IsCone (planeL (N := N) d) := by
  intro c _ z hz l hl
  simp [hz l hl]

theorem planeL_anti {d d' : ℕ} (h : d ≤ d') : planeL (N := N) d ⊆ planeL d' :=
  fun _ hz l hl => hz l (lt_of_le_of_lt h hl)

/-- Multiplication by the coordinate `z_l` on `𝒪^ι`. -/
def scalMat (ι : Type) [DecidableEq ι] (l : Fin (N + 1)) : ι → ι → ConeSpace N → ℂ :=
  fun i j z => if i = j then z l else 0

theorem matApply_scalMat (l : Fin (N + 1)) (a : ι → ConeSpace N → ℂ) :
    matApply (scalMat ι l) a = fun i z => z l * a i z := by
  funext i z
  simp [matApply, scalMat]

theorem differentiable_coord (l : Fin (N + 1)) :
    Differentiable ℂ (fun z : ConeSpace N => z l) :=
  (EuclideanSpace.proj (𝕜 := ℂ) l).differentiable

theorem isHomMatrix_scalMat (l : Fin (N + 1)) : IsHomMatrix (scalMat (N := N) ι l) 1 := by
  refine ⟨fun x _ i j => ?_, fun z _ c _ i j => ?_⟩
  · by_cases h : i = j
    · have : scalMat (N := N) ι l i j = fun z => z l := by funext z; simp [scalMat, h]
      rw [this]
      exact Eventually.of_forall fun z => differentiable_coord l z
    · have : scalMat (N := N) ι l i j = fun _ => 0 := by funext z; simp [scalMat, h]
      rw [this]
      exact holAt_const 0 x
  · by_cases h : i = j <;> simp [scalMat, h]

/-- The generators `z_l e_j` (`l > d`) of `I_{L_d} 𝒪^ι`. -/
def linGen (d : ℕ) (ι : Type) [DecidableEq ι] :
    {l : Fin (N + 1) // d < l.1} × ι → ι → ConeSpace N → ℂ :=
  fun p j z => if j = p.2 then z p.1.1 else 0

/-- The ideal sheaf of `L_d` times `𝒪^ι`. -/
def Idm (d : ℕ) (ι : Type) [Fintype ι] [DecidableEq ι] : GermModule (ConeSpace N) ι :=
  GermModule.span (linGen d ι)

theorem differentiable_linGen (d : ℕ) (p : {l : Fin (N + 1) // d < l.1} × ι) (j : ι) :
    Differentiable ℂ (linGen d ι p j) := by
  by_cases h : j = p.2
  · have : linGen (N := N) d ι p j = fun z => z p.1.1 := by funext z; simp [linGen, h]
    rw [this]
    exact differentiable_coord _
  · have : linGen (N := N) d ι p j = fun _ => 0 := by funext z; simp [linGen, h]
    rw [this]
    exact differentiable_const 0

theorem idm_isCoherentOn (d : ℕ) (Ω : Set (ConeSpace N)) : (Idm d ι).IsCoherentOn Ω :=
  fun x _ => GermModule.span_isCoherentOn isOpen_univ
    (fun k j => (differentiable_linGen d k j).differentiableOn) x (mem_univ x)

/-- **Hadamard**: a germ lies in `I_{L_d} 𝒪^ι` iff it is holomorphic and vanishes on `L_d`. -/
theorem mem_Idm_iff {d : ℕ} {y : ConeSpace N} {a : ι → ConeSpace N → ℂ} :
    (Idm d ι).mem y a ↔ HolTupleAt a y ∧ ∀ᶠ z in 𝓝 y, z ∈ planeL d → ∀ j, a j z = 0 := by
  classical
  constructor
  · intro ha
    refine ⟨IsCombinationAt.holTupleAt (fun k j => Eventually.of_forall fun z =>
      differentiable_linGen d k j z) ha, ?_⟩
    obtain ⟨c, -, hca⟩ := ha
    filter_upwards [eventually_all.2 hca] with z hz hzL j
    rw [hz j]
    refine Finset.sum_eq_zero fun p _ => ?_
    have : z p.1.1 = 0 := hzL p.1.1 p.1.2
    simp [linGen, this]
  · rintro ⟨hhol, hvan⟩
    by_cases hy : y ∈ planeL d
    · -- Hadamard's lemma componentwise
      have hH : ∀ j, ∃ H : Fin (N + 1) → ConeSpace N → ℂ, (∀ i : Fin (N + 1), i.1 < d + 1 → H i = 0) ∧
          (∀ i, ∀ᶠ u in 𝓝 y, DifferentiableAt ℂ (H i) u) ∧
          ∀ᶠ u in 𝓝 y, a j u = ∑ i, u i * H i u := by
        intro j
        refine SGPT.Foundations.Analysis.Pending.CoordinatePlaneDivision.exists_eq_sum_coord_mul (N + 1 - (d + 1)) (d + 1) rfl
          (F := a j) (q := y) (fun i hi => hy i hi) (hhol j) ?_
        filter_upwards [hvan] with u hu huL
        exact hu (fun l hl => huL l hl) j
      choose H hH0 hHd hHa using hH
      refine ⟨fun p z => H p.2 p.1.1 z, fun p => hHd p.2 p.1.1, fun j => ?_⟩
      filter_upwards [hHa j] with z hz
      rw [hz]
      have hsplit : ∑ p : {l : Fin (N + 1) // d < l.1} × ι, H p.2 p.1.1 z * linGen d ι p j z =
          ∑ l : {l : Fin (N + 1) // d < l.1}, H j l.1 z * z l.1 := by
        rw [Fintype.sum_prod_type]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [Finset.sum_eq_single j]
        · simp [linGen]
        · intro j' _ hj'
          simp [linGen, Ne.symm hj']
        · simp
      rw [hsplit]
      have hsub : ∑ i : Fin (N + 1), z i * H j i z =
          ∑ l : {l : Fin (N + 1) // d < l.1}, z l.1 * H j l.1 z := by
        have h1 : ∑ i : Fin (N + 1), z i * H j i z =
            ∑ i ∈ Finset.univ.filter (fun i : Fin (N + 1) => d < i.1), z i * H j i z := by
          rw [Finset.sum_filter]
          refine Finset.sum_congr rfl fun i _ => ?_
          split_ifs with hi
          · rfl
          · rw [hH0 j i (by omega)]
            simp
        rw [h1, Finset.sum_subtype (p := fun i : Fin (N + 1) => d < i.1) _ (fun i => by simp)
          (fun i => z i * H j i z)]
      rw [hsub]
      exact Finset.sum_congr rfl fun l _ => mul_comm _ _
    · -- off `L_d` some `z_l` (`l > d`) is a unit
      simp only [planeL, mem_ofPred_eq, not_forall] at hy
      obtain ⟨l, hl, hyl⟩ := hy
      have hev : ∀ᶠ z in 𝓝 y, z l ≠ 0 :=
        (differentiable_coord l).continuous.continuousAt.eventually_ne hyl
      refine ⟨fun p z => if p.1.1 = l then a p.2 z / z l else 0, fun p => ?_, fun j => ?_⟩
      · by_cases hp : p.1.1 = l
        · simp only [hp, if_true]
          filter_upwards [hhol p.2, hev] with z hz hz'
          exact (hz.mul ((differentiable_coord l z).inv hz')).congr_of_eventuallyEq
            (Eventually.of_forall fun w => div_eq_mul_inv _ _)
        · simp only [hp, if_false]
          exact holAt_const 0 y
      · filter_upwards [hev] with z hz
        rw [Fintype.sum_prod_type, Finset.sum_eq_single ⟨l, hl⟩]
        · rw [Finset.sum_eq_single j]
          · simp [linGen, div_mul_cancel₀ _ hz]
          · intro j' _ hj'
            simp [linGen, Ne.symm hj']
          · simp
        · intro l' _ hl'
          have : l'.1 ≠ l := fun h => hl' (Subtype.ext h)
          simp [this]
        · simp

theorem isConeInvariant_Idm (d : ℕ) : IsConeInvariant (Idm (N := N) d ι) := by
  intro y _ c hc a
  have hφ : ∀ x : ConeSpace N, DifferentiableAt ℂ (fun z : ConeSpace N => c⁻¹ • z) x :=
    fun _ => differentiableAt_id.const_smul c⁻¹
  have hψ : ∀ x : ConeSpace N, DifferentiableAt ℂ (fun z : ConeSpace N => c • z) x :=
    fun _ => differentiableAt_id.const_smul c
  rw [mem_Idm_iff, mem_Idm_iff]
  constructor
  · rintro ⟨ha, hv⟩
    refine ⟨fun j => ?_, ?_⟩
    · have h : HolAt (a j) ((fun z : ConeSpace N => c⁻¹ • z) (c • y)) := by
        simpa [inv_smul_smul₀ hc] using ha j
      exact h.comp (continuous_const_smul c⁻¹) hφ
    · have ht : Tendsto (fun z : ConeSpace N => c⁻¹ • z) (𝓝 (c • y)) (𝓝 y) := by
        have := (continuous_const_smul c⁻¹).tendsto (c • y)
        rwa [inv_smul_smul₀ hc] at this
      filter_upwards [ht.eventually hv] with z hz hzL j
      exact hz (isCone_planeL d c⁻¹ (inv_ne_zero hc) z hzL) j
  · rintro ⟨ha, hv⟩
    refine ⟨fun j => ?_, ?_⟩
    · have h := HolAt.comp (ha j) (continuous_const_smul c) hψ
      refine h.congr (Eventually.of_forall fun z => ?_)
      simp [inv_smul_smul₀ hc]
    · have ht : Tendsto (fun z : ConeSpace N => c • z) (𝓝 y) (𝓝 (c • y)) :=
        (continuous_const_smul c).tendsto y
      filter_upwards [ht.eventually hv] with z hz hzL j
      have := hz (isCone_planeL d c hc z hzL) j
      simpa [inv_smul_smul₀ hc] using this

theorem Idm_le_Idm {d d' : ℕ} (h : d' ≤ d) (Ω : Set (ConeSpace N)) :
    (Idm d ι).LeOn (Idm d' ι) Ω := by
  intro y _ a ha
  rw [mem_Idm_iff] at ha ⊢
  refine ⟨ha.1, ?_⟩
  filter_upwards [ha.2] with z hz hzL
  exact hz (planeL_anti h hzL)

/-- `I_{L_N} 𝒪^ι = 0`. -/
theorem Idm_top_eqOn (Ω : Set (ConeSpace N)) : (Idm N ι).EqOn (GermModule.bot _ ι) Ω := by
  intro y _ a
  rw [mem_Idm_iff]
  constructor
  · rintro ⟨-, hv⟩ j
    filter_upwards [hv] with z hz
    exact hz (fun l hl => absurd l.2 (by omega)) j
  · intro ha
    refine ⟨(GermModule.bot_isCoherentOn univ y (mem_univ y)).holTupleAt_of_mem ha, ?_⟩
    filter_upwards [eventually_all.2 ha] with z hz _ j
    exact hz j

/-- **`z_d` is a non-zero-divisor modulo `I_{L_d}`.** -/
theorem mem_Idm_of_mem_scal {d : ℕ} (hd : d < N + 1) {y : ConeSpace N}
    {a : ι → ConeSpace N → ℂ} (ha : HolTupleAt a y)
    (h : (Idm d ι).mem y (matApply (scalMat ι ⟨d, hd⟩) a)) : (Idm d ι).mem y a := by
  rw [mem_Idm_iff] at h ⊢
  refine ⟨ha, ?_⟩
  rw [matApply_scalMat] at h
  have hev : ∀ᶠ z in 𝓝 y, (∀ j, DifferentiableAt ℂ (a j) z) ∧
      (z ∈ planeL d → ∀ j, z ⟨d, hd⟩ * a j z = 0) := (eventually_all.2 ha).and h.2
  obtain ⟨W, hW, hWo, hyW⟩ := eventually_nhds_iff.1 hev
  filter_upwards [hWo.mem_nhds hyW] with z hz hzL j
  by_cases hzd : z ⟨d, hd⟩ = 0
  · -- approximate `z` inside `L_d` by points with `z_d ≠ 0`
    set e : ConeSpace N := EuclideanSpace.single ⟨d, hd⟩ (1 : ℂ) with hedef
    have hcont : Tendsto (fun t : ℂ => z + t • e) (𝓝[≠] 0) (𝓝 z) := by
      have : Tendsto (fun t : ℂ => z + t • e) (𝓝 0) (𝓝 (z + (0 : ℂ) • e)) :=
        tendsto_const_nhds.add (tendsto_id.smul_const e)
      rw [zero_smul, add_zero] at this
      exact this.mono_left nhdsWithin_le_nhds
    have h1 : Tendsto (fun t : ℂ => a j (z + t • e)) (𝓝[≠] 0) (𝓝 (a j z)) :=
      ((hW z hz).1 j).continuousAt.tendsto.comp hcont
    have h2 : ∀ᶠ t in 𝓝[≠] (0 : ℂ), a j (z + t • e) = 0 := by
      have hmem : ∀ᶠ t in 𝓝[≠] (0 : ℂ), z + t • e ∈ W := hcont.eventually (hWo.mem_nhds hz)
      filter_upwards [hmem, self_mem_nhdsWithin] with t ht ht0
      have hL : z + t • e ∈ planeL d := by
        intro l hl
        have hne : l ≠ ⟨d, hd⟩ := fun h => by rw [h] at hl; exact lt_irrefl _ hl
        simp [hedef, hzL l hl, hne]
      have hcoord : (z + t • e) ⟨d, hd⟩ = t := by simp [hedef, hzd]
      have := (hW _ ht).2 hL j
      rw [hcoord] at this
      exact (mul_eq_zero.1 this).resolve_left ht0
    exact tendsto_nhds_unique h1 (tendsto_const_nhds.congr' (h2.mono fun t ht => ht.symm))
  · exact (mul_eq_zero.1 ((hW z hz).2 hzL j)).resolve_left hzd

/-- **`I_{L_{d-1}} = I_{L_d} + z_d 𝒪^ι`**: every germ in `I_{L_{d-1}} 𝒪^ι` is `z_d b + c` with `b`
holomorphic and `c ∈ I_{L_d} 𝒪^ι`. -/
theorem exists_split_Idm {d : ℕ} (hd : d < N + 1) {y : ConeSpace N}
    {a : ι → ConeSpace N → ℂ} (ha : (Idm (d - 1) ι).mem y a) (hd1 : 1 ≤ d) :
    ∃ b c : ι → ConeSpace N → ℂ, HolTupleAt b y ∧ (Idm d ι).mem y c ∧
      ∀ j, a j =ᶠ[𝓝 y] fun z => z ⟨d, hd⟩ * b j z + c j z := by
  classical
  rw [mem_Idm_iff] at ha
  obtain ⟨hhol, hvan⟩ := ha
  by_cases hy : y ∈ planeL (d - 1)
  · have hH : ∀ j, ∃ H : Fin (N + 1) → ConeSpace N → ℂ,
        (∀ i : Fin (N + 1), i.1 < d → H i = 0) ∧
        (∀ i, ∀ᶠ u in 𝓝 y, DifferentiableAt ℂ (H i) u) ∧
        ∀ᶠ u in 𝓝 y, a j u = ∑ i, u i * H i u := by
      intro j
      refine SGPT.Foundations.Analysis.Pending.CoordinatePlaneDivision.exists_eq_sum_coord_mul (N + 1 - d) d rfl
        (F := a j) (q := y) (fun i hi => hy i (by omega)) (hhol j) ?_
      filter_upwards [hvan] with u hu huL
      exact hu (fun l hl => huL l (by omega)) j
    choose H hH0 hHd hHa using hH
    refine ⟨fun j => H j ⟨d, hd⟩, fun j z => ∑ i ∈ Finset.univ.filter (fun i : Fin (N + 1) =>
      d < i.1), z i * H j i z, fun j => hHd j _, ?_, fun j => ?_⟩
    · rw [mem_Idm_iff]
      refine ⟨fun j => ?_, Eventually.of_forall fun z hzL j => Finset.sum_eq_zero fun i hi => ?_⟩
      · filter_upwards [eventually_all.2 (hHd j)] with u hu
        exact DifferentiableAt.fun_sum fun i _ => (differentiable_coord i u).mul (hu i)
      · rw [hzL i (Finset.mem_filter.1 hi).2, zero_mul]
    · filter_upwards [hHa j] with z hz
      rw [hz, ← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i : Fin (N + 1) => d < i.1)]
      rw [add_comm]
      congr 1
      rw [Finset.sum_eq_single ⟨d, hd⟩]
      · intro i hi hne
        have hi' : ¬d < i.1 := (Finset.mem_filter.1 hi).2
        have : i.1 < d := by
          rcases lt_or_eq_of_le (not_lt.1 hi') with h | h
          · exact h
          · exact absurd (Fin.ext h) hne
        simp [hH0 j i this]
      · intro h
        exact absurd (Finset.mem_filter.2 ⟨Finset.mem_univ (⟨d, hd⟩ : Fin (N + 1)),
          lt_irrefl d⟩) h
  · simp only [planeL, mem_ofPred_eq, not_forall] at hy
    obtain ⟨l, hl, hyl⟩ := hy
    by_cases hld : l.1 = d
    · -- `z_d` is a unit near `y`
      have hl' : l = ⟨d, hd⟩ := Fin.ext hld
      subst hl'
      have hev : ∀ᶠ z in 𝓝 y, z ⟨d, hd⟩ ≠ 0 :=
        (differentiable_coord _).continuous.continuousAt.eventually_ne hyl
      refine ⟨fun j z => a j z / z ⟨d, hd⟩, fun _ _ => 0, fun j => ?_,
        (GermModule.bot_le (idm_isCoherentOn d univ)) y (mem_univ y) _
          fun j => Eventually.of_forall fun _ => rfl, fun j => ?_⟩
      · filter_upwards [hhol j, hev] with z hz hz'
        exact (hz.mul ((differentiable_coord _ z).inv hz')).congr_of_eventuallyEq
          (Eventually.of_forall fun w => div_eq_mul_inv _ _)
      · filter_upwards [hev] with z hz
        rw [mul_div_cancel₀ _ hz, add_zero]
    · -- `y ∉ L_d`: every holomorphic germ lies in `I_{L_d}`
      have hlt : d < l.1 := by omega
      have hev : ∀ᶠ z in 𝓝 y, z l ≠ 0 :=
        (differentiable_coord _).continuous.continuousAt.eventually_ne hyl
      refine ⟨fun _ _ => 0, a, fun j => holAt_const 0 y, ?_, fun j =>
        Eventually.of_forall fun z => by simp⟩
      rw [mem_Idm_iff]
      refine ⟨hhol, ?_⟩
      filter_upwards [hev] with z hz hzL
      exact absurd (hzL l hlt) hz

/-! ### The hyperplane sequence -/

section Hyperplane

/-- The subquotient `M/I` of `𝒪^ι` on `ℂ^{N+1} ∖ 0`. -/
def mkSq (M I : GermModule (ConeSpace N) ι) (hM : M.IsCoherentOn (puncture (ConeSpace N)))
    (hI : I.IsCoherentOn (puncture (ConeSpace N))) (hle : I.LeOn M (puncture (ConeSpace N))) :
    Subquotient (ConeSpace N) (puncture (ConeSpace N)) :=
  ⟨ι, M, I, hM, hI, hle⟩

theorem IsConeInvariant.of_eqOn {P Q : GermModule (ConeSpace N) ι} (hP : IsConeInvariant P)
    (h : P.EqOn Q (puncture (ConeSpace N))) : IsConeInvariant Q := by
  intro y hy c hc a
  rw [← h y hy, ← h (c • y) (smul_ne_zero hc hy)]
  exact hP y hy c hc a

theorem Idm_isCoherentOn_puncture (d : ℕ) :
    (Idm (N := N) d ι).IsCoherentOn (puncture (ConeSpace N)) :=
  idm_isCoherentOn d _

/-- `z_e · (I_{L_d} 𝒪^ι) ⊆ I_{L_d} 𝒪^ι`. -/
theorem Idm_mem_scal {d : ℕ} (e : Fin (N + 1)) {y : ConeSpace N} {a : ι → ConeSpace N → ℂ}
    (ha : (Idm d ι).mem y a) : (Idm d ι).mem y (matApply (scalMat ι e) a) := by
  rw [matApply_scalMat]
  exact (idm_isCoherentOn d univ y (mem_univ y)).smul_mem
    (Eventually.of_forall fun z => differentiable_coord e z) ha

/-- `z_d · 𝒪^ι ⊆ I_{L_{d-1}} 𝒪^ι` (`d ≥ 1`). -/
theorem Idm_pred_mem_scal {d : ℕ} (hd : d < N + 1) (hd1 : 1 ≤ d) {y : ConeSpace N}
    {a : ι → ConeSpace N → ℂ} (ha : HolTupleAt a y) :
    (Idm (d - 1) ι).mem y (matApply (scalMat ι ⟨d, hd⟩) a) := by
  rw [mem_Idm_iff, matApply_scalMat]
  refine ⟨fun j => ?_, Eventually.of_forall fun z hz j => ?_⟩
  · filter_upwards [ha j] with z hz
    exact (differentiable_coord _ z).mul hz
  · show z ⟨d, hd⟩ * a j z = 0
    rw [hz ⟨d, hd⟩ (by simp only; omega), zero_mul]

/-- **The hyperplane sequence** for a subsheaf `M/I_{L_d}` of `𝒪_{L_d}^ι` (`1 ≤ d ≤ N`): with
`M' = M : z_d` and `M'' = M + I_{L_{d-1}}` (up to stalkwise equality, `I`, `I'` the ideal sheaves
of `L_d`, `L_{d-1}` times `𝒪^ι`), multiplication by `z_d` and the identity give a short exact
sequence `0 → M'/I (-1) → M/I → M''/I' → 0`. -/
theorem shortExact_hyperplane {d : ℕ} (hd : d < N + 1) (hd1 : 1 ≤ d)
    {M M' M'' I I' : GermModule (ConeSpace N) ι}
    (hMc : M.IsCoherentOn (puncture (ConeSpace N)))
    (hM'c : M'.IsCoherentOn (puncture (ConeSpace N)))
    (hM''c : M''.IsCoherentOn (puncture (ConeSpace N)))
    (hIc : I.IsCoherentOn (puncture (ConeSpace N)))
    (hI'c : I'.IsCoherentOn (puncture (ConeSpace N)))
    (hI : I.EqOn (Idm d ι) (puncture (ConeSpace N)))
    (hI' : I'.EqOn (Idm (d - 1) ι) (puncture (ConeSpace N)))
    (hIM : (Idm d ι).LeOn M (puncture (ConeSpace N)))
    (hM' : M'.EqOn (M.comap (scalMat ι ⟨d, hd⟩)) (puncture (ConeSpace N)))
    (hM'' : M''.EqOn (M.sup I') (puncture (ConeSpace N)))
    (h1 : I.LeOn M' (puncture (ConeSpace N))) (h2 : I.LeOn M (puncture (ConeSpace N)))
    (h3 : I'.LeOn M'' (puncture (ConeSpace N))) :
    ∃ (φ : Subquotient.Hom (mkSq M' I hM'c hIc h1) (mkSq M I hMc hIc h2))
      (ψ : Subquotient.Hom (mkSq M I hMc hIc h2) (mkSq M'' I' hM''c hI'c h3)),
      φ.A = scalMat ι ⟨d, hd⟩ ∧ ψ.A = idMatrix ι ∧ Subquotient.ShortExact φ ψ := by
  have hII' : I.LeOn I' (puncture (ConeSpace N)) := fun y hy a ha =>
    (hI' y hy a).2 (Idm_le_Idm (by omega) _ y hy a ((hI y hy a).1 ha))
  let φ : Subquotient.Hom (mkSq M' I hM'c hIc h1) (mkSq M I hMc hIc h2) :=
    ⟨scalMat ι ⟨d, hd⟩, fun x hx i j => (isHomMatrix_scalMat ⟨d, hd⟩).holAt x hx i j,
      fun y hy a ha => ((hM' y hy a).1 ha).2,
      fun y hy a ha => (hI y hy _).2 (Idm_mem_scal _ ((hI y hy a).1 ha))⟩
  let ψ : Subquotient.Hom (mkSq M I hMc hIc h2) (mkSq M'' I' hM''c hI'c h3) :=
    ⟨idMatrix ι, fun x _ i j => holAt_idMatrix x i j,
      fun y hy a ha => mem_matApply_idMatrix.2 ((hM'' y hy a).2 (GermModule.le_sup_left hI'c y hy a ha)),
      fun y hy a ha => mem_matApply_idMatrix.2 (hII' y hy a ha)⟩
  refine ⟨φ, ψ, rfl, rfl, ⟨fun y hy a => ?_, fun y hy a => ?_, fun y hy a => ?_⟩⟩
  · -- injectivity: `z_d` is a non-zero-divisor modulo `I_{L_d}`
    change (M'.mem y a ∧ HolTupleAt a y ∧ I.mem y (matApply (scalMat ι ⟨d, hd⟩) a)) ↔ I.mem y a
    constructor
    · rintro ⟨-, hhol, h⟩
      exact (hI y hy a).2 (mem_Idm_of_mem_scal hd hhol ((hI y hy _).1 h))
    · intro ha
      exact ⟨h1 y hy a ha, (hIc y hy).holTupleAt_of_mem ha,
        (hI y hy _).2 (Idm_mem_scal _ ((hI y hy a).1 ha))⟩
  · -- exactness in the middle: `I_{L_{d-1}} = I_{L_d} + z_d 𝒪^ι`
    change (M.mem y a ∧ HolTupleAt a y ∧ I'.mem y (matApply (idMatrix ι) a)) ↔
      (I.sup (M'.map (scalMat ι ⟨d, hd⟩))).mem y a
    constructor
    · rintro ⟨haM, -, haI'⟩
      obtain ⟨b, c, hb, hc, habc⟩ := exists_split_Idm hd ((hI' y hy a).1
        (mem_matApply_idMatrix.1 haI')) hd1
      have hzb : M.mem y (matApply (scalMat ι ⟨d, hd⟩) b) := by
        have hsub := (hMc y hy).sub_mem haM (hIM y hy c hc)
        refine (hMc y hy).congr_mem hsub fun j => ?_
        filter_upwards [habc j] with z hz
        rw [matApply_scalMat]
        simp only
        rw [hz]
        ring
      refine ⟨c, matApply (scalMat ι ⟨d, hd⟩) b, (hI y hy c).2 hc,
        ⟨b, (hM' y hy b).2 ⟨hb, hzb⟩, fun j => EventuallyEq.rfl⟩, fun j => ?_⟩
      filter_upwards [habc j] with z hz
      rw [matApply_scalMat]
      simp only
      rw [hz]
      ring
    · rintro ⟨b, c, hb, ⟨a', ha', hca'⟩, habc⟩
      have hbM : M.mem y b := h2 y hy b hb
      have hcM : M.mem y c := (hMc y hy).congr_mem ((hM' y hy a').1 ha').2
        fun j => (hca' j).symm
      have haM : M.mem y a := (hMc y hy).congr_mem ((hMc y hy).add_mem hbM hcM)
        fun j => (habc j).symm
      refine ⟨haM, (hMc y hy).holTupleAt_of_mem haM, mem_matApply_idMatrix.2 ?_⟩
      have hbI' : I'.mem y b := hII' y hy b hb
      have hcI' : I'.mem y c := (hI' y hy c).2 ((idm_isCoherentOn (d - 1) univ y
        (mem_univ y)).congr_mem (Idm_pred_mem_scal hd hd1 ((hM' y hy a').1 ha').1)
        fun j => (hca' j).symm)
      exact (hI'c y hy).congr_mem ((hI'c y hy).add_mem hbI' hcI') fun j => (habc j).symm
  · -- surjectivity
    change (I'.sup (M.map (idMatrix ι))).mem y a ↔ M''.mem y a
    rw [hM'' y hy a]
    constructor
    · rintro ⟨b, c, hb, ⟨a', ha', hca'⟩, habc⟩
      refine ⟨c, b, (hMc y hy).congr_mem ha' fun j => ?_, hb, fun j => ?_⟩
      · filter_upwards [hca' j] with z hz
        rw [hz, matApply_idMatrix]
      · filter_upwards [habc j] with z hz
        rw [hz, add_comm]
    · rintro ⟨b, c, hb, hc, habc⟩
      refine ⟨c, b, hc, ⟨b, hb, fun j => ?_⟩, fun j => ?_⟩
      · rw [matApply_idMatrix]
      · filter_upwards [habc j] with z hz
        rw [hz, add_comm]

end Hyperplane

end SGPT.GAGA.PN
