import SGPT.GAGA.SerreM5Base

/-!
# Serre's theorems on `ℙᴺ`: Theorems A and B, GAGA for ideals

Towards source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145), milestones M4.2--M4.3.

* `serreAB`: Theorems A and B for the classes `𝒮_d` (invariant subsheaves `M/I_{L_d}` of
  `𝒪_{L_d}^ι`), `d ≤ N`, by induction on `d`: the base case `serreA_zero`, the hyperplane step
  (`ptGen_step`, after moving points of `L_d` into `L_{d-1}` by shears, `ptGen_of_planeL`), the
  reduction to points (`serreA_of_ptGen`), and Theorem B from Theorem A (`serreB_of_serreA`).
* `serreTheoremA`: **Serre's Theorem A on `ℙᴺ`** (`SerreTheoremA N`): every `ℂ*`-invariant
  coherent `M ⊆ 𝒪^ι` on `ℂ^{N+1} ∖ 0` has `M(m)` generated by finitely many global sections for
  all `m ≫ 0`.
* `serreTheoremB`: **Serre's Theorem B on `ℙᴺ`** for coherent subsheaves `M ⊆ 𝒪^ι`:
  `Ȟ^q(K(1), M(m)) = 0` for `q ≥ 1`, `m ≫ 0`.
* `gaga_ideal`: **GAGA for coherent ideal sheaves of `𝒪_{ℙᴺ}`** (milestone M4.3), now
  unconditional: every invariant coherent ideal sheaf `I ⊆ 𝒪` on `ℂ^{N+1} ∖ 0` is generated, in
  every large degree `m`, by finitely many homogeneous polynomials of degree `m`.

Blueprint: `claude-serre-m5.tex`, nodes `claude-serre-m5:theorem-AB`, `claude-serre-m5:gaga-ideals`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {N : ℕ}

/-- **Theorems A and B for the classes `𝒮_d`**, `d ≤ N`. -/
theorem serreAB : ∀ d : ℕ, d ≤ N → SerreA N d ∧ SerreB N d
  | 0, _ => ⟨serreA_zero, serreB_of_serreA (Nat.zero_le N) serreA_zero⟩
  | d + 1, hd => by
    obtain ⟨hA, hB⟩ := serreAB d (by omega)
    have hA' : SerreA N (d + 1) := serreA_of_ptGen fun x hx hx0 =>
      ptGen_of_planeL (d := d + 1) (by omega) (by omega)
        (fun y hy hy0 => ptGen_step (d := d + 1) (by omega) (by omega) hA hB hy hy0) hx hx0
    exact ⟨hA', serreB_of_serreA hd hA'⟩

/-- `I_{L_N} 𝒪^ι` is zero on `ℂ^{N+1} ∖ 0`, so every coherent invariant `M ⊆ 𝒪^ι` is in `𝒮_N`. -/
theorem inS_top {ι : Type} [Fintype ι] [DecidableEq ι] {M : GermModule (ConeSpace N) ι}
    (hM : M.IsCoherentOn (puncture (ConeSpace N))) (hMi : IsConeInvariant M) : InS N M :=
  ⟨hM, hMi, fun y hy a ha => GermModule.bot_le hM y hy a ((Idm_top_eqOn _ y hy a).1 ha)⟩

/-- **Serre's Theorem A on `ℙᴺ`.** -/
theorem serreTheoremA : SerreTheoremA N := by
  intro ι _ _ M hM hMi
  obtain ⟨m₀, hm₀⟩ := (serreAB N le_rfl).1 ι M (inS_top hM hMi)
  refine ⟨m₀, fun m hm => ?_⟩
  obtain ⟨μ, _, σ, ⟨hσh, hσM⟩, hgen⟩ := hm₀ m hm
  refine ⟨μ, inferInstance, σ, hσh, fun k j => (hσh k).diff j, fun y hy a => ⟨fun ha => ?_,
    fun ha => (hM y hy).mem_of_isCombinationAt (fun k => hσM k y hy) ha⟩⟩
  obtain ⟨c, hc, hca⟩ := hgen y hy a ha
  have h0 := (Idm_top_eqOn (ι := ι) _ y hy _).1 hca
  exact ⟨c, hc, fun j => (h0 j).mono fun z hz => sub_eq_zero.1 hz⟩

/-- **Serre's Theorem B on `ℙᴺ`** for coherent invariant subsheaves `M ⊆ 𝒪^ι`:
`Ȟ^q(K(1), M(m)) = 0` for `q ≥ 1` and `m ≫ 0`. -/
theorem serreTheoremB {ι : Type} [Fintype ι] [DecidableEq ι] {M : GermModule (ConeSpace N) ι}
    (hM : M.IsCoherentOn (puncture (ConeSpace N))) (hMi : IsConeInvariant M) {q : ℕ}
    (hq : 1 ≤ q) : ∃ m₀ : ℤ, ∀ m ≥ m₀, Subsingleton (cechH (coverSystem
      (mkSq M (GermModule.bot _ ι) hM (GermModule.bot_isCoherentOn _) (GermModule.bot_le hM))
      m 1) q) := by
  obtain ⟨m₀, hm₀⟩ := (serreAB N le_rfl).2 q hq ι M (inS_top hM hMi)
  refine ⟨m₀, fun m hm => ?_⟩
  have hb := cechHMap_bijective_of_eqOn (M := M) (I := GermModule.bot _ ι) (M' := M)
    (I' := Idm N ι) (hM := hM) (hI := GermModule.bot_isCoherentOn _)
    (hle := GermModule.bot_le hM) (hM' := hM) (hI' := Idm_isCoherentOn_puncture N)
    (hle' := (inS_top hM hMi).le) (fun _ _ _ => Iff.rfl) Idm_N_eqOn_bot m 1 q
  have : Subsingleton (cechH (coverSystem (mkSq M (Idm N ι) hM (Idm_isCoherentOn_puncture N)
      (inS_top hM hMi).le) m 1) q) := hm₀ m hm
  exact hb.1.subsingleton

/-- **Serre's GAGA for coherent ideal sheaves of `𝒪_{ℙᴺ}`** (milestone M4.3): every
`ℂ*`-invariant coherent ideal sheaf `I ⊆ 𝒪` on `ℂ^{N+1} ∖ 0` is generated, in every large degree
`m`, by finitely many homogeneous polynomials of degree `m`. -/
theorem gaga_ideal {I : GermModule (ConeSpace N) Unit}
    (hI : I.IsCoherentOn (puncture (ConeSpace N))) (hIi : IsConeInvariant I) :
    ∃ m₀ : ℕ, ∀ m ≥ m₀, ∃ (μ : Type) (_ : Fintype μ) (P : μ → MvPolynomial (Fin (N + 1)) ℂ),
      (∀ k, (P k).IsHomogeneous m) ∧
      I.GeneratedOn (puncture (ConeSpace N)) (fun k => polyTuple (P k)) :=
  gaga_ideal_of_serreTheoremA serreTheoremA hI hIi

end SGPT.GAGA.PN
