import SGPT.GAGA.SerreM6Defs

/-!
# Serre's GAGA: push-forward of ideals to the Segre cone

Towards source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145), step G1.

For an ideal `𝓛` on `(ℂ^{K+1} ∖ 0) × ℂ`, `graphI 𝓛` is the ideal of germs `f` on `ℂ^{2K+2}` whose
restriction to the Segre cone lies in `𝓛`: `f ∘ segre ∈ 𝓛_p` at every `p` with `segre p = w`,
`p.1 ≠ 0` (no condition off the cone). `graphJ 𝓛` is the same for the chart at infinity
(composition with the exchange `swapE` of the two blocks).

* `graphI_generatedOn`: near a point with `u_i ≠ 0`, `graphI 𝓛` is generated by the generators
  of `𝓛` composed with the chart `piI i` and by the minors `segE i l` (`exists_segE_comb`);
  hence `graphI 𝓛` is coherent wherever `𝓛` is (`graphI_coherentAt`).
* `isConeInvariant_graphI`, `isConeInvariant_graphJ`: invariance under `ℂ*`.

Blueprint: `claude-serre-m6.tex`, node `claude-serre-m6:graph`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {K : ℕ}

/-- The push-forward of `𝓛` to `ℂ^{2K+2}` along the Segre map. -/
def graphI (L : GermModule (ConeSpace K × ℂ) Unit) : GermModule (SegW K) Unit :=
  ⟨fun w f => HolTupleAt f w ∧ ∀ p : ConeSpace K × ℂ, segre p = w → p.1 ≠ 0 →
    L.mem p (fun j q => f j (segre q))⟩

theorem eq_piI_of_segre {i : Fin (K + 1)} {p : ConeSpace K × ℂ} {w : SegW K}
    (hp : segre p = w) (hi : p.1 i ≠ 0) : p = piI i w := by
  rw [← hp, piI_segre hi]

theorem segre_smul (c : ℂ) (p : ConeSpace K × ℂ) : segre (c • p.1, p.2) = c • segre p := by
  unfold segre
  rw [mkW_smul]
  congr 1
  funext l
  simp [Pi.smul_apply]
  ring

theorem isOpen_chartV (i : Fin (K + 1)) {U : Set (ConeSpace K × ℂ)} (hU : IsOpen U) :
    IsOpen {w : SegW K | uC w i ≠ 0 ∧ piI i w ∈ U} := by
  refine isOpen_iff_mem_nhds.2 fun w hw => ?_
  have h1 : ∀ᶠ w' in 𝓝 w, uC w' i ≠ 0 :=
    (differentiable_uC i).continuous.continuousAt.eventually_ne hw.1
  have h2 : ∀ᶠ w' in 𝓝 w, piI i w' ∈ U :=
    (differentiableAt_piI hw.1).continuousAt.eventually (hU.mem_nhds hw.2)
  exact h1.and h2

/-- **Local generators of `graphI 𝓛`** on `{u_i ≠ 0, piI i w ∈ U}`, `U` a generation domain
of `𝓛`. -/
theorem graphI_generatedOn {L : GermModule (ConeSpace K × ℂ) Unit} (i : Fin (K + 1))
    {U : Set (ConeSpace K × ℂ)} (hU : IsOpen U) {μ : Type} [Fintype μ]
    {σ : μ → Unit → ConeSpace K × ℂ → ℂ} (hσ : L.GeneratedOn U σ) :
    (graphI L).GeneratedOn {w | uC w i ≠ 0 ∧ piI i w ∈ U}
      (Sum.elim (fun k j w => σ k j (piI i w)) (fun l (_ : Unit) w => segE i l w)) := by
  classical
  have hσhol : ∀ {w : SegW K}, uC w i ≠ 0 → piI i w ∈ U → ∀ k j,
      HolAt (fun w' => σ k j (piI i w')) w := fun hw hwU k j =>
    HolAt.comp_of_eventually (holAt_of_differentiableOn hU (hσ.1 k j) hwU)
      (eventually_differentiableAt_piI hw)
  have hgens : ∀ {w : SegW K}, uC w i ≠ 0 → piI i w ∈ U → ∀ x (j : Unit),
      HolAt ((Sum.elim (fun k j w => σ k j (piI i w)) (fun l (_ : Unit) w => segE i l w)) x j)
        w := by
    intro w hw hwU x j
    rcases x with k | l
    · exact hσhol hw hwU k j
    · exact Eventually.of_forall fun _ => (differentiable_segE i l).differentiableAt
  refine ⟨fun x j w hw => (hgens hw.1 hw.2 x j).differentiableAt.differentiableWithinAt,
    fun w hw f => ⟨fun hf => ?_, fun hf => ?_⟩⟩
  · obtain ⟨hhol, hcond⟩ := hf
    by_cases hS : ∀ l, segE i l w = 0
    · have hp : segre (piI i w) = w := segre_piI hw.1 hS
      have hp1 : (piI i w).1 ≠ 0 := fun h => hw.1 (by
        have := congrArg (fun z : ConeSpace K => z i) h
        simpa [piI, uPt_apply] using this)
      obtain ⟨c, hc, hcf⟩ := (hσ.2 _ hw.2 _).1 (hcond _ hp hp1)
      obtain ⟨C, hC, hfC⟩ := exists_segE_comb hw.1 hS (hhol ())
      refine ⟨Sum.elim (fun k w' => c k (piI i w')) C, fun x => ?_, fun j => ?_⟩
      · rcases x with k | l
        · show HolAt (fun w' => c k (piI i w')) w
          exact HolAt.comp_of_eventually (hc k) (eventually_differentiableAt_piI hw.1)
        · exact hC l
      · cases j
        filter_upwards [hfC, (differentiableAt_piI hw.1).continuousAt.eventually (hcf ())]
          with w' h1 h2
        rw [h1, Fintype.sum_sum_type]
        simp only [Sum.elim_inl, Sum.elim_inr]
        rw [h2]
    · push Not at hS
      obtain ⟨l, hl⟩ := hS
      have hEl : HolAt (fun w' => segE i l w') w :=
        Eventually.of_forall fun _ => (differentiable_segE i l).differentiableAt
      refine ⟨Sum.elim 0 (fun l' w' => if l' = l then f () w' * (segE i l w')⁻¹ else 0),
        fun x => ?_, fun j => ?_⟩
      · rcases x with k | l'
        · exact holAt_const 0 w
        · by_cases h : l' = l
          · simp only [Sum.elim_inr, h, if_true]
            exact (hhol ()).mul (hEl.inv hl)
          · simp only [Sum.elim_inr, h, if_false]
            exact holAt_const 0 w
      · cases j
        filter_upwards [hEl.continuousAt.eventually_ne hl] with w' hw'
        rw [Fintype.sum_sum_type]
        simp only [Sum.elim_inl, Sum.elim_inr, Pi.zero_apply, zero_mul, Finset.sum_const_zero,
          zero_add, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
        field_simp
  · obtain ⟨d, hd, hdf⟩ := hf
    refine ⟨Core.IsCombinationAt.holTupleAt (fun x j => hgens hw.1 hw.2 x j) ⟨d, hd, hdf⟩,
      fun p hp hp1 => ?_⟩
    have hpi : p.1 i ≠ 0 := by
      have := congrArg (fun w' => uC w' i) hp
      simp only [uC_segre] at this
      rw [this]
      exact hw.1
    have hpU : p ∈ U := by rw [eq_piI_of_segre hp hpi]; exact hw.2
    refine (hσ.2 p hpU _).2 ⟨fun k q => d (Sum.inl k) (segre q), fun k => ?_, fun j => ?_⟩
    · have h1 : HolAt (d (Sum.inl k)) (segre p) := by rw [hp]; exact hd _
      exact h1.comp differentiable_segre.continuous fun q => differentiable_segre q
    · have hev : ∀ᶠ q in 𝓝 p, q.1 i ≠ 0 :=
        ((differentiable_coord i).continuous.comp continuous_fst).continuousAt.eventually_ne hpi
      have ht : Tendsto segre (𝓝 p) (𝓝 w) := by
        rw [← hp]
        exact differentiable_segre.continuous.continuousAt
      filter_upwards [ht.eventually (hdf j), hev] with q hq hqi
      rw [hq, Fintype.sum_sum_type]
      simp only [Sum.elim_inl, Sum.elim_inr, segE_segre, mul_zero, Finset.sum_const_zero,
        add_zero, piI_segre hqi]

/-- `graphI 𝓛` is coherent at points with `u_i ≠ 0` where `𝓛` is coherent at `piI i w`. -/
theorem graphI_coherentAt {L : GermModule (ConeSpace K × ℂ) Unit} {i : Fin (K + 1)}
    {w : SegW K} (hw : uC w i ≠ 0) (hL : L.CoherentAt (piI i w)) : (graphI L).CoherentAt w := by
  obtain ⟨U, hU, hpU, μ, _, σ, hσ⟩ := hL
  exact ⟨_, isOpen_chartV i hU, ⟨hw, hpU⟩, μ ⊕ Fin (K + 1), inferInstance, _,
    graphI_generatedOn i hU hσ⟩

/-- `graphI 𝓛` is invariant under `ℂ*` when `𝓛` is invariant under `ℂ*` on the first factor. -/
theorem isConeInvariant_graphI {L : GermModule (ConeSpace K × ℂ) Unit} (hLi : IsZInvariant L) :
    IsConeInvariant (graphI L) := by
  refine isConeInvariant_of_imp fun w _ c hc f hf => ?_
  obtain ⟨hhol, hcond⟩ := hf
  refine ⟨fun j => ?_, fun p hp hp1 => ?_⟩
  · have h1 : HolAt (f j) (c⁻¹ • (c • w)) := by rw [inv_smul_smul₀ hc]; exact hhol j
    exact h1.comp (continuous_const_smul c⁻¹) fun _ => differentiableAt_id.const_smul c⁻¹
  · have hp' : segre (c⁻¹ • p.1, p.2) = w := by
      rw [segre_smul, hp, inv_smul_smul₀ hc]
    have h1 := hcond _ hp' (smul_ne_zero (inv_ne_zero hc) hp1)
    have h2 := (hLi _ (smul_ne_zero (inv_ne_zero hc) hp1) c hc _).1 h1
    have e1 : ((c • (c⁻¹ • p.1), p.2) : ConeSpace K × ℂ) = p := by simp [smul_inv_smul₀ hc]
    rw [e1] at h2
    refine (iff_of_eq (congrArg _ ?_)).1 h2
    funext j q
    show f j (segre (c⁻¹ • q.1, q.2)) = f j (c⁻¹ • segre q)
    rw [segre_smul]

/-- The push-forward along the Segre map in the chart at infinity. -/
def graphJ (L : GermModule (ConeSpace K × ℂ) Unit) : GermModule (SegW K) Unit :=
  (graphI L).comapHomeomorph swapE.toHomeomorph

theorem mem_graphJ {L : GermModule (ConeSpace K × ℂ) Unit} {w : SegW K}
    {f : Unit → SegW K → ℂ} :
    (graphJ L).mem w f ↔ (graphI L).mem (swapFun w) (fun j w' => f j (swapFun w')) :=
  Iff.rfl

theorem swapFun_smul (c : ℂ) (w : SegW K) : swapFun (c • w) = c • swapFun w :=
  swapLin.map_smul c w

theorem graphJ_coherentAt {L : GermModule (ConeSpace K × ℂ) Unit} {w : SegW K}
    (h : (graphI L).CoherentAt (swapFun w)) : (graphJ L).CoherentAt w :=
  GermModule.CoherentAt.comapHomeomorph swapE.toHomeomorph
    (fun x => by
      have h' := (swapE (K := K)).toContinuousLinearMap.differentiableAt (x := x)
      exact h')
    (fun x => by
      have h' := (swapE (K := K)).symm.toContinuousLinearMap.differentiableAt (x := x)
      exact h') h

theorem isConeInvariant_graphJ {L : GermModule (ConeSpace K × ℂ) Unit} (hLi : IsZInvariant L) :
    IsConeInvariant (graphJ L) := by
  intro w hw c hc f
  have hsw : swapFun w ≠ 0 := fun h => hw (by
    have := congrArg swapFun h
    rwa [swapFun_swapFun, show swapFun (0 : SegW K) = 0 from swapLin.map_zero] at this)
  rw [mem_graphJ, mem_graphJ, isConeInvariant_graphI hLi _ hsw c hc, swapFun_smul]
  exact iff_of_eq (congrArg _ (funext fun j => funext fun w' => by
    show f j (swapFun (c⁻¹ • w')) = f j (c⁻¹ • swapFun w')
    rw [swapFun_smul]))

end SGPT.GAGA.PN
