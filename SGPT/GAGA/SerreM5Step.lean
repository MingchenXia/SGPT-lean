import SGPT.GAGA.SerreM5Shear

/-!
# Serre's theorems on `ℙᴺ`: the hyperplane step of Theorem A

Towards source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145), milestone M4.2.

Let `1 ≤ d ≤ N`, `M/I_{L_d}` an invariant subsheaf of `𝒪_{L_d}^ι` (`InS d M`), `x ∈ L_{d-1} ∖ 0`,
`M_k = M : z_d^k`, `G_k = M_k/I_{L_d}`, `Q_k = (M_k + I_{L_{d-1}})/I_{L_{d-1}} ∈ 𝒮_{d-1}`, and assume
Theorems A and B for `𝒮_{d-1}` (`SerreA`, `SerreB`).

* `exists_chain_global`: when `Ȟ⁰(G_k(m)) → Ȟ⁰(Q_k(m))` is onto, every global section `τ` of
  `(M_k + I_{L_{d-1}})(m)` is congruent modulo `I_{L_{d-1}}` to a global section `P` of `M_k(m)`
  (lift the class of `τ`, then glue with `exists_global_lift`).
* `chain_mod`: hence, by Theorem A for `Q_k`, global sections of `M_k(m)` generate `M_k` modulo
  `I_{L_{d-1}}` at every point.
* `chain_split`, `chain_gen_top`, `chain_gen_step`: writing `I_{L_{d-1}} = I_{L_d} + z_d 𝒪`
  (`exists_split_Idm`), generation of `M_k` modulo `I_{L_d}` at `x` follows from generation of
  `M_{k+1}` in one degree less (`z_d (M : z_d^{k+1}) ⊆ M : z_d^k`), and at the stable index `k₀`
  from Nakayama's lemma (`z_d(x) = 0`).
* `ptGen_step`: every member of `𝒮_d` is generated by global sections at every point of
  `L_{d-1} ∖ 0` (for `k = 0`, after the chain injectivity `chain_injective`).

Blueprint: `claude-serre-m5.tex`, node `claude-serre-m5:step`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {N : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]

/-- **Theorem B for the class `𝒮_d`**: `Ȟ^q(K(1), (M/I_{L_d})(m)) = 0` for `q ≥ 1` and `m ≫ 0`. -/
def SerreB (N d : ℕ) : Prop :=
  ∀ q : ℕ, 1 ≤ q → ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (M : GermModule (ConeSpace N) ι)
    (hS : InS d M), ∃ m₀ : ℤ, ∀ m ≥ m₀, Subsingleton (cechH (coverSystem (sqOf hS) m 1) q)

section Step

variable {d : ℕ} (hd : d < N + 1) {M : GermModule (ConeSpace N) ι} (hS : InS d M)

/-- **Lifting global sections along `G_k → Q_k`.** -/
theorem exists_chain_global (hdN : d ≤ N) (k : ℕ) (n : ℤ) (hn : -(d : ℤ) ≤ n + 1)
    (hsurj : Function.Surjective
      (cechHMap (coverHom (chainPsi hd hS k) (chainPsi_isHom hd hS k) (n + 1) 1) 0).hom)
    {τ : ι → ConeSpace N → ℂ} (hτ : IsHomOn (puncture (ConeSpace N)) (n + 1) τ)
    (hτM : ∀ y : ConeSpace N, y ≠ 0 →
      ((satChain M ⟨d, hd⟩ k).sup (Idm (d - 1) ι)).mem y τ) :
    ∃ P : ι → ConeSpace N → ℂ, IsHomOn (puncture (ConeSpace N)) (n + 1) P ∧
      (∀ y : ConeSpace N, y ≠ 0 → (satChain M ⟨d, hd⟩ k).mem y P) ∧
      ∀ y : ConeSpace N, y ≠ 0 → (Idm (d - 1) ι).mem y (fun j z => P j z - τ j z) := by
  classical
  have hk := hS.satChain ⟨d, hd⟩ k
  have hτ0 : IsHomOn (puncture (ConeSpace N)) (n + 1 + 0) τ := by rwa [add_zero]
  have hg : ∀ i, IsHomSection (chainQ hd hS k).M (n + 1 + 0) (coverSet 1 {i}) τ := fun i =>
    ⟨puncture (ConeSpace N), coverSet_subset 1 {i}, hτ0, fun y hy => hτM y hy⟩
  have hcoc : ∀ i k', IsHomSection (chainQ hd hS k).N (n + 1 + 0) (coverSet 1 {i, k'})
      ((fun _ => τ) k' - (fun _ => τ) i) := fun i k' => by
    rw [sub_self]
    exact ⟨puncture (ConeSpace N), coverSet_subset 1 _,
      isHomOn_zero isOpen_ne isCone_ne_zero (fun _ h => h) _,
      fun y hy => (Idm_isCoherentOn_puncture (d - 1) y hy).zero_mem⟩
  obtain ⟨w, hw⟩ := hsurj (cechClass _ 0 (zeroCocycle (F := chainQ hd hS k) (fun _ => τ) hg hcoc))
  obtain ⟨u, rfl⟩ := cechClass_surjective _ 0 w
  obtain ⟨g, hg', hcoc', rfl⟩ : ∃ (g : Fin (N + 1) → ι → ConeSpace N → ℂ)
      (hg : ∀ i, IsHomSection (satChain M ⟨d, hd⟩ k) (n + 1) (coverSet 1 {i}) (g i))
      (hcoc : ∀ i k', IsHomSection (Idm d ι) (n + 1) (coverSet 1 {i, k'}) (g k' - g i)),
      zeroCocycle (F := chainG hd hS k) g hg hcoc = u := exists_eq_zeroCocycle u
  have hy' := (cechHMap_cechClass _ 0 _).symm.trans hw
  have hz := cechClass_injective_zero _ hy'
  have hcomp : ∀ i, IsHomSection (Idm (d - 1) ι) (n + 1) (coverSet 1 {i})
      (g i - τ) := by
    intro i
    have hi := congrArg (fun t : LinearMap.ker (cechDq (coverSystem (chainQ hd hS k)
      (n + 1 + 0) 1) 0) => t.1.1 {i}) hz
    have hi' : (coverHom (chainPsi hd hS k) (chainPsi_isHom hd hS k) (n + 1) 1).app {i}
        (sectionMk (chainG hd hS k) ⟨g i, hg' i⟩) = sectionMk (chainQ hd hS k) ⟨τ, hg i⟩ := by
      rw [← zeroCocycle_singleton (F := chainG hd hS k) g hg' hcoc' i,
        ← zeroCocycle_singleton (F := chainQ hd hS k) (fun _ => τ) hg hcoc i]
      exact hi
    have h2 := (sectionMk_eq_iff (chainQ hd hS k) ⟨matLin (idMatrix ι) (g i), _⟩
      ⟨τ, hg i⟩).1 hi'
    change IsHomSection (Idm (d - 1) ι) (n + 1 + 0) (coverSet 1 {i})
      (matLin (idMatrix ι) (g i) - τ) at h2
    rw [matLin_idMatrix_one, add_zero] at h2
    exact h2
  obtain ⟨P, hP, hPM, hPg⟩ := exists_global_lift (ρ := 1) le_rfl hdN hk.coh hk.le hn g hg' hcoc'
  refine ⟨P, hP, hPM, fun y hy => ?_⟩
  obtain ⟨i, hyi⟩ := exists_mem_coverSet le_rfl hy
  obtain ⟨U, hKU, -, hU⟩ := hPg i
  obtain ⟨V, hKV, -, hV⟩ := hcomp i
  have hI := Idm_isCoherentOn_puncture (N := N) (ι := ι) (d - 1) y hy
  have h1 := Idm_le_Idm (Nat.sub_le d 1) (puncture (ConeSpace N)) y hy _ (hU y (hKU hyi))
  have h2 := hV y (hKV hyi)
  refine hI.congr_mem (hI.add_mem h1 h2) fun j => Eventually.of_forall fun z => ?_
  simp only [Pi.sub_apply]
  ring

/-- **Generation modulo `I_{L_{d-1}}`** of `M_k` by global sections of `M_k(n+1)`, from Theorem A
for `Q_k` and the surjectivity on `Ȟ⁰`. -/
theorem chain_mod (hdN : d ≤ N) (k : ℕ) (n : ℤ) (hn : -(d : ℤ) ≤ n + 1)
    (hsurj : Function.Surjective
      (cechHMap (coverHom (chainPsi hd hS k) (chainPsi_isHom hd hS k) (n + 1) 1) 0).hom)
    (hA : GenOn ((satChain M ⟨d, hd⟩ k).sup (Idm (d - 1) ι)) (Idm (d - 1) ι) (n + 1)
      (puncture (ConeSpace N))) :
    ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → ConeSpace N → ℂ),
      GlobSec (satChain M ⟨d, hd⟩ k) (n + 1) σ ∧
      ∀ y : ConeSpace N, y ≠ 0 → GenAt (satChain M ⟨d, hd⟩ k) (Idm (d - 1) ι) σ y := by
  classical
  obtain ⟨μ, _, τ, ⟨hτh, hτM⟩, hgen⟩ := hA
  choose P hP hPM hPτ using fun l => exists_chain_global hd hS hdN k n hn hsurj (hτh l) (hτM l)
  refine ⟨μ, inferInstance, P, ⟨hP, hPM⟩, fun y hy a ha => ?_⟩
  have hk := hS.satChain ⟨d, hd⟩ k
  obtain ⟨c, hc, hca⟩ := hgen y hy a
    (GermModule.le_sup_left (Idm_isCoherentOn_puncture _) y hy a ha)
  have hI := Idm_isCoherentOn_puncture (N := N) (ι := ι) (d - 1) y hy
  have hsum : (Idm (d - 1) ι).mem y
      (fun j z => ∑ l ∈ Finset.univ, (fun j z => c l z * (P l j z - τ l j z)) j z) :=
    hI.finset_sum_mem Finset.univ fun l _ => hI.smul_mem (hc l) (hPτ l y hy)
  refine ⟨c, hc, hI.congr_mem (hI.sub_mem hca hsum) fun j => Eventually.of_forall fun z => ?_⟩
  simp only [mul_sub, Finset.sum_sub_distrib]
  ring

include hS in
/-- One step of the descent: an element of `M_k` is a combination of the generators modulo
`I_{L_d} + z_d M_{k+1}`. -/
theorem chain_split (hd1 : 1 ≤ d) (k : ℕ) {x : ConeSpace N} (hx0 : x ≠ 0) {m : ℤ} {μ : Type}
    [Fintype μ] {σ : μ → ι → ConeSpace N → ℂ} (hσ : GlobSec (satChain M ⟨d, hd⟩ k) m σ)
    (hgen : GenAt (satChain M ⟨d, hd⟩ k) (Idm (d - 1) ι) σ x) {a : ι → ConeSpace N → ℂ}
    (ha : (satChain M ⟨d, hd⟩ k).mem x a) :
    ∃ (c : μ → ConeSpace N → ℂ) (b c' : ι → ConeSpace N → ℂ), (∀ l, HolAt (c l) x) ∧
      (satChain M ⟨d, hd⟩ (k + 1)).mem x b ∧ (Idm d ι).mem x c' ∧
      ∀ j, a j =ᶠ[𝓝 x] fun z => ∑ l, c l z * σ l j z + c' j z + z ⟨d, hd⟩ * b j z := by
  have hk := hS.satChain ⟨d, hd⟩ k
  have hMx := hk.coh x hx0
  obtain ⟨c, hc, hw⟩ := hgen a ha
  obtain ⟨b, c', hb, hc', hwb⟩ := exists_split_Idm hd hw hd1
  have hsum : (satChain M ⟨d, hd⟩ k).mem x
      (fun j z => ∑ l ∈ Finset.univ, (fun j z => c l z * σ l j z) j z) :=
    hMx.finset_sum_mem Finset.univ fun l _ => hMx.smul_mem (hc l) (hσ.2 l x hx0)
  have hw' := hMx.sub_mem ha hsum
  have hc'M : (satChain M ⟨d, hd⟩ k).mem x c' := hk.le x hx0 c' hc'
  have hzb : (satChain M ⟨d, hd⟩ k).mem x (fun j z => z ⟨d, hd⟩ * b j z) := by
    refine hMx.congr_mem (hMx.sub_mem hw' hc'M) fun j => ?_
    filter_upwards [hwb j] with z hz
    linear_combination hz
  refine ⟨c, b, c', hc, ⟨hb, ?_⟩, hc', fun j => ?_⟩
  · rw [matApply_scalMat]
    exact hzb
  · filter_upwards [hwb j] with z hz
    linear_combination hz

include hS in
/-- **The stable index**: Nakayama's lemma. -/
theorem chain_gen_top (hd1 : 1 ≤ d) {k₀ : ℕ}
    (hstab : (satChain M ⟨d, hd⟩ (k₀ + 1)).EqOn (satChain M ⟨d, hd⟩ k₀)
      (puncture (ConeSpace N)))
    {x : ConeSpace N} (hx : x ∈ planeL (d - 1)) (hx0 : x ≠ 0) {m : ℤ} {μ : Type} [Fintype μ]
    {σ : μ → ι → ConeSpace N → ℂ} (hσ : GlobSec (satChain M ⟨d, hd⟩ k₀) m σ)
    (hgen : GenAt (satChain M ⟨d, hd⟩ k₀) (Idm (d - 1) ι) σ x) :
    GenAt (satChain M ⟨d, hd⟩ k₀) (Idm d ι) σ x := by
  have hk := hS.satChain ⟨d, hd⟩ k₀
  have hxe : x ⟨d, hd⟩ = 0 := hx ⟨d, hd⟩ (by show d - 1 < d; omega)
  refine generation_nakayama (hk.coh x hx0) (Idm_isCoherentOn_puncture d x hx0)
    (h := fun z => z ⟨d, hd⟩) (Eventually.of_forall fun z => differentiable_coord _ z) hxe
    (fun l => hσ.2 l x hx0) fun a ha => ?_
  obtain ⟨c, b, c', hc, hb, hc', heq⟩ := chain_split hd hS hd1 k₀ hx0 hσ hgen ha
  exact ⟨c, c', b, hc, hc', (hstab x hx0 b).1 hb, heq⟩

include hS in
/-- **The descent**: generation of `M_{k+1}` in degree `m - 1` and of `M_k` modulo
`I_{L_{d-1}}` in degree `m` give generation of `M_k` in degree `m`. -/
theorem chain_gen_step (hd1 : 1 ≤ d) (k : ℕ) {x : ConeSpace N} (hx0 : x ≠ 0) {m : ℤ}
    {μ ν : Type} [Fintype μ] [Fintype ν] {σ : μ → ι → ConeSpace N → ℂ}
    {σ' : ν → ι → ConeSpace N → ℂ} (hσ : GlobSec (satChain M ⟨d, hd⟩ k) m σ)
    (hgen : GenAt (satChain M ⟨d, hd⟩ k) (Idm (d - 1) ι) σ x)
    (hσ' : GlobSec (satChain M ⟨d, hd⟩ (k + 1)) (m - 1) σ')
    (hgen' : GenAt (satChain M ⟨d, hd⟩ (k + 1)) (Idm d ι) σ' x) :
    GlobSec (satChain M ⟨d, hd⟩ k) m (Sum.elim σ fun l j z => z ⟨d, hd⟩ * σ' l j z) ∧
      GenAt (satChain M ⟨d, hd⟩ k) (Idm d ι) (Sum.elim σ fun l j z => z ⟨d, hd⟩ * σ' l j z) x := by
  refine ⟨⟨fun p => ?_, fun p y hy => ?_⟩, fun a ha => ?_⟩
  · rcases p with l | l
    · exact hσ.1 l
    · have := (hσ'.1 l).matApply (isHomMatrix_scalMat (ι := ι) ⟨d, hd⟩)
      rw [matApply_scalMat, sub_add_cancel] at this
      exact this
  · rcases p with l | l
    · exact hσ.2 l y hy
    · have := (hσ'.2 l y hy).2
      rw [matApply_scalMat] at this
      exact this
  · obtain ⟨c, b, c', hc, hb, hc', heq⟩ := chain_split hd hS hd1 k hx0 hσ hgen ha
    obtain ⟨c'', hc'', hb'⟩ := hgen' b hb
    refine ⟨Sum.elim c c'', fun p => ?_, ?_⟩
    · rcases p with l | l
      · exact hc l
      · exact hc'' l
    have hI := Idm_isCoherentOn_puncture (N := N) (ι := ι) d x hx0
    have h2 := Idm_mem_scal ⟨d, hd⟩ hb'
    rw [matApply_scalMat] at h2
    refine hI.congr_mem (hI.add_mem hc' h2) fun j => ?_
    filter_upwards [heq j] with z hz
    simp only [Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]
    have hs : ∑ l, c'' l z * (z ⟨d, hd⟩ * σ' l j z) =
        z ⟨d, hd⟩ * ∑ l, c'' l z * σ' l j z := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun l _ => by ring
    rw [hs, hz]
    ring

/-- Generation of `M_k` modulo `I_{L_d}` at `x` in one degree. -/
def GenK (k : ℕ) (x : ConeSpace N) (m : ℤ) : Prop :=
  ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → ConeSpace N → ℂ),
    GlobSec (satChain M ⟨d, hd⟩ k) m σ ∧ GenAt (satChain M ⟨d, hd⟩ k) (Idm d ι) σ x

end Step

/-- **The hyperplane step of Theorem A**: Theorems A and B for `𝒮_{d-1}` give generation of
every member of `𝒮_d` at every point of `L_{d-1} ∖ 0`. -/
theorem ptGen_step {d : ℕ} (hd : d < N + 1) (hd1 : 1 ≤ d) (hA : SerreA N (d - 1))
    (hB : SerreB N (d - 1)) {x : ConeSpace N} (hx : x ∈ planeL (d - 1)) (hx0 : x ≠ 0) :
    PtGen N d x := by
  intro ι _ _ M hS
  classical
  have hdN : d ≤ N := by omega
  obtain ⟨k₀, hk₀⟩ := exists_satChain_stable ⟨d, hd⟩ hS.coh hS.inv
  have hstab := hk₀ (k₀ + 1) (Nat.le_succ k₀)
  obtain ⟨n₂, hn₂⟩ := chain_injective hd hS hd1 hdN hstab fun k =>
    hB 1 le_rfl ι _ (hS.satChain ⟨d, hd⟩ k).sup_pred
  choose mA hmA using fun k => hA ι _ (hS.satChain ⟨d, hd⟩ k).sup_pred
  -- generation modulo `I_{L_{d-1}}` in large degrees
  have hmod : ∀ k ≤ k₀, ∀ n : ℤ, max n₂ (max (mA k - 1) (-(d : ℤ) - 1)) ≤ n →
      ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → ConeSpace N → ℂ),
        GlobSec (satChain M ⟨d, hd⟩ k) (n + 1) σ ∧
        GenAt (satChain M ⟨d, hd⟩ k) (Idm (d - 1) ι) σ x := by
    intro k hk n hn
    obtain ⟨μ, _, σ, hσ, hgen⟩ := chain_mod hd hS hdN k n (by omega)
      (chain_H0_surjective hd hS hd1 k n (hn₂ k hk n (by omega)))
      (hmA k (n + 1) (by omega))
    exact ⟨μ, inferInstance, σ, hσ, hgen x hx0⟩
  -- the descent from `k₀` to `0`
  have hdesc : ∀ i k, k + i = k₀ → ∃ B : ℤ, ∀ m ≥ B, GenK hd (M := M) k x m := by
    intro i
    induction i with
    | zero =>
      intro k hk
      refine ⟨max n₂ (max (mA k - 1) (-(d : ℤ) - 1)) + 1, fun m hm => ?_⟩
      obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by ring⟩
      obtain ⟨μ, _, σ, hσ, hgen⟩ := hmod k (by omega) n (by omega)
      have hk' : k = k₀ := by omega
      subst hk'
      exact ⟨μ, inferInstance, σ, hσ, chain_gen_top hd hS hd1 hstab hx hx0 hσ hgen⟩
    | succ i ih =>
      intro k hk
      obtain ⟨B, hB'⟩ := ih (k + 1) (by omega)
      refine ⟨max (max n₂ (max (mA k - 1) (-(d : ℤ) - 1)) + 1) (B + 1), fun m hm => ?_⟩
      obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by ring⟩
      obtain ⟨μ, _, σ, hσ, hgen⟩ := hmod k (by omega) n (by omega)
      obtain ⟨ν, _, σ', hσ', hgen'⟩ := hB' (n + 1 - 1) (by omega)
      obtain ⟨h1, h2⟩ := chain_gen_step hd hS hd1 k hx0 hσ hgen hσ' hgen'
      exact ⟨μ ⊕ ν, inferInstance, _, h1, h2⟩
  obtain ⟨B, hB'⟩ := hdesc k₀ 0 (by omega)
  obtain ⟨μ, _, σ, hσ, hgen⟩ := hB' B le_rfl
  exact ⟨B, μ, inferInstance, σ, hσ, fun y hy => (Set.mem_singleton_iff.1 hy) ▸ hgen⟩

end SGPT.GAGA.PN
