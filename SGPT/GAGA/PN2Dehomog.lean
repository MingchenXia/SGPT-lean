/-! ### The affine statement requested from SERRE-CORE2 -/

/-- **Theorem B in degree one on `L ⊆ ℂ^M`, affine form** (the statement requested from lane
SERRE-CORE2 for the compact Reinhardt Laurent polyhedra `L`). Let `P ⊆ 𝒪^κ`, `Q ⊆ 𝒪^ι` be
coherent on an open `W ⊇ L` and `A` a `κ × ι` matrix of functions holomorphic on `W`. If `b` is
holomorphic on an open `U ⊇ L` with germs in `P + A(Q)` at every point of `U`, then there are
an open `V ⊇ L` and `p`, `a` holomorphic on `V` with germs in `P`, resp. `Q`, at every point of
`V`, such that `b = p + A a` on `V`. -/
def AffineSectionsDecompose {M : ℕ} (L : Set (EuclideanSpace ℂ (Fin M))) : Prop :=
  ∀ (κ ι : Type) [Fintype κ] [Fintype ι] (P : GermModule (EuclideanSpace ℂ (Fin M)) κ)
    (Q : GermModule (EuclideanSpace ℂ (Fin M)) ι) (W : Set (EuclideanSpace ℂ (Fin M))),
    IsOpen W → L ⊆ W → P.IsCoherentOn W → Q.IsCoherentOn W →
    ∀ A : κ → ι → EuclideanSpace ℂ (Fin M) → ℂ, (∀ k l, DifferentiableOn ℂ (A k l) W) →
    ∀ (b : κ → EuclideanSpace ℂ (Fin M) → ℂ) (U : Set (EuclideanSpace ℂ (Fin M))),
      IsOpen U → L ⊆ U → (∀ j, DifferentiableOn ℂ (b j) U) →
      (∀ y ∈ U, (P.sup (Q.map A)).mem y b) →
      ∃ (p : κ → EuclideanSpace ℂ (Fin M) → ℂ) (a : ι → EuclideanSpace ℂ (Fin M) → ℂ)
        (V : Set (EuclideanSpace ℂ (Fin M))), IsOpen V ∧ L ⊆ V ∧
        (∀ j, DifferentiableOn ℂ (p j) V) ∧ (∀ l, DifferentiableOn ℂ (a l) V) ∧
        (∀ y ∈ V, P.mem y p ∧ Q.mem y a) ∧ ∀ y ∈ V, ∀ j, b j y = p j y + matApply A a j y

/-! ### The affine chart and dehomogenization -/

variable {N : ℕ}

/-- The affine chart `ℂ^N → ℂ^{N+1}`, `w ↦ (w_0, …, 1, …, w_{N-1})` with `1` in place `i`. -/
def chart (i : Fin (N + 1)) (w : EuclideanSpace ℂ (Fin N)) : ConeSpace N :=
  WithLp.toLp 2 (Fin.insertNth i (1 : ℂ) fun m => w m)

/-- Dehomogenization `z ↦ (z_{i.succAbove m} / z_i)_m`. -/
def dehom (i : Fin (N + 1)) (z : ConeSpace N) : EuclideanSpace ℂ (Fin N) :=
  WithLp.toLp 2 fun m => z (i.succAbove m) / z i

section Chart

variable (i : Fin (N + 1))

@[simp] theorem chart_apply_self (w : EuclideanSpace ℂ (Fin N)) : chart i w i = 1 := by
  simp [chart]

@[simp] theorem chart_apply_succAbove (w : EuclideanSpace ℂ (Fin N)) (m : Fin N) :
    chart i w (i.succAbove m) = w m := by
  simp [chart]

@[simp] theorem dehom_apply (z : ConeSpace N) (m : Fin N) :
    dehom i z m = z (i.succAbove m) / z i :=
  rfl

theorem dehom_chart (w : EuclideanSpace ℂ (Fin N)) : dehom i (chart i w) = w := by
  ext m
  simp

theorem chart_dehom {z : ConeSpace N} (hz : z i ≠ 0) : chart i (dehom i z) = (z i)⁻¹ • z := by
  ext j
  rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨m, rfl⟩
  · simp [hz]
  · simp [div_eq_inv_mul]

theorem dehom_smul {c : ℂ} (hc : c ≠ 0) (z : ConeSpace N) : dehom i (c • z) = dehom i z := by
  ext m
  simp only [dehom_apply, PiLp.smul_apply, smul_eq_mul]
  exact mul_div_mul_left _ _ hc

theorem chart_ne_zero (w : EuclideanSpace ℂ (Fin N)) : chart i w ≠ 0 := by
  intro h
  have := chart_apply_self i w
  rw [h] at this
  simp at this

/-- The linear part of the chart. -/
def chartL : EuclideanSpace ℂ (Fin N) →L[ℂ] ConeSpace N :=
  LinearMap.toContinuousLinearMap
    { toFun := fun w => WithLp.toLp 2 (Fin.insertNth i (0 : ℂ) fun m => w m)
      map_add' := fun w w' => by
        ext j
        rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨m, rfl⟩ <;> simp
      map_smul' := fun c w => by
        ext j
        rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨m, rfl⟩ <;> simp }

theorem chart_eq (w : EuclideanSpace ℂ (Fin N)) :
    chart i w = EuclideanSpace.single i 1 + chartL i w := by
  ext j
  rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨m, rfl⟩
  · simp [chartL]
  · simp [chartL, Fin.succAbove_ne]

theorem differentiable_chart : Differentiable ℂ (chart (N := N) i) := by
  have h : chart (N := N) i = fun w => EuclideanSpace.single i 1 + chartL i w :=
    funext (chart_eq i)
  rw [h]
  exact (differentiable_const _).add (chartL i).differentiable

theorem continuous_chart : Continuous (chart (N := N) i) :=
  (differentiable_chart i).continuous

/-- Forgetting the coordinate `i`. -/
def dropL : ConeSpace N →L[ℂ] EuclideanSpace ℂ (Fin N) :=
  LinearMap.toContinuousLinearMap
    { toFun := fun z => WithLp.toLp 2 fun m => z (i.succAbove m)
      map_add' := fun z z' => by
        ext m
        simp
      map_smul' := fun c z => by
        ext m
        simp }

theorem dehom_eq : dehom (N := N) i = fun z => (z i)⁻¹ • dropL i z := by
  funext z
  ext m
  simp [dropL, div_eq_inv_mul]

theorem differentiableAt_dehom {z : ConeSpace N} (hz : z i ≠ 0) :
    DifferentiableAt ℂ (dehom i) z := by
  rw [dehom_eq]
  exact (((EuclideanSpace.proj i : ConeSpace N →L[ℂ] ℂ).differentiableAt).inv hz).smul
    (dropL i).differentiableAt

theorem tendsto_dehom_chart (w : EuclideanSpace ℂ (Fin N)) :
    Tendsto (dehom i) (𝓝 (chart i w)) (𝓝 w) := by
  have h := (differentiableAt_dehom i (by simp : chart i w i ≠ 0)).continuousAt.tendsto
  rwa [dehom_chart] at h

theorem eventually_coord_ne_zero {y : ConeSpace N} (hy : y i ≠ 0) : ∀ᶠ z in 𝓝 y, z i ≠ 0 :=
  ((EuclideanSpace.proj i : ConeSpace N →L[ℂ] ℂ).continuous.continuousAt).eventually_ne hy

theorem isOpen_coord_ne_zero : IsOpen {z : ConeSpace N | z i ≠ 0} :=
  isOpen_ne_fun (EuclideanSpace.proj i : ConeSpace N →L[ℂ] ℂ).continuous continuous_const

/-- The sets `L_s = chart i ⁻¹' K_s` (`i ∈ s`) are compact: in chart coordinates
`L_s = {w : |w_m| ≤ ρ, |w_m| ≤ ρ |w_{m'}| for i.succAbove m' ∈ s}`. -/
theorem isCompact_chart_preimage_coverSet {ρ : ℝ} {s : Finset (Fin (N + 1))} (hi : i ∈ s) :
    IsCompact (chart i ⁻¹' coverSet ρ s) := by
  have hcl : IsClosed (chart i ⁻¹' coverSet ρ s) := by
    obtain ⟨C, hC, hCs⟩ := isClosed_coverSet_inter ρ s
    have : chart i ⁻¹' coverSet ρ s = chart i ⁻¹' C := by
      ext w
      simp only [mem_preimage, hCs, mem_inter_iff]
      exact and_iff_left (chart_ne_zero i w)
    rw [this]
    exact hC.preimage (continuous_chart i)
  have hbox : IsCompact {w : EuclideanSpace ℂ (Fin N) | ∀ m, w m ∈ closedBall (0 : ℂ) |ρ|} := by
    have h : IsCompact ((EuclideanSpace.equiv (Fin N) ℂ).toHomeomorph ⁻¹'
        (Set.univ.pi fun _ => closedBall (0 : ℂ) |ρ|)) :=
      (EuclideanSpace.equiv (Fin N) ℂ).toHomeomorph.isCompact_preimage.2
        (isCompact_univ_pi fun _ => isCompact_closedBall 0 |ρ|)
    convert h using 1
    ext w
    simp
  refine hbox.of_isClosed_subset hcl fun w hw m => ?_
  have h := hw.2 i hi (i.succAbove m)
  rw [chart_apply_succAbove, chart_apply_self, norm_one, mul_one] at h
  exact mem_closedBall_zero_iff.2 (h.trans (le_abs_self ρ))

end Chart

/-! ### Modules on the chart -/

section Pull

variable {κ ι : Type} [Fintype κ] [Fintype ι]

/-- The module on the chart `z_i = 1`: `a ∈ (pullChart i P)_w` iff the germ of `a ∘ dehom i` at
`chart i w` lies in `P`. -/
def pullChart (i : Fin (N + 1)) (P : GermModule (ConeSpace N) κ) :
    GermModule (EuclideanSpace ℂ (Fin N)) κ :=
  ⟨fun w a => P.mem (chart i w) fun j z => a j (dehom i z)⟩

theorem holAt_comp_dehom (i : Fin (N + 1)) {f : EuclideanSpace ℂ (Fin N) → ℂ}
    {w : EuclideanSpace ℂ (Fin N)} (hf : HolAt f w) :
    HolAt (fun z => f (dehom i z)) (chart i w) := by
  filter_upwards [(tendsto_dehom_chart i w).eventually hf,
    eventually_coord_ne_zero i (by simp : chart i w i ≠ 0)] with z hz hzi
  exact hz.comp z (differentiableAt_dehom i hzi)

theorem holAt_comp_chart (i : Fin (N + 1)) {f : ConeSpace N → ℂ}
    {w : EuclideanSpace ℂ (Fin N)} (hf : HolAt f (chart i w)) :
    HolAt (fun v => f (chart i v)) w :=
  hf.comp (continuous_chart i) fun v => differentiable_chart i v

/-- `σ ∈ P_{chart w}` implies `σ ∘ chart ∈ (pullChart P)_w` (key lemma). -/
theorem mem_pullChart_comp_chart {P : GermModule (ConeSpace N) κ}
    (hP : P.IsCoherentOn (puncture (ConeSpace N))) (hinv : IsConeInvariant P)
    (i : Fin (N + 1)) {w : EuclideanSpace ℂ (Fin N)} {σ : κ → ConeSpace N → ℂ}
    (hσ : P.mem (chart i w) σ) : (pullChart i P).mem w fun j v => σ j (chart i v) := by
  have h := mem_comp_inv_coord_smul hP hinv (chart_apply_self i w) hσ
  show P.mem (chart i w) fun j z => σ j (chart i (dehom i z))
  refine (hP _ (chart_ne_zero i w)).congr_mem h fun j => ?_
  filter_upwards [eventually_coord_ne_zero i (by simp : chart i w i ≠ 0)] with z hz
  show σ j ((z i)⁻¹ • z) = σ j (chart i (dehom i z))
  rw [chart_dehom i hz]

/-- **Coherence on the chart.** -/
theorem isCoherentOn_pullChart {P : GermModule (ConeSpace N) κ}
    (hP : P.IsCoherentOn (puncture (ConeSpace N))) (hinv : IsConeInvariant P)
    (i : Fin (N + 1)) : (pullChart i P).IsCoherentOn univ := by
  intro w _
  obtain ⟨U, hU, hwU, μ, _, τ, hτ⟩ := hP (chart i w) (chart_ne_zero i w)
  refine ⟨chart i ⁻¹' U, hU.preimage (continuous_chart i), hwU, μ, inferInstance,
    fun k j v => τ k j (chart i v), ⟨fun k j => ?_, fun v hv a => ?_⟩⟩
  · exact (hτ.1 k j).comp (differentiable_chart i).differentiableOn fun v hv => hv
  constructor
  · intro ha
    obtain ⟨c, hc, hca⟩ := (hτ.2 _ hv _).1 ha
    refine ⟨fun k v => c k (chart i v), fun k => holAt_comp_chart i (hc k), fun j => ?_⟩
    have h := (continuous_chart i).continuousAt.tendsto.eventually (hca j)
    refine h.mono fun v hv' => ?_
    simpa [dehom_chart] using hv'
  · rintro ⟨g, hg, hga⟩
    have hmem : ∀ k, P.mem (chart i v) fun j z => τ k j ((z i)⁻¹ • z) := fun k =>
      mem_comp_inv_coord_smul hP hinv (chart_apply_self i v) (hτ.gen_mem hv k)
    refine (hP _ (chart_ne_zero i v)).mem_of_isCombinationAt hmem
      ⟨fun k z => g k (dehom i z), fun k => holAt_comp_dehom i (hg k), fun j => ?_⟩
    filter_upwards [(tendsto_dehom_chart i v).eventually (hga j),
      eventually_coord_ne_zero i (by simp : chart i v i ≠ 0)] with z hz hzi
    show a j (dehom i z) = ∑ k, g k (dehom i z) * τ k j ((z i)⁻¹ • z)
    rw [hz]
    simp only [chart_dehom i hzi]

/-- **Sums and images on the chart.** If `b ∈ (P + A(Q))_{chart w}`, then
`b ∘ chart ∈ (pullChart P + (A ∘ chart)(pullChart Q))_w`. -/
theorem pullChart_sup_map {P : GermModule (ConeSpace N) κ} {Q : GermModule (ConeSpace N) ι}
    (hP : P.IsCoherentOn (puncture (ConeSpace N))) (hQ : Q.IsCoherentOn (puncture (ConeSpace N)))
    (hPi : IsConeInvariant P) (hQi : IsConeInvariant Q) (i : Fin (N + 1))
    {A : κ → ι → ConeSpace N → ℂ} {w : EuclideanSpace ℂ (Fin N)} {b : κ → ConeSpace N → ℂ}
    (hb : (P.sup (Q.map A)).mem (chart i w) b) :
    ((pullChart i P).sup ((pullChart i Q).map fun k l v => A k l (chart i v))).mem w
      fun j v => b j (chart i v) := by
  obtain ⟨p, q, hp, ⟨a, ha, hqa⟩, hbpq⟩ := hb
  have ht := (continuous_chart i).tendsto w
  refine ⟨fun j v => p j (chart i v), fun j v => q j (chart i v),
    mem_pullChart_comp_chart hP hPi i hp,
    ⟨fun l v => a l (chart i v), mem_pullChart_comp_chart hQ hQi i ha, fun k => ?_⟩,
    fun j => ht.eventually (hbpq j)⟩
  exact (ht.eventually (hqa k)).mono fun v hv => by simpa [matApply] using hv

end Pull

/-! ### Theorem B on `K_s` from the affine statement -/

/-- **Theorem B (degree one) on `K_s` from the affine statement** (plan node PN5): if `i ∈ s`
and `AffineSectionsDecompose (chart i ⁻¹' K_s)` holds, then `K_s` satisfies
`SectionsDecompose`. -/
theorem sectionsDecompose_coverSet {ρ : ℝ} {s : Finset (Fin (N + 1))} {i : Fin (N + 1)}
    (hi : i ∈ s) (hB : AffineSectionsDecompose (chart i ⁻¹' coverSet ρ s)) :
    SectionsDecompose (coverSet ρ s) := by
  intro κ ι _ _ P Q hP hQ hPi hQi A d n hA b hb
  obtain ⟨Ub, hKUb, hUb, hbmem⟩ := hb
  set A' : κ → ι → EuclideanSpace ℂ (Fin N) → ℂ := fun k l v => A k l (chart i v) with hA'def
  have hA' : ∀ k l, DifferentiableOn ℂ (A' k l) univ := fun k l v _ =>
    ((hA.holAt _ (chart_ne_zero i v) k l).differentiableAt.comp v
      (differentiable_chart i v)).differentiableWithinAt
  set b' : κ → EuclideanSpace ℂ (Fin N) → ℂ := fun j v => b j (chart i v) with hb'def
  have hUb' : IsOpen (chart i ⁻¹' Ub) := hUb.isOpen.preimage (continuous_chart i)
  have hb'diff : ∀ j, DifferentiableOn ℂ (b' j) (chart i ⁻¹' Ub) := fun j =>
    (hUb.diff j).comp (differentiable_chart i).differentiableOn fun v hv => hv
  have hb'mem : ∀ v ∈ chart i ⁻¹' Ub, ((pullChart i P).sup ((pullChart i Q).map A')).mem v b' :=
    fun v hv => pullChart_sup_map hP hQ hPi hQi i (hbmem _ hv)
  obtain ⟨p', a', V, hV, hLV, hp'd, ha'd, hmemV, heqV⟩ :=
    hB κ ι (pullChart i P) (pullChart i Q) univ isOpen_univ (subset_univ _)
      (isCoherentOn_pullChart hP hPi i) (isCoherentOn_pullChart hQ hQi i) A' hA' b'
      (chart i ⁻¹' Ub) hUb' (fun v hv => hKUb hv) hb'diff hb'mem
  -- the rehomogenized sections
  set Vc : Set (ConeSpace N) := {z | z i ≠ 0} ∩ dehom i ⁻¹' V with hVcdef
  have hVco : IsOpen Vc :=
    ContinuousOn.isOpen_inter_preimage (fun z hz => (differentiableAt_dehom i hz).continuousAt
      |>.continuousWithinAt) (isOpen_coord_ne_zero i) hV
  have hVcc : IsCone Vc := by
    intro c hc z hz
    refine ⟨?_, ?_⟩
    · simp only [mem_ofPred_eq, PiLp.smul_apply, smul_eq_mul]
      exact mul_ne_zero hc hz.1
    · show dehom i (c • z) ∈ V
      rw [dehom_smul i hc]
      exact hz.2
  have hVc0 : Vc ⊆ {z | z ≠ 0} := fun z hz h0 => hz.1 (by simp [h0])
  have hKVc : coverSet ρ s ⊆ Vc := by
    intro z hz
    have hzi : z i ≠ 0 := by
      intro h0
      apply hz.1
      ext j
      have := hz.2 i hi j
      rw [h0, norm_zero, mul_zero] at this
      simpa using norm_le_zero_iff.1 this
    refine ⟨hzi, hLV ?_⟩
    show chart i (dehom i z) ∈ coverSet ρ s
    rw [chart_dehom i hzi]
    exact isCone_coverSet ρ s _ (inv_ne_zero hzi) z hz
  have hdiffV : ∀ {f : EuclideanSpace ℂ (Fin N) → ℂ}, DifferentiableOn ℂ f V → ∀ z ∈ Vc,
      DifferentiableAt ℂ (fun z => f (dehom i z)) z := fun hf z hz =>
    (hf.differentiableAt (hV.mem_nhds hz.2)).comp z (differentiableAt_dehom i hz.1)
  have hhol_pow : ∀ (m : ℤ) (z : ConeSpace N), z i ≠ 0 →
      DifferentiableAt ℂ (fun z : ConeSpace N => z i ^ m) z := fun m z hz =>
    ((EuclideanSpace.proj i : ConeSpace N →L[ℂ] ℂ).differentiableAt).zpow (Or.inl hz)
  -- homogeneous extensions from the chart
  have hext : ∀ {τ : Type} [Fintype τ] (R : GermModule (ConeSpace N) τ),
      R.IsCoherentOn (puncture (ConeSpace N)) → IsConeInvariant R →
      ∀ (m : ℤ) (f : τ → EuclideanSpace ℂ (Fin N) → ℂ), (∀ j, DifferentiableOn ℂ (f j) V) →
      (∀ y ∈ V, (pullChart i R).mem y f) →
      IsHomSection R m (coverSet ρ s) fun j z => z i ^ m * f j (dehom i z) := by
    intro τ _ R hR hRi m f hfd hfm
    refine ⟨Vc, hKVc, ⟨hVco, hVcc, hVc0, fun j z hz => ?_, fun z hz c hc j => ?_⟩, fun y hy => ?_⟩
    · exact ((hhol_pow m z hz.1).mul (hdiffV (hfd j) z hz)).differentiableWithinAt
    · simp only [PiLp.smul_apply, smul_eq_mul, dehom_smul i hc, mul_zpow]
      ring
    · have h1 := hfm _ hy.2
      have hy0 : y ≠ 0 := hVc0 hy
      have hyi := hy.1
      have h2 : R.mem ((y i)⁻¹ • y) fun j z => f j (dehom i z) := by
        have h1' : R.mem (chart i (dehom i y)) fun j z => f j (dehom i z) := h1
        rwa [chart_dehom i hyi] at h1'
      have h3 := (hRi ((y i)⁻¹ • y) (smul_ne_zero (inv_ne_zero hyi) hy0) (y i) hyi _).1 h2
      rw [smul_inv_smul₀ hyi] at h3
      have h4 : R.mem y fun j z => f j (dehom i z) := by
        refine (hR y hy0).congr_mem h3 fun j => Eventually.of_forall fun z => ?_
        simp only [dehom_smul i (inv_ne_zero hyi)]
      have hhol : HolAt (fun z : ConeSpace N => z i ^ m) y :=
        (eventually_coord_ne_zero i hyi).mono fun z hz => hhol_pow m z hz
      exact (hR y hy0).smul_mem hhol h4
  set p : κ → ConeSpace N → ℂ := fun j z => z i ^ (n + d) * p' j (dehom i z) with hpdef
  set a : ι → ConeSpace N → ℂ := fun l z => z i ^ n * a' l (dehom i z) with hadef
  have hp : IsHomSection P (n + d) (coverSet ρ s) p :=
    hext P hP hPi (n + d) p' hp'd fun y hy => (hmemV y hy).1
  have ha : IsHomSection Q n (coverSet ρ s) a :=
    hext Q hQ hQi n a' ha'd fun y hy => (hmemV y hy).2
  refine ⟨p, a, hp, ha, Vc ∩ Ub, hVco.inter hUb.isOpen, fun z hz => ⟨hKVc hz, hKUb hz⟩,
    hVcc.inter hUb.isCone, fun z hz j => ?_⟩
  obtain ⟨⟨hzi, hzV⟩, hzU⟩ := hz
  have hz0 : z ≠ 0 := hUb.subset hzU
  have h1 : b j z = z i ^ (n + d) * b j ((z i)⁻¹ • z) := by
    have := hUb.hom ((z i)⁻¹ • z) (hUb.isCone _ (inv_ne_zero hzi) z hzU) (z i) hzi j
    rwa [smul_inv_smul₀ hzi] at this
  have h2 : b j ((z i)⁻¹ • z) = p' j (dehom i z) + matApply A' a' j (dehom i z) := by
    have := heqV _ hzV j
    simp only [hb'def, chart_dehom i hzi] at this
    exact this
  have h3 : ∀ l, A' j l (dehom i z) = (z i)⁻¹ ^ d * A j l z := fun l => by
    simp only [hA'def, chart_dehom i hzi]
    exact hA.hom z hz0 (z i)⁻¹ (inv_ne_zero hzi) j l
  rw [h1, h2]
  simp only [hpdef, hadef, matApply_apply, h3]
  rw [mul_add, Finset.mul_sum]
  congr 1
  refine Finset.sum_congr rfl fun l _ => ?_
  have hzz : z i ^ (n + d) * (z i)⁻¹ ^ d = z i ^ n := by
    rw [inv_zpow', ← zpow_add₀ hzi]
    congr 1
    ring
  linear_combination (A j l z * a' l (dehom i z)) * hzz

/-- **Theorem B on the whole cover from the affine statement**: if for every `s ≠ ∅` some chart
index `i ∈ s` has `AffineSectionsDecompose (chart i ⁻¹' K_s)`, then every `K_s` (`s ≠ ∅`)
satisfies `SectionsDecompose`, which is the hypothesis of `coverSystem_shortExact` and
`coverSystem_les`. -/
theorem sectionsDecompose_coverSet_of_affine {ρ : ℝ}
    (hB : ∀ s : Finset (Fin (N + 1)), s.Nonempty →
      ∃ i ∈ s, AffineSectionsDecompose (chart i ⁻¹' coverSet ρ s)) :
    ∀ s : Finset (Fin (N + 1)), s.Nonempty → SectionsDecompose (coverSet ρ s) := fun s hs => by
  obtain ⟨i, hi, h⟩ := hB s hs
  exact sectionsDecompose_coverSet hi h

end SGPT.GAGA.PN
