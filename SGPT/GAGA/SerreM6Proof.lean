import SGPT.GAGA.SerreM6Graph

/-!
# Serre's GAGA: proof of `lma:GAGA`

Source `lma:GAGA` (`chapter_NApotential.tex`, lines 1143--1145), step G1, following the book's
proof: glue `𝓘` with `q^*𝒥` on `X × (ℙ¹ ∖ 0)` to a coherent ideal sheaf on `X × ℙ¹`, apply GAGA,
restrict to `X × ℂ`. Here `ℙᴷ × ℙ¹` is embedded in `ℙ^{2K+1}` by Segre's map, and GAGA on
`ℙ^{2K+1}` is `gaga_ideal`.

* `segreIdeal = graphI 𝓘 ⊓ graphJ (p^*𝒥)`: the germs on `ℂ^{2K+2}` whose restriction to the Segre
  cone lies in `𝓘` (chart `t`) and in `q^*𝒥` (chart `s = 1/t` at infinity). The two conditions
  agree where both charts apply (`𝓘 = p^*𝒥` for `t ≠ 0`, and `p^*𝒥` is transported by the
  chart change, `pullJ_chi`, since `𝒥` is generated by homogeneous polynomials by GAGA on
  `ℙᴷ`), so near every point of the cone `segreIdeal` is one of the two push-forwards, which
  are coherent (`graphI_coherentAt`); off the cone it is everything.
  Hence `segreIdeal` is a coherent invariant ideal of `𝒪_{ℙ^{2K+1}}` (`segreIdeal_coherentAt`).
* GAGA on `ℙ^{2K+1}`: `segreIdeal` is generated by homogeneous polynomials `P_k`; their
  restrictions `P_k(z, t z)` generate `𝓘` (`generatedOn_segre`).
* `algGenerated_of_pullJ`: `𝓘` is generated by the polynomials
  `Q_k = P_k(z, t z) ∈ ℂ[t][z_0, …, z_K]`, homogeneous in `z`.
* **`lmaGAGA : LmaGAGA`.**

Blueprint: `claude-serre-m6.tex`, nodes `claude-serre-m6:glue`, `claude-serre-m6:lma-GAGA`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Topology
open SGPT.Foundations.Analysis.Pending SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core

noncomputable section

namespace SGPT.GAGA.PN

variable {K : ℕ}

theorem holTupleAt_swap {f : Unit → SegW K → ℂ} {w : SegW K} (hf : HolTupleAt f w) :
    HolTupleAt (fun j w' => f j (swapFun w')) (swapFun w) := fun j => by
  have h1 : HolAt (f j) (swapFun (swapFun w)) := by rw [swapFun_swapFun]; exact hf j
  exact h1.comp (swapE (K := K)).continuous fun x => by
    have h' := (swapE (K := K)).toContinuousLinearMap.differentiableAt (x := x)
    exact h'

theorem holTupleAt_of_swap {f : Unit → SegW K → ℂ} {w : SegW K}
    (hf : HolTupleAt (fun j w' => f j (swapFun w')) (swapFun w)) : HolTupleAt f w := by
  have h := holTupleAt_swap hf
  simp only [swapFun_swapFun] at h
  exact h

theorem segre_ne_zero {p : ConeSpace K × ℂ} (hp : p.1 ≠ 0) : segre p ≠ 0 := by
  intro h
  apply hp
  ext l
  have := congrArg (fun w => uC w l) h
  simp only [uC_segre] at this
  simpa [uC] using this

theorem exists_coord_ne_zero {z : ConeSpace K} (hz : z ≠ 0) : ∃ i, z i ≠ 0 := by
  by_contra h
  push Not at h
  exact hz (by ext l; simp [h l])

section Glue

variable {I : GermModule (ConeSpace K × ℂ) Unit} {J : GermModule (ConeSpace K) Unit}

/-- The glued ideal on `ℂ^{2K+2}`. -/
def segreIdeal (I : GermModule (ConeSpace K × ℂ) Unit) (J : GermModule (ConeSpace K) Unit) :
    GermModule (SegW K) Unit :=
  (graphI I).inf (graphJ (pullJ J))

variable (hI : I.IsCoherentOn {p | p.1 ≠ 0}) (hJ : J.IsCoherentOn (puncture (ConeSpace K)))
  (hIJ : I.EqOn (pullJ J) {p | p.1 ≠ 0 ∧ p.2 ≠ 0})
  {μ : Type} [Fintype μ] {G : μ → MvPolynomial (Fin (K + 1)) ℂ} {m₀ : ℕ}
  (hGh : ∀ k, (G k).IsHomogeneous m₀)
  (hG : J.GeneratedOn (puncture (ConeSpace K)) (fun k => polyTuple (G k)))

include hIJ hGh hG in
/-- From the chart `t` to the chart at infinity. -/
theorem I_to_pullJ {q : ConeSpace K × ℂ} (hq1 : q.1 ≠ 0) (hq2 : q.2 ≠ 0)
    {g : Unit → ConeSpace K × ℂ → ℂ} (hg : I.mem (chi q) g) :
    (pullJ J).mem q (fun j p => g j (chi p)) :=
  pullJ_chi hGh hG hq1 hq2 ((hIJ _ ⟨smul_ne_zero hq2 hq1, inv_ne_zero hq2⟩ g).1 hg)

include hIJ hGh hG in
/-- From the chart at infinity to the chart `t`. -/
theorem pullJ_to_I {q : ConeSpace K × ℂ} (hq1 : q.1 ≠ 0) (hq2 : q.2 ≠ 0)
    {g : Unit → ConeSpace K × ℂ → ℂ} (hg : (pullJ J).mem (chi q) g) :
    I.mem q (fun j p => g j (chi p)) :=
  (hIJ _ ⟨hq1, hq2⟩ _).2 (pullJ_chi hGh hG hq1 hq2 hg)

theorem eventually_ne_zero_snd {q : ConeSpace K × ℂ} (hq2 : q.2 ≠ 0) :
    ∀ᶠ p in 𝓝 q, p.2 ≠ 0 :=
  continuous_snd.continuousAt.eventually_ne hq2

include hJ hIJ hGh hG in
/-- Where `u_i ≠ 0`, the condition at infinity follows from the condition in the chart `t`. -/
theorem graphJ_of_graphI {i : Fin (K + 1)} {w : SegW K} (hw : uC w i ≠ 0)
    {f : Unit → SegW K → ℂ} (hf : (graphI I).mem w f) : (graphJ (pullJ J)).mem w f := by
  obtain ⟨hhol, hcond⟩ := hf
  refine mem_graphJ.2 ⟨holTupleAt_swap hhol, fun p hp hp1 => ?_⟩
  have hp2 : p.2 ≠ 0 := by
    intro h0
    have := congrArg (fun w' => vC w' i) hp
    simp only [vC_segre, vC_swapFun, h0, zero_mul] at this
    exact hw this.symm
  have hw' : segre (chi p) = w := by
    rw [← swap_segre hp2, hp, swapFun_swapFun]
  have h1 := I_to_pullJ hIJ hGh hG hp1 hp2 (hcond _ hw' (smul_ne_zero hp2 hp1))
  refine (pullJ_isCoherentOn hJ p hp1).congr_mem h1 fun j => ?_
  filter_upwards [eventually_ne_zero_snd hp2] with q hq
  show f j (segre (chi q)) = f j (swapFun (segre q))
  rw [swap_segre hq]

include hI hIJ hGh hG in
/-- Where `v_i ≠ 0`, the condition in the chart `t` follows from the condition at infinity. -/
theorem graphI_of_graphJ {i : Fin (K + 1)} {w : SegW K} (hw : vC w i ≠ 0)
    {f : Unit → SegW K → ℂ} (hf : (graphJ (pullJ J)).mem w f) : (graphI I).mem w f := by
  obtain ⟨hhol, hcond⟩ := mem_graphJ.1 hf
  refine ⟨holTupleAt_of_swap hhol, fun p hp hp1 => ?_⟩
  have hp2 : p.2 ≠ 0 := by
    intro h0
    have := congrArg (fun w' => vC w' i) hp
    simp only [vC_segre, h0, zero_mul] at this
    exact hw this.symm
  have hsw : segre (chi p) = swapFun w := by rw [← swap_segre hp2, hp]
  have h1 := pullJ_to_I hIJ hGh hG hp1 hp2 (hcond _ hsw (smul_ne_zero hp2 hp1))
  refine (hI p hp1).congr_mem h1 fun j => ?_
  filter_upwards [eventually_ne_zero_snd hp2] with q hq
  have hq' : (chi q).2 ≠ 0 := inv_ne_zero hq
  show f j (swapFun (segre (chi q))) = f j (segre q)
  rw [swap_segre hq', chi_chi hq]

include hI hJ hIJ hGh hG in
/-- **The glued ideal is coherent.** -/
theorem segreIdeal_coherentAt {w : SegW K} (hw0 : w ≠ 0) : (segreIdeal I J).CoherentAt w := by
  classical
  by_cases hA : ∃ i, uC w i ≠ 0 ∧ ∀ l, segE i l w = 0
  · obtain ⟨i, hwi, hS⟩ := hA
    have hp1 : (piI i w).1 ≠ 0 := fun h => hwi (by
      have := congrArg (fun z : ConeSpace K => z i) h
      simpa [piI, uPt_apply] using this)
    have hc := graphI_coherentAt hwi (hI _ hp1)
    have hev : ∀ᶠ w' in 𝓝 w, uC w' i ≠ 0 :=
      (differentiable_uC i).continuous.continuousAt.eventually_ne hwi
    refine hc.of_eqOn hev fun w' hw' f => ⟨fun h => ⟨h, graphJ_of_graphI hJ hIJ hGh hG hw' h⟩,
      fun h => h.1⟩
  by_cases hB : ∃ i, vC w i ≠ 0 ∧ ∀ l, segE i l (swapFun w) = 0
  · obtain ⟨i, hwi, hS⟩ := hB
    have hwi' : uC (swapFun w) i ≠ 0 := by simpa using hwi
    have hp1 : (piI i (swapFun w)).1 ≠ 0 := fun h => hwi' (by
      have := congrArg (fun z : ConeSpace K => z i) h
      simpa [piI, uPt_apply] using this)
    have hc := graphJ_coherentAt (graphI_coherentAt hwi' (pullJ_isCoherentOn hJ _ hp1))
    have hev : ∀ᶠ w' in 𝓝 w, vC w' i ≠ 0 :=
      (differentiable_vC i).continuous.continuousAt.eventually_ne hwi
    refine hc.of_eqOn hev fun w' hw' f => ⟨fun h => ⟨graphI_of_graphJ hI hIJ hGh hG hw' h, h⟩,
      fun h => h.2⟩
  -- off the Segre cone
  have hE : ∃ i l, segE i l w ≠ 0 := by
    by_contra hcon
    push Not at hcon
    by_cases hu : ∃ i, uC w i ≠ 0
    · obtain ⟨i, hi⟩ := hu
      exact hA ⟨i, hi, hcon i⟩
    · push Not at hu
      by_cases hv : ∃ i, vC w i ≠ 0
      · obtain ⟨i, hi⟩ := hv
        refine hB ⟨i, hi, fun l => ?_⟩
        simp [segE, hu]
      · push Not at hv
        apply hw0
        rw [← mkW_eta w]
        ext k
        rw [mkW_apply]
        split_ifs <;> simp [hu, hv]
  obtain ⟨i, l, hil⟩ := hE
  have hev : ∀ᶠ w' in 𝓝 w, segE i l w' ≠ 0 :=
    (differentiable_segE i l).continuous.continuousAt.eventually_ne hil
  refine (GermModule.top_isCoherentOn (puncture (SegW K)) w hw0).of_eqOn hev fun w' hw' f =>
    ⟨fun h => ⟨⟨h, fun p hp _ => absurd (hp ▸ segE_segre i l p) hw'⟩, mem_graphJ.2
      ⟨holTupleAt_swap h, fun p hp _ => ?_⟩⟩, fun h => h.1.1⟩
  exfalso
  apply hw'
  have := segE_segre i l p
  rw [hp] at this
  simp only [segE, uC_swapFun, vC_swapFun] at this ⊢
  linear_combination -this

end Glue

/-- The polynomial `P(z, t z) ∈ ℂ[t][z_0, …, z_K]`. -/
def segreSubst (idx : Fin (K + 1 + K + 1)) : MvPolynomial (Fin (K + 1)) (Polynomial ℂ) :=
  if h : idx.1 < K + 1 then MvPolynomial.X ⟨idx.1, h⟩
  else MvPolynomial.C Polynomial.X * MvPolynomial.X ⟨idx.1 - (K + 1), by omega⟩

theorem isHomogeneous_segreSubst (idx : Fin (K + 1 + K + 1)) :
    (segreSubst (K := K) idx).IsHomogeneous 1 := by
  unfold segreSubst
  split_ifs
  · exact MvPolynomial.isHomogeneous_X _ _
  · exact MvPolynomial.isHomogeneous_C_mul_X _ _

theorem evalZT_aeval_segreSubst (P : MvPolynomial (Fin (K + 1 + K + 1)) ℂ)
    (p : ConeSpace K × ℂ) :
    evalZT (MvPolynomial.aeval segreSubst P) p = polyTuple P () (segre p) := by
  unfold evalZT polyTuple
  rw [MvPolynomial.aeval_def]
  show (MvPolynomial.eval₂Hom (Polynomial.evalRingHom p.2) fun l => p.1 l)
      (MvPolynomial.eval₂ (algebraMap ℂ (MvPolynomial (Fin (K + 1)) (Polynomial ℂ))) segreSubst P) = _
  rw [MvPolynomial.eval₂_comp_left]
  have h1 : (MvPolynomial.eval₂Hom (Polynomial.evalRingHom p.2) fun l => p.1 l).comp
      (algebraMap ℂ (MvPolynomial (Fin (K + 1)) (Polynomial ℂ))) = RingHom.id ℂ := by
    ext c
    show MvPolynomial.eval₂ (Polynomial.evalRingHom p.2) (fun l => p.1 l)
      (MvPolynomial.C (Polynomial.C c)) = c
    simp
  have h2 : (MvPolynomial.eval₂Hom (Polynomial.evalRingHom p.2) fun l => p.1 l) ∘ segreSubst =
      fun i => (segre p) i := by
    funext idx
    simp only [Function.comp_apply, segreSubst, segre, mkW_apply]
    split_ifs <;> simp
  rw [h1, h2]
  rfl

/-- **`lma:GAGA`, ambient form**: a coherent ideal sheaf `𝓘` on `ℙᴷ × ℂ` with `𝓘 = p^*𝒥` over
`t ≠ 0`, `𝒥` a coherent ideal sheaf on `ℙᴷ`, is generated by polynomials in `ℂ[t][z]`, homogeneous
in `z`. -/
theorem algGenerated_of_pullJ {I : GermModule (ConeSpace K × ℂ) Unit}
    {J : GermModule (ConeSpace K) Unit} (hI : I.IsCoherentOn {p | p.1 ≠ 0})
    (hIi : IsZInvariant I) (hJ : J.IsCoherentOn (puncture (ConeSpace K)))
    (hJi : IsConeInvariant J) (hIJ : I.EqOn (pullJ J) {p | p.1 ≠ 0 ∧ p.2 ≠ 0}) :
    AlgGenerated I := by
  classical
  obtain ⟨m₀, hm₀⟩ := gaga_ideal hJ hJi
  obtain ⟨μJ, _, G, hGh, hG⟩ := hm₀ m₀ le_rfl
  have hK : (segreIdeal I J).IsCoherentOn (puncture (SegW K)) := fun w hw =>
    segreIdeal_coherentAt hI hJ hIJ hGh hG hw
  have hKi : IsConeInvariant (segreIdeal I J) :=
    (isConeInvariant_graphI hIi).inf (isConeInvariant_graphJ (isZInvariant_pullJ hJi))
  obtain ⟨m₁, hm₁⟩ := gaga_ideal hK hKi
  obtain ⟨ν, _, P, hPh, hP⟩ := hm₁ m₁ le_rfl
  refine ⟨ν, inferInstance, fun k => MvPolynomial.aeval segreSubst (P k), fun _ => 1 * m₁,
    fun k => (hPh k).aeval _ isHomogeneous_segreSubst, ?_⟩
  have hfun : (fun k (_ : Unit) p => evalZT (MvPolynomial.aeval segreSubst (P k)) p) =
      fun k j p => polyTuple (P k) j (segre p) := by
    funext k j p
    exact evalZT_aeval_segreSubst (P k) p
  rw [hfun]
  refine ⟨fun k j => ((differentiable_eval_poly (P k)).comp differentiable_segre).differentiableOn,
    fun p hp g => ⟨fun hg => ?_, fun hg => ?_⟩⟩
  · -- `g = f ∘ segre` with `f = g ∘ piI i`, and `f` lies in the glued ideal
    have hp1 : p.1 ≠ 0 := hp
    obtain ⟨i, hpi⟩ := exists_coord_ne_zero hp1
    have hsi : uC (segre p) i ≠ 0 := by simpa using hpi
    have hpiI : piI i (segre p) = p := piI_segre hpi
    have hevi : ∀ᶠ q in 𝓝 p, q.1 i ≠ 0 :=
      ((differentiable_coord i).continuous.comp continuous_fst).continuousAt.eventually_ne hpi
    have hgf : ∀ j, (fun q => g j (piI i (segre q))) =ᶠ[𝓝 p] g j := fun j => by
      filter_upwards [hevi] with q hq
      rw [piI_segre hq]
    have hfI : (graphI I).mem (segre p) (fun j w => g j (piI i w)) := by
      refine ⟨fun j => ?_, fun p' hp' hp'1 => ?_⟩
      · have h1 : HolAt (g j) (piI i (segre p)) := by
          rw [hpiI]
          exact (hI p hp1).holTupleAt_of_mem hg j
        exact HolAt.comp_of_eventually h1 (eventually_differentiableAt_piI hsi)
      · have hp'i : p'.1 i ≠ 0 := by
          have := congrArg (fun w => uC w i) hp'
          simp only [uC_segre] at this
          rw [this]
          exact hpi
        have : p' = p := by rw [eq_piI_of_segre hp' hp'i, hpiI]
        subst this
        exact (hI p' hp'1).congr_mem hg fun j => (hgf j).symm
    have hfK : (segreIdeal I J).mem (segre p) (fun j w => g j (piI i w)) :=
      ⟨hfI, graphJ_of_graphI hJ hIJ hGh hG hsi hfI⟩
    obtain ⟨c, hc, hcf⟩ := (hP.2 (segre p) (segre_ne_zero hp1) _).1 hfK
    refine ⟨fun k q => c k (segre q), fun k => ?_, fun j => ?_⟩
    · exact (hc k).comp differentiable_segre.continuous fun q => differentiable_segre q
    · have ht : Tendsto segre (𝓝 p) (𝓝 (segre p)) := differentiable_segre.continuous.continuousAt
      filter_upwards [ht.eventually (hcf j), hgf j] with q hq hq'
      rw [← hq', hq]
  · have hmem : ∀ k, I.mem p (fun j q => polyTuple (P k) j (segre q)) := fun k =>
      ((hP.2 (segre p) (segre_ne_zero hp) (polyTuple (P k))).2
        (isCombinationAt_gen _ _ k)).1.2 p rfl hp
    exact (hI p hp).mem_of_isCombinationAt hmem hg

/-- The hypothesis `𝓘|_{X × ℂ*} = p^*𝒥` of `LmaGAGA`: the preimage in `𝒪_{ℙᴷ × ℂ}` of `p^*𝒥 ⊆ 𝒪_{X × ℂ}`
is `p^*𝒥̃ + (F) = p^*𝒥̃`, since `(F) 𝒪_{ℙᴷ × ℂ} ⊆ p^*𝒥̃` when `(F) ⊆ 𝒥̃`. -/
theorem idealF₂_le_pullJ {σ : Type} [Fintype σ] {F : σ → MvPolynomial (Fin (K + 1)) ℂ}
    {J : GermModule (ConeSpace K) Unit} (hFJ : (idealF F).LeOn J (puncture (ConeSpace K))) :
    (idealF₂ F).LeOn (pullJ J) {p : ConeSpace K × ℂ | p.1 ≠ 0} := by
  classical
  rintro q hq g ⟨c, hc, hgc⟩
  exact ⟨σ, inferInstance, fun k => polyTuple (F k), c,
    fun k => hFJ q.1 hq _ (isCombinationAt_gen (fun k => polyTuple (F k)) q.1 k), hc, hgc⟩

/-- **`lma:GAGA`** (in the cone model of `LmaGAGA`). -/
theorem lmaGAGA : LmaGAGA :=
  fun _ _ _ _ _ _ _ _ hI hIi _ hJ hJi _ hIJ => algGenerated_of_pullJ hI hIi hJ hJi hIJ

end SGPT.GAGA.PN
