import SGPT.Trace.Trace2Bertini
import SGPT.Foundations.Analysis.Pending.RankDegeneracy
import SGPT.Foundations.Analysis.Pending.BlowupStrictIdeal
import SGPT.Foundations.Analysis.Pending.HolomorphicGermAlgebra

/-!
# Fibres of holomorphic maps: scheme-theoretic fibres and smooth fibres

Source: `chapter_trace.tex`, `rmk:generalABT` ("for quasi-every `y ∈ Y`, the fiber `X_y` is
smooth and ..."), blueprint `claude-direct-img.tex`.

Let `f : X → Y` be a holomorphic map of complex manifolds of dimensions `n` and `m`.

* `fibre f y = f⁻¹(y)` and `fibreIdeal n m f y`: the ideal sheaf of the scheme-theoretic fibre
  `X_y = X ×_Y {y}`, generated by the pullbacks of the germs vanishing at `y`
  (`GermIdeal.pullback`), as for the members `H ×_{ℙᴺ} X` of `thm:Bert`
  (`SGPT.Trace.Bertini.memberSubspace`).
* `IsSmoothFibreOfDim n m f y k`: `X_y` is smooth of dimension `k`, i.e. its support `f⁻¹(y)` is
  regular of dimension `k` at each of its points and its ideal sheaf is the reduced one (the
  analogue of `SGPT.Trace.Bertini.IsSmoothMemberOfDim`).
* `isSmoothFibreOfDim_of_surjective`: if the differential of `f` is surjective at every point of
  `f⁻¹(y)` (`y` is a regular value), then `X_y` is smooth of dimension `n - m`: in the coordinates
  `W = (L(z - z₀), F(z) - F(z₀))` (`F` the coordinate expression of `f`, `L` injective on
  `ker dF`) the fibre is a coordinate plane, and Hadamard's lemma
  (`BlowupStrictIdeal.exists_vanishingIdeal_mem_iff_planeCoords`) shows that its ideal is
  generated by the components of `F - F(z₀)`, which are pullbacks of germs vanishing at `y`.
* `criticalSet n m f` (the points where `df` is not onto) is analytic
  (`isComplexAnalyticSubset_criticalSet`, a rank-degeneracy set); for `f` proper its image, the
  set of critical values, is analytic (Remmert) with empty interior (fibre-dimension and
  image-dimension bounds on the pure-dimensional parts), hence pluripolar
  (`locallyPluripolar_image_criticalSet`).
* `coPluripolar_isSmoothFibreOfDim`: **the smoothness clause of `rmk:generalABT`**: for a proper
  holomorphic `f`, `X_y` is smooth of dimension `n - m` for quasi-every `y ∈ Y`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open Set Filter
open scoped Topology Manifold ContDiff

namespace SGPT.Trace.DirectImg

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
  SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
  SGPT.Foundations.Analysis.FirstPass.BlowupSequences SGPT.Foundations.Analysis.Pending
  SGPT.Foundations.Analysis.Pending.RankDegeneracy SGPT.Foundations.Analysis.Pending.AnalyticDimensionBasics

section Fibre

variable {n m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel m) Y]
  [IsComplexManifold m Y] (f : X → Y)

/-- The set-theoretic fibre `f⁻¹(y)`, the support of `X_y`. -/
def fibre (y : Y) : Set X := f ⁻¹' {y}

theorem mem_fibre {y : Y} {x : X} : x ∈ fibre f y ↔ f x = y := Iff.rfl

theorem isClosed_fibre [T1Space Y] (hf : Continuous f) (y : Y) :
    IsClosed (fibre f y) :=
  isClosed_singleton.preimage hf

variable (n m) in
/-- The ideal sheaf of the scheme-theoretic fibre `X_y = X ×_Y {y}` of `f`: the ideal of `𝒪_X`
generated by the pullbacks `a ∘ f` of the germs `a` vanishing at `y`. -/
def fibreIdeal (y : Y) : GermIdeal n X :=
  GermIdeal.pullback (m := n) f (vanishingIdeal (n := m) ({y} : Set Y))

variable (n m) in
/-- **`X_y` is smooth of dimension `k`**: its support `f⁻¹(y)` is regular of dimension `k` at each
of its points and the ideal sheaf of `X_y` is the ideal of germs vanishing on `f⁻¹(y)` (`X_y` is
reduced). This is the meaning of "the fibre `X_y` is smooth" in `rmk:generalABT`. -/
def IsSmoothFibreOfDim (y : Y) (k : ℕ) : Prop :=
  (∀ x ∈ fibre f y, RegularAtDim (n := n) (fibre f y) x k) ∧
    ∀ x g, (fibreIdeal n m f y).mem x g ↔ (vanishingIdeal (n := n) (fibre f y)).mem x g

/-- A smooth fibre is a closed submanifold. -/
theorem IsSmoothFibreOfDim.isClosedSubmanifold (hf : Continuous f) {y : Y} {k : ℕ}
    (h : IsSmoothFibreOfDim n m f y k) : IsClosedSubmanifold n (fibre f y) :=
  ⟨isClosed_fibre f hf y, fun _ hx => ⟨k, h.1 _ hx⟩⟩

/-- Germs of the ideal of `X_y` vanish on `f⁻¹(y)` near the point. -/
theorem fibreIdeal_mem_vanishingIdeal (hf : Continuous f) {y : Y} {x : X} {g : X → ℂ}
    (hg : (fibreIdeal n m f y).mem x g) : (vanishingIdeal (n := n) (fibre f y)).mem x g := by
  obtain ⟨hgh, K, s, a, hs, -, hga⟩ := hg
  refine ⟨hgh, ?_⟩
  have hev : ∀ i, ∀ᶠ z in 𝓝 x, z ∈ fibre f y → s i z = 0 := by
    intro i
    obtain ⟨b, hb, hsb⟩ := hs i
    obtain ⟨-, hbev⟩ := hb
    have hbev' : ∀ᶠ z in 𝓝 x, f z ∈ ({y} : Set Y) → b (f z) = 0 :=
      hf.continuousAt.eventually hbev
    filter_upwards [hbev'] with z hz hzM
    rw [hsb]
    exact hz hzM
  filter_upwards [hga, Filter.eventually_all.mpr hev] with z hz hz0 hzM
  rw [hz]
  exact Finset.sum_eq_zero fun i _ => by rw [hz0 i hzM, mul_zero]

/-- Off `f⁻¹(y)`, every holomorphic germ lies in the ideal of `X_y`. -/
theorem fibreIdeal_mem_of_notMem {y : Y} {x : X} (hx : x ∉ fibre f y) {g : X → ℂ}
    (hg : HolomorphicAt n g x) : (fibreIdeal n m f y).mem x g := by
  refine ⟨hg, 1, fun _ => fun _ => (1 : ℂ), fun _ => g, ?_, fun _ => hg, ?_⟩
  · intro _
    exact ⟨fun _ => (1 : ℂ), Bertini.vanishingIdeal_mem_one_of_notMem isClosed_singleton hx, rfl⟩
  · exact Eventually.of_forall fun z => by simp

/-- At a point off `f⁻¹(y)`, the ideal of `X_y` and the reduced ideal agree. -/
theorem fibreIdeal_mem_iff_of_notMem (hf : Continuous f) {y : Y} {x : X} (hx : x ∉ fibre f y)
    (g : X → ℂ) :
    (fibreIdeal n m f y).mem x g ↔ (vanishingIdeal (n := n) (fibre f y)).mem x g :=
  ⟨fibreIdeal_mem_vanishingIdeal f hf, fun hg => fibreIdeal_mem_of_notMem f hx hg.1⟩

/-- An empty fibre is smooth of every dimension. -/
theorem isSmoothFibreOfDim_of_fibre_eq_empty (hf : Continuous f) {y : Y}
    (hy : fibre f y = ∅) (k : ℕ) : IsSmoothFibreOfDim n m f y k := by
  refine ⟨fun x hx => by rw [hy] at hx; exact absurd hx (notMem_empty x), fun x g => ?_⟩
  have hx : x ∉ fibre f y := by rw [hy]; exact notMem_empty x
  exact fibreIdeal_mem_iff_of_notMem f hf hx g

end Fibre


/-! ### Regular values have smooth fibres -/

section Regular

variable {b m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel (b + m)) X]
  [IsComplexManifold (b + m) X] {Y : Type*} [TopologicalSpace Y]
  [ChartedSpace (ComplexModel m) Y] [IsComplexManifold m Y] {f : X → Y}

theorem finAddEquivProd_symm_natAdd (p : ComplexModel b) (q : ComplexModel m) (j : Fin m) :
    (EuclideanSpace.finAddEquivProd (𝕜 := ℂ) (n := b) (m := m)).symm (p, q) (Fin.natAdd b j) =
      q j := by
  simp [EuclideanSpace.finAddEquivProd]

/-- A point of `ℂ^{b+m}` written as `(p, q)` lies in the coordinate plane `ℂ^b × 0` iff `q = 0`. -/
theorem finAddEquivProd_symm_mem_plane_iff (p : ComplexModel b) (q : ComplexModel m) :
    (EuclideanSpace.finAddEquivProd (𝕜 := ℂ) (n := b) (m := m)).symm (p, q) ∈
      complexCoordinatePlane (b + m) b ↔ q = 0 := by
  constructor
  · intro h
    ext j
    have := h (Fin.natAdd b j) (by simp)
    rwa [finAddEquivProd_symm_natAdd] at this
  · rintro rfl i hi
    obtain ⟨j, rfl⟩ : ∃ j : Fin m, Fin.natAdd b j = i :=
      ⟨⟨i.1 - b, by omega⟩, Fin.ext (by simp; omega)⟩
    rw [finAddEquivProd_symm_natAdd]
    rfl

/-- **Fibre coordinates at a regular point.** If the differential of `f` at `x` (read in the
preferred charts) is surjective, there are an open `O ∋ x` and a map `W : X → ℂ^{b+m}`,
holomorphic on `O`, with injective differential at `x`, such that on `O` the fibre `f⁻¹(f x)` is
`W⁻¹(ℂ^b × 0)`, and whose coordinates `W_i`, `i ≥ b`, are pullbacks `a ∘ f` of germs `a`
vanishing at `f x`. -/
theorem exists_fibre_coords
    (hf : ContMDiff 𝓘(ℂ, ComplexModel (b + m)) 𝓘(ℂ, ComplexModel m) ∞ f) {x : X}
    (hD : Function.Surjective (chartDeriv (complexChartAt (n := b + m) x)
      (complexChartAt (n := m) (f x)) f x)) :
    ∃ (O : Set X) (W : X → ComplexModel (b + m)), IsOpen O ∧ x ∈ O ∧
      (∀ z ∈ O, ContMDiffAt 𝓘(ℂ, ComplexModel (b + m)) 𝓘(ℂ, ComplexModel (b + m)) ∞ W z) ∧
      Function.Injective (fderiv ℂ (fun ζ => W ((chartAt (ComplexModel (b + m)) x).symm ζ))
        (chartAt (ComplexModel (b + m)) x x)) ∧
      W x ∈ complexCoordinatePlane (b + m) b ∧
      (∀ z ∈ O, (z ∈ fibre f (f x) ↔ W z ∈ complexCoordinatePlane (b + m) b)) ∧
      ∀ i : Fin (b + m), ∃ a : Y → ℂ, (vanishingIdeal (n := m) ({f x} : Set Y)).mem (f x) a ∧
        BlowupStrictIdeal.planeCoords W b i = a ∘ f := by
  classical
  set e := complexChartAt (n := b + m) x with he
  set e' := complexChartAt (n := m) (f x) with he'
  set z₀ := e.val x with hz₀
  set c := e'.val (f x) with hc
  have hxe : x ∈ e.val.source := mem_complexChartAt_source x
  have hfxe' : f x ∈ e'.val.source := mem_complexChartAt_source (f x)
  set F : ComplexModel (b + m) → ComplexModel m := fun ζ => e'.val (f (e.val.symm ζ)) with hF
  set D := chartDeriv e e' f x with hD'
  have hFd : DifferentiableAt ℂ F z₀ :=
    differentiableAt_chartReading e e' hxe hfxe' (hf.mdifferentiableAt (by simp))
  have hDF : fderiv ℂ F z₀ = D := rfl
  -- a linear map injective on the kernel of `D`
  set K := LinearMap.ker (D : ComplexModel (b + m) →ₗ[ℂ] ComplexModel m) with hK
  have hKdim : Module.finrank ℂ K = b := by
    have h1 : Module.finrank ℂ (LinearMap.range (D : ComplexModel (b + m) →ₗ[ℂ] ComplexModel m)) +
        Module.finrank ℂ K = Module.finrank ℂ (ComplexModel (b + m)) :=
      LinearMap.finrank_range_add_finrank_ker _
    have h2 : LinearMap.range (D : ComplexModel (b + m) →ₗ[ℂ] ComplexModel m) = ⊤ :=
      LinearMap.range_eq_top.mpr hD
    rw [h2, finrank_top] at h1
    simp only [finrank_euclideanSpace_fin] at h1
    omega
  obtain ⟨g₀, hg₀⟩ := LinearMap.exists_leftInverse_of_injective K.subtype K.ker_subtype
  set eK : K ≃ₗ[ℂ] ComplexModel b := LinearEquiv.ofFinrankEq K (ComplexModel b)
    (by rw [hKdim, finrank_euclideanSpace_fin])
  set L : ComplexModel (b + m) →L[ℂ] ComplexModel b :=
    LinearMap.toContinuousLinearMap (eK.toLinearMap ∘ₗ g₀) with hL
  set P := EuclideanSpace.finAddEquivProd (𝕜 := ℂ) (n := b) (m := m) with hP
  set W : X → ComplexModel (b + m) := fun z => P.symm (L (e.val z - z₀), e'.val (f z) - c)
    with hW
  set O : Set X := e.val.source ∩ f ⁻¹' e'.val.source with hO
  have hOopen : IsOpen O := e.val.open_source.inter (e'.val.open_source.preimage hf.continuous)
  have hxO : x ∈ O := ⟨hxe, hfxe'⟩
  refine ⟨O, W, hOopen, hxO, fun z hz => ?_, ?_, ?_, fun z hz => ?_, fun i => ?_⟩
  · -- smoothness
    have h1 : ContMDiffAt 𝓘(ℂ, ComplexModel (b + m)) 𝓘(ℂ, ComplexModel b) ∞
        (fun z => L (e.val z - z₀)) z :=
      (L.contMDiff.contMDiffAt).comp z
        (((contMDiffOn_chart (n := ∞)).contMDiffAt (e.val.open_source.mem_nhds hz.1)).sub
          contMDiffAt_const)
    have h2 : ContMDiffAt 𝓘(ℂ, ComplexModel (b + m)) 𝓘(ℂ, ComplexModel m) ∞
        (fun z => e'.val (f z) - c) z :=
      (((contMDiffOn_chart (n := ∞)).contMDiffAt (e'.val.open_source.mem_nhds hz.2)).comp z
        (hf z)).sub contMDiffAt_const
    exact (P.symm.contDiff.contMDiff.contMDiffAt).comp z (h1.prodMk_space h2)
  · -- the differential at `x`
    have hloc : (fun ζ => W (e.val.symm ζ)) =ᶠ[𝓝 z₀]
        fun ζ => P.symm (L (ζ - z₀), F ζ - c) := by
      filter_upwards [e.val.open_target.mem_nhds (e.val.map_source hxe)] with ζ hζ
      simp only [hW, hF, e.val.right_inv hζ]
    have hder : HasFDerivAt (fun ζ => W (e.val.symm ζ))
        ((P.symm : ComplexModel b × ComplexModel m →L[ℂ] ComplexModel (b + m)).comp
          (L.prod D)) z₀ := by
      refine HasFDerivAt.congr_of_eventuallyEq ?_ hloc
      have hL' : HasFDerivAt (fun ζ => L (ζ - z₀)) L z₀ := by
        have := L.hasFDerivAt.comp z₀ ((hasFDerivAt_id z₀).sub_const z₀)
        rw [ContinuousLinearMap.comp_id] at this
        exact this
      have hF' : HasFDerivAt (fun ζ => F ζ - c) D z₀ := by
        rw [← hDF]
        exact hFd.hasFDerivAt.sub_const c
      exact P.symm.hasFDerivAt.comp z₀ (hL'.prodMk hF')
    show Function.Injective (fderiv ℂ (fun ζ => W (e.val.symm ζ)) z₀)
    rw [hder.fderiv]
    refine (injective_iff_map_eq_zero _).mpr fun v hv => ?_
    have hv' : (L.prod D) v = 0 := by
      have h := congrArg P hv
      simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
        ContinuousLinearEquiv.coe_coe, ContinuousLinearEquiv.apply_symm_apply, map_zero] at h
      exact h
    have hDv : D v = 0 := congrArg Prod.snd hv'
    have hLv : L v = 0 := congrArg Prod.fst hv'
    have hvK : v ∈ K := hDv
    have h1 : g₀ v = ⟨v, hvK⟩ := by
      have := congrArg (fun ψ => ψ ⟨v, hvK⟩) hg₀
      simpa using this
    have h2 : eK (g₀ v) = 0 := hLv
    rw [h1, LinearEquiv.map_eq_zero_iff] at h2
    exact congrArg Subtype.val h2
  · -- `W x` lies in the plane
    rw [finAddEquivProd_symm_mem_plane_iff]
    exact sub_self c
  · -- the fibre is the preimage of the plane
    rw [finAddEquivProd_symm_mem_plane_iff, sub_eq_zero, mem_fibre]
    exact ⟨fun h => by rw [h], fun h => e'.val.injOn hz.2 hfxe' h⟩
  · -- the plane coordinates are pullbacks of germs vanishing at `f x`
    by_cases hi : b ≤ i.1
    · obtain ⟨j, rfl⟩ : ∃ j : Fin m, Fin.natAdd b j = i :=
        ⟨⟨i.1 - b, by omega⟩, Fin.ext (by simp; omega)⟩
      refine ⟨fun y => (e'.val y - c) j, ⟨?_, ?_⟩, ?_⟩
      · have hs : ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel m) ∞
            (fun y => e'.val y - c) (f x) :=
          ((contMDiffOn_chart (n := ∞)).contMDiffAt (e'.val.open_source.mem_nhds hfxe')).sub
            contMDiffAt_const
        have hs' : ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ℂ) ∞
            (fun y => (e'.val y - c) j) (f x) :=
          ((EuclideanSpace.proj (𝕜 := ℂ) j).contDiff.contMDiff.contMDiffAt).comp (f x) hs
        have hopen : IsOpen e'.val.source := e'.val.open_source
        filter_upwards [hopen.mem_nhds hfxe'] with y hy
        have hsy : ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ℂ) ∞ (fun y => (e'.val y - c) j) y :=
          ((EuclideanSpace.proj (𝕜 := ℂ) j).contDiff.contMDiff.contMDiffAt).comp y
            (((contMDiffOn_chart (n := ∞)).contMDiffAt (hopen.mem_nhds hy)).sub
              contMDiffAt_const)
        exact hsy.mdifferentiableAt (by simp)
      · exact Eventually.of_forall fun y hy => by
          rw [mem_singleton_iff.mp hy]
          simp [hc]
      · funext z
        simp only [BlowupStrictIdeal.planeCoords, hi, if_true, Function.comp_apply, hW]
        rw [finAddEquivProd_symm_natAdd]
    · refine ⟨fun _ => 0, ⟨holomorphicAt_const 0, Eventually.of_forall fun _ _ => rfl⟩, ?_⟩
      funext z
      simp [BlowupStrictIdeal.planeCoords, hi]

/-- **Regular values have smooth fibres** (dimension written `b` for `X` of dimension `b + m`). -/
theorem isSmoothFibreOfDim_of_forall_surjective_add
    (hf : ContMDiff 𝓘(ℂ, ComplexModel (b + m)) 𝓘(ℂ, ComplexModel m) ∞ f) {y : Y}
    (hy : ∀ x ∈ fibre f y, Function.Surjective (chartDeriv (complexChartAt (n := b + m) x)
      (complexChartAt (n := m) (f x)) f x)) :
    IsSmoothFibreOfDim (b + m) m f y b := by
  refine ⟨fun x hx => ?_, fun x g => ?_⟩
  · obtain ⟨O, W, hO, hxO, hWs, hWinj, hWx, hfib, -⟩ := exists_fibre_coords hf (hy x hx)
    rw [mem_fibre] at hx
    subst hx
    obtain ⟨Θ, hΘt, hΘ0, hΘ⟩ := BlowupSNCTransform.exists_recentred_coords hO hWs hxO hWinj
    refine ⟨by omega, (mem_fibre f).mpr rfl, Θ, hΘt, hΘ0, fun {u} hu huΘ => ?_⟩
    obtain ⟨huO, hΘu⟩ := hΘ hu huΘ
    rw [hΘu, BlowupStrictSubmanifold.sub_mem_plane_iff hWx]
    exact hfib u huO
  · by_cases hx : x ∈ fibre f y
    · refine ⟨fibreIdeal_mem_vanishingIdeal f hf.continuous, fun hg => ?_⟩
      obtain ⟨O, W, hO, hxO, hWs, hWinj, hWx, hfib, hgen⟩ := exists_fibre_coords hf (hy x hx)
      rw [mem_fibre] at hx
      subst hx
      obtain ⟨U, -, hxU, -, hiff⟩ := BlowupStrictIdeal.exists_vanishingIdeal_mem_iff_planeCoords
        hO hWs hxO hWinj hWx (A := fibre f (f x)) hfib
      have hspan := (hiff x hxU g).mp hg
      show IsInSpanAt (n := b + m)
        (fun s => ∃ a, (vanishingIdeal (n := m) ({f x} : Set Y)).mem (f x) a ∧ s = a ∘ f) x g
      refine IsInSpanAt.mono ?_ hspan
      rintro s ⟨i, rfl⟩
      exact hgen i
    · exact fibreIdeal_mem_iff_of_notMem f hf.continuous hx g

end Regular

section RegularGeneral

variable {n m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel m) Y]
  [IsComplexManifold m Y] {f : X → Y}

/-- A surjective differential forces `dim Y ≤ dim X`. -/
theorem le_of_surjective_chartDeriv {x : X}
    (hD : Function.Surjective (chartDeriv (complexChartAt (n := n) x)
      (complexChartAt (n := m) (f x)) f x)) : m ≤ n := by
  set D := chartDeriv (complexChartAt (n := n) x) (complexChartAt (n := m) (f x)) f x
  have h1 := LinearMap.finrank_range_le (D : ComplexModel n →ₗ[ℂ] ComplexModel m)
  have h2 : LinearMap.range (D : ComplexModel n →ₗ[ℂ] ComplexModel m) = ⊤ :=
    LinearMap.range_eq_top.mpr hD
  rw [h2, finrank_top] at h1
  simpa only [finrank_euclideanSpace_fin] using h1

/-- **Regular values have smooth fibres**: if the differential of `f` is surjective at every
point of `f⁻¹(y)`, then the scheme-theoretic fibre `X_y` is smooth of dimension `n - m`. -/
theorem isSmoothFibreOfDim_of_forall_surjective
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) {y : Y}
    (hy : ∀ x ∈ fibre f y, Function.Surjective (chartDeriv (complexChartAt (n := n) x)
      (complexChartAt (n := m) (f x)) f x)) :
    IsSmoothFibreOfDim n m f y (n - m) := by
  by_cases hemp : fibre f y = ∅
  · exact isSmoothFibreOfDim_of_fibre_eq_empty f hf.continuous hemp _
  obtain ⟨x, hx⟩ := Set.nonempty_iff_ne_empty.mpr hemp
  obtain ⟨b, rfl⟩ : ∃ b, n = b + m :=
    ⟨n - m, (Nat.sub_add_cancel (le_of_surjective_chartDeriv (hy x hx))).symm⟩
  rw [Nat.add_sub_cancel]
  exact isSmoothFibreOfDim_of_forall_surjective_add hf hy

end RegularGeneral

/-! ### Critical values -/

section Critical

variable {n m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel m) Y]
  [IsComplexManifold m Y] {f : X → Y}

/-- The tangent space of the whole manifold is everything. -/
theorem tangentSpaceIn_univ (x : X) :
    tangentSpaceIn (complexChartAt (n := n) x) (univ : Set X) x = ⊤ := by
  apply Submodule.eq_top_of_finrank_eq
  rw [finrank_tangentSpaceIn_of_regularAtDim (complexChartAt (n := n) x)
    (mem_complexChartAt_source x) (AnalyticIrreducibleComponents.regularAtDim_univ x),
    finrank_euclideanSpace_fin]

/-- The rank of `f` on `X` at `x` is the rank of its differential. -/
theorem rankAt_univ_eq (x : X) :
    rankAt (n := n) (n' := m) f univ x =
      Module.finrank ℂ (LinearMap.range ((chartDeriv (complexChartAt (n := n) x)
        (complexChartAt (n := m) (f x)) f x : ComplexModel n →L[ℂ] ComplexModel m) :
          ComplexModel n →ₗ[ℂ] ComplexModel m)) := by
  unfold rankAt rankIn
  rw [tangentSpaceIn_univ, Submodule.map_top]

/-- The rank of `f` is `< m` exactly at the critical points. -/
theorem rankAt_univ_lt_iff (x : X) :
    rankAt (n := n) (n' := m) f univ x < m ↔
      ¬ Function.Surjective (chartDeriv (complexChartAt (n := n) x)
        (complexChartAt (n := m) (f x)) f x) := by
  rw [rankAt_univ_eq]
  set D := chartDeriv (complexChartAt (n := n) x) (complexChartAt (n := m) (f x)) f x
  constructor
  · intro h hs
    rw [LinearMap.range_eq_top.mpr hs, finrank_top, finrank_euclideanSpace_fin] at h
    exact lt_irrefl _ h
  · intro h
    by_contra hge
    push Not at hge
    apply h
    apply LinearMap.range_eq_top.mp
    apply Submodule.eq_top_of_finrank_eq
    refine le_antisymm (Submodule.finrank_le _) ?_
    simpa only [finrank_euclideanSpace_fin] using hge

/-- The rank on a subset is at most the rank on the whole manifold. -/
theorem rankAt_le_rankAt_univ (A : Set X) (z : X) :
    rankAt (n := n) (n' := m) f A z ≤ rankAt (n := n) (n' := m) f univ z := by
  unfold rankAt rankIn
  apply Submodule.finrank_mono
  apply Submodule.map_mono
  rw [tangentSpaceIn_univ]
  exact le_top

variable (n m f) in
/-- The critical set of `f`: the points where the differential of `f` is not surjective. -/
def criticalSet : Set X :=
  {x | ¬ Function.Surjective (chartDeriv (complexChartAt (n := n) x)
    (complexChartAt (n := m) (f x)) f x)}

theorem criticalSet_eq_rankDegeneracyLocus :
    criticalSet n m f = rankDegeneracyLocus n m f univ n m := by
  ext x
  simp only [criticalSet, rankDegeneracyLocus, mem_ofPred_eq, mem_union, Set.mem_sdiff,
    regularLocus]
  constructor
  · intro hx
    exact Or.inr ⟨AnalyticIrreducibleComponents.regularAtDim_univ x, (rankAt_univ_lt_iff x).mpr hx⟩
  · rintro (⟨-, hx⟩ | ⟨-, hx⟩)
    · exact absurd (AnalyticIrreducibleComponents.regularAtDim_univ x) hx
    · exact (rankAt_univ_lt_iff x).mp hx

/-- **The critical set is analytic** (`RankDegeneracy.isComplexAnalyticSubset_rankDegeneracyLocus`:
it is cut out by the `m × m` minors of the Jacobian). -/
theorem isComplexAnalyticSubset_criticalSet
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) :
    IsComplexAnalyticSubset (n := n) (criticalSet n m f) := by
  rw [criticalSet_eq_rankDegeneracyLocus]
  exact isComplexAnalyticSubset_rankDegeneracyLocus isComplexAnalyticSubset_univ
    (fun _ _ hy => AnalyticIrreducibleComponents.eq_of_regularAtDim_univ hy)
    (hf.mdifferentiable (by simp)) m

/-- The image of a pure-dimensional part of the critical set has empty interior (Sard's theorem
for holomorphic maps, analytic form): the rank of `f` on it is `≤ m - 1`, so its fibres have
dimension `≥ k - (m - 1)` and its image has dimension `≤ m - 1`. -/
theorem interior_image_dimensionPart_criticalSet
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) (k : ℕ) :
    interior (f '' HironakaEmbeddedDimensionParts.dimensionPart (n := n)
      (criticalSet n m f) k) = ∅ := by
  set C := criticalSet n m f with hCdef
  have hC := isComplexAnalyticSubset_criticalSet hf
  set A := HironakaEmbeddedDimensionParts.dimensionPart (n := n) C k with hAdef
  have hA : IsComplexAnalyticSubset (n := n) A :=
    HironakaEmbeddedDimensionParts.isComplexAnalyticSubset_dimensionPart hC k
  have hpure : IsPureDim (n := n) A k := Bertini.isPureDim_dimensionPart' hC k
  have hAC : A ⊆ C := HironakaEmbeddedDimensionParts.dimensionPart_subset hC.isClosed k
  have hrank : ∀ z ∈ A, rankAt (n := n) (n' := m) f A z ≤ m - 1 := by
    intro z hz
    have h1 := rankAt_le_rankAt_univ (n := n) (m := m) (f := f) A z
    have h2 := (rankAt_univ_lt_iff (n := n) (m := m) (f := f) z).mpr (hAC hz)
    omega
  have hfib : ∀ x ∈ A, LocDimGE (n := n) (A ∩ f ⁻¹' {f x}) x (k - (m - 1)) :=
    fun x hx => FibreDimensionLowerBound.locDimGE_fibre hA hpure hf
      (fun z hz => hrank z hz.2.1) hx
  have hdim : DimLE (n := m) (f '' A) (k - (k - (m - 1))) :=
    AnalyticImageDimension.dimLE_image hf hA hpure.dimLE hfib
  by_contra hne
  obtain ⟨y, hy⟩ := Set.nonempty_iff_ne_empty.mpr hne
  obtain ⟨x, hxA, -⟩ := interior_subset hy
  have hm : 1 ≤ m := by
    have := (rankAt_univ_lt_iff (n := n) (m := m) (f := f) x).mpr (hAC hxA)
    omega
  have hreg : RegularAtDim (n := m) (f '' A) y m := by
    refine RegularPointDimension.regularAtDim_of_inter_eq isOpen_interior hy ?_
      (AnalyticIrreducibleComponents.regularAtDim_univ (n := m) y)
    rw [univ_inter, inter_eq_right.mpr interior_subset]
  have := hdim y m hreg
  omega

/-- **The set of critical values of a proper holomorphic map is analytic with empty interior.** -/
theorem isComplexAnalyticSubset_image_criticalSet
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) (hprop : IsProperMap f) :
    IsComplexAnalyticSubset (n := m) (f '' criticalSet n m f) :=
  ProperMappingTheorem.isComplexAnalyticSubset_image hf (isComplexAnalyticSubset_criticalSet hf)
    fun _ hK => (hprop.isCompact_preimage hK).inter_left
      (isComplexAnalyticSubset_criticalSet hf).isClosed

theorem interior_image_criticalSet
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) (hprop : IsProperMap f) :
    interior (f '' criticalSet n m f) = ∅ := by
  have hC := isComplexAnalyticSubset_criticalSet hf
  rw [HironakaEmbeddedDimensionParts.eq_iUnion_dimensionPart hC, image_iUnion]
  refine Bertini.interior_iUnion_eq_empty_of_isClosed (fun k => ?_)
    (fun k => interior_image_dimensionPart_criticalSet hf k)
  exact hprop.isClosedMap _
    (HironakaEmbeddedDimensionParts.isComplexAnalyticSubset_dimensionPart hC k).isClosed

/-- **The set of critical values of a proper holomorphic map is pluripolar** (in the sense of
`def:pluripolarsets`). -/
theorem locallyPluripolar_image_criticalSet
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) (hprop : IsProperMap f) :
    (SGPT.PSH.VariableComplexAtlas.ofFixedModel m Y).LocallyPluripolar
      (f '' criticalSet n m f) :=
  SGPT.PSH.VariableComplexAtlas.locallyPluripolar_of_in_chart
    (A := SGPT.PSH.VariableComplexAtlas.ofFixedModel m Y)
    (fun e => ModificationMassInvariance.manifoldLocallyPluripolar_of_isComplexAnalyticSubset
      (isComplexAnalyticSubset_image_criticalSet hf hprop) (interior_image_criticalSet hf hprop) e)

/-- **Smoothness clause of `rmk:generalABT`**: for a proper holomorphic map `f : X → Y` of complex
manifolds, for quasi-every `y ∈ Y` the scheme-theoretic fibre `X_y` is smooth (of dimension
`dim X - dim Y`; possibly empty). Indeed every `y` off the pluripolar set of critical values is a
regular value (`isSmoothFibreOfDim_of_forall_surjective`). -/
theorem coPluripolar_isSmoothFibreOfDim
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f) (hprop : IsProperMap f) :
    (SGPT.PSH.VariableComplexAtlas.ofFixedModel m Y).CoPluripolar
      {y | IsSmoothFibreOfDim n m f y (n - m)} := by
  refine (locallyPluripolar_image_criticalSet hf hprop).mono fun y hy => ?_
  by_contra hyC
  apply hy
  refine isSmoothFibreOfDim_of_forall_surjective hf fun x hx => ?_
  by_contra hns
  exact hyC ⟨x, hns, hx⟩

end Critical

