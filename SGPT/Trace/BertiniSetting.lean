import SGPT.Projective.Maps
import SGPT.PSH.OhsawaTakegoshiRestriction
import SGPT.PSH.Pluripolar
import SGPT.Foundations.Analysis.Pending.GermIdealPullbackCalculus
import SGPT.Foundations.Analysis.Pending.LocalGiraudTransform
import SGPT.Foundations.Analysis.Pending.RegularPointDimension
import Mathlib.Geometry.Manifold.Complex
import SGPT.Foundations.Analysis.Pending.HolomorphicGermAlgebra

/-!
# The linear-system setting of the analytic Bertini theorems

Source: `chapter_trace.tex`, Section "Analytic Bertini theorems" (`thm:Bert`,
`rmk:trace:L787`). Let `X` be a connected projective manifold of dimension `n` and
`p : X → ℙᴺ` a morphism. The book writes `Λ = |𝒪_{ℙᴺ}(1)|` for the linear system of
hyperplanes of `ℙᴺ` and, for `H ∈ Λ`, `H ∩ X := p⁻¹H = H ×_{ℙᴺ} X`, the scheme-theoretic
inverse image (`rmk:trace:L787`).

* `HyperplaneSpace N`: the linear system `Λ = |𝒪_{ℙᴺ}(1)|`, i.e. the dual projective space:
  the point `[ℓ]` is the hyperplane `H_ℓ = {[Z] : ∑ ℓᵢ Zᵢ = 0}` (`hyperplane`, well defined by
  `mem_hyperplane_mk_iff`). It is the compact complex manifold `ℙᴺ` of `SGPT.Projective`, so
  pluripolar and co-pluripolar subsets of `Λ` are the book's (`def:pluripolarsets`,
  `SGPT.PSH.VariableComplexAtlas.CoPluripolar`).
* `isClosedSubmanifold_hyperplane`: every hyperplane is a closed complex submanifold of `ℙᴺ`
  (of dimension `N - 1`); in the chart `U_j` it is the zero set of the affine function
  `hyperplaneEquation ℓ j`.
* `member p ℓ = p⁻¹(H_ℓ)` and its local equations `memberEquation p ℓ j`
  (`mem_member_iff_memberEquation`): on `p⁻¹(U_j)` the member is the zero set of
  `x ↦ ⟨ℓ, Z(p x)/Z_j(p x)⟩`.
* `memberSubspace p hp ℓ`: the closed complex subspace `H ×_{ℙᴺ} X` of `X`, whose ideal sheaf
  is generated by the pullbacks of the ideal sheaf of `H` (`GermIdeal.pullback`); its support
  is `p⁻¹(H)` (`support_memberSubspace`). This is source `rmk:trace:L787`, first sentence.
* `IsSmoothHypersurfaceMember n p ℓ`: the local equations have nonvanishing differential on
  `p⁻¹(H_ℓ)`; then `p⁻¹(H_ℓ)` is a closed submanifold of dimension `n - 1`
  (`isClosedSubmanifold_member`) and `H_ℓ ×_{ℙᴺ} X` is reduced, i.e. smooth of dimension `n - 1`
  in the scheme sense (`isSmoothMemberOfDim_of_isSmoothHypersurfaceMember`).
* `IsNondegenerate p` (`p(X)` in no hyperplane; a base-point-free linear system is such a map) and
  `member_nonempty`: every member of a nondegenerate map is nonempty (maximum principle).
* `bertiniGoodSet p hp φ`: the set `𝒢` of `thm:Bert`, i.e. the `H ∈ Λ` such that `H ∩ X` is
  smooth (its support is a closed submanifold of some dimension `k` and its ideal sheaf is the
  reduced one) and `𝓘(φ|_{H ∩ X}) = Rest_{H ∩ X} 𝓘(φ)` at every point.
* `mem_bertiniGoodSet_of_member_eq_empty`: source `rmk:trace:L787`, second sentence: every
  `H` with `p⁻¹H = ∅` lies in `𝒢`.
* `AnalyticBertiniStatement`: the statement of `thm:Bert` (not proved here).
-/

set_option autoImplicit false

noncomputable section

open Set Filter
open scoped Topology Manifold ContDiff

namespace SGPT.Trace.Bertini

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
  SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
  SGPT.Foundations.Analysis.FirstPass.BlowupSequences
  SGPT.Foundations.Analysis.Pending
  SGPT.Projective SGPT.Projective.ComplexProjectiveSpace SGPT.PSH.IdealRestriction

variable {N : ℕ}

/-! ### Hyperplanes of `ℙᴺ` and the dual projective space -/

/-- The pairing `⟨ℓ, v⟩ = ∑ ℓᵢ vᵢ` between a linear form `ℓ` and a vector `v` of `ℂ^{N+1}`. -/
def pairing (l v : Fin (N + 1) → ℂ) : ℂ := ∑ i, l i * v i

theorem pairing_smul_left (c : ℂ) (l v : Fin (N + 1) → ℂ) :
    pairing (c • l) v = c * pairing l v := by
  simp only [pairing, Pi.smul_apply, smul_eq_mul, Finset.mul_sum, mul_assoc]

theorem pairing_smul_right (c : ℂ) (l v : Fin (N + 1) → ℂ) :
    pairing l (c • v) = c * pairing l v := by
  simp only [pairing, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

/-- In the chart `U_j`, `⟨ℓ, insertNth j 1 w⟩ = ℓ_j + ∑ₖ ℓ_{j.succAbove k} w_k`. -/
theorem pairing_affineLift (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) (w : ComplexModel N) :
    pairing l (affineLift j w) = l j + ∑ k : Fin N, l (j.succAbove k) * w k := by
  rw [pairing, Fin.sum_univ_succAbove _ j]
  simp [affineLift]

variable (N) in
/-- The linear system `Λ = |𝒪_{ℙᴺ}(1)|` of hyperplanes of `ℙᴺ`, identified with the dual
projective space: the point `[ℓ]` is the hyperplane `H_ℓ = {[Z] : ∑ ℓᵢ Zᵢ = 0}` (the divisor
of the section `∑ ℓᵢ Zᵢ` of `𝒪(1)`). It carries the complex structure of `ℙᴺ`. -/
abbrev HyperplaneSpace : Type := ComplexProjectiveSpace N

/-- `z ∈ H_ℓ`: the point `z` of `ℙᴺ` lies on the hyperplane `H_ℓ`. -/
def IsIncident (l : HyperplaneSpace N) (z : ComplexProjectiveSpace N) : Prop :=
  pairing l.rep z.rep = 0

/-- Incidence is well defined on homogeneous coordinates. -/
theorem isIncident_mk_mk_iff {l v : Fin (N + 1) → ℂ} (hl : l ≠ 0) (hv : v ≠ 0) :
    IsIncident (mk l hl) (mk v hv) ↔ pairing l v = 0 := by
  obtain ⟨a, ha, hla⟩ := rep_smul (mk l hl) hl rfl
  obtain ⟨b, hb, hvb⟩ := rep_smul (mk v hv) hv rfl
  rw [IsIncident, hla, hvb, pairing_smul_left, pairing_smul_right]
  simp [ha, hb]

/-- The hyperplane `H_ℓ ⊆ ℙᴺ` of a point `ℓ` of the dual projective space. -/
def hyperplane (l : HyperplaneSpace N) : Set (ComplexProjectiveSpace N) := {z | IsIncident l z}

theorem mem_hyperplane_mk_iff (l : HyperplaneSpace N) {v : Fin (N + 1) → ℂ} (hv : v ≠ 0) :
    mk v hv ∈ hyperplane l ↔ pairing l.rep v = 0 := by
  have h := isIncident_mk_mk_iff l.rep_ne_zero hv
  rw [mk_rep] at h
  exact h

/-- The affine equation of `H_ℓ` in the chart `U_j`: `z ↦ ⟨ℓ, insertNth j 1 (affineChart j z)⟩`. -/
def hyperplaneEquation (l : HyperplaneSpace N) (j : Fin (N + 1)) :
    ComplexProjectiveSpace N → ℂ :=
  fun z => pairing l.rep (affineLift j (affineChart j z))

theorem mem_hyperplane_iff_hyperplaneEquation (l : HyperplaneSpace N) (j : Fin (N + 1))
    {z : ComplexProjectiveSpace N} (hz : z ∈ (affineChart j).source) :
    z ∈ hyperplane l ↔ hyperplaneEquation l j z = 0 := by
  conv_lhs => rw [eq_mk_affineLift_affineChart j hz]
  exact mem_hyperplane_mk_iff l _

/-- The linear part `w ↦ ∑ₖ ℓ_{j.succAbove k} w_k` of the affine equation of `H_ℓ` in `U_j`. -/
def hyperplaneLinearPart (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) :
    ComplexModel N →L[ℂ] ℂ :=
  ∑ k : Fin N, l (j.succAbove k) • (EuclideanSpace.proj k : ComplexModel N →L[ℂ] ℂ)

theorem hyperplaneLinearPart_apply (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) (w : ComplexModel N) :
    hyperplaneLinearPart l j w = ∑ k : Fin N, l (j.succAbove k) * w k := by
  simp [hyperplaneLinearPart]

/-- In the chart `U_j` the equation of `H_ℓ` is the affine function `ℓ_j + ∑ₖ ℓ_{j.succAbove k} w_k`. -/
theorem hasFDerivAt_pairing_affineLift (l : Fin (N + 1) → ℂ) (j : Fin (N + 1))
    (w : ComplexModel N) :
    HasFDerivAt (fun w => pairing l (affineLift j w)) (hyperplaneLinearPart l j) w := by
  have heq : (fun w => pairing l (affineLift j w)) =
      fun w => l j + hyperplaneLinearPart l j w := by
    funext w
    rw [pairing_affineLift, hyperplaneLinearPart_apply]
  rw [heq]
  exact (hyperplaneLinearPart l j).hasFDerivAt.const_add (l j)

theorem pairing_affineLift_eq (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) :
    (fun w => pairing l (affineLift j w)) = fun w => l j + hyperplaneLinearPart l j w := by
  funext w
  rw [pairing_affineLift, hyperplaneLinearPart_apply]

theorem contDiff_pairing_affineLift (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) :
    ContDiff ℂ ∞ (fun w => pairing l (affineLift j w)) := by
  rw [pairing_affineLift_eq]
  exact contDiff_const.add (hyperplaneLinearPart l j).contDiff

theorem differentiable_pairing_affineLift (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) :
    Differentiable ℂ (fun w => pairing l (affineLift j w)) :=
  fun w => (hasFDerivAt_pairing_affineLift l j w).differentiableAt

theorem continuous_pairing_affineLift (l : Fin (N + 1) → ℂ) (j : Fin (N + 1)) :
    Continuous (fun w => pairing l (affineLift j w)) :=
  (differentiable_pairing_affineLift l j).continuous

/-- At a zero of the affine equation of `H_ℓ` in `U_j`, some coefficient `ℓ_{j.succAbove k}` is
nonzero (otherwise `ℓ = ℓ_j e_j` and the equation is the nonzero constant `ℓ_j`). -/
theorem exists_coeff_ne_zero_of_pairing_affineLift_eq_zero {l : Fin (N + 1) → ℂ} (hl : l ≠ 0)
    {j : Fin (N + 1)} {w : ComplexModel N} (hw : pairing l (affineLift j w) = 0) :
    ∃ k : Fin N, l (j.succAbove k) ≠ 0 := by
  by_contra h
  push Not at h
  apply hl
  have hj : l j = 0 := by
    rw [pairing_affineLift] at hw
    simpa [h] using hw
  funext i
  refine Fin.succAboveCases j ?_ (fun k => ?_) i
  · exact hj
  · exact h k

theorem continuousOn_hyperplaneEquation (l : HyperplaneSpace N) (j : Fin (N + 1)) :
    ContinuousOn (hyperplaneEquation l j) (affineChart j).source :=
  (continuous_pairing_affineLift l.rep j).comp_continuousOn (affineChart j).continuousOn

/-- The affine chart domain `U_j` as an open set. -/
def affineOpens (j : Fin (N + 1)) : TopologicalSpace.Opens (ComplexProjectiveSpace N) :=
  ⟨(affineChart j).source, (affineChart j).open_source⟩

theorem isOpenCover_affineOpens : TopologicalSpace.IsOpenCover (affineOpens (N := N)) := by
  rw [TopologicalSpace.IsOpenCover, eq_top_iff]
  intro z _
  obtain ⟨j, hj⟩ := exists_mem_affineChart_source z
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨j, hj⟩

/-- Every hyperplane of `ℙᴺ` is closed. -/
theorem isClosed_hyperplane (l : HyperplaneSpace N) : IsClosed (hyperplane l) := by
  rw [isOpenCover_affineOpens.isClosed_iff_coe_preimage]
  intro j
  have hc : Continuous fun z : affineOpens j => hyperplaneEquation l j z.1 :=
    (continuousOn_hyperplaneEquation l j).comp_continuous continuous_subtype_val
      (fun z => z.2)
  have heq : ((↑) ⁻¹' hyperplane l : Set (affineOpens j)) =
      (fun z : affineOpens j => hyperplaneEquation l j z.1) ⁻¹' {0} := by
    ext z
    simp only [mem_preimage, mem_singleton_iff]
    exact mem_hyperplane_iff_hyperplaneEquation l j z.2
  rw [heq]
  exact isClosed_singleton.preimage hc

/-- The equation of `H_ℓ` in `U_j` is holomorphic on `U_j`. -/
theorem contMDiffAt_hyperplaneEquation (l : HyperplaneSpace N) (j : Fin (N + 1))
    {z : ComplexProjectiveSpace N} (hz : z ∈ (affineChart j).source) :
    ContMDiffAt 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ℂ) ∞ (hyperplaneEquation l j) z := by
  have h1 : ContMDiffAt 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ℂ) ∞
      (fun w : ComplexModel N => pairing l.rep (affineLift j w)) (affineChart j z) :=
    (contDiff_pairing_affineLift l.rep j).contMDiff.contMDiffAt
  exact h1.comp z (contMDiffAt_affineChart j hz)

theorem holomorphicAt_hyperplaneEquation (l : HyperplaneSpace N) (j : Fin (N + 1))
    {z : ComplexProjectiveSpace N} (hz : z ∈ (affineChart j).source) :
    HolomorphicAt N (hyperplaneEquation l j) z := by
  filter_upwards [(affineChart j).open_source.mem_nhds hz] with y hy
  exact (contMDiffAt_hyperplaneEquation l j hy).mdifferentiableAt (by simp)

/-- The chart `U_j` as a chart of the atlas of `ℙᴺ`. -/
def affineComplexChart (j : Fin (N + 1)) : ComplexChart N (ComplexProjectiveSpace N) :=
  ⟨affineChart j, affineChart_mem_atlas j⟩

/-- At every point of `H_ℓ ∩ U_j` the equation of `H_ℓ` has a nonzero chart derivative. -/
theorem exists_chartDeriv_hyperplaneEquation_ne_zero (l : HyperplaneSpace N) (j : Fin (N + 1))
    {z : ComplexProjectiveSpace N} (hz : z ∈ (affineChart j).source)
    (hz0 : hyperplaneEquation l j z = 0) :
    ∃ (e : ComplexChart N (ComplexProjectiveSpace N)) (v : ComplexModel N),
      z ∈ e.val.source ∧ DerivativeIdeal.chartDeriv e v (hyperplaneEquation l j) z ≠ 0 := by
  obtain ⟨k, hk⟩ := exists_coeff_ne_zero_of_pairing_affineLift_eq_zero l.rep_ne_zero hz0
  refine ⟨affineComplexChart j, EuclideanSpace.single k 1, hz, ?_⟩
  have hfun : (hyperplaneEquation l j ∘ (affineComplexChart j).val.symm) =
      fun w => pairing l.rep (affineLift j w) := by
    funext w
    simp [hyperplaneEquation, affineComplexChart]
  rw [DerivativeIdeal.chartDeriv, hfun,
    (hasFDerivAt_pairing_affineLift l.rep j _).fderiv, hyperplaneLinearPart_apply]
  have hsum : ∑ k' : Fin N, l.rep (j.succAbove k') *
      (EuclideanSpace.single k (1 : ℂ) : ComplexModel N) k' = l.rep (j.succAbove k) := by
    rw [Finset.sum_eq_single k]
    · simp
    · intro b _ hb
      simp [hb]
    · simp
  rw [hsum]
  exact hk

/-- Every hyperplane of `ℙᴺ` is regular of dimension `N - 1` at each of its points. -/
theorem regularAtDim_hyperplane (l : HyperplaneSpace N) {z : ComplexProjectiveSpace N}
    (hz : z ∈ hyperplane l) : RegularAtDim (n := N) (hyperplane l) z (N - 1) := by
  set j := chartIndex z
  have hzj : z ∈ (affineChart j).source := mem_affineChart_chartIndex z
  have hreg := LocalGiraudTransform.regularAtDim_zeroSet (affineChart j).open_source
    (fun y hy => holomorphicAt_hyperplaneEquation l j hy)
    (fun y hy hy0 => exists_chartDeriv_hyperplaneEquation_ne_zero l j hy hy0) hzj
    ((mem_hyperplane_iff_hyperplaneEquation l j hzj).mp hz)
  refine RegularPointDimension.regularAtDim_of_inter_eq (affineChart j).open_source hzj ?_ hreg
  ext y
  simp only [mem_inter_iff, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨⟨hy0, hy⟩, -⟩
    exact ⟨(mem_hyperplane_iff_hyperplaneEquation l j hy).mpr hy0, hy⟩
  · rintro ⟨hyH, hy⟩
    exact ⟨⟨(mem_hyperplane_iff_hyperplaneEquation l j hy).mp hyH, hy⟩, hy⟩

/-- Every hyperplane of `ℙᴺ` is a closed complex submanifold. -/
theorem isClosedSubmanifold_hyperplane (l : HyperplaneSpace N) :
    IsClosedSubmanifold N (hyperplane l) :=
  ⟨isClosed_hyperplane l, fun _ hz => ⟨N - 1, regularAtDim_hyperplane l hz⟩⟩

/-! ### Members of the linear system on `X` -/

section Member

variable {n : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] (p : X → ComplexProjectiveSpace N)

/-- The member `p⁻¹(H_ℓ) ⊆ X` (as a set: the support of `H_ℓ ∩ X`). -/
def member (l : HyperplaneSpace N) : Set X := p ⁻¹' hyperplane l

theorem isClosed_member (hp : Continuous p) (l : HyperplaneSpace N) : IsClosed (member p l) :=
  (isClosed_hyperplane l).preimage hp

/-- The local equation of `p⁻¹(H_ℓ)` on `p⁻¹(U_j)`: `x ↦ ⟨ℓ, Z(p x)/Z_j(p x)⟩`, the pullback
of the equation of `H_ℓ` in `U_j`. -/
def memberEquation (l : HyperplaneSpace N) (j : Fin (N + 1)) : X → ℂ :=
  fun x => hyperplaneEquation l j (p x)

omit [TopologicalSpace X] in
theorem mem_member_iff_memberEquation (l : HyperplaneSpace N) (j : Fin (N + 1)) {x : X}
    (hx : p x ∈ (affineChart j).source) :
    x ∈ member p l ↔ memberEquation p l j x = 0 :=
  mem_hyperplane_iff_hyperplaneEquation l j hx

omit [IsComplexManifold n X] in
theorem holomorphicAt_memberEquation
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    (l : HyperplaneSpace N) (j : Fin (N + 1)) {x : X} (hx : p x ∈ (affineChart j).source) :
    HolomorphicAt n (memberEquation p l j) x := by
  have hU : IsOpen (p ⁻¹' (affineChart j).source) :=
    (affineChart j).open_source.preimage hp.continuous
  filter_upwards [hU.mem_nhds hx] with y hy
  exact ((contMDiffAt_hyperplaneEquation l j hy).comp y hp.contMDiffAt).mdifferentiableAt
    (by simp)

variable (n) in
/-- `p⁻¹(H_ℓ)` is a smooth hypersurface: at each of its points the local equation in every chart
`U_j ∋ p(x)` has a nonzero differential. -/
def IsSmoothHypersurfaceMember (l : HyperplaneSpace N) : Prop :=
  ∀ x ∈ member p l, ∀ j : Fin (N + 1), p x ∈ (affineChart j).source →
    ∃ (e : ComplexChart n X) (v : ComplexModel n),
      x ∈ e.val.source ∧ DerivativeIdeal.chartDeriv e v (memberEquation p l j) x ≠ 0

/-- A smooth hypersurface member is regular of dimension `n - 1` at each of its points. -/
theorem regularAtDim_member (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    {l : HyperplaneSpace N} (hl : IsSmoothHypersurfaceMember n p l) {x : X} (hx : x ∈ member p l) :
    RegularAtDim (n := n) (member p l) x (n - 1) := by
  set j := chartIndex (p x)
  have hxj : p x ∈ (affineChart j).source := mem_affineChart_chartIndex (p x)
  have hU : IsOpen (p ⁻¹' (affineChart j).source) :=
    (affineChart j).open_source.preimage hp.continuous
  have hreg := LocalGiraudTransform.regularAtDim_zeroSet hU
    (fun y hy => holomorphicAt_memberEquation p hp l j hy)
    (fun y hy hy0 => hl y ((mem_member_iff_memberEquation p l j hy).mpr hy0) j hy) hxj
    ((mem_member_iff_memberEquation p l j hxj).mp hx)
  refine RegularPointDimension.regularAtDim_of_inter_eq hU hxj ?_ hreg
  ext y
  simp only [mem_inter_iff, Set.mem_ofPred_eq, mem_preimage]
  constructor
  · rintro ⟨⟨hy0, hy⟩, -⟩
    exact ⟨(mem_member_iff_memberEquation p l j hy).mpr hy0, hy⟩
  · rintro ⟨hyM, hy⟩
    exact ⟨⟨(mem_member_iff_memberEquation p l j hy).mp hyM, hy⟩, hy⟩

/-- A smooth hypersurface member is a closed complex submanifold of `X`. -/
theorem isClosedSubmanifold_member
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    {l : HyperplaneSpace N} (hl : IsSmoothHypersurfaceMember n p l) :
    IsClosedSubmanifold n (member p l) :=
  ⟨isClosed_member p hp.continuous l, fun _ hx => ⟨n - 1, regularAtDim_member p hp hl hx⟩⟩

/-! ### The scheme-theoretic inverse image `H ×_{ℙᴺ} X` -/

/-- Source `rmk:trace:L787`: `H ∩ X := p⁻¹H = H ×_{ℙᴺ} X`, the scheme-theoretic inverse image
of the hyperplane `H = H_ℓ`. It is the closed complex subspace of `X` whose ideal sheaf
`𝓘_H 𝒪_X` is generated by the pullbacks of the germs of the ideal sheaf `𝓘_H` of `H`
(locally by the single pulled-back equation `memberEquation p ℓ j`). -/
def memberSubspace (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    (l : HyperplaneSpace N) : ClosedComplexSubspace n X :=
  ⟨GermIdeal.pullback (m := n) p (vanishingIdeal (n := N) (hyperplane l)),
    GermIdealPullbackCalculus.isCoherent_pullback hp
      (VanishingIdealCoherent.isCoherent_vanishingIdeal (isClosedSubmanifold_hyperplane l))⟩

/-- Off the closed set `A`, the constant `1` lies in the ideal of germs vanishing on `A`. -/
theorem vanishingIdeal_mem_one_of_notMem {k : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel k) M] [IsComplexManifold k M] {A : Set M} (hA : IsClosed A)
    {y : M} (hy : y ∉ A) : (vanishingIdeal (n := k) A).mem y (fun _ => (1 : ℂ)) := by
  refine ⟨Eventually.of_forall fun z => mdifferentiableAt_const, ?_⟩
  filter_upwards [hA.isOpen_compl.mem_nhds hy] with z hz hzA
  exact absurd hzA hz

/-- Off `p⁻¹(H)` every holomorphic germ lies in the ideal of `H ×_{ℙᴺ} X`. -/
theorem memberSubspace_mem_of_notMem
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (l : HyperplaneSpace N)
    {x : X} (hx : x ∉ member p l) {g : X → ℂ} (hg : HolomorphicAt n g x) :
    (memberSubspace p hp l).ideal.mem x g := by
  refine ⟨hg, 1, fun _ => fun _ => (1 : ℂ), fun _ => g, ?_, fun _ => hg, ?_⟩
  · intro _
    exact ⟨fun _ => (1 : ℂ), vanishingIdeal_mem_one_of_notMem (isClosed_hyperplane l) hx, rfl⟩
  · exact Eventually.of_forall fun y => by simp

/-- The support of `H ×_{ℙᴺ} X` is the set-theoretic inverse image `p⁻¹(H)`. -/
theorem support_memberSubspace
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (l : HyperplaneSpace N) :
    (memberSubspace p hp l).support = member p l := by
  ext x
  constructor
  · intro hx
    by_contra hxM
    have h1 := hx (fun _ => (1 : ℂ))
      (memberSubspace_mem_of_notMem p hp l hxM (Eventually.of_forall fun _ =>
        mdifferentiableAt_const))
    exact one_ne_zero h1
  · intro hxM g hg
    obtain ⟨-, K, s, a, hs, -, hga⟩ := hg
    rw [hga.eq_of_nhds]
    refine Finset.sum_eq_zero fun i _ => ?_
    obtain ⟨b, hb, hsb⟩ := hs i
    rw [hsb]
    have hbx : b (p x) = 0 := by
      obtain ⟨-, hev⟩ := hb
      exact hev.self_of_nhds hxM
    simp [hbx]

/-! ### The set `𝒢` of the analytic Bertini theorem -/

/-- `H ∩ X` is smooth of dimension `k`: its support `p⁻¹(H)` is regular of dimension `k` at
each of its points and its ideal sheaf is the reduced one, `𝓘_{H ∩ X} = 𝓘_{p⁻¹(H)}`. -/
def IsSmoothMemberOfDim (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    (l : HyperplaneSpace N) (k : ℕ) : Prop :=
  (∀ x ∈ member p l, RegularAtDim (n := n) (member p l) x k) ∧
    ∀ x g, (memberSubspace p hp l).ideal.mem x g ↔ (vanishingIdeal (n := n) (member p l)).mem x g

/-- Source `thm:Bert`, the set
`𝒢 = {H ∈ |𝒪_{ℙᴺ}(1)| : H' = H ∩ X is smooth and 𝓘(φ|_{H'}) = Rest_{H'}(𝓘(φ))}`.
`H'` is smooth of some dimension `k`; `𝓘(φ|_{H'})` is the multiplier ideal sheaf of the
restriction on the complex manifold `↥H'` (`k`-dimensional, `SubmanifoldChartedSpace`), and
`Rest_{H'} 𝓘(φ)` is the book's restriction ideal (`def:restidealsheaf`); the two germ rings are
identified by `SGPT.PSH.OhsawaTakegoshi.structureStalkEquiv`. The convention `𝓘(-∞) = 0` holds
automatically: where `φ|_{H'} ≡ -∞` no nonzero germ is square integrable. -/
def bertiniGoodSet (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p)
    (φ : X → EReal) : Set (HyperplaneSpace N) :=
  {l | ∃ (k : ℕ) (hk : k ≤ n) (hsm : IsSmoothMemberOfDim p hp l k),
    letI := SubmanifoldChartedSpace.chartedSpace hk hsm.1
    ∀ q : member p l,
      Ideal.comap (SGPT.PSH.OhsawaTakegoshi.structureStalkEquiv hk hsm.1
          ⟨isClosed_member p hp.continuous l, fun _ hx => ⟨k, hsm.1 _ hx⟩⟩ q)
          (stalkIdeal (multiplierIdeal (n := k) 1 (fun y : member p l => φ y.1)) q) =
        restStalk (multiplierIdeal (n := n) 1 φ)
          (SGPT.PSH.OhsawaTakegoshi.submanifoldSubspace
            (⟨isClosed_member p hp.continuous l, fun _ hx => ⟨k, hsm.1 _ hx⟩⟩ :
              IsClosedSubmanifold n (member p l))) q.1}

/-- If `p⁻¹(H) = ∅`, then `H ∩ X` is smooth (of every dimension): its ideal sheaf is the unit
ideal everywhere. -/
theorem isSmoothMemberOfDim_of_member_eq_empty
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) {l : HyperplaneSpace N}
    (hl : member p l = ∅) (k : ℕ) : IsSmoothMemberOfDim p hp l k := by
  refine ⟨fun x hx => by rw [hl] at hx; exact absurd hx (notMem_empty x), fun x g => ?_⟩
  have hx : x ∉ member p l := by rw [hl]; exact notMem_empty x
  constructor
  · intro hg
    refine ⟨hg.1, Eventually.of_forall fun y hy => ?_⟩
    rw [hl] at hy
    exact absurd hy (notMem_empty y)
  · intro hg
    exact memberSubspace_mem_of_notMem p hp l hx hg.1

/-- Source `rmk:trace:L787`, second sentence: by definition, every `H ∈ |𝒪_{ℙᴺ}(1)|` with
`p⁻¹H = ∅` lies in `𝒢`. -/
theorem mem_bertiniGoodSet_of_member_eq_empty
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (φ : X → EReal)
    {l : HyperplaneSpace N} (hl : member p l = ∅) : l ∈ bertiniGoodSet p hp φ := by
  refine ⟨0, Nat.zero_le n, isSmoothMemberOfDim_of_member_eq_empty p hp hl 0, ?_⟩
  intro q
  exact absurd q.2 (Set.eq_empty_iff_forall_notMem.mp hl q)

/-- Germs of the ideal of `H ×_{ℙᴺ} X` vanish on `p⁻¹(H)` near the point. -/
theorem memberSubspace_mem_vanishingIdeal
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (l : HyperplaneSpace N)
    {x : X} {g : X → ℂ} (hg : (memberSubspace p hp l).ideal.mem x g) :
    (vanishingIdeal (n := n) (member p l)).mem x g := by
  obtain ⟨hgh, K, s, a, hs, -, hga⟩ := hg
  refine ⟨hgh, ?_⟩
  have hev : ∀ i, ∀ᶠ y in 𝓝 x, y ∈ member p l → s i y = 0 := by
    intro i
    obtain ⟨b, hb, hsb⟩ := hs i
    obtain ⟨-, hbev⟩ := hb
    have hbev' : ∀ᶠ y in 𝓝 x, p y ∈ hyperplane l → b (p y) = 0 :=
      hp.continuous.continuousAt.eventually hbev
    filter_upwards [hbev'] with y hy hyM
    rw [hsb]
    exact hy hyM
  filter_upwards [hga, Filter.eventually_all.mpr hev] with y hy hy0 hyM
  rw [hy]
  exact Finset.sum_eq_zero fun i _ => by rw [hy0 i hyM, mul_zero]

/-- The equation of `H_ℓ` in `U_j` lies in the ideal of `H_ℓ` at points of `U_j`. -/
theorem hyperplaneEquation_mem_vanishingIdeal (l : HyperplaneSpace N) (j : Fin (N + 1))
    {z : ComplexProjectiveSpace N} (hz : z ∈ (affineChart j).source) :
    (vanishingIdeal (n := N) (hyperplane l)).mem z (hyperplaneEquation l j) := by
  refine ⟨holomorphicAt_hyperplaneEquation l j hz, ?_⟩
  filter_upwards [(affineChart j).open_source.mem_nhds hz] with y hy hyH
  exact (mem_hyperplane_iff_hyperplaneEquation l j hy).mp hyH

/-- **A smooth hypersurface member is reduced**: if `p⁻¹(H_ℓ)` is a smooth hypersurface, the
ideal sheaf of `H_ℓ ×_{ℙᴺ} X` is the ideal of germs vanishing on `p⁻¹(H_ℓ)`; at a point of
`p⁻¹(U_j)` both are generated by the local equation `s_{ℓ,j}`
(`LocalGiraudTransform.vanishingIdeal_zeroSet_mem_iff`). -/
theorem isSmoothMemberOfDim_of_isSmoothHypersurfaceMember
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) {l : HyperplaneSpace N}
    (hl : IsSmoothHypersurfaceMember n p l) : IsSmoothMemberOfDim p hp l (n - 1) := by
  refine ⟨fun x hx => regularAtDim_member p hp hl hx, fun x g => ⟨fun hg =>
    memberSubspace_mem_vanishingIdeal p hp l hg, fun hg => ?_⟩⟩
  by_cases hxM : x ∈ member p l
  · set j := chartIndex (p x)
    have hxj : p x ∈ (affineChart j).source := mem_affineChart_chartIndex (p x)
    have hU : IsOpen (p ⁻¹' (affineChart j).source) :=
      (affineChart j).open_source.preimage hp.continuous
    have hzero : (vanishingIdeal (n := n) ({y | memberEquation p l j y = 0} ∩
        p ⁻¹' (affineChart j).source)).mem x g := by
      refine ⟨hg.1, ?_⟩
      filter_upwards [hg.2, hU.mem_nhds hxj] with y hy hyU hy0
      exact hy ((mem_member_iff_memberEquation p l j hyU).mpr hy0.1)
    have hspan := (LocalGiraudTransform.vanishingIdeal_zeroSet_mem_iff hU
      (fun y hy => holomorphicAt_memberEquation p hp l j hy)
      (fun y hy hy0 => hl y ((mem_member_iff_memberEquation p l j hy).mpr hy0) j hy) hxj g).mp
      hzero
    show IsInSpanAt (n := n)
      (fun s => ∃ a, (vanishingIdeal (n := N) (hyperplane l)).mem (p x) a ∧ s = a ∘ p) x g
    refine IsInSpanAt.mono ?_ hspan
    rintro s rfl
    exact ⟨hyperplaneEquation l j, hyperplaneEquation_mem_vanishingIdeal l j hxj, rfl⟩
  · exact memberSubspace_mem_of_notMem p hp l hxM hg.1

/-! ### Nondegenerate maps: base-point-free linear systems -/

/-- `p` is *nondegenerate*: `p(X)` lies in no hyperplane. A base-point-free linear system
`Λ = ℙ(V)`, `V ⊆ H⁰(X, L)`, is the same as its morphism `p : X → ℙ(V^∨)`, which is
nondegenerate because `V → H⁰(X, L)` is injective; its members are the `p⁻¹(H)`,
`H ∈ |𝒪(1)| = ℙ(V)`. -/
def IsNondegenerate : Prop := ∀ l : HyperplaneSpace N, ∃ x, p x ∉ hyperplane l

omit [TopologicalSpace X] in
/-- Off `p⁻¹(H_ℓ)`, near `x`, the degree-zero ratio `Z_m(p y)/⟨ℓ, Z(p y)⟩` is read in the chart
`U_j ∋ p(x)` as `(Z_m/Z_j)(p y) / s_{ℓ,j}(y)`. -/
theorem rep_div_pairing_eq (l : HyperplaneSpace N) (j : Fin (N + 1)) (m : Fin (N + 1)) {y : X}
    (hy : p y ∈ (affineChart j).source) :
    (p y).rep m / pairing l.rep (p y).rep =
      affineLift j (affineChart j (p y)) m / memberEquation p l j y := by
  obtain ⟨c, hc, hrep⟩ := rep_smul (p y) (affineLift_ne_zero j _)
    (eq_mk_affineLift_affineChart j hy)
  rw [hrep, pairing_smul_right]
  simp only [Pi.smul_apply, smul_eq_mul, memberEquation, hyperplaneEquation]
  by_cases h0 : pairing l.rep (affineLift j (affineChart j (p y))) = 0
  · simp [h0]
  · field_simp

omit [IsComplexManifold n X] in
/-- If `p(X)` misses `H_ℓ`, the degree-zero ratios `Z_m(p x)/⟨ℓ, Z(p x)⟩` are holomorphic. -/
theorem mdifferentiable_rep_div_pairing
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) {l : HyperplaneSpace N}
    (hoff : ∀ x, p x ∉ hyperplane l) (m : Fin (N + 1)) :
    MDifferentiable 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ)
      (fun x => (p x).rep m / pairing l.rep (p x).rep) := by
  intro x
  set j := chartIndex (p x)
  have hxj : p x ∈ (affineChart j).source := mem_affineChart_chartIndex (p x)
  have hU : IsOpen (p ⁻¹' (affineChart j).source) :=
    (affineChart j).open_source.preimage hp.continuous
  have hden : pairing l.rep (affineLift j (affineChart j (p x))) ≠ 0 := fun h =>
    hoff x ((mem_member_iff_memberEquation p l j hxj).mpr h)
  have hnum : DifferentiableAt ℂ (fun w : ComplexModel N => affineLift j w m)
      (affineChart j (p x)) := differentiable_affineLift_apply j m _
  have hd : DifferentiableAt ℂ (fun w : ComplexModel N => pairing l.rep (affineLift j w))
      (affineChart j (p x)) := differentiable_pairing_affineLift l.rep j _
  have hψ : DifferentiableAt ℂ
      (fun w : ComplexModel N => affineLift j w m / pairing l.rep (affineLift j w))
      (affineChart j (p x)) := by
    simp only [div_eq_mul_inv]
    exact hnum.mul (hd.inv hden)
  have hchart : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N)
      (fun y => affineChart j (p y)) x :=
    ((contMDiffAt_affineChart j hxj).comp x hp.contMDiffAt).mdifferentiableAt (by simp)
  have hcomp : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ)
      (fun y => affineLift j (affineChart j (p y)) m / memberEquation p l j y) x :=
    hψ.mdifferentiableAt.comp x hchart
  refine hcomp.congr_of_eventuallyEq ?_
  filter_upwards [hU.mem_nhds hxj] with y hy
  exact rep_div_pairing_eq p l j m hy

/-- Every point of `ℙᴺ`, `N ≥ 1`, lies on some hyperplane. -/
theorem exists_mem_hyperplane (hN : 1 ≤ N) (z : ComplexProjectiveSpace N) :
    ∃ l : HyperplaneSpace N, z ∈ hyperplane l := by
  obtain ⟨i, hi⟩ := exists_rep_ne_zero z
  obtain ⟨k, hk⟩ : ∃ k : Fin (N + 1), k ≠ i := by
    by_cases h0 : i = 0
    · refine ⟨⟨1, by omega⟩, ?_⟩
      rw [h0]
      intro h
      simp [Fin.ext_iff] at h
    · exact ⟨0, fun h => h0 h.symm⟩
  set v := z.rep
  let l : Fin (N + 1) → ℂ := Pi.single i (v k) - Pi.single k (v i)
  have hl : l ≠ 0 := by
    intro h
    have := congrFun h k
    simp [l, hk] at this
    exact hi this
  refine ⟨mk l hl, ?_⟩
  have h := isIncident_mk_mk_iff hl z.rep_ne_zero
  rw [mk_rep] at h
  show IsIncident (mk l hl) z
  rw [h]
  simp only [pairing, l, Pi.sub_apply, sub_mul, Finset.sum_sub_distrib, Pi.single_apply,
    ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true, v]
  ring

/-- Members of a nondegenerate map (a base-point-free linear system) are nonempty:
otherwise the degree-zero ratios `Z_m(p x)/⟨ℓ, Z(p x)⟩` would be holomorphic on the compact
connected `X`, hence constant, so `p` would be constant and `p(X)` would lie in a hyperplane. -/
theorem member_nonempty [CompactSpace X] [ConnectedSpace X]
    (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (hnd : IsNondegenerate p)
    (hN : 1 ≤ N) (l : HyperplaneSpace N) : (member p l).Nonempty := by
  by_contra hne
  have hoff : ∀ x, p x ∉ hyperplane l := fun x hx => hne ⟨x, hx⟩
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  have hpair : ∀ y, pairing l.rep (p y).rep ≠ 0 := fun y h => by
    apply hoff y
    have := mem_hyperplane_mk_iff l (p y).rep_ne_zero
    rw [mk_rep] at this
    exact this.mpr h
  have hconst : ∀ y m, (p y).rep m / pairing l.rep (p y).rep =
      (p x₀).rep m / pairing l.rep (p x₀).rep := fun y m =>
    MDifferentiable.apply_eq_of_compactSpace (mdifferentiable_rep_div_pairing p hp hoff m) y x₀
  have hpy : ∀ y, p y = p x₀ := by
    intro y
    have hy : (p y).rep = (pairing l.rep (p y).rep / pairing l.rep (p x₀).rep) • (p x₀).rep := by
      funext m
      have := hconst y m
      simp only [Pi.smul_apply, smul_eq_mul]
      field_simp [hpair y, hpair x₀] at this ⊢
      linear_combination this
    have hc : pairing l.rep (p y).rep / pairing l.rep (p x₀).rep ≠ 0 :=
      div_ne_zero (hpair y) (hpair x₀)
    rw [← mk_rep (p y), ← mk_rep (p x₀)]
    exact (mk_eq_mk_iff _ _).mpr ⟨_, hy.symm⟩
  obtain ⟨l', hl'⟩ := exists_mem_hyperplane hN (p x₀)
  obtain ⟨x, hx⟩ := hnd l'
  exact hx (by rw [hpy x]; exact hl')

end Member

/-! ### The statement of the analytic Bertini theorem -/

/-- A compact complex manifold is *projective* if it admits a holomorphic embedding (an injective
holomorphic immersion) into some projective space. -/
def IsProjectiveManifold (n : ℕ) (X : Type*) [TopologicalSpace X]
    [ChartedSpace (ComplexModel n) X] : Prop :=
  ∃ (M : ℕ) (ι : X → ComplexProjectiveSpace M),
    ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) ∞ ι ∧ Function.Injective ι ∧
      ∀ x, Function.Injective (mfderiv 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) ι x)

/-- Source `thm:Bert` (statement only; see `blueprint/src/claude-bertini.tex` for the route):
let `X` be a connected projective manifold, `φ ∈ QPSH(X)` and `p : X → ℙᴺ` a morphism, `N ≥ 1`.
Then `𝒢 ⊆ |𝒪_{ℙᴺ}(1)|` is co-pluripolar. -/
def AnalyticBertiniStatement : Prop :=
  ∀ (n N : ℕ) (X : Type) [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
    [IsComplexManifold n X] [CompactSpace X] [ConnectedSpace X],
    IsProjectiveManifold n X → 1 ≤ N →
    ∀ (p : X → ComplexProjectiveSpace N)
      (hp : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ p) (φ : X → EReal),
      ManifoldQuasiPlurisubharmonic (n := n) φ →
      (SGPT.PSH.VariableComplexAtlas.ofFixedModel N (HyperplaneSpace N)).CoPluripolar
        (bertiniGoodSet p hp φ)

end SGPT.Trace.Bertini
