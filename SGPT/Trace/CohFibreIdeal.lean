import SGPT.GAGA.CohRigidity
import SGPT.PSH.OhsawaTakegoshiRestriction
import Mathlib.Analysis.Complex.RemovableSingularity

/-!
# The ideal of a smooth fibre over `Δ*` is generated by `t - z`

Infrastructure of lane COHERENT (source `lma:fibIeq`, `chapter_trace.tex` lines 1166--1193;
blueprint `claude-coherent.tex`).

Let `f : X → Δ*` be holomorphic with coordinate `t` (`SGPT.GAGA.Coherent.coord`), and let the
fibre `X_z` be smooth (`SGPT.Trace.DirectImg.IsSmoothFibreOfDim`: its support is a submanifold
and the ideal `f^*𝔪_z 𝒪_X` of the scheme-theoretic fibre is the reduced ideal).

* `exists_dslope_factor`: a germ on `Δ*` vanishing at `z` is `(w - z) B(w)` (one-variable
  Hadamard lemma, `dslope`).
* `stalkIdeal_fibre_eq_span`: at every `y ∈ X_z`, the stalk of the ideal of `X_z` is `(t - z)`.
* `sup_span_eq_of_restStalk_eq`: equal restrictions `Rest_{X_z} I = Rest_{X_z} I'` at `y`
  (`def:restidealsheaf`) mean `I_y + (t - z) = I'_y + (t - z)`, the hypothesis of the rigidity
  theorem `SGPT.GAGA.Coherent.eq_of_dense_sup_eq`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open Set Filter
open scoped Topology Manifold ContDiff

namespace SGPT.Trace.CohFib

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
  SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending
  SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
  SGPT.Okounkov SGPT.PSH.IdealRestriction SGPT.GAGA.Coherent SGPT.Trace.DirectImg

/-- The preferred chart of `Δ*` is the inclusion into `ℂ¹`. -/
theorem chartAt_puncturedDisc_apply (z w : puncturedDisc) :
    chartAt (ComplexModel 1) z w = (w : ComplexModel 1) := by
  rw [AnalyticSubsetOpens.chartAt_opens_apply, chartAt_self_eq]
  rfl

theorem mem_chartAt_puncturedDisc_source (z w : puncturedDisc) :
    w ∈ (chartAt (ComplexModel 1) z).source := by
  rw [AnalyticSubsetOpens.mem_chartAt_opens_source, chartAt_self_eq]
  exact mem_univ _

/-- **One-variable Hadamard lemma on `Δ*`.** A germ at `z` vanishing at `z` is `(w - z) B(w)`
with `B` holomorphic near `z`. -/
theorem exists_dslope_factor (z : puncturedDisc) {a : puncturedDisc → ℂ}
    (ha : (vanishingIdeal (n := 1) ({z} : Set puncturedDisc)).mem z a) :
    ∃ B : ℂ → ℂ, (∀ᶠ c in 𝓝 ((z : ComplexModel 1) 0), DifferentiableAt ℂ B c) ∧
      ∀ w : puncturedDisc,
        a w = ((w : ComplexModel 1) 0 - (z : ComplexModel 1) 0) * B ((w : ComplexModel 1) 0) := by
  set e := chartAt (ComplexModel 1) z with he
  have hG : HolAt (fun v => a (e.symm v)) (e z) :=
    CartanLocalReduction.holAt_comp_chart_symm (mem_chartAt_puncturedDisc_source z z) ha.1
  set c₀ : ℂ := (z : ComplexModel 1) 0 with hc₀
  set A : ℂ → ℂ := fun c => a (e.symm (lineEmb c)) with hA
  have hlin : lineEmb c₀ = e z := by
    rw [hc₀, lineEmb_coord, he, chartAt_puncturedDisc_apply]
  have hAd : ∀ᶠ c in 𝓝 c₀, DifferentiableAt ℂ A c := by
    have hT : Tendsto lineEmb (𝓝 c₀) (𝓝 (e z)) := by
      rw [← hlin]; exact lineEmb.continuous.tendsto c₀
    filter_upwards [hT.eventually hG] with c hc
    exact hc.comp c lineEmb.differentiableAt
  obtain ⟨s, hsd, hs, hc₀s⟩ := _root_.eventually_nhds_iff.1 hAd
  have hdiff : DifferentiableOn ℂ A s := fun c hc => (hsd c hc).differentiableWithinAt
  have hB := (Complex.differentiableOn_dslope (hs.mem_nhds hc₀s)).2 hdiff
  refine ⟨dslope A c₀, eventually_of_mem (hs.mem_nhds hc₀s) fun c hc =>
    hB.differentiableAt (hs.mem_nhds hc), fun w => ?_⟩
  have hAw : A ((w : ComplexModel 1) 0) = a w := by
    simp only [hA, lineEmb_coord]
    rw [← chartAt_puncturedDisc_apply z w, ← he, e.left_inv (mem_chartAt_puncturedDisc_source z w)]
  have hA0 : A c₀ = 0 := by
    have h0 : a z = 0 := ha.2.self_of_nhds (mem_singleton z)
    simp only [hA, hlin, e.left_inv (mem_chartAt_puncturedDisc_source z z), h0]
  have h := sub_smul_dslope A c₀ ((w : ComplexModel 1) 0)
  rw [hA0, sub_zero, hAw, smul_eq_mul] at h
  exact h.symm

variable {n : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {f : X → puncturedDisc}

/-- A function of `t` holomorphic near `t(y)` is holomorphic near `y`. -/
theorem holomorphicAt_comp_coord (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel 1) ∞ f)
    {y : X} {B : ℂ → ℂ} (hB : ∀ᶠ c in 𝓝 (coord f y), DifferentiableAt ℂ B c) :
    HolomorphicAt n (fun p => B (coord f p)) y := by
  have hproj : Tendsto (fun w : ComplexModel 1 => w 0) (𝓝 ((f y : ComplexModel 1)))
      (𝓝 (coord f y)) :=
    ((EuclideanSpace.proj (0 : Fin 1) : ComplexModel 1 →L[ℂ] ℂ).continuous).tendsto _
  have hb : HolomorphicAt 1 (fun w : ComplexModel 1 => B (w 0)) ((f y : ComplexModel 1)) := by
    filter_upwards [hproj.eventually hB] with w hw
    rw [mdifferentiableAt_iff_differentiableAt]
    exact hw.comp w (EuclideanSpace.proj (0 : Fin 1) : ComplexModel 1 →L[ℂ] ℂ).differentiableAt
  have hval : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel 1) ∞
      (fun x => ((f x : puncturedDisc) : ComplexModel 1)) :=
    contMDiff_subtype_val.comp hf
  exact HolomorphicAt.comp_contMDiff (f := fun x => ((f x : puncturedDisc) : ComplexModel 1)) hb
    (Eventually.of_forall fun y => hval y)

/-- **The stalk of the ideal of a smooth fibre is generated by `t - z`.** -/
theorem stalkIdeal_fibre_eq_span (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel 1) ∞ f)
    {z : puncturedDisc} {k : ℕ} (hsm : IsSmoothFibreOfDim n 1 f z k) {y : X} (hy : f y = z) :
    stalkIdeal (vanishingIdeal (n := n) (fibre f z)) y =
      Ideal.span {NativeHolGerm.mk _ (holomorphicAt_fibreEquation hf (coord f y) y)} := by
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨g, hg, hmem, rfl⟩
    obtain ⟨-, N, s, c, hs, hc, heq⟩ := (hsm.2 y g).2 hmem
    choose a ha hsa using hs
    have hfy : ∀ i, (vanishingIdeal (n := 1) ({f y} : Set puncturedDisc)).mem (f y) (a i) := by
      intro i; rw [hy]; rw [hy] at ha; exact ha i
    choose B hB hfac using fun i => exists_dslope_factor (f y) (hfy i)
    have hBh : ∀ i, HolomorphicAt n (fun p => B i (coord f p)) y := fun i =>
      holomorphicAt_comp_coord hf (hB i)
    have hsum : HolomorphicAt n (fun p => ∑ i, c i p * B i (coord f p)) y :=
      HolomorphicAt.sum _ fun i _ => (hc i).mul (hBh i)
    have hgeq : NativeHolGerm.mk g hg =
        NativeHolGerm.mk _ (holomorphicAt_fibreEquation hf (coord f y) y) *
          NativeHolGerm.mk _ hsum := by
      rw [CircleAction.nativeHolGerm_mk_mul, NativeHolGerm.mk_eq_mk_iff]
      filter_upwards [heq] with p hp
      rw [hp, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hsa i, Function.comp_apply, hfac i (f p)]
      simp only [coord]
      ring
    rw [SetLike.mem_coe, hgeq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine SGPT.NAPotential.GAGAMult.mk_mem_stalkIdeal _ ⟨holomorphicAt_fibreEquation hf _ y, ?_⟩
    refine Eventually.of_forall fun p hp => ?_
    have hp' : f p = f y := by rw [hy]; exact hp
    simp only [coord, hp', sub_self]

/-- **Equal restrictions to a smooth fibre.** If `Rest_{X_z} I = Rest_{X_z} I'` at `y ∈ X_z`, then
`I_y + (t - z) = I'_y + (t - z)`. -/
theorem sup_span_eq_of_restStalk_eq (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel 1) ∞ f)
    {z : puncturedDisc} {k : ℕ} (hsm : IsSmoothFibreOfDim n 1 f z k) {y : X} (hy : f y = z)
    {I I' : GermIdeal n X}
    (h : restStalk I (SGPT.PSH.OhsawaTakegoshi.submanifoldSubspace
        (hsm.isClosedSubmanifold f hf.continuous)) y =
      restStalk I' (SGPT.PSH.OhsawaTakegoshi.submanifoldSubspace
        (hsm.isClosedSubmanifold f hf.continuous)) y) :
    stalkIdeal I y ⊔ Ideal.span {NativeHolGerm.mk _ (holomorphicAt_fibreEquation hf
        (coord f y) y)} =
      stalkIdeal I' y ⊔ Ideal.span {NativeHolGerm.mk _ (holomorphicAt_fibreEquation hf
        (coord f y) y)} := by
  set K := stalkIdeal (vanishingIdeal (n := n) (fibre f z)) y with hK
  have hcm : ∀ J : GermIdeal n X, Ideal.comap (Ideal.Quotient.mk K)
      (restStalk J (SGPT.PSH.OhsawaTakegoshi.submanifoldSubspace
        (hsm.isClosedSubmanifold f hf.continuous)) y) = stalkIdeal J y ⊔ K := by
    intro J
    change Ideal.comap (Ideal.Quotient.mk K) (Ideal.map (Ideal.Quotient.mk K) (stalkIdeal J y)) = _
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker]
  have h2 := congrArg (Ideal.comap (Ideal.Quotient.mk K)) h
  have h3 : stalkIdeal I y ⊔ K = stalkIdeal I' y ⊔ K := (hcm I).symm.trans (h2.trans (hcm I'))
  rw [hK, stalkIdeal_fibre_eq_span hf hsm hy] at h3
  exact h3

end SGPT.Trace.CohFib
