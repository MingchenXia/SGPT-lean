import SGPT.Okounkov.TranscendentalWNDeformation
import SGPT.Okounkov.TranscendentalWNDeformationLine
import SGPT.Foundations.Analysis.Pending.BlowupFlatCoordinates

/-!
# Generators of the ideal of the centre `Z × {0}`

Blueprint `tok-wn-def:centre-generators` (`claude-tok-wn-def`).

Near a point `(x₀, 0)` of the centre `C = Z × {0}`, every germ of the ideal `𝓘_C` is a holomorphic
combination of `g ∘ π_X` and `τ ∘ π_{ℙ¹}`, where `g` is a local generator of the ideal of the
hypersurface `Z` and `τ` the affine coordinate of `ℙ¹` (`exists_centre_generators`).

The proof uses the product flattening `L(a, b) ↦ L(Φ a, b - e'(0))` of `C`
(`exists_prod_singleton_flattening`): by Hadamard's lemma in flattening coordinates
(`BlowupFlatCoordinates.exists_eq_sum_flatCoord`) `𝓘_C` is generated by the last two flattening
coordinates, which are `Φ_m ∘ e ∘ π_X` (a multiple of `g ∘ π_X`, since it lies in `𝓘_Z`) and the
chart coordinate of `ℙ¹` at `0`, which is `τ` (`chartAt_projectiveZero`).
-/

set_option autoImplicit false

noncomputable section

universe u

namespace SGPT.Okounkov.TranscendentalWN

open Set Filter
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.Pending.ProductComplexManifold
open SGPT.Foundations.Analysis.Pending.BlowupFlatCoordinates
open scoped SGPT.Foundations.Analysis.Pending.ProductComplexManifold
open SGPT.Toric

theorem prodModelEquiv_apply_castSucc_last {m : ℕ} (a : ComplexModel (m + 1))
    (b : ComplexModel 1) :
    prodModelEquiv (m + 1) 1 (a, b) (Fin.castSucc (Fin.last m)) = a (Fin.last m) := by
  show prodModelEquiv (m + 1) 1 (a, b) (Fin.castAdd 1 (Fin.last m)) = _
  simp [prodModelEquiv]

theorem prodModelEquiv_apply_last {m : ℕ} (a : ComplexModel (m + 1)) (b : ComplexModel 1) :
    prodModelEquiv (m + 1) 1 (a, b) (Fin.last (m + 1)) = b 0 := by
  have h : Fin.last (m + 1) = Fin.natAdd (m + 1) (0 : Fin 1) := Fin.ext (by simp)
  rw [h]
  simp [prodModelEquiv]

/-- A sum over `Fin (m + 2)` whose terms of index `< m` vanish has two terms. -/
theorem sum_fin_eq_two {m : ℕ} (f : Fin (m + 1 + 1) → ℂ) (hf : ∀ i : Fin (m + 1 + 1), i.1 < m → f i = 0) :
    ∑ i, f i = f (Fin.castSucc (Fin.last m)) + f (Fin.last (m + 1)) := by
  rw [Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
  have h0 : ∑ i : Fin m, f (Fin.castSucc (Fin.castSucc i)) = 0 :=
    Finset.sum_eq_zero fun i _ => hf _ (by simp)
  rw [h0, zero_add]

variable {m : ℕ} (F : OriginalFlagGeometry.{u} (m + 1))

/-- **Generators of `𝓘_{Z × {0}}`**: near `(x₀, 0)`, every germ of the ideal of the centre is a
holomorphic combination of `g ∘ π_X` and `τ ∘ π_{ℙ¹}`, for a local generator `g` of `𝓘_Z` on an
open `V ∋ x₀`.  The neighbourhood lies in `V × {τ ≠ ∞}`. -/
theorem exists_centre_generators {x₀ : F.carrier} (hx₀ : x₀ ∈ F.flag (1 : Fin (m + 2)))
    {V : Set F.carrier} (hV : IsOpen V) (hx₀V : x₀ ∈ V) {g : F.carrier → ℂ}
    (hgen : ∀ y ∈ V, ∀ f, (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))).mem y f ↔
      IsInSpanAt (n := m + 1) (· = g) y f) :
    ∃ O : Set (F.carrier × ProjectiveLine), IsOpen O ∧ (x₀, projectiveZero) ∈ O ∧
      O ⊆ V ×ˢ (projectiveModelChart false).source ∧
      ∀ q ∈ O, ∀ f, (vanishingIdeal (n := m + 1 + 1) (deformationCentre F)).mem q f →
        ∃ c₁ c₂ : F.carrier × ProjectiveLine → ℂ, HolomorphicAt (m + 1 + 1) c₁ q ∧
          HolomorphicAt (m + 1 + 1) c₂ q ∧
          f =ᶠ[𝓝 q] fun q' => c₁ q' * g q'.1 + c₂ q' * projectiveAffine q'.2 := by
  obtain ⟨hkn, -, Φ, hΦsrc, hΦ0, hflatZ⟩ := F.firstDivisor.2.2 x₀ hx₀
  obtain ⟨Ψ, hΨsrc, -, hΨflat, hΨfun, hΨsource⟩ :=
    exists_prod_singleton_flattening (n' := 1) (A := F.flag (1 : Fin (m + 2)))
      (y := projectiveZero) hkn Φ hΦsrc hΦ0 hflatZ
  have hchart : chartAt (ComplexModel (m + 1 + 1)) ((x₀, projectiveZero) : F.carrier × ProjectiveLine) =
      prodChart (chartAt (ComplexModel (m + 1)) x₀) (chartAt (ComplexModel 1) projectiveZero) :=
    rfl
  -- the two flattening coordinates
  have hflat_last : ∀ q' : F.carrier × ProjectiveLine,
      flatCoord (y₀ := ((x₀, projectiveZero) : F.carrier × ProjectiveLine)) Ψ (Fin.castSucc (Fin.last m)) q' =
        flatCoord (y₀ := x₀) Φ (Fin.last m) q'.1 := by
    intro q'
    simp only [flatCoord, hΨfun, hchart, prodChart_apply, ContinuousLinearEquiv.symm_apply_apply,
      prodModelEquiv_apply_castSucc_last]
  have hflat_tau : ∀ q' : F.carrier × ProjectiveLine,
      q'.2 ∈ (projectiveModelChart false).source →
        flatCoord (y₀ := ((x₀, projectiveZero) : F.carrier × ProjectiveLine)) Ψ (Fin.last (m + 1)) q' = projectiveAffine q'.2 := by
    intro q' hq'
    simp only [flatCoord, hΨfun, hchart, prodChart_apply, ContinuousLinearEquiv.symm_apply_apply,
      prodModelEquiv_apply_last]
    change ((chartAt (ComplexModel 1) projectiveZero) q'.2 -
      (chartAt (ComplexModel 1) projectiveZero) projectiveZero) 0 = _
    rw [chartAt_projectiveZero, PiLp.sub_apply, projectiveModelChart_false_apply hq',
      projectiveModelChart_false_apply projectiveZero_mem_chart_source, projectiveAffine_zero,
      sub_zero]
  have hOopen : IsOpen (flatDomain (y₀ := ((x₀, projectiveZero) : F.carrier × ProjectiveLine)) Ψ ∩ V ×ˢ (projectiveModelChart false).source) :=
    (isOpen_flatDomain Ψ).inter (hV.prod (projectiveModelChart false).open_source)
  refine ⟨flatDomain (y₀ := ((x₀, projectiveZero) : F.carrier × ProjectiveLine)) Ψ ∩ V ×ˢ (projectiveModelChart false).source, hOopen,
    ⟨mem_flatDomain_self Ψ, hx₀V, projectiveZero_mem_chart_source⟩, inter_subset_right, ?_⟩
  rintro q ⟨hqΨ, hqV, hqτ⟩ f hf
  obtain ⟨b, hb0, hbhol, hsum⟩ := exists_eq_sum_flatCoord (y₀ := ((x₀, projectiveZero) : F.carrier × ProjectiveLine)) Ψ hΨsrc hΨflat hqΨ hf
  -- `Φ_m ∘ e` is a multiple of `g` near `q.1`
  have hq1 : q.1 ∈ flatDomain (y₀ := x₀) Φ := by
    have h1 := hqΨ.1
    rw [hchart, prodChart_source] at h1
    refine ⟨h1.1, ?_⟩
    have h := (hΨsource _).mp hqΨ.2
    simpa [hchart, prodChart_apply] using h.1
  have hζ : (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))).mem q.1
      (flatCoord (y₀ := x₀) Φ (Fin.last m)) :=
    flatCoord_mem_vanishingIdeal Φ hflatZ (i := Fin.last m) (by simp) hq1
  obtain ⟨-, N, s, a, hs, ha, hζeq⟩ := (hgen q.1 hqV _).mp hζ
  have hk : HolomorphicAt (m + 1) (fun y => ∑ i ∈ Finset.univ, a i y) q.1 :=
    HolomorphicAt.sum Finset.univ (fun i _ => ha i)
  have hζk : flatCoord (y₀ := x₀) Φ (Fin.last m) =ᶠ[𝓝 q.1]
      fun y => (∑ i ∈ Finset.univ, a i y) * g y := by
    filter_upwards [hζeq] with y hy
    rw [hy, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hs i]
  refine ⟨fun q' => b (Fin.castSucc (Fin.last m)) q' * ∑ i ∈ Finset.univ, a i q'.1,
    b (Fin.last (m + 1)), ?_, hbhol _, ?_⟩
  · have hk' : HolomorphicAt (m + 1 + 1)
        ((fun y => ∑ i ∈ Finset.univ, a i y) ∘ Prod.fst) q :=
      HolomorphicAt.comp_contMDiff (f := Prod.fst) hk
        (Eventually.of_forall fun _ => contMDiff_fst.contMDiffAt)
    exact (hbhol _).mul hk'
  · have hfst : Tendsto Prod.fst (𝓝 q) (𝓝 q.1) := continuous_fst.continuousAt
    filter_upwards [hsum, hfst.eventually hζk,
      (hV.prod (projectiveModelChart false).open_source).mem_nhds ⟨hqV, hqτ⟩] with q' h1 h2 h3
    rw [h1, sum_fin_eq_two _ (fun i hi => by simp [hb0 i hi]), hflat_last,
      hflat_tau q' h3.2, h2]
    ring

end SGPT.Okounkov.TranscendentalWN
