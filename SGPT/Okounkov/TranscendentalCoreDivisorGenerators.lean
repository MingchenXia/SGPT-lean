import SGPT.Foundations.Analysis.Pending.GermIdealTotalTransform
import SGPT.Foundations.Analysis.Pending.AnalyticModificationLocalDiscrepancy

/-!
# Local equations of sums and total transforms of effective divisors

Auxiliary for blueprint node `tok:gentle-sum`. If an effective divisor `D` has the local
equation `g` on an open set `U` (i.e. `𝒪(-D)` is generated by `g` there) and `D'` has the local
equation `g'`, then `D + D'` has the local equation `g g'` on `U`, `k D` has the local equation
`g^k`, and the total transform `ℓ^* D` along a holomorphic map `ℓ` (with nowhere dense
exceptional locus) has the local equation `g ∘ ℓ` on `ℓ⁻¹ U`. The project's
`isInvertible_mul` and `isInvertible_pullback` prove the existence of local equations; here the
local equations are the given ones.
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.Okounkov.TranscendentalCore

open Set Filter
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.FirstPass.BlowupSequences
open SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.Pending.RelativePrincipalizationSpan
open SGPT.Foundations.Analysis.Pending.GermIdealPullbackCalculus
open SGPT.Foundations.Analysis.Pending.IdealWeightPowers
open SGPT.Foundations.Analysis.Pending.InvertibleIdealQuotient
open SGPT.Foundations.Analysis.Pending.GermIdealTotalTransform

universe u

variable {n : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-- `g` is a local equation of the ideal `𝔞` on `U`: `𝔞` is generated by `g` at every point of
`U`, `g` is holomorphic on `U` and vanishes identically on no nonempty open subset of `U`. -/
def IsLocalEquationOn (𝔞 : GermIdeal n M) (U : Set M) (g : M → ℂ) : Prop :=
  MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) g U ∧
    (∀ W : Set M, IsOpen W → W ⊆ U → W.Nonempty → ∃ t ∈ W, g t ≠ 0) ∧
    ∀ t ∈ U, ∀ a : M → ℂ, 𝔞.mem t a ↔ IsInSpanAt (n := n) (· = g) t a

omit [IsComplexManifold n M] in
theorem IsLocalEquationOn.mono {𝔞 : GermIdeal n M} {U U' : Set M} {g : M → ℂ}
    (h : IsLocalEquationOn 𝔞 U g) (hU' : U' ⊆ U) : IsLocalEquationOn 𝔞 U' g :=
  ⟨h.1.mono hU', fun W hW hWU hne => h.2.1 W hW (hWU.trans hU') hne,
    fun t ht => h.2.2 t (hU' ht)⟩

omit [IsComplexManifold n M] in
/-- Local equations of a product of invertible ideals. -/
theorem IsLocalEquationOn.mul {𝔞 𝔟 : GermIdeal n M} (h𝔞 : 𝔞.IsInvertible)
    (h𝔟 : 𝔟.IsInvertible) {U : Set M} (hU : IsOpen U) {g g' : M → ℂ}
    (hg : IsLocalEquationOn 𝔞 U g) (hg' : IsLocalEquationOn 𝔟 U g') :
    IsLocalEquationOn (𝔞.mul 𝔟) U (fun y => g y * g' y) := by
  obtain ⟨hh, hnon, hgen⟩ := hg
  obtain ⟨hh', hnon', hgen'⟩ := hg'
  have hhhol : ∀ y ∈ U, HolomorphicAt n g y := fun y hy =>
    holomorphicAt_of_mdifferentiableOn hU hh hy
  have hh'hol : ∀ y ∈ U, HolomorphicAt n g' y := fun y hy =>
    holomorphicAt_of_mdifferentiableOn hU hh' hy
  refine ⟨?_, ?_, ?_⟩
  · intro y hy
    exact ((hhhol y hy).mul (hh'hol y hy)).mdifferentiableAt.mdifferentiableWithinAt
  · intro W hW hWU hWne
    obtain ⟨y₁, hy₁W, hy₁⟩ := hnon W hW hWU hWne
    have hWopen : IsOpen (W ∩ {z | g z ≠ 0}) := by
      rw [isOpen_iff_mem_nhds]
      intro z hz
      filter_upwards [hW.mem_nhds hz.1,
        (hhhol z (hWU hz.1)).continuousAt.eventually_ne hz.2] with w h1 h2
      exact ⟨h1, h2⟩
    obtain ⟨y, hyW, hy⟩ := hnon' _ hWopen (fun z hz => hWU hz.1) ⟨y₁, hy₁W, hy₁⟩
    exact ⟨y, hyW.1, mul_ne_zero hyW.2 hy⟩
  intro y hy v
  constructor
  · intro hv
    refine IsInSpanAt.trans ?_ (mem_mul_iff.mp hv)
    rintro t ⟨p, q, hp, hq, rfl⟩
    obtain ⟨-, α, hα, hαeq⟩ := isInSpanAt_eq_iff.mp ((hgen y hy p).mp hp)
    obtain ⟨-, β, hβ, hβeq⟩ := isInSpanAt_eq_iff.mp ((hgen' y hy q).mp hq)
    refine isInSpanAt_of_eq_mul rfl
      ((GermIdeal.IsInvertible.holomorphicAt_mem h𝔞 hp).mul
        (GermIdeal.IsInvertible.holomorphicAt_mem h𝔟 hq)) (hα.mul hβ) ?_
    filter_upwards [hαeq, hβeq] with z hz hz'
    show p z * q z = α z * β z * (g z * g' z)
    rw [hz, hz']
    ring
  · intro hv
    obtain ⟨hvhol, α, hα, hαeq⟩ := isInSpanAt_eq_iff.mp hv
    refine mem_mul_iff.mpr
      (isInSpanAt_of_eq_mul (s := fun z => g z * g' z)
        ⟨g, g', (hgen y hy g).mpr (isInSpanAt_self rfl (hhhol y hy)),
          (hgen' y hy g').mpr (isInSpanAt_self rfl (hh'hol y hy)), rfl⟩
        hvhol hα ?_)
    filter_upwards [hαeq] with z hz
    exact hz

/-- Local equations of a total transform. -/
theorem IsLocalEquationOn.pullback {Z : Type u} [TopologicalSpace Z]
    [ChartedSpace (ComplexModel n) Z] [IsComplexManifold n Z] {ℓ : Z → M}
    (hℓ : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ ℓ)
    (hint : interior (exceptionalLocus n ℓ) = ∅) {𝔞 : GermIdeal n M} {U : Set M}
    (hU : IsOpen U) {g : M → ℂ} (hg : IsLocalEquationOn 𝔞 U g) :
    IsLocalEquationOn (GermIdeal.pullback (m := n) ℓ 𝔞) (ℓ ⁻¹' U) (fun z => g (ℓ z)) := by
  obtain ⟨hh, hnon, hgen⟩ := hg
  have hhhol : ∀ y ∈ U, HolomorphicAt n g y := fun y hy =>
    holomorphicAt_of_mdifferentiableOn hU hh hy
  have hgat : ∀ {z' : Z}, ∀ᶠ w in 𝓝 z',
      ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ ℓ w :=
    fun {_} => Eventually.of_forall fun w => hℓ.contMDiffAt
  refine ⟨?_, ?_, ?_⟩
  · intro w hw
    exact ((hhhol (ℓ w) hw).comp_contMDiff hgat).mdifferentiableAt.mdifferentiableWithinAt
  · exact fun W hW hWU hWne =>
      MeteredDivisorOperations.exists_ne_zero_comp hℓ hint hnon hW hWU hWne
  intro w hw v
  constructor
  · intro hv
    refine IsInSpanAt.trans ?_ (GermIdeal.mem_pullback_iff.mp hv)
    rintro u ⟨c, hc, rfl⟩
    refine IsInSpanAt.mono ?_ (isInSpanAt_comp hℓ ((hgen (ℓ w) hw c).mp hc))
    rintro u' ⟨σ, rfl, rfl⟩
    rfl
  · intro hv
    refine GermIdeal.mem_pullback_iff.mpr (IsInSpanAt.mono ?_ hv)
    rintro u rfl
    exact ⟨g, (hgen (ℓ w) hw g).mpr (isInSpanAt_self rfl (hhhol (ℓ w) hw)), rfl⟩

/-- `(k + 1) D` for an effective divisor `D`. -/
def divisorSuccNsmul (D : EffectiveDivisor n M) : ℕ → EffectiveDivisor n M
  | 0 => D
  | k + 1 => EffectiveDivisor.add (divisorSuccNsmul D k) D

/-- `(k + 1) D` has the local equation `g^{k+1}` where `D` has the local equation `g`. -/
theorem IsLocalEquationOn.succNsmul {D : EffectiveDivisor n M} {U : Set M} (hU : IsOpen U)
    {g : M → ℂ} (hg : IsLocalEquationOn D.ideal U g) :
    ∀ k : ℕ, IsLocalEquationOn (divisorSuccNsmul D k).ideal U (fun y => g y ^ (k + 1))
  | 0 => by
      have hfun : (fun y => g y ^ (0 + 1)) = g := by
        funext y
        ring
      rw [hfun]
      exact hg
  | k + 1 => by
      have h := (IsLocalEquationOn.succNsmul hU hg k).mul (divisorSuccNsmul D k).isInvertible
        D.isInvertible hU hg
      have hfun : (fun y => g y ^ (k + 1) * g y) = fun y => g y ^ (k + 1 + 1) := by
        funext y
        ring
      rw [hfun] at h
      exact h

/-- An analytic modification has a nowhere dense exceptional locus. -/
theorem interior_exceptionalLocus_eq_empty_of_isAnalyticModification {Z : Type u}
    [TopologicalSpace Z] [ChartedSpace (ComplexModel n) Z] [IsComplexManifold n Z]
    {π : Z → M} (hπ : AnalyticModificationLocalDiscrepancy.IsAnalyticModification (n := n) π) :
    interior (exceptionalLocus n π) = ∅ := by
  obtain ⟨A, _hAc, _hAa, hAi, _hinj, hnon⟩ :=
    AnalyticModificationLocalDiscrepancy.exists_analytic_exceptional_set_of_isAnalyticModification
      hπ
  have hsub : exceptionalLocus n π ⊆ A := by
    intro y hy
    by_contra hyA
    exact hnon y hyA hy
  exact subset_empty_iff.mp ((interior_mono hsub).trans hAi.subset)

end SGPT.Okounkov.TranscendentalCore
