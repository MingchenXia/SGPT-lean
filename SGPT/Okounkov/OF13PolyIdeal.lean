import SGPT.GAGA.ChowBlMap
import SGPT.Okounkov.OF13ProperModel

/-!
# Ideal sheaves of homogeneous polynomials on a projective manifold

Source: chapter *The theory of Okounkov bodies*, `rmk:Abhyankar` (existence part of
[CFKLRS17, Thm 2.9]): the resolution step principalizes the ideal sheaves of the numerators and
denominators `P, Q` of rational functions `u = P/Q` on a projective manifold.

Let `M` be a compact complex manifold with a holomorphic embedding `Ψ : M → ℙᴺ` and
`R₁, …, R_K` homogeneous polynomials of the same degree `D`. The ideal sheaf `polyIdeal Ψ R` of
`𝒪_M` is generated, near a point `x` with `Ψ x` in the chart `{Zᵢ ≠ 0}`, by the restrictions
`R_m(Ψ/Zᵢ)` (`genFun Ψ i (R m)`); the chart does not matter, since the restrictions in two charts
differ by the unit `(Z_{i'}/Zᵢ)^D` (`isInSpanAt_genFun_chart_change`). It is coherent
(`isCoherent_polyIdeal`), and nonzero at every point as soon as some `R_m` does not vanish
identically near the point (`polyIdeal_nonzero`): exactly the hypotheses of the principalization
theorem (`SGPT.Foundations.Analysis.Pending.HironakaAPI.exists_principalization`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov.OF13

open Set Filter
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Projective SGPT.Projective.ComplexProjectiveSpace
open SGPT.GAGA.H0S SGPT.GAGA.ChowBl
open scoped Topology Manifold

universe u

variable {n N : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] {Ψ : M → ComplexProjectiveSpace N}

omit [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M] in
/-- `R(Ψ/Zᵢ)` for the monomial `R = Z_{i'}^D` is `(Z_{i'}/Zᵢ)^D`. -/
theorem genFun_X_pow (i i' : Fin (N + 1)) (D : ℕ) (x : M) :
    genFun Ψ i (MvPolynomial.X i' ^ D) x = coneLift Ψ i x i' ^ D := by
  simp [genFun, SGPT.GAGA.PN.polyTuple]

omit [IsComplexManifold n M] in
theorem eventually_mem_affineChart_source (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {i : Fin (N + 1)} {x : M} (hi : Ψ x ∈ (affineChart i).source) :
    ∀ᶠ y in 𝓝 x, Ψ y ∈ (affineChart i).source :=
  hΨ.continuous.continuousAt.preimage_mem_nhds ((affineChart i).open_source.mem_nhds hi)

variable [CompactSpace M]

omit [IsComplexManifold n M] in
/-- The chart change of the restrictions of a homogeneous polynomial, as germs. -/
theorem genFun_eventuallyEq_chart_change (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {R : MvPolynomial (Fin (N + 1)) ℂ} {D : ℕ} (hR : R.IsHomogeneous D) {i i' : Fin (N + 1)}
    {x : M} (hi : Ψ x ∈ (affineChart i).source) (hi' : Ψ x ∈ (affineChart i').source) :
    genFun Ψ i R =ᶠ[𝓝 x] fun y => genFun Ψ i (MvPolynomial.X i' ^ D) y * genFun Ψ i' R y := by
  filter_upwards [eventually_mem_affineChart_source hΨ hi,
    eventually_mem_affineChart_source hΨ hi'] with y hy hy'
  rw [genFun_chart_change hR hy' hy, genFun_X_pow]

variable {K : ℕ}

/-- Generation by the restrictions of homogeneous polynomials of the same degree does not depend on
the chart. -/
theorem isInSpanAt_genFun_chart_change (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {R : Fin K → MvPolynomial (Fin (N + 1)) ℂ} {D : ℕ} (hR : ∀ m, (R m).IsHomogeneous D)
    {i i' : Fin (N + 1)} {x : M} (hi : Ψ x ∈ (affineChart i).source)
    (hi' : Ψ x ∈ (affineChart i').source) {g : M → ℂ}
    (h : IsInSpanAt (n := n) (· ∈ Set.range fun m => genFun Ψ i (R m)) x g) :
    IsInSpanAt (n := n) (· ∈ Set.range fun m => genFun Ψ i' (R m)) x g := by
  rw [CoherentIdealColon.isInSpanAt_range_iff] at h ⊢
  obtain ⟨hg, c, hc, hgc⟩ := h
  refine ⟨hg, fun m y => c m y * genFun Ψ i (MvPolynomial.X i' ^ D) y,
    fun m => (hc m).mul (holomorphicAt_genFun hΨ hi _), ?_⟩
  have hall : ∀ᶠ y in 𝓝 x, ∀ m, genFun Ψ i (R m) y =
      genFun Ψ i (MvPolynomial.X i' ^ D) y * genFun Ψ i' (R m) y :=
    eventually_all.mpr fun m => genFun_eventuallyEq_chart_change hΨ (hR m) hi hi'
  filter_upwards [hgc, hall] with y hy hy'
  rw [hy]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [hy' m, mul_assoc]

variable (Ψ) in
/-- **The ideal sheaf of homogeneous polynomials** `R₁, …, R_K`: near `x`, generated by the
restrictions `R_m(Ψ/Zᵢ)` in a chart `{Zᵢ ≠ 0}` containing `Ψ x`. -/
def polyIdeal (R : Fin K → MvPolynomial (Fin (N + 1)) ℂ) : GermIdeal n M where
  mem x g := ∃ i, Ψ x ∈ (affineChart i).source ∧
    IsInSpanAt (n := n) (· ∈ Set.range fun m => genFun Ψ i (R m)) x g

theorem polyIdeal_mem_iff (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {R : Fin K → MvPolynomial (Fin (N + 1)) ℂ} {D : ℕ} (hR : ∀ m, (R m).IsHomogeneous D)
    {i : Fin (N + 1)} {x : M} (hi : Ψ x ∈ (affineChart i).source) (g : M → ℂ) :
    (polyIdeal (n := n) Ψ R).mem x g ↔
      IsInSpanAt (n := n) (· ∈ Set.range fun m => genFun Ψ i (R m)) x g := by
  constructor
  · rintro ⟨i', hi', h⟩
    exact isInSpanAt_genFun_chart_change hΨ hR hi' hi h
  · exact fun h => ⟨i, hi, h⟩

/-- The ideal sheaf of homogeneous polynomials of the same degree is coherent. -/
theorem isCoherent_polyIdeal (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {R : Fin K → MvPolynomial (Fin (N + 1)) ℂ} {D : ℕ} (hR : ∀ m, (R m).IsHomogeneous D) :
    (polyIdeal (n := n) Ψ R).IsCoherent := by
  intro x
  obtain ⟨i, hi⟩ := exists_mem_affineChart_source (Ψ x)
  refine ⟨Ψ ⁻¹' (affineChart i).source,
    (affineChart i).open_source.preimage hΨ.continuous, hi, K, fun m => genFun Ψ i (R m),
    fun m y hy => ?_, fun y hy g => polyIdeal_mem_iff hΨ hR hy g⟩
  exact (holomorphicAt_genFun hΨ hy (R m)).self_of_nhds.mdifferentiableWithinAt

/-- The ideal sheaf is nonzero at every point where some `R_m` does not vanish identically. -/
theorem polyIdeal_nonzero (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {R : Fin K → MvPolynomial (Fin (N + 1)) ℂ}
    (h0 : ∀ x, ∃ (i : Fin (N + 1)) (m : Fin K), Ψ x ∈ (affineChart i).source ∧
      ∃ᶠ y in 𝓝 x, genFun Ψ i (R m) y ≠ 0) :
    ∀ x, ∃ g, (polyIdeal (n := n) Ψ R).mem x g ∧ ∃ᶠ y in 𝓝 x, g y ≠ 0 := by
  classical
  intro x
  obtain ⟨i, m, hi, hfreq⟩ := h0 x
  refine ⟨genFun Ψ i (R m), ⟨i, hi, ?_⟩, hfreq⟩
  rw [CoherentIdealColon.isInSpanAt_range_iff]
  refine ⟨holomorphicAt_genFun hΨ hi _, fun l _ => if l = m then 1 else 0,
    fun l => holomorphicAt_const _, Eventually.of_forall fun y => ?_⟩
  simp

end SGPT.Okounkov.OF13
