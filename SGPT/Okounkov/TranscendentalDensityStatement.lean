import SGPT.Okounkov.TranscendentalCoreDefs
import SGPT.PSH.BookCurrentSpace

/-!
# Density of gentle Kähler currents: the statements

Blueprint nodes `tok:density` and `tok:partial-analytic` (chapter
`claude-okounkov-transcendental`; DRWNXZ = Darvas--Reboulet--Witt Nyström--Xia--Zhang,
*Transcendental Okounkov bodies*, Lemma 3.1, Definition 3.2 and Lemma 5.3).

This file contains **statements only** (`def … : Prop`); it is the interface consumed by the
packages LIFT (`tok:approx-pushforward`, `tok:lifting-invariance`), PARTIAL
(`tok:partial-convex`, `tok:A-iff-B`) and SLICE/VOL (`tok:nu1-closure`, `tok:slice-density`,
`tok:A1`, `tok:slice-kahler`). The proofs are in `TranscendentalDensity.lean`,
`TranscendentalDensityPartial.lean` (from Skoda's theorem as a hypothesis) and
`TranscendentalDensityTheorem.lean` (`densityStatement`, `bodyEqualityStatement`,
`partialAnalyticStatement`).

* `DensityStatement` (`tok:density`, DRWNXZ Lemma 3.1): if `Ω(ξ) ≠ ∅` (e.g. `ξ` big), every
  `T ∈ 𝒜(ξ)` is a limit of valuations of currents of `Ω(ξ)`:
  `ν(T) ∈ closure ν(Ω(ξ))`.
* `BodyEqualityStatement` (`tok:density`, consequence; DRWNXZ Definition 3.2: the book's body
  agrees with Deng's): for big `ξ`, `Δ(ξ) = closure ν(Ω(ξ)) = closure ν(𝒜(ξ))`.
* `PartialAnalyticStatement` (`tok:partial-analytic`, DRWNXZ Lemma 5.3): for a Kähler current
  `R ∈ 𝒜(ξ)` on a manifold of dimension `n = m + 1 ≥ 1`,
  `closure ν(Ω(ξ; R)) = closure ν(𝒜(ξ; R))`. (DRWNXZ and `tok:partial-def` take `R ∈ 𝒜ᵍ(ξ)`; the
  statement here only asks `R ∈ 𝒜(ξ) ⊇ 𝒜ᵍ(ξ)`, so it is more general.)

All sets are sets of potentials relative to the representative `θ` of `ξ`
(`SGPT.Okounkov.TranscendentalCore`); `ν` is `flagValuation F`.
-/

set_option autoImplicit false

noncomputable section

universe u

namespace SGPT.Okounkov.TranscendentalDensity

open Set
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.AnalyticGluingData
open SGPT.Okounkov.TranscendentalCore

/-- **Gentle Kähler currents are dense for the valuation** (`tok:density`, DRWNXZ Lemma 3.1):
on a compact Kähler manifold with a smooth flag, if `Ω(ξ) ≠ ∅` then every `T ∈ 𝒜(ξ)` satisfies
`ν(T) ∈ closure ν(Ω(ξ))` (equivalently, there are `T_k ∈ Ω(ξ)` with `ν(T_k) → ν(T)`). -/
def DensityStatement : Prop :=
  ∀ (n : ℕ) (F : OriginalFlagGeometry.{u} n) (θ : ClosedRealOneOneForm n F.carrier),
    (gentleKahlerCurrents θ).Nonempty → ∀ φ ∈ analyticCurrents θ,
      flagValuation F φ ∈ closure (flagValuation F '' gentleKahlerCurrents θ)

/-- **The book's Okounkov body equals the bodies generated by `Ω` and by `𝒜`**
(`tok:density`, consequence; DRWNXZ Definition 3.2): for a big class `ξ = {θ}`,
`Δ(ξ) = closure ν(Ω(ξ)) = closure ν(𝒜(ξ))`. -/
def BodyEqualityStatement : Prop :=
  ∀ (m : ℕ) (F : OriginalFlagGeometry.{u} (m + 1)) (θ : ClosedRealOneOneForm (m + 1) F.carrier),
    SGPT.PSH.BookCurrent.IsBig (RealBottChern.ofRepresentative θ) →
      tradOkounkovBody F θ = closure (flagValuation F '' gentleKahlerCurrents θ) ∧
        tradOkounkovBody F θ = closure (flagValuation F '' analyticCurrents θ)

/-- **Partial bodies via currents with analytic singularities** (`tok:partial-analytic`,
DRWNXZ Lemma 5.3): for a Kähler current `R = θ + dd^c u` with analytic singularities,
`closure ν(Ω(ξ; R)) = closure ν(𝒜(ξ; R))`. The left side is the partial Okounkov body
`Δ(ξ; R)` of `tok:partial-def`. -/
def PartialAnalyticStatement : Prop :=
  ∀ (m : ℕ) (F : OriginalFlagGeometry.{u} (m + 1)) (θ : ClosedRealOneOneForm (m + 1) F.carrier)
    (u : F.carrier → EReal), IsKahlerCurrentPotential θ u → u ∈ analyticCurrents θ →
      closure (flagValuation F '' gentleKahlerCurrentsBelow θ u) =
        closure (flagValuation F '' analyticCurrentsBelow θ u)

end SGPT.Okounkov.TranscendentalDensity
