import SGPT.Okounkov.OF3SectionDivisorOrder
import SGPT.NAPotential.GAGAMultSiuComplete
import SGPT.NAPotential.GAGAMult2Algebraic
import SGPT.GAGA.H0LDXMain

/-!
# Sections of `L^k ⊗ 𝓘(kφ)` computing `ord_E 𝓘(kφ)`

Source: chapter *The theory of Okounkov bodies*, proof of `thm:nuOk` (Step 2: *"for large
enough `k`, the line bundle `k(L - F)` is globally generated. Hence we can choose a section ...
which does not vanish at the generic point of `E`"*, i.e. `ord_E H⁰(X, L^k ⊗ 𝓘(kφ)) = ord_E 𝓘(kφ)`
up to `O(1)`).

We prove the exact equality `ord_E H⁰(X, L^k ⊗ 𝓘(kφ)) = ord_E 𝓘(kφ)` for all `k ≫ 0`, for every
prime divisor `E` over `X` and every `φ` with `θ_φ ≥ δω` (a Kähler current), directly from Siu's
uniform global generation of multiplier ideal sheaves (`lma:Siu_global_uniform_generatedness`,
`SGPT.NAPotential.GAGAMult.siuGlobalGeneration_iff`: `𝓘(kφ)_x` is generated by the
coefficients of the global holomorphic sections of `L^k` with finite `L²(e^{-kφ})` norm) and
GAGA for the sections of `L^k` (`SGPT.GAGA.H0L.algSection`). This replaces the log resolution of
the book's proof (the formula then holds without resolving the singularities of `φ`, and without
any smoothness assumption on `E`).

## Main results

* `exists_section_sectionDivisorOrder_le`: for `k ≥ k₀` (depending only on `(L, H)`, the Kähler
  form `ω` and `δ > 0`), every `φ ∈ PSH(X, θ - δω)` and every prime divisor `E` over `X`, there
  is a nonzero `σ ∈ H⁰(X, L^k ⊗ 𝓘(kφ))` with `ord_E(σ) ≤ ord_E 𝓘(kφ)`.
* `sectionDivisorOrder_eq_of_le`: together with
  `SGPT.Okounkov.OF3.presentationMultiplierOrder_le_sectionDivisorOrder`, `ord_E(σ) = ord_E 𝓘(kφ)`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov.OF3

open Set Filter CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes MeasureTheory
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.FirstPass.PositiveClasses
open SGPT.Foundations.Analysis.Pending.FixedGermNormalOrder
open SGPT.Foundations.Analysis.Pending.DemaillyApproximantDivisorialLelong
open SGPT.Foundations.Analysis.FirstPass.BlowupSequences
open SGPT.PSH.CompactPrimeOver SGPT.PSH.CompactPrimeMultiplierOrder
open SGPT.Bergman.TensorDictionaryDraft HermitianHolomorphicLineBundle
open SGPT.NAPotential.GAGAMult SGPT.Foundations.Analysis.Pending.ChartwiseGlobalL1

variable {X : Scheme.{0}} [IsIntegral X] (f : X ⟶ Spec (.of ℂ)) {m : ℕ}
  [SmoothOfRelativeDimension (m + 1) f] (E : ClosedProjectiveEmbedding f)
  [IsSeparated f] [QuasiCompact f]

local instance of3SiuTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance of3SiuCharts : ChartedSpace (ComplexModel (m + 1)) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f (m + 1)
local instance of3SiuManifold : IsComplexManifold (m + 1) (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f (m + 1)
local instance of3SiuMeasurable : MeasurableSpace (SchemeComplexPoint f) := borel _
local instance of3SiuBorel : BorelSpace (SchemeComplexPoint f) := ⟨rfl⟩

omit [IsIntegral X] in
/-- The normal order of a function vanishing near the point is `⊤`. -/
theorem pullbackNormalOrder_eq_top_of_eventuallyEq_zero
    (p : PrimePresentation (m + 1) (SchemeComplexPoint f)) {y : p.model}
    (Φ : DivisorFlattening (m := m) p.divisor y) {g : SchemeComplexPoint f → ℂ}
    (hg : HolomorphicAt (m + 1) g (p.projection y)) (h0 : g =ᶠ[𝓝 (p.projection y)] fun _ => 0) :
    pullbackNormalOrder p.modification Φ g hg = ⊤ := by
  rw [pullbackNormalOrder_congr p.modification Φ hg (holomorphicAt_const 0) h0]
  unfold pullbackNormalOrder functionNormalOrder
  convert normalOrder_zero Φ
  rfl

variable {L : X.Modules} (a : LineBundleAtlas L) (H : SchemeLineBundleMetric f (m + 1) E L)

omit [IsIntegral X] in
/-- **Siu + GAGA: a section computing `ord_E 𝓘(kφ)`.** There is `k₀` such that for every
`k ≥ k₀`, every `φ ∈ PSH(X, θ - δω)` (`θ = c₁(L, H)`, `ω` a Kähler form, `δ > 0`) and every prime
divisor `E` over `X`, some nonzero `σ ∈ H⁰(X, L^k ⊗ 𝓘(kφ))` has `ord_E(σ) ≤ ord_E 𝓘(kφ)`. -/
theorem exists_section_sectionDivisorOrder_le [CompactSpace (SchemeComplexPoint f)]
    (ωb : KahlerBackground (m + 1) (SchemeComplexPoint f)) {δ : ℝ} (hδ : 0 < δ) :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ φ : SchemeComplexPoint f → EReal,
      IsThetaPshPotential (H.curvature a - δ • ωb.form).val φ →
      ∀ (hq : IsGlobalQuasiPshPotential (n := m + 1) φ) (hk : (0 : ℝ) < k)
        (p : PrimePresentation (m + 1) (SchemeComplexPoint f)),
        ∃ σ : bundlePowerGlobalSections L k, σ ≠ 0 ∧ IsMultiplierSection f (m + 1) E φ k σ ∧
          sectionDivisorOrder f E p σ ≤ presentationMultiplierOrder hq hk p := by
  classical
  let μ := IntegrationCurrent.kahlerVolume ωb
  have hμ : IsSmoothPositiveVolume (n := m + 1) μ :=
    KahlerVolumeSmoothPositive.isSmoothPositiveVolume_kahlerVolume ωb
  obtain ⟨k₀, hk₀⟩ := siuGlobalGeneration_iff ωb hμ
    (isSourceSmoothHermitianMetric_schemeHermitianLineBundle f (m + 1) E a H)
    SGPT.PSH.GlobalL2.isSourceSmoothHermitianMetric_unit
    (isOwnFirstChernForm_schemeHermitianLineBundle f (m + 1) E a H) hδ
  refine ⟨k₀, fun k hk φ hφ hq hkR p => ?_⟩
  have hφθ : IsThetaPshPotential (H.curvature a).val φ := by
    have h := LocalPotentials.isThetaPshPotential_add_of_semipositive hφ
      (KahlerDomination.isSemipositive_smul ωb.isSemipositive hδ.le)
    rwa [sub_add_cancel] at h
  -- a point of `E`, a flattening and an atlas frame at its image
  have hE := isClosedConnectedSubmanifold_divisor p
  obtain ⟨y, hy⟩ := hE.2.1.nonempty
  obtain ⟨Φ⟩ := DivisorFlattening.nonempty_of_regularAtDim (hE.2.2 y hy)
  obtain ⟨i, hi⟩ := a.covers (schemeComplexPointImage f (p.projection y))
  let e := twistedFrame f (m + 1) E a H (a.frame i) k
  have hxe : p.projection y ∈ e.val.baseSet := mem_twistedFrame_baseSet f (m + 1) E a H _ k hi
  -- a member of `𝓘(kφ)` attaining the order of the pulled-back ideal
  set a₀ := presentationMultiplierOrder hq hkR p with ha₀
  have hcoh : (multiplierIdeal (n := m + 1) (k : ℝ) φ).IsCoherent :=
    SGPT.Bergman.MultiplierSectionsDraft.multiplierIdeal_isCoherent_genuine hq hkR
  have horder := (presentationMultiplierOrder_eq_originalStalkNormalOrder hq hkR p hy Φ).symm
  obtain ⟨F, hF, hFmem, -, hFord⟩ :=
    MultiplierIdealLowerBound.exists_original_member_attaining_finite_pullback_order
      p.modification Φ _ hcoh a₀ horder
  -- Siu: `F` is a combination of coefficients of `L²` sections
  have hspan := (hk₀ k hk φ hφ (p.projection y) e hxe F).mp hFmem
  by_contra hcon
  push Not at hcon
  have hO : IsOpen (schemeComplexPointImage f ⁻¹' (a.opens i : Set X)) :=
    (a.opens i).isOpen.preimage (schemeComplexPointImage_continuous f)
  have hlow : ((a₀ + 1 : ℕ) : ℕ∞) ≤ pullbackNormalOrder p.modification Φ F hF := by
    refine le_pullbackNormalOrder_of_isInSpanAt p.modification Φ hspan hF ?_
    rintro _ ⟨s, hs, rfl⟩
    set σ := SGPT.GAGA.H0L.algSection a H s with hσdef
    have hσ := SGPT.GAGA.H0L.isAnalytificationOf_algSection a H s
    have hcoef : (fun z => e.val.continuousLinearMapAt ℂ z (s z)) =ᶠ[𝓝 (p.projection y)]
        sectionFrameCoefficient f (m + 1) E (a.frame i) k σ := by
      filter_upwards [hO.mem_nhds hi] with z hz
      exact hσ i z hz
    have hhol : HolomorphicAt (m + 1) (sectionFrameCoefficient f (m + 1) E (a.frame i) k σ)
        (p.projection y) :=
      schemeOpenRegularFunction_holomorphicAt f (m + 1) E (a.opens i) _ _ hi
    refine ⟨hhol.congr hcoef.symm, ?_⟩
    rw [pullbackNormalOrder_congr p.modification Φ _ hhol hcoef]
    by_cases hσ0 : σ = 0
    · rw [pullbackNormalOrder_eq_top_of_eventuallyEq_zero f p Φ hhol ?_]
      · exact le_top
      filter_upwards [hO.mem_nhds hi] with z hz
      rw [hσ0]
      exact SGPT.IGood.sectionFrameCoefficient_zero (f := f) (n := m + 1) (E := E) (a.frame i) k hz
    have hmult : IsMultiplierSection f (m + 1) E φ k σ :=
      SGPT.GAGA.H0L.isMultiplierSection_algSection a H hφθ hμ hs
    have hlt := hcon σ hσ0 hmult
    have hle := sectionDivisorOrder_le f E p σ hy ((a.frame i).tensorPower k) hi Φ
    have h2 : (a₀ : ℕ∞) < pullbackNormalOrder p.modification Φ
        (sectionFrameCoefficient f (m + 1) E (a.frame i) k σ) hhol := lt_of_lt_of_le hlt hle
    have h3 := (ENat.add_one_le_iff (ENat.natCast_ne_top a₀)).mpr h2
    exact_mod_cast h3
  rw [hFord] at hlow
  exact absurd (ENat.natCast_le_natCast.mp hlow) (Nat.not_succ_le_self a₀)

end SGPT.Okounkov.OF3
