import Mathlib.RingTheory.Smooth.Local
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
import Mathlib.RingTheory.RingHom.FaithfullyFlat
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Normal crossings coordinates through a faithfully flat local extension

Source: chapter *The theory of Okounkov bodies*, Section *Flags and valuations*, `rmk:Abhyankar`
(the existence part of [CFKLRS17, Thm 2.9]: a valuation with value group `ℤⁿ_lex` is equivalent
to the valuation of an admissible flag on a modification of `X`).

Lane OF11 reduced the existence to a smooth model `X'` of `ℂ(X)` on which, at the centre `x` of
`ν`, given elements `u₁, …, uₙ` (with `ν(u_k) = e_k`) are Laurent monomials in *strict normal
crossings coordinates* `z₁, …, zₙ ∈ 𝒪_{X',x}` (`OF11.IsSNCCoordinates`: `(z) = 𝔪_x`, and for
every set `s` of indices `(z_s)` is a prime of height `|s|` with `𝒪_{X',x}/(z_s)` formally smooth
over `ℂ`). A resolution of singularities produces such coordinates *analytically*. This file
contains the commutative algebra which transports them along the faithfully flat local map
`φ : 𝒪_{X',x} → 𝒪^{an}_{X',x}` from the algebraic to the analytic local ring.

* `span_range_eq_maximalIdeal_of_map`: if the `φ(zⱼ)` generate the maximal ideal of `B`, the `zⱼ`
  generate the maximal ideal of `A`;
* `isPrime_span_image_of_map`: `(z_s)` is prime when `(φ(z_s))` is (contraction);
* `height_span_image_eq_card`: in a Noetherian domain, if all `(z_s)` are prime and `zⱼ ∉ (z_s)`
  for `j ∉ s`, then `ht (z_s) = |s|` (Krull's height theorem and a chain of primes);
* `injective_cotangentComplexBaseChange_of_derivations`, `formallySmooth_quotient_of_derivations`:
  the Jacobian criterion with point derivations `Dᵢ : A → K` dual to the generators, `Dᵢ(gⱼ) = δᵢⱼ`
  (`A` formally smooth with finite free differentials);
* `exists_algebraMap_eq_of_map_eq`, `exists_unit_algebraMap_eq_of_map_eq`: an element of
  `Frac A` which becomes regular (a unit) in `Frac B` is regular (a unit) in `A`.
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.Okounkov.OF13

open IsLocalRing TensorProduct KaehlerDifferential

/-! ### The Jacobian criterion with point derivations -/

section Derivations

variable {k A B K : Type*} [CommRing k] [CommRing A] [CommRing B] [Field K]
  [Algebra k A] [Algebra A B] [Algebra B K] [Algebra A K] [Algebra k K]
  [IsScalarTower A B K] [IsScalarTower k A K]

/-- Every vector of `K ⊗_A I` is a `K`-combination of the `1 ⊗ gⱼ` when `I = (gⱼ)`. -/
theorem exists_eq_sum_tmul_of_span {ι : Type*} [Fintype ι] (I : Ideal A) (g : ι → A)
    (hg : ∀ j, g j ∈ I) (hI : I = Ideal.span (Set.range g)) (x : K ⊗[A] I) :
    ∃ c : ι → K, x = ∑ j, c j • ((1 : K) ⊗ₜ[A] (⟨g j, hg j⟩ : I)) := by
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul a b =>
      have hbI : (b : A) ∈ Ideal.span (Set.range g) := hI ▸ b.property
      obtain ⟨d, hd⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hbI
      have hb : b = ∑ j, d j • (⟨g j, hg j⟩ : I) := by
        apply Subtype.ext
        rw [← hd]
        simp [smul_eq_mul]
      refine ⟨fun j => d j • a, ?_⟩
      rw [hb, TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [TensorProduct.tmul_smul]
      simp only [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, by simp [add_smul, Finset.sum_add_distrib]⟩

/-- The evaluation of a family of derivations on base-changed differentials. -/
def derivationsEval {ι : Type*} (D : ι → Derivation k A K) :
    K ⊗[A] Ω[A⁄k] →ₗ[K] (ι → K) :=
  LinearMap.pi fun i => (D i).liftKaehlerDifferential.liftBaseChange K

theorem derivationsEval_cotangent {ι : Type*} (D : ι → Derivation k A K) (a : A)
    (ha : a ∈ RingHom.ker (algebraMap A B)) :
    derivationsEval D (cotangentComplexBaseChange k B A K ((1 : K) ⊗ₜ[A] ⟨a, ha⟩)) =
      fun i => D i a := by
  funext i
  simp only [derivationsEval, LinearMap.pi_apply, cotangentComplexBaseChange_tmul, one_smul,
    kerToTensor_apply, LinearMap.liftBaseChange_tmul, Derivation.liftKaehlerDifferential_comp_D]

/-- **Jacobian criterion, injectivity.** If the kernel of `A → B` is generated by `g` and there
are point derivations `Dᵢ : A → K` with `Dᵢ(gⱼ) = δᵢⱼ`, the base-changed conormal map
`K ⊗_A ker → K ⊗_A Ω_{A/k}` is injective. -/
theorem injective_cotangentComplexBaseChange_of_derivations {ι : Type*} [Fintype ι]
    [DecidableEq ι] (g : ι → A) (hg : ∀ j, g j ∈ RingHom.ker (algebraMap A B))
    (hI : RingHom.ker (algebraMap A B) = Ideal.span (Set.range g))
    (D : ι → Derivation k A K) (hD : ∀ i j, D i (g j) = if i = j then 1 else 0) :
    Function.Injective (cotangentComplexBaseChange k B A K) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  obtain ⟨c, rfl⟩ := exists_eq_sum_tmul_of_span (K := K) _ g hg hI x
  have h := congrArg (derivationsEval D) hx
  rw [map_sum, map_sum, map_zero] at h
  have hc : c = 0 := by
    funext i
    have hi := congrFun h i
    simp only [map_smul, derivationsEval_cotangent D _ (hg _), Finset.sum_apply,
      Pi.smul_apply, hD, smul_eq_mul, mul_ite, mul_one, mul_zero, Pi.zero_apply,
      Finset.sum_ite_eq, Finset.mem_univ, if_true] at hi
    simpa using hi
  simp [hc]

variable [Algebra k B] [IsScalarTower k A B] [Module.Free A Ω[A⁄k]] [Module.Finite A Ω[A⁄k]]

/-- **Jacobian criterion, formal smoothness.** A local quotient `B` of a formally smooth
`k`-algebra `A` (finite free differentials) by an ideal generated by `g`, such that there are
point derivations `Dᵢ : A → K` into a field receiving `B` with `Dᵢ(gⱼ) = δᵢⱼ`, is formally smooth
over `k`. -/
theorem formallySmooth_of_derivations [Algebra.FormallySmooth k A] [IsLocalRing B]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (hAB : Function.Surjective (algebraMap A B)) (g : ι → A)
    (hg : ∀ j, g j ∈ RingHom.ker (algebraMap A B))
    (hI : RingHom.ker (algebraMap A B) = Ideal.span (Set.range g))
    (D : ι → Derivation k A K) (hD : ∀ i j, D i (g j) = if i = j then 1 else 0)
    (hBK : maximalIdeal B ≤ RingHom.ker (algebraMap B K)) : Algebra.FormallySmooth k B := by
  have hfg : (RingHom.ker (algebraMap A B)).FG := by
    rw [hI]
    exact Submodule.fg_span (Set.finite_range g)
  exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange A K hAB hfg hBK).mpr
    (injective_cotangentComplexBaseChange_of_derivations g hg hI D hD)

end Derivations

/-! ### Contraction along a faithfully flat map -/

section FaithfullyFlat

variable {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)

/-- Faithful flatness: the contraction of an extended ideal is the ideal itself. -/
theorem comap_map_of_faithfullyFlat (hφ : φ.FaithfullyFlat) (I : Ideal A) :
    (I.map φ).comap φ = I := by
  let := φ.toAlgebra
  have : Module.FaithfullyFlat A B := hφ
  exact Ideal.comap_map_eq_self_of_faithfullyFlat I

theorem mem_of_map_mem_map (hφ : φ.FaithfullyFlat) {I : Ideal A} {a : A}
    (h : φ a ∈ I.map φ) : a ∈ I := by
  rw [← comap_map_of_faithfullyFlat φ hφ I]
  exact h

theorem map_span_image_comp {ι : Type*} (z : ι → A) (s : Set ι) :
    (Ideal.span (z '' s)).map φ = Ideal.span ((φ ∘ z) '' s) := by
  rw [Ideal.map_span, Set.image_image]
  rfl

variable {n : ℕ} (z : Fin n → A)

/-- If the images `φ(zⱼ)` generate the maximal ideal of `B` (and `φ` is local and faithfully
flat), the `zⱼ` generate the maximal ideal of `A`. -/
theorem span_range_eq_maximalIdeal_of_map [IsLocalRing A] [IsLocalRing B] [IsLocalHom φ]
    (hφ : φ.FaithfullyFlat) (hm : Ideal.span (Set.range (φ ∘ z)) = maximalIdeal B) :
    Ideal.span (Set.range z) = maximalIdeal A := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hmem : φ (z j) ∈ maximalIdeal B := by
      rw [← hm]
      exact Ideal.subset_span ⟨j, rfl⟩
    exact (mem_nonunits_iff.mp ((mem_maximalIdeal _).mp hmem)) (hu.map φ)
  · intro a ha
    apply mem_of_map_mem_map φ hφ
    have h1 : φ a ∈ maximalIdeal B := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (mem_nonunits_iff.mp ((mem_maximalIdeal _).mp ha)) (isUnit_of_map_unit φ a hu)
    rw [Ideal.map_span, ← Set.range_comp]
    rwa [hm]

/-- `(z_s)` is prime when the ideal generated by the images is (contraction of a prime). -/
theorem isPrime_span_image_of_map (hφ : φ.FaithfullyFlat) (s : Set (Fin n))
    (hp : (Ideal.span ((φ ∘ z) '' s)).IsPrime) : (Ideal.span (z '' s)).IsPrime := by
  rw [← comap_map_of_faithfullyFlat φ hφ (Ideal.span (z '' s)), map_span_image_comp]
  exact Ideal.comap_isPrime φ _

theorem notMem_span_image_of_map {s : Set (Fin n)} {j : Fin n}
    (h : φ (z j) ∉ Ideal.span ((φ ∘ z) '' s)) : z j ∉ Ideal.span (z '' s) := by
  intro hj
  apply h
  rw [← map_span_image_comp]
  exact Ideal.mem_map_of_mem φ hj

end FaithfullyFlat

/-! ### Heights of coordinate ideals -/

section Height

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsDomain A] {n : ℕ} (z : Fin n → A)

/-- If all the ideals `(z_s)` are prime and `zⱼ ∉ (z_s)` for `j ∉ s`, then `ht (z_s) = |s|`. -/
theorem height_span_image_eq_card
    (hprime : ∀ s : Finset (Fin n), (Ideal.span (z '' ↑s)).IsPrime)
    (hind : ∀ (s : Finset (Fin n)) (j : Fin n), j ∉ s → z j ∉ Ideal.span (z '' ↑s))
    (s : Finset (Fin n)) : (Ideal.span (z '' ↑s)).height = s.card := by
  classical
  apply le_antisymm
  · have := hprime s
    have hmin : Ideal.span (z '' ↑s) ∈
        (Ideal.span ((s.image z : Finset A) : Set A)).minimalPrimes := by
      rw [Finset.coe_image, Ideal.minimalPrimes_eq_subsingleton_self]
      rfl
    calc (Ideal.span (z '' ↑s)).height ≤ ((s.image z).card : ℕ∞) :=
          Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
      _ ≤ (s.card : ℕ∞) := by exact_mod_cast Finset.card_image_le
  · induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
        have := hprime s
        have := hprime (insert j s)
        have hlt : Ideal.span (z '' ↑s) < Ideal.span (z '' ↑(insert j s)) := by
          refine lt_of_le_of_ne (Ideal.span_mono (Set.image_mono (by simp))) fun heq => ?_
          apply hind s j hj
          rw [heq]
          exact Ideal.subset_span ⟨j, by simp, rfl⟩
        have h1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
        rw [Finset.card_insert_of_notMem hj, Nat.cast_add, Nat.cast_one]
        exact (add_le_add ih le_rfl).trans h1

end Height

/-! ### Regular elements and units of the fraction field -/

section Fraction

variable {A B K L : Type*} [CommRing A] [CommRing B] [IsDomain A] [IsDomain B]
  [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L]
  {φ : A →+* B} (hinj : Function.Injective φ)

omit [IsDomain A] in
theorem fractionMap_algebraMap (a : A) :
    IsFractionRing.map (K := K) (L := L) hinj (algebraMap A K a) = algebraMap B L (φ a) :=
  IsLocalization.map_eq _ _

/-- An element of `Frac A` whose image in `Frac B` lies in `B` lies in `A` (`φ` faithfully
flat). -/
theorem exists_algebraMap_eq_of_map_eq (hφ : φ.FaithfullyFlat) (q : K) (b : B)
    (h : IsFractionRing.map (K := K) (L := L) hinj q = algebraMap B L b) :
    ∃ a : A, algebraMap A K a = q := by
  obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := A) q
  have hy0 : algebraMap A K y ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (nonZeroDivisors.ne_zero hy)
  have hφy : φ y ≠ 0 := (map_ne_zero_iff φ hinj).mpr (nonZeroDivisors.ne_zero hy)
  have hLy : algebraMap B L (φ y) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective B L)).mpr hφy
  rw [map_div₀, fractionMap_algebraMap, fractionMap_algebraMap, div_eq_iff hLy, ← map_mul] at h
  have hx : φ x = b * φ y := IsFractionRing.injective B L h
  have hmem : x ∈ Ideal.span {y} := by
    apply mem_of_map_mem_map φ hφ
    rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton, hx]
    exact Dvd.intro_left b rfl
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hmem
  refine ⟨a, ?_⟩
  rw [map_mul, mul_div_cancel_left₀ _ hy0]

/-- An element of `Frac A` whose image in `Frac B` is a unit of `B` is a unit of `A`. -/
theorem exists_unit_algebraMap_eq_of_map_eq (hφ : φ.FaithfullyFlat) (q : K) (η : Bˣ)
    (h : IsFractionRing.map (K := K) (L := L) hinj q = algebraMap B L η) :
    ∃ ε : Aˣ, algebraMap A K ε = q := by
  have hq : q ≠ 0 := by
    rintro rfl
    rw [map_zero] at h
    exact ((map_ne_zero_iff _ (IsFractionRing.injective B L)).mpr η.ne_zero) h.symm
  obtain ⟨a, ha⟩ := exists_algebraMap_eq_of_map_eq hinj hφ q η h
  have h' : IsFractionRing.map (K := K) (L := L) hinj q⁻¹ = algebraMap B L ((η⁻¹ : Bˣ) : B) := by
    rw [map_inv₀ (IsFractionRing.map (K := K) (L := L) hinj), h]
    exact (map_units_inv (algebraMap B L) η).symm
  obtain ⟨a', ha'⟩ := exists_algebraMap_eq_of_map_eq hinj hφ q⁻¹ _ h'
  have h1 : a * a' = 1 := by
    apply IsFractionRing.injective A K
    rw [map_mul, ha, ha', mul_inv_cancel₀ hq, map_one]
  exact ⟨⟨a, a', h1, by rw [mul_comm]; exact h1⟩, ha⟩

end Fraction

end SGPT.Okounkov.OF13
