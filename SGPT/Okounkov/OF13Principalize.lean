/-!
# Principalization of numerators and denominators

Source: chapter *The theory of Okounkov bodies*, `rmk:Abhyankar` (existence part of
[CFKLRS17, Thm 2.9]): the modification on which the given valuation becomes a flag valuation is a
log resolution of functions `u_k = P_k/Q_k`, obtained by Hironaka's principalization.

Let `M` be a compact complex manifold with a holomorphic embedding `Ψ : M → ℙᴺ`, and `P_k, Q_k`
(`k < r`) homogeneous polynomials of degree `d_k` whose restrictions do not vanish identically near
any point. Principalize (`HironakaAPI.exists_principalization`) the ideal sheaf
`𝔞 = ∏ₖ (Pₖ)(Qₖ)(Pₖ, Qₖ)`, generated by the `2ʳ` products `∏ₖ fₖ(bₖ)` with
`fₖ(true) = Pₖ²Qₖ`, `fₖ(false) = PₖQₖ²` (homogeneous of the same degree). On the resulting blow-up
tower `π : Y → M` the pull-back of `𝔞` is the ideal of an effective divisor `D` with simple normal
crossings support (`D.support = ⋃ E`), and at every point `y` of `Y`, for the germs
`pₖ = Pₖ(Ψ ∘ π)`, `qₖ = Qₖ(Ψ ∘ π)` read in a chart (**`exists_principalization_ratios`**):

* `pₖ ∣ qₖ` or `qₖ ∣ pₖ` (the pull-back of `Pₖ/Qₖ` or of its inverse is holomorphic);
* `pₖ` and `qₖ` divide every local generator of `D` at `y`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov.OF13

open Set Filter
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.FirstPass.BlowupSequences
open SGPT.Foundations.Analysis.Pending.AnalyticModificationLocalDiscrepancy
open SGPT.Foundations.Analysis.Pending.NormalCrossings
open SGPT.Okounkov SGPT.Projective SGPT.Projective.ComplexProjectiveSpace
open SGPT.GAGA.H0S SGPT.GAGA.ChowBl
open scoped Topology Manifold ContDiff

/-! ### Germs of spans -/

section Germs

variable {n : ℕ} {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y]
  [IsComplexManifold n Y] {y : Y}

omit [IsComplexManifold n Y] in
/-- A function in the span of `h` at `y` has its germ in the principal ideal of the germ of `h`. -/
theorem mk_mem_span_singleton_of_isInSpanAt {g h : Y → ℂ} (hg : HolomorphicAt n g y)
    (hh : HolomorphicAt n h y) (H : IsInSpanAt (n := n) (· = h) y g) :
    NativeHolGerm.mk g hg ∈ Ideal.span {NativeHolGerm.mk h hh} := by
  obtain ⟨-, N, s, a, hs, ha, hga⟩ := H
  have hs' : ∀ i, HolomorphicAt n (s i) y := fun i => (hs i) ▸ hh
  have hsum : HolomorphicAt n (fun z => ∑ i, a i z * s i z) y :=
    HolomorphicAt.sum Finset.univ fun i _ => (ha i).mul (hs' i)
  have h1 : NativeHolGerm.mk g hg = NativeHolGerm.mk (fun z => ∑ i, a i z * s i z) hsum :=
    NativeHolGerm.mk_eq_mk_iff.mpr hga
  rw [h1, SGPT.PSH.IdealRestriction.mk_sum_mul a s ha hs' hsum]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ ?_
  have h2 : NativeHolGerm.mk (s i) (hs' i) = NativeHolGerm.mk h hh :=
    NativeHolGerm.mk_eq_mk_iff.mpr (by rw [hs i])
  rw [h2]
  exact Ideal.mem_span_singleton_self _

/-- A function in the span of a finite family at `y` has its germ in the ideal of their germs. -/
theorem mk_mem_span_range_of_isInSpanAt {K : ℕ} {S : Fin K → Y → ℂ}
    (hS : ∀ m, HolomorphicAt n (S m) y) {g : Y → ℂ} (hg : HolomorphicAt n g y)
    (H : IsInSpanAt (n := n) (· ∈ Set.range S) y g) :
    NativeHolGerm.mk g hg ∈ Ideal.span (Set.range fun m => NativeHolGerm.mk (S m) (hS m)) := by
  obtain ⟨-, c, hc, hgc⟩ := CoherentIdealColon.isInSpanAt_range_iff.mp H
  have hsum : HolomorphicAt n (fun z => ∑ m, c m z * S m z) y :=
    HolomorphicAt.sum Finset.univ fun m _ => (hc m).mul (hS m)
  have h1 : NativeHolGerm.mk g hg = NativeHolGerm.mk (fun z => ∑ m, c m z * S m z) hsum :=
    NativeHolGerm.mk_eq_mk_iff.mpr hgc
  rw [h1, SGPT.PSH.IdealRestriction.mk_sum_mul c S hc hS hsum]
  exact Ideal.sum_mem _ fun m _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m, rfl⟩)

end Germs

/-! ### Pull-backs of polynomial ideal sheaves -/

section Pullback

universe u

variable {n N : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [CompactSpace M] {Ψ : M → ComplexProjectiveSpace N}
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]

/-- The germs at `y` of the pull-back of the polynomial ideal sheaf are generated by the pulled
back restrictions of the polynomials. -/
theorem mk_mem_span_of_pullback_polyIdeal (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
    {π : Y → M} (hπ : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π)
    {K : ℕ} {R : Fin K → MvPolynomial (Fin (N + 1)) ℂ} {D : ℕ} (hR : ∀ m, (R m).IsHomogeneous D)
    {y : Y} {i : Fin (N + 1)} (hi : Ψ (π y) ∈ (affineChart i).source)
    {g : Y → ℂ} (hg : HolomorphicAt n g y)
    (H : (GermIdeal.pullback (m := n) π (polyIdeal (n := n) Ψ R)).mem y g) :
    NativeHolGerm.mk g hg ∈ Ideal.span (Set.range fun m => NativeHolGerm.mk (genFun Ψ i (R m) ∘ π)
      ((holomorphicAt_genFun hΨ hi (R m)).comp_contMDiff
        (Eventually.of_forall fun z => hπ z))) := by
  classical
  have hS : ∀ m, HolomorphicAt n (genFun Ψ i (R m) ∘ π) y := fun m =>
    (holomorphicAt_genFun hΨ hi (R m)).comp_contMDiff (Eventually.of_forall fun z => hπ z)
  obtain ⟨-, L, s, a, hs, ha, hga⟩ := H
  choose b hb hbs using hs
  -- each `b j` is a combination of the restrictions near `π y`
  have hcomb : ∀ j, ∃ c : Fin K → M → ℂ, (∀ m, HolomorphicAt n (c m) (π y)) ∧
      b j =ᶠ[𝓝 (π y)] fun x => ∑ m, c m x * genFun Ψ i (R m) x := fun j => by
    have := (polyIdeal_mem_iff hΨ hR hi (b j)).mp (hb j)
    obtain ⟨-, c, hc, hbc⟩ := CoherentIdealColon.isInSpanAt_range_iff.mp this
    exact ⟨c, hc, hbc⟩
  choose c hc hbc using hcomb
  -- the composite combination
  let C : Fin K → Y → ℂ := fun m z => ∑ j, a j z * c j m (π z)
  have hC : ∀ m, HolomorphicAt n (C m) y := fun m =>
    HolomorphicAt.sum Finset.univ fun j _ => (ha j).mul
      ((hc j m).comp_contMDiff (Eventually.of_forall fun z => hπ z))
  have hgC : g =ᶠ[𝓝 y] fun z => ∑ m, C m z * (genFun Ψ i (R m) ∘ π) z := by
    have hev : ∀ᶠ z in 𝓝 y, ∀ j, b j (π z) =
        ∑ m, c j m (π z) * genFun Ψ i (R m) (π z) := by
      rw [eventually_all]
      intro j
      exact hπ.continuous.continuousAt.eventually (hbc j)
    filter_upwards [hga, hev] with z hz hz'
    rw [hz]
    show ∑ j, a j z * s j z =
      ∑ m, (∑ j, a j z * c j m (π z)) * genFun Ψ i (R m) (π z)
    have hs' : ∀ j, s j z = ∑ m, c j m (π z) * genFun Ψ i (R m) (π z) := fun j => by
      rw [hbs j]
      exact hz' j
    simp_rw [hs', Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun j _ => by ring
  exact mk_mem_span_range_of_isInSpanAt hS hg
    (CoherentIdealColon.isInSpanAt_range_iff.mpr ⟨hg, C, hC, hgC⟩)

end Pullback

/-! ### The principalization of numerators and denominators -/

section Principalization

universe u

variable {n N : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [CompactSpace M] {Ψ : M → ComplexProjectiveSpace N}
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]

/-- The germ at `y` of the pull-back along `π` of the restriction `P(Ψ/Zᵢ)`. -/
def pullGerm (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {π : Y → M}
    (hπ : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π) {y : Y} {i : Fin (N + 1)}
    (hi : Ψ (π y) ∈ (affineChart i).source) (P : MvPolynomial (Fin (N + 1)) ℂ) :
    NativeHolGerm n Y y :=
  NativeHolGerm.comap π hπ y (NativeHolGerm.mk (genFun Ψ i P) (holomorphicAt_genFun hΨ hi P))

theorem pullGerm_eq_mk (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {π : Y → M}
    (hπ : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π) {y : Y} {i : Fin (N + 1)}
    (hi : Ψ (π y) ∈ (affineChart i).source) (P : MvPolynomial (Fin (N + 1)) ℂ)
    (hP : HolomorphicAt n (genFun Ψ i P ∘ π) y) :
    pullGerm hΨ hπ hi P = NativeHolGerm.mk (genFun Ψ i P ∘ π) hP :=
  Subtype.ext (NativeHolGerm.comap_mk π hπ y _ _)

omit [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [CompactSpace M] in
theorem genFun_mul (i : Fin (N + 1)) (A B : MvPolynomial (Fin (N + 1)) ℂ) (x : M) :
    genFun Ψ i (A * B) x = genFun Ψ i A x * genFun Ψ i B x := by
  simp [genFun, SGPT.GAGA.PN.polyTuple]

omit [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [CompactSpace M] in
theorem genFun_pow (i : Fin (N + 1)) (A : MvPolynomial (Fin (N + 1)) ℂ) (k : ℕ) (x : M) :
    genFun Ψ i (A ^ k) x = genFun Ψ i A x ^ k := by
  simp [genFun, SGPT.GAGA.PN.polyTuple]

omit [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [CompactSpace M] in
theorem genFun_prod {ι : Type*} (s : Finset ι) (i : Fin (N + 1))
    (A : ι → MvPolynomial (Fin (N + 1)) ℂ) (x : M) :
    genFun Ψ i (∏ k ∈ s, A k) x = ∏ k ∈ s, genFun Ψ i (A k) x := by
  simp [genFun, SGPT.GAGA.PN.polyTuple]

omit [IsComplexManifold n M] [CompactSpace M] in
theorem mk_genFun_mul {x : M} (i : Fin (N + 1)) (A B : MvPolynomial (Fin (N + 1)) ℂ)
    (hA : HolomorphicAt n (genFun Ψ i A) x) (hB : HolomorphicAt n (genFun Ψ i B) x)
    (hAB : HolomorphicAt n (genFun Ψ i (A * B)) x) :
    NativeHolGerm.mk (genFun Ψ i (A * B)) hAB =
      NativeHolGerm.mk (genFun Ψ i A) hA * NativeHolGerm.mk (genFun Ψ i B) hB := by
  apply Subtype.ext
  change ((genFun Ψ i (A * B) : M → ℂ) : Germ (𝓝 x) ℂ) =
    ((genFun Ψ i A : M → ℂ) : Germ (𝓝 x) ℂ) * ((genFun Ψ i B : M → ℂ) : Germ (𝓝 x) ℂ)
  rw [← Germ.coe_mul]
  congr 1
  funext z
  exact genFun_mul i A B z

theorem polyGerm_mul (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {x : M} {i : Fin (N + 1)}
    (hi : Ψ x ∈ (affineChart i).source) (A B : MvPolynomial (Fin (N + 1)) ℂ) :
    OF9.polyGerm hΨ hi (A * B) = OF9.polyGerm hΨ hi A * OF9.polyGerm hΨ hi B :=
  mk_genFun_mul i A B _ _ _

theorem polyGerm_one (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {x : M} {i : Fin (N + 1)}
    (hi : Ψ x ∈ (affineChart i).source) : OF9.polyGerm hΨ hi 1 = 1 := by
  apply Subtype.ext
  change ((genFun Ψ i 1 : M → ℂ) : Germ (𝓝 x) ℂ) = ((fun _ => (1 : ℂ) : M → ℂ) : Germ (𝓝 x) ℂ)
  congr 1
  funext z
  simp [genFun, SGPT.GAGA.PN.polyTuple]

theorem polyGerm_pow (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {x : M} {i : Fin (N + 1)}
    (hi : Ψ x ∈ (affineChart i).source) (A : MvPolynomial (Fin (N + 1)) ℂ) (k : ℕ) :
    OF9.polyGerm hΨ hi (A ^ k) = OF9.polyGerm hΨ hi A ^ k := by
  induction k with
  | zero => rw [pow_zero, pow_zero, polyGerm_one]
  | succ k ih => rw [pow_succ, pow_succ, polyGerm_mul, ih]

theorem polyGerm_prod (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {x : M} {i : Fin (N + 1)}
    (hi : Ψ x ∈ (affineChart i).source) {ι : Type*} (s : Finset ι)
    (A : ι → MvPolynomial (Fin (N + 1)) ℂ) :
    OF9.polyGerm hΨ hi (∏ k ∈ s, A k) = ∏ k ∈ s, OF9.polyGerm hΨ hi (A k) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.prod_empty, Finset.prod_empty, polyGerm_one]
  | insert a s ha ih => rw [Finset.prod_insert ha, Finset.prod_insert ha, polyGerm_mul, ih]

end Principalization

/-! ### The main theorem -/

section Main

universe u

variable {n N : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [CompactSpace M] {Ψ : M → ComplexProjectiveSpace N}

/-- The generators `∏ₖ fₖ(bₖ)` (`fₖ(true) = Pₖ²Qₖ`, `fₖ(false) = PₖQₖ²`) of the ideal
`∏ₖ (Pₖ)(Qₖ)(Pₖ, Qₖ)`. -/
def ratioGenerators {r : ℕ} (P Q : Fin r → MvPolynomial (Fin (N + 1)) ℂ) (b : Fin r → Bool) :
    MvPolynomial (Fin (N + 1)) ℂ :=
  ∏ k, (if b k then P k ^ 2 * Q k else P k * Q k ^ 2)

omit [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [CompactSpace M] in
theorem isHomogeneous_ratioGenerators {r : ℕ} {P Q : Fin r → MvPolynomial (Fin (N + 1)) ℂ}
    {d : Fin r → ℕ} (hP : ∀ k, (P k).IsHomogeneous (d k)) (hQ : ∀ k, (Q k).IsHomogeneous (d k))
    (b : Fin r → Bool) : (ratioGenerators P Q b).IsHomogeneous (∑ k, 3 * d k) := by
  unfold ratioGenerators
  apply MvPolynomial.IsHomogeneous.prod
  intro k _
  split_ifs
  · have h := ((hP k).pow 2).mul (hQ k)
    convert h using 1
    ring
  · have h := (hP k).mul ((hQ k).pow 2)
    convert h using 1
    ring

/-- **Principalization of numerators and denominators.** Let `Ψ : M → ℙᴺ` be a holomorphic
embedding of a compact complex manifold and `Pₖ, Qₖ` homogeneous polynomials of degree `dₖ`
whose restrictions are nonzero germs at every point. There are a blow-up tower `π : Y → M`, an
effective divisor `D` on `Y` and a simple normal crossings divisor `E` with `supp D = ⋃ E` such
that at every `y ∈ Y`, for every local generator `h` of `D` at `y`, the pulled back germs
`pₖ, qₖ` of `Pₖ, Qₖ` are nonzero, `pₖ ∣ qₖ` or `qₖ ∣ pₖ`, and `pₖ, qₖ ∣ h`. -/
theorem exists_principalization_ratios (hΨ : IsHolomorphicEmbedding (n := n) Ψ) {r : ℕ}
    (P Q : Fin r → MvPolynomial (Fin (N + 1)) ℂ) (d : Fin r → ℕ)
    (hP : ∀ k, (P k).IsHomogeneous (d k)) (hQ : ∀ k, (Q k).IsHomogeneous (d k))
    (h0 : ∀ (x : M) (i : Fin (N + 1)) (hi : Ψ x ∈ (affineChart i).source) (k : Fin r),
      NativeHolGerm.mk (genFun Ψ i (P k)) (holomorphicAt_genFun hΨ hi (P k)) ≠ 0 ∧
      NativeHolGerm.mk (genFun Ψ i (Q k)) (holomorphicAt_genFun hΨ hi (Q k)) ≠ 0) :
    ∃ (Y : Type u) (_ : TopologicalSpace Y) (_ : ChartedSpace (ComplexModel n) Y)
      (_ : IsComplexManifold n Y) (π : Y → M) (hseq : IsBlowupSequence n M Y π)
      (D : EffectiveDivisor n Y) (E : List (Set Y)),
      IsSNCDivisor n E ∧ D.support = ⋃ H ∈ E, H ∧
      ∀ (y : Y) (i : Fin (N + 1)) (hi : Ψ (π y) ∈ (affineChart i).source)
        (h : Y → ℂ) (hh : HolomorphicAt n h y),
        (∀ g, D.ideal.mem y g ↔ IsInSpanAt (n := n) (· = h) y g) →
        NativeHolGerm.mk h hh ≠ 0 ∧ ∀ k,
          pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (P k) ≠ 0 ∧
          pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (Q k) ≠ 0 ∧
          (pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (P k) ∣
            pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (Q k) ∨
          pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (Q k) ∣
            pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (P k)) ∧
          pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (P k) ∣ NativeHolGerm.mk h hh ∧
          pullGerm hΨ (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence hseq).1 hi
              (Q k) ∣ NativeHolGerm.mk h hh := by
  classical
  let e := Fintype.equivFin (Fin r → Bool)
  let K := Fintype.card (Fin r → Bool)
  let R : Fin K → MvPolynomial (Fin (N + 1)) ℂ := fun m => ratioGenerators P Q (e.symm m)
  have hR : ∀ m, (R m).IsHomogeneous (∑ k, 3 * d k) := fun m =>
    isHomogeneous_ratioGenerators hP hQ _
  -- the germ of a generator is the product of the germs
  have hgerm : ∀ (x : M) (i : Fin (N + 1)) (hi : Ψ x ∈ (affineChart i).source)
      (b : Fin r → Bool), OF9.polyGerm hΨ hi (ratioGenerators P Q b) =
        ∏ k, (if b k then OF9.polyGerm hΨ hi (P k) ^ 2 * OF9.polyGerm hΨ hi (Q k)
          else OF9.polyGerm hΨ hi (P k) * OF9.polyGerm hΨ hi (Q k) ^ 2) := by
    intro x i hi b
    unfold ratioGenerators
    rw [polyGerm_prod]
    refine Finset.prod_congr rfl fun k _ => ?_
    split_ifs <;> simp only [polyGerm_mul, polyGerm_pow]
  -- nonvanishing of the ideal sheaf
  have hne := polyIdeal_nonzero (n := n) hΨ (R := R) fun x => by
    obtain ⟨i, hi⟩ := exists_mem_affineChart_source (Ψ x)
    refine ⟨i, e (fun _ => true), hi, ?_⟩
    intro hev
    have hz : OF9.polyGerm hΨ hi (R (e fun _ => true)) = 0 := by
      have h1 : (0 : NativeHolGerm n M x) = NativeHolGerm.mk (fun _ => (0 : ℂ))
          (holomorphicAt_const 0) := rfl
      rw [h1]
      exact NativeHolGerm.mk_eq_mk_iff.mpr (hev.mono fun z hz => not_ne_iff.mp hz)
    simp only [R, Equiv.symm_apply_apply, hgerm x i hi, if_true] at hz
    exact Finset.prod_ne_zero_iff.mpr (fun k _ => mul_ne_zero (pow_ne_zero 2 (h0 x i hi k).1)
      (h0 x i hi k).2) hz
  obtain ⟨Y, tY, cY, mY, π, D, E, hadm, hpull, hsnc, hsupp, -, -⟩ :=
    HironakaAPI.exists_principalization (isCoherent_polyIdeal hΨ hR) hne
  refine ⟨Y, tY, cY, mY, π, hadm.isBlowupSequence, D, E, hsnc, hsupp, ?_⟩
  intro y i hi h hh hgen
  set hπ := (HironakaChowLemma.isAnalyticModification_of_isBlowupSequence
    hadm.isBlowupSequence).1
  have hmod := HironakaChowLemma.isAnalyticModification_of_isBlowupSequence
    hadm.isBlowupSequence
  let p : Fin r → NativeHolGerm n Y y := fun k => pullGerm hΨ hπ hi (P k)
  let q : Fin r → NativeHolGerm n Y y := fun k => pullGerm hΨ hπ hi (Q k)
  have hp0 : ∀ k, p k ≠ 0 := fun k hk =>
    (h0 (π y) i hi k).1 ((OF2.nativeHolGerm_comap_injective hmod y) (hk.trans (map_zero _).symm))
  have hq0 : ∀ k, q k ≠ 0 := fun k hk =>
    (h0 (π y) i hi k).2 ((OF2.nativeHolGerm_comap_injective hmod y) (hk.trans (map_zero _).symm))
  -- the germs of the generators
  have hRgerm : ∀ b : Fin r → Bool, pullGerm hΨ hπ hi (ratioGenerators P Q b) =
      ∏ k, (if b k then p k ^ 2 * q k else p k * q k ^ 2) := by
    intro b
    change NativeHolGerm.comap π hπ y (OF9.polyGerm hΨ hi (ratioGenerators P Q b)) = _
    rw [hgerm (π y) i hi b, map_prod]
    refine Finset.prod_congr rfl fun k _ => ?_
    split_ifs <;> simp only [map_mul, map_pow] <;> rfl
  -- the principal ideal
  have hspan : Ideal.span (Set.range fun b : Fin r → Bool =>
      ∏ k, (if b k then p k ^ 2 * q k else p k * q k ^ 2)) =
      Ideal.span {NativeHolGerm.mk h hh} := by
    have hS : ∀ m, HolomorphicAt n (genFun Ψ i (R m) ∘ π) y := fun m =>
      (holomorphicAt_genFun hΨ hi (R m)).comp_contMDiff (Eventually.of_forall fun z => hπ z)
    have hrange : (Set.range fun b : Fin r → Bool =>
        ∏ k, (if b k then p k ^ 2 * q k else p k * q k ^ 2)) =
        Set.range fun m => NativeHolGerm.mk (genFun Ψ i (R m) ∘ π) (hS m) := by
      ext g
      constructor
      · rintro ⟨b, rfl⟩
        refine ⟨e b, ?_⟩
        dsimp only
        rw [← hRgerm b]
        have hRb : R (e b) = ratioGenerators P Q b := by simp [R]
        rw [← pullGerm_eq_mk hΨ hπ hi _ (hS (e b))]
        rw [hRb]
      · rintro ⟨m, rfl⟩
        refine ⟨e.symm m, ?_⟩
        dsimp only
        rw [← hRgerm]
        exact pullGerm_eq_mk hΨ hπ hi (R m) (hS m)
    rw [hrange]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨m, rfl⟩
      apply mk_mem_span_singleton_of_isInSpanAt (hS m) hh
      rw [← hgen, ← hpull]
      refine ⟨hS m, 1, fun _ => genFun Ψ i (R m) ∘ π, fun _ => fun _ => 1,
        fun _ => ⟨genFun Ψ i (R m),
        (polyIdeal_mem_iff hΨ hR hi _).mpr ?_, rfl⟩, fun _ => holomorphicAt_const 1,
        Eventually.of_forall fun z => by simp⟩
      rw [CoherentIdealColon.isInSpanAt_range_iff]
      exact ⟨holomorphicAt_genFun hΨ hi _, fun l _ => if l = m then 1 else 0,
        fun l => holomorphicAt_const _, Eventually.of_forall fun z => by simp⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      apply mk_mem_span_of_pullback_polyIdeal hΨ hπ hR hi hh
      rw [hpull, hgen]
      exact ⟨hh, 1, fun _ => h, fun _ => fun _ => 1, fun _ => rfl, fun _ => holomorphicAt_const 1,
        Eventually.of_forall fun z => by simp⟩
  have hh0 : NativeHolGerm.mk h hh ≠ 0 := by
    intro h0'
    rw [h0', Ideal.span_singleton_eq_bot.mpr rfl] at hspan
    have hmem := Ideal.subset_span (s := Set.range fun b : Fin r → Bool =>
      ∏ k, (if b k then p k ^ 2 * q k else p k * q k ^ 2)) ⟨fun _ => true, rfl⟩
    rw [hspan, SetLike.mem_coe, Ideal.mem_bot] at hmem
    simp only [if_true] at hmem
    exact Finset.prod_ne_zero_iff.mpr (fun k _ => mul_ne_zero (pow_ne_zero 2 (hp0 k)) (hq0 k))
      hmem
  obtain ⟨hdvd, hgdvd⟩ := dvd_or_dvd_of_span_range_prod_eq p q hp0 hq0 hh0 hspan
  exact ⟨hh0, fun k => ⟨hp0 k, hq0 k, hdvd k, (hgdvd k).1, (hgdvd k).2⟩⟩

end Main

