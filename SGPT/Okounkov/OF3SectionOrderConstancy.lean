import SGPT.Okounkov.OF3SectionDivisorOrder
import SGPT.Projective.OkounkovOriginalIdealProducts
import SGPT.Foundations.Analysis.Pending.MultiplierPullbackNonzero
import SGPT.Foundations.Analysis.Pending.IdealPowerNormalOrder
import SGPT.Foundations.Analysis.Pending.GermIdealPullbackCalculus
import SGPT.Foundations.Analysis.Pending.InvertibleIdealQuotient

/-!
# `ord_E(s)` is the order of `π^* s` along `E` at every point of `E`

Source: chapter *The theory of Okounkov bodies*, `thm:nuOk`, `cor:numin` (the order of vanishing
`ord_E(s)` of a section along a prime divisor `E` over `X`).

`SGPT.Okounkov.OF3.sectionDivisorOrder` is defined as an infimum over the points of `E`, the
local frames and the local equations of `E`. We prove that for a nonzero section `s` of a line
bundle `M` the order of vanishing of `π^*` of the frame coefficient of `s` along `E` at `y` is
the same finite number at **every** point `y ∈ E`, in every frame and every flattening of `E`
(`E` is connected); hence `sectionDivisorOrder` is that number (the generic order of vanishing
of `π^* s` along `E`, the book's `ord_E(s)`), and it is finite.

## Main results

* `frequently_frameCoefficient_ne_zero`: the coefficient of a nonzero section of a line bundle on
  the integral scheme `X` does not vanish identically near any point of `X(ℂ)`.
* `sectionIdeal`: the ideal sheaf on `X(ℂ)` generated by the coefficients of `s`; it is
  coherent (`sectionIdeal_isCoherent`) and in any frame it is generated by the coefficient
  (`sectionIdeal_mem_iff`).
* **`sectionDivisorOrder_eq_pullbackNormalOrder`**, `sectionDivisorOrder_ne_top`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov.OF3

open Set Filter CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending.FixedGermNormalOrder
open SGPT.Foundations.Analysis.Pending.DemaillyApproximantDivisorialLelong
open SGPT.Foundations.Analysis.Pending.AnalyticModificationLocalDiscrepancy
open SGPT.Foundations.Analysis.FirstPass.BlowupSequences
open SGPT.PSH.CompactPrimeOver

variable {X : Scheme.{0}} [IsIntegral X] (f : X ⟶ Spec (.of ℂ)) {m : ℕ}
  [SmoothOfRelativeDimension (m + 1) f] (E : ClosedProjectiveEmbedding f)
  [IsSeparated f] [QuasiCompact f]

local instance of3ConstTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance of3ConstCharts : ChartedSpace (ComplexModel (m + 1)) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f (m + 1)
local instance of3ConstManifold : IsComplexManifold (m + 1) (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f (m + 1)

variable {M : X.Modules}

variable (m) in
/-- The holomorphic coefficient of a section `s` of `M` in a local frame `β` on `U`. -/
def frameCoefficient {U : X.Opens} (β : LocalBundleFrame M U) (s : bundleSections M ⊤) :
    SchemeComplexPoint f → ℂ :=
  schemeOpenRegularFunction f (m + 1) E U (β.coefficients (𝟙 U) (M.val.map (homOfLE le_top).op s))

omit [IsIntegral X] [IsSeparated f] [QuasiCompact f] in
theorem frameCoefficient_holomorphicAt {U : X.Opens} (β : LocalBundleFrame M U)
    (s : bundleSections M ⊤) {x : SchemeComplexPoint f} (hx : schemeComplexPointImage f x ∈ U) :
    HolomorphicAt (m + 1) (frameCoefficient f m E β s) x :=
  schemeOpenRegularFunction_holomorphicAt f (m + 1) E U _ x hx

/-- **Nonzero sections have nonzero coefficient germs.** -/
theorem frequently_frameCoefficient_ne_zero (b : LineBundleAtlas M) {s : bundleSections M ⊤}
    (hs : s ≠ 0) {U : X.Opens} (β : LocalBundleFrame M U) {x : SchemeComplexPoint f}
    (hx : schemeComplexPointImage f x ∈ U) :
    ∃ᶠ y in 𝓝 x, frameCoefficient f m E β s y ≠ 0 := by
  set r := β.coefficients (𝟙 U) (M.val.map (homOfLE le_top).op s) with hr
  have : Nonempty U := ⟨⟨_, hx⟩⟩
  have hr0 : r ≠ 0 := by
    intro h0
    apply hs
    apply globalSectionToFunctionField_injective b β
    change X.germToFunctionField U r = globalSectionToFunctionField β 0
    rw [h0, map_zero, map_zero]
  by_contra hzero
  have hev : ∀ᶠ y in 𝓝 x, frameCoefficient f m E β s y = 0 := by
    filter_upwards [Filter.not_frequently.mp hzero] with y hy
    exact not_ne_iff.mp hy
  have hhol := frameCoefficient_holomorphicAt (m := m) f E β s hx
  have hz : NativeHolGerm.mk (frameCoefficient f m E β s) hhol = 0 := by
    apply Subtype.ext
    apply Germ.coe_eq.mpr
    exact hev
  change NativeHolGerm.mk (schemeOpenRegularFunction f (m + 1) E U r) hhol = 0 at hz
  rw [schemeOpenRegularFunction_germ] at hz
  apply hr0
  apply germ_injective_of_isIntegral X (schemeComplexPointImage f x) hx
  apply schemeNativeStalkGerm_injective f (m + 1) x
  simpa only [map_zero] using hz

omit [IsIntegral X] [IsSeparated f] [QuasiCompact f] in
/-- Frame change: the coefficient in `β'` is a holomorphic multiple of the coefficient in `β`. -/
theorem frameCoefficient_eventuallyEq_mul {U V : X.Opens} (β : LocalBundleFrame M U)
    (β' : LocalBundleFrame M V) (s : bundleSections M ⊤) {x : SchemeComplexPoint f}
    (hxU : schemeComplexPointImage f x ∈ U) (hxV : schemeComplexPointImage f x ∈ V) :
    frameCoefficient f m E β' s =ᶠ[𝓝 x]
      fun y => schemeFrameTransition f (m + 1) E β β' y * frameCoefficient f m E β s y := by
  have hO : IsOpen (schemeComplexPointImage f ⁻¹' ((U ⊓ V : X.Opens) : Set X)) :=
    (U ⊓ V).isOpen.preimage (schemeComplexPointImage_continuous f)
  filter_upwards [hO.mem_nhds ⟨hxU, hxV⟩] with y hy
  exact OriginalIdealProducts.originalOrdinaryCoefficient_transition f (m + 1) E β β' s y hy.1 hy.2

variable (m) in
/-- The ideal sheaf generated by the coefficients of a section `s` of `M`. -/
def sectionIdeal (s : bundleSections M ⊤) : GermIdeal (m + 1) (SchemeComplexPoint f) where
  mem x g := ∃ (U : X.Opens) (β : LocalBundleFrame M U)
    (_ : schemeComplexPointImage f x ∈ U), IsInSpanAt (n := m + 1) (· = frameCoefficient f m E β s) x g

omit [IsIntegral X] [IsSeparated f] [QuasiCompact f] in
/-- In a frame `β` at `x`, `𝓘_s` is generated by the coefficient of `s` in `β`. -/
theorem sectionIdeal_mem_iff {U : X.Opens} (β : LocalBundleFrame M U) (s : bundleSections M ⊤)
    {x : SchemeComplexPoint f} (hx : schemeComplexPointImage f x ∈ U) (g : SchemeComplexPoint f → ℂ) :
    (sectionIdeal f m E s).mem x g ↔
      IsInSpanAt (n := m + 1) (· = frameCoefficient f m E β s) x g := by
  constructor
  · rintro ⟨V, β', hxV, hg, N, t, c, ht, hc, heq⟩
    have htr := frameCoefficient_eventuallyEq_mul (m := m) f E β β' s hx hxV
    have hT := schemeFrameTransition_holomorphicAt f (m + 1) E β β' x hx hxV
    refine ⟨hg, N, fun _ => frameCoefficient f m E β s,
      fun i y => c i y * schemeFrameTransition f (m + 1) E β β' y, fun _ => rfl,
      fun i => (hc i).mul hT, ?_⟩
    filter_upwards [heq, htr] with y hy hyt
    rw [hy]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ht i, hyt]
    ring
  · intro h
    exact ⟨U, β, hx, h⟩

omit [IsIntegral X] [IsSeparated f] [QuasiCompact f] in
/-- `𝓘_s` is coherent (locally principal). -/
theorem sectionIdeal_isCoherent (b : LineBundleAtlas M) (s : bundleSections M ⊤) :
    (sectionIdeal f m E s).IsCoherent := by
  intro x
  obtain ⟨i, hi⟩ := b.covers (schemeComplexPointImage f x)
  refine ⟨schemeComplexPointImage f ⁻¹' (b.opens i : Set X),
    (b.opens i).isOpen.preimage (schemeComplexPointImage_continuous f), hi, 1,
    fun _ => frameCoefficient f m E (b.frame i) s, fun _ =>
      schemeOpenRegularFunction_mdifferentiableOn f (m + 1) E (b.opens i) _, fun y hy g => ?_⟩
  rw [sectionIdeal_mem_iff (m := m) f E (b.frame i) s hy g]
  constructor
  · exact IsInSpanAt.mono fun t ht => ⟨0, ht.symm⟩
  · exact IsInSpanAt.mono fun t ⟨_, ht⟩ => ht.symm

omit [IsIntegral X] in
/-- **The pulled-back section ideal is principal at every point**: its order along `E` is the
order of `π^*` of the coefficient of `s`, in any frame. -/
theorem originalStalkNormalOrder_pullback_sectionIdeal
    (p : PrimePresentation (m + 1) (SchemeComplexPoint f)) (s : bundleSections M ⊤)
    {y : p.model} {U : X.Opens} (β : LocalBundleFrame M U)
    (hU : schemeComplexPointImage f (p.projection y) ∈ U)
    (Φ : DivisorFlattening (m := m) p.divisor y) :
    originalStalkNormalOrder Φ (GermIdeal.pullback (m := m + 1) p.projection (sectionIdeal f m E s)) =
      pullbackNormalOrder p.modification Φ (frameCoefficient f m E β s)
        (frameCoefficient_holomorphicAt (m := m) f E β s hU) := by
  have hhol := frameCoefficient_holomorphicAt (m := m) f E β s hU
  have hπc : ∀ᶠ z in 𝓝 y, ContMDiffAt 𝓘(ℂ, ComplexModel (m + 1)) 𝓘(ℂ, ComplexModel (m + 1)) ∞
      p.projection z := Eventually.of_forall fun _ => p.modification.1.contMDiffAt
  let G : Fin 1 → p.model → ℂ := fun _ => frameCoefficient f m E β s ∘ p.projection
  have hG : ∀ i, HolomorphicAt (m + 1) (G i) y := fun _ => hhol.comp_contMDiff hπc
  rw [originalStalkNormalOrder_eq_generators Φ _ G hG ?_]
  · rw [iInf_unique]
    rfl
  intro g
  constructor
  · rintro ⟨hg, N, t, c, ht, hc, heq⟩
    -- each generator `a ∘ π`, `a ∈ 𝓘_s`, is a multiple of `coef ∘ π`
    have hgen : ∀ i, ∃ d : p.model → ℂ, HolomorphicAt (m + 1) d y ∧
        t i =ᶠ[𝓝 y] fun z => d z * (frameCoefficient f m E β s ∘ p.projection) z := by
      intro i
      obtain ⟨a, ha, hta⟩ := ht i
      obtain ⟨-, K, u, e, hu, he, hae⟩ := (sectionIdeal_mem_iff (m := m) f E β s hU a).mp ha
      refine ⟨fun z => ∑ j, e j (p.projection z), ?_, ?_⟩
      · exact HolomorphicAt.sum Finset.univ fun j _ => (he j).comp_contMDiff hπc
      · rw [hta]
        filter_upwards [p.modification.1.continuous.continuousAt.tendsto.eventually hae] with z hz
        simp only [Function.comp_apply] at hz ⊢
        rw [hz, Finset.sum_mul]
        exact Finset.sum_congr rfl fun j _ => by rw [hu j]
    choose d hd hdeq using hgen
    refine ⟨hg, 1, G, fun _ z => ∑ i, c i z * d i z, fun _ => mem_range_self 0,
      fun _ => HolomorphicAt.sum Finset.univ fun i _ => (hc i).mul (hd i), ?_⟩
    filter_upwards [heq, Filter.eventually_all.mpr hdeq] with z hz hzd
    rw [hz, Fin.sum_univ_one, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hzd i]
    simp only [G]
    ring
  · intro hg
    show IsInSpanAt (n := m + 1) (fun s' => ∃ a, (sectionIdeal f m E s).mem (p.projection y) a ∧
      s' = a ∘ p.projection) y g
    refine IsInSpanAt.mono ?_ hg
    rintro _ ⟨_, rfl⟩
    exact ⟨frameCoefficient f m E β s,
      (sectionIdeal_mem_iff (m := m) f E β s hU _).mpr (InvertibleIdealQuotient.isInSpanAt_self rfl hhol), rfl⟩

/-- **`ord_E(s)` is the order of `π^* s` along `E` at any point of `E`.** For a nonzero section
`s` of a line bundle `M`, every point `y ∈ E`, every local frame `β` of `M` at `π(y)` and every
flattening of `E` at `y` give the same finite order, which is `sectionDivisorOrder`. -/
theorem sectionDivisorOrder_eq_pullbackNormalOrder (b : LineBundleAtlas M)
    (p : PrimePresentation (m + 1) (SchemeComplexPoint f)) {s : bundleSections M ⊤} (hs : s ≠ 0)
    {y : p.model} (hy : y ∈ p.divisor) {U : X.Opens} (β : LocalBundleFrame M U)
    (hU : schemeComplexPointImage f (p.projection y) ∈ U)
    (Φ : DivisorFlattening (m := m) p.divisor y) :
    sectionDivisorOrder f E p s = pullbackNormalOrder p.modification Φ (frameCoefficient f m E β s)
      (frameCoefficient_holomorphicAt (m := m) f E β s hU) ∧
      pullbackNormalOrder p.modification Φ (frameCoefficient f m E β s)
        (frameCoefficient_holomorphicAt (m := m) f E β s hU) ≠ ⊤ := by
  have hE := isClosedConnectedSubmanifold_divisor p
  set A := GermIdeal.pullback (m := m + 1) p.projection (sectionIdeal f m E s) with hA
  have hcoh : A.IsCoherent :=
    GermIdealPullbackCalculus.isCoherent_pullback p.modification.1 (sectionIdeal_isCoherent (m := m) f E b s)
  have hnon : ∀ z, DivisorExponent.IsNonzeroAt A z := by
    intro z
    obtain ⟨i, hi⟩ := b.covers (schemeComplexPointImage f (p.projection z))
    have hhol := frameCoefficient_holomorphicAt (m := m) f E (b.frame i) s hi
    refine ⟨frameCoefficient f m E (b.frame i) s ∘ p.projection, ?_,
      MultiplierPullbackNonzero.frequently_comp_ne_zero p.modification z hhol
        (frequently_frameCoefficient_ne_zero (m := m) f E b hs (b.frame i) hi)⟩
    show IsInSpanAt (n := m + 1) (fun s' => ∃ a, (sectionIdeal f m E s).mem (p.projection z) a ∧
      s' = a ∘ p.projection) z _
    exact InvertibleIdealQuotient.isInSpanAt_self ⟨frameCoefficient f m E (b.frame i) s,
      (sectionIdeal_mem_iff (m := m) f E (b.frame i) s hi _).mpr
        (InvertibleIdealQuotient.isInSpanAt_self rfl hhol), rfl⟩
      (hhol.comp_contMDiff (Eventually.of_forall fun _ => p.modification.1.contMDiffAt))
  obtain ⟨a, ha⟩ := IdealPowerNormalOrder.exists_originalStalkNormalOrder_on_connected_hypersurface
    hE A hcoh hnon
  have hconst : ∀ (y' : p.model) (hy' : y' ∈ p.divisor) (U' : X.Opens) (β' : LocalBundleFrame M U')
      (hU' : schemeComplexPointImage f (p.projection y') ∈ U')
      (Φ' : DivisorFlattening (m := m) p.divisor y'),
      pullbackNormalOrder p.modification Φ' (frameCoefficient f m E β' s)
        (frameCoefficient_holomorphicAt (m := m) f E β' s hU') = (a : ℕ∞) := by
    intro y' hy' U' β' hU' Φ'
    rw [← originalStalkNormalOrder_pullback_sectionIdeal f E p s β' hU' Φ']
    exact ha y' hy' Φ'
  refine ⟨?_, by rw [hconst y hy U β hU Φ]; exact ENat.natCast_ne_top a⟩
  rw [hconst y hy U β hU Φ]
  apply le_antisymm
  · rw [← hconst y hy U β hU Φ]
    exact sectionDivisorOrder_le f E p s hy β hU Φ
  · refine le_iInf fun y' => le_iInf fun hy' => le_iInf fun U' => le_iInf fun β' => le_iInf fun hU' =>
      le_iInf fun Φ' => ?_
    exact (hconst y' hy' U' β' hU' Φ').ge

/-- The order of a nonzero section along `E` is finite. -/
theorem sectionDivisorOrder_ne_top (b : LineBundleAtlas M)
    (p : PrimePresentation (m + 1) (SchemeComplexPoint f)) {s : bundleSections M ⊤} (hs : s ≠ 0) :
    sectionDivisorOrder f E p s ≠ ⊤ := by
  have hE := isClosedConnectedSubmanifold_divisor p
  obtain ⟨y, hy⟩ := hE.2.1.nonempty
  obtain ⟨Φ⟩ := DivisorFlattening.nonempty_of_regularAtDim (hE.2.2 y hy)
  obtain ⟨i, hi⟩ := b.covers (schemeComplexPointImage f (p.projection y))
  obtain ⟨h1, h2⟩ := sectionDivisorOrder_eq_pullbackNormalOrder f E b p hs hy (b.frame i) hi Φ
  rw [h1]
  exact h2

end SGPT.Okounkov.OF3
