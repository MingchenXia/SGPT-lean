import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.Tactic.LinearCombination
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.GroupWithZero.Divisibility

/-!
# Principalized products in a local domain

Source: chapter *The theory of Okounkov bodies*, `rmk:Abhyankar` (existence part of
[CFKLRS17, Thm 2.9]). After principalizing the ideal `∏ₖ (Pₖ)(Qₖ)(Pₖ, Qₖ)`, generated by the
products `∏ₖ fₖ(bₖ)` with `fₖ(true) = Pₖ²Qₖ`, `fₖ(false) = PₖQₖ²`, the pulled back ideal is
principal at every point. In a local domain this forces, for each `k`, one of `Pₖ²Qₖ, PₖQₖ²` to
divide the other, i.e. `Pₖ ∣ Qₖ` or `Qₖ ∣ Pₖ`: the rational function `Pₖ/Qₖ` or its inverse is
regular (`dvd_or_dvd_of_span_range_prod_eq`).
-/

set_option autoImplicit false

namespace SGPT.Okounkov.OF13

open IsLocalRing

variable {R : Type*} [CommRing R]

/-- In a local ring, a finite family generating a nonzero principal ideal of a domain contains a
generator: some member divides all the others. -/
theorem exists_dvd_of_span_range_eq_span_singleton [IsLocalRing R] [IsDomain R] {ι : Type*}
    [Fintype ι] (g : ι → R) {h : R} (hh : h ≠ 0)
    (H : Ideal.span (Set.range g) = Ideal.span {h}) : ∃ i₀, ∀ i, g i₀ ∣ g i := by
  classical
  have hmem : h ∈ Ideal.span (Set.range g) := H ▸ Ideal.mem_span_singleton_self h
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hmem
  have he : ∀ i, ∃ e, g i = e * h := fun i => by
    have hi : g i ∈ Ideal.span {h} := H ▸ Ideal.subset_span ⟨i, rfl⟩
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp hi
    exact ⟨e, he.symm⟩
  choose e he using he
  have hsum : ∑ i, c i * e i = 1 := by
    have h1 : (∑ i, c i * e i) * h = 1 * h := by
      rw [one_mul, Finset.sum_mul]
      conv_rhs => rw [← hc]
      exact Finset.sum_congr rfl fun i _ => by rw [he i, mul_assoc]
    exact mul_right_cancel₀ hh h1
  obtain ⟨i₀, hi₀⟩ : ∃ i, IsUnit (c i * e i) := by
    by_contra hcon
    push Not at hcon
    have hm : ∑ i, c i * e i ∈ maximalIdeal R :=
      Submodule.sum_mem _ fun i _ => (mem_maximalIdeal _).mpr (hcon i)
    rw [hsum] at hm
    exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr hm)
  have hu : IsUnit (e i₀) := isUnit_of_mul_isUnit_right hi₀
  refine ⟨i₀, fun i => ⟨e i * ↑hu.unit⁻¹, ?_⟩⟩
  rw [he i, he i₀]
  linear_combination (-(e i * h)) * hu.mul_val_inv

/-- If a product `∏ₖ fₖ(b₀ₖ)` divides all the products `∏ₖ fₖ(bₖ)`, then each factor `fₖ(b₀ₖ)`
divides the other choice `fₖ(¬b₀ₖ)`. -/
theorem dvd_flip_of_prod_dvd [IsDomain R] {r : ℕ} (f : Fin r → Bool → R)
    (hf : ∀ k b, f k b ≠ 0) (b₀ : Fin r → Bool)
    (hdiv : ∀ b : Fin r → Bool, (∏ k, f k (b₀ k)) ∣ ∏ k, f k (b k)) (k : Fin r) :
    f k (b₀ k) ∣ f k (!b₀ k) := by
  classical
  let b₁ : Fin r → Bool := Function.update b₀ k (!b₀ k)
  have h1 : ∏ l, f l (b₁ l) = f k (!b₀ k) * ∏ l ∈ Finset.univ.erase k, f l (b₀ l) := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ k)]
    congr 1
    · simp [b₁]
    · exact Finset.prod_congr rfl fun l hl => by
        simp [b₁, Function.update_of_ne (Finset.ne_of_mem_erase hl)]
  have h0 : ∏ l, f l (b₀ l) = f k (b₀ k) * ∏ l ∈ Finset.univ.erase k, f l (b₀ l) :=
    (Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ k)).symm
  have hrest : ∏ l ∈ Finset.univ.erase k, f l (b₀ l) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun l _ => hf l _
  have h := hdiv b₁
  rw [h1, h0] at h
  exact (mul_dvd_mul_iff_right hrest).mp h

/-- `p²q ∣ pq²` forces `p ∣ q` (for `p, q ≠ 0` in a domain). -/
theorem dvd_of_sq_mul_dvd [IsDomain R] {p q : R} (hp : p ≠ 0) (hq : q ≠ 0)
    (h : p ^ 2 * q ∣ p * q ^ 2) : p ∣ q := by
  have hpq : p * q ≠ 0 := mul_ne_zero hp hq
  have h1 : p * (p * q) ∣ q * (p * q) := by
    have e1 : p ^ 2 * q = p * (p * q) := by ring
    have e2 : p * q ^ 2 = q * (p * q) := by ring
    rwa [e1, e2] at h
  exact (mul_dvd_mul_iff_right hpq).mp h1

/-- **Principalized numerator–denominator products.** Let `pₖ, qₖ ≠ 0` in a local domain and
suppose the ideal generated by all products `∏ₖ fₖ(bₖ)`, `fₖ(true) = pₖ²qₖ`, `fₖ(false) = pₖqₖ²`,
is principal and nonzero. Then for every `k`, `pₖ ∣ qₖ` or `qₖ ∣ pₖ`, and `pₖ, qₖ` divide a
generator. -/
theorem dvd_or_dvd_of_span_range_prod_eq [IsLocalRing R] [IsDomain R] {r : ℕ} (p q : Fin r → R)
    (hp : ∀ k, p k ≠ 0) (hq : ∀ k, q k ≠ 0) {h : R} (hh : h ≠ 0)
    (H : Ideal.span (Set.range fun b : Fin r → Bool =>
        ∏ k, (if b k then p k ^ 2 * q k else p k * q k ^ 2)) = Ideal.span {h}) :
    (∀ k, p k ∣ q k ∨ q k ∣ p k) ∧ ∀ k, p k ∣ h ∧ q k ∣ h := by
  classical
  let f : Fin r → Bool → R := fun k b => if b then p k ^ 2 * q k else p k * q k ^ 2
  have hf : ∀ k b, f k b ≠ 0 := fun k b => by
    cases b <;> simp [f, hp k, hq k]
  obtain ⟨b₀, hb₀⟩ := exists_dvd_of_span_range_eq_span_singleton
    (fun b : Fin r → Bool => ∏ k, f k (b k)) hh H
  refine ⟨fun k => ?_, fun k => ?_⟩
  · have hk := dvd_flip_of_prod_dvd f hf b₀ hb₀ k
    cases hb : b₀ k
    · rw [hb] at hk
      simp only [f, Bool.not_false, if_true] at hk
      right
      have h' : q k ^ 2 * p k ∣ q k * p k ^ 2 := by
        have e1 : q k ^ 2 * p k = p k * q k ^ 2 := by ring
        have e2 : q k * p k ^ 2 = p k ^ 2 * q k := by ring
        rw [e1, e2]
        exact hk
      exact dvd_of_sq_mul_dvd (hq k) (hp k) h'
    · rw [hb] at hk
      simp only [f, Bool.not_true, if_true] at hk
      left
      exact dvd_of_sq_mul_dvd (hp k) (hq k) hk
  · have hgen : (∏ l, f l (b₀ l)) ∣ h := by
      have hmem : h ∈ Ideal.span (Set.range fun b : Fin r → Bool => ∏ l, f l (b l)) :=
        H ▸ Ideal.mem_span_singleton_self h
      obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hmem
      rw [← hc]
      exact Finset.dvd_sum fun b _ => Dvd.dvd.mul_left (hb₀ b) _
    have hfk : f k (b₀ k) ∣ ∏ l, f l (b₀ l) := Finset.dvd_prod_of_mem _ (Finset.mem_univ k)
    have hpk : p k ∣ f k (b₀ k) ∧ q k ∣ f k (b₀ k) := by
      simp only [f]
      split_ifs
      · exact ⟨⟨p k * q k, by ring⟩, ⟨p k ^ 2, by ring⟩⟩
      · exact ⟨⟨q k ^ 2, by ring⟩, ⟨p k * q k, by ring⟩⟩
    exact ⟨hpk.1.trans (hfk.trans hgen), hpk.2.trans (hfk.trans hgen)⟩

end SGPT.Okounkov.OF13
