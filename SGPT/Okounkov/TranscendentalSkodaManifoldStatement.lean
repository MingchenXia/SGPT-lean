import SGPT.Okounkov.TranscendentalSkodaStatement
import SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves

/-!
# Skoda's theorem for analytic singularities on a complex manifold: the statement

Blueprint node `tok:ext-skoda` (manifold form, `skoda:manifold` of `claude-tok-skoda`), the
form consumed by the DENSITY package (`tok:density`, `tok:partial-analytic`).

Let `M` be a complex manifold of dimension `n > 0`, `φ` a quasi-plurisubharmonic function on `M`
and `U ⊆ M` open with holomorphic `g₁, …, g_r` on `U` such that `φ = log ∑ᵢ |gᵢ|² + R` on `U` with
`R` bounded (analytic singularities of type `(1, (g))`, TN `HasAnalyticSingularitiesOfType` with
coefficient `1`). Then for every `y ∈ U` and integers `m ≥ n`, `k ≥ 0`,
`𝓘((k + m)φ)_y = J_y^k · 𝓘(mφ)_y`, `J_y` the ideal generated by the germs of the `gᵢ` at `y`.

* `𝓘(cφ)_y` is TN's manifold multiplier ideal `multiplierIdeal c φ` (holomorphic germs `f`
  with `|f|² e^{-cφ}` integrable near `y` in the preferred chart at `y`).
* `J^k · 𝓘(cφ)_y` is `ManifoldMemPowMulMultiplier g k c φ y`: near `y`,
  `f = ∑_{β : Fin k → Fin r} (∏ᵢ g_{β i}) h_β` with every `h_β ∈ 𝓘(cφ)_y`.

This file contains **statements only**. The proof is `TranscendentalSkodaManifold.lean`.
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.Okounkov.TranscendentalSkoda

open Filter SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open scoped Topology Manifold

universe u

/-- `f ∈ J^k · 𝓘(cφ)_y` on a complex manifold, for `J` generated by `g₁, …, g_r`: near `y`,
`f = ∑_{β : Fin k → Fin r} (∏ᵢ g_{β i}) h_β` with every `h_β ∈ 𝓘(cφ)_y`. -/
def ManifoldMemPowMulMultiplier {n : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] {r : ℕ} (g : Fin r → M → ℂ) (k : ℕ) (c : ℝ)
    (φ : M → EReal) (y : M) (f : M → ℂ) : Prop :=
  ∃ h : (Fin k → Fin r) → M → ℂ,
    (∀ β, (multiplierIdeal (n := n) c φ).mem y (h β)) ∧
      f =ᶠ[𝓝 y] fun z => ∑ β, (∏ i, g (β i) z) * h β z

/-- **Skoda's theorem on a complex manifold** (`tok:ext-skoda`, manifold form): for a
quasi-psh `φ` on a complex manifold of dimension `n > 0` with `φ = log ∑ᵢ |gᵢ|² + R` on an open
`U`, `gᵢ` holomorphic on `U` and `R` bounded on `U`, and for `y ∈ U`, `m ≥ n`, `k ≥ 0`:
`𝓘((k + m)φ)_y = J_y^k · 𝓘(mφ)_y`. -/
def ManifoldSkodaStatement : Prop :=
  ∀ (n : ℕ) (M : Type u) [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
    [IsComplexManifold n M], 0 < n →
  ∀ φ : M → EReal, ManifoldQuasiPlurisubharmonic (n := n) φ →
  ∀ (r : ℕ) (g : Fin r → M → ℂ) (U : Set M), IsOpen U →
    (∀ i, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (g i) U) →
  ∀ (R : M → ℝ) (C : ℝ), (∀ y ∈ U, |R y| ≤ C) →
    (∀ y ∈ U, φ y = generatorLog g y + (R y : EReal)) →
  ∀ y ∈ U, ∀ m k : ℕ, n ≤ m → ∀ f : M → ℂ,
    ((multiplierIdeal (n := n) ((k + m : ℕ) : ℝ) φ).mem y f ↔
      ManifoldMemPowMulMultiplier (n := n) g k (m : ℝ) φ y f)

end SGPT.Okounkov.TranscendentalSkoda
