import SGPT.AlmostSemigroup.Okounkov

/-!
# Products and Veronese subsemigroups of graded semigroups: their Okounkov bodies

Two operations on graded lattice semigroups `S ⊆ ℤⁿ × ℤ` underlie the elementary properties
of Okounkov bodies of line bundles (chapter *The theory of Okounkov bodies*, Section
*Algebraic Okounkov bodies*):

* **products** (source `prop:subaddOkoun`): if `S`, `S'` contain `0`, have nonnegative degrees,
  and same-degree points multiply into `S''` (`(x, k) ∈ S`, `(y, k) ∈ S'` give
  `(x + y, k) ∈ S''`, the multiplication of sections `H⁰(L^k) × H⁰(L'^k) → H⁰((L ⊗ L')^k)`),
  then `Δ(S) + Δ(S') ⊆ Δ(S'')`;
* **Veronese subsemigroups** (source `prop:Okourescaling`): if `(x, k) ∈ S'` exactly when
  `(x, a k) ∈ S` (the identification `H⁰((L^a)^k) = H⁰(L^{ak})`), then `Δ(S') = a Δ(S)`.

Here `Δ(S) = SGPT.AlmostSemigroup.Okounkov.body S = {x : (x, 1) ∈ C(S)}` with `C(S)` the closed
convex cone generated by `S` (source `def:Okokk`). Both statements hold for *arbitrary*
semigroups, without the hypothesis `S ∈ 𝒮'(C)`: the source deduces them from
`thm:HausOkoun`, we argue directly on the generated cones. For products, the bilinear map
`((a, s), (b, t)) ↦ (t a + s b, s t)` sends `C(S) × C(S')` into `C(S'')` and
`((x, 1), (y, 1))` to `(x + y, 1)`; for Veronese subsemigroups, the linear automorphism
`(x, t) ↦ (x, a t)` maps `C(S')` onto `C(S)`.

## Main results

* `SGPT.Okounkov.AlgebraicBody.body_add_subset_of_mul`
* `SGPT.Okounkov.AlgebraicBody.body_eq_smul_of_veronese`
-/

set_option autoImplicit false

noncomputable section

namespace SGPT.Okounkov.AlgebraicBody

open Set SGPT.AlmostSemigroup SGPT.AlmostSemigroup.Okounkov
open scoped Pointwise Topology

variable {n : ℕ}

/-- Multiples `m • z` (`m ∈ ℕ`) of points of a semigroup containing `0` stay in it. -/
theorem nsmul_mem_of_zero_mem (S : AddSubsemigroup ((Fin n → ℤ) × ℤ))
    (h0 : (0 : (Fin n → ℤ) × ℤ) ∈ S) {z : (Fin n → ℤ) × ℤ} (hz : z ∈ S) :
    ∀ m : ℕ, m • z ∈ S
  | 0 => by simpa using h0
  | m + 1 => by
      rw [succ_nsmul]
      exact S.add_mem (nsmul_mem_of_zero_mem S h0 hz m) hz

/-- Positive multiples `m • z` of points of a semigroup stay in it. -/
theorem succ_nsmul_mem (S : AddSubsemigroup ((Fin n → ℤ) × ℤ)) {z : (Fin n → ℤ) × ℤ}
    (hz : z ∈ S) : ∀ m : ℕ, (m + 1) • z ∈ S
  | 0 => by simpa using hz
  | m + 1 => by
      rw [succ_nsmul]
      exact S.add_mem (succ_nsmul_mem S hz m) hz

/-- The graded product `((a, s), (b, t)) ↦ (t a + s b, s t)` on `ℝⁿ × ℝ`. -/
def gradedProduct (z w : (Fin n → ℝ) × ℝ) : (Fin n → ℝ) × ℝ :=
  (w.2 • z.1 + z.2 • w.1, z.2 * w.2)

theorem gradedProduct_add_left (z z' w : (Fin n → ℝ) × ℝ) :
    gradedProduct (z + z') w = gradedProduct z w + gradedProduct z' w := by
  simp only [gradedProduct, Prod.fst_add, Prod.snd_add, smul_add, add_smul, Prod.mk_add_mk,
    add_mul]
  congr 1
  abel

theorem gradedProduct_add_right (z w w' : (Fin n → ℝ) × ℝ) :
    gradedProduct z (w + w') = gradedProduct z w + gradedProduct z w' := by
  simp only [gradedProduct, Prod.fst_add, Prod.snd_add, smul_add, add_smul, Prod.mk_add_mk,
    mul_add]
  congr 1
  abel

theorem gradedProduct_smul_left (c : ℝ) (z w : (Fin n → ℝ) × ℝ) :
    gradedProduct (c • z) w = c • gradedProduct z w := by
  ext i <;> simp [gradedProduct] <;> ring

theorem gradedProduct_smul_right (c : ℝ) (z w : (Fin n → ℝ) × ℝ) :
    gradedProduct z (c • w) = c • gradedProduct z w := by
  ext i <;> simp [gradedProduct] <;> ring

theorem gradedProduct_zero_left (w : (Fin n → ℝ) × ℝ) : gradedProduct 0 w = 0 := by
  simp [gradedProduct]

theorem gradedProduct_zero_right (z : (Fin n → ℝ) × ℝ) : gradedProduct z 0 = 0 := by
  simp [gradedProduct]

theorem continuous_gradedProduct :
    Continuous (fun p : ((Fin n → ℝ) × ℝ) × ((Fin n → ℝ) × ℝ) => gradedProduct p.1 p.2) := by
  unfold gradedProduct
  fun_prop

/-- The graded product of the height-one points `(x, 1)`, `(y, 1)` is `(x + y, 1)`. -/
theorem gradedProduct_heightOne (x y : Fin n → ℝ) :
    gradedProduct (x, (1 : ℝ)) (y, 1) = (x + y, 1) := by
  simp [gradedProduct]

/-- The graded product maps two cone hulls into the cone hull of the products of generators. -/
theorem gradedProduct_mem_hull {s t u : Set ((Fin n → ℝ) × ℝ)}
    (h : ∀ a ∈ s, ∀ b ∈ t, gradedProduct a b ∈ PointedCone.hull ℝ u)
    {z w : (Fin n → ℝ) × ℝ} (hz : z ∈ PointedCone.hull ℝ s) (hw : w ∈ PointedCone.hull ℝ t) :
    gradedProduct z w ∈ PointedCone.hull ℝ u := by
  induction hz using Submodule.span_induction with
  | mem a ha =>
      induction hw using Submodule.span_induction with
      | mem b hb => exact h a ha b hb
      | zero => rw [gradedProduct_zero_right]; exact zero_mem _
      | add w w' _ _ hw hw' => rw [gradedProduct_add_right]; exact add_mem hw hw'
      | smul c w _ hw =>
          change gradedProduct a ((c : ℝ) • w) ∈ _
          rw [gradedProduct_smul_right]
          exact Submodule.smul_mem _ c hw
  | zero => rw [gradedProduct_zero_left]; exact zero_mem _
  | add z z' _ _ hz hz' => rw [gradedProduct_add_left]; exact add_mem hz hz'
  | smul c z _ hz =>
      change gradedProduct ((c : ℝ) • z) w ∈ _
      rw [gradedProduct_smul_left]
      exact Submodule.smul_mem _ c hz

/-- **Okounkov bodies of products.** Let `S`, `S'`, `S''` be graded semigroups such that `S`
and `S'` contain `0` and have nonnegative degrees, and same-degree points multiply into `S''`.
Then `Δ(S) + Δ(S') ⊆ Δ(S'')`. -/
theorem body_add_subset_of_mul (S S' S'' : AddSubsemigroup ((Fin n → ℤ) × ℤ))
    (h0 : (0 : (Fin n → ℤ) × ℤ) ∈ S) (h0' : (0 : (Fin n → ℤ) × ℤ) ∈ S')
    (hdeg : ∀ z ∈ S, 0 ≤ z.2) (hdeg' : ∀ z ∈ S', 0 ≤ z.2)
    (hmul : ∀ (x y : Fin n → ℤ) (k : ℤ), (x, k) ∈ S → (y, k) ∈ S' → (x + y, k) ∈ S'') :
    body S + body S' ⊆ body S'' := by
  -- products of generators
  have hgen : ∀ a ∈ latticeCast n '' (S : Set ((Fin n → ℤ) × ℤ)),
      ∀ b ∈ latticeCast n '' (S' : Set ((Fin n → ℤ) × ℤ)),
      gradedProduct a b ∈ PointedCone.hull ℝ (latticeCast n '' (S'' : Set ((Fin n → ℤ) × ℤ))) := by
    rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩
    obtain ⟨x, k⟩ := z
    obtain ⟨y, m⟩ := w
    have hk : 0 ≤ k := hdeg _ hz
    have hm : 0 ≤ m := hdeg' _ hw
    lift k to ℕ using hk
    lift m to ℕ using hm
    have h1 := nsmul_mem_of_zero_mem S h0 hz m
    have h2 := nsmul_mem_of_zero_mem S' h0' hw k
    simp only [Prod.smul_mk, nsmul_eq_mul] at h1 h2
    have h2' : (k • y, ((m : ℤ) * (k : ℤ))) ∈ S' := by
      rw [mul_comm]; simpa [nsmul_eq_mul] using h2
    have h1' : (m • x, ((m : ℤ) * (k : ℤ))) ∈ S := by simpa [nsmul_eq_mul] using h1
    have h3 := hmul _ _ _ h1' h2'
    refine PointedCone.subset_hull ⟨_, h3, ?_⟩
    ext i <;> simp [latticeCast, gradedProduct, nsmul_eq_mul]; ring
  rintro _ ⟨u, hu, u', hu', rfl⟩
  change (u + u', (1 : ℝ)) ∈ (closedCone S'' : Set ((Fin n → ℝ) × ℝ))
  have hu1 : (u, (1 : ℝ)) ∈ closure
      (PointedCone.hull ℝ (latticeCast n '' (S : Set ((Fin n → ℤ) × ℤ))) :
        Set ((Fin n → ℝ) × ℝ)) := hu
  have hu2 : (u', (1 : ℝ)) ∈ closure
      (PointedCone.hull ℝ (latticeCast n '' (S' : Set ((Fin n → ℤ) × ℤ))) :
        Set ((Fin n → ℝ) × ℝ)) := hu'
  have hmem := map_mem_closure₂ (f := gradedProduct) continuous_gradedProduct hu1 hu2
    (fun a ha b hb => gradedProduct_mem_hull hgen ha hb)
  rw [gradedProduct_heightOne] at hmem
  exact hmem

/-- The linear automorphism `(x, t) ↦ (x, a t)` of `ℝⁿ × ℝ` (`a ≠ 0`). -/
def degreeScaling (a : ℝ) (ha : a ≠ 0) : ((Fin n → ℝ) × ℝ) ≃L[ℝ] ((Fin n → ℝ) × ℝ) :=
  (ContinuousLinearEquiv.refl ℝ (Fin n → ℝ)).prodCongr
    (ContinuousLinearEquiv.smulLeft (Units.mk0 a ha))

@[simp] theorem degreeScaling_apply (a : ℝ) (ha : a ≠ 0) (z : (Fin n → ℝ) × ℝ) :
    degreeScaling a ha z = (z.1, a * z.2) := rfl

/-- **Okounkov bodies of Veronese subsemigroups.** If `(x, k) ∈ S'` exactly when
`(x, a k) ∈ S` (`a > 0`), then `Δ(S') = a Δ(S)`. -/
theorem body_eq_smul_of_veronese (S S' : AddSubsemigroup ((Fin n → ℤ) × ℤ)) {a : ℕ}
    (ha : 0 < a) (hS : ∀ (x : Fin n → ℤ) (k : ℤ), (x, k) ∈ S' ↔ (x, (a : ℤ) * k) ∈ S) :
    body S' = (a : ℝ) • body S := by
  have haR : (a : ℝ) ≠ 0 := by exact_mod_cast ha.ne'
  have haR' : (0 : ℝ) < a := by exact_mod_cast ha
  let ψ := degreeScaling (n := n) (a : ℝ) haR
  let H := PointedCone.hull ℝ (latticeCast n '' (S : Set ((Fin n → ℤ) × ℤ)))
  let H' := PointedCone.hull ℝ (latticeCast n '' (S' : Set ((Fin n → ℤ) × ℤ)))
  -- `ψ` maps the hull of `S'` onto the hull of `S`
  have himage : ψ '' (H' : Set ((Fin n → ℝ) × ℝ)) = H := by
    apply Set.Subset.antisymm
    · rintro _ ⟨z, hz, rfl⟩
      induction hz using Submodule.span_induction with
      | mem z hz =>
          obtain ⟨w, hw, rfl⟩ := hz
          obtain ⟨x, k⟩ := w
          have hw' := (hS x k).mp hw
          refine PointedCone.subset_hull ⟨_, hw', ?_⟩
          ext i <;> simp [latticeCast, ψ]
      | zero => simp
      | add z z' _ _ hz hz' => rw [map_add]; exact add_mem hz hz'
      | smul c z _ hz =>
          change ψ ((c : ℝ) • z) ∈ H
          rw [map_smul]
          exact Submodule.smul_mem _ c hz
    · intro z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
          obtain ⟨w, hw, rfl⟩ := hz
          obtain ⟨x, k⟩ := w
          obtain ⟨b, rfl⟩ : ∃ b : ℕ, a = b + 1 := ⟨a - 1, by omega⟩
          have hmul := succ_nsmul_mem S hw b
          simp only [Prod.smul_mk] at hmul
          have hw' : ((b + 1) • x, k) ∈ S' := by
            apply (hS _ k).mpr
            simpa [nsmul_eq_mul] using hmul
          have hmem : latticeCast n ((b + 1) • x, k) ∈ H' := PointedCone.subset_hull ⟨_, hw', rfl⟩
          let c : {r : ℝ // 0 ≤ r} := ⟨((b + 1 : ℕ) : ℝ)⁻¹, by positivity⟩
          refine ⟨c • latticeCast n ((b + 1) • x, k), Submodule.smul_mem _ c hmem, ?_⟩
          change ψ (((b + 1 : ℕ) : ℝ)⁻¹ • latticeCast n ((b + 1) • x, k)) = _
          have hb : ((b + 1 : ℕ) : ℝ) ≠ 0 := by positivity
          ext i
          · simp [ψ, latticeCast, nsmul_eq_mul, Pi.mul_apply]
            field_simp
          · simp [ψ, latticeCast]
            field_simp
      | zero => exact ⟨0, zero_mem _, map_zero ψ⟩
      | add z z' _ _ hz hz' =>
          obtain ⟨w, hw, rfl⟩ := hz
          obtain ⟨w', hw', rfl⟩ := hz'
          exact ⟨w + w', add_mem hw hw', map_add ψ w w'⟩
      | smul c z _ hz =>
          obtain ⟨w, hw, rfl⟩ := hz
          refine ⟨c • w, Submodule.smul_mem _ c hw, ?_⟩
          change ψ ((c : ℝ) • w) = (c : ℝ) • ψ w
          exact map_smul ψ (c : ℝ) w
  have hcl : ψ '' (closedCone S' : Set ((Fin n → ℝ) × ℝ)) = (closedCone S : Set _) := by
    change ψ '' closure (H' : Set ((Fin n → ℝ) × ℝ)) = closure (H : Set ((Fin n → ℝ) × ℝ))
    rw [ψ.image_closure, himage]
  ext u
  constructor
  · intro hu
    change (u, (1 : ℝ)) ∈ (closedCone S' : Set ((Fin n → ℝ) × ℝ)) at hu
    have h1 : ψ (u, 1) ∈ (closedCone S : Set ((Fin n → ℝ) × ℝ)) := hcl ▸ ⟨_, hu, rfl⟩
    have h2 : ((a : ℝ)⁻¹ • u, (1 : ℝ)) ∈ (closedCone S : Set ((Fin n → ℝ) × ℝ)) := by
      have := (closedCone S).smul_mem (r := (a : ℝ)⁻¹) (by positivity) h1
      convert this using 1
      simp [ψ, haR]
    refine Set.mem_smul_set.mpr ⟨(a : ℝ)⁻¹ • u, h2, ?_⟩
    simp [smul_smul, haR]
  · intro hu
    obtain ⟨v, hv, rfl⟩ := Set.mem_smul_set.mp hu
    change ((a : ℝ) • v, (1 : ℝ)) ∈ (closedCone S' : Set ((Fin n → ℝ) × ℝ))
    change (v, (1 : ℝ)) ∈ (closedCone S : Set ((Fin n → ℝ) × ℝ)) at hv
    have h1 : ((a : ℝ) • v, (a : ℝ)) ∈ (closedCone S : Set ((Fin n → ℝ) × ℝ)) := by
      have := (closedCone S).smul_mem (r := (a : ℝ)) haR'.le hv
      convert this using 1
      simp
    rw [← hcl] at h1
    obtain ⟨w, hw, hψw⟩ := h1
    have hw' : w = ((a : ℝ) • v, 1) := by
      have := congrArg ψ.symm hψw
      rw [ContinuousLinearEquiv.symm_apply_apply] at this
      rw [this]
      apply ψ.injective
      rw [ContinuousLinearEquiv.apply_symm_apply]
      simp [ψ]
    rwa [hw'] at hw

end SGPT.Okounkov.AlgebraicBody
