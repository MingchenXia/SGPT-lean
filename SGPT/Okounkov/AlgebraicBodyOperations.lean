import SGPT.Okounkov.AlgebraicBodyCones
import SGPT.Okounkov.AlgebraicSectionBodies
import SGPT.Foundations.Schemes.NativeTensorPowerAnyFrame
import SGPT.Foundations.Schemes.BundleMorphismGluing

/-!
# Okounkov bodies of tensor products and of tensor powers of line bundles

Source: chapter *The theory of Okounkov bodies*, Section *Algebraic Okounkov bodies*,
`prop:subaddOkoun` (`Δ_ν(L) + Δ_ν(L') ⊆ Δ_ν(L ⊗ L')`) and `prop:Okourescaling`
(`Δ_ν(L^a) = a Δ_ν(L)` for `a ∈ ℤ_{>0}`).

## Formal setting

As in `SGPT.Okounkov.AlgebraicSectionBodies`: `X` is an integral smooth projective complex
scheme of dimension `n`, line bundles are sheaves of modules with a rank-one atlas, `L^k` is
`bundleTensorPower L k`, `L ⊗ L'` is `bundleTensor L L'`, and `ν` is the flag valuation of a
smooth flag `Y` (the case `ν = ν_{Y•}`); `Δ_{Y•}(L) = lineBundleOkounkovBody` is the height-one
slice of the closed cone generated by the section semigroup `Γ(L)` (source `def:Okobd`).

## Sections of tensor products and of tensor powers

* `tensorPowerTensorIso a b k : (L ⊗ N)^k ≅ L^k ⊗ N^k`, descended from matching frames on the
  pairwise intersections of the atlases, and the product
  `H⁰(L^k) × H⁰(N^k) → H⁰((L ⊗ N)^k)`, `(s, t) ↦ s · t`; the flag valuation is additive:
  `ν(s · t) = ν(s) + ν(t)` (`schemeFubiniStudySectionVector_tensorProduct`).
* The existing comparison `nativeLineTensorPowerMulIso a r m : L^{rm} ≅ (L^r)^m` preserves the
  flag valuation (`schemeFubiniStudySectionVector_tensorPowerMulIso`), so that
  `(x, k) ∈ Γ(L^r) ↔ (x, r k) ∈ Γ(L)`.

## Main results

* `lineBundleOkounkovBody_add_subset_tensor` (source `prop:subaddOkoun`).
* `lineBundleOkounkovBody_tensorPower` (source `prop:Okourescaling`).

Both hold for all line bundles (bigness, used in the source only to know that the bodies are
convex bodies, is not needed for the identities), and for every atlas of `L ⊗ L'`, resp.
`L^a` (the bodies do not depend on the atlas). The source deduces them from `thm:HausOkoun`;
here they follow from the cone descriptions of `SGPT.Okounkov.AlgebraicBodyCones`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes Set Opposite TopologicalSpace
open SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open scoped Pointwise

universe u

section Frames

variable {X : Scheme.{u}} [IsIntegral X]

/-- The iterated power comparison `L^{rm} ≅ (L^r)^m` preserves function-field coefficients in
every frame. -/
theorem globalSectionToFunctionField_tensorPowerMulIso {L : X.Modules} (a : LineBundleAtlas L)
    (r m : ℕ) {U : X.Opens} [Nonempty U] (α : LocalBundleFrame L U)
    (t : bundlePowerGlobalSections L (r * m)) :
    globalSectionToFunctionField ((α.tensorPower r).tensorPower m)
        ((nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t) =
      globalSectionToFunctionField (α.tensorPower (r * m)) t := by
  change X.germToFunctionField U (((α.tensorPower r).tensorPower m).coefficients (𝟙 _)
      ((bundleTensorPower (bundleTensorPower L r) m).val.map (homOfLE le_top).op
        ((nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t))) =
    X.germToFunctionField U ((α.tensorPower (r * m)).coefficients (𝟙 _)
      ((bundleTensorPower L (r * m)).val.map (homOfLE le_top).op t))
  congr 1
  have hn := PresheafOfModules.naturality_apply (nativeLineTensorPowerMulIso a r m).hom.val
    (homOfLE (le_top : U ≤ ⊤)).op t
  change (nativeLineTensorPowerMulIso a r m).hom.val.app (op U)
      ((bundleTensorPower L (r * m)).val.map (homOfLE le_top).op t) =
    (bundleTensorPower (bundleTensorPower L r) m).val.map (homOfLE le_top).op
      ((nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t) at hn
  rw [← hn]
  exact nativeLineTensorPowerMulIso_anyFrame a r m α (𝟙 U) _

variable {L N : X.Modules}

/-- The frame of `L` on `U_i ∩ V_j` restricted from the atlas frame on `U_i`. -/
def leftRestrictedFrame (a : LineBundleAtlas L) (b : LineBundleAtlas N) (ij : a.I × b.I) :
    LocalBundleFrame L (a.opens ij.1 ⊓ b.opens ij.2) :=
  bundleHomRestrictionIso L (SheafOfModules.unit X.ringCatSheaf)
    (Opens.infLELeft (a.opens ij.1) (b.opens ij.2)) (a.frame ij.1)

/-- The frame of `N` on `U_i ∩ V_j` restricted from the atlas frame on `V_j`. -/
def rightRestrictedFrame (a : LineBundleAtlas L) (b : LineBundleAtlas N) (ij : a.I × b.I) :
    LocalBundleFrame N (a.opens ij.1 ⊓ b.opens ij.2) :=
  bundleHomRestrictionIso N (SheafOfModules.unit X.ringCatSheaf)
    (Opens.infLERight (a.opens ij.1) (b.opens ij.2)) (b.frame ij.2)

/-- The rank-one atlas of `L ⊗ N` on the pairwise intersections `U_i ∩ V_j` of atlases of `L`
and `N`, with the tensor products of the restricted frames. -/
def pairwiseTensorAtlas (a : LineBundleAtlas L) (b : LineBundleAtlas N) :
    LineBundleAtlas (bundleTensor L N) where
  I := a.I × b.I
  opens ij := a.opens ij.1 ⊓ b.opens ij.2
  covers x := by
    obtain ⟨i, hi⟩ := a.covers x
    obtain ⟨j, hj⟩ := b.covers x
    exact ⟨(i, j), hi, hj⟩
  frame ij := (leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)

/-- The comparison `(L ⊗ N)^k ≅ L^k ⊗ N^k`, descended from the frames `(e ⊗ f)^k` and
`e^k ⊗ f^k` on the pairwise intersections of atlases of `L` and `N` (their transition units
`(u v)^k = u^k v^k` agree). -/
def tensorPowerTensorIso (a : LineBundleAtlas L) (b : LineBundleAtlas N) (k : ℕ) :
    bundleTensorPower (bundleTensor L N) k ≅
      bundleTensor (bundleTensorPower L k) (bundleTensorPower N k) :=
  nativeMatchingBundleFrameIso _ _ (fun ij : a.I × b.I => a.opens ij.1 ⊓ b.opens ij.2)
    (fun x => by
      obtain ⟨i, hi⟩ := a.covers x
      obtain ⟨j, hj⟩ := b.covers x
      exact ⟨(i, j), hi, hj⟩)
    (fun ij => ((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k)
    (fun ij => ((leftRestrictedFrame a b ij).tensorPower k).tensor
      ((rightRestrictedFrame a b ij).tensorPower k))
    (by
      intro i j W h h'
      rw [localBundleFrameTransition_tensorPower, localBundleFrameTransition_tensor,
        localBundleFrameTransition_tensor, localBundleFrameTransition_tensorPower,
        localBundleFrameTransition_tensorPower, mul_pow])

/-- The product `H⁰(L^k) × H⁰(N^k) → H⁰((L ⊗ N)^k)` of global sections. -/
def tensorPowerSectionProduct (a : LineBundleAtlas L) (b : LineBundleAtlas N) (k : ℕ)
    (s : bundlePowerGlobalSections L k) (t : bundlePowerGlobalSections N k) :
    bundlePowerGlobalSections (bundleTensor L N) k :=
  (tensorPowerTensorIso a b k).inv.val.app (op ⊤)
    (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) ⊤ s t)

omit [IsIntegral X] in
/-- In the frame `(e ⊗ f)^k`, the coefficient of a product of sections is the product of the
coefficients. -/
theorem tensorPowerTensorIso_inv_coefficients (a : LineBundleAtlas L) (b : LineBundleAtlas N)
    (k : ℕ) (ij : a.I × b.I) {W : X.Opens} (h : W ⟶ a.opens ij.1 ⊓ b.opens ij.2)
    (s : bundleSections (bundleTensorPower L k) W) (t : bundleSections (bundleTensorPower N k) W) :
    (((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k).coefficients h
        ((tensorPowerTensorIso a b k).inv.val.app (op W)
          (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t)) =
      ((leftRestrictedFrame a b ij).tensorPower k).coefficients h s *
        ((rightRestrictedFrame a b ij).tensorPower k).coefficients h t := by
  let Ψ := tensorPowerTensorIso a b k
  have he := nativeMatchingBundleFrameIso_coefficients _ _
    (fun ij : a.I × b.I => a.opens ij.1 ⊓ b.opens ij.2)
    (fun x => by
      obtain ⟨i, hi⟩ := a.covers x
      obtain ⟨j, hj⟩ := b.covers x
      exact ⟨(i, j), hi, hj⟩)
    (fun ij => ((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k)
    (fun ij => ((leftRestrictedFrame a b ij).tensorPower k).tensor
      ((rightRestrictedFrame a b ij).tensorPower k))
    (by
      intro i j W h h'
      rw [localBundleFrameTransition_tensorPower, localBundleFrameTransition_tensor,
        localBundleFrameTransition_tensor, localBundleFrameTransition_tensorPower,
        localBundleFrameTransition_tensorPower, mul_pow]) ij h
    (Ψ.inv.val.app (op W) (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t))
  have hh := congrArg (fun α => α.val.app (op W)
    (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t)) Ψ.inv_hom_id
  change Ψ.hom.val.app (op W) (Ψ.inv.val.app (op W)
      (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t)) =
    tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t at hh
  change (((leftRestrictedFrame a b ij).tensorPower k).tensor
      ((rightRestrictedFrame a b ij).tensorPower k)).coefficients h
      (Ψ.hom.val.app (op W) (Ψ.inv.val.app (op W)
        (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t))) =
    (((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k).coefficients h
      (Ψ.inv.val.app (op W) (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) W s t))
    at he
  rw [← he, hh]
  exact LocalBundleFrame.tensor_coefficients _ _ h s t

/-- In the frame `(e ⊗ f)^k`, the function-field coefficient of a product of global sections is
the product of the function-field coefficients. -/
theorem globalSectionToFunctionField_tensorPowerSectionProduct (a : LineBundleAtlas L)
    (b : LineBundleAtlas N) (k : ℕ) (ij : a.I × b.I) [Nonempty (a.opens ij.1 ⊓ b.opens ij.2 : X.Opens)]
    (s : bundlePowerGlobalSections L k) (t : bundlePowerGlobalSections N k) :
    globalSectionToFunctionField
        (((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k)
        (tensorPowerSectionProduct a b k s t) =
      globalSectionToFunctionField ((leftRestrictedFrame a b ij).tensorPower k) s *
        globalSectionToFunctionField ((rightRestrictedFrame a b ij).tensorPower k) t := by
  let U : X.Opens := a.opens ij.1 ⊓ b.opens ij.2
  let Ψ := tensorPowerTensorIso a b k
  change X.germToFunctionField U
      ((((leftRestrictedFrame a b ij).tensor (rightRestrictedFrame a b ij)).tensorPower k).coefficients
        (𝟙 _) ((bundleTensorPower (bundleTensor L N) k).val.map (homOfLE le_top).op
          (Ψ.inv.val.app (op ⊤)
            (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) ⊤ s t)))) =
    X.germToFunctionField U (((leftRestrictedFrame a b ij).tensorPower k).coefficients (𝟙 _)
        ((bundleTensorPower L k).val.map (homOfLE le_top).op s)) *
      X.germToFunctionField U (((rightRestrictedFrame a b ij).tensorPower k).coefficients (𝟙 _)
        ((bundleTensorPower N k).val.map (homOfLE le_top).op t))
  rw [← map_mul]
  congr 1
  have hn := PresheafOfModules.naturality_apply Ψ.inv.val (homOfLE (le_top : U ≤ ⊤)).op
    (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) ⊤ s t)
  change Ψ.inv.val.app (op U)
      ((bundleTensor (bundleTensorPower L k) (bundleTensorPower N k)).val.map (homOfLE le_top).op
        (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) ⊤ s t)) =
    (bundleTensorPower (bundleTensor L N) k).val.map (homOfLE le_top).op
      (Ψ.inv.val.app (op ⊤) (tensorSection (bundleTensorPower L k) (bundleTensorPower N k) ⊤ s t))
    at hn
  rw [← hn, tensorSection_restrict]
  exact tensorPowerTensorIso_inv_coefficients a b k ij (𝟙 U) _ _

end Frames

variable {X : Scheme} [IsIntegral X] (f : X ⟶ Spec (.of ℂ)) (n : ℕ)
  [SmoothOfRelativeDimension n f] (E : ClosedProjectiveEmbedding f)

local instance algebraicBodyOpsTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance algebraicBodyOpsCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n

variable (Y : Fin (n + 1) → Set (SchemeComplexPoint f)) (hY : IsSmoothFlag Y)

/-- Equal sections have equal flag vectors (transport of the nonvanishing proof). -/
theorem schemeFubiniStudySectionVector_congr {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ)
    {s s' : bundlePowerGlobalSections L m} (hs : s ≠ 0) (hs' : s' ≠ 0) (h : s = s') :
    schemeFubiniStudySectionVector f n E Y hY a m s hs =
      schemeFubiniStudySectionVector f n E Y hY a m s' hs' := by
  subst h
  rfl

/-- Equal whole flag values give equal flag vectors. -/
theorem schemeFubiniStudySectionVector_eq_of_value_eq {L L' : X.Modules} (a : LineBundleAtlas L)
    (a' : LineBundleAtlas L') (m m' : ℕ) (s : bundlePowerGlobalSections L m)
    (s' : bundlePowerGlobalSections L' m') (hs : s ≠ 0) (hs' : s' ≠ 0)
    (h : letI := E.isSeparated
      letI := E.quasiCompact
      schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY a m s =
        schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY
          a' m' s') :
    schemeFubiniStudySectionVector f n E Y hY a m s hs =
      schemeFubiniStudySectionVector f n E Y hY a' m' s' hs' := by
  let := E.isSeparated
  let := E.quasiCompact
  rw [schemeFubiniStudySectionValue_vector f n E Y hY a m s hs,
    schemeFubiniStudySectionValue_vector f n E Y hY a' m' s' hs'] at h
  have hlex := WithTop.coe_injective h
  have hfun := congrArg (ofLex : Lex (Fin n → ℤ) → Fin n → ℤ) hlex
  funext i
  exact Nat.cast_injective (congrFun hfun i)

section Veronese

/-- The comparison `L^{rm} ≅ (L^r)^m` preserves the whole flag value of sections. -/
theorem schemeOriginalFlagSectionValue_tensorPowerMulIso {L : X.Modules} (a : LineBundleAtlas L)
    (r m : ℕ) (t : bundlePowerGlobalSections L (r * m)) :
    letI := E.isSeparated
    letI := E.quasiCompact
    schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY
        (a.tensorPower r) m ((nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t) =
      schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY a
        (r * m) t := by
  let := E.isSeparated
  let := E.quasiCompact
  let ω := schemeProjectiveTNKahlerBackground f n E
  let p := (schemeProjectiveOriginalFlagPoint f n E ω Y hY).val
  let α := schemePointFrame f p a
  have hx := schemePointFrame_mem f p a
  let : Nonempty (schemePointFrameOpen f p a) := ⟨⟨_, hx⟩⟩
  rw [schemeOriginalFlagSectionValue_eq_frame f n E ω Y hY (a.tensorPower r) (α.tensorPower r) hx m,
    schemeOriginalFlagSectionValue_eq_frame f n E ω Y hY a α hx (r * m),
    globalSectionToFunctionField_tensorPowerMulIso]

/-- The comparison `L^{rm} ≅ (L^r)^m` preserves the flag valuation of nonzero sections. -/
theorem schemeFubiniStudySectionVector_tensorPowerMulIso {L : X.Modules} (a : LineBundleAtlas L)
    (r m : ℕ) (t : bundlePowerGlobalSections L (r * m)) (ht : t ≠ 0)
    (hΦt : (nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t ≠ 0) :
    schemeFubiniStudySectionVector f n E Y hY (a.tensorPower r) m
        ((nativeLineTensorPowerMulIso a r m).hom.val.app (op ⊤) t) hΦt =
      schemeFubiniStudySectionVector f n E Y hY a (r * m) t ht :=
  schemeFubiniStudySectionVector_eq_of_value_eq f n E Y hY _ _ _ _ _ _ _ _
    (schemeOriginalFlagSectionValue_tensorPowerMulIso f n E Y hY a r m t)

/-- The section semigroup of `L^r` is the Veronese subsemigroup of `Γ(L)`:
`(x, k) ∈ Γ(L^r) ↔ (x, r k) ∈ Γ(L)`, for every atlas of `L^r`. -/
theorem mem_schemeProjectiveSectionSemigroup_tensorPower_iff {L : X.Modules}
    (a : LineBundleAtlas L) {r : ℕ} (hr : 0 < r) (b : LineBundleAtlas (bundleTensorPower L r))
    (x : Fin n → ℤ) (k : ℤ) :
    (x, k) ∈ schemeProjectiveSectionSemigroup f n E Y hY b ↔
      (x, (r : ℤ) * k) ∈ schemeProjectiveSectionSemigroup f n E Y hY a := by
  rw [schemeProjectiveSectionSemigroup_atlas_independent f n E Y hY b (a.tensorPower r)]
  constructor
  · rintro ⟨m, s, hs, hz⟩
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hz
    let Φ := nativeLineTensorPowerMulIso a r m
    let t := Φ.inv.val.app (op ⊤) s
    have hst : Φ.hom.val.app (op ⊤) t = s := by
      have hh := congrArg (fun α => α.val.app (op ⊤) s) Φ.inv_hom_id
      exact hh
    have ht : t ≠ 0 := by
      intro h0
      apply hs
      rw [← hst, h0, map_zero]
    refine ⟨r * m, t, ht, ?_⟩
    have hv := schemeFubiniStudySectionVector_tensorPowerMulIso f n E Y hY a r m t ht
      (by rw [hst]; exact hs)
    rw [schemeFubiniStudySectionVector_congr f n E Y hY (a.tensorPower r) m _ hs hst] at hv
    rw [hv]
    push_cast
    rfl
  · rintro ⟨m', t, ht, hz⟩
    obtain ⟨hx, hk⟩ := Prod.mk.inj hz
    have hk0 : 0 ≤ k := by
      have : (0 : ℤ) ≤ (r : ℤ) * k := by rw [hk]; exact Int.natCast_nonneg _
      have hr' : (0 : ℤ) < r := by exact_mod_cast hr
      nlinarith
    lift k to ℕ using hk0
    have hm' : m' = r * k := by exact_mod_cast hk.symm
    subst hm' hx
    let Φ := nativeLineTensorPowerMulIso a r k
    have hΦt : Φ.hom.val.app (op ⊤) t ≠ 0 := by
      intro h0
      apply ht
      have hh := congrArg (fun α => α.val.app (op ⊤) t) Φ.hom_inv_id
      change Φ.inv.val.app (op ⊤) (Φ.hom.val.app (op ⊤) t) = t at hh
      rw [← hh, h0, map_zero]
    refine ⟨k, Φ.hom.val.app (op ⊤) t, hΦt, ?_⟩
    rw [schemeFubiniStudySectionVector_tensorPowerMulIso f n E Y hY a r k t ht hΦt]

/-- **Source `prop:Okourescaling`** (flag valuations): `Δ_{Y•}(L^a) = a Δ_{Y•}(L)` for every
`a ∈ ℤ_{>0}` and every atlas of `L^a`. -/
theorem lineBundleOkounkovBody_tensorPower {L : X.Modules} (a : LineBundleAtlas L) {r : ℕ}
    (hr : 0 < r) (b : LineBundleAtlas (bundleTensorPower L r)) :
    lineBundleOkounkovBody f n E Y hY b = (r : ℝ) • lineBundleOkounkovBody f n E Y hY a :=
  AlgebraicBody.body_eq_smul_of_veronese _ _ hr
    (mem_schemeProjectiveSectionSemigroup_tensorPower_iff f n E Y hY a hr b)

end Veronese

section Tensor

/-- The flag valuation is additive on products of sections of `L^k` and `N^k`:
`ν(s · t) = ν(s) + ν(t)` (whole values in `WithTop (ℤⁿ)_lex`, for every atlas of `L ⊗ N`). -/
theorem schemeOriginalFlagSectionValue_tensorPowerSectionProduct {L N : X.Modules}
    (a : LineBundleAtlas L) (b : LineBundleAtlas N) (c : LineBundleAtlas (bundleTensor L N))
    (k : ℕ) (s : bundlePowerGlobalSections L k) (t : bundlePowerGlobalSections N k) :
    letI := E.isSeparated
    letI := E.quasiCompact
    schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY c k
        (tensorPowerSectionProduct a b k s t) =
      schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY a k s +
        schemeOriginalFlagSectionValue f n E (schemeProjectiveTNKahlerBackground f n E) Y hY
          b k t := by
  let := E.isSeparated
  let := E.quasiCompact
  let ω := schemeProjectiveTNKahlerBackground f n E
  let p := (schemeProjectiveOriginalFlagPoint f n E ω Y hY).val
  obtain ⟨i, hi⟩ := a.covers (schemeComplexPointImage f p)
  obtain ⟨j, hj⟩ := b.covers (schemeComplexPointImage f p)
  have hx : schemeComplexPointImage f p ∈ (a.opens (i, j).1 ⊓ b.opens (i, j).2 : X.Opens) :=
    ⟨hi, hj⟩
  let : Nonempty (a.opens (i, j).1 ⊓ b.opens (i, j).2 : X.Opens) := ⟨⟨_, hx⟩⟩
  rw [schemeOriginalFlagSectionValue_eq_frame f n E ω Y hY c
      ((leftRestrictedFrame a b (i, j)).tensor (rightRestrictedFrame a b (i, j))) hx k,
    schemeOriginalFlagSectionValue_eq_frame f n E ω Y hY a (leftRestrictedFrame a b (i, j)) hx k,
    schemeOriginalFlagSectionValue_eq_frame f n E ω Y hY b (rightRestrictedFrame a b (i, j)) hx k,
    globalSectionToFunctionField_tensorPowerSectionProduct,
    (schemeOriginalFlagFunctionFieldValuation f n E ω Y hY).map_mul]

include f n E Y hY in
/-- Products of nonzero sections are nonzero. -/
theorem tensorPowerSectionProduct_ne_zero {L N : X.Modules}
    (a : LineBundleAtlas L) (b : LineBundleAtlas N) (k : ℕ) {s : bundlePowerGlobalSections L k}
    {t : bundlePowerGlobalSections N k} (hs : s ≠ 0) (ht : t ≠ 0) :
    tensorPowerSectionProduct a b k s t ≠ 0 := by
  let := E.isSeparated
  let := E.quasiCompact
  let ω := schemeProjectiveTNKahlerBackground f n E
  intro h0
  have hv := schemeOriginalFlagSectionValue_tensorPowerSectionProduct f n E Y hY a b
    (pairwiseTensorAtlas a b) k s t
  rw [h0, (schemeOriginalFlagSectionValue_eq_top_iff f n E ω Y hY (pairwiseTensorAtlas a b) k 0).mpr rfl]
    at hv
  have hs' := (schemeOriginalFlagSectionValue_eq_top_iff f n E ω Y hY a k s).not.mpr hs
  have ht' := (schemeOriginalFlagSectionValue_eq_top_iff f n E ω Y hY b k t).not.mpr ht
  exact WithTop.add_ne_top.mpr ⟨hs', ht'⟩ hv.symm

/-- The flag vector of a product of nonzero sections is the sum of their flag vectors. -/
theorem schemeFubiniStudySectionVector_tensorProduct {L N : X.Modules}
    (a : LineBundleAtlas L) (b : LineBundleAtlas N) (c : LineBundleAtlas (bundleTensor L N))
    (k : ℕ) (s : bundlePowerGlobalSections L k) (t : bundlePowerGlobalSections N k)
    (hs : s ≠ 0) (ht : t ≠ 0) (hst : tensorPowerSectionProduct a b k s t ≠ 0) :
    schemeFubiniStudySectionVector f n E Y hY c k (tensorPowerSectionProduct a b k s t) hst =
      schemeFubiniStudySectionVector f n E Y hY a k s hs +
        schemeFubiniStudySectionVector f n E Y hY b k t ht := by
  let := E.isSeparated
  let := E.quasiCompact
  have h := schemeOriginalFlagSectionValue_tensorPowerSectionProduct f n E Y hY a b c k s t
  rw [schemeFubiniStudySectionValue_vector f n E Y hY c k _ hst,
    schemeFubiniStudySectionValue_vector f n E Y hY a k s hs,
    schemeFubiniStudySectionValue_vector f n E Y hY b k t ht, ← WithTop.coe_add,
    ← toLex_add] at h
  have hlex := WithTop.coe_injective h
  have hfun := congrArg (ofLex : Lex (Fin n → ℤ) → Fin n → ℤ) hlex
  funext i
  have hi := congrFun hfun i
  simp only [ofLex_toLex, Pi.add_apply] at hi
  exact_mod_cast hi

/-- Same-degree points of `Γ(L)` and `Γ(N)` multiply into `Γ(L ⊗ N)`. -/
theorem schemeProjectiveSectionSemigroup_add_mem_tensor {L N : X.Modules}
    (a : LineBundleAtlas L) (b : LineBundleAtlas N) (c : LineBundleAtlas (bundleTensor L N))
    (x y : Fin n → ℤ) (k : ℤ) (hx : (x, k) ∈ schemeProjectiveSectionSemigroup f n E Y hY a)
    (hy : (y, k) ∈ schemeProjectiveSectionSemigroup f n E Y hY b) :
    (x + y, k) ∈ schemeProjectiveSectionSemigroup f n E Y hY c := by
  obtain ⟨m, s, hs, hz⟩ := hx
  obtain ⟨m', t, ht, hz'⟩ := hy
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj hz
  obtain ⟨rfl, hmm⟩ := Prod.mk.inj hz'
  have hm : m' = m := by exact_mod_cast hmm.symm
  subst hm
  have hst := tensorPowerSectionProduct_ne_zero f n E Y hY a b m' hs ht
  refine ⟨m', tensorPowerSectionProduct a b m' s t, hst, ?_⟩
  rw [schemeFubiniStudySectionVector_tensorProduct f n E Y hY a b c m' s t hs ht hst]
  ext i <;> simp

/-- **Source `prop:subaddOkoun`** (flag valuations): `Δ_{Y•}(L) + Δ_{Y•}(N) ⊆ Δ_{Y•}(L ⊗ N)`
for all line bundles `L`, `N` and every atlas of `L ⊗ N`. -/
theorem lineBundleOkounkovBody_add_subset_tensor {L N : X.Modules}
    (a : LineBundleAtlas L) (b : LineBundleAtlas N) (c : LineBundleAtlas (bundleTensor L N)) :
    lineBundleOkounkovBody f n E Y hY a + lineBundleOkounkovBody f n E Y hY b ⊆
      lineBundleOkounkovBody f n E Y hY c :=
  AlgebraicBody.body_add_subset_of_mul _ _ _
    (schemeProjectiveSectionSemigroup_zero_mem f n E Y hY a)
    (schemeProjectiveSectionSemigroup_zero_mem f n E Y hY b)
    (fun z hz => (schemeProjectiveSectionSemigroup_nonneg f n E Y hY a z hz).2)
    (fun z hz => (schemeProjectiveSectionSemigroup_nonneg f n E Y hY b z hz).2)
    (schemeProjectiveSectionSemigroup_add_mem_tensor f n E Y hY a b c)

end Tensor

