/-- The genuine holomorphic pullback of a principal germ is generated by
the actual composed generator, rather than by an assumed tail section. -/
theorem pullback_principal_generator {n k : ℕ} {M N : Type*}
    [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
    [TopologicalSpace N] [ChartedSpace (ComplexModel k) N] [IsComplexManifold k N]
    (ι : N → M)
    (hι : ContMDiff 𝓘(ℂ, ComplexModel k) 𝓘(ℂ, ComplexModel n) ∞ ι)
    (I : GermIdeal n M) (r : M → ℂ) (q : N)
    (hr : HolomorphicAt n r (ι q))
    (hgen : ∀ f, I.mem (ι q) f ↔ IsInSpanAt (n := n) (· = r) (ι q) f) :
    ∀ g, (GermIdeal.pullback (m := k) ι I).mem q g ↔
      IsInSpanAt (n := k) (· = r ∘ ι) q g := by
  intro g
  have hcomp := fun {a : M → ℂ} (ha : HolomorphicAt n a (ι q)) =>
    ha.comp_contMDiff (Eventually.of_forall fun y => hι y)
  constructor
  · intro hg
    have hg' : IsInSpanAt (n := k)
        (fun s => ∃ a, I.mem (ι q) a ∧ s = a ∘ ι) q g := hg
    refine IsInSpanAt.of_forall_eq_mul ?_ hg'
    rintro s ⟨a, ha, rfl⟩
    obtain ⟨_, c, hc, hceq⟩ := isInSpanAt_eq_iff.mp ((hgen a).mp ha)
    exact ⟨c ∘ ι, hcomp hc, (hι.continuous.continuousAt (x := q)).eventually hceq⟩
  · intro hg
    obtain ⟨hgh, c, hc, hceq⟩ := isInSpanAt_eq_iff.mp hg
    have hrmem : I.mem (ι q) r := (hgen r).mpr (isInSpanAt_self rfl hr)
    show IsInSpanAt (n := k) (fun s => ∃ a, I.mem (ι q) a ∧ s = a ∘ ι) q g
    exact isInSpanAt_of_eq_mul ⟨r, hrmem, rfl⟩ hgh hc hceq

/-- Literal source section step: actual local defining equation, original
Cartier section, and holomorphic quotient restricted to the actual tail. -/
def OriginalCartierSectionStep {m : ℕ} (F : OriginalFlagGeometry.{u} (m + 1))
    (D : EffectiveDivisor (m + 1) F.carrier) (a : ℕ)
    (Dtail : EffectiveDivisor m F.tail.carrier) : Prop :=
  letI : ChartedSpace (ComplexModel m) (F.flag (1 : Fin (m + 2))) := F.tail.charts
  ∀ p ∈ F.flag (1 : Fin (m + 2)),
    ∃ (U : Set F.carrier) (t r s : F.carrier → ℂ),
      IsOpen U ∧ p ∈ U ∧
      MDifferentiableOn 𝓘(ℂ, ComplexModel (m + 1)) 𝓘(ℂ, ℂ) t U ∧
      MDifferentiableOn 𝓘(ℂ, ComplexModel (m + 1)) 𝓘(ℂ, ℂ) r U ∧
      (∀ y ∈ U, ∀ g, (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))).mem y g ↔
        IsInSpanAt (n := m + 1) (· = t) y g) ∧
      (∀ y ∈ U, y ∈ F.flag (1 : Fin (m + 2)) ↔ t y = 0) ∧
      (∀ y ∈ U, ∀ g, D.ideal.mem y g ↔ IsInSpanAt (n := m + 1) (· = s) y g) ∧
      (∀ y ∈ U, s y = t y ^ a * r y) ∧
      (∀ y ∈ U, t y ≠ 0 → s y / t y ^ a = r y) ∧
      (∀ q : F.tail.carrier, (Subtype.val : F.tail.carrier → F.carrier) q ∈ U → ∀ g,
        Dtail.ideal.mem q g ↔ IsInSpanAt (n := m) (· = r ∘ Subtype.val) q g) ∧
      (∀ V : Set F.carrier, IsOpen V → V ⊆ U →
        (V ∩ F.flag (1 : Fin (m + 2))).Nonempty →
          ∃ y ∈ V ∩ F.flag (1 : Fin (m + 2)), r y ≠ 0)

/-- The existing actual Cartier ideal step produces every local function
in the book's division/restriction formula, including true tail nonzero germs. -/
theorem originalCartierSectionStep_of_ideal_step {m : ℕ}
    (F : OriginalFlagGeometry.{u} (m + 1))
    (D : EffectiveDivisor (m + 1) F.carrier) (a : ℕ)
    (Dtail : EffectiveDivisor m F.tail.carrier) (hstep : OriginalCartierFlagStep F D a Dtail) :
    OriginalCartierSectionStep F D a Dtail := by
  let : ChartedSpace (ComplexModel m) (F.flag (1 : Fin (m + 2))) := F.tail.charts
  let : IsComplexManifold m (F.flag (1 : Fin (m + 2))) := F.tail.complex
  obtain ⟨R, _ha, hDR, hnot, htail⟩ := hstep
  have hWI : (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))).IsInvertible :=
    BlowupExistenceCodimOne.isInvertible_vanishingIdeal_of_codimOne F.firstDivisor.1
      (smooth_divisor_interior_eq_empty F.firstDivisor)
      (fun x hx => ⟨m, F.firstDivisor.2.2 x hx, rfl⟩)
  have hRI := SubmanifoldDivisorRestriction.isInvertibleAlong_of_isClosedConnectedSubmanifold
    F.firstDivisor R.isInvertible hnot
  intro p hp
  obtain ⟨Ut, hUt, hpUt, t, ht, _htnv, htgen⟩ := hWI p
  obtain ⟨Ur, hUr, hpUr, r, hr, hrnv, hrgen⟩ := hRI p hp
  let U := Ut ∩ Ur
  have hU : IsOpen U := hUt.inter hUr
  have hthol : ∀ y ∈ U, HolomorphicAt (m + 1) t y := fun y hy =>
    DivisorExponent.holomorphicAt_of_mdifferentiableOn_open hUt ht hy.1
  have hrhol : ∀ y ∈ U, HolomorphicAt (m + 1) r y := fun y hy =>
    DivisorExponent.holomorphicAt_of_mdifferentiableOn_open hUr hr hy.2
  have htpow : MDifferentiableOn 𝓘(ℂ, ComplexModel (m + 1)) 𝓘(ℂ, ℂ)
      (fun y => t y ^ a) U := fun y hy =>
    (BlowupDerivativeIdeal.holomorphicAt_pow (hthol y hy) a).mdifferentiableAt.mdifferentiableWithinAt
  have hpowgen : ∀ y ∈ U, ∀ g,
      (idealPow (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))) a).mem y g ↔
        IsInSpanAt (n := m + 1) (· = fun z => t z ^ a) y g :=
    BlowupDerivativeIdeal.idealPow_mem_iff_of_generator hthol (fun y hy => htgen y hy.1) a
  have hDgen : ∀ y ∈ U, ∀ g, D.ideal.mem y g ↔
      IsInSpanAt (n := m + 1) (· = fun z => t z ^ a * r z) y g := by
    intro y hy g
    rw [hDR]
    have hfamily : mulFamily (fun _ : Fin 1 => fun z => t z ^ a) (fun _ : Fin 1 => r) =
        (fun _ : Fin (1 * 1) => fun z => t z ^ a * r z) := rfl
    simpa only [hfamily, range_const, mem_singleton_iff] using mem_mul_iff_isInSpanAt_mulFamily hU
      (N := 1) (P := 1) (g := fun _ => fun z => t z ^ a) (h := fun _ => r)
      (fun _ => htpow) (fun _ => hr.mono inter_subset_right)
      (fun y hy g => by simpa using hpowgen y hy g)
      (fun y hy g => by simpa using hrgen y hy.2 g) hy g
  have hval : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel (m + 1)) ∞
      (Subtype.val : F.tail.carrier → F.carrier) :=
    SubmanifoldChartedSpace.contMDiff_val (Nat.le_succ m) F.firstDivisor.2.2
  refine ⟨U, t, r, fun z => t z ^ a * r z, hU, ⟨hpUt, hpUr⟩,
    ht.mono inter_subset_left, hr.mono inter_subset_right, (fun y hy => htgen y hy.1), ?_, hDgen,
    fun _ _ => rfl, ?_, ?_, ?_⟩
  · intro y hy
    have htself := (htgen y hy.1 t).mpr (isInSpanAt_self rfl (hthol y hy))
    constructor
    · intro hyW
      exact (htself.2).self_of_nhds hyW
    · intro hty
      have hyZ : y ∈ (vanishingIdeal (n := m + 1) (F.flag (1 : Fin (m + 2)))).zeroLocus := by
        intro g hg
        obtain ⟨_, c, _, hceq⟩ := isInSpanAt_eq_iff.mp ((htgen y hy.1 g).mp hg)
        simpa only [hty, mul_zero] using hceq.self_of_nhds
      simpa only [VanishingIdealZeroLocus.zeroLocus_vanishingIdeal F.firstDivisor.1] using hyZ
  · intro y _ hty
    exact mul_div_cancel_left₀ (r y) (pow_ne_zero a hty)
  · intro q hq g
    rw [htail]
    exact pullback_principal_generator Subtype.val hval R.ideal r q
      (hrhol ((Subtype.val : F.tail.carrier → F.carrier) q) hq)
      (hrgen ((Subtype.val : F.tail.carrier → F.carrier) q) hq.2) g
  · intro V hV hVU hne
    exact hrnv V hV (fun y hy => (hVU hy).2) hne

end SGPT.Okounkov
