import SGPT.Okounkov.SchemeAffineStalkGerm
import SGPT.Okounkov.SchemePointPowerGerm
import SGPT.Foundations.Schemes.SectionRingCenteredFrame
import SGPT.Foundations.Analysis.Pending.HolomorphicGermAlgebra
import SGPT.Foundations.Analysis.Pending.IdealWeightPowers

/-!
# Actual section coefficients manufacture an original analytic effective divisor

The principal ideal of the SAME actual point-power coefficient germ is locally
generated by a literal original holomorphic function. Actual original frame
transition units, not a supplied gluing or invertibility certificate, prove it.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov

open CategoryTheory AlgebraicGeometry SGPT.Foundations.Schemes Filter Set
open SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open scoped Topology Manifold

private def nativePrincipalGermIdeal {d : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel d) M] (v : ∀ p : M, NativeHolGerm d M p) : GermIdeal d M where
  mem p g := ∃ hg : HolomorphicAt d g p, NativeHolGerm.mk g hg ∈ Ideal.span {v p}

private theorem nativePrincipal_mem_iff {d : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel d) M] {p : M} {H : M → ℂ}
    (hH : HolomorphicAt d H p) (g : M → ℂ) :
    (∃ hg : HolomorphicAt d g p,
      NativeHolGerm.mk g hg ∈ Ideal.span {NativeHolGerm.mk H hH}) ↔
        IsInSpanAt (n := d) (· = H) p g := by
  rw [isInSpanAt_eq_iff]
  constructor
  · rintro ⟨hg, hmem⟩
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hmem
    obtain ⟨C, hC, rfl⟩ := NativeHolGerm.exists_eq_mk c
    refine ⟨hg, C, hC, ?_⟩
    have heq : NativeHolGerm.mk g hg = NativeHolGerm.mk
        (fun y => C y * H y) (hC.mul hH) := by
      change NativeHolGerm.mk g hg = NativeHolGerm.mk C hC * NativeHolGerm.mk H hH
      exact hc.trans (mul_comm _ _)
    exact NativeHolGerm.mk_eq_mk_iff.mp heq
  · rintro ⟨hg, C, hC, heq⟩
    refine ⟨hg, Ideal.mem_span_singleton.mpr ⟨NativeHolGerm.mk C hC, ?_⟩⟩
    apply Subtype.ext
    apply Germ.coe_eq.mpr
    filter_upwards [heq] with y hy
    simpa only [mul_comm] using hy

private theorem principalProduct_mem_iff {d : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel d) M] {p : M} (I J : GermIdeal d M)
    (H K : M → ℂ) (hH : HolomorphicAt d H p) (hK : HolomorphicAt d K p)
    (hI : ∀ g, I.mem p g ↔ IsInSpanAt (n := d) (· = H) p g)
    (hJ : ∀ g, J.mem p g ↔ IsInSpanAt (n := d) (· = K) p g) (g : M → ℂ) :
    (I.mul J).mem p g ↔ IsInSpanAt (n := d) (· = fun y => H y * K y) p g := by
  constructor
  · intro hg
    have hg' : IsInSpanAt (n := d)
        (fun t => ∃ a b, I.mem p a ∧ J.mem p b ∧ t = a * b) p g := hg
    apply IsInSpanAt.of_forall_eq_mul ?_ hg'
    rintro t ⟨a, b, ha, hb, rfl⟩
    obtain ⟨_, A, hA, heA⟩ := isInSpanAt_eq_iff.mp ((hI a).mp ha)
    obtain ⟨_, B, hB, heB⟩ := isInSpanAt_eq_iff.mp ((hJ b).mp hb)
    refine ⟨fun y => A y * B y, hA.mul hB, ?_⟩
    filter_upwards [heA, heB] with y hyA hyB
    change a y * b y = _
    rw [hyA, hyB]
    ring
  · intro hg
    obtain ⟨hgh, C, hC, heC⟩ := isInSpanAt_eq_iff.mp hg
    have hHm : I.mem p H := (hI H).mpr (isInSpanAt_eq_iff.mpr
      ⟨hH, fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ => by simp⟩)
    have hKm : J.mem p K := (hJ K).mpr (isInSpanAt_eq_iff.mpr
      ⟨hK, fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ => by simp⟩)
    show IsInSpanAt (n := d) (fun t => ∃ a b, I.mem p a ∧ J.mem p b ∧ t = a * b) p g
    exact isInSpanAt_of_eq_mul ⟨H, K, hHm, hKm, rfl⟩ hgh hC heC

variable {X : Scheme} (f : X ⟶ Spec (.of ℂ)) (n : ℕ)
  [SmoothOfRelativeDimension n f] [IsSeparated f] [QuasiCompact f]

local instance sectionDivisorTopology : TopologicalSpace (SchemeComplexPoint f) :=
  schemeAnalyticPointTopology f
local instance sectionDivisorCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint f) :=
  schemeAnalyticTNChartedSpace f n
local instance sectionDivisorManifold : IsComplexManifold n (SchemeComplexPoint f) :=
  schemeAnalyticTN_isComplexManifold f n

private def framePowerCoefficient {L : X.Modules} {U : X.Opens}
    (α : LocalBundleFrame L U) (m : ℕ) (s : bundlePowerGlobalSections L m) : Γ(X, U) :=
  (α.tensorPower m).coefficients (𝟙 _)
    ((bundleTensorPower L m).val.map (homOfLE le_top).op s)

/-- Literal original coefficient germ in any genuine original frame at the point. -/
def schemeFramePowerSectionNativeGerm (p : SchemeComplexPoint f) {L : X.Modules} {U : X.Opens}
    (α : LocalBundleFrame L U) (hp : schemeComplexPointImage f p ∈ U)
    (m : ℕ) (s : bundlePowerGlobalSections L m) : NativeHolGerm n (SchemeComplexPoint f) p :=
  schemeNativeStalkGerm f n p (X.presheaf.germ U (schemeComplexPointImage f p) hp
    (framePowerCoefficient α m s))

private theorem framePowerNativeGerm_transition (p : SchemeComplexPoint f)
    {L : X.Modules} {U V : X.Opens} (α : LocalBundleFrame L U) (β : LocalBundleFrame L V)
    (hpU : schemeComplexPointImage f p ∈ U) (hpV : schemeComplexPointImage f p ∈ V)
    (m : ℕ) (s : bundlePowerGlobalSections L m) :
    schemeFramePowerSectionNativeGerm f n p β hpV m s =
      ((Units.map (schemeNativeStalkGerm f n p).toMonoidHom
        (localBundleFrameTransitionAtCenter α β (schemeComplexPointImage f p) hpU hpV) :
          (NativeHolGerm n (SchemeComplexPoint f) p)ˣ) : NativeHolGerm n (SchemeComplexPoint f) p) ^ m *
        schemeFramePowerSectionNativeGerm f n p α hpU m s := by
  let x := schemeComplexPointImage f p
  let i : U ⊓ V ⟶ U := homOfLE inf_le_left
  let j : U ⊓ V ⟶ V := homOfLE inf_le_right
  have ht := LocalBundleFrame.global_coefficients_transition α β i j m s
  have hg := congrArg (fun r : Γ(X, U ⊓ V) =>
    schemeNativeStalkGerm f n p (X.presheaf.germ (U ⊓ V) x ⟨hpU, hpV⟩ r)) ht
  have hU : X.presheaf.germ (U ⊓ V) x ⟨hpU, hpV⟩
      (X.presheaf.map i.op (framePowerCoefficient α m s)) =
        X.presheaf.germ U x hpU (framePowerCoefficient α m s) :=
    congrArg (fun h : Γ(X, U) ⟶ X.presheaf.stalk x => h (framePowerCoefficient α m s))
      (X.presheaf.germ_res i x ⟨hpU, hpV⟩)
  have hV : X.presheaf.germ (U ⊓ V) x ⟨hpU, hpV⟩
      (X.presheaf.map j.op (framePowerCoefficient β m s)) =
        X.presheaf.germ V x hpV (framePowerCoefficient β m s) :=
    congrArg (fun h : Γ(X, V) ⟶ X.presheaf.stalk x => h (framePowerCoefficient β m s))
      (X.presheaf.germ_res j x ⟨hpU, hpV⟩)
  change schemeNativeStalkGerm f n p (X.presheaf.germ (U ⊓ V) x ⟨hpU, hpV⟩
    (X.presheaf.map j.op (framePowerCoefficient β m s))) =
      schemeNativeStalkGerm f n p (X.presheaf.germ (U ⊓ V) x ⟨hpU, hpV⟩
        ((show Γ(X, U ⊓ V) from (localBundleFrameTransition α β i j).val) ^ m *
          X.presheaf.map i.op (framePowerCoefficient α m s))) at hg
  simp only [map_mul, map_pow, hU, hV] at hg
  exact hg

private theorem framePowerNativeGerm_span (p : SchemeComplexPoint f)
    {L : X.Modules} {U V : X.Opens} (α : LocalBundleFrame L U) (β : LocalBundleFrame L V)
    (hpU : schemeComplexPointImage f p ∈ U) (hpV : schemeComplexPointImage f p ∈ V)
    (m : ℕ) (s : bundlePowerGlobalSections L m) :
    Ideal.span {schemeFramePowerSectionNativeGerm f n p β hpV m s} =
      Ideal.span {schemeFramePowerSectionNativeGerm f n p α hpU m s} := by
  rw [framePowerNativeGerm_transition]
  exact Ideal.span_singleton_mul_left_unit
    ((Units.map (schemeNativeStalkGerm f n p).toMonoidHom
      (localBundleFrameTransitionAtCenter α β (schemeComplexPointImage f p) hpU hpV)).isUnit.pow m) _

private theorem pointPowerNativeGerm_span_frame (p : SchemeComplexPoint f)
    {L : X.Modules} (a : LineBundleAtlas L) {U : X.Opens} (α : LocalBundleFrame L U)
    (hpU : schemeComplexPointImage f p ∈ U) (m : ℕ) (s : bundlePowerGlobalSections L m) :
    Ideal.span {schemePointPowerSectionNativeGerm f n p a m s} =
      Ideal.span {schemeFramePowerSectionNativeGerm f n p α hpU m s} :=
  framePowerNativeGerm_span f n p α (schemePointFrame f p a) hpU (schemePointFrame_mem f p a) m s

omit [IsSeparated f] [QuasiCompact f] in
/-- The ACTUAL original coefficient germ defines its intrinsic principal germ
ideal at every original point. No gluing or divisor witness is an input. -/
def schemeSectionAnalyticIdeal (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m) :
    GermIdeal n (SchemeComplexPoint f) := by
  let := E.isSeparated
  let := E.quasiCompact
  exact nativePrincipalGermIdeal (fun p => schemePointPowerSectionNativeGerm f n p a m s)

omit [IsSeparated f] [QuasiCompact f] in
/-- WHOLE native-ring principal membership of the SAME point-power coefficients. -/
theorem schemeSectionAnalyticIdeal_mem (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m)
    (p : SchemeComplexPoint f) (g : SchemeComplexPoint f → ℂ) :
    letI := E.isSeparated
    letI := E.quasiCompact
    (schemeSectionAnalyticIdeal f n E a m s).mem p g ↔
      ∃ hg : HolomorphicAt n g p, NativeHolGerm.mk g hg ∈
        Ideal.span {schemePointPowerSectionNativeGerm f n p a m s} := Iff.rfl

omit [IsSeparated f] [QuasiCompact f] in
/-- Actual original frame-transition units give WHOLE principal membership in
EVERY genuine original frame containing the point. -/
theorem schemeSectionAnalyticIdeal_mem_frame (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m)
    (p : SchemeComplexPoint f) {U : X.Opens} (α : LocalBundleFrame L U)
    (hp : schemeComplexPointImage f p ∈ U) (g : SchemeComplexPoint f → ℂ) :
    letI := E.isSeparated
    letI := E.quasiCompact
    (schemeSectionAnalyticIdeal f n E a m s).mem p g ↔
      ∃ hg : HolomorphicAt n g p, NativeHolGerm.mk g hg ∈
        Ideal.span {schemeFramePowerSectionNativeGerm f n p α hp m s} := by
  let := E.isSeparated
  let := E.quasiCompact
  rw [schemeSectionAnalyticIdeal_mem, pointPowerNativeGerm_span_frame f n p a α hp m s]

omit [IsSeparated f] [QuasiCompact f] in
/-- Actual nonzero original sections INTERNALLY produce the literal TN
locally principal, nowhere-identically-zero ideal condition. -/
theorem schemeSectionAnalyticIdeal_isInvertible [IsIntegral X] (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m)
    (hs : s ≠ 0) :
    letI := E.isSeparated
    letI := E.quasiCompact
    (schemeSectionAnalyticIdeal f n E a m s).IsInvertible := by
  let := E.isSeparated
  let := E.quasiCompact
  intro p
  let U := schemePointFrameOpen f p a
  let α := schemePointFrame f p a
  let r := framePowerCoefficient α m s
  obtain ⟨V, hV, hpV, hVU, H, hH, hread⟩ :=
    schemeRegularSection_locally_holomorphic f n E U r p (schemePointFrame_mem f p a)
  have hhol : ∀ q ∈ V, HolomorphicAt n H q := by
    intro q hq
    filter_upwards [hV.mem_nhds hq] with v hv
    exact (hH v hv).mdifferentiableAt (hV.mem_nhds hv)
  have hframe : ∀ (q : SchemeComplexPoint f) (hq : q ∈ V),
      schemeFramePowerSectionNativeGerm f n q α (hVU hq) m s =
        NativeHolGerm.mk H (hhol q hq) := by
    intro q hq
    apply Subtype.ext
    exact hread q hq (hVU hq)
  have hnz : ∀ (q : SchemeComplexPoint f) (hq : q ∈ V),
      NativeHolGerm.mk H (hhol q hq) ≠ 0 := by
    intro q hq hz
    have hspan := pointPowerNativeGerm_span_frame f n q a α (hVU hq) m s
    rw [hframe q hq, hz, Ideal.span_singleton_zero] at hspan
    exact schemePointPowerSectionNativeGerm_ne_zero f n q a m s hs
      (Ideal.span_singleton_eq_bot.mp hspan)
  refine ⟨V, hV, hpV, H, hH, ?_, ?_⟩
  · intro W hW hWV hWne
    obtain ⟨q, hq⟩ := hWne
    by_contra! hzero
    have hz : NativeHolGerm.mk H (hhol q (hWV hq)) = 0 := by
      apply Subtype.ext
      apply Germ.coe_eq.mpr
      filter_upwards [hW.mem_nhds hq] with v hv
      exact hzero v hv
    exact hnz q (hWV hq) hz
  · intro q hq g
    rw [schemeSectionAnalyticIdeal_mem_frame f n E a m s q α (hVU hq), hframe q hq]
    exact nativePrincipal_mem_iff (hhol q hq) g

omit [IsSeparated f] [QuasiCompact f] in
/-- The actual effective divisor of the original nonzero section is produced
from its original coefficient ideals, with no divisor certificate input. -/
def schemeSectionAnalyticDivisor [IsIntegral X] (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m)
    (hs : s ≠ 0) : EffectiveDivisor n (SchemeComplexPoint f) where
  ideal := schemeSectionAnalyticIdeal f n E a m s
  isInvertible := schemeSectionAnalyticIdeal_isInvertible f n E a m s hs

omit [IsSeparated f] [QuasiCompact f] in
/-- The actual produced divisor retains exactly its original coefficient ideal. -/
theorem schemeSectionAnalyticDivisor_ideal [IsIntegral X] (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m)
    (hs : s ≠ 0) :
    (schemeSectionAnalyticDivisor f n E a m s hs).ideal = schemeSectionAnalyticIdeal f n E a m s := rfl

omit [IsSeparated f] [QuasiCompact f] in
/-- Genuine original stalk units prove WHOLE ideal independence of the actual atlas. -/
theorem schemeSectionAnalyticIdeal_atlas_independent (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a b : LineBundleAtlas L) (m : ℕ) (s : bundlePowerGlobalSections L m) :
    schemeSectionAnalyticIdeal f n E a m s = schemeSectionAnalyticIdeal f n E b m s := by
  let := E.isSeparated
  let := E.quasiCompact
  ext p g
  rw [schemeSectionAnalyticIdeal_mem_frame f n E a m s p
    (schemePointFrame f p b) (schemePointFrame_mem f p b), schemeSectionAnalyticIdeal_mem]
  rfl

omit [IsSeparated f] [QuasiCompact f] in
/-- SAME original frame powers prove the WHOLE literal TN ideal-product law. -/
theorem schemeSectionAnalyticIdeal_mul (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) (m k : ℕ)
    (s : bundlePowerGlobalSections L m) (t : bundlePowerGlobalSections L k) :
    schemeSectionAnalyticIdeal f n E a (m + k) (atlasPowerGlobalMul a m k s t) =
      (schemeSectionAnalyticIdeal f n E a m s).mul (schemeSectionAnalyticIdeal f n E a k t) := by
  let := E.isSeparated
  let := E.quasiCompact
  ext p g
  obtain ⟨H, hH, heH⟩ := NativeHolGerm.exists_eq_mk (schemePointPowerSectionNativeGerm f n p a m s)
  obtain ⟨K, hK, heK⟩ := NativeHolGerm.exists_eq_mk (schemePointPowerSectionNativeGerm f n p a k t)
  have hI (v : SchemeComplexPoint f → ℂ) :
      (schemeSectionAnalyticIdeal f n E a m s).mem p v ↔ IsInSpanAt (n := n) (· = H) p v := by
    rw [schemeSectionAnalyticIdeal_mem, heH]
    exact nativePrincipal_mem_iff hH v
  have hJ (v : SchemeComplexPoint f → ℂ) :
      (schemeSectionAnalyticIdeal f n E a k t).mem p v ↔ IsInSpanAt (n := n) (· = K) p v := by
    rw [schemeSectionAnalyticIdeal_mem, heK]
    exact nativePrincipal_mem_iff hK v
  rw [schemeSectionAnalyticIdeal_mem, schemePointPowerSectionNativeGerm_mul, heH, heK]
  change (∃ hg : HolomorphicAt n g p, NativeHolGerm.mk g hg ∈
    Ideal.span {NativeHolGerm.mk (fun y => H y * K y) (hH.mul hK)}) ↔ _
  rw [nativePrincipal_mem_iff]
  exact (principalProduct_mem_iff _ _ H K hH hK hI hJ g).symm

omit [IsSeparated f] [QuasiCompact f] in
/-- The actual original degree-zero section unit gives the literal TN unit ideal. -/
theorem schemeSectionAnalyticIdeal_one (E : ClosedProjectiveEmbedding f)
    {L : X.Modules} (a : LineBundleAtlas L) :
    schemeSectionAnalyticIdeal f n E a 0 (bundlePowerGlobalOne L) =
      IdealWeightPowers.unitIdeal n (SchemeComplexPoint f) := by
  let := E.isSeparated
  let := E.quasiCompact
  ext p g
  rw [schemeSectionAnalyticIdeal_mem, schemePointPowerSectionNativeGerm_one, Ideal.span_singleton_one]
  change (∃ hg : HolomorphicAt n g p, NativeHolGerm.mk g hg ∈ (⊤ : Ideal (NativeHolGerm n (SchemeComplexPoint f) p))) ↔
    HolomorphicAt n g p
  exact ⟨fun ⟨hg, _⟩ => hg, fun hg => ⟨hg, Submodule.mem_top⟩⟩

end SGPT.Okounkov
