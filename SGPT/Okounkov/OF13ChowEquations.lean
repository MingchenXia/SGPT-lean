import SGPT.Okounkov.OF13CoordinatePrime
import SGPT.Okounkov.FlagValuationSchemeChowFunctions
import SGPT.PSH.BookRestrictionIdeal

/-!
# Algebraic local equations of analytic hypersurfaces at the centre

Source: chapter *The theory of Okounkov bodies*, `rmk:Abhyankar` (existence part of
[CFKLRS17, Thm 2.9]); continuation of `SGPT.Okounkov.OF13CoordinatePrime`.

Let `V` be an integral smooth projective complex scheme (a closed projective embedding `EV`) of
dimension `n`. A resolution of singularities performed analytically produces, at a point `p` of
`V(ℂ)`, analytic hypersurfaces `H₁, …, Hₙ` through `p` (members of a simple normal crossings
divisor) with local equations `ℓⱼ` forming a holomorphic coordinate system at `p`, in which the
germs of given rational functions `u_k` are units times Laurent monomials. By **Chow's theorem**
(`SGPT.GAGA.ChowBl.chow_image`, with the generation of the analytic ideal by the Chow polynomials,
`vanishingIdeal_mem_iff_isInSpanAt_genFun`) each `Hⱼ` has an *algebraic* local equation:

* `exists_algebraic_localEquation`: if the analytic ideal of `H` at `p` is generated by `ℓ ≠ 0`,
  there is `z ∈ 𝒪_{V,x}` whose analytic germ is a unit times `ℓ` (one of the Chow polynomials
  `P(x/xᵢ)` of `H` generates the ideal: `ℓ = ∑ A_r G_r` and `G_r = B_r ℓ` give `∑ A_r B_r = 1`, so
  some `B_r` is a unit in the local ring of germs).

Consequently (**`exists_admissibleFlag_lexEquivalent_of_analyticMembers`**) the conclusion of
[CFKLRS17, Thm 2.9] holds on `V` as soon as, at the centre `p` of `ν`, the `u_k` (with
`ν(u_k) = e_k`) are, analytically, units times Laurent monomials in local equations of analytic
hypersurfaces `Hⱼ` which form a holomorphic coordinate system, `u_k` or `u_k⁻¹` holomorphic: `ν` is
equivalent to the valuation of an admissible flag on `V` with point `p`. This is exactly the local
output of an analytic log resolution of `u₁, …, uₙ` on `V(ℂ)`.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace SGPT.Okounkov.OF13

open CategoryTheory AlgebraicGeometry Filter Set IsLocalRing SGPT.Foundations.Schemes
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Okounkov SGPT.NAPotential.FSPos SGPT.Okounkov.OF5 SGPT.Okounkov.OF6 SGPT.Okounkov.ValCurr
open SGPT.Projective SGPT.Projective.ComplexProjectiveSpace
open SGPT.GAGA.H0S SGPT.GAGA.ChowBl SGPT.GAGA.Core
open scoped Topology Manifold

section Chow

variable {V : Scheme.{0}} (g : V ⟶ Spec (.of ℂ)) (n : ℕ)
  [SmoothOfRelativeDimension n g] [IsSeparated g] [QuasiCompact g]

local instance of13chTopology : TopologicalSpace (SchemeComplexPoint g) :=
  schemeAnalyticPointTopology g
local instance of13chCharts : ChartedSpace (ComplexModel n) (SchemeComplexPoint g) :=
  schemeAnalyticTNChartedSpace g n
local instance of13chManifold : IsComplexManifold n (SchemeComplexPoint g) :=
  schemeAnalyticTN_isComplexManifold g n

variable {g n}

/-- **Algebraic local equations of analytic hypersurfaces (Chow).** Let `H ⊆ V(ℂ)` be an analytic
subset and `ℓ` a holomorphic function at `p` vanishing on `H` whose germ is nonzero and generates
(the germs of) the analytic ideal of `H` at `p`. Then there is an algebraic germ `z ∈ 𝒪_{V,x}`
whose analytic germ is a unit times the germ of `ℓ`. -/
theorem exists_algebraic_localEquation (EV : ClosedProjectiveEmbedding g) (p : SchemeComplexPoint g)
    {H : Set (SchemeComplexPoint g)} (hH : IsComplexAnalyticSubset (n := n) H)
    (ℓ : SchemeComplexPoint g → ℂ) (hℓ : HolomorphicAt n ℓ p)
    (hℓmem : (vanishingIdeal (n := n) H).mem p ℓ)
    (hℓgen : ∀ (h : SchemeComplexPoint g → ℂ) (hh : HolomorphicAt n h p),
      (vanishingIdeal (n := n) H).mem p h →
        NativeHolGerm.mk h hh ∈ Ideal.span {NativeHolGerm.mk ℓ hℓ})
    (hℓ0 : NativeHolGerm.mk ℓ hℓ ≠ 0) :
    ∃ (z : V.presheaf.stalk (schemeComplexPointImage g p))
      (η : (NativeHolGerm n (SchemeComplexPoint g) p)ˣ),
      schemeNativeStalkGerm g n p z = η * NativeHolGerm.mk ℓ hℓ := by
  classical
  let : CompactSpace (SchemeComplexPoint g) := EV.analyticCompact
  let Ψ := projectivePoint g EV n
  have hΨ : IsHolomorphicEmbedding (n := n) Ψ := isHolomorphicEmbedding_projectivePoint g EV n
  obtain ⟨m₀, hm₀⟩ := chow_image hΨ hH
  obtain ⟨μ, hμ, Q, -, hgen, -⟩ := hm₀ m₀ le_rfl
  let : Fintype μ := hμ
  let e : μ ≃ Fin (Fintype.card μ) := Fintype.equivFin μ
  let P : Fin (Fintype.card μ) → MvPolynomial (Fin (EV.ambientDimension + 1)) ℂ :=
    fun j => Q (e.symm j)
  have hgenP : (coneIdeal (Ψ '' H)).GeneratedOn
      (SGPT.GAGA.PN.puncture (SGPT.GAGA.PN.ConeSpace EV.ambientDimension))
      (fun j => SGPT.GAGA.PN.polyTuple (P j)) := by
    apply hgen.of_generators
    · exact fun j b => hgen.1 (e.symm j) b
    · exact fun y hy j => hgen.gen_mem hy (e.symm j)
    · intro y hy j
      have hh := isCombinationAt_gen (fun a => SGPT.GAGA.PN.polyTuple (P a)) y (e j)
      simpa only [P, e.symm_apply_apply] using hh
  let i := frameIndex g EV p
  have hi : schemeComplexPointImage g p ∈ coordOpen EV i := mem_coordOpen_frameIndex g EV p
  have hΨi : Ψ p ∈ (affineChart i).source := (projectivePoint_mem_source_iff g EV n i p).mpr hi
  have hiff := vanishingIdeal_mem_iff_isInSpanAt_genFun hΨ hgenP hΨi
  -- `ℓ` is a combination of the Chow functions
  obtain ⟨-, N, s, A, hs, hA, hℓeq⟩ := (hiff ℓ).mp hℓmem
  choose k hk using hs
  have hG : ∀ r, HolomorphicAt n (s r) p := fun r => by
    rw [← hk r]
    exact holomorphicAt_genFun hΨ hΨi (P (k r))
  -- every Chow function lies in the ideal of `H`, hence is a multiple of `ℓ`
  have hGmem : ∀ r, (vanishingIdeal (n := n) H).mem p (s r) := fun r => by
    refine (hiff (s r)).mpr ⟨hG r, 1, fun _ => s r, fun _ => fun _ => 1, fun _ => ⟨k r, hk r⟩,
      fun _ => holomorphicAt_const 1, Eventually.of_forall fun y => ?_⟩
    simp
  have hB : ∀ r, ∃ B : NativeHolGerm n (SchemeComplexPoint g) p,
      NativeHolGerm.mk (s r) (hG r) = B * NativeHolGerm.mk ℓ hℓ := fun r => by
    obtain ⟨B, hB⟩ := Ideal.mem_span_singleton'.mp (hℓgen (s r) (hG r) (hGmem r))
    exact ⟨B, hB.symm⟩
  choose B hB using hB
  have hsum : NativeHolGerm.mk ℓ hℓ =
      ∑ r, NativeHolGerm.mk (A r) (hA r) * NativeHolGerm.mk (s r) (hG r) := by
    have hsumhol : HolomorphicAt n (fun y => ∑ r, A r y * s r y) p :=
      HolomorphicAt.sum Finset.univ fun r _ => (hA r).mul (hG r)
    rw [← SGPT.PSH.IdealRestriction.mk_sum_mul A s hA hG hsumhol]
    exact NativeHolGerm.mk_eq_mk_iff.mpr hℓeq
  simp only [hB, ← mul_assoc, ← Finset.sum_mul] at hsum
  have h1 : ∑ r, NativeHolGerm.mk (A r) (hA r) * B r = 1 := by
    have h2 : (1 - ∑ r, NativeHolGerm.mk (A r) (hA r) * B r) * NativeHolGerm.mk ℓ hℓ = 0 := by
      rw [sub_mul, one_mul, ← hsum, sub_self]
    have h3 := (mul_eq_zero.mp h2).resolve_right hℓ0
    exact (sub_eq_zero.mp h3).symm
  obtain ⟨r, hr⟩ : ∃ r, IsUnit (NativeHolGerm.mk (A r) (hA r) * B r) := by
    by_contra hcon
    push Not at hcon
    have hmem : ∑ r, NativeHolGerm.mk (A r) (hA r) * B r ∈
        maximalIdeal (NativeHolGerm n (SchemeComplexPoint g) p) :=
      Ideal.sum_mem _ fun r _ => (mem_maximalIdeal _).mpr (hcon r)
    rw [h1] at hmem
    exact (maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr hmem)
  have hBu : IsUnit (B r) := isUnit_of_mul_isUnit_right hr
  refine ⟨V.presheaf.germ (coordOpen EV i) (schemeComplexPointImage g p) hi
    (polyCoef EV i (P (k r))), hBu.unit, ?_⟩
  rw [schemeNativeStalkGerm_polyCoef g EV n i (P (k r)) p hi, IsUnit.unit_spec, ← hB r]
  apply NativeHolGerm.mk_eq_mk_iff.mpr
  have hkr : genFun Ψ i (P (k r)) = s r := hk r
  rw [hkr]

/-! ### Units, fractions and generators -/

omit [SmoothOfRelativeDimension n g] [IsSeparated g] [QuasiCompact g] in
theorem algebraMap_units_zpow {R L : Type*} [CommRing R] [Field L] [Algebra R L] (u : Rˣ)
    (m : ℤ) : algebraMap R L ((u ^ m : Rˣ) : R) = (algebraMap R L (u : R)) ^ m := by
  have h := congrArg Units.val (map_zpow (Units.map (algebraMap R L).toMonoidHom) u m)
  rw [Units.val_zpow_eq_zpow_val] at h
  exact h

omit [SmoothOfRelativeDimension n g] [IsSeparated g] [QuasiCompact g] in
/-- Multiplying generators by units does not change the ideal they generate. -/
theorem span_range_units_mul {R : Type*} [CommRing R] {ι : Type*} (c : ι → Rˣ) (t : ι → R) :
    Ideal.span (Set.range fun j => (c j : R) * t j) = Ideal.span (Set.range t) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    have h : t j = ((c j)⁻¹ : Rˣ) * ((c j : R) * t j) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [SetLike.mem_coe, h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

variable (g n) in
/-- The meromorphic germ map of `ℂ(V)` is the fraction map of the analytic germ map. -/
theorem schemeNativeFunctionFieldGerm_eq_fractionMap [IsIntegral V] (p : SchemeComplexPoint g) :
    schemeNativeFunctionFieldGerm g n p =
      IsFractionRing.map (A := V.presheaf.stalk (schemeComplexPointImage g p))
        (K := V.functionField) (L := FractionRing (NativeHolGerm n (SchemeComplexPoint g) p))
        (schemeNativeStalkGerm_injective g n p) := by
  apply IsLocalization.ringHom_ext
    (nonZeroDivisors (V.presheaf.stalk (schemeComplexPointImage g p)))
  ext a
  simp only [RingHom.comp_apply]
  rw [schemeNativeFunctionFieldGerm_stalk, fractionMap_algebraMap]

/-! ### The main theorem -/

/-- **[CFKLRS17, Thm 2.9] on a smooth projective model from an analytic log resolution at the
centre.** Let `X` be integral, `ν : ℂ(X)^× → ℤⁿ_lex` a valuation, `V` an integral smooth projective
complex scheme of dimension `n` with `e : ℂ(X) ≃ ℂ(V)`, and `p` a complex point of `V` at whose
image `x` the valuation `ν` is centred. Suppose that `V(ℂ)` carries analytic hypersurfaces
`H₁, …, Hₙ` through `p` whose local equations `ℓⱼ` (generators of their analytic ideals at `p`)
form a holomorphic coordinate system at `p` (simple normal crossings at `p`), and that
`u₁, …, uₙ ∈ ℂ(X)` with `ν(u_k) = e_k` have meromorphic germs at `p` equal to analytic units times
Laurent monomials `∏ⱼ ℓⱼ^{a_{kj}}`, the germ of `u_k` or of `u_k⁻¹` being holomorphic. Then `ν` is
equivalent to the valuation `ν_{Y•} ∘ e` of an admissible flag `Y•` on `V` with point `x`. -/
theorem exists_admissibleFlag_lexEquivalent_of_analyticMembers {X : Scheme.{0}} [IsIntegral X]
    [IsIntegral V] (EV : ClosedProjectiveEmbedding g) (e : X.functionField ≃+* V.functionField)
    (ν : AddValuation X.functionField (WithTop (Lex (Fin n → ℤ))))
    (p : SchemeComplexPoint g)
    (hcent : AlgebraicValuation.IsValuationCenter (ν.comap e.symm.toRingHom)
      (schemeComplexPointImage g p))
    (H : Fin n → Set (SchemeComplexPoint g)) (hH : ∀ j, IsComplexAnalyticSubset (n := n) (H j))
    (ℓ : Fin n → SchemeComplexPoint g → ℂ) (hℓ : ∀ j, HolomorphicAt n (ℓ j) p)
    (hℓmem : ∀ j, (vanishingIdeal (n := n) (H j)).mem p (ℓ j))
    (hℓgen : ∀ j (h : SchemeComplexPoint g → ℂ) (hh : HolomorphicAt n h p),
      (vanishingIdeal (n := n) (H j)).mem p h →
        NativeHolGerm.mk h hh ∈ Ideal.span {NativeHolGerm.mk (ℓ j) (hℓ j)})
    (hcoord : Ideal.span (Set.range fun j =>
        NativeHolGerm.chartEquiv p (NativeHolGerm.mk (ℓ j) (hℓ j))) =
      maximalIdeal (HolGerm (ComplexModel n)))
    (u : Fin n → X.functionField) (η : Fin n → (NativeHolGerm n (SchemeComplexPoint g) p)ˣ)
    (a : Fin n → Fin n → ℤ)
    (hu : ∀ k, schemeNativeFunctionFieldGerm g n p (e (u k)) =
      algebraMap _ (FractionRing (NativeHolGerm n (SchemeComplexPoint g) p))
          (η k : NativeHolGerm n (SchemeComplexPoint g) p) *
        ∏ j, (algebraMap _ (FractionRing (NativeHolGerm n (SchemeComplexPoint g) p))
          (NativeHolGerm.mk (ℓ j) (hℓ j))) ^ (a k j))
    (hreg : ∀ k, (∃ h : NativeHolGerm n (SchemeComplexPoint g) p,
        schemeNativeFunctionFieldGerm g n p (e (u k)) =
          algebraMap _ (FractionRing (NativeHolGerm n (SchemeComplexPoint g) p)) h) ∨
      ∃ h : NativeHolGerm n (SchemeComplexPoint g) p,
        schemeNativeFunctionFieldGerm g n p (e (u k))⁻¹ =
          algebraMap _ (FractionRing (NativeHolGerm n (SchemeComplexPoint g) p)) h)
    (hνu : ∀ k, ν (u k) = basisValue k) :
    ∃ (Y : Fin (n + 1) → Set V) (hY : IsAdmissibleFlag g n Y),
      hY.point = schemeComplexPointImage g p ∧
      ValuationsLexEquivalent ((admissibleFlagValuation hY).comap e.toRingHom) ν := by
  classical
  let G := NativeHolGerm n (SchemeComplexPoint g) p
  let L := FractionRing G
  let w : Fin n → G := fun j => NativeHolGerm.mk (ℓ j) (hℓ j)
  -- the local equations are nonzero
  obtain ⟨v, hv⟩ := dualVectors_of_span_eq _ hcoord
  have hw0 : ∀ j, w j ≠ 0 := fun j h => by
    have h1 := hv j j
    change germDeriv (v j) (NativeHolGerm.chartEquiv p (w j)) = _ at h1
    rw [h, map_zero, germDeriv_zero, if_pos rfl] at h1
    exact zero_ne_one h1
  -- algebraic local equations (Chow)
  have hz : ∀ j, ∃ (z : V.presheaf.stalk (schemeComplexPointImage g p)) (B : Gˣ),
      schemeNativeStalkGerm g n p z = B * w j :=
    fun j => exists_algebraic_localEquation EV p (hH j) (ℓ j) (hℓ j) (hℓmem j) (hℓgen j) (hw0 j)
  choose z B hzB using hz
  -- `z` are strict normal crossings coordinates
  have hm : Ideal.span (Set.range (stalkToModel g n p ∘ z)) =
      maximalIdeal (HolGerm (ComplexModel n)) := by
    have h1 : (stalkToModel g n p ∘ z) = fun j =>
        ((Units.map (NativeHolGerm.chartEquiv p).toMonoidHom (B j) :
          (HolGerm (ComplexModel n))ˣ) : HolGerm (ComplexModel n)) *
          NativeHolGerm.chartEquiv p (w j) := by
      funext j
      change NativeHolGerm.chartEquiv p (schemeNativeStalkGerm g n p (z j)) = _
      rw [hzB j, map_mul]
      rfl
    rw [h1, span_range_units_mul]
    exact hcoord
  have hsnc := isSNCCoordinates_of_analyticCoordinates z hm
  -- the fraction germ map
  have hinj := schemeNativeStalkGerm_injective g n p
  have hff := schemeNativeStalkGerm_faithfullyFlat g n p
  have hΓ := schemeNativeFunctionFieldGerm_eq_fractionMap g n p
  have hz0 : ∀ j, z j ≠ 0 := fun j h => by
    have h1 := hzB j
    rw [h, map_zero] at h1
    exact hw0 j ((Units.mul_right_eq_zero (B j)).mp h1.symm)
  let P : Fin n → V.functionField := fun k => ∏ j, (algebraMap _ V.functionField (z j)) ^ (a k j)
  have hP0 : ∀ k, P k ≠ 0 := fun k => Finset.prod_ne_zero_iff.mpr fun j _ =>
    zpow_ne_zero _ ((map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr (hz0 j))
  have hwL0 : ∀ j, algebraMap G L (w j) ≠ 0 := fun j =>
    (map_ne_zero_iff _ (IsFractionRing.injective G L)).mpr (hw0 j)
  have hBL0 : ∀ j, algebraMap G L (B j : G) ≠ 0 := fun j =>
    (map_ne_zero_iff _ (IsFractionRing.injective G L)).mpr (B j).ne_zero
  have hPgerm : ∀ k, schemeNativeFunctionFieldGerm g n p (P k) =
      ∏ j, (algebraMap G L (B j : G) * algebraMap G L (w j)) ^ (a k j) := fun k => by
    simp only [P, map_prod, map_zpow₀]
    refine Finset.prod_congr rfl fun j _ => ?_
    rw [schemeNativeFunctionFieldGerm_stalk, hzB j, map_mul]
  let η' : Fin n → Gˣ := fun k => η k * ∏ j, (B j) ^ (-a k j)
  have hε : ∀ k, ∃ ε : (V.presheaf.stalk (schemeComplexPointImage g p))ˣ,
      algebraMap _ V.functionField (ε : V.presheaf.stalk (schemeComplexPointImage g p)) =
        e (u k) / P k := fun k => by
    refine exists_unit_algebraMap_eq_of_map_eq (K := V.functionField) (L := L) hinj hff _
      (η' k) ?_
    rw [← hΓ]
    have hPL : schemeNativeFunctionFieldGerm g n p (P k) ≠ 0 :=
      (map_ne_zero_iff _ (schemeNativeFunctionFieldGerm g n p).injective).mpr (hP0 k)
    rw [map_div₀, div_eq_iff hPL, hu k, hPgerm k]
    simp only [η', Units.val_mul, Units.coe_prod, map_mul, map_prod, algebraMap_units_zpow,
      mul_zpow, Finset.prod_mul_distrib]
    rw [mul_assoc, ← mul_assoc (∏ j, (algebraMap G L (B j : G)) ^ (-a k j))]
    rw [← Finset.prod_mul_distrib]
    have hone : ∀ j, (algebraMap G L (B j : G)) ^ (-a k j) * (algebraMap G L (B j : G)) ^ (a k j)
        = 1 := fun j => by
      rw [← zpow_add₀ (hBL0 j), neg_add_cancel, zpow_zero]
    simp only [hone, Finset.prod_const_one, one_mul]
    rfl
  choose ε hε using hε
  refine OF11.exists_admissibleFlag_lexEquivalent_of_model e ν hcent hsnc u ε a (fun k => ?_)
    (fun k => ?_) hνu
  · change e (u k) = algebraMap _ V.functionField
      (ε k : V.presheaf.stalk (schemeComplexPointImage g p)) * P k
    rw [hε k, div_mul_cancel₀ _ (hP0 k)]
  · rcases hreg k with ⟨h, hh⟩ | ⟨h, hh⟩
    · rw [hΓ] at hh
      exact Or.inl (exists_algebraMap_eq_of_map_eq (K := V.functionField) (L := L) hinj hff _ h hh)
    · rw [hΓ] at hh
      exact Or.inr (exists_algebraMap_eq_of_map_eq (K := V.functionField) (L := L) hinj hff _ h hh)

end Chow

end SGPT.Okounkov.OF13
