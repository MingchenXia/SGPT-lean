import SGPT.PSH.StrongOpenness

set_option autoImplicit false

noncomputable section

namespace SGPT.PSH

open Set Filter MeasureTheory Metric
open scoped Topology Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending
open MultiplierIdealBergmanNadelIdeal

/-- The actual full holomorphic stalk is generated by the original constant
one, with actual holomorphic coefficients. This also covers empty manifolds. -/
theorem isCoherent_of_holomorphic_stalks
    {n : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
    (I : GermIdeal n M)
    (hI : ∀ y F, I.mem y F ↔ HolomorphicAt n F y) : I.IsCoherent := by
  intro x
  refine ⟨univ, isOpen_univ, mem_univ x, 1, fun _ _ => 1,
    fun _ => mdifferentiableOn_const, ?_⟩
  intro y _ F
  rw [hI]
  constructor
  · intro hF
    refine ⟨hF, 1, fun _ _ => 1, fun _ => F,
      fun _ => ⟨0, rfl⟩, fun _ => hF, ?_⟩
    exact Eventually.of_forall fun z => by simp
  · exact fun h => h.1

/-- Whole original Nadel coherence for the native multiplier ideal, all
dimensions. Positive dimensions reuse main's genuine theorem; zero dimensions
reuse its complete original multiplier stalk and the actual unit generator. -/
theorem ManifoldPSH.multiplierIdeal_isCoherent
    {n : ℕ} {M : Type*} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
    {u : M → EReal} (hu : ManifoldPSH (n := n) u)
    {c : ℝ} (hc : 0 < c) : (multiplierIdeal (n := n) c u).IsCoherent := by
  cases n with
  | zero =>
    exact isCoherent_of_holomorphic_stalks _ fun y F =>
      ZeroDimensionalQuasiPshMultiplierIdeals.mem_multiplierIdeal_iff_holomorphicAt
        hu.isThetaPshPotential_zero.quasiPshPotential hc y F
  | succ m =>
    exact MultiplierIdealBergmanNadelManifold.isCoherent_multiplierIdeal
      hu.isThetaPshPotential_zero.1 hc

/-- True Nadel generators on one original model ball give equality of every
nearby original multiplier stalk with their genuine holomorphic germ span. -/
theorem exists_multiplierIdeal_ball_generators
    {n : ℕ} {W : Set (ComplexModel n)} (hW : IsOpen W)
    {u : ComplexModel n → EReal} (hu : PSHOn u W)
    {z : ComplexModel n} (hz : z ∈ W) {c : ℝ} (hc : 0 < c) :
    ∃ r > 0, ∃ (N : ℕ) (g : Fin N → ComplexModel n → ℂ),
      ball z r ⊆ W ∧ (∀ i, DifferentiableOn ℂ (g i) (ball z r)) ∧
      (∀ i, ∀ y ∈ ball z r, MultiplierIntegrableAt u c (g i) y volume) ∧
      ∀ y ∈ ball z r, ∀ f : ComplexModel n → ℂ,
        MultiplierIntegrableAt u c f y volume ↔ InGermSpan (range g) y f := by
  cases n with
  | zero =>
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hW z hz
    refine ⟨r, hr, 1, fun _ _ => 1, hball,
      fun _ => differentiableOn_const _,
      fun _ y hy => multiplierIntegrableAt_zero_of_pshOn hu (hball hy) hc _, ?_⟩
    intro y hy f
    constructor
    · intro _
      refine ⟨1, fun _ _ => 1, fun _ => f,
        fun _ => ⟨0, rfl⟩, ?_, Eventually.of_forall fun _ => by simp⟩
      intro _
      have hf : f = fun _ => f y := by
        funext x
        rw [Subsingleton.elim x y]
      rw [hf]
      exact Eventually.of_forall fun _ => differentiableAt_const _
    · intro _
      exact multiplierIntegrableAt_zero_of_pshOn hu (hball hy) hc f
  | succ m =>
    let Ω : TopologicalSpace.Opens (ComplexModel (m + 1)) := ⟨W, hW⟩
    have hp := hu.disc.plurisubharmonicOn hW
    obtain ⟨r, hr, N, g, hball, hgd, hgi, hgen⟩ :=
      MultiplierIdealBergmanNadelCoherence.exists_local_generators (Ω := Ω) hp hc hz
    refine ⟨r, hr, N, g, hball, hgd, hgi, ?_⟩
    intro y hy f
    refine ⟨hgen y hy f, ?_⟩
    rintro ⟨N', s, a, hs, ha, heq⟩
    have hsi (i : Fin N') : MultiplierIntegrableAt u c (s i) y volume := by
      obtain ⟨j, hj⟩ := hs i
      rw [← hj]
      exact hgi j y hy
    have hsum := MultiplierIdealBergmanNadelManifold.multiplierIntegrableAt_sum_mul
      hc (hp y (hball hy)).quasiPlurisubharmonicAt ha hsi
    exact hsum.congr (EventuallyEq.refl _ _) heq.symm

/-- Source Nadel coherence is local in every actual chart, even when the
original components have different complex dimensions. All nearby stalks
share one produced finite holomorphic generating family. -/
theorem VariableComplexAtlas.IsPSH.exists_multiplierIdeal_ball_generators
    {X : Type*} [TopologicalSpace X] {A : VariableComplexAtlas X}
    {u : X → EReal} (hu : A.IsPSH u) (i : A.Index)
    {x : X} (hx : x ∈ (A.chart i).source) {c : ℝ} (hc : 0 < c) :
    ∃ r > 0, ∃ (N : ℕ) (g : Fin N → ComplexModel (A.dimension i) → ℂ),
      ball (A.chart i x) r ⊆ (A.chart i).target ∧
      (∀ j, DifferentiableOn ℂ (g j) (ball (A.chart i x) r)) ∧
      (∀ j, ∀ y ∈ ball (A.chart i x) r,
        MultiplierIntegrableAt (A.coordinate u i) c (g j) y volume) ∧
      ∀ y ∈ ball (A.chart i x) r, ∀ f : ComplexModel (A.dimension i) → ℂ,
        MultiplierIntegrableAt (A.coordinate u i) c f y volume ↔
          InGermSpan (range g) y f := by
  have hz := (A.chart i).map_source hx
  have hp : PSHOn (A.coordinate u i) (A.chart i).target :=
    ⟨(hu.chartPlurisubharmonic i).discPshOn,
      LocallyNondegenerate.exists_coordinate_ne_bot hu.locallyNondegenerate
        (A.chart i) (A.chart i).open_target subset_rfl hz⟩
  exact SGPT.PSH.exists_multiplierIdeal_ball_generators (A.chart i).open_target hp hz hc

end SGPT.PSH
