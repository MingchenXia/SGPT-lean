import SGPT.PSH.Manifold

/-!
# Multiplier ideals of pullbacks by smooth morphisms (`prop:pull-backmis`)

Source: `prop:pull-backmis` of the chapter *Plurisubharmonic functions*: for a smooth morphism
`π : Y → X` of complex manifolds and `φ ∈ PSH(X)`, `𝓘(π^*φ) = π^*𝓘(φ)`. Here `π^*𝓘` is the ideal
of `𝒪_Y` generated by the pullbacks of the germs of `𝓘` (`GermIdeal.pullback`; the book's footnote:
the image of `π^*𝓘 → 𝒪_Y`). The book reduces to an étale morphism (a local biholomorphism) and to a
projection `X × U → X`, `U ⊆ ℂⁿ` a domain, where `⊇` follows from Fubini's theorem and `⊆` is
Demailly, *Analytic methods*, Prop. 14.3.

## Main results

* `multiplierIdeal_comp_firstCoords_iff` — **the projection case in coordinates**: for the
  projection `firstCoords : ℂ^{m+b} → ℂ^m`, a weight `ψ` psh near `firstCoords p` and `c > 0`,
  `𝓘(cψ ∘ firstCoords)_p = (firstCoords^* 𝓘(cψ))_p`.
* `exists_normalForm` — a smooth morphism (`IsSmoothMorphism`: holomorphic with surjective
  differential) is, in the preferred charts, `firstCoords ∘ Θ` for a local biholomorphism `Θ`.
* `multiplierIdeal_comp_iff_mem_pullback`, `prop_pull_backmis` — **`prop:pull-backmis`**.

## Proof of the projection case

By induction on `b` it suffices to drop the last coordinate (`initCoords`).
* `⊇` (Fubini): `∫_{Δ × D} |a(x)|² e^{-cψ(x)} = vol(D) ∫_Δ |a|² e^{-cψ}` in the splitting
  `ℂ^{m+1} ≅ ℂ^m × ℂ` (`lintegral_polydiscN_comp_initCoords_lt_top`), and multiplier ideals are
  closed under holomorphic combinations.
* `⊆`: instead of Demailly's Hilbert-space argument we use the slice closure lemma of Hiep's proof
  of strong openness: for `f ∈ 𝓘(cψ ∘ pr)_p`, Fubini gives slices `z_last = p_last + t_k`,
  `t_k → 0`, `t_k ≠ 0`, on which `f(·, p_last + t_k) ∈ 𝓘(cψ)` (`exists_good_slice`); its pullback
  `F_k ∈ pr^*𝓘(cψ)` agrees with `f` on the slice and `|t_k| |F_k| ≤ |t_k| sup |f| → 0`.
  `germIdeal_mem_of_slice_extensions` (Krull's intersection theorem for germ ideals, proved in TN)
  then puts `f` in the ideal `pr^*𝓘(cψ)`.

The general case transports both ideals through the charts and `Θ`
(`LocalHolomorphicMultiplierGermCovariance.multiplierIntegrableAt_comp_inv_iff`, `isInSpanAt_comp`).
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory Metric
open scoped Topology Manifold ContDiff ENNReal

namespace SGPT.PSH.MultiplierPullback

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending

/-! ### Generalities on the model spaces -/

section Model

variable {k : ℕ}

theorem holomorphicAt_model_iff {g : ComplexModel k → ℂ} {x : ComplexModel k} :
    HolomorphicAt k g x ↔ ∀ᶠ y in 𝓝 x, DifferentiableAt ℂ g y := by
  unfold HolomorphicAt
  simp only [mdifferentiableAt_iff_differentiableAt]

/-- On the model space the multiplier ideal is read in the identity chart. -/
theorem mem_multiplierIdeal_model_iff {c : ℝ} {ψ : ComplexModel k → EReal}
    {x : ComplexModel k} {g : ComplexModel k → ℂ} :
    (multiplierIdeal (n := k) c ψ).mem x g ↔
      HolomorphicAt k g x ∧ MultiplierIntegrableAt ψ c g x volume :=
  Iff.rfl

theorem exists_polydiscN_subset {U : Set (ComplexModel k)} (hU : IsOpen U)
    {x : ComplexModel k} (hx : x ∈ U) : ∃ r : ℝ, 0 < r ∧ polydiscN x r ⊆ U := by
  obtain ⟨R, hR, hball⟩ := Metric.isOpen_iff.mp hU x hx
  refine ⟨R / (Real.sqrt k + 1), by positivity, (polydiscN_subset_ball x (by positivity) ?_).trans
    hball⟩
  have h1 : 0 < Real.sqrt k + 1 := by positivity
  rw [mul_div_assoc', div_lt_iff₀ h1]
  nlinarith [Real.sqrt_nonneg (k : ℝ)]

theorem mem_polydiscN_self (x : ComplexModel k) {r : ℝ} (hr : 0 < r) : x ∈ polydiscN x r :=
  fun i => by simpa using hr

/-- Multiplier integrability is closed under holomorphic combinations of its members. -/
theorem multiplierIntegrableAt_of_eq_sum {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E] {μ : Measure E} {x₀ : E}
    {φ : E → EReal} (hφ : QuasiPlurisubharmonicAt φ x₀) {c : ℝ} (hc : 0 < c) {f : E → ℂ}
    {N : ℕ} {s a : Fin N → E → ℂ} (hs : ∀ i, MultiplierIntegrableAt φ c (s i) x₀ μ)
    (ha : ∀ i, ∀ᶠ y in 𝓝 x₀, DifferentiableAt ℂ (a i) y)
    (hf : f =ᶠ[𝓝 x₀] fun y => ∑ i, a i y * s i y) : MultiplierIntegrableAt φ c f x₀ μ := by
  have hsum : ∀ I : Finset (Fin N),
      MultiplierIntegrableAt φ c (fun y => ∑ i ∈ I, a i y * s i y) x₀ μ := by
    intro I
    induction I using Finset.induction_on with
    | empty =>
      have h0 : multiplierDensity φ c
          (fun y => ∑ i ∈ (∅ : Finset (Fin N)), a i y * s i y) = fun _ => 0 := by
        funext y
        simp [multiplierDensity]
      refine ⟨hc, univ, isOpen_univ, mem_univ _, ?_, ?_, ?_⟩
      · simp only [Finset.sum_empty]
        exact differentiableOn_const 0
      · rw [h0]
        exact aemeasurable_const
      · rw [h0]
        simp
    | insert i I hi ih =>
      have h1 := multiplierIntegrableAt_differentiable_mul (hs i) (ha i)
      have h2 := multiplierIntegrableAt_add hφ h1 ih
      simpa only [Finset.sum_insert hi] using h2
  refine (hsum Finset.univ).congr (EventuallyEq.refl _ _) ?_
  exact hf.symm

end Model

/-! ### Dropping the last coordinate -/

section Last

variable {m : ℕ}

/-- `initCoords` is a continuous linear map. -/
def initCoordsCLM (m : ℕ) : ComplexModel (m + 1) →L[ℂ] ComplexModel m :=
  (ContinuousLinearMap.fst ℂ (ComplexModel m) ℂ).comp (splitCLE m).toContinuousLinearMap

@[simp] theorem initCoordsCLM_apply (x : ComplexModel (m + 1)) :
    initCoordsCLM m x = initCoords x := rfl

theorem differentiable_initCoords : Differentiable ℂ (initCoords (m := m)) :=
  (initCoordsCLM m).differentiable

theorem continuous_initCoords : Continuous (initCoords (m := m)) :=
  (initCoordsCLM m).continuous

theorem initCoords_mem_polydiscN {p x : ComplexModel (m + 1)} {r : ℝ}
    (hx : x ∈ polydiscN p r) : initCoords x ∈ polydiscN (initCoords p) r :=
  fun i => by simpa using hx i.castSucc

/-- **Fubini.** If `g` has finite integral over the polydisc `Δ(x₀, r)` of `ℂ^m`, then
`g ∘ initCoords` has finite integral over the polydisc `Δ(p, r)` of `ℂ^{m+1}`
(`initCoords p = x₀`). -/
theorem lintegral_polydiscN_comp_initCoords_lt_top (p : ComplexModel (m + 1)) (r : ℝ)
    {g : ComplexModel m → ℝ≥0∞}
    (hg : AEMeasurable g (volume.restrict (polydiscN (initCoords p) r)))
    (hfin : ∫⁻ w in polydiscN (initCoords p) r, g w ≠ ⊤) :
    ∫⁻ x in polydiscN p r, g (initCoords x) ≠ ⊤ := by
  set e : ComplexModel (m + 1) ≃ᵐ ComplexModel m × ℂ :=
    (splitCLE m).toHomeomorph.toMeasurableEquiv with he
  set T : Set (ComplexModel m × ℂ) := polydiscN (initCoords p) r ×ˢ ball (p (Fin.last m)) r
  have hpre : e ⁻¹' T = polydiscN p r := splitCLE_preimage_polydiscN p r
  set μ' : Measure (ComplexModel m × ℂ) := volume.map e with hμ'
  have : μ'.IsAddHaarMeasure := (splitCLE m).isAddHaarMeasure_map volume
  set k := μ'.addHaarScalarFactor (volume.prod volume) with hk
  have hsmul : μ' = k • (volume.prod volume) :=
    Measure.isAddLeftInvariant_eq_smul μ' (volume.prod volume)
  have hrestr : μ'.restrict T = (volume.restrict (polydiscN p r)).map e := by
    rw [hμ', e.restrict_map, hpre]
  have hprodres : μ'.restrict T = (k : ℝ≥0∞) •
      ((volume.restrict (polydiscN (initCoords p) r)).prod
        (volume.restrict (ball (p (Fin.last m)) r))) := by
    rw [hsmul, Measure.restrict_smul, Measure.prod_restrict]
    rfl
  have hge : ∀ q, g (initCoords (e.symm q)) = g q.1 := fun q => by
    show g (initCoords (sliceMap m q.2 q.1)) = g q.1
    rw [initCoords_sliceMap]
  have hint : ∫⁻ q, g (initCoords (e.symm q)) ∂(μ'.restrict T) =
      ∫⁻ x in polydiscN p r, g (initCoords x) := by
    rw [hrestr, lintegral_map_equiv]
    simp
  rw [← hint, hprodres, lintegral_smul_measure]
  simp only [hge]
  have hprod : ∫⁻ q, g q.1 ∂((volume.restrict (polydiscN (initCoords p) r)).prod
      (volume.restrict (ball (p (Fin.last m)) r))) =
      (∫⁻ w in polydiscN (initCoords p) r, g w) * volume (ball (p (Fin.last m)) r) := by
    have := lintegral_prod_mul (μ := volume.restrict (polydiscN (initCoords p) r))
      (ν := volume.restrict (ball (p (Fin.last m)) r)) hg (aemeasurable_const (b := (1 : ℝ≥0∞)))
    simp only [mul_one, one_mul, lintegral_const, Measure.restrict_apply_univ] at this
    exact this
  rw [hprod, smul_eq_mul]
  exact ENNReal.mul_ne_top ENNReal.coe_ne_top
    (ENNReal.mul_ne_top hfin measure_ball_lt_top.ne)

variable {ψ : ComplexModel m → EReal} {W : Set (ComplexModel m)}

/-- **`⊇`, generators.** The pullback `a ∘ initCoords` of a germ of `𝓘(cψ)` at `initCoords p` is a
germ of `𝓘(cψ ∘ initCoords)` at `p`. -/
theorem multiplierIntegrableAt_comp_initCoords (hW : IsOpen W) (hψ : PlurisubharmonicOn ψ W)
    {p : ComplexModel (m + 1)} (hp : initCoords p ∈ W) {c : ℝ} {a : ComplexModel m → ℂ}
    (ha : MultiplierIntegrableAt ψ c a (initCoords p) volume) :
    MultiplierIntegrableAt (fun x => ψ (initCoords x)) c (fun x => a (initCoords x)) p volume := by
  obtain ⟨hc, U, hU, hpU, haU, hmeas, hfin⟩ := ha
  obtain ⟨r, hr, hrUW⟩ := exists_polydiscN_subset (hU.inter hW) ⟨hpU, hp⟩
  set Δ := polydiscN p r with hΔ
  have hΔopen : IsOpen Δ := isOpen_polydiscN p r
  have hmaps : MapsTo initCoords Δ (polydiscN (initCoords p) r) :=
    fun x hx => initCoords_mem_polydiscN hx
  refine ⟨hc, Δ, hΔopen, mem_polydiscN_self p hr, ?_, ?_, ?_⟩
  · exact (haU.mono fun w hw => (hrUW hw).1).comp differentiable_initCoords.differentiableOn
      hmaps
  · have husc : UpperSemicontinuousOn (fun x => ψ (initCoords x)) Δ :=
      ((hψ.comp_continuousLinearMap (initCoordsCLM m)).upperSemicontinuousOn).mono
        fun x hx => (hrUW (hmaps hx)).2
    have hcont : ContinuousOn (fun x => a (initCoords x)) Δ :=
      ((haU.mono fun w hw => (hrUW hw).1).comp differentiable_initCoords.differentiableOn
        hmaps).continuousOn
    exact RestrictionOhsawaTakegoshi.aemeasurable_multiplierDensity_of_upperSemicontinuousOn
      hΔopen husc hcont hc.ne'
  · have hsub : polydiscN (initCoords p) r ⊆ U := fun w hw => (hrUW hw).1
    have hmeas' : AEMeasurable (multiplierDensity ψ c a)
        (volume.restrict (polydiscN (initCoords p) r)) := hmeas.mono_measure
      (Measure.restrict_mono hsub le_rfl)
    have hfin' : ∫⁻ w in polydiscN (initCoords p) r, multiplierDensity ψ c a w ≠ ⊤ :=
      ne_top_of_le_ne_top hfin.ne (lintegral_mono_set hsub)
    exact lt_top_iff_ne_top.mpr
      (lintegral_polydiscN_comp_initCoords_lt_top p r hmeas' hfin')

/-- **`⊇`.** `(initCoords^* 𝓘(cψ))_p ⊆ 𝓘(cψ ∘ initCoords)_p`. -/
theorem multiplierIdeal_comp_initCoords_of_mem_pullback (hW : IsOpen W)
    (hψ : PlurisubharmonicOn ψ W) {p : ComplexModel (m + 1)} (hp : initCoords p ∈ W) {c : ℝ}
    (hc : 0 < c) {f : ComplexModel (m + 1) → ℂ}
    (hf : (GermIdeal.pullback (m := m + 1) initCoords (multiplierIdeal (n := m) c ψ)).mem p f) :
    (multiplierIdeal (n := m + 1) c (fun x => ψ (initCoords x))).mem p f := by
  obtain ⟨hfhol, N, s, a, hs, ha, hsum⟩ := hf
  refine ⟨hfhol, ?_⟩
  choose b hb hsb using hs
  have hsint : ∀ i, MultiplierIntegrableAt (fun x => ψ (initCoords x)) c (s i) p volume := by
    intro i
    rw [hsb i]
    exact multiplierIntegrableAt_comp_initCoords hW hψ hp (hb i).2
  have hq : QuasiPlurisubharmonicAt (fun x => ψ (initCoords x)) p :=
    ((hψ.comp_continuousLinearMap (initCoordsCLM m)) p hp).quasiPlurisubharmonicAt
  exact multiplierIntegrableAt_of_eq_sum hq hc hsint
    (fun i => holomorphicAt_model_iff.mp (ha i)) hsum

theorem mem_pullback_initCoords_iff {p : ComplexModel (m + 1)} {c : ℝ}
    {h : ComplexModel (m + 1) → ℂ} :
    (GermIdeal.pullback (m := m + 1) initCoords (multiplierIdeal (n := m) c ψ)).mem p h ↔
      IsInSpanAt (n := m + 1) (fun s => ∃ a, (multiplierIdeal (n := m) c ψ).mem (initCoords p) a ∧
        s = a ∘ initCoords) p h :=
  Iff.rfl

/-- The ideal `(initCoords^* 𝓘(cψ))_p` is an ideal of holomorphic germs at `p`. -/
theorem isHolomorphicGermIdeal_pullback {p : ComplexModel (m + 1)} (c : ℝ) :
    IsHolomorphicGermIdeal p
      (fun h => (GermIdeal.pullback (m := m + 1) initCoords
        (multiplierIdeal (n := m) c ψ)).mem p h) where
  zero_mem := ⟨holomorphicAt_const 0, 0, Fin.elim0, Fin.elim0, fun i => i.elim0,
    fun i => i.elim0, Eventually.of_forall fun _ => by simp⟩
  add_mem := fun h₁ h₂ => mem_pullback_initCoords_iff.mpr
    (RelativePrincipalizationSpan.IsInSpanAt.add (mem_pullback_initCoords_iff.mp h₁)
      (mem_pullback_initCoords_iff.mp h₂))
  mul_mem := fun ha h => mem_pullback_initCoords_iff.mpr
    (RelativePrincipalizationSpan.IsInSpanAt.mul_left (holomorphicAt_model_iff.mpr ha)
      (mem_pullback_initCoords_iff.mp h))
  holomorphic := fun {h} hh => by
    obtain ⟨V, hVsub, hV, hpV⟩ := _root_.mem_nhds_iff.mp (holomorphicAt_model_iff.mp hh.1)
    exact ⟨V, hV, hpV, fun z hz => (hVsub hz).differentiableWithinAt⟩
  congr := fun hh heq => mem_pullback_initCoords_iff.mpr
    (InvertibleIdealQuotient.IsInSpanAt.congr' (mem_pullback_initCoords_iff.mp hh) heq.symm)

/-- **`⊆`.** `𝓘(cψ ∘ initCoords)_p ⊆ (initCoords^* 𝓘(cψ))_p`, by Fubini on slices and the slice
closure lemma for germ ideals (Krull's intersection theorem). -/
theorem mem_pullback_of_multiplierIdeal_comp_initCoords (hW : IsOpen W)
    (hψ : PlurisubharmonicOn ψ W) {p : ComplexModel (m + 1)} (hp : initCoords p ∈ W) {c : ℝ}
    {f : ComplexModel (m + 1) → ℂ}
    (hf : (multiplierIdeal (n := m + 1) c (fun x => ψ (initCoords x))).mem p f) :
    (GermIdeal.pullback (m := m + 1) initCoords (multiplierIdeal (n := m) c ψ)).mem p f := by
  obtain ⟨-, hc, U, hU, hpU, hfU, hmeas, hfin⟩ := hf
  set x₀ := initCoords p with hx₀
  have hW' : IsOpen (initCoords ⁻¹' W) := hW.preimage continuous_initCoords
  obtain ⟨ρ, hρ, hρsub⟩ := exists_polydiscN_subset (hU.inter hW') ⟨hpU, hp⟩
  have hρU : polydiscN p ρ ⊆ U := fun x hx => (hρsub hx).1
  have hx₀W : polydiscN x₀ ρ ⊆ W := by
    intro w hw
    have h1 : sliceMap m (p (Fin.last m)) w ∈ polydiscN p ρ := by
      rw [← mem_preimage, sliceMap_preimage_polydiscN p (by simpa using hρ)]
      exact hw
    have := (hρsub h1).2
    simpa [mem_preimage, initCoords_sliceMap] using this
  set G : ComplexModel (m + 1) → ℝ≥0∞ := multiplierDensity (fun x => ψ (initCoords x)) c f
    with hG
  have hGmeas : AEMeasurable G (volume.restrict (polydiscN p ρ)) :=
    hmeas.mono_measure (Measure.restrict_mono hρU le_rfl)
  have hGfin : ∫⁻ x in polydiscN p ρ, G x ≠ ⊤ :=
    ne_top_of_le_ne_top hfin.ne (lintegral_mono_set hρU)
  obtain ⟨hpmeas, hpfin⟩ := aemeasurable_lintegral_sliceMap_prod p ρ hGmeas hGfin
  set s : ℝ := ρ / 4 with hs
  set s' : ℝ := ρ / 2 with hs'
  have hspos : 0 < s := by positivity
  have hss' : s < s' := by rw [hs, hs']; linarith
  have hs'ρ : s' < ρ := by rw [hs']; linarith
  -- the slices
  have hslices : ∀ k : ℕ, ∃ t : ℂ, t ≠ 0 ∧ ‖t‖ < min (1 / ((k : ℝ) + 1)) (s / 2) ∧
      ∫⁻ w in polydiscN x₀ ρ, G (sliceMap m (p (Fin.last m) + t) w) ≠ ⊤ := by
    intro k
    have hε : 0 < min (1 / ((k : ℝ) + 1)) (s / 2) := lt_min Nat.one_div_pos_of_nat (by positivity)
    obtain ⟨t, ht0, htε, -, hbound⟩ := exists_good_slice (μ := volume) (B := polydiscN x₀ ρ)
      (a := p (Fin.last m)) hρ hpmeas hpfin hε
    refine ⟨t, ht0, htε, ?_⟩
    have htpos : ENNReal.ofReal (‖t‖ ^ 2) ≠ 0 := by
      rw [ENNReal.ofReal_ne_zero_iff]
      have := norm_pos_iff.mpr ht0
      positivity
    intro htop
    rw [htop, ENNReal.mul_top htpos] at hbound
    exact ENNReal.ofReal_ne_top (top_le_iff.mp hbound)
  choose t ht0 htlt htfin using hslices
  have hts : ∀ k, ‖t k‖ < s / 2 := fun k => (htlt k).trans_le (min_le_right _ _)
  have htρ : ∀ k, ‖p (Fin.last m) + t k - p (Fin.last m)‖ < ρ := fun k => by
    rw [add_sub_cancel_left]
    exact (hts k).trans (by rw [hs]; linarith)
  have htlim : Tendsto t atTop (𝓝 0) := by
    refine tendsto_zero_iff_norm_tendsto_zero.mpr (squeeze_zero (fun _ => norm_nonneg _)
      (fun k => ((htlt k).trans_le (min_le_left _ _)).le) ?_)
    exact tendsto_one_div_add_atTop_nhds_zero_nat
  -- the slice functions and their pullbacks
  set fs : ℕ → ComplexModel m → ℂ := fun k w => f (sliceMap m (p (Fin.last m) + t k) w)
    with hfs
  have hmapsS : ∀ k, MapsTo (sliceMap m (p (Fin.last m) + t k)) (polydiscN x₀ ρ)
      (polydiscN p ρ) := fun k w hw => by
    rw [← mem_preimage, sliceMap_preimage_polydiscN p (htρ k)]
    exact hw
  have hfsdiff : ∀ k, DifferentiableOn ℂ (fs k) (polydiscN x₀ ρ) := fun k =>
    (hfU.mono hρU).comp (differentiable_sliceMap _).differentiableOn (hmapsS k)
  have hfsmem : ∀ k, (multiplierIdeal (n := m) c ψ).mem x₀ (fs k) := by
    intro k
    have hopen := isOpen_polydiscN x₀ ρ
    have hx₀mem := mem_polydiscN_self x₀ hρ
    refine ⟨holomorphicAt_model_iff.mpr ?_, hc, polydiscN x₀ ρ, hopen, hx₀mem, hfsdiff k,
      ?_, ?_⟩
    · filter_upwards [hopen.mem_nhds hx₀mem] with w hw
      exact (hfsdiff k).differentiableAt (hopen.mem_nhds hw)
    · exact RestrictionOhsawaTakegoshi.aemeasurable_multiplierDensity_of_upperSemicontinuousOn
        hopen (hψ.upperSemicontinuousOn.mono hx₀W) (hfsdiff k).continuousOn hc.ne'
    · have hdens : ∀ w, multiplierDensity ψ c (fs k) w =
          G (sliceMap m (p (Fin.last m) + t k) w) := fun w => by
        rw [hG]
        simp only [multiplierDensity]
        rw [initCoords_sliceMap]
      exact lt_of_eq_of_lt (lintegral_congr fun w => hdens w) (lt_top_iff_ne_top.mpr (htfin k))
  set F : ℕ → ComplexModel (m + 1) → ℂ := fun k x => fs k (initCoords x) with hF
  have hmapsI : MapsTo initCoords (openPolydisc p s') (polydiscN x₀ ρ) := fun x hx =>
    initCoords_mem_polydiscN (fun i => (hx i).trans hs'ρ)
  have hFdiff : ∀ k, DifferentiableOn ℂ (F k) (openPolydisc p s') := fun k =>
    (hfsdiff k).comp differentiable_initCoords.differentiableOn hmapsI
  have hFJ : ∀ k,
      (GermIdeal.pullback (m := m + 1) initCoords (multiplierIdeal (n := m) c ψ)).mem p (F k) := by
    intro k
    have hhol : HolomorphicAt (m + 1) (F k) p := by
      refine holomorphicAt_model_iff.mpr ?_
      have hopen := isOpen_openPolydisc p s'
      have hpmem : p ∈ openPolydisc p s' := fun i => by
        simpa using (show (0 : ℝ) < s' by positivity)
      filter_upwards [hopen.mem_nhds hpmem] with x hx
      exact (hFdiff k).differentiableAt (hopen.mem_nhds hx)
    show IsInSpanAt (n := m + 1) (fun s => ∃ a, (multiplierIdeal (n := m) c ψ).mem
      (initCoords p) a ∧ s = a ∘ initCoords) p (F k)
    exact InvertibleIdealQuotient.isInSpanAt_self ⟨fs k, hfsmem k, rfl⟩ hhol
  have hslice : ∀ k, ∀ z ∈ openPolydisc p s', z (Fin.last m) = p (Fin.last m) + t k →
      F k z = f z := by
    intro k z _ hz
    show f (sliceMap m (p (Fin.last m) + t k) (initCoords z)) = f z
    rw [← hz, sliceMap_initCoords]
  -- a bound for `f` on the closed polydisc
  have hcomp : IsCompact (closedPolydiscN p s) := isCompact_closedPolydiscN p hspos.le
  have hcl : closedPolydiscN p s ⊆ U := (closedPolydiscN_subset_polydiscN p
    (show s < ρ by rw [hs]; linarith)).trans hρU
  obtain ⟨M, hM⟩ := hcomp.exists_bound_of_continuousOn (hfU.continuousOn.mono hcl)
  have hbound : ∀ k θ, ‖t k‖ * ‖F k (torusPoint p s θ)‖ ≤ ‖t k‖ * max M 0 := by
    intro k θ
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    have hmem : sliceMap m (p (Fin.last m) + t k) (initCoords (torusPoint p s θ)) ∈
        closedPolydiscN p s := by
      intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · rw [sliceMap_last, add_sub_cancel_left]
        exact (hts k).le.trans (by linarith)
      · rw [sliceMap_castSucc, initCoords_apply, norm_torusPoint_sub p hspos.le]
    show ‖f (sliceMap m (p (Fin.last m) + t k) (initCoords (torusPoint p s θ)))‖ ≤ max M 0
    exact (hM _ hmem).trans (le_max_left _ _)
  have hδ : Tendsto (fun k => ‖t k‖ * max M 0) atTop (𝓝 0) := by
    simpa using (tendsto_norm_zero.comp htlim).mul_const (max M 0)
  have hfpoly : DifferentiableOn ℂ f (openPolydisc p s') :=
    hfU.mono fun x hx => hρU fun i => (hx i).trans hs'ρ
  exact germIdeal_mem_of_slice_extensions (germKrullIntersection m)
    (isHolomorphicGermIdeal_pullback c) hspos hss' hfpoly t ht0 hts htlim F hFJ hFdiff hslice
    _ hδ hbound

/-- **The projection case, one variable**: `𝓘(cψ ∘ initCoords)_p = (initCoords^* 𝓘(cψ))_p`. -/
theorem multiplierIdeal_comp_initCoords_iff (hW : IsOpen W) (hψ : PlurisubharmonicOn ψ W)
    {p : ComplexModel (m + 1)} (hp : initCoords p ∈ W) {c : ℝ} (hc : 0 < c)
    (f : ComplexModel (m + 1) → ℂ) :
    (multiplierIdeal (n := m + 1) c (fun x => ψ (initCoords x))).mem p f ↔
      (GermIdeal.pullback (m := m + 1) initCoords (multiplierIdeal (n := m) c ψ)).mem p f :=
  ⟨mem_pullback_of_multiplierIdeal_comp_initCoords hW hψ hp,
    multiplierIdeal_comp_initCoords_of_mem_pullback hW hψ hp hc⟩

end Last

/-! ### Composition of pullback ideals -/

section Comp

variable {a b d : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel a) X]
  [IsComplexManifold a X] {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel b) Y]
  [IsComplexManifold b Y] {Z : Type*} [TopologicalSpace Z] [ChartedSpace (ComplexModel d) Z]
  [IsComplexManifold d Z]

/-- **Pullback ideals compose**: `g^*(f^*𝔞) = (f ∘ g)^*𝔞` for holomorphic `f`, `g` and an ideal
`𝔞` whose members are holomorphic germs. -/
theorem mem_pullback_pullback_iff {f : Y → X} {g : Z → Y}
    (hf : ContMDiff 𝓘(ℂ, ComplexModel b) 𝓘(ℂ, ComplexModel a) ∞ f)
    (hg : ContMDiff 𝓘(ℂ, ComplexModel d) 𝓘(ℂ, ComplexModel b) ∞ g)
    {𝔞 : GermIdeal a X} (h𝔞 : ∀ x s, 𝔞.mem x s → HolomorphicAt a s x) (z : Z) (h : Z → ℂ) :
    (GermIdeal.pullback (m := d) g (GermIdeal.pullback (m := b) f 𝔞)).mem z h ↔
      (GermIdeal.pullback (m := d) (f ∘ g) 𝔞).mem z h := by
  have hcomp : ∀ {t : X → ℂ} {y : Y}, HolomorphicAt a t (f y) → HolomorphicAt b (t ∘ f) y :=
    fun ht => ht.comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt)
  have hcompg : ∀ {t : Y → ℂ} {w : Z}, HolomorphicAt b t (g w) → HolomorphicAt d (t ∘ g) w :=
    fun ht => ht.comp_contMDiff (Eventually.of_forall fun _ => hg.contMDiffAt)
  constructor
  · rintro ⟨hh, N, s, c, hs, hc, hsum⟩
    choose u hu hsu using hs
    -- each `s i = u i ∘ g` lies in the span of the `t ∘ f ∘ g`
    have hterm : ∀ i, IsInSpanAt (n := d) (fun r => ∃ t, 𝔞.mem (f (g z)) t ∧ r = t ∘ (f ∘ g))
        z (s i) := by
      intro i
      obtain ⟨-, K, v, e, hv, he, hvsum⟩ := hu i
      choose w hw hvw using hv
      have hpull : s i =ᶠ[𝓝 z] fun y => ∑ j, e j (g y) * w j (f (g y)) := by
        rw [hsu i]
        filter_upwards [hg.continuous.continuousAt.eventually hvsum] with y hy
        simp only [Function.comp_apply] at hy ⊢
        rw [hy]
        exact Finset.sum_congr rfl fun j _ => by rw [hvw j]; rfl
      refine InvertibleIdealQuotient.IsInSpanAt.congr'
        (RelativePrincipalizationSpan.IsInSpanAt.sum Finset.univ fun j _ =>
          isInSpanAt_of_eq_mul (s := w j ∘ (f ∘ g)) (a := e j ∘ g) ⟨w j, hw j, rfl⟩ ?_
            (hcompg (he j)) (EventuallyEq.refl _ _)) hpull.symm
      exact (hcompg (he j)).mul (hcompg (hcomp (h𝔞 _ _ (hw j))))
    have hfull := RelativePrincipalizationSpan.IsInSpanAt.sum Finset.univ fun i _ =>
      RelativePrincipalizationSpan.IsInSpanAt.mul_left (hc i) (hterm i)
    exact InvertibleIdealQuotient.IsInSpanAt.congr' hfull hsum.symm
  · rintro ⟨hh, N, s, c, hs, hc, hsum⟩
    choose t ht hst using hs
    refine ⟨hh, N, s, c, fun i => ⟨t i ∘ f, ?_, hst i⟩, hc, hsum⟩
    show IsInSpanAt (n := b) (fun r => ∃ a, 𝔞.mem (f (g z)) a ∧ r = a ∘ f) (g z) (t i ∘ f)
    exact InvertibleIdealQuotient.isInSpanAt_self ⟨t i, ht i, rfl⟩ (hcomp (h𝔞 _ _ (ht i)))

end Comp

/-! ### The projection onto the first coordinates -/

section First

variable {m : ℕ}

/-- The projection `ℂ^{m+b} → ℂ^m` onto the first `m` coordinates. -/
def firstCoords (m b : ℕ) (x : ComplexModel (m + b)) : ComplexModel m :=
  WithLp.toLp 2 fun i => x (Fin.castAdd b i)

@[simp] theorem firstCoords_apply {b : ℕ} (x : ComplexModel (m + b)) (i : Fin m) :
    firstCoords m b x i = x (Fin.castAdd b i) := rfl

theorem firstCoords_zero (x : ComplexModel (m + 0)) : firstCoords m 0 x = x := by
  ext i
  rfl

theorem firstCoords_succ (b : ℕ) (x : ComplexModel (m + (b + 1))) :
    firstCoords m (b + 1) x = firstCoords m b (initCoords x) := by
  ext i
  rfl

/-- `firstCoords` is a continuous linear map. -/
def firstCoordsCLM (m b : ℕ) : ComplexModel (m + b) →L[ℂ] ComplexModel m :=
  LinearMap.toContinuousLinearMap
    { toFun := firstCoords m b
      map_add' := fun x y => by ext i; simp
      map_smul' := fun c x => by ext i; simp }

@[simp] theorem firstCoordsCLM_apply {b : ℕ} (x : ComplexModel (m + b)) :
    firstCoordsCLM m b x = firstCoords m b x := rfl

theorem contMDiff_firstCoords (b : ℕ) :
    ContMDiff 𝓘(ℂ, ComplexModel (m + b)) 𝓘(ℂ, ComplexModel m) ∞ (firstCoords m b) :=
  (firstCoordsCLM m b).contDiff.contMDiff

theorem contMDiff_initCoords :
    ContMDiff 𝓘(ℂ, ComplexModel (m + 1)) 𝓘(ℂ, ComplexModel m) ∞ (initCoords (m := m)) :=
  (initCoordsCLM m).contDiff.contMDiff

variable {ψ : ComplexModel m → EReal} {W : Set (ComplexModel m)}

/-- Members of multiplier ideals are holomorphic germs. -/
theorem holomorphicAt_of_mem_multiplierIdeal {k : ℕ} {c : ℝ} {u : ComplexModel k → EReal}
    {x : ComplexModel k} {s : ComplexModel k → ℂ} (hs : (multiplierIdeal (n := k) c u).mem x s) :
    HolomorphicAt k s x :=
  hs.1

/-- The multiplier ideal of a quasi-psh weight is closed under holomorphic combinations: the
pullback along the identity is the ideal itself. -/
theorem mem_pullback_id_iff {k : ℕ} {u : ComplexModel k → EReal} {x : ComplexModel k}
    (hu : QuasiPlurisubharmonicAt u x) {c : ℝ} (hc : 0 < c) (h : ComplexModel k → ℂ) :
    (GermIdeal.pullback (m := k) (fun y => y) (multiplierIdeal (n := k) c u)).mem x h ↔
      (multiplierIdeal (n := k) c u).mem x h := by
  constructor
  · rintro ⟨hh, N, s, a, hs, ha, hsum⟩
    choose t ht hst using hs
    refine ⟨hh, multiplierIntegrableAt_of_eq_sum hu hc (s := s) (fun i => ?_)
      (fun i => holomorphicAt_model_iff.mp (ha i)) hsum⟩
    rw [hst i]
    exact (ht i).2
  · intro hh
    show IsInSpanAt (n := k) (fun s => ∃ a, (multiplierIdeal (n := k) c u).mem x a ∧
      s = a ∘ fun y => y) x h
    exact InvertibleIdealQuotient.isInSpanAt_self ⟨h, hh, rfl⟩ hh.1

/-- **The projection case of `prop:pull-backmis`, in coordinates.** For the projection
`firstCoords : ℂ^{m+b} → ℂ^m`, a weight `ψ` psh on an open `W ∋ firstCoords p` and `c > 0`:
`𝓘(cψ ∘ firstCoords)_p = (firstCoords^* 𝓘(cψ))_p`. -/
theorem multiplierIdeal_comp_firstCoords_iff (hW : IsOpen W) (hψ : PlurisubharmonicOn ψ W)
    {c : ℝ} (hc : 0 < c) :
    ∀ (b : ℕ) {p : ComplexModel (m + b)}, firstCoords m b p ∈ W → ∀ f : ComplexModel (m + b) → ℂ,
      ((multiplierIdeal (n := m + b) c (fun x => ψ (firstCoords m b x))).mem p f ↔
        (GermIdeal.pullback (m := m + b) (firstCoords m b)
          (multiplierIdeal (n := m) c ψ)).mem p f)
  | 0, p, hp, f => by
    have hid : (firstCoords m 0 : ComplexModel (m + 0) → ComplexModel m) = fun y => y :=
      funext firstCoords_zero
    rw [hid]
    have hp' : p ∈ W := by rwa [hid] at hp
    exact (mem_pullback_id_iff ((hψ p hp').quasiPlurisubharmonicAt) hc f).symm
  | b + 1, p, hp, f => by
    have hWb : IsOpen (firstCoords m b ⁻¹' W) :=
      hW.preimage (firstCoordsCLM m b).continuous
    have hψb : PlurisubharmonicOn (fun y => ψ (firstCoords m b y)) (firstCoords m b ⁻¹' W) :=
      hψ.comp_continuousLinearMap (firstCoordsCLM m b)
    have hpb : initCoords p ∈ firstCoords m b ⁻¹' W := by
      rw [mem_preimage, ← firstCoords_succ]
      exact hp
    have step1 := multiplierIdeal_comp_initCoords_iff hWb hψb hpb hc f
    -- the inner pullback ideal at `initCoords p` is the multiplier ideal there
    have hinner : ∀ a, (multiplierIdeal (n := m + b) c (fun y => ψ (firstCoords m b y))).mem
        (initCoords p) a ↔
        (GermIdeal.pullback (m := m + b) (firstCoords m b)
          (multiplierIdeal (n := m) c ψ)).mem (initCoords p) a :=
      multiplierIdeal_comp_firstCoords_iff hW hψ hc b hpb
    have step2 : (GermIdeal.pullback (m := m + b + 1) initCoords
        (multiplierIdeal (n := m + b) c (fun y => ψ (firstCoords m b y)))).mem p f ↔
        (GermIdeal.pullback (m := m + b + 1) initCoords (GermIdeal.pullback (m := m + b)
          (firstCoords m b) (multiplierIdeal (n := m) c ψ))).mem p f := by
      simp only [GermIdeal.pullback]
      constructor
      · exact fun h => IsInSpanAt.mono
          (fun s ⟨a, ha, hsa⟩ => ⟨a, (hinner a).mp ha, hsa⟩) h
      · exact fun h => IsInSpanAt.mono
          (fun s ⟨a, ha, hsa⟩ => ⟨a, (hinner a).mpr ha, hsa⟩) h
    have step3 := mem_pullback_pullback_iff (contMDiff_firstCoords b) contMDiff_initCoords
      (𝔞 := multiplierIdeal (n := m) c ψ)
      (fun x s hs => holomorphicAt_of_mem_multiplierIdeal hs) p f
    exact step1.trans (step2.trans step3)

end First

/-! ### Transport of spans along holomorphic maps -/

section Transport

variable {a b : ℕ} {A : Type*} [TopologicalSpace A] [ChartedSpace (ComplexModel a) A]
  [IsComplexManifold a A] {B : Type*} [TopologicalSpace B] [ChartedSpace (ComplexModel b) B]
  [IsComplexManifold b B]

/-- Span membership is transported along a holomorphic map, generators being transported by a
rule `S → T` up to germs. -/
theorem isInSpanAt_comp {h : A → B} {x : A} {y : B} (hxy : h x = y)
    (hh : ∀ᶠ w in 𝓝 x, ContMDiffAt 𝓘(ℂ, ComplexModel a) 𝓘(ℂ, ComplexModel b) ∞ h w)
    {S : (B → ℂ) → Prop} {T : (A → ℂ) → Prop}
    (hST : ∀ s, S s → ∃ t, T t ∧ (fun w => s (h w)) =ᶠ[𝓝 x] t)
    {G : B → ℂ} (hG : IsInSpanAt (n := b) S y G) :
    IsInSpanAt (n := a) T x (fun w => G (h w)) := by
  subst hxy
  obtain ⟨hGhol, N, s, c, hs, hc, hsum⟩ := hG
  choose t ht hst using fun i => hST (s i) (hs i)
  have hcont : ContinuousAt h x := hh.self_of_nhds.continuousAt
  refine ⟨hGhol.comp_contMDiff hh, N, t, fun i w => c i (h w), ht,
    fun i => (hc i).comp_contMDiff hh, ?_⟩
  filter_upwards [hcont.eventually hsum, eventually_all.mpr hst] with w hw hwt
  rw [hw]
  exact Finset.sum_congr rfl fun i _ => by rw [← hwt i]

end Transport

/-! ### Smooth morphisms -/

section Smooth

variable {m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel m) X]
  [IsComplexManifold m X]

/-- `firstCoords` is the first component of the splitting `ℂ^{m+b} ≅ ℂ^m × ℂ^b`. -/
theorem firstCoords_eq_fst {b : ℕ} (x : ComplexModel (m + b)) :
    firstCoords m b x = (EuclideanSpace.finAddEquivProd x).1 := by
  ext i
  simp [firstCoords, EuclideanSpace.finAddEquivProd]

theorem firstCoords_finAddEquivProd_symm {b : ℕ} (q : ComplexModel m × ComplexModel b) :
    firstCoords m b (EuclideanSpace.finAddEquivProd.symm q) = q.1 := by
  rw [firstCoords_eq_fst, ContinuousLinearEquiv.apply_symm_apply]

variable {N : ℕ} {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel N) Y]
  [IsComplexManifold N Y]

/-- A **smooth morphism** of complex manifolds: a holomorphic map whose differential is
surjective at every point (a holomorphic submersion). -/
def IsSmoothMorphism (π : Y → X) : Prop :=
  ContMDiff 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ComplexModel m) ∞ π ∧
    ∀ y, Function.Surjective (mfderiv 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ComplexModel m) π y)

/-- The derivative of the coordinate expression of a smooth morphism in the preferred charts is
surjective. -/
theorem surjective_fderiv_coordinateMap {π : Y → X} (hπ : IsSmoothMorphism (m := m) (N := N) π)
    (y : Y) :
    Function.Surjective (fderiv ℂ (HolomorphicMaps.coordinateMap π (complexChartAt (n := N) y)
      (complexChartAt (n := m) (π y))) ((complexChartAt (n := N) y).val y)) := by
  have hz : (complexChartAt (n := N) y).val y ∈ HolomorphicMaps.coordinateDomain π
      (complexChartAt (n := N) y) (complexChartAt (n := m) (π y)) :=
    HolomorphicMaps.mem_coordinateDomain (mem_complexChartAt_source y)
      (mem_complexChartAt_source (π y))
  have hd : DifferentiableAt ℂ (HolomorphicMaps.coordinateMap π (complexChartAt (n := N) y)
      (complexChartAt (n := m) (π y))) ((complexChartAt (n := N) y).val y) :=
    (HolomorphicMaps.coordinateMap_contDiffAt hπ.1 _ _ hz).differentiableAt (by simp)
  intro v
  obtain ⟨w, hw⟩ := hπ.2 y v
  refine ⟨w, ?_⟩
  have h1 := BlowupFibreDirection.fderiv_coordinateMap_eq_mfderiv hπ.1 y w
  have h2 : (fderiv ℝ (HolomorphicMaps.coordinateMap π (complexChartAt (n := N) y)
      (complexChartAt (n := m) (π y))) ((complexChartAt (n := N) y).val y)) w =
      (fderiv ℂ (HolomorphicMaps.coordinateMap π (complexChartAt (n := N) y)
      (complexChartAt (n := m) (π y))) ((complexChartAt (n := N) y).val y)) w := by
    rw [hd.fderiv_restrictScalars ℝ]
    rfl
  rw [← h2]
  exact h1.trans hw

/-- The fibre dimension: the source of a smooth morphism has at least the dimension of the
target. -/
theorem le_of_isSmoothMorphism {π : Y → X} (hπ : IsSmoothMorphism (m := m) (N := N) π) (y : Y) :
    m ≤ N := by
  set D := fderiv ℂ (HolomorphicMaps.coordinateMap π (complexChartAt (n := N) y)
      (complexChartAt (n := m) (π y))) ((complexChartAt (n := N) y).val y)
  have hsurj := surjective_fderiv_coordinateMap hπ y
  have h1 := LinearMap.finrank_range_add_finrank_ker (D : ComplexModel N →ₗ[ℂ] ComplexModel m)
  have h2 : LinearMap.range (D : ComplexModel N →ₗ[ℂ] ComplexModel m) = ⊤ :=
    LinearMap.range_eq_top.mpr hsurj
  rw [h2, finrank_top] at h1
  simp only [finrank_euclideanSpace_fin] at h1
  omega

end Smooth

section NormalForm

variable {m b : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel m) X]
  [IsComplexManifold m X] {Y : Type*} [TopologicalSpace Y]
  [ChartedSpace (ComplexModel (m + b)) Y] [IsComplexManifold (m + b) Y]

/-- **Local normal form of a smooth morphism.** In the preferred charts at `y` and `π y`, the
coordinate expression `F` of `π` is `firstCoords ∘ Θ` for a local biholomorphism `Θ` of
`ℂ^{m+b}` near `e_Y(y)` (with source inside the coordinate domain). -/
theorem exists_normalForm {π : Y → X} (hπ : IsSmoothMorphism (m := m) (N := m + b) π) (y : Y) :
    ∃ Θ : LocalHolomorphicEquivAt (n := m + b) ((complexChartAt (n := m + b) y).val y),
      Θ.source ⊆ HolomorphicMaps.coordinateDomain π (complexChartAt (n := m + b) y)
        (complexChartAt (n := m) (π y)) ∧
      ∀ z ∈ Θ.source, firstCoords m b (Θ.toFun z) =
        HolomorphicMaps.coordinateMap π (complexChartAt (n := m + b) y)
          (complexChartAt (n := m) (π y)) z := by
  set eY := complexChartAt (n := m + b) y
  set eX := complexChartAt (n := m) (π y)
  set Dom := HolomorphicMaps.coordinateDomain π eY eX with hDom
  set F := HolomorphicMaps.coordinateMap π eY eX with hF
  set z₀ := eY.val y with hz₀
  have hDomopen : IsOpen Dom := HolomorphicMaps.coordinateDomain_isOpen hπ.1 eY eX
  have hz₀Dom : z₀ ∈ Dom := HolomorphicMaps.mem_coordinateDomain (mem_complexChartAt_source y)
    (mem_complexChartAt_source (π y))
  have hFdiff : DifferentiableOn ℂ F Dom := fun z hz =>
    ((HolomorphicMaps.coordinateMap_contDiffAt hπ.1 eY eX hz).differentiableAt
      (by simp)).differentiableWithinAt
  have hFz₀ : DifferentiableAt ℂ F z₀ := hFdiff.differentiableAt (hDomopen.mem_nhds hz₀Dom)
  set D := fderiv ℂ F z₀ with hD
  have hsurj : Function.Surjective D := surjective_fderiv_coordinateMap hπ y
  -- a linear map injective on the kernel of `D`
  set K := LinearMap.ker (D : ComplexModel (m + b) →ₗ[ℂ] ComplexModel m) with hK
  have hKdim : Module.finrank ℂ K = b := by
    have h1 : Module.finrank ℂ (LinearMap.range (D : ComplexModel (m + b) →ₗ[ℂ] ComplexModel m)) +
        Module.finrank ℂ K = Module.finrank ℂ (ComplexModel (m + b)) :=
      LinearMap.finrank_range_add_finrank_ker _
    have h2 : LinearMap.range (D : ComplexModel (m + b) →ₗ[ℂ] ComplexModel m) = ⊤ :=
      LinearMap.range_eq_top.mpr hsurj
    rw [h2, finrank_top] at h1
    simp only [finrank_euclideanSpace_fin] at h1
    omega
  obtain ⟨g₀, hg₀⟩ := LinearMap.exists_leftInverse_of_injective K.subtype K.ker_subtype
  set eK : K ≃ₗ[ℂ] ComplexModel b := LinearEquiv.ofFinrankEq K (ComplexModel b)
    (by rw [hKdim, finrank_euclideanSpace_fin])
  set L : ComplexModel (m + b) →L[ℂ] ComplexModel b :=
    LinearMap.toContinuousLinearMap (eK.toLinearMap ∘ₗ g₀) with hL
  set P := EuclideanSpace.finAddEquivProd (𝕜 := ℂ) (n := m) (m := b) with hP
  set Φ : ComplexModel (m + b) → ComplexModel (m + b) := fun z => P.symm (F z, L (z - z₀))
    with hΦ
  have hΦdiff : DifferentiableOn ℂ Φ Dom := by
    intro z hz
    refine (P.symm.differentiable.differentiableAt.comp z ?_).differentiableWithinAt
    exact (hFdiff.differentiableAt (hDomopen.mem_nhds hz)).prodMk
      (L.differentiable.differentiableAt.comp z (differentiableAt_id.sub_const z₀))
  have hΦder : HasFDerivAt Φ ((P.symm : ComplexModel m × ComplexModel b →L[ℂ]
      ComplexModel (m + b)).comp (D.prod L)) z₀ := by
    have hL' : HasFDerivAt (fun z => L (z - z₀)) L z₀ := by
      have := L.hasFDerivAt.comp z₀ ((hasFDerivAt_id z₀).sub_const z₀)
      rw [ContinuousLinearMap.comp_id] at this
      exact this
    exact P.symm.hasFDerivAt.comp z₀ (hFz₀.hasFDerivAt.prodMk hL')
  have hinj : Function.Injective (fderiv ℂ Φ z₀) := by
    rw [hΦder.fderiv]
    refine (injective_iff_map_eq_zero _).mpr fun v hv => ?_
    have hv' : (D.prod L) v = 0 := by
      have h := congrArg P hv
      simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
        ContinuousLinearEquiv.coe_coe, ContinuousLinearEquiv.apply_symm_apply, map_zero] at h
      exact h
    have hDv : D v = 0 := congrArg Prod.fst hv'
    have hLv : L v = 0 := congrArg Prod.snd hv'
    have hvK : v ∈ K := hDv
    have h1 : g₀ v = ⟨v, hvK⟩ := by
      have := congrArg (fun ψ => ψ ⟨v, hvK⟩) hg₀
      simpa using this
    have h2 : eK (g₀ v) = 0 := hLv
    rw [h1, LinearEquiv.map_eq_zero_iff] at h2
    exact congrArg Subtype.val h2
  obtain ⟨Θ, hΘsrc, hΘfun, -⟩ := exists_localHolomorphicEquivAt hDomopen hz₀Dom hΦdiff hinj
  refine ⟨Θ, hΘsrc, fun z _ => ?_⟩
  rw [hΘfun]
  exact firstCoords_finAddEquivProd_symm _

end NormalForm

/-! ### `prop:pull-backmis` -/

section Main

variable {m : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel m) X]
  [IsComplexManifold m X]

/-- `prop:pull-backmis` when the fibre dimension is explicit (`dim Y = m + b`). -/
theorem multiplierIdeal_comp_iff_mem_pullback_of_add {b : ℕ} {Y : Type*} [TopologicalSpace Y]
    [ChartedSpace (ComplexModel (m + b)) Y] [IsComplexManifold (m + b) Y] {π : Y → X}
    (hπ : IsSmoothMorphism (m := m) (N := m + b) π) {φ : X → EReal}
    (hφ : ManifoldPSH (n := m) φ) {c : ℝ} (hc : 0 < c) (y : Y) (g : Y → ℂ) :
    (multiplierIdeal (n := m + b) c (fun w => φ (π w))).mem y g ↔
      (GermIdeal.pullback (m := m + b) π (multiplierIdeal (n := m) c φ)).mem y g := by
  set eY := complexChartAt (n := m + b) y with heY
  set eX := complexChartAt (n := m) (π y) with heX
  set z₀ := eY.val y with hz₀
  set ψ : ComplexModel m → EReal := chartFunction φ eX with hψ
  set Dom := HolomorphicMaps.coordinateDomain π eY eX with hDom
  obtain ⟨Θ, hΘsrc, hΘF⟩ := exists_normalForm hπ y
  set q₀ := Θ.toFun z₀ with hq₀
  have hyY : y ∈ eY.val.source := mem_complexChartAt_source y
  have hπyX : π y ∈ eX.val.source := mem_complexChartAt_source (π y)
  have hDomopen : IsOpen Dom := HolomorphicMaps.coordinateDomain_isOpen hπ.1 eY eX
  have hz₀Dom : z₀ ∈ Dom := HolomorphicMaps.mem_coordinateDomain hyY hπyX
  have hz₀src : z₀ ∈ Θ.source := Θ.center_mem_source
  have hq₀tgt : q₀ ∈ Θ.target := Θ.mapsTo_toFun hz₀src
  have hψpsh : PlurisubharmonicOn ψ eX.val.target := hφ.chartPlurisubharmonic eX
  -- the local inverse `λ` of `κ = Θ ∘ e_Y`
  set lam : ComplexModel (m + b) → Y := fun q => eY.val.symm (Θ.invFun q) with hlam
  set kap : Y → ComplexModel (m + b) := fun w => Θ.toFun (eY.val w) with hkap
  have hlamq₀ : lam q₀ = y := by
    show eY.val.symm (Θ.invFun (Θ.toFun z₀)) = y
    rw [Θ.left_inv z₀ hz₀src]
    exact eY.val.left_inv hyY
  have hf3 : ∀ q ∈ Θ.target, π (lam q) ∈ eX.val.source ∧
      firstCoords m b q = eX.val (π (lam q)) := by
    intro q hq
    have hs := Θ.mapsTo_invFun hq
    have hD := hΘsrc hs
    refine ⟨hD.2, ?_⟩
    have := hΘF _ hs
    rw [Θ.right_inv q hq] at this
    exact this
  have hi3 : ∀ q ∈ Θ.target, π (lam q) = eX.val.symm (firstCoords m b q) := by
    intro q hq
    rw [(hf3 q hq).2, eX.val.left_inv (hf3 q hq).1]
  have hfirst₀ : firstCoords m b q₀ = eX.val (π y) := by
    rw [(hf3 q₀ hq₀tgt).2, hlamq₀]
  set O := eY.val.source ∩ eY.val ⁻¹' Θ.source with hO
  have hOopen : IsOpen O := eY.val.isOpen_inter_preimage Θ.isOpen_source
  have hyO : y ∈ O := ⟨hyY, hz₀src⟩
  have hi1 : ∀ w ∈ O, lam (kap w) = w := by
    intro w hw
    simp only [hlam, hkap, Θ.left_inv _ hw.2, eY.val.left_inv hw.1]
  have hi2 : ∀ w ∈ O, firstCoords m b (kap w) = eX.val (π w) := by
    intro w hw
    rw [hΘF _ hw.2]
    exact HolomorphicMaps.coordinateMap_at hw.1
  -- holomorphy of `λ` and `κ`
  have hemax : eY.val ∈ IsManifold.maximalAtlas 𝓘(ℂ, ComplexModel (m + b)) ∞ Y :=
    IsManifold.subset_maximalAtlas eY.property
  have hlamC : ∀ᶠ q in 𝓝 q₀,
      ContMDiffAt 𝓘(ℂ, ComplexModel (m + b)) 𝓘(ℂ, ComplexModel (m + b)) ∞ lam q := by
    filter_upwards [Θ.isOpen_target.mem_nhds hq₀tgt] with q hq
    have h1 : ContDiffAt ℂ ∞ Θ.invFun q :=
      (contDiffOn_of_differentiableOn_complex Θ.invFun_holomorphic Θ.isOpen_target).contDiffAt
        (Θ.isOpen_target.mem_nhds hq)
    have h2 := contMDiffAt_symm_of_mem_maximalAtlas hemax (hΘsrc (Θ.mapsTo_invFun hq)).1
    exact h2.comp q h1.contMDiffAt
  have hkapC : ∀ᶠ w in 𝓝 y,
      ContMDiffAt 𝓘(ℂ, ComplexModel (m + b)) 𝓘(ℂ, ComplexModel (m + b)) ∞ kap w := by
    filter_upwards [hOopen.mem_nhds hyO] with w hw
    have h1 : ContDiffAt ℂ ∞ Θ.toFun (eY.val w) :=
      (contDiffOn_of_differentiableOn_complex Θ.toFun_holomorphic Θ.isOpen_source).contDiffAt
        (Θ.isOpen_source.mem_nhds hw.2)
    exact h1.contMDiffAt.comp w (contMDiffAt_of_mem_maximalAtlas hemax hw.1)
  -- the weight in the coordinates `q`
  have hFdiff : DifferentiableOn ℂ (HolomorphicMaps.coordinateMap π eY eX) Dom := fun z hz =>
    ((HolomorphicMaps.coordinateMap_contDiffAt hπ.1 eY eX hz).differentiableAt
      (by simp)).differentiableWithinAt
  have hw₀ : QuasiPlurisubharmonicAt (chartFunction (fun w => φ (π w)) eY) z₀ := by
    have hpsh := Pending.HolomorphicPullback.plurisubharmonicOn_comp_holomorphic hDomopen hFdiff
      (fun z hz => HolomorphicMaps.coordinateMap_mem_target hz) hψpsh
    refine (hpsh z₀ hz₀Dom).quasiPlurisubharmonicAt.congr ?_
    filter_upwards [hDomopen.mem_nhds hz₀Dom] with z hz
    simp only [hψ, chartFunction, HolomorphicMaps.coordinateMap, Function.comp_apply,
      eX.val.left_inv hz.2]
  have hweq : (fun q => chartFunction (fun w => φ (π w)) eY (Θ.invFun q)) =ᶠ[𝓝 q₀]
      fun q => ψ (firstCoords m b q) := by
    filter_upwards [Θ.isOpen_target.mem_nhds hq₀tgt] with q hq
    show φ (π (lam q)) = φ (eX.val.symm (firstCoords m b q))
    rw [hi3 q hq]
  have hMI : MultiplierIntegrableAt (chartFunction (fun w => φ (π w)) eY) c
        (fun z => g (eY.val.symm z)) z₀ volume ↔
      MultiplierIntegrableAt (fun q => ψ (firstCoords m b q)) c (fun q => g (lam q)) q₀ volume := by
    rw [← LocalHolomorphicMultiplierGermCovariance.multiplierIntegrableAt_comp_inv_iff Θ hw₀]
    exact ⟨fun h => h.congr hweq (EventuallyEq.refl _ _),
      fun h => h.congr hweq.symm (EventuallyEq.refl _ _)⟩
  -- the Euclidean projection case
  have hpW : firstCoords m b q₀ ∈ eX.val.target := by
    rw [hfirst₀]
    exact eX.val.map_source hπyX
  have hE := multiplierIdeal_comp_firstCoords_iff eX.val.open_target hψpsh hc b hpW
    (fun q => g (lam q))
  -- transport of the pullback ideals
  have hto : (GermIdeal.pullback (m := m + b) (firstCoords m b)
        (multiplierIdeal (n := m) c ψ)).mem q₀ (fun q => g (lam q)) →
      (GermIdeal.pullback (m := m + b) π (multiplierIdeal (n := m) c φ)).mem y g := by
    intro hP
    have h1 := isInSpanAt_comp (h := kap) (x := y) (y := q₀) rfl hkapC
      (S := fun s => ∃ a, (multiplierIdeal (n := m) c ψ).mem (firstCoords m b q₀) a ∧
        s = a ∘ firstCoords m b) (G := fun q => g (lam q))
      (T := fun t => ∃ a, (multiplierIdeal (n := m) c φ).mem (π y) a ∧ t = a ∘ π)
      (fun s ⟨a, ha, hsa⟩ => by
        refine ⟨(fun p => a (eX.val p)) ∘ π, ⟨fun p => a (eX.val p), ⟨?_, ?_⟩, rfl⟩, ?_⟩
        · rw [hfirst₀] at ha
          exact DerivativeIdeal.holomorphicAt_comp_chart eX hπyX
            (holomorphicAt_model_iff.mp ha.1)
        · rw [hfirst₀] at ha
          refine ha.2.congr (EventuallyEq.refl _ _) ?_
          filter_upwards [eX.val.open_target.mem_nhds (eX.val.map_source hπyX)] with z hz
          show a z = a (eX.val (eX.val.symm z))
          rw [eX.val.right_inv hz]
        · filter_upwards [hOopen.mem_nhds hyO] with w hw
          rw [hsa]
          show a (firstCoords m b (kap w)) = a (eX.val (π w))
          rw [hi2 w hw]) hP
    refine InvertibleIdealQuotient.IsInSpanAt.congr' h1 ?_
    filter_upwards [hOopen.mem_nhds hyO] with w hw
    show g (lam (kap w)) = g w
    rw [hi1 w hw]
  have hfrom : (GermIdeal.pullback (m := m + b) π (multiplierIdeal (n := m) c φ)).mem y g →
      (GermIdeal.pullback (m := m + b) (firstCoords m b)
        (multiplierIdeal (n := m) c ψ)).mem q₀ (fun q => g (lam q)) := by
    intro hY
    exact isInSpanAt_comp (h := lam) (x := q₀) (y := y) hlamq₀ hlamC
      (S := fun s => ∃ a, (multiplierIdeal (n := m) c φ).mem (π y) a ∧ s = a ∘ π) (G := g)
      (T := fun t => ∃ a, (multiplierIdeal (n := m) c ψ).mem (firstCoords m b q₀) a ∧
        t = a ∘ firstCoords m b)
      (fun s ⟨a, ha, hsa⟩ => by
        refine ⟨(fun z => a (eX.val.symm z)) ∘ firstCoords m b,
          ⟨fun z => a (eX.val.symm z), ⟨?_, ?_⟩, rfl⟩, ?_⟩
        · rw [hfirst₀]
          obtain ⟨-, U, hU, hzU, hdiff, -⟩ := ha.2
          refine holomorphicAt_model_iff.mpr ?_
          filter_upwards [hU.mem_nhds hzU] with z hz
          exact hdiff.differentiableAt (hU.mem_nhds hz)
        · rw [hfirst₀]
          exact ha.2
        · filter_upwards [Θ.isOpen_target.mem_nhds hq₀tgt] with q hq
          rw [hsa]
          show a (π (lam q)) = a (eX.val.symm (firstCoords m b q))
          rw [hi3 q hq]) hY
  constructor
  · rintro ⟨hg, hmi⟩
    have hgl : HolomorphicAt (m + b) (fun q => g (lam q)) q₀ := by
      have hg' : HolomorphicAt (m + b) g (lam q₀) := by rw [hlamq₀]; exact hg
      exact hg'.comp_contMDiff hlamC
    exact hto (hE.mp ⟨hgl, hMI.mp hmi⟩)
  · intro hY
    exact ⟨hY.1, hMI.mpr (hE.mpr (hfrom hY)).2⟩

variable {N : ℕ} {Y : Type*} [TopologicalSpace Y] [ChartedSpace (ComplexModel N) Y]
  [IsComplexManifold N Y]

/-- **`prop:pull-backmis`.** Let `π : Y → X` be a smooth morphism of complex manifolds (a
holomorphic submersion) and `φ ∈ PSH(X)`. Then `𝓘(c π^*φ) = π^*𝓘(cφ)` stalkwise for every
`c > 0`: a germ at `y` lies in the multiplier ideal of `φ ∘ π` if and only if it lies in the
ideal generated by the pullbacks of the germs of `𝓘(cφ)` at `π y`. -/
theorem multiplierIdeal_comp_iff_mem_pullback {π : Y → X}
    (hπ : IsSmoothMorphism (m := m) (N := N) π) {φ : X → EReal} (hφ : ManifoldPSH (n := m) φ)
    {c : ℝ} (hc : 0 < c) (y : Y) (g : Y → ℂ) :
    (multiplierIdeal (n := N) c (fun w => φ (π w))).mem y g ↔
      (GermIdeal.pullback (m := N) π (multiplierIdeal (n := m) c φ)).mem y g := by
  obtain ⟨b, rfl⟩ := Nat.exists_eq_add_of_le (le_of_isSmoothMorphism hπ y)
  exact multiplierIdeal_comp_iff_mem_pullback_of_add hπ hφ hc y g

/-- **`prop:pull-backmis`**, as an equality of ideal sheaves, in the book's normalization
`𝓘(φ) = 𝓘(1·φ)`: `𝓘(π^*φ) = π^*𝓘(φ)`. -/
theorem prop_pull_backmis {π : Y → X} (hπ : IsSmoothMorphism (m := m) (N := N) π)
    {φ : X → EReal} (hφ : ManifoldPSH (n := m) φ) :
    multiplierIdeal (n := N) 1 (fun w => φ (π w)) =
      GermIdeal.pullback (m := N) π (multiplierIdeal (n := m) 1 φ) :=
  GermIdeal.ext (funext fun y => funext fun g => propext
    (multiplierIdeal_comp_iff_mem_pullback hπ hφ one_pos y g))

end Main

end SGPT.PSH.MultiplierPullback
