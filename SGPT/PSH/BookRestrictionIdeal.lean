import SGPT.Okounkov.NativeHolomorphicGermRing

/-!
# The restriction of a coherent ideal sheaf to a closed subspace (`def:restidealsheaf`)

Source: `def:restidealsheaf` of the chapter *Plurisubharmonic functions*. Given a coherent ideal
sheaf `𝓘` on `X` and a closed complex subspace `Y ⊆ X` with defining ideal sheaf `𝓘_Y`, the
restriction `Rest_Y 𝓘` is the coherent ideal sheaf `𝓘/(𝓘 ∩ 𝓘_Y)` of `𝒪_Y = 𝒪_X/𝓘_Y`.

Ideal sheaves are the existing germ ideals (`GermIdeal`); a closed complex subspace is given by
its coherent defining ideal sheaf `𝓘_Y` (its support is the zero locus). Stalks are ideals of the
local rings `𝒪_{X,y}` (`SGPT.Okounkov.NativeHolGerm`), and `𝒪_{Y,y} = 𝒪_{X,y}/𝓘_{Y,y}`.

Main declarations:

* `SGPT.PSH.IdealRestriction.stalkIdeal` — the stalk of a germ ideal as an ideal of `𝒪_{X,x}`;
* `SGPT.PSH.IdealRestriction.ClosedComplexSubspace`, `…structureStalk` — `Y` and `𝒪_{Y,y}`;
* `SGPT.PSH.IdealRestriction.restStalk` — `(Rest_Y 𝓘)_y`, the image of `𝓘_y` in `𝒪_{Y,y}`;
* `SGPT.PSH.IdealRestriction.restStalkEquiv` — the book's formula `Rest_Y 𝓘 = 𝓘/(𝓘 ∩ 𝓘_Y)`:
  an `𝒪_{X,y}`-linear isomorphism `𝓘_y/(𝓘_y ∩ 𝓘_{Y,y}) ≃ (Rest_Y 𝓘)_y`;
* `SGPT.PSH.IdealRestriction.isCoherent_restStalk` — `Rest_Y 𝓘` is coherent: near every point it
  is generated by the images of finitely many holomorphic functions.
-/

set_option autoImplicit false

noncomputable section

open Set Filter
open scoped Topology Manifold

namespace SGPT.PSH.IdealRestriction

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves SGPT.Foundations.Analysis.Pending
open SGPT.Okounkov

universe u

variable {n : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-- The stalk at `x` of an ideal sheaf `𝔞`, as an ideal of `𝒪_{M,x}`: the ideal generated by the
germs of the members of `𝔞_x` (for a coherent `𝔞` these germs already form an ideal,
`stalkIdeal_eq_span`). -/
def stalkIdeal (𝔞 : GermIdeal n M) (x : M) : Ideal (NativeHolGerm n M x) :=
  Ideal.span {g | ∃ (f : M → ℂ) (hf : HolomorphicAt n f x), 𝔞.mem x f ∧ g = NativeHolGerm.mk f hf}

/-- A closed complex subspace `Y` of `M`, given by its coherent defining ideal sheaf `𝓘_Y`. -/
structure ClosedComplexSubspace (n : ℕ) (M : Type u) [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] where
  /-- The defining ideal sheaf `𝓘_Y`. -/
  ideal : GermIdeal n M
  coherent : ideal.IsCoherent

namespace ClosedComplexSubspace

/-- The underlying closed set of `Y`. -/
def support (Y : ClosedComplexSubspace n M) : Set M := Y.ideal.zeroLocus

/-- The local ring `𝒪_{Y,y} = 𝒪_{M,y}/𝓘_{Y,y}`. -/
abbrev structureStalk (Y : ClosedComplexSubspace n M) (y : M) :=
  NativeHolGerm n M y ⧸ stalkIdeal Y.ideal y

end ClosedComplexSubspace

open ClosedComplexSubspace

/-- `def:restidealsheaf`. The stalk at `y` of `Rest_Y 𝓘`: the image of `𝓘_y` in `𝒪_{Y,y}`. -/
def restStalk (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M) :
    Ideal (Y.structureStalk y) :=
  Ideal.map (Ideal.Quotient.mk (stalkIdeal Y.ideal y)) (stalkIdeal I y)

/-- The `𝒪_{M,y}`-linear map `𝓘_y → 𝒪_{Y,y}`. -/
def restMap (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M) :
    stalkIdeal I y →ₗ[NativeHolGerm n M y] Y.structureStalk y :=
  (Ideal.Quotient.mkₐ (NativeHolGerm n M y) (stalkIdeal Y.ideal y)).toLinearMap ∘ₗ
    (stalkIdeal I y).subtype

theorem ker_restMap (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M) :
    LinearMap.ker (restMap I Y y) =
      Submodule.comap (stalkIdeal I y).subtype (stalkIdeal Y.ideal y) := by
  ext g
  simp [restMap, Ideal.Quotient.eq_zero_iff_mem]

theorem range_restMap (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M) :
    LinearMap.range (restMap I Y y) =
      (restStalk I Y y).restrictScalars (NativeHolGerm n M y) := by
  ext g
  simp only [LinearMap.mem_range, Submodule.restrictScalars_mem, restStalk]
  rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
  constructor
  · rintro ⟨⟨a, ha⟩, rfl⟩
    exact ⟨a, ha, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨⟨a, ha⟩, rfl⟩

/-- `def:restidealsheaf`, the book's formula `Rest_Y 𝓘 = 𝓘/(𝓘 ∩ 𝓘_Y)`: at every point,
`𝓘_y/(𝓘_y ∩ 𝓘_{Y,y})` is `𝒪_{M,y}`-linearly isomorphic to the ideal `(Rest_Y 𝓘)_y` of `𝒪_{Y,y}`. -/
def restStalkEquiv (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M) :
    (stalkIdeal I y ⧸ Submodule.comap (stalkIdeal I y).subtype (stalkIdeal Y.ideal y)) ≃ₗ[NativeHolGerm n M y]
      (restStalk I Y y).restrictScalars (NativeHolGerm n M y) :=
  (Submodule.quotEquivOfEq _ _ (ker_restMap I Y y).symm).trans
    ((restMap I Y y).quotKerEquivRange.trans (LinearEquiv.ofEq _ _ (range_restMap I Y y)))

theorem restStalkEquiv_mk (I : GermIdeal n M) (Y : ClosedComplexSubspace n M) (y : M)
    (a : stalkIdeal I y) :
    (restStalkEquiv I Y y (Submodule.Quotient.mk a) : Y.structureStalk y) =
      Ideal.Quotient.mk (stalkIdeal Y.ideal y) a := rfl

/-! ### Coherence -/

theorem holomorphicAt_of_mdifferentiableOn {U : Set M} (hU : IsOpen U) {s : M → ℂ}
    (hs : MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) s U) {z : M} (hz : z ∈ U) :
    HolomorphicAt n s z := by
  filter_upwards [hU.mem_nhds hz] with w hw
  exact (hs w hw).mdifferentiableAt (hU.mem_nhds hw)

theorem mk_sum_mul {x : M} {N : ℕ} (a s : Fin N → M → ℂ) (ha : ∀ i, HolomorphicAt n (a i) x)
    (hs : ∀ i, HolomorphicAt n (s i) x) (h : HolomorphicAt n (fun y => ∑ i, a i y * s i y) x) :
    NativeHolGerm.mk (fun y => ∑ i, a i y * s i y) h =
      ∑ i, NativeHolGerm.mk (a i) (ha i) * NativeHolGerm.mk (s i) (hs i) := by
  apply Subtype.ext
  have hfun : (fun y => ∑ i, a i y * s i y) = ∑ i, a i * s i := by
    funext y
    simp [Finset.sum_apply]
  rw [AddSubmonoidClass.coe_finsetSum]
  change ((fun y => ∑ i, a i y * s i y : M → ℂ) : Germ (𝓝 x) ℂ) =
    ∑ i, ((a i : M → ℂ) : Germ (𝓝 x) ℂ) * ((s i : M → ℂ) : Germ (𝓝 x) ℂ)
  rw [hfun]
  have := map_sum (Germ.coeRingHom (R := ℂ) (𝓝 x)) (fun i => a i * s i) Finset.univ
  simp only [Germ.coe_coeRingHom, map_mul] at this
  exact this

/-- For a germ ideal with local generators `s`, the stalk is generated by the germs of the `sᵢ`. -/
theorem stalkIdeal_eq_span (𝔞 : GermIdeal n M) {z : M} {N : ℕ} (s : Fin N → M → ℂ)
    (hs : ∀ i, HolomorphicAt n (s i) z)
    (h𝔞 : ∀ g, 𝔞.mem z g ↔ IsInSpanAt (n := n) (· ∈ range s) z g) :
    stalkIdeal 𝔞 z = Ideal.span (range fun i => NativeHolGerm.mk (s i) (hs i)) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨f, hf, hmem, rfl⟩
    obtain ⟨-, K, t, a, ht, ha, heq⟩ := (h𝔞 f).mp hmem
    have htz : ∀ j, HolomorphicAt n (t j) z := by
      intro j
      obtain ⟨i, hi⟩ := ht j
      rw [← hi]
      exact hs i
    have hsum : HolomorphicAt n (fun y => ∑ j, a j y * t j y) z :=
      HolomorphicAt.sum _ fun j _ => (ha j).mul (htz j)
    have hmk : NativeHolGerm.mk f hf = NativeHolGerm.mk _ hsum :=
      NativeHolGerm.mk_eq_mk_iff.mpr heq
    rw [hmk, mk_sum_mul a t ha htz hsum]
    apply Ideal.sum_mem
    intro j _
    apply Ideal.mul_mem_left
    obtain ⟨i, hi⟩ := ht j
    apply Ideal.subset_span
    refine ⟨i, ?_⟩
    simp only
    congr 1
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply Ideal.subset_span
    refine ⟨s i, hs i, (h𝔞 (s i)).mpr ⟨hs i, 1, fun _ => s i, fun _ _ => 1,
      fun _ => ⟨i, rfl⟩, fun _ => holomorphicAt_const 1, ?_⟩, rfl⟩
    exact Eventually.of_forall fun y => by simp

/-- Coherence of an ideal sheaf of `𝒪_Y`, given by its stalks: near every point of `Y` it is
generated by the images of finitely many holomorphic functions. -/
def IsCoherentOn (Y : ClosedComplexSubspace n M)
    (𝔟 : (y : M) → Ideal (Y.structureStalk y)) : Prop :=
  ∀ y ∈ Y.support, ∃ (U : Set M) (hU : IsOpen U), y ∈ U ∧ ∃ (N : ℕ) (s : Fin N → M → ℂ)
    (hs : ∀ i, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (s i) U),
    ∀ (z : M) (hz : z ∈ U), 𝔟 z = Ideal.span (range fun i =>
      Ideal.Quotient.mk (stalkIdeal Y.ideal z)
        (NativeHolGerm.mk (s i) (holomorphicAt_of_mdifferentiableOn hU (hs i) hz)))

/-- `def:restidealsheaf`: `Rest_Y 𝓘` is a coherent ideal sheaf of `𝒪_Y` when `𝓘` is coherent. -/
theorem isCoherent_restStalk {I : GermIdeal n M} (hI : I.IsCoherent)
    (Y : ClosedComplexSubspace n M) : IsCoherentOn Y (restStalk I Y) := by
  intro y _
  obtain ⟨U, hU, hyU, N, s, hs, hgen⟩ := hI y
  refine ⟨U, hU, hyU, N, s, hs, fun z hz => ?_⟩
  rw [restStalk, stalkIdeal_eq_span I s (fun i => holomorphicAt_of_mdifferentiableOn hU (hs i) hz)
    (hgen z hz), Ideal.map_span, ← Set.range_comp]
  rfl

end SGPT.PSH.IdealRestriction
