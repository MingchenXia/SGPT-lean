import SGPT.PSH.GeometricQDivisor
import SGPT.Foundations.Analysis.Pending.HironakaEffectiveDivisorSum
import SGPT.Foundations.Analysis.Pending.HironakaSNCComponentCoefficients

set_option autoImplicit false
noncomputable section
namespace SGPT.PSH
open Set Filter
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
open SGPT.Foundations.Analysis.Pending HironakaEffectiveDivisorSum
open scoped Topology Manifold ContDiff

/-- The genuine finite Cartier sum has EXACTLY the entire stalk generated by
its SAME original power product; no SNC or smooth-carrier hypotheses occur. -/
theorem finite_cartier_sum_generator_product {n : ℕ} {M ι : Type*}
    [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
    (s : Finset ι) (F : ι → EffectiveDivisor n M) (a : ι → ℕ)
    (g : ι → M → ℂ) (x : M) (hg : ∀ i ∈ s, HolomorphicAt n (g i) x)
    (hgen : ∀ i ∈ s, ∀ h, (F i).ideal.mem x h ↔ IsInSpanAt (n := n) (· = g i) x h)
    (h : M → ℂ) :
    (∑ i ∈ s, a i • F i).ideal.mem x h ↔
      IsInSpanAt (n := n) (· = fun y => ∏ i ∈ s, g i y ^ a i) x h := by
  classical
  induction s using Finset.induction_on generalizing h with
  | empty =>
    simpa only [Finset.sum_empty, ideal_zero, IdealWeightPowers.unitIdeal,
      Finset.prod_empty] using (MemberPullback.isInSpanAt_one_iff h).symm
  | @insert i s hi ih =>
    have hip : HolomorphicAt n (fun y => g i y ^ a i) x :=
      CompanionReduction.holomorphicAt_pow_of (hg i (Finset.mem_insert_self i s)) (a i)
    have htp : HolomorphicAt n (fun y => ∏ j ∈ s, g j y ^ a j) x :=
      MonomialPart.holomorphicAt_finset_prod s (fun j hj =>
        CompanionReduction.holomorphicAt_pow_of (hg j (Finset.mem_insert_of_mem hj)) (a j))
    have higen : ∀ b, (a i • F i).ideal.mem x b ↔
        IsInSpanAt (n := n) (· = fun y => g i y ^ a i) x b := by
      intro b
      rw [ideal_nsmul]
      exact HironakaSNCComponentCoefficients.idealPow_mem_iff_of_generator
        (hg i (Finset.mem_insert_self i s)) (hgen i (Finset.mem_insert_self i s)) (a i) b
    have htgen : ∀ b, (∑ j ∈ s, a j • F j).ideal.mem x b ↔
        IsInSpanAt (n := n) (· = fun y => ∏ j ∈ s, g j y ^ a j) x b :=
      ih (fun j hj => hg j (Finset.mem_insert_of_mem hj))
        (fun j hj => hgen j (Finset.mem_insert_of_mem hj))
    simpa only [Finset.sum_insert hi, ideal_add, Finset.prod_insert hi] using
      MemberPullback.mul_mem_iff_of_generators higen htgen hip htp h

end SGPT.PSH
