import SGPT.Foundations.Analysis.Pending.SNCEuclideanCoordinateMultiplier
import SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves
import Mathlib.Analysis.Analytic.Order
import Mathlib.Analysis.Complex.CauchyIntegral
import Mathlib.Geometry.Manifold.MFDeriv.FDeriv

/-!
# The normalization of multiplier ideals (`rmk:misconv`)

Source: `rmk:misconv` of the chapter *Plurisubharmonic functions*. The book defines
`𝓘(φ)` by local integrability of `|f|² exp(-φ)` (not `exp(-2φ)`), and records the mnemonic

`𝓘(λ log |z|²) = 𝒪_ℂ(-⌊λ⌋ {0})` for every real `λ > 0`

(instead of `𝒪_ℂ(-⌊2λ⌋ {0})` in the other convention).

Here `ℂ` is the model `ComplexModel 1` with coordinate `z = z 0`, the multiplier ideal is the
existing germ ideal `multiplierIdeal c φ` of `|g|² exp(-c φ)`, and `𝒪_ℂ(-k {0})` is the ideal
sheaf generated by `z^k` (`pointDivisorIdeal k`). We prove the general identity
`𝓘(c λ log |z|²) = 𝒪(-⌊cλ⌋ {0})` (`multiplierIdeal_logPoleWeight`), which gives the book's
formula for `c = 1` (`multiplierIdeal_logPoleWeight_book`) and the other convention for `c = 2`
(`multiplierIdeal_logPoleWeight_doubled`).
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory Metric
open scoped Topology ENNReal Manifold

namespace SGPT.PSH.MultiplierConvention

open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.FirstPass.HolomorphicIdealSheaves

/-- The coordinate `z` of the complex line `ℂ = ComplexModel 1`. -/
def lineCoord : ComplexModel 1 ≃L[ℂ] ℂ :=
  (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin 1 => ℂ)).trans
    (ContinuousLinearEquiv.funUnique (Fin 1) ℂ ℂ)

@[simp] theorem lineCoord_apply (z : ComplexModel 1) : lineCoord z = z 0 := rfl

@[simp] theorem lineCoord_symm_apply_zero (w : ℂ) : (lineCoord.symm w) 0 = w := rfl

/-- The weight `λ log |z|²` on `ℂ`, with value `-∞` at `0`. -/
def logPoleWeight (lam : ℝ) : ComplexModel 1 → EReal :=
  fun z => (lam : EReal) * ENNReal.log (ENNReal.ofReal (‖z 0‖ ^ 2))

/-- The ideal sheaf `𝒪_ℂ(-k {0})` of the divisor `k {0}`: it is generated by `z^k`. -/
def pointDivisorIdeal (k : ℕ) : GermIdeal 1 (ComplexModel 1) where
  mem x g := IsInSpanAt (n := 1) (· = fun z : ComplexModel 1 => (z 0) ^ k) x g

/-! ### Auxiliary facts -/

theorem holomorphicAt_iff {g : ComplexModel 1 → ℂ} {x : ComplexModel 1} :
    HolomorphicAt 1 g x ↔ ∀ᶠ y in 𝓝 x, DifferentiableAt ℂ g y := by
  unfold HolomorphicAt
  simp only [mdifferentiableAt_iff_differentiableAt]

theorem logPoleWeight_eq_sum (lam : ℝ) :
    logPoleWeight lam = fun z : ComplexModel 1 =>
      (∑ i : Fin 1, ((2 * lam : ℝ) : EReal) * ENNReal.log (ENNReal.ofReal ‖z i‖)) +
        ((0 : ℝ) : EReal) := by
  funext z
  simp only [logPoleWeight, Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
    EReal.coe_zero, add_zero]
  rw [ENNReal.ofReal_pow (norm_nonneg _), ENNReal.log_pow, EReal.coe_mul, mul_left_comm,
    ← mul_assoc]
  norm_num
  norm_cast

/-- Away from the origin the weight is the continuous real function `λ log |z|²`. -/
theorem logPoleWeight_eq_real (lam : ℝ) {y : ComplexModel 1} (hy : y 0 ≠ 0) :
    logPoleWeight lam y = ((lam * Real.log (‖y 0‖ ^ 2) : ℝ) : EReal) := by
  have hpos : 0 < ‖y 0‖ ^ 2 := by positivity
  rw [logPoleWeight, ENNReal.log_ofReal_of_pos hpos, ← EReal.coe_mul]

/-- With the weight `0`, every holomorphic germ is locally square integrable. -/
theorem multiplierIntegrableAt_zero_weight {c : ℝ} (hc : 0 < c) {f : ComplexModel 1 → ℂ}
    {x : ComplexModel 1} (hf : ∀ᶠ y in 𝓝 x, DifferentiableAt ℂ f y) :
    MultiplierIntegrableAt (fun _ => (0 : EReal)) c f x volume := by
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hf
  have hr2 : 0 < r / 2 := half_pos hr
  have hsub : closedBall x (r / 2) ⊆ ball x r := closedBall_subset_ball (half_lt_self hr)
  have hcont : ContinuousOn f (closedBall x (r / 2)) :=
    fun y hy => (hball y (hsub hy)).continuousAt.continuousWithinAt
  obtain ⟨M, hM⟩ := (isCompact_closedBall x (r / 2)).exists_bound_of_continuousOn hcont
  refine ⟨hc, ball x (r / 2), isOpen_ball, mem_ball_self hr2, ?_, ?_⟩
  · intro y hy
    exact (hball y (hsub (ball_subset_closedBall hy))).differentiableWithinAt
  · have hdens : ∀ y, multiplierDensity (fun _ => (0 : EReal)) c f y =
        ENNReal.ofReal (‖f y‖ ^ 2) := by
      intro y
      simp [multiplierDensity, multiplierWeight]
    refine ⟨?_, ?_⟩
    · have hfm : AEMeasurable f (volume.restrict (ball x (r / 2))) :=
        (hcont.mono ball_subset_closedBall).aemeasurable measurableSet_ball
      have : AEMeasurable (fun y => ENNReal.ofReal (‖f y‖ ^ 2))
          (volume.restrict (ball x (r / 2))) :=
        (hfm.norm.pow_const 2).ennreal_ofReal
      have he : multiplierDensity (fun _ => (0 : EReal)) c f =
          fun y => ENNReal.ofReal (‖f y‖ ^ 2) := funext hdens
      rw [he]
      exact this
    · simp only [hdens]
      calc ∫⁻ y in ball x (r / 2), ENNReal.ofReal (‖f y‖ ^ 2)
          ≤ ∫⁻ _ in ball x (r / 2), ENNReal.ofReal (M ^ 2) := by
            apply setLIntegral_mono measurable_const
            intro y hy
            apply ENNReal.ofReal_le_ofReal
            have h1 := hM y (ball_subset_closedBall hy)
            exact pow_le_pow_left₀ (norm_nonneg _) h1 2
        _ = ENNReal.ofReal (M ^ 2) * volume (ball x (r / 2)) := setLIntegral_const _ _
        _ < ⊤ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top measure_ball_lt_top

/-- Away from the origin every holomorphic germ belongs to `𝓘(c λ log |z|²)`. -/
theorem multiplierIntegrableAt_logPoleWeight_of_ne_zero (lam : ℝ) {c : ℝ} (hc : 0 < c)
    {f : ComplexModel 1 → ℂ} {x : ComplexModel 1} (hx : x 0 ≠ 0)
    (hf : ∀ᶠ y in 𝓝 x, DifferentiableAt ℂ f y) :
    MultiplierIntegrableAt (logPoleWeight lam) c f x volume := by
  set ρ : ComplexModel 1 → ℝ := fun y => lam * Real.log (‖y 0‖ ^ 2) with hρ
  have hnear : ∀ᶠ y in 𝓝 x, y 0 ≠ 0 :=
    ((lineCoord.continuous.continuousAt (x := x)).eventually_ne (by simpa using hx)).mono
      fun y hy => by simpa using hy
  have hρc : ∀ᶠ y in 𝓝 x, ContinuousAt ρ y := by
    filter_upwards [hnear] with y hy
    have h1 : ContinuousAt (fun y : ComplexModel 1 => ‖y 0‖ ^ 2) y :=
      ((continuous_apply 0).comp (PiLp.continuous_ofLp 2 _)).norm.pow 2 |>.continuousAt
    exact continuousAt_const.mul (h1.log (by positivity))
  have h0 := multiplierIntegrableAt_zero_weight hc hf
  have h1 : MultiplierIntegrableAt (fun y => (0 : EReal) + (ρ y : EReal)) c f x volume :=
    (Pending.SNCCoordinateUnitCorrection.multiplierIntegrableAt_add_continuous_iff hρc).mpr h0
  refine h1.congr ?_ (Eventually.of_forall fun _ => rfl)
  filter_upwards [hnear] with y hy
  rw [zero_add, logPoleWeight_eq_real lam hy]

/-! ### The origin -/

/-- The coordinate expression of a germ at the origin. -/
def lineGerm (f : ComplexModel 1 → ℂ) : ℂ → ℂ := fun w => f (lineCoord.symm w)

theorem eq_lineGerm (f : ComplexModel 1 → ℂ) (z : ComplexModel 1) :
    f z = lineGerm f (z 0) := by
  simp [lineGerm, ← lineCoord_apply, ContinuousLinearEquiv.symm_apply_apply]

theorem analyticAt_lineGerm {f : ComplexModel 1 → ℂ}
    (hf : ∀ᶠ y in 𝓝 (0 : ComplexModel 1), DifferentiableAt ℂ f y) :
    AnalyticAt ℂ (lineGerm f) 0 := by
  rw [Complex.analyticAt_iff_eventually_differentiableAt]
  have ht : Tendsto lineCoord.symm (𝓝 (0 : ℂ)) (𝓝 (0 : ComplexModel 1)) := by
    simpa using lineCoord.symm.continuous.tendsto (0 : ℂ)
  filter_upwards [ht.eventually hf] with w hw
  exact hw.comp w lineCoord.symm.differentiableAt

theorem tendsto_lineCoord_zero :
    Tendsto lineCoord (𝓝 (0 : ComplexModel 1)) (𝓝 (0 : ℂ)) := by
  simpa using lineCoord.continuous.tendsto (0 : ComplexModel 1)

/-- Membership at the origin is the order condition `⌊cλ⌋ ≤ ord₀ f`. -/
theorem multiplierIntegrableAt_logPoleWeight_zero_iff {lam c : ℝ} (hlam : 0 < lam) (hc : 0 < c)
    {f : ComplexModel 1 → ℂ} (hf : ∀ᶠ y in 𝓝 (0 : ComplexModel 1), DifferentiableAt ℂ f y) :
    MultiplierIntegrableAt (logPoleWeight lam) c f 0 volume ↔
      ((⌊c * lam⌋₊ : ℕ) : ℕ∞) ≤ analyticOrderAt (lineGerm f) 0 := by
  have hF := analyticAt_lineGerm hf
  by_cases htop : analyticOrderAt (lineGerm f) 0 = ⊤
  · -- the zero germ
    rw [htop]
    have hz : ∀ᶠ w in 𝓝 (0 : ℂ), lineGerm f w = 0 := analyticOrderAt_eq_top.mp htop
    have hz' : f =ᶠ[𝓝 0] fun _ => 0 := by
      filter_upwards [tendsto_lineCoord_zero.eventually hz] with y hy
      rw [eq_lineGerm f y]
      simpa using hy
    simp only [le_top, iff_true]
    exact (multiplierIntegrableAt_zero (logPoleWeight lam) hc 0 volume).congr
      (Eventually.of_forall fun _ => rfl) hz'.symm
  · obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp htop
    rw [← hm]
    obtain ⟨G, hG, hG0, hFG⟩ := hF.analyticOrderAt_eq_natCast.mp hm.symm
    have hfG : f =ᶠ[𝓝 0] fun z : ComplexModel 1 =>
        G (lineCoord z) * ∏ i : Fin 1, z i ^ (fun _ : Fin 1 => m) i := by
      filter_upwards [tendsto_lineCoord_zero.eventually hFG] with y hy
      rw [eq_lineGerm f y]
      simp only [lineCoord_apply, sub_zero, smul_eq_mul] at hy
      simp only [lineCoord_apply, Finset.univ_unique, Fin.default_eq_zero,
        Finset.prod_singleton, hy]
      ring
    have hGd : ∀ᶠ z in 𝓝 (0 : ComplexModel 1), DifferentiableAt ℂ (fun z => G (lineCoord z)) z := by
      have hGe := hG.eventually_analyticAt
      filter_upwards [tendsto_lineCoord_zero.eventually hGe] with y hy
      exact hy.differentiableAt.comp y lineCoord.differentiableAt
    have hcrit := Pending.SNCEuclideanCoordinateMultiplier.multiplierIntegrableAt_sum_log_unit_monomial_iff
      (n := 1) (fun _ => m) (fun _ => lam) hc (g := fun z => G (lineCoord z)) (ρ := fun _ => 0)
      hGd (by simpa using hG0) (Eventually.of_forall fun _ => continuousAt_const)
    rw [← logPoleWeight_eq_sum] at hcrit
    have hcongr : MultiplierIntegrableAt (logPoleWeight lam) c f 0 volume ↔
        MultiplierIntegrableAt (logPoleWeight lam) c
          (fun z => G (lineCoord z) * ∏ i : Fin 1, z i ^ (fun _ : Fin 1 => m) i) 0 volume :=
      ⟨fun hh => hh.congr (Eventually.of_forall fun _ => rfl) hfG,
        fun hh => hh.congr (Eventually.of_forall fun _ => rfl) hfG.symm⟩
    rw [hcongr, hcrit]
    simp only [forall_const]
    rw [Nat.cast_le]
    have hcl : 0 ≤ c * lam := (mul_pos hc hlam).le
    constructor
    · intro hlt
      exact Nat.lt_succ_iff.mp ((Nat.floor_lt hcl).mpr (by exact_mod_cast hlt))
    · intro hle
      have := (Nat.floor_lt hcl).mp (Nat.lt_succ_iff.mpr hle)
      exact_mod_cast this

/-- Membership in `𝒪(-k {0})` at the origin is the order condition `k ≤ ord₀ f`. -/
theorem pointDivisorIdeal_mem_zero_iff (k : ℕ) (f : ComplexModel 1 → ℂ) :
    (pointDivisorIdeal k).mem 0 f ↔
      HolomorphicAt 1 f 0 ∧ ((k : ℕ) : ℕ∞) ≤ analyticOrderAt (lineGerm f) 0 := by
  constructor
  · rintro ⟨hf, N, s, a, hs, ha, heq⟩
    refine ⟨hf, ?_⟩
    have hF := analyticAt_lineGerm (holomorphicAt_iff.mp hf)
    rw [natCast_le_analyticOrderAt hF]
    refine ⟨fun w => ∑ i, a i (lineCoord.symm w), ?_, ?_⟩
    · have : ∀ i, AnalyticAt ℂ (fun w => a i (lineCoord.symm w)) 0 := by
        intro i
        exact analyticAt_lineGerm (holomorphicAt_iff.mp (ha i))
      exact Finset.analyticAt_fun_sum _ fun i _ => this i
    · have ht : Tendsto lineCoord.symm (𝓝 (0 : ℂ)) (𝓝 (0 : ComplexModel 1)) := by
        simpa using lineCoord.symm.continuous.tendsto (0 : ℂ)
      filter_upwards [ht.eventually heq] with w hw
      simp only [lineGerm, hw, sub_zero, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hs i, lineCoord_symm_apply_zero]
      ring
  · rintro ⟨hf, hk⟩
    have hF := analyticAt_lineGerm (holomorphicAt_iff.mp hf)
    obtain ⟨H, hH, hFH⟩ := (natCast_le_analyticOrderAt hF).mp hk
    refine ⟨hf, 1, fun _ z => (z 0) ^ k, fun _ z => H (lineCoord z), fun _ => rfl, ?_, ?_⟩
    · intro _
      rw [holomorphicAt_iff]
      filter_upwards [tendsto_lineCoord_zero.eventually hH.eventually_analyticAt] with y hy
      exact hy.differentiableAt.comp y lineCoord.differentiableAt
    · filter_upwards [tendsto_lineCoord_zero.eventually hFH] with y hy
      rw [eq_lineGerm f y]
      simp only [lineCoord_apply, sub_zero, smul_eq_mul] at hy
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton, hy,
        lineCoord_apply]
      ring

/-- Away from the origin `𝒪(-k {0})` contains every holomorphic germ. -/
theorem pointDivisorIdeal_mem_of_ne_zero (k : ℕ) {x : ComplexModel 1} (hx : x 0 ≠ 0)
    (f : ComplexModel 1 → ℂ) :
    (pointDivisorIdeal k).mem x f ↔ HolomorphicAt 1 f x := by
  constructor
  · exact fun h => h.1
  · intro hf
    have hnear : ∀ᶠ y in 𝓝 x, y 0 ≠ 0 :=
      ((lineCoord.continuous.continuousAt (x := x)).eventually_ne (by simpa using hx)).mono
        fun y hy => by simpa using hy
    refine ⟨hf, 1, fun _ z => (z 0) ^ k, fun _ z => f z / (z 0) ^ k, fun _ => rfl, ?_, ?_⟩
    · intro _
      rw [holomorphicAt_iff] at hf ⊢
      filter_upwards [hf, hnear] with y hy hy0
      have hp : DifferentiableAt ℂ (fun z : ComplexModel 1 => (z 0) ^ k) y :=
        (lineCoord.differentiableAt.pow k)
      have hne : (fun z : ComplexModel 1 => (z 0) ^ k) y ≠ 0 := pow_ne_zero k hy0
      have hmul := hy.mul (hp.inv hne)
      convert hmul using 1
      all_goals rfl
    · filter_upwards [hnear] with y hy
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton]
      rw [div_mul_cancel₀ _ (pow_ne_zero _ hy)]

/-! ### The identity of ideal sheaves -/

theorem complexChartAt_model (x : ComplexModel 1) :
    (complexChartAt (n := 1) x).val = OpenPartialHomeomorph.refl (ComplexModel 1) := rfl

/-- `𝓘(c λ log |z|²) = 𝒪_ℂ(-⌊cλ⌋ {0})` for real `c, λ > 0`, as ideal sheaves on `ℂ`. -/
theorem multiplierIdeal_logPoleWeight {lam c : ℝ} (hlam : 0 < lam) (hc : 0 < c) :
    multiplierIdeal (n := 1) c (logPoleWeight lam) = pointDivisorIdeal ⌊c * lam⌋₊ := by
  ext x g
  change (HolomorphicAt 1 g x ∧ MultiplierIntegrableAt
      (chartFunction (logPoleWeight lam) (complexChartAt (n := 1) x)) c
      (fun z => g ((complexChartAt (n := 1) x).val.symm z))
      ((complexChartAt (n := 1) x).val x) volume) ↔ (pointDivisorIdeal ⌊c * lam⌋₊).mem x g
  have hcf : chartFunction (logPoleWeight lam) (complexChartAt (n := 1) x) =
      logPoleWeight lam := rfl
  rw [hcf]
  simp only [complexChartAt_model, OpenPartialHomeomorph.refl_symm,
    OpenPartialHomeomorph.refl_apply, id_eq]
  by_cases hx : x 0 = 0
  · have hx0 : x = 0 := lineCoord.injective (by rw [lineCoord_apply, map_zero]; exact hx)
    subst hx0
    rw [pointDivisorIdeal_mem_zero_iff]
    constructor
    · rintro ⟨hg, hint⟩
      exact ⟨hg, (multiplierIntegrableAt_logPoleWeight_zero_iff hlam hc
        (holomorphicAt_iff.mp hg)).mp hint⟩
    · rintro ⟨hg, hord⟩
      exact ⟨hg, (multiplierIntegrableAt_logPoleWeight_zero_iff hlam hc
        (holomorphicAt_iff.mp hg)).mpr hord⟩
  · rw [pointDivisorIdeal_mem_of_ne_zero _ hx]
    exact ⟨fun h => h.1, fun hg => ⟨hg, multiplierIntegrableAt_logPoleWeight_of_ne_zero lam hc hx
      (holomorphicAt_iff.mp hg)⟩⟩

/-- `rmk:misconv`, the book's convention: `𝓘(λ log |z|²) = 𝒪_ℂ(-⌊λ⌋ {0})` for real `λ > 0`,
where `𝓘(φ)` is defined by integrability of `|f|² exp(-φ)`. -/
theorem multiplierIdeal_logPoleWeight_book {lam : ℝ} (hlam : 0 < lam) :
    multiplierIdeal (n := 1) 1 (logPoleWeight lam) = pointDivisorIdeal ⌊lam⌋₊ := by
  simpa using multiplierIdeal_logPoleWeight hlam one_pos

/-- `rmk:misconv`, the other convention: with `exp(-2φ)` in place of `exp(-φ)` one gets
`𝒪_ℂ(-⌊2λ⌋ {0})` instead. -/
theorem multiplierIdeal_logPoleWeight_doubled {lam : ℝ} (hlam : 0 < lam) :
    multiplierIdeal (n := 1) 2 (logPoleWeight lam) = pointDivisorIdeal ⌊2 * lam⌋₊ :=
  multiplierIdeal_logPoleWeight hlam two_pos

end SGPT.PSH.MultiplierConvention
