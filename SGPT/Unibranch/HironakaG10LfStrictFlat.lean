import SGPT.Unibranch.HironakaG10SbTorsionSaturation
import SGPT.Foundations.Analysis.Pending.HironakaG10ChowArtinReesCentre
import Mathlib.RingTheory.Flat.Equalizer
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra

/-!
# Strict generation on a Rees chart and flat base change of saturations (lane G10LF, core of N5.c2)

Pure commutative algebra for the N5 (Hironaka 1975, p. 532: the ideal of the strict transform is
generated by the `G⁻ᵏ h`, `h ∈ I ∩ Wᵏ`).

* **(A2)** `map_colonElem_of_flat`, **`map_powerSat_of_flat`**: for a flat `B → C`, colons `(I : f)` and
  saturations `(I : g^∞)` commute with base change.
* **(A3)** **`strictIdeal_eq_powerSat_of_chart`**: `φ : A → B`, `e₀ ∈ W`, `G = φ e₀`; if every `y ∈ B` satisfies
  `Gᵏ y = φ w` for some `w ∈ Wᵏ` (`B = A[W/G]`; `chart_H1_of_adjoin`) and `φ a ∈ I B ⇒ e₀ᴺ a ∈ I` (e.g. `B` maps
  to `A_{e₀}` over `A`; `chart_H2_of_away`), then for EVERY ideal `I`, `strictIdeal φ I W G = powerSat (I B) G`.
* **(A4)** **`strictIdeal_eq_powerSat_of_flat_chart`**: the same after any flat `B → C` (the analytic stalk of a
  blowup chart over the algebraic Rees chart).

No named input. BP: hironaka-g10lf-generic-freeness.tex.
-/

set_option autoImplicit false

open Function TensorProduct
open SGPT.Unibranch.HironakaG10SbTorsionSaturation
  SGPT.Foundations.Analysis.Pending.HironakaG10ChowArtinReesCentre

namespace SGPT.Unibranch.HironakaG10LfStrictFlat

/-! ### (A2) Colons and saturations under flat base change -/

section Colon

variable {B : Type*} [CommRing B]

/-- The colon ideal `(I : f) = {x | f x ∈ I}`. -/
def colonElem (I : Ideal B) (f : B) : Ideal B where
  carrier := {x | f * x ∈ I}
  add_mem' := by
    intro x y hx hy
    change f * (x + y) ∈ I
    rw [mul_add]
    exact I.add_mem hx hy
  zero_mem' := by
    change f * 0 ∈ I
    rw [mul_zero]
    exact I.zero_mem
  smul_mem' := by
    intro c x hx
    change f * (c • x) ∈ I
    rw [smul_eq_mul, mul_left_comm]
    exact I.mul_mem_left c hx

theorem mem_colonElem {I : Ideal B} {f x : B} : x ∈ colonElem I f ↔ f * x ∈ I := Iff.rfl

theorem colonElem_pow_le_powerSat (I : Ideal B) (g : B) (m : ℕ) :
    colonElem I (g ^ m) ≤ powerSat I g := fun _ hx => mem_powerSat.2 ⟨m, hx⟩

variable {C : Type*} [CommRing C] [Algebra B C]

/-- The easy inclusion `(I : f) C ≤ (I C : f)` (no flatness). -/
theorem map_colonElem_le (I : Ideal B) (f : B) :
    (colonElem I f).map (algebraMap B C) ≤ colonElem (I.map (algebraMap B C)) (algebraMap B C f) := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  change algebraMap B C f * algebraMap B C x ∈ I.map (algebraMap B C)
  rw [← map_mul]
  exact Ideal.mem_map_of_mem _ hx

variable [Module.Flat B C]

/-- **The key step:** for flat `C`, `φ(f) y ∈ I C ⇒ y ∈ (I : f) C`. -/
theorem mem_map_colonElem_of_flat (I : Ideal B) (f : B) (y : C)
    (hy : algebraMap B C f * y ∈ I.map (algebraMap B C)) :
    y ∈ (colonElem I f).map (algebraMap B C) := by
  let μ : B →ₗ[B] B ⧸ I := (Submodule.mkQ I).comp (LinearMap.mulLeft B f)
  have hker : ∀ x : B, x ∈ LinearMap.ker μ ↔ x ∈ colonElem I f := by
    intro x
    rw [LinearMap.mem_ker, mem_colonElem]
    change Submodule.Quotient.mk (f * x) = (0 : B ⧸ I) ↔ _
    rw [Submodule.Quotient.mk_eq_zero]
  let μC := TensorProduct.AlgebraTensorModule.lTensor C C μ
  have hkerC := Module.Flat.ker_lTensor_eq C C μ
  have h0 : μC (y ⊗ₜ[B] (1 : B)) = 0 := by
    change y ⊗ₜ[B] μ 1 = 0
    have h1 : μ 1 = Ideal.Quotient.mk I f := by
      change Submodule.Quotient.mk (f * 1) = _
      rw [mul_one]
      rfl
    rw [h1]
    apply (TensorProduct.tensorQuotEquivQuotSMul C I).injective
    rw [TensorProduct.tensorQuotEquivQuotSMul_tmul_mk, map_zero, Submodule.Quotient.mk_eq_zero,
      Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Algebra.smul_def]
    exact hy
  have hmem : y ⊗ₜ[B] (1 : B) ∈ LinearMap.ker μC := h0
  rw [hkerC] at hmem
  obtain ⟨t, ht⟩ := hmem
  have hrid : TensorProduct.AlgebraTensorModule.rid B C C (y ⊗ₜ[B] (1 : B)) = y := by
    rw [TensorProduct.AlgebraTensorModule.rid_tmul, one_smul]
  rw [← hrid, ← ht]
  clear ht hrid
  induction t using TensorProduct.induction_on with
  | zero => rw [map_zero, map_zero]; exact Ideal.zero_mem _
  | tmul c k =>
    change TensorProduct.AlgebraTensorModule.rid B C C (c ⊗ₜ[B] (k : B)) ∈ _
    rw [TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ((hker k).1 k.2))
  | add t₁ t₂ h₁ h₂ =>
    rw [map_add, map_add]
    exact Ideal.add_mem _ h₁ h₂

/-- **(A2) Colons commute with flat base change.** -/
theorem map_colonElem_of_flat (I : Ideal B) (f : B) :
    (colonElem I f).map (algebraMap B C) = colonElem (I.map (algebraMap B C)) (algebraMap B C f) :=
  le_antisymm (map_colonElem_le I f) fun y hy => mem_map_colonElem_of_flat I f y hy

/-- **(A2) Saturations commute with flat base change.** -/
theorem map_powerSat_of_flat (I : Ideal B) (g : B) :
    (powerSat I g).map (algebraMap B C) = powerSat (I.map (algebraMap B C)) (algebraMap B C g) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨m, hm⟩ := mem_powerSat.1 hx
    refine mem_powerSat.2 ⟨m, ?_⟩
    change algebraMap B C g ^ m * algebraMap B C x ∈ _
    rw [← map_pow, ← map_mul]
    exact Ideal.mem_map_of_mem _ hm
  · intro y hy
    obtain ⟨m, hm⟩ := mem_powerSat.1 hy
    rw [← map_pow] at hm
    exact Ideal.map_mono (colonElem_pow_le_powerSat I g m) (mem_map_colonElem_of_flat I (g ^ m) y hm)

end Colon

/-! ### (A3) Strict generation on a Rees chart -/

section Chart

variable {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)

/-- The strict ideal always lies in the saturation of the total transform. -/
theorem strictIdeal_le_powerSat (I W : Ideal A) (G : B) :
    strictIdeal φ I W G ≤ powerSat (I.map φ) G := by
  rw [strictIdeal, Ideal.span_le]
  rintro h' ⟨k, h, hh, hφ⟩
  refine mem_powerSat.2 ⟨k, ?_⟩
  rw [← hφ]
  exact Ideal.mem_map_of_mem φ hh.1

/-- **(A3) Strict generation on a Rees chart.** -/
theorem powerSat_le_strictIdeal (I W : Ideal A) (e₀ : A) (he₀ : e₀ ∈ W)
    (H1 : ∀ y : B, ∃ k : ℕ, ∃ w ∈ W ^ k, φ w = φ e₀ ^ k * y)
    (H2 : ∀ a : A, φ a ∈ I.map φ → ∃ N : ℕ, e₀ ^ N * a ∈ I) :
    powerSat (I.map φ) (φ e₀) ≤ strictIdeal φ I W (φ e₀) := by
  intro y hy
  obtain ⟨m, hm⟩ := mem_powerSat.1 hy
  obtain ⟨k, w, hw, hwy⟩ := H1 y
  have h1 : φ (e₀ ^ m * w) ∈ I.map φ := by
    rw [map_mul, map_pow, hwy, mul_left_comm]
    exact Ideal.mul_mem_left _ _ hm
  obtain ⟨N, hN⟩ := H2 _ h1
  apply Ideal.subset_span
  refine ⟨N + m + k, e₀ ^ N * (e₀ ^ m * w), ⟨hN, ?_⟩, ?_⟩
  · rw [← mul_assoc, ← pow_add, pow_add W (N + m) k]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow he₀ _) hw
  · rw [map_mul, map_mul, map_pow, map_pow, hwy]
    ring

theorem strictIdeal_eq_powerSat_of_chart (I W : Ideal A) (e₀ : A) (he₀ : e₀ ∈ W)
    (H1 : ∀ y : B, ∃ k : ℕ, ∃ w ∈ W ^ k, φ w = φ e₀ ^ k * y)
    (H2 : ∀ a : A, φ a ∈ I.map φ → ∃ N : ℕ, e₀ ^ N * a ∈ I) :
    strictIdeal φ I W (φ e₀) = powerSat (I.map φ) (φ e₀) :=
  le_antisymm (strictIdeal_le_powerSat φ I W _) (powerSat_le_strictIdeal φ I W e₀ he₀ H1 H2)

/-- Strict generators map to strict generators. -/
theorem map_strictIdeal_le {C : Type*} [CommRing C] (ψ : B →+* C) (I W : Ideal A) (G : B) :
    (strictIdeal φ I W G).map ψ ≤ strictIdeal (ψ.comp φ) I W (ψ G) := by
  rw [Ideal.map_le_iff_le_comap, strictIdeal, Ideal.span_le]
  rintro h' ⟨k, h, hh, hφ⟩
  apply Ideal.subset_span
  refine ⟨k, h, hh, ?_⟩
  rw [RingHom.comp_apply, hφ, map_mul, map_pow]

/-- **(A4) Strict generation after a flat base change of the chart.** -/
theorem strictIdeal_eq_powerSat_of_flat_chart {C : Type*} [CommRing C] [Algebra B C]
    [Module.Flat B C] (I W : Ideal A) (e₀ : A) (he₀ : e₀ ∈ W)
    (H1 : ∀ y : B, ∃ k : ℕ, ∃ w ∈ W ^ k, φ w = φ e₀ ^ k * y)
    (H2 : ∀ a : A, φ a ∈ I.map φ → ∃ N : ℕ, e₀ ^ N * a ∈ I) :
    strictIdeal ((algebraMap B C).comp φ) I W (algebraMap B C (φ e₀)) =
      powerSat (I.map ((algebraMap B C).comp φ)) (algebraMap B C (φ e₀)) := by
  apply le_antisymm (strictIdeal_le_powerSat _ I W _)
  rw [← Ideal.map_map, ← map_powerSat_of_flat]
  exact (Ideal.map_mono (powerSat_le_strictIdeal φ I W e₀ he₀ H1 H2)).trans
    (map_strictIdeal_le φ (algebraMap B C) I W (φ e₀))

/-! ### Checking (H1) and (H2) -/

/-- (H1) for an `A`-algebra generated by elements `s` with `G s ∈ φ(W)`. -/
theorem chart_H1_of_adjoin [Algebra A B] (W : Ideal A) (e₀ : A) (he₀ : e₀ ∈ W) (S : Set B)
    (hS : Algebra.adjoin A S = ⊤)
    (hSW : ∀ s ∈ S, ∃ w ∈ W, algebraMap A B w = algebraMap A B e₀ * s) (y : B) :
    ∃ k : ℕ, ∃ w ∈ W ^ k, algebraMap A B w = algebraMap A B e₀ ^ k * y := by
  have hy : y ∈ Algebra.adjoin A S := hS ▸ Algebra.mem_top
  induction hy using Algebra.adjoin_induction with
  | mem s hs =>
    obtain ⟨w, hw, hws⟩ := hSW s hs
    exact ⟨1, w, by rwa [pow_one], by rw [pow_one, hws]⟩
  | algebraMap a =>
    exact ⟨0, a, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top, by rw [pow_zero, one_mul]⟩
  | add x y _ _ hx hy =>
    obtain ⟨k₁, w₁, hw₁, h₁⟩ := hx
    obtain ⟨k₂, w₂, hw₂, h₂⟩ := hy
    refine ⟨k₁ + k₂, e₀ ^ k₂ * w₁ + e₀ ^ k₁ * w₂, ?_, ?_⟩
    · refine Ideal.add_mem _ ?_ ?_
      · rw [add_comm, pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow he₀ _) hw₁
      · rw [pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow he₀ _) hw₂
    · rw [map_add, map_mul, map_mul, map_pow, map_pow, h₁, h₂]
      ring
  | mul x y _ _ hx hy =>
    obtain ⟨k₁, w₁, hw₁, h₁⟩ := hx
    obtain ⟨k₂, w₂, hw₂, h₂⟩ := hy
    refine ⟨k₁ + k₂, w₁ * w₂, ?_, ?_⟩
    · rw [pow_add]
      exact Ideal.mul_mem_mul hw₁ hw₂
    · rw [map_mul, h₁, h₂]
      ring

/-- (H2) for an `A`-algebra mapping to a localization `A_{e₀}` over `A`. -/
theorem chart_H2_of_away [Algebra A B] (I : Ideal A) (e₀ : A) (L : Type*) [CommRing L] [Algebra A L]
    [IsLocalization.Away e₀ L] (ρ : B →ₐ[A] L) (a : A)
    (ha : algebraMap A B a ∈ I.map (algebraMap A B)) : ∃ N : ℕ, e₀ ^ N * a ∈ I := by
  have hle : I.map (algebraMap A B) ≤ (I.map (algebraMap A L)).comap ρ.toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro i hi
    change ρ (algebraMap A B i) ∈ I.map (algebraMap A L)
    rw [ρ.commutes]
    exact Ideal.mem_map_of_mem _ hi
  have h1 : algebraMap A L a ∈ I.map (algebraMap A L) := by
    have h2 := hle ha
    change ρ (algebraMap A B a) ∈ I.map (algebraMap A L) at h2
    rwa [ρ.commutes] at h2
  rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers e₀) L] at h1
  obtain ⟨⟨⟨i, hi⟩, ⟨_, p, rfl⟩⟩, hx⟩ := h1
  simp only at hx
  rw [← map_mul, IsLocalization.eq_iff_exists (Submonoid.powers e₀)] at hx
  obtain ⟨⟨_, q, rfl⟩, hq⟩ := hx
  refine ⟨q + p, ?_⟩
  have : e₀ ^ (q + p) * a = e₀ ^ q * i := by
    simp only at hq
    rw [pow_add, mul_assoc, ← mul_comm a, hq]
  rw [this]
  exact I.mul_mem_left _ hi

/-- **Packaged form**: an algebraic Rees chart `B = A[S]` (`e₀ s ∈ W` for `s ∈ S`, mapping to `A_{e₀}` over `A`)
followed by a flat `B → C` (`C` an `A`-algebra through `B`): strict generation holds in `C` for EVERY ideal. -/
theorem strictIdeal_eq_powerSat_of_reesChart [Algebra A B] {C : Type*} [CommRing C] [Algebra B C]
    [Algebra A C] [IsScalarTower A B C] [Module.Flat B C] (I W : Ideal A) (e₀ : A) (he₀ : e₀ ∈ W)
    (S : Set B) (hS : Algebra.adjoin A S = ⊤)
    (hSW : ∀ s ∈ S, ∃ w ∈ W, algebraMap A B w = algebraMap A B e₀ * s)
    (ρ : B →ₐ[A] Localization.Away e₀) :
    strictIdeal (algebraMap A C) I W (algebraMap A C e₀) =
      powerSat (I.map (algebraMap A C)) (algebraMap A C e₀) := by
  rw [IsScalarTower.algebraMap_eq A B C]
  exact strictIdeal_eq_powerSat_of_flat_chart (algebraMap A B) I W e₀ he₀
    (chart_H1_of_adjoin W e₀ he₀ S hS hSW) (fun a ha => chart_H2_of_away I e₀ _ ρ a ha)

end Chart

/-! ### (A1) Flat descent along a faithfully flat (e.g. local flat) target -/

section Descent

/-- **(A1)** If `B → S` is flat and `C → S` is faithfully flat (`B → C → S`), then `C` is flat over `B`.
(Same statement as TN `HironakaActualPolynomialAnalyticFlatness.flat_of_faithfully_flat_target`, reproved here
without its analytic import closure.) -/
theorem flat_of_flat_of_faithfullyFlat (B C S : Type*) [CommRing B] [CommRing C] [CommRing S]
    [Algebra B C] [Algebra B S] [Algebra C S] [IsScalarTower B C S]
    [Module.Flat B S] [Module.FaithfullyFlat C S] : Module.Flat B C := by
  rw [Module.Flat.iff_lTensor_injectiveₛ]
  intro M _ _ N
  rw [← TensorProduct.AlgebraTensorModule.coe_lTensor (A := C)]
  apply (Module.FaithfullyFlat.lTensor_injective_iff_injective C S
    (TensorProduct.AlgebraTensorModule.lTensor C C N.subtype)).mp
  have h := Module.Flat.lTensor_preserves_injective_linearMap (M := S) N.subtype Subtype.val_injective
  rw [← TensorProduct.AlgebraTensorModule.coe_lTensor (A := S)] at h
  rw [← TensorProduct.AlgebraTensorModule.coe_lTensor (A := S)]
  rw [← EquivLike.comp_injective _ (TensorProduct.AlgebraTensorModule.cancelBaseChange B C S S M),
    ← LinearEquiv.coe_coe, ← LinearMap.coe_comp,
    ← TensorProduct.AlgebraTensorModule.lTensor_comp_cancelBaseChange, LinearMap.coe_comp,
    LinearEquiv.coe_coe]
  exact h.comp (TensorProduct.AlgebraTensorModule.cancelBaseChange B C S S N).injective

/-- **(A1), local form**: `B → C → S` with `C → S` a flat local homomorphism of local rings (e.g. `S` the
completion of a Noetherian local `C`) and `B → S` flat: then `C` is flat over `B`. -/
theorem flat_of_flat_of_isLocalHom (B C S : Type*) [CommRing B] [CommRing C] [CommRing S]
    [Algebra B C] [Algebra B S] [Algebra C S] [IsScalarTower B C S] [IsLocalRing C] [IsLocalRing S]
    [Module.Flat C S] [IsLocalHom (algebraMap C S)] [Module.Flat B S] : Module.Flat B C := by
  have : Module.FaithfullyFlat C S := Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact flat_of_flat_of_faithfullyFlat B C S

end Descent

end SGPT.Unibranch.HironakaG10LfStrictFlat
