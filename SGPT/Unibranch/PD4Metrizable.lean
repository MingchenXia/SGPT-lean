import SGPT.Unibranch.ComplexSpaceLocalEmbedding
import Mathlib.Topology.Metrizable.Urysohn
import Mathlib.Topology.MetricSpace.Gluing
import Mathlib.Topology.EMetricSpace.Paracompact
import Mathlib.Topology.Compactness.Paracompact
import Mathlib.Topology.Compactness.LocallyCompact

/-!
# Complex spaces are metrizable; their open subsets are paracompact

The book's complex spaces are reduced, Hausdorff and paracompact (standing assumptions of
Appendix B, `def:unibranch:L21`), and the open subspace `X \ Z` of `thm:GRexten2` must again be a
complex space. Paracompactness is not inherited by open subsets of an arbitrary paracompact
space, so the library's open subspace (`HironakaG11BlowupLocality.openSubspace`) asks for it as an
instance. Here it is proved for every subset of every complex space.

* `metrizableSpace_of_locally_secondCountable`: a paracompact, locally compact Hausdorff space in
  which every point has a second-countable open neighbourhood is metrizable (the case of the
  Smirnov metrization theorem needed here). Proof: take a locally finite open refinement `V` of
  the interiors of compact neighbourhoods `K x ⊆ W x` (`W x` second countable); a compact set meets
  only finitely many `V j`, so the classes of the equivalence relation generated by
  "`V i ∩ V j ≠ ∅`" are countable; the union of the `V j` of a class is clopen and is covered by
  countably many second-countable open sets `W j`, hence it is second countable and regular,
  hence metrizable (Urysohn); `X` is homeomorphic to the topological sum of these pieces, which is
  metrizable (`Metric.Sigma.metricSpace`).
* `metrizableSpace`: every `SourceReducedComplexSpace` is metrizable (local embeddings into `ℂ^N`
  are second countable, analytic models are locally compact).
* `paracompactSpace_subtype`, instance `paracompactSpace_opens`: every subset (in particular every
  open subset) of a complex space is paracompact.

Lane PD4, blueprint `pd4.tex`.
-/

set_option autoImplicit false

open Set Filter Topology TopologicalSpace CategoryTheory AlgebraicGeometry

noncomputable section

namespace SGPT.Unibranch.PD4

/-! ### Countability of overlap classes -/

section Reach

variable {ι : Type*} (r : ι → ι → Prop)

/-- The indices reached from `a` by at most `n` steps of `r`. -/
def reach (a : ι) : ℕ → Set ι
  | 0 => {a}
  | n + 1 => reach a n ∪ ⋃ i ∈ reach a n, {j | r i j}

theorem reach_finite (hr : ∀ i, {j | r i j}.Finite) (a : ι) : ∀ n, (reach r a n).Finite
  | 0 => finite_singleton a
  | n + 1 => (reach_finite hr a n).union ((reach_finite hr a n).biUnion fun i _ => hr i)

/-- For a relation with finite fibres, the indices reachable from `a` form a countable set. -/
theorem countable_setOf_reflTransGen (hr : ∀ i, {j | r i j}.Finite) (a : ι) :
    {b | Relation.ReflTransGen r a b}.Countable := by
  refine (countable_iUnion fun n => (reach_finite r hr a n).countable).mono ?_
  intro b hb
  induction hb with
  | refl => exact mem_iUnion.mpr ⟨0, mem_singleton a⟩
  | tail _ hbc ih =>
    obtain ⟨n, hn⟩ := mem_iUnion.mp ih
    exact mem_iUnion.mpr ⟨n + 1, Or.inr (mem_iUnion₂.mpr ⟨_, hn, hbc⟩)⟩

variable {r}

theorem reflTransGen_symm (hr : ∀ i j, r i j → r j i) {a b : ι}
    (h : Relation.ReflTransGen r a b) : Relation.ReflTransGen r b a := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hbc ih => exact Relation.ReflTransGen.head (hr _ _ hbc) ih

end Reach

/-! ### Metrization -/

/-- **Metrization of paracompact, locally second-countable spaces.** A paracompact, locally
compact Hausdorff space in which every point has a second-countable open neighbourhood is
metrizable. -/
theorem metrizableSpace_of_locally_secondCountable (X : Type*) [TopologicalSpace X] [T2Space X]
    [ParacompactSpace X] [LocallyCompactSpace X]
    (h : ∀ x : X, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧ SecondCountableTopology W) :
    MetrizableSpace X := by
  classical
  choose W hWo hxW hWsc using h
  choose K hK hxK hKW using fun x : X => exists_compact_subset (hWo x) (hxW x)
  obtain ⟨V, hVo, hVc, hVlf, hVK⟩ := precise_refinement (fun x : X => interior (K x))
    (fun _ => isOpen_interior) (iUnion_eq_univ_iff.mpr fun x => ⟨x, hxK x⟩)
  let r : X → X → Prop := fun i j => (V i ∩ V j).Nonempty
  have hr_symm : ∀ i j, r i j → r j i := fun i j h => by
    obtain ⟨y, hy⟩ := h
    exact ⟨y, hy.2, hy.1⟩
  have hr_fin : ∀ i, {j | r i j}.Finite := fun i =>
    (hVlf.finite_nonempty_inter_compact (hK i)).subset fun j hj => by
      obtain ⟨y, hyi, hyj⟩ := hj
      exact ⟨y, hyj, interior_subset (hVK i hyi)⟩
  let s : Setoid X := ⟨Relation.ReflTransGen r, ⟨fun _ => Relation.ReflTransGen.refl,
    fun h => reflTransGen_symm hr_symm h, fun h₁ h₂ => h₁.trans h₂⟩⟩
  choose idx hidx using fun x : X => iUnion_eq_univ_iff.mp hVc x
  let f : X → Quotient s := fun x => Quotient.mk s (idx x)
  have hf : ∀ y j : X, y ∈ V j → f y = Quotient.mk s j := fun y j hy =>
    Quotient.sound (Relation.ReflTransGen.single ⟨y, hidx y, hy⟩)
  have hfo : ∀ q : Quotient s, IsOpen (f ⁻¹' {q}) := by
    intro q
    rw [isOpen_iff_forall_mem_open]
    intro x hx
    refine ⟨V (idx x), fun y hy => ?_, hVo _, hidx x⟩
    change f y = q
    rw [hf y (idx x) hy]
    exact hx
  have hfsc : ∀ q : Quotient s, SecondCountableTopology (f ⁻¹' {q}) := by
    intro q
    induction q using Quotient.inductionOn with
    | h a =>
    let I := {j : X // Relation.ReflTransGen r a j}
    have : Countable I := (countable_setOf_reflTransGen r hr_fin a).to_subtype
    let U : I → Set (f ⁻¹' {Quotient.mk s a}) := fun j => Subtype.val ⁻¹' W j.val
    have hU : ∀ j, SecondCountableTopology (U j) := by
      intro j
      have : SecondCountableTopology (W j.val) := hWsc j.val
      let g : U j → W j.val := fun z => ⟨z.val.val, z.property⟩
      have hg : Continuous g := (continuous_subtype_val.comp continuous_subtype_val).subtype_mk _
      have he : IsEmbedding g := by
        apply IsEmbedding.of_comp hg continuous_subtype_val
        change IsEmbedding ((Subtype.val : f ⁻¹' {Quotient.mk s a} → X) ∘
          (Subtype.val : U j → f ⁻¹' {Quotient.mk s a}))
        exact IsEmbedding.subtypeVal.comp IsEmbedding.subtypeVal
      exact he.secondCountableTopology
    have := hU
    apply secondCountableTopology_of_countable_cover (U := U)
      (fun j => (hWo j.val).preimage continuous_subtype_val)
    rw [iUnion_eq_univ_iff]
    rintro ⟨x, hx⟩
    have hx' : Quotient.mk s a = Quotient.mk s (idx x) := (show f x = Quotient.mk s a from hx).symm
    exact ⟨⟨idx x, Quotient.exact hx'⟩, hKW _ (interior_subset (hVK _ (hidx x)))⟩
  have hmet : ∀ q, MetrizableSpace (f ⁻¹' {q}) := fun q => by
    have := hfsc q
    infer_instance
  let e : (Σ q : Quotient s, (f ⁻¹' {q} : Set X)) ≃ X := Equiv.sigmaFiberEquiv f
  have hec : Continuous e := continuous_sigma_iff.mpr fun q => continuous_subtype_val
  have heo : IsOpenMap e := isOpenMap_sigma.mpr fun q => (hfo q).isOpenMap_subtype_val
  let E := e.toHomeomorphOfContinuousOpen hec heo
  let : ∀ q, MetricSpace (f ⁻¹' {q}) := fun q => by
    have := hmet q
    exact metrizableSpaceMetric _
  let : MetricSpace (Σ q : Quotient s, (f ⁻¹' {q} : Set X)) := Metric.Sigma.metricSpace
  have : MetrizableSpace (Σ q : Quotient s, (f ⁻¹' {q} : Set X)) := inferInstance
  exact E.symm.isEmbedding.metrizableSpace

/-! ### Complex spaces -/

open SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending SourceReducedComplexSpace

/-- Complex spaces are locally compact (closed analytic subsets of open subsets of `ℂ^N`). -/
theorem locallyCompactSpace (X : SourceReducedComplexSpace) : LocallyCompactSpace X.obj.left := by
  have : T2Space X.obj.left := X.property.1
  have : WeaklyLocallyCompactSpace X.obj.left := by
    refine ⟨fun x => ?_⟩
    let e := LocalEmbedding.ofPoint X x
    obtain ⟨c, hc⟩ := LocalEmbedding.mem_range_ofPoint X x
    have : LocallyCompactSpace e.ambient := e.ambient.isOpen.locallyCompactSpace
    have : LocallyCompactSpace e.carrier := e.analytic.isClosed.locallyCompactSpace
    obtain ⟨L, hL, hcL⟩ := exists_compact_mem_nhds c
    refine ⟨e.toPoint '' L, hL.image e.isOpenEmbedding_toPoint.continuous, ?_⟩
    rw [← hc]
    exact e.isOpenEmbedding_toPoint.image_mem_nhds.mpr hcL
  infer_instance

/-- Every point of a complex space has a second-countable open neighbourhood (the image of a
local embedding into `ℂ^N`). -/
theorem exists_secondCountable_nhds (X : SourceReducedComplexSpace) (x : X.obj.left) :
    ∃ W : Set X.obj.left, IsOpen W ∧ x ∈ W ∧ SecondCountableTopology W :=
  let e := LocalEmbedding.ofPoint X x
  ⟨range e.toPoint, e.isOpen_range_toPoint, LocalEmbedding.mem_range_ofPoint X x,
    e.isOpenEmbedding_toPoint.isEmbedding.toHomeomorph.symm.isEmbedding.secondCountableTopology⟩

/-- **Complex spaces are metrizable** (Hausdorff, paracompact, locally compact and locally second
countable). -/
theorem metrizableSpace (X : SourceReducedComplexSpace) : MetrizableSpace X.obj.left := by
  have : T2Space X.obj.left := X.property.1
  have : ParacompactSpace X.obj.left := X.property.2.1
  have : LocallyCompactSpace X.obj.left := locallyCompactSpace X
  exact metrizableSpace_of_locally_secondCountable _ (exists_secondCountable_nhds X)

/-- Every subset of a complex space is metrizable. -/
theorem metrizableSpace_subtype (X : SourceReducedComplexSpace) (s : Set X.obj.left) :
    MetrizableSpace s := by
  have := metrizableSpace X
  infer_instance

/-- Every subset of a complex space is paracompact (metrizable spaces are paracompact). -/
theorem paracompactSpace_subtype (X : SourceReducedComplexSpace) (s : Set X.obj.left) :
    ParacompactSpace s := by
  have := metrizableSpace_subtype X s
  let : MetricSpace s := metrizableSpaceMetric s
  infer_instance

/-- **Open subsets of complex spaces are paracompact**: the instance required by the library's
open subspace `HironakaG11BlowupLocality.openSubspace`. -/
instance paracompactSpace_opens (X : SourceReducedComplexSpace) (V : Opens X.obj.left) :
    ParacompactSpace V :=
  paracompactSpace_subtype X (V : Set X.obj.left)

end SGPT.Unibranch.PD4
