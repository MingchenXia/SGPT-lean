import SGPT.Unibranch.GAGA2LocalIrreducibility
import SGPT.Foundations.Analysis.Pending.HironakaActualTaylorFaithfullyFlat
import Mathlib.RingTheory.Ideal.Quotient.Nilpotent

/-!
# From the formal completion to the analytic germ

Let `I ⊆ ℂ[z₁, …, zₙ]` and `c ∈ V(I)`. The local ring of `𝒳 = Spec ℂ[z]/I` at `c` has
completion `ℂ[[z - c]]/I·ℂ[[z - c]]`; in coordinates centred at `c` this is
`ℂ[[z]]/formalPointIdeal I c`, where `formalPointIdeal I c` is generated by the translated
polynomials `p(z + c)`, `p ∈ I`.

The Taylor map `𝒪_{ℂⁿ,0} → ℂ[[z]]` is faithfully flat
(`HironakaActualTaylorFaithfullyFlat.originalTaylorAlgHom_faithfullyFlat`); every ideal of
`𝒪_{ℂⁿ,0}` is the contraction of its extension (`comap_map_originalTaylorAlgHom`). Hence the
radical of `I𝒪_{ℂⁿ,c}` is the contraction of the radical of `I·ℂ[[z - c]]`. The germ
vanishing ideal `modelStalkIdeal I c` of `V(I)` at `c` is this radical (it lies between `I𝒪`
and `√(I𝒪)` by Rückert's Nullstellensatz, and it is radical because the model stalk is
reduced). So:

* `modelStalkIdeal_isPrime_of_formal`: if `I·ℂ[[z - c]]` has a prime radical (the completion
  of `𝒪_{𝒳,c}` has a unique minimal prime), then the analytic germ of `V(I)` at `c` is
  irreducible;
* `sourceUnibranchReducedRing_modelStalk_of_formal`, `polynomialZeroSetComplexSpace_isUnibranch_of_formal`:
  in that case the complex space `V(I)` is unibranch at `c` (resp. everywhere).

This is the second half of the book's proof of `prop:unibranch_gaga` ("`\widehat{𝒪_{𝒳,x}} =
\widehat{𝒪_{𝒳^{An},x}}` integral implies `𝒪_{𝒳^{An},x}` unibranch"), with the Henselian
input of `GAGA2Henselian`. The first half ("`𝒳` unibranch at `x` ⟹ the completion has a
unique minimal prime", which the book takes from excellence, EGA IV 18.9.1) remains open.

Blueprint: `claude-serre-gaga.tex`.
-/

set_option autoImplicit false

open TopologicalSpace
open SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
open SGPT.Foundations.Analysis.Pending.HironakaActualOriginalFormalTaylor
  (originalTaylorAlgHom originalTaylorAlgHom_coordinate)
open SGPT.Foundations.Analysis.Pending.HironakaActualFormalIdealContraction
  (comap_map_originalTaylorAlgHom)
open SGPT.Foundations.Analysis.Pending.HironakaActualOriginalTaylorPolynomial
  (originalPolynomialEval)
open SGPT.Foundations.Analysis.Pending.HironakaReducedComplexAnalyticSpaces (modelOver)

namespace SGPT.Unibranch

noncomputable section

/-! ### Radicals and contraction along a map with `comap ∘ map = id` -/

/-- If every ideal of `R` is the contraction of its extension along `φ` (e.g. `φ` faithfully
flat), then the radical of an ideal is the contraction of the radical of its extension. -/
theorem radical_eq_comap_radical_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : ∀ J : Ideal R, (J.map φ).comap φ = J) (J : Ideal R) :
    J.radical = ((J.map φ).radical).comap φ := by
  ext x
  simp only [Ideal.mem_radical_iff, Ideal.mem_comap]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, by rw [← map_pow]; exact Ideal.mem_map_of_mem φ hk⟩
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [← hφ J, Ideal.mem_comap, map_pow]
    exact hk

variable {n : ℕ}

/-! ### The Taylor map in the coordinates of `ℂⁿ` -/

/-- The Taylor map `𝒪_{ℂⁿ,0} → ℂ[[z₁, …, zₙ]]`, in the germ ring indexed by `n`. -/
def taylorRingHom (n : ℕ) : HolGerm (ComplexModel n) →+* MvPowerSeries (Fin n) ℂ :=
  (originalTaylorAlgHom n).toRingHom.comp (germDimensionRingEquiv (Nat.zero_add n)).symm.toRingHom

/-- Every ideal of `𝒪_{ℂⁿ,0}` is the contraction of its formal extension. -/
theorem comap_map_taylorRingHom (J : Ideal (HolGerm (ComplexModel n))) :
    (J.map (taylorRingHom n)).comap (taylorRingHom n) = J := by
  set e := germDimensionRingEquiv (Nat.zero_add n)
  have hmap : J.map (taylorRingHom n) =
      (J.map e.symm.toRingHom).map (originalTaylorAlgHom n).toRingHom := by
    rw [taylorRingHom, Ideal.map_map]
  have hcomap : ∀ K : Ideal (MvPowerSeries (Fin n) ℂ), K.comap (taylorRingHom n) =
      (K.comap (originalTaylorAlgHom n).toRingHom).comap e.symm.toRingHom := by
    intro K
    rw [taylorRingHom, Ideal.comap_comap]
  rw [hmap, hcomap, comap_map_originalTaylorAlgHom]
  ext g
  simp only [Ideal.mem_comap]
  constructor
  · intro h
    obtain ⟨y, hy, hye⟩ := (Ideal.mem_map_iff_of_surjective _ e.symm.surjective).mp h
    have : y = g := e.symm.injective hye
    exact this ▸ hy
  · intro h
    exact Ideal.mem_map_of_mem _ h

/-- The translation `p ↦ p(z + c)` followed by the inclusion of polynomials into power
series: the formal expansion of polynomials at the point `c`. -/
def formalPointMap (c : Fin n → ℂ) : MvPolynomial (Fin n) ℂ →+* MvPowerSeries (Fin n) ℂ :=
  (MvPolynomial.coeToMvPowerSeries.ringHom).comp
    (PolynomialPointAnalyticMap.polynomialTranslation c).toAlgHom.toRingHom

/-- The Taylor series of the polynomial germ of `p` at `c` is the formal expansion of `p` at
`c`. -/
theorem taylorRingHom_polynomialPointGerm (c : Fin n → ℂ) :
    (taylorRingHom n).comp (polynomialPointGerm c) = formalPointMap c := by
  have hpoly : ((originalTaylorAlgHom n).comp (originalPolynomialEval n)) =
      (MvPolynomial.coeToMvPowerSeries.algHom ℂ : MvPolynomial (Fin n) ℂ →ₐ[ℂ] _) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, MvPolynomial.coeToMvPowerSeries.algHom_apply, originalPolynomialEval,
      MvPolynomial.aeval_X, originalTaylorAlgHom_coordinate]
    simp
  refine RingHom.ext fun p => ?_
  have h1 := congrArg (fun φ => φ ((PolynomialPointAnalyticMap.polynomialTranslation c) p)) hpoly
  simp only [AlgHom.comp_apply, MvPolynomial.coeToMvPowerSeries.algHom_apply,
    Algebra.algebraMap_self] at h1
  simp only [taylorRingHom, polynomialPointGerm, formalPointMap, RingHom.comp_apply,
    RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.symm_apply_apply,
    AlgHom.toRingHom_eq_coe, MvPolynomial.coeToMvPowerSeries.ringHom_apply]
  rw [MvPowerSeries.map_id] at h1
  exact h1

/-- The ideal `I·ℂ[[z - c]]`, written in coordinates centred at `c`: the ideal of
`ℂ[[z₁, …, zₙ]]` generated by the translated polynomials `p(z + c)`, `p ∈ I`. -/
def formalPointIdeal (I : Ideal (MvPolynomial (Fin n) ℂ)) (c : Fin n → ℂ) :
    Ideal (MvPowerSeries (Fin n) ℂ) :=
  I.map (formalPointMap c)

/-- The radical of `I𝒪_{ℂⁿ,c}` is the contraction of the radical of `I·ℂ[[z - c]]`. -/
theorem radical_map_polynomialPointGerm (I : Ideal (MvPolynomial (Fin n) ℂ)) (c : Fin n → ℂ) :
    (I.map (polynomialPointGerm c)).radical =
      ((formalPointIdeal I c).radical).comap (taylorRingHom n) := by
  rw [radical_eq_comap_radical_map (taylorRingHom n) comap_map_taylorRingHom, Ideal.map_map,
    taylorRingHom_polynomialPointGerm]
  rfl

/-! ### Consequences for the embedded affine complex space -/

variable (I : Ideal (MvPolynomial (Fin n) ℂ))

/-- The germ vanishing ideal of `V(I)` at `x` is radical: the model stalk is reduced. -/
theorem modelStalkIdeal_isRadical (x : polynomialZeroSet I) :
    (modelStalkIdeal I x.val).IsRadical := by
  rw [Ideal.isRadical_iff_quotient_reduced]
  have : IsReduced ((modelOver (⊤ : Opens (ComplexModel n)) (polynomialZeroSet I)).left.presheaf.stalk
      x).carrier := (polynomialZeroSetComplexSpace I).isReduced_stalk x
  exact isReduced_of_injective (modelStalkEquiv I x).symm.toRingHom
    (modelStalkEquiv I x).symm.injective

/-- **The germ vanishing ideal is the radical of `I𝒪`.** -/
theorem modelStalkIdeal_eq_radical (x : polynomialZeroSet I) :
    modelStalkIdeal I x.val =
      (I.map (polynomialPointGerm (complexCoordinates (x.val : ComplexModel n)))).radical := by
  refine le_antisymm (modelStalkIdeal_le_radical I x.val) ?_
  rw [← (modelStalkIdeal_isRadical I x).radical]
  exact Ideal.radical_mono (map_le_modelStalkIdeal I x.val)

/-- **Formal irreducibility implies analytic irreducibility.** If `I·ℂ[[z - c]]` has a prime
radical at the point `c` of `V(I)` (the completion of `𝒪_{𝒳,c}` has a unique minimal prime),
then the germ vanishing ideal of `V(I)` at `c` is prime. -/
theorem modelStalkIdeal_isPrime_of_formal (x : polynomialZeroSet I)
    (h : (formalPointIdeal I (complexCoordinates (x.val : ComplexModel n))).radical.IsPrime) :
    (modelStalkIdeal I x.val).IsPrime := by
  rw [modelStalkIdeal_eq_radical, radical_map_polynomialPointGerm]
  exact Ideal.comap_isPrime _ _

/-- At a point with formally irreducible completion, the complex space `V(I)` is unibranch
(`def:unibranch:L21`). -/
theorem sourceUnibranchReducedRing_modelStalk_of_formal (x : polynomialZeroSet I)
    (h : (formalPointIdeal I (complexCoordinates (x.val : ComplexModel n))).radical.IsPrime) :
    SourceUnibranchReducedRing
      ((polynomialZeroSetComplexSpace I).obj.left.presheaf.stalk x).carrier := by
  refine ((polynomialZeroSetComplexSpace I).sourceUnibranchReducedRing_stalk_iff x).mpr ?_
  have := modelStalkIdeal_isPrime_of_formal I x h
  exact (modelStalkEquiv I x).toMulEquiv.isDomain_iff.mpr
    ((Ideal.Quotient.isDomain_iff_prime _).mpr this)

/-- **"Formally unibranch ⟹ `V(I)` unibranch".** If at every point `c ∈ V(I)` the ideal
`I·ℂ[[z - c]]` has a prime radical, then the complex space `V(I)` is unibranch. -/
theorem polynomialZeroSetComplexSpace_isUnibranch_of_formal
    (h : ∀ x : polynomialZeroSet I,
      (formalPointIdeal I (complexCoordinates (x.val : ComplexModel n))).radical.IsPrime) :
    (polynomialZeroSetComplexSpace I).IsUnibranch :=
  fun x => sourceUnibranchReducedRing_modelStalk_of_formal I x (h x)

end

end SGPT.Unibranch
