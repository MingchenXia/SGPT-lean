import SGPT.Unibranch.UnibAlgPowerSeries
import Mathlib.RingTheory.MvPowerSeries.Substitution
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Artinian.Ring
import Mathlib.RingTheory.HopkinsLevitzki
import Mathlib.RingTheory.Ideal.Quotient.Noetherian
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Analysis.Complex.Basic

/-!
# The completion of a finite algebra over a polynomial ring

Let `R = ℂ[z₁, …, zₙ] / I` (presented by a surjection `φ`), `c ∈ V(I)`, and let
`P₀ = ℂ[w₁, …, w_d] → R` be a finite algebra map sending every `wᵢ` into the maximal ideal of
`c`. Write `T = ℂ⟦z - c⟧`, `T₀ = ℂ⟦w⟧` and `B = T / I T`, the formal completion of `R` at `c`.
The finite `T₀`-algebra `S = T₀ ⊗_{P₀} R` maps to `B` (`bridgeMap`: `wᵢ ↦ wᵢ(z)` by formal
substitution, `R → B` by Taylor expansion at `c`), and this map is the localization of `S` at
the maximal ideal `M_c = ker χ`, `χ : S → ℂ` the evaluation at `(0, c)`:

* `bridgeMap_surjective`: the map is surjective (complete Nakayama over `T₀`, using that
  `(z - c)ᴺ ⊆ (w) T + I T` because `R / (w) R` is Artinian);
* `bridgeMap_eq_zero`: its kernel is killed by elements outside `M_c` (the truncations
  `B → S / 𝔪ᵏ` and Krull's intersection theorem in the Noetherian ring `S`);
* `isUnit_bridgeMap`: elements outside `M_c` become units.

This identifies the formal completion of `R` at `c` with a localization of the base change of
`R` along `P₀ → ℂ⟦w⟧`, so that the primitive-element and normality arguments over `P₀` reach
the completion (lane UNIB-ALG, step U3 of `claude-serre-gaga.tex`; blueprint
`claude-unib-alg.tex`).
-/

set_option autoImplicit false

open MvPowerSeries TensorProduct

namespace SGPT.Unibranch.UnibAlg

noncomputable section

variable {n : ℕ}

/-! ### Translation and formal expansion at a point -/

/-- Translation of polynomials: `p ↦ p(z + c)`. -/
def transl (c : Fin n → ℂ) : MvPolynomial (Fin n) ℂ →ₐ[ℂ] MvPolynomial (Fin n) ℂ :=
  MvPolynomial.aeval fun i => MvPolynomial.X i + MvPolynomial.C (c i)

theorem transl_X (c : Fin n → ℂ) (i : Fin n) :
    transl c (MvPolynomial.X i) = MvPolynomial.X i + MvPolynomial.C (c i) :=
  MvPolynomial.aeval_X _ _

theorem transl_transl_neg (c : Fin n → ℂ) (p : MvPolynomial (Fin n) ℂ) :
    transl c (transl (-c) p) = p := by
  have h : (transl c).comp (transl (-c)) = AlgHom.id ℂ _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [transl_X]
  exact congrArg (fun f : MvPolynomial (Fin n) ℂ →ₐ[ℂ] MvPolynomial (Fin n) ℂ => f p) h

theorem transl_neg_transl (c : Fin n → ℂ) (p : MvPolynomial (Fin n) ℂ) :
    transl (-c) (transl c p) = p := by
  simpa using transl_transl_neg (-c) p

theorem eval_transl (c x : Fin n → ℂ) (p : MvPolynomial (Fin n) ℂ) :
    MvPolynomial.eval x (transl c p) = MvPolynomial.eval (x + c) p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [transl]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => rw [map_mul, MvPolynomial.eval_mul, hp, transl_X]; simp

/-- The formal expansion at `c`: `p ↦ p(z + c) ∈ ℂ⟦z⟧`. -/
def fpm (c : Fin n → ℂ) : MvPolynomial (Fin n) ℂ →ₐ[ℂ] MvPowerSeries (Fin n) ℂ :=
  (MvPolynomial.coeToMvPowerSeries.algHom ℂ).comp (transl c)

theorem fpm_apply (c : Fin n → ℂ) (p : MvPolynomial (Fin n) ℂ) :
    fpm c p = ((transl c p : MvPolynomial (Fin n) ℂ) : MvPowerSeries (Fin n) ℂ) := by
  simp [fpm]

theorem constantCoeff_fpm (c : Fin n → ℂ) (p : MvPolynomial (Fin n) ℂ) :
    constantCoeff (fpm c p) = MvPolynomial.eval c p := by
  have h1 : constantCoeff (fpm c p) = MvPolynomial.constantCoeff (transl c p) := by
    rw [fpm_apply, ← coeff_zero_eq_constantCoeff_apply, MvPolynomial.coeff_coe,
      MvPolynomial.constantCoeff_eq]
  rw [h1, ← MvPolynomial.eval_zero, eval_transl, zero_add]

theorem fpm_transl_neg (c : Fin n → ℂ) (q : MvPolynomial (Fin n) ℂ) :
    fpm c (transl (-c) q) = (q : MvPowerSeries (Fin n) ℂ) := by
  rw [fpm_apply, transl_transl_neg]

/-- The polynomials vanishing at `c`, generated by the `zᵢ - cᵢ`. -/
def pointIdealSpan (c : Fin n → ℂ) : Ideal (MvPolynomial (Fin n) ℂ) :=
  Ideal.span (Set.range fun i => MvPolynomial.X i - MvPolynomial.C (c i))

theorem fpm_X_sub_C (c : Fin n → ℂ) (i : Fin n) :
    fpm c (MvPolynomial.X i - MvPolynomial.C (c i)) = X i := by
  simp [fpm_apply, transl_X]

theorem map_pointIdealSpan (c : Fin n → ℂ) :
    (pointIdealSpan c).map (fpm c) = spanX (Fin n) ℂ := by
  rw [pointIdealSpan, Ideal.map_span, ← Set.range_comp]
  congr 1
  ext f
  simp [fpm_X_sub_C]

theorem eval_eq_zero_of_mem_pointIdealSpan (c : Fin n → ℂ) {p : MvPolynomial (Fin n) ℂ}
    (hp : p ∈ pointIdealSpan c) : MvPolynomial.eval c p = 0 := by
  have : pointIdealSpan c ≤ RingHom.ker (MvPolynomial.eval c) := by
    rw [pointIdealSpan, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp
  exact this hp

/-- Truncation `ℂ⟦z⟧ → ℂ[z] / (z - c)ᵏ`, inverse to the formal expansion at `c` modulo
`(z - c)ᵏ`. -/
def thetaTrunc (c : Fin n → ℂ) (k : ℕ) :
    MvPowerSeries (Fin n) ℂ →+* MvPolynomial (Fin n) ℂ ⧸ pointIdealSpan c ^ k :=
  (Ideal.quotientMap (pointIdealSpan c ^ k) (transl (-c)).toRingHom (by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    change Ideal.map _ (Ideal.span (Set.range MvPolynomial.X)) ≤ _
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨i, ?_⟩
    simp [transl_X, sub_eq_add_neg])).comp
    (truncTotalAlgHom (Fin n) ℂ k).toRingHom

theorem thetaTrunc_fpm (c : Fin n → ℂ) (k : ℕ) (p : MvPolynomial (Fin n) ℂ) :
    thetaTrunc c k (fpm c p) = Ideal.Quotient.mk _ p := by
  rw [thetaTrunc, RingHom.comp_apply, fpm_apply]
  have h1 : (truncTotalAlgHom (Fin n) ℂ k).toRingHom ((transl c p : MvPolynomial (Fin n) ℂ) :
      MvPowerSeries (Fin n) ℂ) = Ideal.Quotient.mk _ (transl c p) :=
    (truncTotalAlgHom (Fin n) ℂ k).commutes (transl c p)
  rw [h1, Ideal.quotientMap_mk]
  simp [transl_neg_transl]

/-! ### Two general lemmas -/

theorem map_mk_pow_eq_bot {A : Type*} [CommRing A] (J : Ideal A) (k : ℕ) :
    (J.map (Ideal.Quotient.mk (J ^ k))) ^ k = ⊥ := by
  rw [← Ideal.map_pow, Ideal.map_quotient_self]

theorem eq_zero_of_mem_pow_of_le {A Q : Type*} [CommRing A] [CommRing Q] (F : A →+* Q)
    {𝔫 : Ideal Q} {k : ℕ} (h𝔫 : 𝔫 ^ k = ⊥) {I : Ideal A} (hI : I ≤ Ideal.comap F 𝔫) {G : A}
    (hG : G ∈ I ^ k) : F G = 0 := by
  have h3 := (Ideal.pow_right_mono hI k).trans (Ideal.le_comap_pow F k)
  rw [h𝔫] at h3
  have := h3 hG
  rwa [Ideal.mem_comap, Ideal.mem_bot] at this

/-- In an Artinian ring, a power of a maximal ideal `m` is killed by an element outside `m`. -/
theorem exists_mul_pow_eq_zero_of_isArtinianRing {A : Type*} [CommRing A] [IsArtinianRing A]
    (m : Ideal A) [m.IsMaximal] : ∃ s ∉ m, ∃ N : ℕ, ∀ x ∈ m ^ N, s * x = 0 := by
  classical
  set L := Localization.AtPrime m
  obtain ⟨N, hN⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := L)
  rw [IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal m L, ← Ideal.map_pow] at hN
  obtain ⟨G, hG⟩ := (IsNoetherian.noetherian (m ^ N) : (m ^ N).FG)
  have hgen : ∀ g ∈ G, ∃ u : m.primeCompl, (u : A) * g = 0 := by
    intro g hg
    have hgm : g ∈ m ^ N := hG ▸ Ideal.subset_span hg
    have : algebraMap A L g = 0 := by
      have hN' : Ideal.map (algebraMap A L) (m ^ N) = ⊥ := hN
      have := Ideal.mem_map_of_mem (algebraMap A L) hgm
      rwa [hN', Ideal.mem_bot] at this
    exact (IsLocalization.map_eq_zero_iff m.primeCompl L g).mp this
  choose! u hu using hgen
  refine ⟨∏ g ∈ G, (u g : A), ?_, N, ?_⟩
  · exact (Submonoid.prod_mem m.primeCompl fun g _ => (u g).2)
  · intro x hx
    rw [← hG] at hx
    induction hx using Submodule.span_induction with
    | mem g hg =>
      rw [← Finset.prod_erase_mul _ _ hg, mul_assoc, hu g hg, mul_zero]
    | zero => rw [mul_zero]
    | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]

/-! ### The bridge data -/

/-- Data for the comparison: `R` presented as a quotient of `ℂ[z₁, …, zₙ]` by `φ`, a point
`c` of the zero set, and a finite `ℂ[w₁, …, w_d]`-algebra structure on `R` whose generators
`wᵢ` are the images of polynomials `yᵢ` vanishing at `c`. -/
structure BridgeData (n d : ℕ) (R : Type*) [CommRing R] [Algebra ℂ R]
    [Algebra (MvPolynomial (Fin d) ℂ) R] where
  /-- The presentation. -/
  φ : MvPolynomial (Fin n) ℂ →ₐ[ℂ] R
  surj : Function.Surjective φ
  /-- The point. -/
  c : Fin n → ℂ
  hc : ∀ p, φ p = 0 → MvPolynomial.eval c p = 0
  /-- Lifts of the generators of `P₀`. -/
  y : Fin d → MvPolynomial (Fin n) ℂ
  hy : ∀ i, φ (y i) = algebraMap (MvPolynomial (Fin d) ℂ) R (MvPolynomial.X i)
  hy0 : ∀ i, MvPolynomial.eval c (y i) = 0

namespace BridgeData

variable {d : ℕ} {R : Type*} [CommRing R] [Algebra ℂ R] [Algebra (MvPolynomial (Fin d) ℂ) R]
  [IsScalarTower ℂ (MvPolynomial (Fin d) ℂ) R] (D : BridgeData n d R)

local notation "P₀" => MvPolynomial (Fin d) ℂ
local notation "T₀" => MvPowerSeries (Fin d) ℂ
local notation "T" => MvPowerSeries (Fin n) ℂ

/-- Evaluation at `c` on `R`. -/
def evR : R →+* ℂ :=
  (Ideal.Quotient.lift (RingHom.ker D.φ) (MvPolynomial.eval D.c) fun p hp => D.hc p hp).comp
    (Ideal.quotientKerAlgEquivOfSurjective D.surj).symm.toRingEquiv.toRingHom

omit [IsScalarTower ℂ P₀ R] in
theorem evR_φ (p : MvPolynomial (Fin n) ℂ) : D.evR (D.φ p) = MvPolynomial.eval D.c p := by
  simp [evR, Ideal.quotientKerAlgEquivOfSurjective_symm_apply]

theorem φ_aeval_y (p : P₀) : D.φ (MvPolynomial.aeval D.y p) = algebraMap P₀ R p := by
  have h : D.φ.comp (MvPolynomial.aeval D.y) = IsScalarTower.toAlgHom ℂ P₀ R := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [D.hy i]
  exact congrArg (fun f : P₀ →ₐ[ℂ] R => f p) h

omit [IsScalarTower ℂ P₀ R] in
theorem eval_aeval_y (p : P₀) :
    MvPolynomial.eval D.c (MvPolynomial.aeval D.y p) = MvPolynomial.eval 0 p := by
  have h : (MvPolynomial.eval D.c).comp (MvPolynomial.aeval D.y).toRingHom =
      MvPolynomial.eval (0 : Fin d → ℂ) := by
    apply MvPolynomial.ringHom_ext
    · intro a; simp
    · intro i; simp [D.hy0 i]
  exact congrArg (fun f : P₀ →+* ℂ => f p) h

theorem evR_algebraMap (p : P₀) : D.evR (algebraMap P₀ R p) = MvPolynomial.eval 0 p := by
  rw [← D.φ_aeval_y, evR_φ, eval_aeval_y]

/-- The substituted generators `yᵢ(z + c) ∈ ℂ⟦z⟧`. -/
def aT (i : Fin d) : T := fpm D.c (D.y i)

omit [IsScalarTower ℂ P₀ R] in
theorem constantCoeff_aT (i : Fin d) : constantCoeff (D.aT i) = 0 := by
  rw [aT, constantCoeff_fpm, D.hy0]

omit [IsScalarTower ℂ P₀ R] in
theorem hasSubst : HasSubst D.aT := hasSubst_of_constantCoeff_zero D.constantCoeff_aT

/-- The substitution `ℂ⟦w⟧ → ℂ⟦z⟧`, `wᵢ ↦ yᵢ(z + c)`. -/
def g₀ : T₀ →ₐ[ℂ] T := substAlgHom D.hasSubst

omit [IsScalarTower ℂ P₀ R] in
theorem g₀_coe (p : P₀) : D.g₀ (p : T₀) = fpm D.c (MvPolynomial.aeval D.y p) := by
  rw [g₀, substAlgHom_coe]
  have h := MvPolynomial.comp_aeval D.y (fpm D.c)
  exact (congrArg (fun f : P₀ →ₐ[ℂ] T => f p) h).symm

omit [IsScalarTower ℂ P₀ R] in
theorem g₀_X (i : Fin d) : D.g₀ (X i) = D.aT i := substAlgHom_X _ i

omit [IsScalarTower ℂ P₀ R] in
theorem constantCoeff_g₀ (t : T₀) : constantCoeff (D.g₀ t) = constantCoeff t := by
  have h0 : constantCoeff (D.g₀ (t - C (constantCoeff t))) = 0 := by
    rw [g₀, coe_substAlgHom]
    exact constantCoeff_subst_eq_zero D.hasSubst D.constantCoeff_aT (by simp)
  rw [map_sub, map_sub] at h0
  have h1 : D.g₀ (C (constantCoeff t)) = C (constantCoeff t) := by
    simpa [MvPowerSeries.algebraMap_apply] using D.g₀.commutes (constantCoeff t)
  rw [h1, constantCoeff_C, sub_eq_zero] at h0
  exact h0

/-- The ideal `I · ℂ⟦z - c⟧`. -/
def IT : Ideal T := (RingHom.ker D.φ).map (fpm D.c)

/-- The formal completion `B = ℂ⟦z - c⟧ / I`. -/
abbrev B := T ⧸ D.IT

omit [IsScalarTower ℂ P₀ R] in
theorem IT_le : D.IT ≤ RingHom.ker (constantCoeff (σ := Fin n) (R := ℂ)) := by
  rw [IT, Ideal.map_le_iff_le_comap]
  intro p hp
  rw [Ideal.mem_comap, RingHom.mem_ker]
  erw [constantCoeff_fpm]
  exact D.hc p hp

/-- Taylor expansion `R → B`. -/
def toB : R →+* D.B :=
  (Ideal.quotientMap D.IT (fpm D.c).toRingHom Ideal.le_comap_map).comp
    (Ideal.quotientKerAlgEquivOfSurjective D.surj).symm.toRingEquiv.toRingHom

omit [IsScalarTower ℂ P₀ R] in
theorem toB_φ (p : MvPolynomial (Fin n) ℂ) :
    D.toB (D.φ p) = Ideal.Quotient.mk D.IT (fpm D.c p) := by
  simp [toB, Ideal.quotientKerAlgEquivOfSurjective_symm_apply]

/-- `T₀ → B`. -/
def gB : T₀ →+* D.B := (Ideal.Quotient.mk D.IT).comp D.g₀.toRingHom

omit [IsScalarTower ℂ P₀ R] in
theorem gB_apply (t : T₀) : D.gB t = Ideal.Quotient.mk D.IT (D.g₀ t) := rfl

theorem compat (p : P₀) : D.toB (algebraMap P₀ R p) = D.gB (algebraMap P₀ T₀ p) := by
  rw [← D.φ_aeval_y, toB_φ, gB_apply]
  change _ = Ideal.Quotient.mk D.IT (D.g₀ (p : T₀))
  rw [g₀_coe]

/-- **The comparison map** `S = ℂ⟦w⟧ ⊗_{P₀} R → B`. -/
def bridgeMap : T₀ ⊗[P₀] R →+* D.B :=
  letI : Algebra P₀ D.B := (D.gB.comp (algebraMap P₀ T₀)).toAlgebra
  (Algebra.TensorProduct.lift
    ({ D.gB with commutes' := fun _ => rfl } : T₀ →ₐ[P₀] D.B)
    ({ D.toB with commutes' := fun p => D.compat p } : R →ₐ[P₀] D.B)
    (fun _ _ => Commute.all _ _)).toRingHom

theorem bridgeMap_tmul (t : T₀) (r : R) : D.bridgeMap (t ⊗ₜ r) = D.gB t * D.toB r := by
  simp [bridgeMap, Algebra.TensorProduct.lift_tmul]

/-- The residue map of `B`. -/
def χB : D.B →+* ℂ :=
  Ideal.Quotient.lift D.IT constantCoeff fun _ ha => D.IT_le ha

omit [IsScalarTower ℂ P₀ R] in
theorem χB_mk (F : T) : D.χB (Ideal.Quotient.mk D.IT F) = constantCoeff F := rfl

omit [IsScalarTower ℂ P₀ R] in
theorem χB_toB (r : R) : D.χB (D.toB r) = D.evR r := by
  obtain ⟨p, rfl⟩ := D.surj r
  rw [toB_φ, χB_mk, constantCoeff_fpm, evR_φ]

omit [IsScalarTower ℂ P₀ R] in
theorem χB_gB (t : T₀) : D.χB (D.gB t) = constantCoeff t := by
  rw [gB_apply, χB_mk, constantCoeff_g₀]

/-- The evaluation `χ : S → ℂ` at the point `(0, c)`; its kernel is `M_c`. -/
def χ : T₀ ⊗[P₀] R →+* ℂ := D.χB.comp D.bridgeMap

theorem χ_tmul (t : T₀) (r : R) : D.χ (t ⊗ₜ r) = constantCoeff t * D.evR r := by
  simp only [χ, RingHom.comp_apply, bridgeMap_tmul, map_mul, χB_gB, χB_toB]

/-! ### Units -/

omit [IsScalarTower ℂ P₀ R] in
theorem isUnit_of_χB_ne_zero {b : D.B} (hb : D.χB b ≠ 0) : IsUnit b := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [χB_mk] at hb
  exact (isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr hb)).map _

/-- Elements outside `M_c` become units in `B`. -/
theorem isUnit_bridgeMap {u : T₀ ⊗[P₀] R} (hu : D.χ u ≠ 0) : IsUnit (D.bridgeMap u) :=
  D.isUnit_of_χB_ne_zero hu

/-! ### The kernel -/

/-- The maximal ideal of `R` at `c`. -/
def mR : Ideal R := RingHom.ker D.evR

/-- The ideal of `S` generated by the maximal ideal of `R` at `c`. -/
def mS : Ideal (T₀ ⊗[P₀] R) :=
  D.mR.map (Algebra.TensorProduct.includeRight : R →ₐ[P₀] T₀ ⊗[P₀] R)

theorem algebraMap_X_mem_mR (i : Fin d) : algebraMap P₀ R (MvPolynomial.X i) ∈ D.mR := by
  rw [mR, RingHom.mem_ker, evR_algebraMap]
  simp

theorem χ_eq_zero_of_mem_mS {s : T₀ ⊗[P₀] R} (hs : s ∈ D.mS) : D.χ s = 0 := by
  have : D.mS ≤ RingHom.ker D.χ := by
    rw [mS, Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change D.χ (1 ⊗ₜ r) = 0
    rw [χ_tmul, (RingHom.mem_ker).mp hr, mul_zero]
  exact this hs

omit [IsScalarTower ℂ P₀ R] in
theorem pointIdealSpan_le (k : ℕ) :
    pointIdealSpan D.c ^ k ≤ Ideal.comap D.φ.toRingHom (D.mR ^ k) := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  apply Ideal.pow_right_mono
  rw [pointIdealSpan, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  change D.evR (D.φ _) = 0
  rw [evR_φ]
  simp

omit [IsScalarTower ℂ P₀ R] in
theorem mR_le (k : ℕ) :
    D.mR ^ k ≤ Ideal.comap (Algebra.TensorProduct.includeRight : R →ₐ[P₀] T₀ ⊗[P₀] R).toRingHom
      (D.mS ^ k) := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  rfl

/-- The truncation `ρ_k : B → S / 𝔪ᵏ`, a left inverse of the comparison map modulo `𝔪ᵏ`. -/
def ρ (k : ℕ) : D.B →+* (T₀ ⊗[P₀] R) ⧸ D.mS ^ k :=
  Ideal.Quotient.lift D.IT
    (((Ideal.quotientMap (D.mS ^ k) _ (D.mR_le k)).comp
      (Ideal.quotientMap (D.mR ^ k) D.φ.toRingHom (D.pointIdealSpan_le k))).comp
      (thetaTrunc D.c k)) (by
    intro F hF
    have : D.IT ≤ RingHom.ker (((Ideal.quotientMap (D.mS ^ k) _ (D.mR_le k)).comp
        (Ideal.quotientMap (D.mR ^ k) D.φ.toRingHom (D.pointIdealSpan_le k))).comp
        (thetaTrunc D.c k)) := by
      rw [IT, Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, RingHom.comp_apply]
      erw [thetaTrunc_fpm]
      rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      change Ideal.Quotient.mk _ (Algebra.TensorProduct.includeRight (D.φ p)) = 0
      rw [(RingHom.mem_ker).mp hp, map_zero, map_zero]
    exact (RingHom.mem_ker).mp (this hF))

omit [IsScalarTower ℂ P₀ R] in
theorem ρ_mk_fpm (k : ℕ) (p : MvPolynomial (Fin n) ℂ) :
    D.ρ k (Ideal.Quotient.mk D.IT (fpm D.c p)) = Ideal.Quotient.mk _ (1 ⊗ₜ D.φ p) := by
  rw [ρ, Ideal.Quotient.lift_mk, RingHom.comp_apply, RingHom.comp_apply]
  erw [thetaTrunc_fpm]
  rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk]
  rfl

omit [IsScalarTower ℂ P₀ R] in
theorem ρ_toB (k : ℕ) (r : R) : D.ρ k (D.toB r) = Ideal.Quotient.mk _ (1 ⊗ₜ r) := by
  obtain ⟨p, rfl⟩ := D.surj r
  rw [toB_φ, ρ_mk_fpm]

theorem ρ_gB (k : ℕ) (t : T₀) : D.ρ k (D.gB t) = Ideal.Quotient.mk _ (t ⊗ₜ 1) := by
  set F₁ : T₀ →+* (T₀ ⊗[P₀] R) ⧸ D.mS ^ k := (D.ρ k).comp D.gB
  set F₂ : T₀ →+* (T₀ ⊗[P₀] R) ⧸ D.mS ^ k :=
    (Ideal.Quotient.mk _).comp Algebra.TensorProduct.includeLeftRingHom
  have hpoly : ∀ p : P₀, F₁ (p : T₀) = F₂ (p : T₀) := by
    intro p
    change D.ρ k (D.gB (algebraMap P₀ T₀ p)) = Ideal.Quotient.mk _ (algebraMap P₀ T₀ p ⊗ₜ 1)
    rw [← D.compat, ρ_toB, Algebra.TensorProduct.tmul_one_eq_one_tmul]
  have hX : ∀ i : Fin d, F₁ (X i) ∈ D.mS.map (Ideal.Quotient.mk (D.mS ^ k)) ∧
      F₂ (X i) ∈ D.mS.map (Ideal.Quotient.mk (D.mS ^ k)) := by
    intro i
    have hmem : (1 : T₀) ⊗ₜ[P₀] algebraMap P₀ R (MvPolynomial.X i) ∈ D.mS :=
      Ideal.mem_map_of_mem _ (D.algebraMap_X_mem_mR i)
    constructor
    · change D.ρ k (D.gB (X i)) ∈ _
      rw [gB_apply, g₀_X, aT, ρ_mk_fpm, D.hy i]
      exact Ideal.mem_map_of_mem _ hmem
    · change Ideal.Quotient.mk _ ((X i : T₀) ⊗ₜ[P₀] (1 : R)) ∈ _
      have : (X i : T₀) = algebraMap P₀ T₀ (MvPolynomial.X i) := by
        rw [← MvPolynomial.coe_X]; rfl
      rw [this, Algebra.TensorProduct.tmul_one_eq_one_tmul]
      exact Ideal.mem_map_of_mem _ hmem
  have hkill : ∀ (F : T₀ →+* (T₀ ⊗[P₀] R) ⧸ D.mS ^ k),
      (∀ i, F (X i) ∈ D.mS.map (Ideal.Quotient.mk (D.mS ^ k))) →
      ∀ G ∈ spanX (Fin d) ℂ ^ k, F G = 0 := by
    intro F hF G hG
    refine eq_zero_of_mem_pow_of_le F (map_mk_pow_eq_bot D.mS k) ?_ hG
    rw [spanX, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hF i
  obtain ⟨p, G, hG, rfl⟩ := exists_coe_add_mem k t
  change F₁ ((p : T₀) + G) = F₂ ((p : T₀) + G)
  rw [map_add, map_add, hpoly, hkill F₁ (fun i => (hX i).1) G hG,
    hkill F₂ (fun i => (hX i).2) G hG]

theorem ρ_bridgeMap (k : ℕ) (s : T₀ ⊗[P₀] R) :
    D.ρ k (D.bridgeMap s) = Ideal.Quotient.mk _ s := by
  induction s using TensorProduct.induction_on with
  | zero => simp
  | tmul t r =>
    rw [bridgeMap_tmul, map_mul, ρ_gB, ρ_toB, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
      one_mul, mul_one]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]

theorem mem_mS_pow_of_bridgeMap_eq_zero {s : T₀ ⊗[P₀] R} (hs : D.bridgeMap s = 0) (k : ℕ) :
    s ∈ D.mS ^ k := by
  have h := D.ρ_bridgeMap k s
  rw [hs, map_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm

/-- **The kernel of the comparison map** is killed by elements outside `M_c`. -/
theorem bridgeMap_eq_zero [Module.Finite P₀ R] {s : T₀ ⊗[P₀] R} (hs : D.bridgeMap s = 0) :
    ∃ u : T₀ ⊗[P₀] R, D.χ u ≠ 0 ∧ u * s = 0 := by
  have : IsNoetherianRing (T₀ ⊗[P₀] R) := IsNoetherianRing.of_finite T₀ _
  have hmem : s ∈ (⨅ i : ℕ, D.mS ^ i • ⊤ : Submodule (T₀ ⊗[P₀] R) (T₀ ⊗[P₀] R)) := by
    rw [Submodule.mem_iInf]
    intro i
    rw [smul_eq_mul, Ideal.mul_top]
    exact D.mem_mS_pow_of_bridgeMap_eq_zero hs i
  obtain ⟨⟨r, hr⟩, hrs⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff D.mS s).mp hmem
  refine ⟨1 - r, ?_, ?_⟩
  · rw [map_sub, map_one, D.χ_eq_zero_of_mem_mS hr, sub_zero]
    exact one_ne_zero
  · rw [smul_eq_mul] at hrs
    rw [sub_mul, one_mul, hrs, sub_self]

/-! ### Surjectivity -/

/-- The ideal `(w) R`. -/
def 𝔞 (_D : BridgeData n d R) : Ideal R :=
  Ideal.span (Set.range fun i => algebraMap P₀ R (MvPolynomial.X i))

omit [IsScalarTower ℂ P₀ R] in
theorem 𝔞_eq_map : D.𝔞 = (Ideal.span (Set.range D.y)).map D.φ := by
  rw [𝔞, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  simp [D.hy i]

theorem 𝔞_le_mR : D.𝔞 ≤ D.mR := by
  rw [𝔞, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact D.algebraMap_X_mem_mR i

theorem algebraMap_sub_C_mem_𝔞 (p : P₀) :
    algebraMap P₀ R p - algebraMap ℂ R (MvPolynomial.eval 0 p) ∈ D.𝔞 := by
  have hp : p - MvPolynomial.C (MvPolynomial.eval 0 p) ∈ MvPolynomial.idealOfVars (Fin d) ℂ := by
    rw [← pow_one (MvPolynomial.idealOfVars (Fin d) ℂ), MvPolynomial.mem_pow_idealOfVars_iff']
    intro x hx
    have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (Nat.lt_one_iff.mp hx)
    subst hx0
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_zero_C, ← MvPolynomial.constantCoeff_eq,
      MvPolynomial.eval_zero, sub_self]
  have hmap : (MvPolynomial.idealOfVars (Fin d) ℂ).map (algebraMap P₀ R) ≤ D.𝔞 := by
    change (Ideal.span (Set.range MvPolynomial.X)).map _ ≤ _
    rw [Ideal.map_span, ← Set.range_comp]
    exact le_rfl
  have := hmap (Ideal.mem_map_of_mem (algebraMap P₀ R) hp)
  rwa [map_sub, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply ℂ P₀ R] at this

instance [Module.Finite P₀ R] : Module.Finite ℂ (R ⧸ D.𝔞) := by
  classical
  obtain ⟨m, β, hβ⟩ := Module.Finite.exists_fin (R := P₀) (M := R)
  refine ⟨⟨Finset.univ.image fun j => Ideal.Quotient.mk D.𝔞 (β j), ?_⟩⟩
  rw [eq_top_iff]
  rintro x -
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hr : r ∈ Submodule.span P₀ (Set.range β) := hβ ▸ Submodule.mem_top
  obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun P₀).mp hr
  rw [← hf, map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  have : Ideal.Quotient.mk D.𝔞 (f j • β j) =
      (MvPolynomial.eval 0 (f j)) • Ideal.Quotient.mk D.𝔞 (β j) := by
    rw [Algebra.smul_def, Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul,
      Ideal.Quotient.eq, ← sub_mul]
    exact Ideal.mul_mem_right _ _ (D.algebraMap_sub_C_mem_𝔞 (f j))
  rw [this]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

/-- Evaluation at `c` on `R / (w)`. -/
def evA : R ⧸ D.𝔞 →+* ℂ := Ideal.Quotient.lift D.𝔞 D.evR fun _ ha => (RingHom.mem_ker).mp (D.𝔞_le_mR ha)

theorem evA_surjective : Function.Surjective D.evA := by
  intro z
  refine ⟨Ideal.Quotient.mk _ (algebraMap ℂ R z), ?_⟩
  rw [evA, Ideal.Quotient.lift_mk, ← D.φ.commutes z, MvPolynomial.algebraMap_eq, evR_φ,
    MvPolynomial.eval_C]

/-- **The power `(z - c)ᴺ` lies in `(w) T + I T`.** -/
theorem exists_spanX_pow_le [Module.Finite P₀ R] :
    ∃ N : ℕ, spanX (Fin n) ℂ ^ N ≤ D.IT ⊔ Ideal.span (Set.range D.aT) := by
  have : IsArtinianRing (R ⧸ D.𝔞) := IsArtinianRing.of_finite ℂ _
  have : (RingHom.ker D.evA).IsMaximal := RingHom.ker_isMaximal_of_surjective _ D.evA_surjective
  obtain ⟨sbar, hs, N, hN⟩ := exists_mul_pow_eq_zero_of_isArtinianRing (RingHom.ker D.evA)
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective sbar
  obtain ⟨st, rfl⟩ := D.surj r
  have hst : MvPolynomial.eval D.c st ≠ 0 := by
    intro h
    apply hs
    rw [RingHom.mem_ker, evA, Ideal.Quotient.lift_mk, evR_φ, h]
  have hU : IsUnit (fpm D.c st) := by
    rw [isUnit_iff_constantCoeff, constantCoeff_fpm]
    exact isUnit_iff_ne_zero.mpr hst
  refine ⟨N, ?_⟩
  -- the generators
  have hkey : ∀ x ∈ pointIdealSpan D.c ^ N,
      fpm D.c x ∈ D.IT ⊔ Ideal.span (Set.range D.aT) := by
    intro x hx
    have h1 : D.φ (st * x) ∈ D.𝔞 := by
      have hxm : Ideal.Quotient.mk D.𝔞 (D.φ x) ∈ RingHom.ker D.evA ^ N := by
        have hφx : D.φ x ∈ D.mR ^ N := D.pointIdealSpan_le N hx
        have hle : D.mR ^ N ≤ Ideal.comap (Ideal.Quotient.mk D.𝔞) (RingHom.ker D.evA ^ N) := by
          refine (Ideal.pow_right_mono ?_ N).trans (Ideal.le_comap_pow _ N)
          intro r hr
          rw [Ideal.mem_comap, RingHom.mem_ker, evA, Ideal.Quotient.lift_mk]
          exact hr
        exact hle hφx
      have := hN _ hxm
      rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem] at this
      exact this
    have h2 : st * x ∈ Ideal.span (Set.range D.y) ⊔ RingHom.ker D.φ := by
      have := Ideal.mem_comap.mpr (show D.φ (st * x) ∈ (Ideal.span (Set.range D.y)).map D.φ from
        D.𝔞_eq_map ▸ h1)
      rwa [Ideal.comap_map_of_surjective _ D.surj, ← RingHom.ker_eq_comap_bot] at this
    have h3 : fpm D.c (st * x) ∈ D.IT ⊔ Ideal.span (Set.range D.aT) := by
      have hle : Ideal.span (Set.range D.y) ⊔ RingHom.ker D.φ ≤
          Ideal.comap (fpm D.c) (D.IT ⊔ Ideal.span (Set.range D.aT)) := by
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_sup, Ideal.map_span, ← Set.range_comp]
        exact sup_le (le_sup_of_le_right le_rfl) (le_sup_of_le_left le_rfl)
      exact hle h2
    rw [map_mul] at h3
    obtain ⟨u, hu⟩ := hU
    have := Ideal.mul_mem_left _ (↑u⁻¹ : MvPowerSeries (Fin n) ℂ) h3
    rwa [← mul_assoc, ← hu, Units.inv_mul, one_mul] at this
  rw [← map_pointIdealSpan, ← Ideal.map_pow, Ideal.map_le_iff_le_comap]
  exact hkey

/-- The ideal `(w) B`. -/
def 𝔶 : Ideal D.B := (spanX (Fin d) ℂ).map D.gB

omit [IsScalarTower ℂ P₀ R] in
theorem map_mk_le_𝔶 :
    (D.IT ⊔ Ideal.span (Set.range D.aT)).map (Ideal.Quotient.mk D.IT) ≤ D.𝔶 := by
  rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  have : Ideal.Quotient.mk D.IT (D.aT i) = D.gB (X i) := by rw [gB_apply, g₀_X]
  rw [SetLike.mem_coe, this]
  exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)

theorem exists_approx₀ [Module.Finite P₀ R] {m : ℕ} (β : Fin m → R)
    (hβ : Submodule.span P₀ (Set.range β) = ⊤) (b : D.B) :
    ∃ t : Fin m → T₀, b - ∑ j, D.gB (t j) * D.toB (β j) ∈ D.𝔶 := by
  obtain ⟨N, hN⟩ := D.exists_spanX_pow_le
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨q, G, hG, rfl⟩ := exists_coe_add_mem N F
  have hr : D.φ (transl (-D.c) q) ∈ Submodule.span P₀ (Set.range β) := hβ ▸ Submodule.mem_top
  obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun P₀).mp hr
  refine ⟨fun j => algebraMap P₀ T₀ (f j), ?_⟩
  have hsum : ∑ j, D.gB (algebraMap P₀ T₀ (f j)) * D.toB (β j) =
      Ideal.Quotient.mk D.IT (q : MvPowerSeries (Fin n) ℂ) := by
    simp_rw [← D.compat, ← map_mul, ← map_sum, ← Algebra.smul_def, hf, toB_φ, fpm_transl_neg]
  rw [hsum, map_add, add_sub_cancel_left]
  exact D.map_mk_le_𝔶 (Ideal.mem_map_of_mem _ (hN hG))

theorem exists_approx [Module.Finite P₀ R] {m : ℕ} (β : Fin m → R)
    (hβ : Submodule.span P₀ (Set.range β) = ⊤) (k : ℕ) (b : D.B) (hb : b ∈ D.𝔶 ^ k) :
    ∃ t : Fin m → T₀, (∀ j, t j ∈ spanX (Fin d) ℂ ^ k) ∧
      b - ∑ j, D.gB (t j) * D.toB (β j) ∈ D.𝔶 ^ (k + 1) := by
  classical
  rw [𝔶, ← Ideal.map_pow] at hb
  obtain ⟨L, f, g, hfg⟩ := Submodule.mem_span_set'.mp hb
  choose x hx hxg using fun l => (g l).2
  choose t ht using fun l => D.exists_approx₀ β hβ (f l)
  refine ⟨fun j => ∑ l, x l * t l j, fun j => Ideal.sum_mem _ fun l _ => Ideal.mul_mem_right _ _
    (hx l), ?_⟩
  have hident : b - ∑ j, D.gB (∑ l, x l * t l j) * D.toB (β j) =
      ∑ l, D.gB (x l) * (f l - ∑ j, D.gB (t l j) * D.toB (β j)) := by
    rw [← hfg]
    simp only [smul_eq_mul, map_sum, map_mul, Finset.sum_mul, mul_sub, Finset.sum_sub_distrib,
      Finset.mul_sum]
    rw [Finset.sum_comm (s := Finset.univ) (t := Finset.univ)]
    congr 1
    · exact Finset.sum_congr rfl fun l _ => by rw [← hxg l, mul_comm]
    · exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun j _ => by ring
  rw [hident]
  have hpow : D.𝔶 ^ k * D.𝔶 ≤ D.𝔶 ^ (k + 1) := by
    rw [pow_succ D.𝔶 k]
  refine Ideal.sum_mem _ fun l _ => hpow (Ideal.mul_mem_mul ?_ (ht l))
  rw [𝔶, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ (hx l)

omit [IsScalarTower ℂ P₀ R] in
theorem nontrivial_B : Nontrivial D.B := by
  refine nontrivial_of_ne 0 1 fun h => ?_
  have := congrArg D.χB h
  rw [map_zero, map_one] at this
  exact zero_ne_one this

omit [IsScalarTower ℂ P₀ R] in
theorem isLocalRing_B : IsLocalRing D.B :=
  haveI := D.nontrivial_B
  IsLocalRing.of_surjective' (Ideal.Quotient.mk D.IT) Ideal.Quotient.mk_surjective

omit [IsScalarTower ℂ P₀ R] in
theorem 𝔶_le_maximalIdeal :
    letI := D.isLocalRing_B
    D.𝔶 ≤ IsLocalRing.maximalIdeal D.B := by
  let := D.isLocalRing_B
  rw [𝔶, Ideal.map_le_iff_le_comap, spanX, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have := hu.map D.χB
  rw [χB_gB, constantCoeff_X] at this
  exact not_isUnit_zero this

/-- **The comparison map is surjective** (complete Nakayama over `ℂ⟦w⟧`). -/
theorem bridgeMap_surjective [Module.Finite P₀ R] : Function.Surjective D.bridgeMap := by
  classical
  let := D.isLocalRing_B
  obtain ⟨m, β, hβ⟩ := Module.Finite.exists_fin (R := P₀) (M := R)
  intro b
  have step : ∀ (k : ℕ) (t : Fin m → T₀), b - ∑ j, D.gB (t j) * D.toB (β j) ∈ D.𝔶 ^ k →
      ∃ t' : Fin m → T₀, (∀ j, t' j - t j ∈ spanX (Fin d) ℂ ^ k) ∧
        b - ∑ j, D.gB (t' j) * D.toB (β j) ∈ D.𝔶 ^ (k + 1) := by
    intro k t ht
    obtain ⟨u, hu, hu'⟩ := D.exists_approx β hβ k _ ht
    refine ⟨t + u, fun j => by rw [Pi.add_apply, add_sub_cancel_left]; exact hu j, ?_⟩
    convert hu' using 1
    simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    ring
  choose! nxt hnxt₁ hnxt₂ using step
  let sq : ℕ → Fin m → T₀ := fun k => Nat.rec (motive := fun _ => Fin m → T₀) 0
    (fun k t => nxt k t) k
  have hsq : ∀ k, b - ∑ j, D.gB (sq k j) * D.toB (β j) ∈ D.𝔶 ^ k := by
    intro k
    induction k with
    | zero => rw [pow_zero D.𝔶, Ideal.one_eq_top]; exact Submodule.mem_top
    | succ k ih => exact hnxt₂ k (sq k) ih
  have hinc : ∀ k j, sq (k + 1) j - sq k j ∈ spanX (Fin d) ℂ ^ k :=
    fun k j => hnxt₁ k (sq k) (hsq k) j
  have hcauchy : ∀ j {a b' : ℕ}, a ≤ b' → sq a j - sq b' j ∈ spanX (Fin d) ℂ ^ a := by
    intro j a b' hab
    induction b', hab using Nat.le_induction with
    | base => simp
    | succ b' hab ih =>
      have := Ideal.pow_le_pow_right hab (hinc b' j)
      rw [show sq a j - sq (b' + 1) j = (sq a j - sq b' j) - (sq (b' + 1) j - sq b' j) by ring]
      exact Ideal.sub_mem _ ih this
  have hprec : IsPrecomplete (spanX (Fin d) ℂ) T₀ := inferInstance
  choose L hL using fun j => hprec.prec (f := fun k => sq k j) (fun {a b'} hab => by
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    exact hcauchy j hab)
  refine ⟨∑ j, L j ⊗ₜ β j, ?_⟩
  rw [map_sum]
  simp_rw [bridgeMap_tmul]
  have hall : ∀ k, b - ∑ j, D.gB (L j) * D.toB (β j) ∈ (IsLocalRing.maximalIdeal D.B) ^ k := by
    intro k
    have h1 := hsq k
    have h2 : ∀ j, sq k j - L j ∈ spanX (Fin d) ℂ ^ k := by
      intro j
      have := hL j k
      rwa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at this
    have h3 : b - ∑ j, D.gB (L j) * D.toB (β j) = (b - ∑ j, D.gB (sq k j) * D.toB (β j)) +
        ∑ j, D.gB (sq k j - L j) * D.toB (β j) := by
      simp only [map_sub, sub_mul, Finset.sum_sub_distrib]
      ring
    have h4 : b - ∑ j, D.gB (L j) * D.toB (β j) ∈ D.𝔶 ^ k := by
      rw [h3]
      refine Ideal.add_mem _ h1 (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ ?_)
      rw [𝔶, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ (h2 j)
    exact Ideal.pow_right_mono D.𝔶_le_maximalIdeal k h4
  have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal D.B)
    (IsLocalRing.maximalIdeal.isMaximal D.B).ne_top
  have hmem : b - ∑ j, D.gB (L j) * D.toB (β j) ∈ (⊥ : Ideal D.B) := by
    rw [← hbot, Ideal.mem_iInf]
    exact hall
  rw [Ideal.mem_bot, sub_eq_zero] at hmem
  exact hmem.symm

end BridgeData

end

