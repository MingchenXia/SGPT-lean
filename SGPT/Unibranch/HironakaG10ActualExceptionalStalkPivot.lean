import SGPT.Foundations.Analysis.Pending.HironakaActualNativeExceptionalControlledStalk
import SGPT.Foundations.Analysis.Pending.BlowupStrictIdeal
import SGPT.Unibranch.HironakaG10AdaptedStalkIdeal

/-! The same supplied native blowup chart identifies its literal transported
pivot as a generator of the ENTIRE actual exceptional-divisor stalk ideal.
The source flattening and the native square remain explicit inputs; this does
not derive them for an arbitrary previously chosen point chart. -/
set_option autoImplicit false
open Set
open scoped Topology Manifold ContDiff
namespace SGPT.Unibranch.HironakaG10ActualExceptionalStalkPivot
noncomputable section
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass SGPT.Foundations.Analysis.Pending
  FirstPass.HolomorphicIdealSheaves FirstPass.BlowupSequences HolGerm
  BlowupFlatCoordinates BlowupExceptionalDivisor BlowupControlledTransform IdealWeightPowers
  HironakaSmoothSubmersionGermIdealColon HironakaHolomorphicJetChartInvariance
  HironakaActualHistoricalMovingCentreChart HironakaActualAnalyticBlowupTaylor
  HironakaActualNativeExceptionalControlledStalk HironakaHolomorphicJetMonomialSpan
  HironakaSmoothCentreRealDomainActualSheafStalk
  SGPT.Unibranch.HironakaG10AdaptedStalkIdeal

variable {n : ℕ} {X Y : Type}
  [TopologicalSpace X] [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]

/-- The actual exceptional-divisor stalk ideal is generated by the literal
pivot transported through the SAME adapted stalk equivalence. -/
theorem actual_exceptional_stalk_ideal_eq_span_transported_pivot
    {C : Set X} {π : Y → X} (hπ : IsBlowupAlong n C π) (y : Y)
    (A : Set (Fin n)) (e : Fin n) (he : e ∈ A) (b : Fin n → ℂ)
    (Φ : LocalHolomorphicEquivAt (chartAt (ComplexModel n) (π y) (π y)))
    (hFlat : ∀ {x : X}, x ∈ (chartAt (ComplexModel n) (π y)).source →
      chartAt (ComplexModel n) (π y) x ∈ Φ.source →
      (x ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) (π y) x) ∈ coordinateSubsetPlane A))
    (Θ : LocalHolomorphicEquivAt (chartAt (ComplexModel n) y y))
    (hΘsrc : Θ.source ⊆ (chartAt (ComplexModel n) y).target)
    (hΘ0 : Θ.toFun (chartAt (ComplexModel n) y y) = 0)
    (hSquare : ∀ z : Y, z ∈ (chartAt (ComplexModel n) y).source →
      chartAt (ComplexModel n) y z ∈ Θ.source → π z ∈ flatDomain Φ ∧
      Φ.toFun (chartAt (ComplexModel n) (π y) (π z)) =
        actualAnalyticBlowupMap A e b (Θ.toFun (chartAt (ComplexModel n) y z))) :
    let E := adaptedStalkEquiv y Θ hΘ0
    let t := E.symm (coordinateGerm e)
    E t = coordinateGerm e ∧
    actualWholeSheafStalkIdeal (exceptionalDivisor hπ).ideal y = Ideal.span {t} := by
  let E := adaptedStalkEquiv y Θ hΘ0
  let J := actualWholeSheafStalkIdeal (exceptionalDivisor hπ).ideal y
  have hpower := actual_native_exceptional_power_stalk hπ y A e he b Φ hFlat Θ hΘsrc hΘ0 hSquare 1
  have hchart : adaptedIdeal (exceptionalDivisor hπ).ideal y Θ hΘ0 = Ideal.span {coordinateGerm e} := by
    simpa only [BlowupStrictIdeal.idealPow_one_exceptionalDivisor hπ, pow_one] using hpower
  have hmap : Ideal.map E.toRingHom J = Ideal.span {coordinateGerm e} :=
    (map_actualWholeSheafStalkIdeal_adapted (exceptionalDivisor hπ).ideal y Θ hΘsrc hΘ0).trans hchart
  have hback : Ideal.map E.symm.toRingHom (Ideal.map E.toRingHom J) = J := by
    simpa only [RingEquiv.toRingHom_eq_coe] using (Ideal.map_of_equiv (I := J) E)
  refine ⟨E.apply_symm_apply _, ?_⟩
  calc
    J = Ideal.map E.symm.toRingHom (Ideal.map E.toRingHom J) := hback.symm
    _ = Ideal.map E.symm.toRingHom (Ideal.span {coordinateGerm e}) := by rw [hmap]
    _ = Ideal.span {E.symm (coordinateGerm e)} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
end
end SGPT.Unibranch.HironakaG10ActualExceptionalStalkPivot
