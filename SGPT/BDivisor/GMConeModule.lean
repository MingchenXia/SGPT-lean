import SGPT.GAGA.ChowBlImage
import SGPT.GAGA.ChowBlLift
import SGPT.GAGA.SerreM5Main
import SGPT.GAGA.SerreHomogeneous

/-!
# holomorphic maps from a projective manifold to `ℙᴹ` are locally polynomial

Source: the GAGA input "holomorphic maps between projective varieties are algebraic", used in
`rmk:bdiv:L749` (cofinality of the algebraized models), `rmk:valcurr` and `rmk:Abhyankar`
(resolutions of a normal projective variety).  Analytic half; the algebraic half is
`SGPT.BDivisor.GMMorphism`.

Let `X` be a compact complex manifold with a holomorphic embedding `ι : X → ℙᴺ`
(`IsHolomorphicEmbedding`) and `Ψ : X → ℙᴹ` a holomorphic map.  On `ℂ^{N+1}` consider the
subsheaf `𝓛 ⊆ 𝒪^{M+1}` (`graphModule ι Ψ`) of tuples `a` which, at the points `z ≠ 0` of the cone
over `ι(X)`, are proportional to a homogeneous lift `ŷ` of `Ψ(ι⁻¹[z])`
(`a_b ŷ_{b'} = a_{b'} ŷ_b`); it is the push-forward to `ℙᴺ` of the line bundle `Ψ^*𝒪(-1)` plus
`𝓘_{ι(X)} ⊗ 𝒪^{M+1}`.

* `exists_local_lift`: near every point of the punctured cone over `ι(X)` the map
  `z ↦ Ψ(ι⁻¹[z])` has a holomorphic homogeneous lift `φ` defined on an ambient neighbourhood,
  obtained through the holomorphic retraction onto `ι(X)` of lane H0-GAGA2's
  `exists_affine_graph`;
* hence near such a point `𝓛` is the intersection of the preimages of the ideal of the cone
  (coherent by Cartan, `isCoherentOn_coneIdeal`) under the holomorphic rows
  `a ↦ a_b φ_{b'} − a_{b'} φ_b`, so `𝓛` is coherent on `ℂ^{N+1} ∖ 0`
  (`isCoherentOn_graphModule`, Oka); it is `ℂ*`-invariant (`isConeInvariant_graphModule`);
* **`exists_polynomial_lifts`**: by Serre's Theorem A on `ℙᴺ` (lane SERRE-M34,
  `SGPT.GAGA.PN.serreTheoremA`) `𝓛(m)` is generated by finitely many global sections, which are
  tuples `P_k = (P_{k,b})_b` of homogeneous polynomials of degree `m`
  (`exists_isHomogeneous_eq_of_homogeneous`).  At every `x ∈ X` some `P_k(ι x) ≠ 0` (the local
  lift `φ`, which does not vanish, is a combination of the generators), and wherever
  `P_k(ι x) ≠ 0` one has `[P_k(ι x)] = Ψ(x)`.

So `Ψ` is given on the sets `{P_k ∘ ι ≠ 0}`, which cover `X`, by homogeneous polynomials in the
ambient coordinates.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace SGPT.BDivisor.GM

open Set Filter Topology Metric
open scoped Manifold ContDiff
open SGPT.Foundations.Analysis SGPT.Foundations.Analysis.FirstPass
open SGPT.Foundations.Analysis.Pending.OkaRelationSheaf
open SGPT.GAGA.Core SGPT.GAGA.PN SGPT.GAGA.H0S SGPT.GAGA.ChowBl
open SGPT.Projective SGPT.Projective.ComplexProjectiveSpace

/-! ### Finite intersections of coherent modules -/

section FiniteInf

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {ι κ : Type} [Fintype ι]

/-- The intersection of the modules `M_k`, `k ∈ s` (together with holomorphy, so that `s = ∅`
gives `𝒪^ι`). -/
def finInf (Mk : κ → GermModule E ι) (s : Finset κ) : GermModule E ι :=
  ⟨fun y a => HolTupleAt a y ∧ ∀ k ∈ s, (Mk k).mem y a⟩

/-- **Finite intersections of coherent modules are coherent** (Oka). -/
theorem coherentAt_finInf [DecidableEq κ] (hE : OkaProperty E) {Mk : κ → GermModule E ι}
    {x₀ : E} (hM : ∀ k, (Mk k).CoherentAt x₀) (s : Finset κ) : (finInf Mk s).CoherentAt x₀ := by
  induction s using Finset.induction_on with
  | empty =>
    refine GermModule.CoherentAt.of_eqOn
      (GermModule.top_isCoherentOn (X := E) (ι := ι) {x₀} x₀ rfl) univ_mem fun y _ a => ?_
    exact ⟨fun h => ⟨h, fun k hk => absurd hk (Finset.notMem_empty k)⟩, fun h => h.1⟩
  | insert k s hk ih =>
    refine ((hM k).inf hE ih).of_eqOn univ_mem fun y _ a => ⟨?_, ?_⟩
    · rintro ⟨h1, h2, h3⟩
      refine ⟨h2, fun l hl => ?_⟩
      rcases Finset.mem_insert.1 hl with rfl | hl
      · exact h1
      · exact h3 l hl
    · rintro ⟨h2, h3⟩
      exact ⟨h3 k (Finset.mem_insert_self k s), h2, fun l hl =>
        h3 l (Finset.mem_insert_of_mem hl)⟩

end FiniteInf

/-! ### Proportional vectors -/

/-- Two nonzero vectors with vanishing `2 × 2` minors define the same point of `ℙᴹ`. -/
theorem mk_eq_of_minors {M : ℕ} {u r : Fin (M + 1) → ℂ} (hu : u ≠ 0) (hr : r ≠ 0)
    (h : ∀ b b', u b * r b' = u b' * r b) : mk u hu = mk r hr := by
  obtain ⟨b', hb'⟩ : ∃ b', r b' ≠ 0 := by
    by_contra! h0
    exact hr (funext h0)
  refine (mk_eq_mk_iff hu hr).mpr ⟨u b' / r b', funext fun b => ?_⟩
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [div_mul_eq_mul_div, div_eq_iff hb']
  linear_combination (h b' b)

/-! ### The cone map and the graph module -/

section Cone

variable {n N M : ℕ} {X : Type*} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]

/-- `Ψ ∘ ι⁻¹` on `ι(X)` (arbitrary elsewhere). -/
def invMap (ι : X → ComplexProjectiveSpace N) (Ψ : X → ComplexProjectiveSpace M)
    (p : ComplexProjectiveSpace N) : ComplexProjectiveSpace M := by
  classical
  exact if h : ∃ x, ι x = p then Ψ h.choose else affinePoint 0 0

theorem invMap_apply {ι : X → ComplexProjectiveSpace N} (hι : Function.Injective ι)
    (Ψ : X → ComplexProjectiveSpace M) (x : X) : invMap ι Ψ (ι x) = Ψ x := by
  have h : ∃ x', ι x' = ι x := ⟨x, rfl⟩
  unfold invMap
  rw [dif_pos h]
  exact congrArg Ψ (hι h.choose_spec)

/-- `z ↦ Ψ(ι⁻¹[z])` on the cone over `ι(X)`. -/
def coneMap (ι : X → ComplexProjectiveSpace N) (Ψ : X → ComplexProjectiveSpace M)
    (z : ConeSpace N) : ComplexProjectiveSpace M :=
  invMap ι Ψ (pmk (WithLp.ofLp z))

theorem coneMap_eq {ι : X → ComplexProjectiveSpace N} (hι : Function.Injective ι)
    (Ψ : X → ComplexProjectiveSpace M) {z : ConeSpace N} {x : X}
    (hx : ι x = pmk (WithLp.ofLp z)) : coneMap ι Ψ z = Ψ x := by
  rw [coneMap, ← hx, invMap_apply hι]

theorem coneMap_smul (ι : X → ComplexProjectiveSpace N) (Ψ : X → ComplexProjectiveSpace M)
    {c : ℂ} (hc : c ≠ 0) (z : ConeSpace N) : coneMap ι Ψ (c • z) = coneMap ι Ψ z := by
  unfold coneMap
  congr 1
  rw [WithLp.ofLp_smul]
  by_cases hz : WithLp.ofLp z = 0
  · rw [hz, smul_zero]
  · exact pmk_smul hz hc

/-- **The graph module** `𝓛 ⊆ 𝒪^{M+1}` on `ℂ^{N+1}`: the germs at `y` of tuples `a`, holomorphic
near `y`, which at every point `z ≠ 0` of the cone over `ι(X)` near `y` are proportional to a
homogeneous lift of `Ψ(ι⁻¹[z])`. -/
def graphModule (ι : X → ComplexProjectiveSpace N) (Ψ : X → ComplexProjectiveSpace M) :
    GermModule (ConeSpace N) (Fin (M + 1)) :=
  ⟨fun y a => HolTupleAt a y ∧ ∀ᶠ z in 𝓝 y, z ∈ affineCone (range ι) → z ≠ 0 →
    ∀ b b', a b z * (coneMap ι Ψ z).rep b' = a b' z * (coneMap ι Ψ z).rep b⟩

/-- **`𝓛` is `ℂ*`-invariant.** -/
theorem isConeInvariant_graphModule (ι : X → ComplexProjectiveSpace N)
    (Ψ : X → ComplexProjectiveSpace M) : IsConeInvariant (graphModule ι Ψ) := by
  refine isConeInvariant_of_imp fun w _ c hc a ha => ?_
  obtain ⟨hhol, hvan⟩ := ha
  refine ⟨fun j => ?_, ?_⟩
  · have h1 : HolAt (a j) (c⁻¹ • (c • w)) := by rw [inv_smul_smul₀ hc]; exact hhol j
    exact h1.comp (continuous_const_smul c⁻¹) fun _ => differentiableAt_id.const_smul c⁻¹
  · filter_upwards [(tendsto_inv_smul_nhds hc w).eventually hvan] with z hz hzS hz0 b b'
    have h := hz (smul_mem_affineCone c⁻¹ hzS) (smul_ne_zero (inv_ne_zero hc) hz0) b b'
    rwa [coneMap_smul ι Ψ (inv_ne_zero hc)] at h

/-! ### The local holomorphic lift -/

variable [IsComplexManifold n X]

/-- A holomorphic map into `ℙᴹ`, read in the chart at `c` and the chart of `ℙᴹ` at `Ψ c`, is
differentiable at every point of the chart domain mapped into that chart. -/
theorem differentiableAt_chart_of_mdifferentiable {Ψ : X → ComplexProjectiveSpace M}
    (hΨ : MDifferentiable 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) Ψ) (c : X) {x : X}
    (hx : x ∈ (chartAt (ComplexModel n) c).source)
    (hxΨ : Ψ x ∈ (chartAt (ComplexModel M) (Ψ c)).source) :
    DifferentiableAt ℂ
      (fun w => chartAt (ComplexModel M) (Ψ c) (Ψ ((chartAt (ComplexModel n) c).symm w)))
      (chartAt (ComplexModel n) c x) := by
  have h := ((mdifferentiableAt_iff_of_mem_source hx hxΨ).mp (hΨ x)).2
  rw [modelWithCornersSelf_coe, Set.range_id, differentiableWithinAt_univ] at h
  exact h

variable [CompactSpace X]

/-- **The local holomorphic lift.** Near every point `y ≠ 0` of the cone over `ι(X)` there are an
open `U ∋ y` and functions `φ_b` holomorphic on `U` such that at every point `z ≠ 0` of the cone in
`U`, `φ(z) ≠ 0` is a homogeneous lift of `Ψ(ι⁻¹[z])`. -/
theorem exists_local_lift {ι : X → ComplexProjectiveSpace N}
    (hι : IsHolomorphicEmbedding (n := n) ι) {Ψ : X → ComplexProjectiveSpace M}
    (hΨ : MDifferentiable 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) Ψ)
    {y : ConeSpace N} (hy0 : y ≠ 0) (hy : y ∈ affineCone (range ι)) :
    ∃ U : Set (ConeSpace N), IsOpen U ∧ y ∈ U ∧ ∃ φ : Fin (M + 1) → ConeSpace N → ℂ,
      (∀ b, DifferentiableOn ℂ (φ b) U) ∧ ∀ z ∈ U, z ∈ affineCone (range ι) → z ≠ 0 →
        (fun b => φ b z) ≠ 0 ∧ ∃ t : ℂ, t ≠ 0 ∧ (coneMap ι Ψ z).rep = t • fun b => φ b z := by
  classical
  have hv : WithLp.ofLp y ≠ 0 := fun h => hy0 ((WithLp.ofLp_eq_zero 2).mp h)
  obtain ⟨c, hc⟩ := hy hv
  obtain ⟨i, hi⟩ : ∃ i, WithLp.ofLp y i ≠ 0 := by
    by_contra! h0
    exact hv (funext h0)
  have hp₀ : ι c ∈ (affineChart i).source := by
    rw [hc]
    exact (mk_mem_affineChart_source_iff i hv).mpr hi
  obtain ⟨-, L0, ε, O, gr, ψ, hε, hO, -, hψ, -, -, hgraph⟩ := exists_affine_graph hι c i hp₀
  set e := (complexChartAt (n := n) c).val with he
  set j := chartIndex (Ψ c) with hj
  have hjc : Ψ c ∈ (affineChart j).source := mem_affineChart_chartIndex (Ψ c)
  have hΨc : Continuous Ψ := hΨ.continuous
  -- the chart expression of `Ψ` near `c`
  set F : ComplexModel n → ComplexModel M := fun w => affineChart j (Ψ (e.symm w)) with hF
  set S : Set (ComplexModel n) := e.target ∩ e.symm ⁻¹' (Ψ ⁻¹' (affineChart j).source) with hS
  have hSo : IsOpen S :=
    e.isOpen_inter_preimage_symm ((affineChart j).open_source.preimage hΨc)
  have hFd : ∀ w ∈ S, DifferentiableAt ℂ F w := by
    intro w hw
    have hx : e.symm w ∈ (chartAt (ComplexModel n) c).source := e.map_target hw.1
    have h := differentiableAt_chart_of_mdifferentiable hΨ c hx hw.2
    have hw' : chartAt (ComplexModel n) c (e.symm w) = w := e.right_inv hw.1
    rw [hw'] at h
    exact h
  -- the retraction onto `ι(X)`, read in the chart `e`, and the lift
  set Y : ConeSpace N → ComplexModel N := fun z => affineRatio i (WithLp.ofLp z) with hY
  set Wf : ConeSpace N → ComplexModel n := fun z => ψ (L0 (Y z)).1 with hW
  set φ : Fin (M + 1) → ConeSpace N → ℂ := fun b z => affineLift j (F (Wf z)) b with hφ
  set A1 : Set (ConeSpace N) := {z | WithLp.ofLp z i ≠ 0} with hA1def
  have hA1 : IsOpen A1 :=
    isOpen_ne.preimage ((continuous_apply i).comp (PiLp.continuous_ofLp 2 _))
  have hYd : ∀ z ∈ A1, DifferentiableAt ℂ Y z := by
    intro z hz
    have h1 : DifferentiableAt ℂ (WithLp.ofLp : ConeSpace N → Fin (N + 1) → ℂ) z :=
      (PiLp.continuousLinearEquiv 2 ℂ fun _ : Fin (N + 1) => ℂ).differentiableAt
    exact (differentiableAt_affineRatio i hz).comp z h1
  set U1 : Set (ConeSpace N) := A1 ∩ Y ⁻¹' ball (affineChart i (ι c)) ε with hU1def
  have hU1 : IsOpen U1 :=
    ContinuousOn.isOpen_inter_preimage (fun z hz => (hYd z hz).continuousAt.continuousWithinAt)
      hA1 isOpen_ball
  have hWd : ∀ z ∈ U1, DifferentiableAt ℂ Wf z := by
    intro z hz
    have hO' : (L0 (Y z)).1 ∈ O := (hgraph _ hz.2).1
    have h2 : DifferentiableAt ℂ (fun y : ComplexModel N => (L0 y).1) (Y z) :=
      (ContinuousLinearMap.fst ℂ _ _ ∘L L0.toContinuousLinearMap).differentiableAt
    have h3 : DifferentiableAt ℂ (fun z => (L0 (Y z)).1) z := h2.comp z (hYd z hz.1)
    exact (hψ.differentiableAt (hO.mem_nhds hO')).comp z h3
  set U : Set (ConeSpace N) := U1 ∩ Wf ⁻¹' S with hUdef
  have hU : IsOpen U :=
    ContinuousOn.isOpen_inter_preimage (fun z hz => (hWd z hz).continuousAt.continuousWithinAt)
      hU1 hSo
  -- `y ∈ U`
  have hYy : Y y = affineChart i (ι c) := by
    rw [hc]
    exact (affineChart_mk i hv hi).symm
  have hyU1 : y ∈ U1 := ⟨hi, by rw [mem_preimage, hYy]; exact mem_ball_self hε⟩
  have hpt_y : affinePoint i (Y y) = ι c := by
    rw [hYy]
    exact (affineChart i).left_inv hp₀
  obtain ⟨hψt_y, hψι_y⟩ := (hgraph (Y y) hyU1.2).2.2
    (((hgraph (Y y) hyU1.2).2.1).mp (by rw [hpt_y]; exact mem_range_self c))
  have hWy : e.symm (Wf y) = c := hι.injective (hψι_y.trans hpt_y)
  have hyS : Wf y ∈ S := ⟨hψt_y, by
    show Ψ (e.symm (Wf y)) ∈ (affineChart j).source
    rw [hWy]
    exact hjc⟩
  refine ⟨U, hU, ⟨hyU1, hyS⟩, φ, fun b z hz => ?_, fun z hz hzc hz0 => ?_⟩
  · have h1 : DifferentiableAt ℂ (fun z => F (Wf z)) z := (hFd _ hz.2).comp z (hWd z hz.1)
    exact ((differentiable_affineLift_apply j b).differentiableAt.comp z h1).differentiableWithinAt
  · have hvz : WithLp.ofLp z ≠ 0 := fun h => hz0 ((WithLp.ofLp_eq_zero 2).mp h)
    have hvzi : WithLp.ofLp z i ≠ 0 := hz.1.1
    obtain ⟨x, hx⟩ := hzc hvz
    have hpt : affinePoint i (Y z) = mk (WithLp.ofLp z) hvz := (mk_eq_affinePoint i hvz hvzi).symm
    have hgr : (L0 (Y z)).2 = gr (L0 (Y z)).1 :=
      ((hgraph (Y z) hz.1.2).2.1).mp (by rw [hpt, ← hx]; exact mem_range_self x)
    obtain ⟨-, hψι⟩ := (hgraph (Y z) hz.1.2).2.2 hgr
    have hWz : e.symm (Wf z) = x := hι.injective (hψι.trans (hpt.trans hx.symm))
    have hcone : coneMap ι Ψ z = Ψ x :=
      coneMap_eq hι.injective Ψ (by rw [hx]; exact (pmk_eq_mk hvz).symm)
    have hsrc : Ψ x ∈ (affineChart j).source := by
      have := hz.2.2
      simp only [mem_preimage] at this
      rwa [hWz] at this
    have hΨx : Ψ x = mk (fun b => φ b z) (affineLift_ne_zero j _) := by
      show Ψ x = affinePoint j (F (Wf z))
      simp only [hF]
      rw [hWz]
      exact ((affineChart j).left_inv hsrc).symm
    refine ⟨affineLift_ne_zero j _, ?_⟩
    exact rep_smul (coneMap ι Ψ z) (affineLift_ne_zero j (F (Wf z))) (hcone.trans hΨx)

/-! ### Coherence -/

/-- **`𝓛` is coherent on `ℂ^{N+1} ∖ 0`.** Off the cone it is `𝒪^{M+1}`; near a point of the cone
it is the intersection of the preimages of the (Cartan-coherent) ideal of the cone under the rows
`a ↦ a_b φ_{b'} − a_{b'} φ_b` of the local lift (Oka). -/
theorem isCoherentOn_graphModule {ι : X → ComplexProjectiveSpace N}
    (hι : IsHolomorphicEmbedding (n := n) ι) {Ψ : X → ComplexProjectiveSpace M}
    (hΨ : MDifferentiable 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) Ψ) :
    (graphModule ι Ψ).IsCoherentOn (puncture (ConeSpace N)) := by
  classical
  have hS : IsComplexAnalyticSubset (n := N) (range ι) := by
    have h := isComplexAnalyticSubset_image hι (isComplexAnalyticSubset_univ (n := n) (M := X))
    rwa [image_univ] at h
  have hcl : IsClosed (affineCone (range ι)) :=
    isClosed_affineCone (isCompact_range hι.continuous).isClosed
  have hOka : OkaProperty (ConeSpace N) := okaProperty_of_finiteDimensional _
  intro y hy0
  by_cases hy : y ∈ affineCone (range ι)
  swap
  · refine GermModule.CoherentAt.of_eqOn
      (GermModule.top_isCoherentOn (X := ConeSpace N) (ι := Fin (M + 1)) {y} y rfl)
      (hcl.isOpen_compl.mem_nhds hy) fun z hz a => ⟨fun ha => ⟨ha, ?_⟩, fun ha => ha.1⟩
    filter_upwards [hcl.isOpen_compl.mem_nhds hz] with w hw hwc
    exact absurd hwc hw
  obtain ⟨U, hU, hyU, φ, hφd, hφ⟩ := exists_local_lift hι hΨ hy0 hy
  have hφh : ∀ b, ∀ z ∈ U, HolAt (φ b) z := fun b z hz =>
    Filter.eventually_of_mem (hU.mem_nhds hz) fun w hw => (hφd b).differentiableAt (hU.mem_nhds hw)
  -- the rows `a ↦ a_b φ_{b'} − a_{b'} φ_b`
  let A : Fin (M + 1) × Fin (M + 1) → Unit → Fin (M + 1) → ConeSpace N → ℂ :=
    fun p _ β z => (if β = p.1 then φ p.2 z else 0) - (if β = p.2 then φ p.1 z else 0)
  have hA : ∀ p (z : ConeSpace N) (a : Fin (M + 1) → ConeSpace N → ℂ),
      matApply (A p) a () z = a p.1 z * φ p.2 z - a p.2 z * φ p.1 z := by
    intro p z a
    simp only [matApply, A, sub_mul, Finset.sum_sub_distrib, ite_mul, zero_mul,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  have hAh : ∀ p, ∀ z ∈ U, ∀ (k : Unit) β, HolAt (A p k β) z := by
    intro p z hz k β
    have e1 : HolAt (fun w => if β = p.1 then φ p.2 w else 0) z := by
      by_cases h : β = p.1
      · simp only [h, if_true]; exact hφh p.2 z hz
      · simp only [h, if_false]; exact Eventually.of_forall fun _ => differentiableAt_const _
    have e2 : HolAt (fun w => if β = p.2 then φ p.1 w else 0) z := by
      by_cases h : β = p.2
      · simp only [h, if_true]; exact hφh p.1 z hz
      · simp only [h, if_false]; exact Eventually.of_forall fun _ => differentiableAt_const _
    exact e1.sub e2
  let Mk : Fin (M + 1) × Fin (M + 1) → GermModule (ConeSpace N) (Fin (M + 1)) :=
    fun p => (coneIdeal (range ι)).comap (A p)
  have hMk : ∀ p, (Mk p).CoherentAt y := fun p =>
    (isCoherentOn_coneIdeal hS y hy0).comap hOka (hAh p y hyU)
  refine (coherentAt_finInf hOka hMk Finset.univ).of_eqOn (Ω := U ∩ puncture (ConeSpace N))
    (inter_mem (hU.mem_nhds hyU) (isOpen_ne.mem_nhds hy0)) fun z hz a => ?_
  constructor
  · rintro ⟨ha, hall⟩
    refine ⟨ha, ?_⟩
    have hev : ∀ p, ∀ᶠ w in 𝓝 z, w ∈ affineCone (range ι) → matApply (A p) a () w = 0 :=
      fun p => (hall p (Finset.mem_univ p)).2.2
    filter_upwards [eventually_all.2 hev, hU.mem_nhds hz.1] with w hw hwU hwc hw0 b b'
    obtain ⟨-, t, -, hrep⟩ := hφ w hwU hwc hw0
    have h := hw (b, b') hwc
    rw [hA] at h
    rw [hrep]
    simp only [Pi.smul_apply, smul_eq_mul]
    linear_combination t * h
  · rintro ⟨ha, hev⟩
    refine ⟨ha, fun p _ => ⟨ha, ?_, ?_⟩⟩
    · have hfun : matApply (A p) a () = fun w => a p.1 w * φ p.2 w - a p.2 w * φ p.1 w :=
        funext fun w => hA p w a
      rw [hfun]
      exact ((ha p.1).mul (hφh p.2 z hz.1)).sub ((ha p.2).mul (hφh p.1 z hz.1))
    · filter_upwards [hev, hU.mem_nhds hz.1, isOpen_ne.mem_nhds hz.2] with w hw hwU hw0 hwc
      obtain ⟨-, t, ht, hrep⟩ := hφ w hwU hwc hw0
      have h := hw hwc hw0 p.1 p.2
      rw [hrep] at h
      simp only [Pi.smul_apply, smul_eq_mul] at h
      rw [hA]
      have h' : t * (a p.1 w * φ p.2 w - a p.2 w * φ p.1 w) = 0 := by linear_combination h
      exact (mul_eq_zero.mp h').resolve_left ht

/-! ### Polynomial lifts (Serre's Theorem A) -/

/-- **Holomorphic maps from a projective manifold to `ℙᴹ` are locally polynomial.** Let
`ι : X → ℙᴺ` be a holomorphic embedding of a compact complex manifold and `Ψ : X → ℙᴹ` holomorphic.
There are finitely many tuples `P_k = (P_{k,0}, …, P_{k,M})` of homogeneous polynomials of a common
degree `m` such that every `x ∈ X` has some `P_k(ι x) ≠ 0`, and `[P_k(ι x)] = Ψ(x)` whenever
`P_k(ι x) ≠ 0`. -/
theorem exists_polynomial_lifts {ι : X → ComplexProjectiveSpace N}
    (hι : IsHolomorphicEmbedding (n := n) ι) {Ψ : X → ComplexProjectiveSpace M}
    (hΨ : MDifferentiable 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel M) Ψ) :
    ∃ (m : ℕ) (μ : Type) (_ : Fintype μ) (P : μ → Fin (M + 1) → MvPolynomial (Fin (N + 1)) ℂ),
      (∀ k b, (P k b).IsHomogeneous m) ∧
      (∀ x : X, ∃ k, (fun b => MvPolynomial.eval (ι x).rep (P k b)) ≠ 0) ∧
      ∀ k (x : X) (h : (fun b => MvPolynomial.eval (ι x).rep (P k b)) ≠ 0),
        mk (fun b => MvPolynomial.eval (ι x).rep (P k b)) h = Ψ x := by
  classical
  obtain ⟨m₀, hm₀⟩ := serreTheoremA (N := N) (Fin (M + 1)) (graphModule ι Ψ)
    (isCoherentOn_graphModule hι hΨ) (isConeInvariant_graphModule ι Ψ)
  obtain ⟨μ, hμ, σ, hσh, hgen⟩ := hm₀ (m₀.toNat : ℤ) (Int.self_le_toNat m₀)
  have hpoly : ∀ k b, ∃ P : MvPolynomial (Fin (N + 1)) ℂ, P.IsHomogeneous m₀.toNat ∧
      ∀ z : ConeSpace N, z ≠ 0 → σ k b z = MvPolynomial.eval (fun i => z i) P := by
    intro k b
    refine SGPT.GAGA.exists_isHomogeneous_eq_of_homogeneous (m := m₀.toNat) ((hσh k).diff b)
      fun c z hc hz => ?_
    have h := (hσh k).hom z hz c hc b
    rwa [zpow_natCast] at h
  choose P hPh hPσ using hpoly
  have hval : ∀ k b (x : X), σ k b (coneRep (ι x)) = MvPolynomial.eval (ι x).rep (P k b) :=
    fun k b x => hPσ k b _ (coneRep_ne_zero _)
  have hcone : ∀ x : X, coneRep (ι x) ∈ affineCone (range ι) := fun x =>
    (mem_affineCone_coneRep_iff (ι x)).mpr (mem_range_self x)
  have hconeMap : ∀ x : X, coneMap ι Ψ (coneRep (ι x)) = Ψ x := fun x =>
    coneMap_eq hι.injective Ψ (by
      show ι x = pmk (WithLp.ofLp (WithLp.toLp 2 (ι x).rep))
      rw [WithLp.ofLp_toLp, pmk_rep])
  refine ⟨m₀.toNat, μ, hμ, P, hPh, fun x => ?_, fun k x h => ?_⟩
  · have hy0 := coneRep_ne_zero (ι x)
    obtain ⟨U, hU, hyU, φ, hφd, hφ⟩ := exists_local_lift hι hΨ hy0 (hcone x)
    have hmem : (graphModule ι Ψ).mem (coneRep (ι x)) φ := by
      refine ⟨fun b => Filter.eventually_of_mem (hU.mem_nhds hyU) fun w hw => (hφd b).differentiableAt
        (hU.mem_nhds hw), ?_⟩
      filter_upwards [hU.mem_nhds hyU] with w hwU hwc hw0 b b'
      obtain ⟨-, t, -, hrep⟩ := hφ w hwU hwc hw0
      rw [hrep]
      simp only [Pi.smul_apply, smul_eq_mul]
      ring
    obtain ⟨c, -, hc⟩ := (hgen.2 _ hy0 φ).mp hmem
    by_contra! hall
    apply (hφ _ hyU (hcone x) hy0).1
    funext b
    rw [(hc b).self_of_nhds]
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [hval k b x, congrFun (hall k) b, Pi.zero_apply, mul_zero]
  · have hy0 := coneRep_ne_zero (ι x)
    have hmem := hgen.gen_mem (show coneRep (ι x) ∈ puncture (ConeSpace N) from hy0) k
    have h1 := hmem.2.self_of_nhds (hcone x) hy0
    rw [hconeMap x] at h1
    refine (mk_eq_of_minors h (Ψ x).rep_ne_zero fun b b' => ?_).trans (mk_rep (Ψ x))
    have h2 := h1 b b'
    rwa [hval k b x, hval k b' x] at h2

end Cone

end SGPT.BDivisor.GM
