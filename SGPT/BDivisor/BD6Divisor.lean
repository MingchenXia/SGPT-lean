attribute [local instance] MvPolynomial.gradedAlgebra

local instance bd6DivTopology {X : Scheme.{0}} (h : X ⟶ Spec (.of ℂ)) :
    TopologicalSpace (SchemeComplexPoint h) := schemeAnalyticPointTopology h
local instance bd6DivCharts {X : Scheme.{0}} (h : X ⟶ Spec (.of ℂ)) (d : ℕ)
    [SmoothOfRelativeDimension d h] : ChartedSpace (ComplexModel d) (SchemeComplexPoint h) :=
  schemeAnalyticTNChartedSpace h d
local instance bd6DivManifold {X : Scheme.{0}} (h : X ⟶ Spec (.of ℂ)) (d : ℕ)
    [SmoothOfRelativeDimension d h] [IsSeparated h] [QuasiCompact h] :
    IsComplexManifold d (SchemeComplexPoint h) := schemeAnalyticTN_isComplexManifold h d

/-! ### Principal germ ideals -/

section Principal

variable {d : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel d) M]

theorem mem_span_mk_iff_isInSpanAt {p : M} {H : M → ℂ} (hH : HolomorphicAt d H p) (f : M → ℂ) :
    (∃ hf : HolomorphicAt d f p, NativeHolGerm.mk f hf ∈ Ideal.span {NativeHolGerm.mk H hH}) ↔
      IsInSpanAt (n := d) (· = H) p f := by
  rw [isInSpanAt_eq_iff]
  constructor
  · rintro ⟨hf, hmem⟩
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
    obtain ⟨C, hC, rfl⟩ := NativeHolGerm.exists_eq_mk c
    refine ⟨hf, C, hC, ?_⟩
    have := NativeHolGerm.mk_eq_mk_iff.mp (show NativeHolGerm.mk (fun y => C y * H y)
      (hC.mul hH) = NativeHolGerm.mk f hf from hc)
    exact this.symm
  · rintro ⟨hf, a, ha, hfa⟩
    refine ⟨hf, Ideal.mem_span_singleton'.mpr ⟨NativeHolGerm.mk a ha, ?_⟩⟩
    exact (NativeHolGerm.mk_eq_mk_iff (hf := ha.mul hH) (hg := hf)).mpr hfa.symm

/-- A principal generator may be multiplied by a unit. -/
theorem isInSpanAt_eq_congr_unit {p : M} {a b c : M → ℂ} (hc : HolomorphicAt d c p)
    (hcp : c p ≠ 0) (hab : a =ᶠ[𝓝 p] fun y => c y * b y) (f : M → ℂ) :
    IsInSpanAt (n := d) (· = a) p f ↔ IsInSpanAt (n := d) (· = b) p f := by
  rw [isInSpanAt_eq_iff, isInSpanAt_eq_iff]
  constructor
  · rintro ⟨hf, A, hA, hfA⟩
    refine ⟨hf, fun y => A y * c y, hA.mul hc, ?_⟩
    filter_upwards [hfA, hab] with y h1 h2
    rw [h1, h2]; ring
  · rintro ⟨hf, B, hB, hfB⟩
    refine ⟨hf, fun y => B y * (c y)⁻¹,
      hB.mul (RelativePrincipalizationSpan.holomorphicAt_inv hc hcp), ?_⟩
    have hne : ∀ᶠ y in 𝓝 p, c y ≠ 0 := hc.self_of_nhds.continuousAt.eventually_ne hcp
    filter_upwards [hfB, hab, hne] with y h1 h2 h3
    rw [h1, h2]; field_simp

end Principal

/-! ### Coordinate sections of `φ^*𝒪(1)` -/

section Coordinate

variable {V : Scheme.{0}} {r : ℕ} (φ : V ⟶ polynomialProj ℂ r) (n : ℕ)
  [SmoothOfRelativeDimension n (φ ≫ polynomialProjStructureMap ℂ r)]
  [IsSeparated (φ ≫ polynomialProjStructureMap ℂ r)] [QuasiCompact (φ ≫ polynomialProjStructureMap ℂ r)]
  (EV : ClosedProjectiveEmbedding (φ ≫ polynomialProjStructureMap ℂ r))

/-- The pulled-back coordinate section `φ^*y_k`, as a section of the first tensor power. -/
abbrev coordSection (k : Fin (r + 1)) :
    bundlePowerGlobalSections (originalMapHyperplaneBundle φ) 1 :=
  originalSectionUnit (originalMapCoordinateSection φ k)

/-- The point of `ℙʳ` of a complex point of `V`. -/
abbrev mapPoint (z : SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r)) :
    SchemeComplexPoint (polynomialProjStructureMap ℂ r) :=
  schemeComplexPointMap (φ ≫ polynomialProjStructureMap ℂ r) (polynomialProjStructureMap ℂ r) φ rfl z

theorem mem_atlas_opens {z : SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r)}
    {i : Fin (r + 1)} (hz : schemeComplexPointImage _ (mapPoint φ z) ∈
      coordOpen (identityEmbedding r) i) :
    schemeComplexPointImage _ z ∈ (originalMapHyperplaneAtlas φ).opens i := hz

/-- The germ of the coefficient of `φ^*y_k` in the frame `φ^*y_i`. -/
theorem frameGerm_coordSection (k i : Fin (r + 1))
    (z : SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r))
    (hz : schemeComplexPointImage _ z ∈ (originalMapHyperplaneAtlas φ).opens i) :
    schemeFramePowerSectionNativeGerm (φ ≫ polynomialProjStructureMap ℂ r) n z
        ((originalMapHyperplaneAtlas φ).frame i) hz 1 (coordSection φ k) =
      NativeHolGerm.mk (schemeOpenRegularFunction _ n EV _ (φ.app _ (ratio (identityEmbedding r) i k)))
        (schemeOpenRegularFunction_holomorphicAt _ n EV _ _ z hz) := by
  refine Eq.trans ?_ (schemeOpenRegularFunction_germ _ n EV
    (φ ⁻¹ᵁ coordOpen (identityEmbedding r) i) _ z hz).symm
  unfold schemeFramePowerSectionNativeGerm
  congr 2
  have h1 := originalSectionUnit_coefficients (originalMapCoordinateSection φ k)
    ((originalMapHyperplaneAtlas φ).frame i) (𝟙 _)
  have h2 := originalMapCoordinateSection_coefficients φ i k
  exact h1.trans h2

variable {φ n}

/-- The data of a morphism `φ = [u₀ : ⋯ : u_r]` on an open set `Nb`. -/
structure MapData (φ : V ⟶ polynomialProj ℂ r) (n : ℕ)
    [SmoothOfRelativeDimension n (φ ≫ polynomialProjStructureMap ℂ r)] where
  Nb : Set (SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r))
  u : Fin (r + 1) → SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r) → ℂ
  isOpen : IsOpen Nb
  hol : ∀ y ∈ Nb, ∀ k, HolomorphicAt n (u k) y
  ne : ∀ y ∈ Nb, (fun k => u k y) ≠ 0
  point : ∀ y (hy : y ∈ Nb), mapPoint φ y = polynomialProjNonzeroVectorPoint r ⟨fun k => u k y, ne y hy⟩

theorem MapData.mapPoint_eq_chart (D : MapData φ n) {y} (hy : y ∈ D.Nb) {i : Fin (r + 1)}
    (hi : D.u i y ≠ 0) :
    mapPoint φ y = polynomialProjVectorChartPoint r i (fun k => D.u k y) := by
  rw [D.point y hy]
  exact polynomialProjNonzeroVectorPoint_eq_chart r _ i hi

theorem MapData.mem_opens (D : MapData φ n) {y} (hy : y ∈ D.Nb) {i : Fin (r + 1)}
    (hi : D.u i y ≠ 0) :
    schemeComplexPointImage _ y ∈ (originalMapHyperplaneAtlas φ).opens i := by
  apply mem_atlas_opens
  rw [D.mapPoint_eq_chart hy hi]
  exact nativeVectorPoint_mem r i _ hi

include EV in
/-- In the frame `φ^*y_i` the coefficient germ of `φ^*y_k` is `u_k/u_i`. -/
theorem MapData.frameGerm_eq (D : MapData φ n) (k i : Fin (r + 1)) {z} (hz : z ∈ D.Nb)
    (hi : D.u i z ≠ 0) :
    schemeFramePowerSectionNativeGerm (φ ≫ polynomialProjStructureMap ℂ r) n z
        ((originalMapHyperplaneAtlas φ).frame i) (D.mem_opens hz hi) 1 (coordSection φ k) =
      NativeHolGerm.mk (fun y => D.u k y * (D.u i y)⁻¹)
        ((D.hol z hz k).mul (RelativePrincipalizationSpan.holomorphicAt_inv (D.hol z hz i) hi)) := by
  rw [frameGerm_coordSection φ n EV k i z (D.mem_opens hz hi)]
  apply NativeHolGerm.mk_eq_mk_iff.mpr
  have hne : ∀ᶠ y in 𝓝 z, D.u i y ≠ 0 :=
    (D.hol z hz i).self_of_nhds.continuousAt.eventually_ne hi
  filter_upwards [D.isOpen.mem_nhds hz, hne] with y hy hyi
  have hpt := D.mapPoint_eq_chart hy hyi
  have hmem : schemeComplexPointImage _ y ∈ φ ⁻¹ᵁ coordOpen (identityEmbedding r) i :=
    D.mem_opens hy hyi
  rw [originalRegularFunction_pullback (polynomialProjStructureMap ℂ r) φ n r EV
    (identityEmbedding r) _ _ y hmem]
  change schemeOpenRegularFunction _ r (identityEmbedding r) _ _ (mapPoint φ y) = _
  rw [hpt, nativeVectorPoint_ratio r i k _ hyi, div_eq_mul_inv]

/-- **The divisor of `φ^*y_k` is `div(u_k)`**: its analytic ideal is generated by `u_k`. -/
theorem MapData.coordSection_ideal_mem (D : MapData φ n) (k : Fin (r + 1)) {z} (hz : z ∈ D.Nb)
    (f : SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r) → ℂ) :
    (schemeSectionAnalyticIdeal _ n EV (originalMapHyperplaneAtlas φ) 1 (coordSection φ k)).mem z f ↔
      IsInSpanAt (n := n) (· = D.u k) z f := by
  obtain ⟨i, hi⟩ := exists_ne_zero_of_ne_zero (D.ne z hz)
  rw [schemeSectionAnalyticIdeal_mem_frame _ n EV _ 1 _ z ((originalMapHyperplaneAtlas φ).frame i)
    (D.mem_opens hz hi) f, D.frameGerm_eq EV k i hz hi, mem_span_mk_iff_isInSpanAt]
  refine isInSpanAt_eq_congr_unit (c := fun y => (D.u i y)⁻¹)
    (RelativePrincipalizationSpan.holomorphicAt_inv (D.hol z hz i) hi) (inv_ne_zero hi)
    (Eventually.of_forall fun y => mul_comm _ _) f

omit [IsSeparated (φ ≫ polynomialProjStructureMap ℂ r)]
  [QuasiCompact (φ ≫ polynomialProjStructureMap ℂ r)] in
/-- The coordinate section `φ^*y_k` is nonzero as soon as `φ` meets `D₊(y_k)`. -/
theorem coordSection_ne_zero (k : Fin (r + 1)) {z : SchemeComplexPoint (φ ≫ polynomialProjStructureMap ℂ r)}
    (hz : schemeComplexPointImage _ z ∈ (originalMapHyperplaneAtlas φ).opens k) :
    coordSection φ k ≠ 0 := by
  rw [Ne, ← not_ne_iff, not_not, originalSectionUnit_ne_zero_iff]
  intro h0
  have h2 := originalMapCoordinateSection_coefficients φ k k
  rw [h0, map_zero, map_zero, ratio_self, map_one] at h2
  have h3 := congrArg (V.presheaf.germ _ (schemeComplexPointImage _ z) hz) h2
  rw [map_zero, map_one] at h3
  exact zero_ne_one h3

end Coordinate

end SGPT.BDivisor.BD6
