attribute [local instance] MvPolynomial.gradedAlgebra

local instance bd5SmoothTopology {X : Scheme.{0}} (h : X ⟶ Spec (.of ℂ)) :
    TopologicalSpace (SchemeComplexPoint h) := schemeAnalyticPointTopology h
local instance bd5SmoothCharts (N : ℕ) :
    ChartedSpace (ComplexModel N) (SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :=
  schemeAnalyticTNChartedSpace _ N
local instance bd5SmoothManifold (N : ℕ) :
    IsComplexManifold N (SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :=
  schemeAnalyticTN_isComplexManifold _ N
local instance bd5SmoothCompact (N : ℕ) :
    CompactSpace (SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :=
  (identityEmbedding N).analyticCompact

/-- The native projective point map `ℙᴺ(ℂ) → ℙᴺ` (a homeomorphism). -/
abbrev nativeProj (N : ℕ) : SchemeComplexPoint (polynomialProjStructureMap ℂ N) →
    ComplexProjectiveSpace N :=
  projectivePoint (polynomialProjStructureMap ℂ N) (identityEmbedding N) N

theorem nativeProj_isHolomorphicEmbedding (N : ℕ) :
    IsHolomorphicEmbedding (n := N) (nativeProj N) :=
  isHolomorphicEmbedding_projectivePoint _ _ N

theorem nativeProj_surjective (N : ℕ) : Function.Surjective (nativeProj N) := by
  intro x
  obtain ⟨p, hp⟩ := (SGPT.NAPotential.AlgPrimes3.ProjectiveGraphProjectiveHomeomorph.originalProjectiveHomeomorph
    N).surjective x
  refine ⟨p, ?_⟩
  rw [← hp, SGPT.NAPotential.AlgPrimes3.ProjectiveGraphProjectiveHomeomorph.originalProjectiveHomeomorph_apply]

/-! ### Polynomials in the affine charts -/

theorem eval_affineLift_bd5 {N : ℕ} (i : Fin (N + 1)) (y : ComplexModel N)
    (Q : MvPolynomial (Fin (N + 1)) ℂ) :
    MvPolynomial.eval (affineLift i y) Q =
      MvPolynomial.eval (fun a => y a) (polynomialProjDehomogenization ℂ N i Q) := by
  have h : (MvPolynomial.aeval (fun a => y a)).comp (polynomialProjDehomogenization ℂ N i) =
      MvPolynomial.aeval (affineLift i y) := by
    apply MvPolynomial.algHom_ext
    intro j
    refine Fin.succAboveCases i ?_ (fun a => ?_) j
    · simp [polynomialProjDehomogenization, polynomialProjDehomogenizationVariable_self]
    · simp [polynomialProjDehomogenization, polynomialProjDehomogenizationVariable_succAbove]
  have := AlgHom.congr_fun h Q
  simpa only [AlgHom.comp_apply, MvPolynomial.aeval_eq_eval] using this.symm

/-- The analytic function of the regular function `Q(x)/x_i^{deg}` on `D₊(x_i)`: the
restriction `genFun` of `Q` used by Chow's theorem. -/
theorem genFun_eq_regular {N : ℕ} (i : Fin (N + 1)) (Q : MvPolynomial (Fin (N + 1)) ℂ)
    {p : SchemeComplexPoint (polynomialProjStructureMap ℂ N)}
    (hp : schemeComplexPointImage _ p ∈ coordOpen (identityEmbedding N) i) :
    genFun (nativeProj N) i Q p =
      schemeOpenRegularFunction (polynomialProjStructureMap ℂ N) N (identityEmbedding N)
        (coordOpen (identityEmbedding N) i)
        (affinePresentation (polynomialProjStructureMap ℂ N) (identityEmbedding N) i
          (polynomialProjDehomogenization ℂ N i Q)) p := by
  have h1 := schemeOpenRegularFunction_affinePresentation (polynomialProjStructureMap ℂ N)
    (identityEmbedding N) N i (polynomialProjDehomogenization ℂ N i Q) p hp
  have h2 := projectivePoint_eq_affinePoint (polynomialProjStructureMap ℂ N) (identityEmbedding N)
    N i hp
  rw [h1]
  have h3 : affineChart i (nativeProj N p) =
      affineCoords (polynomialProjStructureMap ℂ N) (identityEmbedding N) N i p :=
    (congrArg (fun x : ComplexProjectiveSpace N => affineChart i x) h2).trans
      (affineChart_affinePoint i _)
  change MvPolynomial.eval (fun j => (WithLp.toLp 2 (affineLift i (affineChart i (nativeProj N p)))
    : SGPT.GAGA.PN.ConeSpace N) j) Q = _
  rw [h3]
  exact eval_affineLift_bd5 i _ Q

theorem mem_coordOpen_iff_affineChart {N : ℕ} (i : Fin (N + 1))
    (p : SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :
    schemeComplexPointImage _ p ∈ coordOpen (identityEmbedding N) i ↔
      nativeProj N p ∈ (affineChart i).source := by
  obtain ⟨⟨v, hv⟩, rfl⟩ := polynomialProjNonzeroVectorPoint_surjective N p
  obtain ⟨j, hj⟩ := polynomialProjVector_exists_nonzero_coordinate N v hv
  have he : polynomialProjNonzeroVectorPoint N ⟨v, hv⟩ = polynomialProjVectorChartPoint N j v :=
    polynomialProjNonzeroVectorPoint_eq_chart N ⟨v, hv⟩ j hj
  have hpp : nativeProj N (polynomialProjVectorChartPoint N j v) = mk v hv :=
    SGPT.NAPotential.AlgPrimes3.ProjectiveGraphProjectiveReadback.nativeVectorPoint_projectivePoint
      N j v hv hj
  rw [he, hpp, mk_mem_affineChart_source_iff i hv]
  change MvPolynomial.X i ∉ (schemeComplexPointImage (polynomialProjStructureMap ℂ N)
    (polynomialProjVectorChartPoint N j v)).asHomogeneousIdeal ↔ _
  rw [polynomialProjVectorChartPoint_mem_homogeneous N j v hj 1 (MvPolynomial.X i)
    (MvPolynomial.isHomogeneous_X ℂ i), MvPolynomial.eval_X]

section Chow

universe u

variable {N n : ℕ} {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y]
  [IsComplexManifold n Y] [CompactSpace Y] {Ψ : Y → ComplexProjectiveSpace N}
  (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
  {K : ℕ} (P : Fin K → MvPolynomial (Fin (N + 1)) ℂ)
  (hgen : (coneIdeal (range Ψ)).GeneratedOn (SGPT.GAGA.PN.puncture (SGPT.GAGA.PN.ConeSpace N))
    (fun k => SGPT.GAGA.PN.polyTuple (P k)))

/-- `Ψ(Y)` read in the native `ℙᴺ(ℂ)`. -/
abbrev nativeImage (Ψ : Y → ComplexProjectiveSpace N) :
    Set (SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :=
  nativeProj N ⁻¹' range Ψ

omit [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  [CompactSpace Y] in
include hgen in
/-- **Theorem A for `Ψ(Y)` on `ℙᴺ(ℂ)`.** -/
theorem vanishing_iff_genFun {i : Fin (N + 1)}
    {p : SchemeComplexPoint (polynomialProjStructureMap ℂ N)}
    (hp : nativeProj N p ∈ (affineChart i).source) (g : _ → ℂ) :
    (vanishingIdeal (n := N) (nativeImage Ψ)).mem p g ↔
      IsInSpanAt (n := N) (· ∈ range fun k => genFun (nativeProj N) i (P k)) p g := by
  have himg : nativeProj N '' nativeImage Ψ = range Ψ :=
    image_preimage_eq _ (nativeProj_surjective N)
  rw [← himg] at hgen
  exact vanishingIdeal_mem_iff_isInSpanAt_genFun (nativeProj_isHolomorphicEmbedding N) hgen hp g

/-- The lift of `Ψ` to `ℙᴺ(ℂ)`. -/
def nativeLift (Ψ : Y → ComplexProjectiveSpace N) (y : Y) :
    SchemeComplexPoint (polynomialProjStructureMap ℂ N) :=
  (nativeProj_surjective N (Ψ y)).choose

omit [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  [CompactSpace Y] in
theorem nativeProj_nativeLift (y : Y) : nativeProj N (nativeLift Ψ y) = Ψ y :=
  (nativeProj_surjective N (Ψ y)).choose_spec

omit [IsComplexManifold n Y] [CompactSpace Y] in
include hΨ in
theorem nativeLift_contMDiff :
    ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) ∞ (nativeLift Ψ) :=
  contMDiff_of_comp_eq_bd5 (SGPT.GAGA.SmoothFlags.contMDiff_of_isHolomorphicEmbedding hΨ)
    (nativeProj_isHolomorphicEmbedding N) _ (nativeProj_nativeLift)

omit [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  [CompactSpace Y] in
theorem range_nativeLift : range (nativeLift Ψ) = nativeImage Ψ := by
  ext p
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨y, (nativeProj_nativeLift y).symm⟩
  · rintro ⟨y, hy⟩
    refine ⟨y, (nativeProj_isHolomorphicEmbedding N).injective ?_⟩
    rw [nativeProj_nativeLift, hy]

include hΨ in
/-- `Ψ(Y)` is a closed submanifold of dimension `n` of `ℙᴺ(ℂ)`. -/
theorem regularAtDim_nativeImage {p : SchemeComplexPoint (polynomialProjStructureMap ℂ N)}
    (hp : p ∈ nativeImage Ψ) : RegularAtDim (n := N) (nativeImage Ψ) p n := by
  rw [← range_nativeLift] at hp ⊢
  obtain ⟨y, rfl⟩ := hp
  have hF := nativeLift_contMDiff hΨ
  have hcont : Continuous (nativeLift Ψ) := hF.continuous
  have hemb : Topology.IsClosedEmbedding (nativeLift Ψ) :=
    hcont.isClosedEmbedding (fun y₁ y₂ h => hΨ.injective (by
      have h' := congrArg (nativeProj N) h
      rwa [nativeProj_nativeLift, nativeProj_nativeLift] at h'))
  refine SGPT.GAGA.AlgPrimes3.regularAtDim_of_immersion
    (Eventually.of_forall fun y' => hF y') ?_ (Eventually.of_forall fun y' => ⟨y', rfl⟩) ?_
  · -- injectivity of the derivative: `nativeProj ∘ nativeLift = Ψ`
    have hcomp : nativeProj N ∘ nativeLift Ψ = Ψ := funext nativeProj_nativeLift
    have hd1 : MDifferentiableAt 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ComplexModel N) (nativeProj N)
        (nativeLift Ψ y) :=
      (SGPT.GAGA.SmoothFlags.contMDiff_of_isHolomorphicEmbedding
        (nativeProj_isHolomorphicEmbedding N) _).mdifferentiableAt (by simp)
    have hd2 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) (nativeLift Ψ) y :=
      (hF y).mdifferentiableAt (by simp)
    have hinj := mfderiv_injective_of_isHolomorphicEmbedding_bd5 hΨ y
    have key : ∀ t, (mfderiv 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) Ψ y) t =
        mfderiv 𝓘(ℂ, ComplexModel N) 𝓘(ℂ, ComplexModel N) (nativeProj N) (nativeLift Ψ y)
          (mfderiv 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel N) (nativeLift Ψ) y t) := by
      intro t
      rw [← mfderiv_comp_apply y hd1 hd2, hcomp]
    intro u w huw
    apply hinj
    rw [key, key, huw]
  · intro U hU
    have h1 : nativeLift Ψ '' U ∈ 𝓝[range (nativeLift Ψ)] (nativeLift Ψ y) := by
      rw [← hemb.isEmbedding.map_nhds_eq]
      exact image_mem_map hU
    obtain ⟨V, hV, hVsub⟩ := mem_nhdsWithin_iff_exists_mem_nhds_inter.mp h1
    exact ⟨V, hV, fun z hz => hVsub ⟨hz.2, hz.1⟩⟩

end Chow

end SGPT.BDivisor.BD5
