/-! ### Germs of combinations -/

theorem nativeHolGerm_mk_sum_mul {N : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel N) M] {x : M} {R : ℕ} (a s : Fin R → M → ℂ)
    (ha : ∀ i, HolomorphicAt N (a i) x) (hs : ∀ i, HolomorphicAt N (s i) x)
    (h : HolomorphicAt N (fun y => ∑ i, a i y * s i y) x) :
    NativeHolGerm.mk (fun y => ∑ i, a i y * s i y) h =
      ∑ i, NativeHolGerm.mk (a i) (ha i) * NativeHolGerm.mk (s i) (hs i) := by
  apply Subtype.ext
  have h1 : ((∑ i, NativeHolGerm.mk (a i) (ha i) * NativeHolGerm.mk (s i) (hs i) :
      NativeHolGerm N M x) : Germ (𝓝 x) ℂ) =
      ∑ i, ((a i : M → ℂ) : Germ (𝓝 x) ℂ) * ((s i : M → ℂ) : Germ (𝓝 x) ℂ) := by
    have := map_sum (nativeHolGermSubring N M x).subtype
      (fun i => NativeHolGerm.mk (a i) (ha i) * NativeHolGerm.mk (s i) (hs i)) Finset.univ
    simp only [map_mul] at this
    exact this
  rw [h1]
  have h2 := map_sum (Filter.Germ.coeRingHom (𝓝 x) : (M → ℂ) →+* Germ (𝓝 x) ℂ)
    (fun i => a i * s i) Finset.univ
  simp only [map_mul] at h2
  have hfun : (fun y => ∑ i, a i y * s i y) = ∑ i, a i * s i := by
    funext y
    simp [Finset.sum_apply]
  show ((fun y => ∑ i, a i y * s i y : M → ℂ) : Germ (𝓝 x) ℂ) = _
  rw [hfun]
  exact h2

/-- A germ in the span of finitely many holomorphic functions lies in the ideal of the germ ring
generated by their germs. -/
theorem nativeHolGerm_mem_span_of_isInSpanAt {N : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel N) M] {x : M} {c : ℕ} (r : Fin c → M → ℂ)
    (hr : ∀ l, HolomorphicAt N (r l) x) {f : M → ℂ} (hfh : HolomorphicAt N f x)
    (hf : IsInSpanAt (n := N) (· ∈ range r) x f) :
    NativeHolGerm.mk f hfh ∈ Ideal.span (range fun l => NativeHolGerm.mk (r l) (hr l)) := by
  obtain ⟨-, R, s, a, hs, ha, hsum⟩ := hf
  choose t ht using hs
  have hs' : ∀ i, HolomorphicAt N (s i) x := fun i => (ht i) ▸ hr (t i)
  have hsumh : HolomorphicAt N (fun y => ∑ i, a i y * s i y) x := hfh.congr hsum
  rw [show NativeHolGerm.mk f hfh = NativeHolGerm.mk (fun y => ∑ i, a i y * s i y) hsumh from
    NativeHolGerm.mk_eq_mk_iff.mpr hsum, nativeHolGerm_mk_sum_mul a s ha hs' hsumh]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t i, ?_⟩)
  apply Subtype.ext
  change ((r (t i) : _ → ℂ) : Germ (𝓝 x) ℂ) = ((s i : _ → ℂ) : Germ (𝓝 x) ℂ)
  rw [ht i]

section Chow

universe u

variable {N n : ℕ} {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y]
  [IsComplexManifold n Y] [CompactSpace Y] {Ψ : Y → ComplexProjectiveSpace N}
  (hΨ : IsHolomorphicEmbedding (n := n) Ψ)
  {K : ℕ} (P : Fin K → MvPolynomial (Fin (N + 1)) ℂ) {m : ℕ} (hP : ∀ k, (P k).IsHomogeneous m)
  (hgen : (coneIdeal (range Ψ)).GeneratedOn (SGPT.GAGA.PN.puncture (SGPT.GAGA.PN.ConeSpace N))
    (fun k => SGPT.GAGA.PN.polyTuple (P k)))
  (hzero : range Ψ = commonZeros P)

omit [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  [CompactSpace Y] in
include hzero in
theorem mem_nativeImage_iff_mem_range (p : SchemeComplexPoint (polynomialProjStructureMap ℂ N)) :
    p ∈ nativeImage Ψ ↔ p ∈ range (zeroPoint P hP) := by
  rw [mem_range_zeroPoint_iff P hP]
  change nativeProj N p ∈ range Ψ ↔ _
  rw [hzero]

include hΨ hgen hzero in
/-- **The stalk of `V(P)` at a complex point.**  It is formally smooth over `ℂ` and its
cotangent space has dimension `n`. -/
theorem stalk_formallySmooth_finrank (q : SchemeComplexPoint (zeroStructure P hP)) :
    letI := stalkComplexAlgebra (zeroStructure P hP) (schemeComplexPointImage _ q)
    letI : Algebra ((zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)) ℂ :=
      (schemeComplexPointStalkEval (zeroStructure P hP) q).toAlgebra
    Algebra.FormallySmooth ℂ ((zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)) ∧
      finrank ℂ (ℂ ⊗[(zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)]
        Ω[(zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)⁄ℂ]) = n := by
  classical
  set fP := polynomialProjStructureMap ℂ N with hfP
  set E := identityEmbedding N with hE
  set ι := zeroSchemeι P hP with hι
  set x := schemeComplexPointImage (zeroStructure P hP) q with hx
  set p := zeroPoint P hP q with hp
  have hpimg : schemeComplexPointImage fP p = ι x := rfl
  have hpC : p ∈ nativeImage Ψ := (mem_nativeImage_iff_mem_range P hP hzero p).mpr ⟨q, rfl⟩
  set i := frameIndex fP E p with hi
  have hpi : schemeComplexPointImage fP p ∈ coordOpen E i := mem_coordOpen_frameIndex fP E p
  have hpa : nativeProj N p ∈ (affineChart i).source := (mem_coordOpen_iff_affineChart i p).mp hpi
  -- analytic data on `ℙᴺ(ℂ)`
  let G : Fin K → SchemeComplexPoint fP → ℂ := fun k => genFun (nativeProj N) i (P k)
  have hGA : ∀ k, (vanishingIdeal (n := N) (nativeImage Ψ)).mem p (G k) := by
    intro k
    refine (vanishing_iff_genFun P hgen hpa (G k)).mpr ⟨?_, 1, fun _ => G k, fun _ => 1,
      fun _ => ⟨k, rfl⟩, fun _ => holomorphicAt_const _, Eventually.of_forall fun y => by simp⟩
    exact holomorphicAt_genFun (nativeProj_isHolomorphicEmbedding N) hpa (P k)
  have hreg := regularAtDim_nativeImage hΨ hpC
  have hnN : n ≤ N := hreg.1
  obtain ⟨sel, v, hdual, hspan⟩ := exists_selected_equations_bd5 hreg G hGA
    (fun g hg => (vanishing_iff_genFun P hgen hpa g).mp hg)
  -- the regular functions `P_{sel l}(x)/x_i^m`
  let r : Fin (N - n) → Γ(polynomialProj ℂ N, coordOpen E i) := fun l =>
    affinePresentation fP E i (polynomialProjDehomogenization ℂ N i (P (sel l)))
  let ran : Fin (N - n) → SchemeComplexPoint fP → ℂ := fun l =>
    schemeOpenRegularFunction fP N E (coordOpen E i) (r l)
  have hranhol : ∀ l, HolomorphicAt N (ran l) p := fun l =>
    schemeOpenRegularFunction_holomorphicAt fP N E _ (r l) p hpi
  have hGr : ∀ l, G (sel l) =ᶠ[𝓝 p] ran l := by
    intro l
    filter_upwards [(isOpen_coordOpen_points fP E i).mem_nhds hpi] with p' hp'
    exact genFun_eq_regular i (P (sel l)) hp'
  -- the stalks
  let A := (polynomialProj ℂ N).presheaf.stalk (schemeComplexPointImage fP p)
  let B := (zeroScheme P hP).presheaf.stalk x
  let tau : A →+* B := (ι.stalkMap x).hom
  let g : Fin (N - n) → A := fun l =>
    (polynomialProj ℂ N).presheaf.germ (coordOpen E i) (schemeComplexPointImage fP p) hpi (r l)
  have hr0 : ∀ l, ι.app (coordOpen E i) (r l) = 0 := fun l =>
    zeroSchemeι_app_ratio_dehom P hP i (sel l)
  have htau_germ : ∀ (W : (polynomialProj ℂ N).Opens) (hW : schemeComplexPointImage fP p ∈ W)
      (s : Γ(polynomialProj ℂ N, W)),
      tau ((polynomialProj ℂ N).presheaf.germ W (schemeComplexPointImage fP p) hW s) =
        (zeroScheme P hP).presheaf.germ (ι ⁻¹ᵁ W) x hW (ι.app W s) := fun W hW s =>
    Scheme.Hom.germ_stalkMap_apply ι W x hW s
  -- the kernel of the stalk map
  have hker : RingHom.ker tau = Ideal.span (range g) := by
    apply le_antisymm
    · intro a ha
      rw [RingHom.mem_ker] at ha
      obtain ⟨W, hxW, s, rfl⟩ := (polynomialProj ℂ N).presheaf.exists_germ_eq a
      -- the analytic function of `s` vanishes on `Ψ(Y)` near `p`
      have h0 := ha
      rw [htau_germ W hxW s] at h0
      rw [← map_zero (ConcreteCategory.hom ((zeroScheme P hP).presheaf.germ (ι ⁻¹ᵁ W) x hxW))] at h0
      obtain ⟨W', hxW', iU, iV, hres⟩ := (zeroScheme P hP).presheaf.germ_eq x hxW hxW _ _ h0
      rw [map_zero] at hres
      obtain ⟨W₀, hW₀, hW₀eq⟩ := ι.isClosedEmbedding.isInducing.isOpen_iff.mp W'.isOpen
      let F := schemeOpenRegularFunction fP N E W s
      have hFhol : HolomorphicAt N F p := schemeOpenRegularFunction_holomorphicAt fP N E W s p hxW
      have hFvan : (vanishingIdeal (n := N) (nativeImage Ψ)).mem p F := by
        refine ⟨hFhol, ?_⟩
        have hO : IsOpen (schemeComplexPointImage fP ⁻¹' (W₀ ∩ (W : Set (polynomialProj ℂ N)))) :=
          (hW₀.inter W.isOpen).preimage (schemeComplexPointImage_continuous fP)
        have hpO : p ∈ schemeComplexPointImage fP ⁻¹' (W₀ ∩ (W : Set (polynomialProj ℂ N))) := by
          refine ⟨?_, hxW⟩
          change ι x ∈ W₀
          have : x ∈ ι ⁻¹' W₀ := by rw [hW₀eq]; exact hxW'
          exact this
        filter_upwards [hO.mem_nhds hpO] with p'' hp'' hp''C
        obtain ⟨q'', rfl⟩ := (mem_nativeImage_iff_mem_range P hP hzero p'').mp hp''C
        have hx'' : schemeComplexPointImage _ q'' ∈ W' := by
          show schemeComplexPointImage _ q'' ∈ (W' : Set (zeroScheme P hP))
          rw [← hW₀eq]
          exact hp''.1
        have hval := schemeOpenRegularFunction_apply fP N E W s (zeroPoint P hP q'') hp''.2
        show schemeOpenRegularFunction fP N E W s (zeroPoint P hP q'') = 0
        rw [hval, schemeNativeStalkGerm_eval]
        have hcomp := schemeComplexPointStalkEval_comp (zeroStructure P hP) fP ι rfl q''
        have hc := RingHom.congr_fun hcomp
          ((polynomialProj ℂ N).presheaf.germ W (ι (schemeComplexPointImage _ q'')) hp''.2 s)
        refine hc.trans ?_
        rw [RingHom.comp_apply]
        erw [Scheme.Hom.germ_stalkMap_apply ι W _ hp''.2 s]
        have hgr := (zeroScheme P hP).presheaf.germ_res_apply iU (schemeComplexPointImage _ q'') hx''
          (ι.app W s)
        erw [← hgr, hres]
        simp only [map_zero]
      have hFspan : IsInSpanAt (n := N) (· ∈ range ran) p F := by
        refine RelativePrincipalizationSpan.IsInSpanAt.trans (n := N) (S := (· ∈ range fun l => G (sel l))) ?_ (hspan F hFvan)
        rintro _ ⟨l, rfl⟩
        refine isInSpanAt_of_eventuallyEq_bd5 ?_ (hGr l).symm
        exact ⟨hranhol l, 1, fun _ => ran l, fun _ => 1, fun _ => ⟨l, rfl⟩,
          fun _ => holomorphicAt_const _, Eventually.of_forall fun y => by simp⟩
      have hmem := nativeHolGerm_mem_span_of_isInSpanAt ran hranhol hFhol hFspan
      have hgerm : NativeHolGerm.mk F hFhol =
          schemeNativeStalkGerm fP N p ((polynomialProj ℂ N).presheaf.germ W _ hxW s) :=
        schemeOpenRegularFunction_germ fP N E W s p hxW
      have hrgerm : ∀ l, NativeHolGerm.mk (ran l) (hranhol l) = schemeNativeStalkGerm fP N p (g l) :=
        fun l => schemeOpenRegularFunction_germ fP N E _ (r l) p hpi
      rw [hgerm] at hmem
      simp only [hrgerm] at hmem
      rw [mem_ideal_iff_schemeNativeStalkGerm fP N p, Ideal.map_span]
      convert hmem using 2
      ext z
      simp only [mem_image, mem_range, exists_exists_eq_and]
    · rw [Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      change tau ((polynomialProj ℂ N).presheaf.germ (coordOpen E i)
        (schemeComplexPointImage fP p) hpi (r l)) = 0
      rw [htau_germ, hr0, map_zero]
  -- algebra structures
  let := stalkComplexAlgebra fP (schemeComplexPointImage fP p)
  let := stalkComplexAlgebra (zeroStructure P hP) x
  let : Algebra A B := tau.toAlgebra
  let : Algebra A ℂ := (schemeComplexPointStalkEval fP p).toAlgebra
  let : Algebra B ℂ := (schemeComplexPointStalkEval (zeroStructure P hP) q).toAlgebra
  let : IsScalarTower ℂ A B := IsScalarTower.of_algebraMap_eq fun c =>
    (originalStalk_algebraMap_comp fP ι x c).symm
  have heval : schemeComplexPointStalkEval fP p =
      (schemeComplexPointStalkEval (zeroStructure P hP) q).comp tau :=
    schemeComplexPointStalkEval_comp (zeroStructure P hP) fP ι rfl q
  let : IsScalarTower A B ℂ := IsScalarTower.of_algebraMap_eq fun a => RingHom.congr_fun heval a
  let : IsScalarTower ℂ A ℂ := originalPointStalk_scalarTower fP N p
  have : Smooth fP := SmoothOfRelativeDimension.smooth N fP
  obtain ⟨hsm, -, hfin, hfree⟩ := originalSmoothStalk_differentials fP (schemeComplexPointImage fP p)
  let : Algebra.FormallySmooth ℂ A := hsm
  let : Module.Finite A Ω[A⁄ℂ] := hfin
  let : Module.Free A Ω[A⁄ℂ] := hfree
  have hAB : Function.Surjective (algebraMap A B) := ι.stalkMap_surjective x
  -- the derivations dual to the selected equations
  let D : Fin (N - n) → Derivation ℂ A ℂ := fun j => nativeStalkDerivation fP N p (v j)
  have hD : ∀ j l, D j (g l) = if j = l then 1 else 0 := by
    intro j l
    change nativeStalkDerivation fP N p (v j) ((polynomialProj ℂ N).presheaf.germ (coordOpen E i)
      (schemeComplexPointImage fP p) hpi (r l)) = _
    rw [nativeStalkDerivation_regular fP N E _ (r l) p hpi (v j)]
    have h := hdual j l
    rw [chartDeriv_congr_bd5 (N := N) (hGr l)] at h
    exact h
  have hev_surj : Function.Surjective (schemeComplexPointStalkEval (zeroStructure P hP) q) := by
    intro c
    refine ⟨tau (algebraMap ℂ A c), ?_⟩
    rw [← RingHom.comp_apply, ← heval]
    exact originalPointStalkEval_algebraMap fP N p c
  have hBK : maximalIdeal B ≤ RingHom.ker (algebraMap B ℂ) :=
    (IsLocalRing.ker_eq_maximalIdeal (schemeComplexPointStalkEval (zeroStructure P hP) q)
      hev_surj).ge
  refine ⟨formallySmooth_of_relations_derivations_bd5 hAB g hker D hD hBK, ?_⟩
  rw [cotangent_finrank_of_relations_derivations_bd5 hAB g hker D hD,
    originalStalk_cotangent_finrank fP N (schemeComplexPointImage fP p)]
  omega

include hΨ hgen hzero in
/-- **`V(P)` is smooth over `ℂ`.** -/
theorem zeroStructure_smooth : Smooth (zeroStructure P hP) := by
  have : LocallyOfFinitePresentation (zeroStructure P hP) := by
    unfold zeroStructure
    infer_instance
  exact smooth_of_formallySmooth_complexPoint_stalk _ fun q =>
    (stalk_formallySmooth_finrank hΨ P hP hgen hzero q).1

include hΨ hgen hzero in
/-- **`V(P)` is smooth of relative dimension `n = dim Y` over `ℂ`.** -/
theorem zeroStructure_smoothOfRelativeDimension :
    SmoothOfRelativeDimension n (zeroStructure P hP) := by
  have := zeroStructure_smooth hΨ P hP hgen hzero
  apply smoothOfRelativeDimension_of_complexPoint_cotangent_finrank _ n
  intro q
  let := stalkComplexAlgebra (zeroStructure P hP) (schemeComplexPointImage _ q)
  obtain ⟨-, -, hfin, hfree⟩ := originalSmoothStalk_differentials (zeroStructure P hP)
    (schemeComplexPointImage _ q)
  let : Module.Finite _ Ω[(zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)⁄ℂ] := hfin
  let : Module.Free _ Ω[(zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)⁄ℂ] := hfree
  let : Algebra ((zeroScheme P hP).presheaf.stalk (schemeComplexPointImage _ q)) ℂ :=
    (schemeComplexPointStalkEval (zeroStructure P hP) q).toAlgebra
  have h := (stalk_formallySmooth_finrank hΨ P hP hgen hzero q).2
  rw [Module.finrank_baseChange] at h
  exact h

end Chow

